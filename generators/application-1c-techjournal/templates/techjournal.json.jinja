{%- set step = vars.step -%}
{%- if step == 'routine' -%}
  {%- set cap = ([params.anomaly_after_events, 200] | max) + 200 -%}
  {%- set n = (shared.get('routine_count', 0) % cap) + 1 -%}
  {%- do shared.set('routine_count', n) -%}
  {%- set batch = n % 200 >= 100 and n % 200 < 198 -%}
  {%- if batch -%}
    {%- do shared.set('seen_contending_user', true) -%}
    {%- do shared.set('last_contending_event', timestamp.timestamp()) -%}
  {%- endif -%}
  {%- if params.anomaly_mode and not shared.get('anomaly_done', false)
      and n >= params.anomaly_after_events
      and shared.get('seen_contending_user', false)
      and not batch
      and timestamp.timestamp() - shared.get('last_contending_event', 0) >= 6 -%}
    {%- do shared.set('anomaly_done', true) -%}
    {%- do shared.set('start_anomaly', true) -%}
  {%- endif -%}
  {%- set slot = n % 100 -%}
  {%- if slot in [10, 55, 90] -%}
    {%- set name = 'TLOCK' -%}
  {%- elif slot == 72 -%}
    {%- set name = 'EXCP' -%}
  {%- elif slot % 5 == 0 -%}
    {%- set name = 'CALL' -%}
  {%- else -%}
    {%- set name = 'SCALL' -%}
  {%- endif -%}
  {%- set duration = module.rand.number.clamp(
      module.rand.number.lognormal(8.5, 1.0), 300, 90000) | int -%}
{%- else -%}
  {%- do shared.pop('start_anomaly', none) -%}
  {%- set batch = true -%}
  {%- set name = {'lock_wait': 'TLOCK', 'exception': 'EXCP',
      'call_result': 'CALL'}[step] -%}
  {%- set duration = {'lock_wait': 2000000,
      'exception': 0, 'call_result': 5500000}[step] -%}
{%- endif -%}
{%- set user = params.contending_user if batch else params.routine_user -%}
{%- set client_id = params.contending_client_id if batch else params.routine_client_id -%}
{%- set thread = '15968' if batch else '15432' -%}
{%- set session = '421' if batch else '103' -%}
{%- set connection = '16' if batch else '17' -%}
{%- set blocker = '17' if batch else '16' -%}
{%- set event_time = timestamp.replace(
    microsecond=module.rand.number.integer(1, 999999)) -%}
{%- set raw = {
    'ts': event_time.strftime('%Y-%m-%dT%H:%M:%S.%f'),
    'duration': duration | string,
    'name': name,
    'depth': {'CALL': '1', 'SCALL': '2', 'TLOCK': '5',
        'EXCP': '6'}[name],
    'level': 'ERROR' if name == 'EXCP' else 'INFO',
    'process': params.process_name,
    'p:processName': params.infobase,
    'OSThread': thread,
    't:clientID': client_id,
    't:applicationName': '1CV8C',
    't:computerName': 'client-01' if batch else 'client-02',
    't:connectID': connection,
    'SessionID': session,
    'Usr': user,
    'AppID': '1CV8C'
} -%}
{%- if name in ['SCALL', 'CALL'] -%}
  {%- set call_id = (shared.get('call_id', 28283) % 999999999) + 1 -%}
  {%- do shared.set('call_id', call_id) -%}
  {%- if name == 'SCALL' -%}
    {%- do raw.update({'ClientID': '92' if batch else '8',
        'Interface': 'bc15bd01-10bf-413c-a856-ddc907fcd123',
        'IName': 'IVResourceRemoteConnection', 'Method': '0',
        'CallID': call_id | string, 'MName': 'send',
        'DstClientID': '122'}) -%}
  {%- else -%}
    {%- do raw.update({'Interface':
        'bc15bd01-10bf-413c-a856-ddc907fcd123',
        'Method': '0', 'CallID': call_id | string,
        'InBytes': '2048', 'OutBytes': '512',
        'Context': 'ОбщийМодуль.ЗаписьДокументов.Модуль : 81 : НаборЗаписей.Записать();'}) -%}
  {%- endif -%}
{%- elif name == 'TLOCK' -%}
  {%- do raw.update({'Regions': 'InfoRg42.DIMS',
      'Locks': 'InfoRg42.DIMS Exclusive Fld43="DOC-0042"',
      'WaitConnections': blocker,
      'Context': 'ОбщийМодуль.ЗаписьДокументов.Модуль : 81 : НаборЗаписей.Записать();'}) -%}
{%- else -%}
  {%- do raw.update({'Descr':
      'Превышено максимальное время ожидания предоставления блокировки',
      'Context': 'ОбщийМодуль.ЗаписьДокументов.Модуль : 81 : НаборЗаписей.Записать();'}) -%}
{%- endif -%}
{{ {'@timestamp': event_time.isoformat(),
    'ecs': {'version': '8.17.0'},
    'event': {'dataset': '1c.techjournal', 'kind': 'event',
        'type': ['error'] if name == 'EXCP' else ['info'],
        'action': name,
        'original': module.json.dumps(raw, ensure_ascii=false,
            separators=(',', ':'))},
    'host': {'name': params.host_name},
    'process': {'name': params.process_name},
    'user': {'name': user},
    'one_c': {'techjournal': raw}
} | tojson }}
