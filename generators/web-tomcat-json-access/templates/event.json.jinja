{%- set step = vars.step -%}
{%- set kind = step -%}
{%- if step == 'routine' -%}
  {%- do shared.pop('to_attack', none) -%}
  {%- set count = shared.get('routine_count', 0) + 1 -%}
  {%- if count >= params.anomaly_interval_events -%}
    {%- do shared.set('routine_count', 0) -%}
    {%- if params.anomaly_mode -%}{%- do shared.set('to_attack', true) -%}{%- endif -%}
  {%- else -%}{%- do shared.set('routine_count', count) -%}{%- endif -%}
{%- endif -%}
{%- set req = samples.requests.pick() -%}
{%- set method = req.method -%}{%- set path = req.path -%}
{%- set status = req.status -%}{%- set size = req.size -%}
{%- set src = '10.120.2.' ~ module.rand.number.integer(20,180) -%}
{%- set user = '-' -%}{%- set session = '-' -%}{%- set query = '' -%}
{%- set elapsed = 10 if status != 503 else 35 -%}
{%- if kind.startswith('fail_') -%}
  {%- set src = params.anomaly_ip -%}{%- set method = 'GET' -%}
  {%- set path = '/manager/html' -%}{%- set status = 401 -%}{%- set size = 190 -%}
  {%- set elapsed = 14 -%}
{%- elif kind == 'manager_ok' -%}
  {%- set src = params.anomaly_ip -%}{%- set method = 'GET' -%}
  {%- set path = '/manager/html' -%}{%- set status = 200 -%}{%- set size = 4891 -%}
  {%- set user = params.anomaly_user -%}
  {%- set session = 'B4MANAGER' ~ (shared.get('session_counter', 0) + 1) -%}
  {%- do shared.set('session_counter', (shared.get('session_counter', 0) % 2147483647) + 1) -%}
  {%- do shared.set('attack_session', session) -%}
{%- elif kind == 'deploy' -%}
  {%- set src = params.anomaly_ip -%}{%- set method = 'POST' -%}
  {%- set path = '/manager/text/deploy' -%}{%- set query = '?war=file:/tmp/support.war&path=/support' -%}
  {%- set status = 200 -%}{%- set size = 142 -%}{%- set elapsed = 429 -%}
  {%- set user = params.anomaly_user -%}{%- set session = shared.get('attack_session') -%}
{%- elif kind == 'deployed_get' -%}
  {%- set src = params.anomaly_ip -%}{%- set method = 'GET' -%}
  {%- set path = '/support/' -%}{%- set status = 200 -%}
  {%- set size = 2048 -%}{%- set elapsed = 45 -%}
{%- endif -%}
{%- set request = method ~ ' ' ~ path ~ query ~ ' HTTP/1.1' -%}
{%- set native = {'time':'[' ~ timestamp.strftime('%d/%b/%Y:%H:%M:%S %z') ~ ']','remoteAddr':src,'user':user,'method':method,'path':path,'query':query,'statusCode':status|string,'size':'-' if size == 0 else size|string,'elapsedTime':elapsed|string,'sessionId':session,'request':request,'protocol':'HTTP/1.1','localServerName':params.server_name} -%}
{%- set category = ['web'] -%}{%- set event_type = ['access'] -%}{%- set outcome = 'failure' if status >= 400 else 'success' -%}
{%- set out = {'@timestamp':timestamp.isoformat(),'ecs':{'version':'8.17.0'},'event':{'action':'http-access','category':category,'dataset':'tomcat.access','kind':'event','original':native|tojson,'outcome':outcome,'type':event_type},'host':{'name':params.server_name,'ip':[params.server_ip]},'http':{'request':{'method':method},'response':{'status_code':status,'bytes':size},'version':'1.1'},'message':request,'observer':{'hostname':params.server_name,'ip':params.server_ip,'product':'Tomcat','type':'web','vendor':'Apache'},'related':{'ip':[src]},'source':{'ip':src},'tags':['tomcat-json-access','preserve_original_event'],'tomcat':{'access':native},'url':{'path':path,'query':query}} -%}
{%- if user != '-' -%}{%- do out.update({'user':{'name':user}}) -%}{%- do out.related.update({'user':[user]}) -%}{%- endif -%}
{{- out | tojson -}}
