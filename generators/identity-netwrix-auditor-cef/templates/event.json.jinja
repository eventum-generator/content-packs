{%- set step = vars.step -%}
{%- set chain = step.startswith('chain_') -%}
{%- if step == 'routine_a' -%}
  {%- do shared.pop('to_chain', none) -%}
  {%- set count = shared.get('routine_count', 0) + 1 -%}
  {%- if count >= params.anomaly_interval_events -%}
    {%- do shared.set('routine_count', 0) -%}
    {%- if params.anomaly_mode -%}{%- do shared.set('to_chain', true) -%}{%- endif -%}
  {%- else -%}{%- do shared.set('routine_count', count) -%}{%- endif -%}
{%- endif -%}
{%- set slash = '\\' -%}
{%- set operator = params.chain_operator if chain else 'EXAMPLE' ~ slash ~ module.rand.choice(['helpdesk-a','helpdesk-b','helpdesk-c']) -%}
{%- set target = ('contractor0' ~ step[-1]) if chain else ('staff' ~ module.rand.number.integer(1000, 9999)) -%}
{%- set path = slash ~ 'local' ~ slash ~ 'example' ~ slash ~ 'users' ~ slash ~ target -%}
{%- set extension = {'shost':params.domain_controller,'cat':'user','suser':operator,'filePath':path,'start':timestamp.strftime('%b %d %Y %H:%M:%S')} -%}
{%- set pieces = [] -%}
{%- for key,value in extension.items() -%}{%- do pieces.append(key ~ '=' ~ value|string) -%}{%- endfor -%}
{%- set raw = 'CEF:0|Netwrix|Active Directory|1.0|Added|Added user|0|' ~ pieces|join(' ') -%}
{%- set cef = {'version':0,'vendor':'Netwrix','product':'Active Directory','device_version':'1.0','class_id':'Added','name':'Added user','severity':0,'extension':extension} -%}
{%- set out = {'@timestamp':timestamp.isoformat(),'ecs':{'version':'8.17.0'},'event':{'action':'added-user','category':['iam'],'code':'Added','dataset':'netwrix_auditor.cef','kind':'event','original':raw,'type':['creation']},'host':{'name':params.domain_controller},'user':{'name':operator,'target':{'name':target}},'related':{'user':[operator,target]},'netwrix':{'auditor':cef}} -%}
{{- out | tojson -}}
