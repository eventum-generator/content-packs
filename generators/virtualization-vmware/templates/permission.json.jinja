{%- do sessions[actor_index].update({'calls': sessions[actor_index].calls + 1}) -%}
{%- if kind == 'PermissionAddedEvent' -%}
  {%- do shared.set('grant', true) -%}
  {%- set text = 'Permission added for ' ~ params.granted_principal ~ ' on ' ~ params.datacenter ~ ' with role Administrator (propagate=true) by ' ~ actor.name -%}
  {%- set permission = {'principal': params.granted_principal, 'entity': params.datacenter, 'group': false, 'role': 'Administrator', 'propagate': true} -%}
  {%- set action = 'permission-added' -%}
{%- else -%}
  {%- do shared.set('grant', false) -%}
  {%- set text = 'Permission removed for ' ~ params.granted_principal ~ ' on ' ~ params.datacenter ~ ' by ' ~ actor.name -%}
  {%- set permission = {'principal': params.granted_principal, 'entity': params.datacenter, 'group': false} -%}
  {%- set action = 'permission-removed' -%}
{%- endif -%}
{%- do details.update({'permission': permission}) -%}
{%- do result.update({'text': text, 'datacenter': params.datacenter, 'action': action, 'category': ['iam'], 'type': ['change'], 'outcome': 'success'}) -%}
{%- include 'templates/record.json.jinja' -%}
