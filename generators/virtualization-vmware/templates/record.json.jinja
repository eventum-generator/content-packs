{%- set dc = result.get('datacenter', '') -%}
{%- set tail = '[' ~ actor.name ~ '] [' ~ dc ~ '] [' ~ key ~ '] [' ~ result.text ~ ']' -%}
{%- set raw = '<14>1 ' ~ result.header ~ ' ' ~ params.vcenter_host ~ ' vpxd 58650 - -  Event [' ~ key ~ '] [1-1] [' ~ native_time ~ '] [' ~ details.class ~ '] [info] ' ~ tail -%}
{%- set body = {
  '@timestamp': result.at,
  'agent': {'ephemeral_id': params.agent_ephemeral_id, 'id': params.agent_id, 'name': params.vcenter_host, 'type': 'filebeat', 'version': params.agent_version},
  'data_stream': {'dataset': 'vsphere.log', 'namespace': 'default', 'type': 'logs'},
  'ecs': {'version': params.ecs_version},
  'elastic_agent': {'id': params.agent_id, 'snapshot': false, 'version': params.agent_version},
  'event': {'dataset': 'vsphere.log', 'ingested': (utc + module.datetime.timedelta(milliseconds=200)).isoformat(timespec='milliseconds').replace('+00:00', 'Z'), 'original': raw, 'timezone': '+00:00', 'id': key | string, 'kind': 'event', 'category': result.category, 'type': result.type, 'action': result.action, 'outcome': result.outcome},
  'host': {'architecture': 'x86_64', 'containerized': false, 'hostname': params.vcenter_host, 'id': params.vcenter_id, 'ip': [params.vcenter_ip], 'mac': [params.vcenter_mac], 'name': params.vcenter_host, 'os': {'family': 'linux', 'name': 'VMware Photon OS', 'platform': 'photon', 'type': 'linux'}},
  'input': {'type': 'udp'},
  'log': {'level': 'info', 'source': {'address': params.vcenter_ip ~ ':59146'}, 'syslog': {'priority': 14, 'facility': {'code': 1, 'name': 'User'}, 'severity': {'code': 6, 'name': 'Informational'}}, 'logger': details.class},
  'message': tail,
  'process': {'name': 'vpxd', 'pid': 58650},
  'tags': ['preserve_original_event', 'vmware-sphere'],
  'user': {'name': actor.name.split('\\')[-1], 'domain': actor.name.rsplit('\\', 1)[0]},
  'related': {'user': [actor.name.split('\\')[-1]]},
  'vsphere': {'event': details}
} -%}
{%- if result.get('peer') is not none -%}
  {%- do body.update({'client': {'ip': result.peer}, 'source': {'ip': result.peer}}) -%}
  {%- do body.related.update({'ip': [result.peer]}) -%}
{%- endif -%}
{%- if result.get('user_agent') is not none -%}
  {%- do body.update({'user_agent': {'original': result.user_agent, 'device': {'name': 'Other'}, 'name': 'Go-http-client', 'version': '1.1'}}) -%}
{%- endif -%}
{%- if result.get('start') is not none -%}
  {%- do body.event.update({'start': result.start, 'end': result.at, 'duration': result.duration}) -%}
  {%- do body.vsphere.update({'log': {'api': {'invocations': result.calls}}}) -%}
{%- endif -%}
{%- if details.get('permission') is not none -%}
  {%- do body.related.user.append(params.granted_principal.split('\\')[-1]) -%}
{%- endif -%}
{{ body | tojson }}
