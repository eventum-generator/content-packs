{%- if params.anomaly_mode -%}
{%- from 'templates/_base.json.jinja' import render with context -%}
{%- set station = shared.get('arc_station') -%}
{%- set fields = {
  'MSG.Component': 'Dr.Web Scanner',
  'MSG.Scanned': module.rand.number.integer(800, 20000),
  'MSG.Infected': 1,
  'MSG.Cured': 0,
  'MSG.DeletedObjs': 0,
  'MSG.Errors': 0,
  'MSG.Locked': 0,
  'MSG.Modifications': 0,
  'MSG.Moved': 1,
  'MSG.Renamed': 0,
  'MSG.RunBy': station.user,
  'MSG.ServerTime': timestamp.isoformat(),
  'MSG.Speed': module.rand.number.integer(12000, 85000),
  'MSG.Suspicious': 0,
  'MSG.VirusActivity': 1
} -%}
{%- do shared.pop('arc_station') -%}
{%- do shared.pop('arc_object') -%}
{{- render(station, 'Scan statistics', 'scan-completed', ['malware'], ['info'], 'success', 2,
    'Scan completed on ' ~ station.name ~ ': one infected object moved.', fields,
    station.user) -}}
{%- else -%}
{%- include 'templates/scan-stats.json.jinja' -%}
{%- endif -%}
