{%- if shared.get('arc_station') -%}
{%- from 'templates/_base.json.jinja' import render with context -%}
{%- set station = shared.get('arc_station') -%}
{%- set obj = shared.get('arc_object') -%}
{%- set fields = {
  'MSG.Action': 'moved to quarantine',
  'MSG.Component': 'Dr.Web Scanner',
  'MSG.InfectionType': obj.kind,
  'MSG.ObjectName': obj.path,
  'MSG.ObjectOwner': station.user,
  'MSG.RunBy': station.user,
  'MSG.ServerTime': timestamp.isoformat(),
  'MSG.Virus': obj.threat
} -%}
{{- render(station, 'Security threat detected', 'security-threat-detected',
    ['malware'], ['info'], 'success', 6,
    obj.threat ~ ' detected in ' ~ obj.path ~ ' on ' ~ station.name ~ '.', fields,
    station.user) -}}
{%- else -%}
{%- include 'templates/threat-detected.json.jinja' -%}
{%- endif -%}
