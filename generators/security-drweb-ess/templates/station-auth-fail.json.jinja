{%- if params.anomaly_mode -%}
{%- from 'templates/_base.json.jinja' import render with context -%}
{%- set picked = samples.stations.pick() -%}
{%- set station = dict(id=picked.id, name=picked.name, ip=picked.ip) -%}
{%- do shared.set('auth_station', station) -%}
{%- set fields = {
  'MSG.ID': station.id,
  'MSG.Rejected': 'rejected',
  'MSG.StationName': station.name
} -%}
{{- render(station, 'Station authorization failed', 'station-authorization-failed',
    ['authentication'], ['denied'], 'failure', 5,
    'Station ' ~ station.name ~ ' provided incorrect credentials to Dr.Web Server.', fields) -}}
{%- else -%}
{%- include 'templates/scan-stats.json.jinja' -%}
{%- endif -%}
