{%- from 'templates/_base.json.jinja' import render with context -%}
{%- if shared.get('auth_station') -%}
  {%- set station = shared.pop('auth_station') -%}
  {%- do shared.set('auth_done', true) -%}
{%- else -%}
  {%- set index = (shared.pop('bg_auth_index', 0) + 1) % (samples.stations | length) -%}
  {%- set picked = samples.stations[index] -%}
  {%- set station = dict(id=picked.id, name=picked.name, ip=picked.ip) -%}
{%- endif -%}
{%- set fields = {
  'MSG.ID': station.id,
  'MSG.Server': params.server_id,
  'MSG.StationName': station.name
} -%}
{{- render(station, 'Station already logged in', 'station-id-duplicate',
    ['authentication'], ['info'], 'failure', 6,
    'A station using the identifier of ' ~ station.name ~ ' is already connected to Dr.Web Server.',
    fields) -}}
