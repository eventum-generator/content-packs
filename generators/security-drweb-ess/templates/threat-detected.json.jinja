{%- from 'templates/_base.json.jinja' import render with context -%}
{%- set fields = {
  'MSG.Action': 'moved to quarantine', 'MSG.Component': 'Dr.Web Scanner',
  'MSG.InfectionType': ctx.obj.kind, 'MSG.ObjectName': ctx.obj.path,
  'MSG.ObjectOwner': station.user, 'MSG.RunBy': station.user,
  'MSG.ServerTime': now.isoformat(), 'MSG.Virus': ctx.obj.threat
} -%}
{{- render(station, 'Security threat detected', 'security-threat-detected',
    ['malware'], ['info'], 'success', 6,
    ctx.obj.threat ~ ' detected in ' ~ ctx.obj.path ~ ' and moved to quarantine on ' ~ station.name ~ '.',
    fields, station.user) -}}
