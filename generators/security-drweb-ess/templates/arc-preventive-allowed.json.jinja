{%- if params.anomaly_mode -%}
{%- from 'templates/_base.json.jinja' import render with context -%}
{%- set station = shared.get('arc_station') -%}
{%- set obj = shared.get('arc_object') -%}
{%- set fields = {
  'MSG.Denied': 'allowed',
  'MSG.HipsType': 'file access',
  'MSG.IsShellGuard': 'check the access to the protected objects',
  'MSG.Path': 'C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe',
  'MSG.Pid': module.rand.number.integer(2400, 12000),
  'MSG.StationTime': timestamp.isoformat(),
  'MSG.Target': obj.path,
  'MSG.Total': 0,
  'MSG.User': station.user,
  'MSG.UserAction': 'user'
} -%}
{{- render(station, 'Report of Preventive protection', 'preventive-protection-allowed',
    ['process'], ['allowed'], 'success', 6,
    'User ' ~ station.user ~ ' allowed suspicious process access to ' ~ obj.path ~ ' on ' ~ station.name ~ '.',
    fields, station.user) -}}
{%- else -%}
{%- include 'templates/scan-stats.json.jinja' -%}
{%- endif -%}
