{%- from 'templates/_base.json.jinja' import render with context -%}
{%- set station = samples.stations.pick() -%}
{%- set scanned = module.rand.number.integer(800, 20000) -%}
{%- set infected = module.rand.weighted_choice([0, 1, 2], [94, 5, 1]) -%}
{%- set fields = {
  'MSG.Component': 'Dr.Web Scanner',
  'MSG.Scanned': scanned,
  'MSG.Infected': infected,
  'MSG.Cured': 0,
  'MSG.DeletedObjs': 0,
  'MSG.Errors': 0,
  'MSG.Locked': 0,
  'MSG.Modifications': 0,
  'MSG.Moved': infected,
  'MSG.Renamed': 0,
  'MSG.RunBy': station.user,
  'MSG.ServerTime': timestamp.isoformat(),
  'MSG.Speed': module.rand.number.integer(12000, 85000),
  'MSG.Suspicious': 0,
  'MSG.VirusActivity': infected
} -%}
{{- render(station, 'Scan statistics', 'scan-completed', ['malware'], ['info'], 'success', 2,
    'Scan completed on ' ~ station.name ~ ': ' ~ scanned ~ ' objects scanned, ' ~ infected ~ ' infected.',
    fields, station.user) -}}
