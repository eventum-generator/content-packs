  'MSG.Component': 'Dr.Web Scanner', 'MSG.Scanned': ctx.scanned,
  'MSG.Infected': ctx.infected, 'MSG.Cured': 0, 'MSG.DeletedObjs': 0,
  'MSG.Errors': 0, 'MSG.Locked': 0, 'MSG.Modifications': 0,
  'MSG.Moved': ctx.infected, 'MSG.Renamed': 0, 'MSG.RunBy': station.user,
  'MSG.ServerTime': now.isoformat(), 'MSG.Speed': ctx.speed,
  'MSG.Suspicious': 0, 'MSG.VirusActivity': ctx.infected
} -%}
{{- render(station, 'Scan statistics', 'scan-completed', ['malware'], ['info'], 'success', 2,
