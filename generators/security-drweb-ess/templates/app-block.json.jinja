{%- from 'templates/_base.json.jinja' import render with context -%}
{%- set fields = {
  'MSG.AppCtlAction': 5, 'MSG.AppCtlType': 1,
  'MSG.Path': ctx.obj.path, 'MSG.Profile': 'Default deny executables',
  'MSG.Rule': 'Block untrusted application', 'MSG.SHA256': ctx.obj.sha256,
  'MSG.StationTime': (now - module.datetime.timedelta(seconds=station_delay)).isoformat(),
  'MSG.TestMode': 0, 'MSG.User': station.user
} -%}
{{- render(station, 'Application Control blocked the process', 'application-control-blocked',
    ['process'], ['denied'], 'success', 5,
    'Application Control prevented launch of ' ~ ctx.obj.path ~ ' on ' ~ station.name ~ '.', fields,
    station.user, [ctx.obj.sha256], ctx.obj.path) -}}
