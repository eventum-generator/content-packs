{#- Veeam Backup & Replication 13.1 syslog records wrapped in ECS JSON.
    One input tick per second; each tick emits the earliest due record,
    stamped with its own time (microseconds), or drops. Independent
    background processes: per-operator web UI sessions (lognormal gaps
    thinned by a UTC hour curve; random typos give 44002 denials before
    the 44003 grant, sometimes a give-up), user-started backup job
    sessions (110, one 10010 per VM, 190) launched from sessions,
    SYSTEM retention removal of the oldest point (10050), manual point
    cleanup by operators (10050), and one planned retirement of a
    secondary repository (10050 + 28200). Times are in microseconds. -#}
{%- set ts = timestamp.astimezone(module.datetime.timezone.utc) -%}
{%- set now = module.builtins.int(ts.timestamp() * 1000000) -%}
{%- if shared.get('queue') is not none and now < shared.get('next_due') -%}{{- dispatch.drop() -}}{%- endif -%}
{%- set hq = module.heapq -%}
{%- set sec = 1000000 -%}
{%- set hour = 3600000000 -%}
{#- Chain window, counted from the first denial: see the 'del' item. -#}
{%- set window = 1800000000 -%}
{%- macro ln(med, sig) -%}
  {#- Lognormal seconds with median med; returns microseconds. -#}
  {{- module.builtins.int(module.rand.number.lognormal(module.math.log(med), sig) * 1000000) -}}
{%- endmacro -%}
{%- macro push(due, item) -%}
  {%- set s = shared.get('seq') + 1 -%}
  {%- do shared.set('seq', s) -%}
  {%- do module.heapq.heappush(shared.get('queue'), [due, s, item]) -%}
{%- endmacro -%}
{%- macro pick_start(lo, span) -%}
  {#- Time in [lo, lo + span) with its UTC hour weighted by the activity
      curve squared plus a small floor. -#}
  {%- set curve = shared.get('curve') -%}
  {%- set top = (curve | max) ** 2 + 0.02 -%}
  {%- set r = namespace(v=lo + module.rand.number.integer(0, span - 1), ok=false) -%}
  {%- for _ in range(500) if not r.ok -%}
    {%- set c = lo + module.rand.number.integer(0, span - 1) -%}
    {%- if module.rand.number.floating(0, top) < curve[(c // 3600000000) % 24] ** 2 + 0.02 -%}
      {%- set r.v = c -%}
      {%- set r.ok = true -%}
    {%- endif -%}
  {%- endfor -%}
  {{- r.v -}}
{%- endmacro -%}
{%- macro pick_user(skip) -%}
  {#- Operator weighted by session rate (1 / gap_h). -#}
  {%- set idx = range(samples.operators | length) | reject('equalto', skip) | list -%}
  {%- set ws = [] -%}
  {%- for i in idx -%}{%- do ws.append(1 / samples.operators[i].gap_h) -%}{%- endfor -%}
  {{- module.rand.weighted_choice(idx, ws) -}}
{%- endmacro -%}
{%- macro denials(first) -%}
  {#- Denials before a grant: 0 or 1, continued with probability 0.45,
      at most 5; first=2 draws the same count conditioned on >= 2. -#}
  {%- set n = namespace(v=first, go=first > 0) -%}
  {%- for _ in range(4) if n.go and n.v < 5 -%}
    {%- if module.rand.chance(0.45) -%}{%- set n.v = n.v + 1 -%}{%- else -%}{%- set n.go = false -%}{%- endif -%}
  {%- endfor -%}
  {{- n.v -}}
{%- endmacro -%}
{%- macro session(ui, ip, t, nd, grant, op) -%}
  {#- nd denials at t, then (if grant) the 44003 and the post-login
      operations; returns the grant time. -#}
  {%- set c = namespace(t=t) -%}
  {%- for _ in range(nd) -%}
    {{- push(c.t, {'k': 'row', 'id': 44002, 'u': ui, 'ip': ip}) -}}
    {%- set c.t = c.t + (ln(25, 0.7) | int) -%}
  {%- endfor -%}
  {%- if grant -%}
    {{- push(c.t, {'k': 'row', 'id': 44003, 'u': ui, 'ip': ip}) -}}
    {{- push(c.t, {'k': 'ops', 'u': ui, 'op': op}) -}}
  {%- endif -%}
  {{- c.t -}}
{%- endmacro -%}
{%- macro cleanup(ui, t, own) -%}
  {#- One to three manual point removals a few minutes after login. -#}
  {%- set r = module.rand.number.floating(0, 1) -%}
  {%- set k = 1 if r < 0.7 else 2 if r < 0.92 else 3 -%}
  {%- set c = namespace(t=t) -%}
  {%- for i in range(k) -%}
    {{- push(c.t, {'k': 'del', 'u': ui, 'own': own and i == 0}) -}}
    {%- set c.t = c.t + (ln(40, 0.7) | int) -%}
  {%- endfor -%}
{%- endmacro -%}
{%- macro dt(us) -%}
  {{- module.datetime.datetime.fromtimestamp(us / 1000000, module.datetime.timezone.utc).strftime('%m/%d/%Y %H:%M:%S') -}}
{%- endmacro -%}
{%- if shared.get('queue') is none -%}
  {%- set schema = {'type': 'typed-dict', 'fields': {
    'anomaly_mode': {'type': 'typed-dict-field', 'schema': {'type': 'bool', 'strict': true}},
    'anomaly_interval_hours': {'type': 'typed-dict-field', 'schema': {'type': 'float', 'ge': 2, 'le': 8760}}
  }} -%}
  {%- do module.pydantic_core.SchemaValidator(schema).validate_python({'anomaly_mode': params.anomaly_mode, 'anomaly_interval_hours': params.anomaly_interval_hours}) -%}
  {#- Relative operator activity by UTC hour (peak 1): sessions are
      thinned by it; episode starts are weighted by its square. -#}
  {%- do shared.update({'queue': [], 'seq': 0, 'last_us': now - 1, 'auth': {}, 'running': [], 'ep_user': none, 'ep_vm': none, 'curve': [0.08, 0.06, 0.05, 0.05, 0.06, 0.1, 0.25, 0.55, 0.85, 1.0, 1.0, 0.95, 0.85, 0.95, 1.0, 1.0, 0.9, 0.7, 0.45, 0.3, 0.2, 0.15, 0.12, 0.1]}) -%}
  {#- Restore points already on the active repository, per VM (job
      index, VM index): oldest first, all from finished sessions. -#}
  {%- set points = {} -%}
  {%- for job in samples.jobs -%}
    {%- set ji = loop.index0 -%}
    {%- for vm in job.vms -%}
      {%- set lst = [] -%}
      {%- set c = namespace(t=now) -%}
      {%- for _ in range(module.rand.number.integer(2, job.retention)) -%}
        {%- set c.t = c.t - (ln(43200, 0.6) | int) -%}
        {%- do lst.insert(0, {'oib': module.rand.crypto.uuid4() | string, 'dt': dt(c.t), 'size': (module.builtins.int(vm.size * module.rand.number.lognormal(0, 0.06)) // 4096) * 4096, 'sid': none}) -%}
      {%- endfor -%}
      {%- do points.update({ji ~ ':' ~ loop.index0: lst}) -%}
    {%- endfor -%}
  {%- endfor -%}
  {%- do shared.set('points', points) -%}
  {%- for row in samples.operators -%}
    {{- push(now + module.builtins.int(module.rand.number.floating(0, 1) * (ln(row.gap_h * 3600, 0.8) | int)), {'k': 'sess', 'u': loop.index0}) -}}
  {%- endfor -%}
  {#- Planned retirement of the unused secondary repository: once, at a
      curve-weighted time within the first three days. -#}
  {%- set sj = module.rand.number.integer(0, samples.jobs | length - 1) -%}
  {%- set sv = module.rand.number.integer(0, samples.jobs[sj].vms | length - 1) -%}
  {%- do shared.set('secondary', {'j': sj, 'v': sv, 'dt': dt(now - (ln(20 * 86400, 0.4) | int)), 'present': true}) -%}
  {{- push(pick_start(now + 6 * hour, 66 * hour) | int, {'k': 'ret'}) -}}
  {%- set interval = module.builtins.int(params.anomaly_interval_hours * hour) -%}
  {%- if params.anomaly_mode -%}
    {{- push(pick_start(now, [interval, 24 * hour] | min) | int + (ln(120, 0.8) | int), {'k': 'ep'}) -}}
  {%- endif -%}
{%- endif -%}
{%- set queue = shared.get('queue') -%}
{%- set curve = shared.get('curve') -%}
{%- set points = shared.get('points') -%}
{%- set running = shared.get('running') -%}
{%- set auth = shared.get('auth') -%}
{%- set interval = module.builtins.int(params.anomaly_interval_hours * hour) -%}
{%- if now < queue[0][0] -%}
  {%- do shared.set('next_due', queue[0][0]) -%}
  {{- dispatch.drop() -}}
{%- endif -%}
{%- set out = namespace(row=none, rec=0) -%}
{%- for _ in range(64) if out.row is none and queue and queue[0][0] <= now -%}
  {%- set top = hq.heappop(queue) -%}
  {%- set due = top[0] -%}
  {%- set item = top[2] -%}
  {%- set emit = namespace(v=none) -%}
  {%- if item.k == 'row' -%}
    {%- set emit.v = item -%}
    {%- if item.id in [44002, 44003] -%}
      {#- Authorization history of the operator, kept for one window. -#}
      {%- set hist = auth.setdefault(item.u, []) -%}
      {%- do hist.append([due, item.id, item.ip]) -%}
      {%- for _ in range(hist | length) if hist and hist[0][0] < due - window - 60 * sec -%}{%- do hist.pop(0) -%}{%- endfor -%}
    {%- endif -%}
  {%- elif item.k == 'sess' -%}
    {#- Session arrival of one operator, thinned by the hour curve. -#}
    {%- set op = samples.operators[item.u] -%}
    {{- push(due + (ln(op.gap_h * 3600, 0.8) | int), item) -}}
    {%- if module.rand.chance(curve[(due // hour) % 24]) -%}
      {%- set ip = module.rand.weighted_choice(op.ips, op.ip_weights) -%}
      {%- set nd = denials(1 if module.rand.chance(op.fail) else 0) | int -%}
      {%- set _ = session(item.u, ip, due, nd, nd == 0 or module.rand.chance(0.85), 'work') -%}
    {%- endif -%}
  {%- elif item.k == 'ops' -%}
    {#- After a grant: maybe start an idle job, maybe clean up points. -#}
    {%- if item.op == 'retire' -%}
      {{- push(due + (ln(240, 0.9) | int), {'k': 'del', 'u': item.u, 'sec': true}) -}}
    {%- else -%}
      {#- Ordinary and episode logons alike may start a job; the episode's
          cleanup is scheduled by the episode itself. -#}
      {%- if module.rand.chance(0.3) -%}
        {{- push(due + (ln(90, 0.8) | int), {'k': 'run', 'u': item.u, 'j': module.rand.number.integer(0, samples.jobs | length - 1)}) -}}
      {%- endif -%}
      {%- if item.op == 'work' and module.rand.chance(0.2) -%}
        {{- cleanup(item.u, due + (ln(240, 0.9) | int), false) -}}
      {%- endif -%}
    {%- endif -%}
  {%- elif item.k == 'run' -%}
    {#- A user-started job session, unless that job is already running:
        110, one 10010 per VM (snapshot time as DateTime), then 190. -#}
    {%- if item.j not in running -%}
      {%- do running.append(item.j) -%}
      {%- set job = samples.jobs[item.j] -%}
      {%- set sid = module.rand.crypto.uuid4() | string -%}
      {{- push(due, {'k': 'row', 'id': 110, 'u': item.u, 'j': item.j, 'sid': sid}) -}}
      {%- set c = namespace(t=due + (ln(40, 0.5) | int)) -%}
      {%- for vm in job.vms -%}
        {%- set snap = c.t -%}
        {%- set c.t = c.t + (ln(150, 0.6) | int) -%}
        {{- push(c.t, {'k': 'pt', 'j': item.j, 'v': loop.index0, 'sid': sid, 'dt': dt(snap), 'size': (module.builtins.int(vm.size * module.rand.number.lognormal(0, 0.06)) // 4096) * 4096}) -}}
        {%- set c.t = c.t + (ln(4, 0.8) | int) -%}
      {%- endfor -%}
      {{- push(c.t + (ln(6, 0.6) | int), {'k': 'fin', 'j': item.j, 'sid': sid}) -}}
    {%- endif -%}
  {%- elif item.k == 'pt' -%}
    {#- Restore point created; SYSTEM retention removes the oldest point
        of that VM once the retention count is exceeded. -#}
    {%- set lst = points[item.j ~ ':' ~ item.v] -%}
    {%- set oib = module.rand.crypto.uuid4() | string -%}
    {%- do lst.append({'oib': oib, 'dt': item.dt, 'size': item.size, 'sid': item.sid}) -%}
    {%- set emit.v = {'id': 10010, 'j': item.j, 'v': item.v, 'p': lst[-1]} -%}
    {%- if lst | length > samples.jobs[item.j].retention -%}
      {{- push(due + (ln(3, 0.8) | int), {'k': 'del', 'u': none, 'j': item.j, 'v': item.v, 'oib': lst[0].oib}) -}}
    {%- endif -%}
  {%- elif item.k == 'fin' -%}
    {%- for key, lst in points.items() -%}
      {%- for p in lst if p.sid == item.sid -%}{%- do p.update({'sid': none}) -%}{%- endfor -%}
    {%- endfor -%}
    {%- if item.j in running -%}{%- do running.remove(item.j) -%}{%- endif -%}
    {%- set emit.v = {'id': 190, 'j': item.j, 'sid': item.sid} -%}
  {%- elif item.k == 'del' -%}
    {#- Point removal. A manual removal that would complete the chain
        (the same operator denied twice and then granted from one address,
        the first denial within the window) is dropped at its own time and
        the point stays; the operator and the time are never changed. -#}
    {%- set guard = namespace(hit=false) -%}
    {%- if item.u is not none and not item.get('own') -%}
      {%- set hist = auth.get(item.u, []) -%}
      {%- for i in range(hist | length) if not guard.hit and hist[i][1] == 44002 and hist[i][0] >= due - window -%}
        {%- set h = hist[i] -%}
        {%- set st = namespace(n=1) -%}
        {%- for g in hist[i + 1:] -%}
          {%- if st.n == 1 and g[1] == 44002 and g[2] == h[2] -%}{%- set st.n = 2 -%}
          {%- elif st.n == 2 and g[1] == 44003 and g[2] == h[2] -%}{%- set st.n = 3 -%}{%- endif -%}
        {%- endfor -%}
        {%- if st.n == 3 -%}{%- set guard.hit = true -%}{%- endif -%}
      {%- endfor -%}
    {%- endif -%}
    {%- if item.get('sec') -%}
      {#- The repository is removed after the point, whether or not the
          guard dropped that removal (Veeam leaves the files in place). -#}
      {{- push(due + (ln(900, 0.8) | int), {'k': 'row', 'id': 28200, 'u': item.u}) -}}
    {%- endif -%}
    {%- if not guard.hit -%}
      {%- if item.get('sec') -%}
        {%- set s2 = shared.get('secondary') -%}
        {%- if s2.present -%}
          {%- do s2.update({'present': false}) -%}
          {%- set emit.v = {'id': 10050, 'u': item.u, 'j': s2.j, 'v': s2.v, 'p': {'oib': params.retired_point_id, 'dt': s2.dt, 'size': (module.builtins.int(samples.jobs[s2.j].vms[s2.v].size * 1.03) // 4096) * 4096}, 'repo': params.repository_id} -%}
        {%- endif -%}
      {%- elif item.get('oib') -%}
        {%- set lst = points[item.j ~ ':' ~ item.v] -%}
        {%- for p in lst if p.oib == item.oib -%}
          {%- set emit.v = {'id': 10050, 'u': none, 'j': item.j, 'v': item.v, 'p': p} -%}
        {%- endfor -%}
        {%- if emit.v is not none -%}{%- do lst.remove(emit.v.p) -%}{%- endif -%}
      {%- else -%}
        {#- Manual cleanup: a random finished point of a random VM (other
            than the previous episode's VM for an episode). -#}
        {%- set keys = [] -%}
        {%- for key, lst in points.items() -%}
          {%- if key != (shared.get('ep_vm') if item.get('own') else none) and lst | selectattr('sid', 'none') | list -%}{%- do keys.append(key) -%}{%- endif -%}
        {%- endfor -%}
        {%- if keys -%}
          {%- set key = module.rand.choice(keys) -%}
          {%- set lst = points[key] -%}
          {%- set p = module.rand.choice(lst | selectattr('sid', 'none') | list) -%}
          {%- do lst.remove(p) -%}
          {%- set jv = key.split(':') -%}
          {%- set emit.v = {'id': 10050, 'u': item.u, 'j': jv[0] | int, 'v': jv[1] | int, 'p': p} -%}
          {%- if item.get('own') -%}
            {%- do shared.set('ep_vm', key) -%}
            {%- do auth.update({item.u: []}) -%}
          {%- endif -%}
        {%- endif -%}
      {%- endif -%}
    {%- endif -%}
  {%- elif item.k == 'ret' -%}
    {#- Planned retirement: an operator logs in, removes the pre-existing
        secondary point, then the repository. -#}
    {%- set ui = pick_user(none) | int -%}
    {%- set op = samples.operators[ui] -%}
    {%- set nd = denials(1 if module.rand.chance(op.fail) else 0) | int -%}
    {%- set _ = session(ui, module.rand.weighted_choice(op.ips, op.ip_weights), due, nd, true, 'retire') -%}
  {%- elif item.k == 'ep' -%}
    {#- Episode: an operator other than the previous episode's fails the
        password at least twice from one of their addresses, logs in, and
        removes a finished restore point of a VM other than the previous
        episode's within the chain window. The first start falls within
        the first min(interval, 24 h); each later start within a window of
        min(interval / 4, 6 h) centred one interval after the actual
        start, weighted by the activity curve squared, plus a random
        delay. Missed episodes are not replayed. -#}
    {%- set ui = pick_user(shared.get('ep_user')) | int -%}
    {%- set op = samples.operators[ui] -%}
    {%- set t_grant = session(ui, module.rand.weighted_choice(op.ips, op.ip_weights), due, denials(2) | int, true, 'episode') | int -%}
    {%- set d = namespace(v=ln(240, 0.9) | int) -%}
    {%- for _ in range(50) if t_grant + d.v > due + window - 30 * sec -%}{%- set d.v = ln(240, 0.9) | int -%}{%- endfor -%}
    {{- cleanup(ui, t_grant + d.v, true) -}}
    {%- set w = [interval // 4, 6 * hour] | min -%}
    {%- do shared.set('ep_user', ui) -%}
    {{- push(pick_start(due + interval - w // 2, w) | int + (ln(120, 0.8) | int), {'k': 'ep'}) -}}
  {%- endif -%}
  {%- if emit.v is not none -%}
    {%- set out.row = emit.v -%}
    {%- set out.rec = [due, shared.get('last_us') + 1] | max -%}
    {%- do shared.set('last_us', out.rec) -%}
  {%- endif -%}
{%- endfor -%}
{%- do shared.set('next_due', queue[0][0] if queue else now + 1000000) -%}
{%- if out.row is none -%}{{- dispatch.drop() -}}{%- endif -%}
{%- set row = out.row -%}
{%- set moment = (ts + module.datetime.timedelta(microseconds=out.rec - now)).isoformat(timespec='microseconds') -%}
{%- set event_id = row.id -%}
{%- set username = samples.operators[row.u].name if row.get('u') is not none else none -%}
{%- set qualified_user = params.user_domain ~ '\\' ~ username if username else 'SYSTEM' -%}
{%- set kind = {44002: 'denied', 44003: 'granted', 110: 'job_start', 190: 'job_finish', 10010: 'point_created', 10050: 'restore', 28200: 'repository'}[event_id] -%}
{%- set event_action = {'denied': 'authorization_denied', 'granted': 'authorization_granted', 'job_start': 'backup_job_started', 'job_finish': 'backup_job_finished', 'point_created': 'restore_point_created', 'restore': 'restore_point_deleted', 'repository': 'backup_repository_deleted'}[kind] -%}
{%- set severity = 'warning' if kind in ['denied', 'restore', 'repository'] else 'info' -%}
{%- set app = 'Veeam_Security' if kind in ['denied', 'granted'] else 'Veeam_MP' -%}
{%- set attrs = {} -%}
{%- if kind in ['denied', 'granted'] -%}
  {%- do attrs.update({'SourceIpAddress': row.ip, 'ClientId': 'veeam-backup-web-ui', 'FriendlyName': username, 'Subject': 'UID-' ~ username, 'ResourceId': 'veeam-gateway-api-service', 'RedirectUri': '/'}) -%}
  {%- if kind == 'denied' -%}
    {%- do attrs.update({'Reason': '1'}) -%}
    {%- set description = 'Authorization request was denied: an authentication has failed.' -%}
  {%- else -%}
    {%- set description = 'Authorization was successful.' -%}
  {%- endif -%}
{%- elif kind in ['job_start', 'job_finish'] -%}
  {%- set job = samples.jobs[row.j] -%}
  {%- do attrs.update({'JobSessionID': row.sid, 'JobID': job.id}) -%}
  {%- if kind == 'job_finish' -%}
    {%- do attrs.update({'JobResult': '0'}) -%}
  {%- endif -%}
  {%- do attrs.update({'JobType': '0', 'Platform': '0'}) -%}
  {%- if kind == 'job_start' -%}
    {%- do attrs.update({'Flags': '1'}) -%}
    {%- set description = "Backup job '" ~ job.name ~ "' has been started by user " ~ qualified_user ~ '.' -%}
  {%- else -%}
    {%- do attrs.update({'WillBeRetried': 'False', 'JobName': job.name}) -%}
    {%- set description = "Backup job '" ~ job.name ~ "' finished with Success. All objects have been backed up successfully." -%}
  {%- endif -%}
  {%- do attrs.update({'SourceType': '2'}) -%}
{%- elif kind in ['point_created', 'restore'] -%}
  {%- set vm = samples.jobs[row.j].vms[row.v] -%}
  {%- do attrs.update({'OibID': row.p.oib, 'OriginalOibID': row.p.oib, 'VmRef': vm.ref, 'VmName': vm.name, 'ServerName': params.hypervisor_server, 'DateTime': row.p.dt, 'IsCorrupted': 'False', 'Platform': '0', 'StorageSize': row.p.size | string, 'RepositoryID': row.get('repo') or params.active_repository_id, 'IsFull': 'True', 'UserFullInfo': '<ModifiedUserInfo fullName="' ~ ('SYSTEM' if kind == 'point_created' else qualified_user) ~ '" loginType="0" />'}) -%}
  {%- if kind == 'point_created' -%}
    {%- set description = "VM '" ~ vm.name ~ "' restore point has been created." -%}
  {%- else -%}
    {%- set description = "Restore point for VM '" ~ vm.name ~ "' has been removed by user " ~ qualified_user ~ '.' -%}
  {%- endif -%}
{%- else -%}
  {%- do attrs.update({'RepositoryID': params.repository_id, 'Type': '0', 'RepositoryName': params.repository_name, 'ChangesXML': '<changes><object id="' ~ params.repository_id ~ '" name="' ~ params.repository_name ~ '" /></changes>', 'UserName': qualified_user, 'UserFullInfo': '<ModifiedUserInfo fullName="' ~ qualified_user ~ '" loginType="0" />'}) -%}
  {%- set description = 'Backup repository ' ~ params.repository_name ~ ' has been deleted.' -%}
{%- endif -%}
{%- do attrs.update({'VbrHostName': params.server_fqdn, 'VbrVersion': params.version, 'Version': '1', 'Description': description}) -%}
{%- set parts = [] -%}
{%- for key, value in attrs.items() -%}
  {%- do parts.append(key ~ '="' ~ value ~ '"') -%}
{%- endfor -%}
{%- set original = '1 ' ~ moment ~ ' ' ~ params.server_name ~ ' ' ~ app ~ ' - - [origin enterpriseId="31023"] [categoryId=0 instanceId=' ~ event_id ~ ' ' ~ parts | join(' ') ~ ']' -%}
{
  "@timestamp": {{ moment | tojson }},
  "ecs": {"version": "8.17.0"},
  "event": {"kind": "event", "module": "veeam", "dataset": "veeam.vbr.syslog", "code": {{ event_id | string | tojson }}, "category": {{ (['authentication'] if kind in ['denied', 'granted'] else ['configuration'] if kind == 'repository' else ['file'] if kind in ['point_created', 'restore'] else ['process']) | tojson }}, "action": {{ event_action | tojson }}, "type": {{ (['denied'] if kind == 'denied' else ['allowed'] if kind == 'granted' else ['start'] if kind == 'job_start' else ['end'] if kind == 'job_finish' else ['creation'] if kind == 'point_created' else ['deletion']) | tojson }}, "outcome": {{ ('failure' if kind == 'denied' else 'success') | tojson }}, "original": {{ original | tojson }}},
  "message": {{ description | tojson }},
  "host": {"name": {{ params.server_name | tojson }}},
  {% if kind in ['denied', 'granted'] %}"source": {"ip": {{ row.ip | tojson }}}, {% endif %}
  {% if username %}"user": {"name": {{ username | tojson }}}, {% endif %}
  "veeam": {"event_id": {{ event_id }}, "app": {{ app | tojson }}, "severity": {{ severity | tojson }}, "enterprise_id": 31023, "category_id": 0, "parameters": {{ attrs | tojson }}}
}
