{#- Yandex Cloud Audit Trails management events inside ECS JSON.
    One input tick per second; each tick emits the earliest due record,
    stamped with its own time, or drops. Every operator runs an
    independent session process: Poisson arrivals thinned by a UTC hour
    curve, a random number of operations with lognormal gaps. Created
    VMs, service accounts, folder roles and static keys carry their own
    lognormal lifetimes and are removed through native delete events.
    Times are in microseconds. -#}
{%- set ts = timestamp.astimezone(module.datetime.timezone.utc) -%}
{%- set now = module.builtins.int(ts.timestamp() * 1000000) -%}
{%- if shared.get('queue') is not none and now < shared.get('next_due') and not (params.anomaly_mode and now >= shared.get('ep_due')) -%}{{- dispatch.drop() -}}{%- endif -%}
{%- set hq = module.heapq -%}
{%- set hour = 3600000000 -%}
{#- Chain window, counted from the service-account creation. -#}
{%- set window = 1800000000 -%}
{%- macro ln(med, sig) -%}
  {#- Lognormal seconds with median med; returns microseconds. -#}
  {{- module.builtins.int(module.rand.number.lognormal(module.math.log(med), sig) * 1000000) -}}
{%- endmacro -%}
{%- macro push(due, item) -%}
  {%- set s = shared.get('seq') + 1 -%}
  {%- do shared.set('seq', s) -%}
  {%- do module.heapq.heappush(shared.get('queue'), [due, s, item]) -%}
{%- endmacro -%}
{%- macro pick_start(lo, span) -%}
  {#- Time in [lo, lo + span) with its UTC hour weighted by the activity
      curve squared plus a small floor. -#}
  {%- set curve = shared.get('curve') -%}
  {%- set top = (curve | max) ** 2 + 0.02 -%}
  {%- set r = namespace(v=lo + module.rand.number.integer(0, span - 1), ok=false) -%}
  {%- for _ in range(500) if not r.ok -%}
    {%- set c = lo + module.rand.number.integer(0, span - 1) -%}
    {%- if module.rand.number.floating(0, top) < curve[(c // 3600000000) % 24] ** 2 + 0.02 -%}
      {%- set r.v = c -%}
      {%- set r.ok = true -%}
    {%- endif -%}
  {%- endfor -%}
  {{- r.v -}}
{%- endmacro -%}
{%- macro pick_op(exclude) -%}
  {#- Operator index weighted by session rate, other than exclude. -#}
  {%- set idx = range(samples.operators | length) | reject('equalto', exclude) | list -%}
  {%- set ws = [] -%}
  {%- for i in idx -%}{%- do ws.append(1 / samples.operators[i].gap_h) -%}{%- endfor -%}
  {{- module.rand.weighted_choice(idx, ws) -}}
{%- endmacro -%}
{%- macro addr(o) -%}
  {{- samples.operators[o].ips[0] if module.rand.chance(0.85) else samples.operators[o].ips[1] -}}
{%- endmacro -%}
{%- macro later(o) -%}
  {#- Operator of a follow-up job: usually the same one. -#}
  {{- o if module.rand.chance(0.6) else pick_op(o) -}}
{%- endmacro -%}
{%- macro row(t, o, ip, kind, details, sa) -%}
  {{- push(t, {'k': 'row', 'o': o, 'ip': ip, 'kind': kind, 'd': details, 'sa': sa}) -}}
{%- endmacro -%}
{%- if shared.get('queue') is none -%}
  {%- set schema = {'type': 'typed-dict', 'fields': {
    'anomaly_mode': {'type': 'typed-dict-field', 'schema': {'type': 'bool', 'strict': true}},
    'anomaly_interval_hours': {'type': 'typed-dict-field', 'schema': {'type': 'float', 'ge': 2, 'le': 8760}}
  }} -%}
  {%- do module.pydantic_core.SchemaValidator(schema).validate_python({'anomaly_mode': params.anomaly_mode, 'anomaly_interval_hours': params.anomaly_interval_hours}) -%}
  {#- Relative activity by UTC hour (peak 1), office hours of UTC+3.
      Sessions are thinned by it; episode starts are weighted by its
      square. -#}
  {%- do shared.update({'queue': [], 'seq': 0, 'last_us': now - 1, 'acc': {}, 'vms': {}, 'pipe': module.rand.number.integer(20000, 60000), 'ep_last': -1, 'curve': [0.06, 0.05, 0.05, 0.06, 0.12, 0.3, 0.6, 0.9, 1.0, 1.0, 0.95, 0.85, 0.95, 1.0, 0.9, 0.7, 0.45, 0.3, 0.2, 0.14, 0.1, 0.08, 0.07, 0.06]}) -%}
  {%- for i in range(samples.service_accounts | length) -%}
    {%- set a = samples.service_accounts[i] -%}
    {%- do shared.get('acc').update({a.id: {'name': a.name, 'by': -1, 'te': 0, 'roles': [], 'kz': [], 'm': false, 'ed': []}}) -%}
  {%- endfor -%}
  {%- for o in range(samples.operators | length) -%}
    {{- push(now + module.builtins.int(module.rand.number.floating(0, 1) * (ln(samples.operators[o].gap_h * 3600, 0.8) | int)), {'k': 'sess', 'o': o}) -}}
  {%- endfor -%}
  {%- set interval = module.builtins.int(params.anomaly_interval_hours * hour) -%}
  {%- do shared.set('ep_due', pick_start(now, [interval, 24 * hour] | min) | int) -%}
{%- endif -%}
{%- set queue = shared.get('queue') -%}
{%- set acc = shared.get('acc') -%}
{%- set vms = shared.get('vms') -%}
{%- set curve = shared.get('curve') -%}
{%- set interval = module.builtins.int(params.anomaly_interval_hours * hour) -%}
{#- Episode: at the first tick at or after the drawn start, and after a
    random delay, an operator other than the previous episode's
    provisions a fresh account. The first start falls within the first
    min(interval, 24 h); each later start within a window of
    min(interval / 4, 6 h) centred one interval after the actual start,
    weighted by the activity curve squared. Missed episodes are not
    replayed. -#}
{%- if params.anomaly_mode and now >= shared.get('ep_due') -%}
  {%- set o = pick_op(shared.get('ep_last')) | int -%}
  {{- push(now + (ln(150, 0.9) | int), {'k': 'ep', 'o': o, 'ip': addr(o)}) -}}
  {%- do shared.set('ep_due', now + 1000 * 24 * hour) -%}
{%- endif -%}
{%- if now < queue[0][0] -%}
  {%- do shared.set('next_due', queue[0][0]) -%}
  {{- dispatch.drop() -}}
{%- endif -%}
{%- set out = namespace(row=none, rec=0) -%}
{%- for _ in range(64) if out.row is none and queue and queue[0][0] <= now -%}
  {%- set top = hq.heappop(queue) -%}
  {%- set due = top[0] -%}
  {%- set item = top[2] -%}
  {%- set o = item.get('o') -%}
  {%- set ip = item.get('ip') -%}
  {%- if item.k == 'row' -%}
    {%- set out.row = item -%}
    {%- set out.rec = [due, shared.get('last_us') + 1] | max -%}
    {%- do shared.set('last_us', out.rec) -%}
    {%- if item.kind == 'CreateServiceAccount' and item.sa[0] in acc -%}
      {%- do acc[item.sa[0]].update({'te': out.rec}) -%}
    {%- endif -%}
  {%- elif item.k == 'sess' -%}
    {#- Session arrival, thinned by the curve of its UTC hour. -#}
    {{- push(due + (ln(samples.operators[o].gap_h * 3600, 0.8) | int), item) -}}
    {%- if module.rand.chance(curve[(due // hour) % 24]) -%}
      {%- set n = namespace(v=1, go=true) -%}
      {%- for _ in range(15) if n.go -%}
        {%- if module.rand.chance(0.68) -%}{%- set n.v = n.v + 1 -%}{%- else -%}{%- set n.go = false -%}{%- endif -%}
      {%- endfor -%}
      {{- push(due + (ln(20, 0.8) | int), {'k': 'op', 'o': o, 'ip': addr(o), 'left': n.v}) -}}
    {%- endif -%}
  {%- elif item.k == 'op' -%}
    {%- set kind = module.rand.weighted_choice(['upd', 'vmc', 'prov', 'maint', 'revoke', 'key', 'rot'], [54, 9, 9, 8, 6, 4, 3]) -%}
    {{- push(due, {'k': kind, 'o': o, 'ip': ip}) -}}
    {%- if item.left > 1 -%}
      {{- push(due + (ln(50, 1.0) | int), {'k': 'op', 'o': o, 'ip': ip, 'left': item.left - 1}) -}}
    {%- endif -%}
  {%- elif item.k == 'ep' -%}
    {%- set w = [interval // 4, 6 * hour] | min -%}
    {%- do shared.update({'ep_last': o, 'ep_due': pick_start(due + interval - w // 2, w) | int}) -%}
    {{- push(due, {'k': 'prov', 'o': o, 'ip': ip, 'ep': true}) -}}
  {%- elif item.k == 'upd' -%}
    {%- set pool = [] -%}
    {%- for i in range(samples.instances | length) -%}{%- do pool.append([samples.instances[i].id, samples.instances[i].name]) -%}{%- endfor -%}
    {%- for vid, vm in vms.items() -%}{%- do pool.append([vid, vm.name]) -%}{%- endfor -%}
    {%- set vm = module.rand.choice(pool) -%}
    {%- set labels = {'deployment': 'rollout-' ~ module.rand.number.integer(100, 999)} -%}
    {%- if module.rand.chance(0.3) -%}{%- do labels.update({'owner': module.rand.choice(['platform', 'payments', 'search', 'infra'])}) -%}{%- endif -%}
    {{- row(due, o, ip, 'UpdateInstance', {'instance_id': vm[0], 'instance_name': vm[1], 'labels': labels, 'update_mask': 'labels'}, none) -}}
  {%- elif item.k == 'vmc' -%}
    {%- if vms | length >= 8 -%}
      {{- push(due, {'k': 'upd', 'o': o, 'ip': ip}) -}}
    {%- else -%}
      {%- do shared.set('pipe', shared.get('pipe') + module.rand.number.integer(1, 60)) -%}
      {%- set vid = 'fhm' ~ module.rand.string.hex(17) | lower -%}
      {%- set name = 'ci-job-' ~ shared.get('pipe') -%}
      {%- set zone = module.rand.choice(['ru-central1-a', 'ru-central1-b', 'ru-central1-d']) -%}
      {%- set subnet = {'ru-central1-a': 'e9b0ba6b3ff9de4bb42d', 'ru-central1-b': 'e2l1ca7c4aa0ef5cc53e', 'ru-central1-d': 'fl82db8d5bb1fa6dd64f'}[zone] -%}
      {%- set v4 = {'address': '10.60.' ~ {'ru-central1-a': 20, 'ru-central1-b': 21, 'ru-central1-d': 22}[zone] ~ '.' ~ module.rand.number.integer(10, 250)} -%}
      {%- if module.rand.chance(0.3) -%}
        {%- do v4.update({'one_to_one_nat': {'address': '203.0.113.' ~ module.rand.number.integer(10, 250), 'ip_version': 'IPV4'}}) -%}
      {%- endif -%}
      {%- set mac = 'd0:0d:' ~ [module.rand.string.hex(2), module.rand.string.hex(2), module.rand.string.hex(2), module.rand.string.hex(2)] | join(':') | lower -%}
      {%- do vms.update({vid: {'name': name}}) -%}
      {{- row(due, o, ip, 'CreateInstance', {'instance_id': vid, 'instance_name': name, 'zone_id': zone, 'platform_id': 'standard-v3', 'metadata_keys': ['ssh-keys', 'user-data'], 'network_settings': {'type': 'STANDARD'}, 'placement_policy': {}, 'os': {'type': 'LINUX'}, 'product_ids': ['fd8j7i4d1e3f9a5b2c6d'], 'resources': {'memory': '4294967296', 'cores': '2', 'core_fraction': '100'}, 'boot_disk': {'mode': 'READ_WRITE', 'device_name': name ~ '-boot', 'auto_delete': true, 'disk_id': 'epd' ~ module.rand.string.hex(17) | lower}, 'network_interfaces': [{'index': '0', 'mac_address': mac, 'subnet_id': subnet, 'primary_v4_address': v4}], 'fqdn': vid ~ '.auto.internal'}, none) -}}
      {%- set o2 = later(o) | int -%}
      {{- push(due + (ln(9000, 0.7) | int), {'k': 'vmd', 'o': o2, 'ip': addr(o2), 'v': vid}) -}}
    {%- endif -%}
  {%- elif item.k == 'vmd' -%}
    {%- if item.v in vms -%}
      {%- set vm = vms.pop(item.v) -%}
      {{- row(due, o, ip, 'DeleteInstance', {'instance_id': item.v, 'instance_name': vm.name}, none) -}}
    {%- endif -%}
  {%- elif item.k == 'prov' -%}
    {%- set managed = acc.values() | selectattr('m') | list | length -%}
    {%- if not item.get('ep') and managed >= 40 -%}
      {{- push(due, {'k': 'upd', 'o': o, 'ip': ip}) -}}
    {%- else -%}
      {%- set hexid = module.rand.string.hex(17) | lower -%}
      {%- set sid = 'aje' ~ hexid -%}
      {%- set sname = params.service_account_prefix ~ '-' ~ hexid -%}
      {%- do acc.update({sid: {'name': sname, 'by': o, 'te': due, 'roles': [], 'kz': [], 'm': true, 'ed': []}}) -%}
      {{- row(due, o, ip, 'CreateServiceAccount', {'service_account_id': sid, 'service_account_name': sname, 'description': 'Maintenance automation', 'labels': {'team': 'infra'}, 'status': 'ACTIVE'}, [sid, sname]) -}}
      {#- Follow-up role and key on the new account. Both gaps share the
          background distribution; an episode redraws them until the
          whole sequence fits the chain window. -#}
      {%- set g = namespace(a=ln(90, 1.0) | int, b=ln(120, 1.0) | int) -%}
      {%- if item.get('ep') -%}
        {%- for _ in range(50) if g.a + g.b > window - 120000000 -%}
          {%- set g.a = ln(90, 1.0) | int -%}{%- set g.b = ln(120, 1.0) | int -%}
        {%- endfor -%}
        {{- push(due + g.a, {'k': 'grant', 'o': o, 'ip': ip, 's': sid, 'role': 'editor'}) -}}
        {{- push(due + g.a + g.b, {'k': 'key', 'o': o, 'ip': ip, 's': sid, 'ep': true}) -}}
      {%- else -%}
        {%- set do_grant = module.rand.chance(0.55) -%}
        {%- set do_key = module.rand.chance(0.45) -%}
        {%- set role = module.rand.weighted_choice(['viewer', 'editor', 'storage.editor', 'compute.editor'], [4, 3, 2, 1]) -%}
        {%- if do_grant and do_key and module.rand.chance(0.2) -%}
          {{- push(due + g.a, {'k': 'key', 'o': o, 'ip': ip, 's': sid}) -}}
          {{- push(due + g.a + g.b, {'k': 'grant', 'o': o, 'ip': ip, 's': sid, 'role': role}) -}}
        {%- else -%}
          {%- if do_grant -%}{{- push(due + g.a, {'k': 'grant', 'o': o, 'ip': ip, 's': sid, 'role': role}) -}}{%- endif -%}
          {%- if do_key -%}{{- push(due + (g.a if do_grant else 0) + g.b, {'k': 'key', 'o': o, 'ip': ip, 's': sid}) -}}{%- endif -%}
        {%- endif -%}
      {%- endif -%}
      {%- set o2 = later(o) | int -%}
      {{- push(due + (ln(30 * 3600, 0.6) | int), {'k': 'sad', 'o': o2, 'ip': addr(o2), 's': sid}) -}}
    {%- endif -%}
  {%- elif item.k == 'maint' -%}
    {#- Work on one existing account: a role, sometimes a key after it. -#}
    {%- set sid = module.rand.choice(acc.keys() | list) -%}
    {{- push(due, {'k': 'grant', 'o': o, 'ip': ip, 's': sid}) -}}
    {%- if module.rand.chance(0.35) -%}
      {{- push(due + (ln(120, 1.0) | int), {'k': 'key', 'o': o, 'ip': ip, 's': sid}) -}}
    {%- endif -%}
  {%- elif item.k == 'grant' -%}
    {%- if item.s in acc -%}
      {%- set a = acc[item.s] -%}
      {%- set free = ['viewer', 'editor', 'storage.editor', 'compute.editor'] | reject('in', a.roles) | list -%}
      {%- if item.get('role') and item.role not in a.roles -%}
        {%- set role = item.role -%}
      {%- elif free and not item.get('role') -%}
        {%- set ws = [] -%}
        {%- for r in free -%}{%- do ws.append({'viewer': 4, 'editor': 3, 'storage.editor': 2, 'compute.editor': 1}[r]) -%}{%- endfor -%}
        {%- set role = module.rand.weighted_choice(free, ws) -%}
      {%- else -%}
        {%- set role = none -%}
      {%- endif -%}
      {%- if role is not none -%}
        {%- do a.roles.append(role) -%}
        {%- if role == 'editor' -%}{%- do a.ed.append(o) -%}{%- endif -%}
        {{- row(due, o, ip, 'UpdateFolderAccessBindings', {'folder_id': params.folder_id, 'folder_name': 'production', 'access_binding_deltas': [{'action': 'ADD', 'access_binding': {'role_id': role, 'subject_id': item.s, 'subject_type': 'SERVICE_ACCOUNT', 'subject_name': a.name}}]}, [item.s, a.name]) -}}
      {%- elif a.roles and not item.get('role') -%}
        {{- push(due, {'k': 'revoke', 'o': o, 'ip': ip, 's': item.s}) -}}
      {%- endif -%}
    {%- endif -%}
  {%- elif item.k == 'revoke' -%}
    {%- set held = [] -%}
    {%- for sid, a in acc.items() if a.roles -%}{%- do held.append(sid) -%}{%- endfor -%}
    {%- set sid = item.get('s') or (module.rand.choice(held) if held else none) -%}
    {%- if sid is none or sid not in acc or not acc[sid].roles -%}
      {{- push(due, {'k': 'upd', 'o': o, 'ip': ip}) -}}
    {%- else -%}
      {%- set a = acc[sid] -%}
      {%- set role = module.rand.choice(a.roles) -%}
      {%- do a.roles.remove(role) -%}
      {{- row(due, o, ip, 'UpdateFolderAccessBindings', {'folder_id': params.folder_id, 'folder_name': 'production', 'access_binding_deltas': [{'action': 'REMOVE', 'access_binding': {'role_id': role, 'subject_id': sid, 'subject_type': 'SERVICE_ACCOUNT', 'subject_name': a.name}}]}, [sid, a.name]) -}}
    {%- endif -%}
  {%- elif item.k == 'key' -%}
    {%- set open = [] -%}
    {%- for sid, a in acc.items() if a.kz | length < 2 -%}{%- do open.append(sid) -%}{%- endfor -%}
    {%- set sid = item.get('s') or (module.rand.choice(open) if open else none) -%}
    {%- if sid is not none and sid in acc and (item.get('ep') or acc[sid].kz | length < 2) -%}
      {%- set a = acc[sid] -%}
      {#- Guard on the final chain step: a background key that would
          complete the chain (this operator created the account and added
          it as editor, and the account is at most one chain window old)
          is not issued. Event times are unchanged. -#}
      {%- if item.get('ep') or not (a.by == o and o in a.ed and due - a.te <= window) -%}
        {%- set akid = 'aje' ~ module.rand.string.hex(17) | lower -%}
        {%- set kid = 'YC' ~ module.rand.string.letters(23) -%}
        {%- set moment = module.datetime.datetime(1970, 1, 1, tzinfo=module.datetime.timezone.utc) + module.datetime.timedelta(microseconds=due) -%}
        {%- do a.kz.append(akid) -%}
        {{- row(due, o, ip, 'CreateAccessKey', {'access_key_id': akid, 'service_account_id': sid, 'service_account_name': a.name, 'key_id': kid, 'description': 'Maintenance automation', 'created_at': moment.strftime('%Y-%m-%dT%H:%M:%S.%fZ')}, [sid, a.name]) -}}
        {%- set o2 = later(o) | int -%}
        {{- push(due + (ln(20 * 3600, 0.8) | int), {'k': 'kd', 'o': o2, 'ip': addr(o2), 's': sid, 'akid': akid}) -}}
      {%- endif -%}
    {%- elif item.get('s') is none -%}
      {{- push(due, {'k': 'upd', 'o': o, 'ip': ip}) -}}
    {%- endif -%}
  {%- elif item.k == 'kd' -%}
    {%- if item.s in acc and item.akid in acc[item.s].kz -%}
      {%- set a = acc[item.s] -%}
      {%- do a.kz.remove(item.akid) -%}
      {{- row(due, o, ip, 'DeleteAccessKey', {'access_key_id': item.akid, 'service_account_id': item.s, 'service_account_name': a.name}, [item.s, a.name]) -}}
    {%- endif -%}
  {%- elif item.k == 'rot' -%}
    {#- Key rotation: revoke one key, issue a new one shortly after. -#}
    {%- set keyed = [] -%}
    {%- for sid, a in acc.items() if a.kz -%}{%- do keyed.append(sid) -%}{%- endfor -%}
    {%- if keyed -%}
      {%- set sid = module.rand.choice(keyed) -%}
      {{- push(due, {'k': 'kd', 'o': o, 'ip': ip, 's': sid, 'akid': module.rand.choice(acc[sid].kz)}) -}}
      {{- push(due + (ln(60, 0.9) | int), {'k': 'key', 'o': o, 'ip': ip, 's': sid}) -}}
    {%- else -%}
      {{- push(due, {'k': 'key', 'o': o, 'ip': ip}) -}}
    {%- endif -%}
  {%- elif item.k == 'sad' -%}
    {#- Account cleanup, one native call per step: keys, roles, account. -#}
    {%- if item.s in acc -%}
      {%- set a = acc[item.s] -%}
      {%- if a.kz -%}
        {{- push(due, {'k': 'kd', 'o': o, 'ip': ip, 's': item.s, 'akid': a.kz[0]}) -}}
      {%- elif a.roles -%}
        {{- push(due, {'k': 'revoke', 'o': o, 'ip': ip, 's': item.s}) -}}
      {%- else -%}
        {%- do acc.pop(item.s) -%}
        {{- row(due, o, ip, 'DeleteServiceAccount', {'service_account_id': item.s, 'service_account_name': a.name}, [item.s, a.name]) -}}
      {%- endif -%}
      {%- if a.kz or a.roles -%}
        {{- push(due + (ln(25, 0.8) | int), item) -}}
      {%- endif -%}
    {%- endif -%}
  {%- endif -%}
{%- endfor -%}
{%- do shared.set('next_due', queue[0][0] if queue else now + 1000000) -%}
{%- if out.row is none -%}{{- dispatch.drop() -}}{%- endif -%}
{%- set r = out.row -%}
{%- set op = samples.operators[r.o] -%}
{%- set kind = r.kind -%}
{%- set service = 'iam' if kind in ['CreateServiceAccount', 'DeleteServiceAccount', 'CreateAccessKey', 'DeleteAccessKey'] else ('resourcemanager' if kind == 'UpdateFolderAccessBindings' else 'compute') -%}
{%- set moment = module.datetime.datetime(1970, 1, 1, tzinfo=module.datetime.timezone.utc) + module.datetime.timedelta(microseconds=out.rec) -%}
{%- set stamp = moment.strftime('%Y-%m-%dT%H:%M:%S.%fZ') -%}
{%- set event_id = module.rand.crypto.uuid4() | string -%}
{%- set native = {'event_id': event_id, 'event_source': service, 'event_type': 'yandex.cloud.audit.' ~ service ~ '.' ~ kind, 'event_time': stamp, 'authentication': {'authenticated': true, 'subject_type': 'FEDERATED_USER_ACCOUNT', 'subject_id': op.id, 'subject_name': op.name, 'federation_id': 'bpffd0b1506f5e3af1f1', 'federation_name': 'contoso', 'federation_type': 'PRIVATE_FEDERATION'}, 'authorization': {'authorized': true}, 'resource_metadata': {'path': [{'resource_type': 'organization-manager.organization', 'resource_id': params.organization_id, 'resource_name': 'contoso-org'}, {'resource_type': 'resource-manager.cloud', 'resource_id': params.cloud_id, 'resource_name': 'contoso-cloud'}, {'resource_type': 'resource-manager.folder', 'resource_id': params.folder_id, 'resource_name': 'production'}]}, 'request_metadata': {'remote_address': r.ip, 'user_agent': 'yc/0.157', 'request_id': module.rand.crypto.uuid4() | string}, 'event_status': 'DONE', 'details': r.d} -%}
