{%- set step = vars.step -%}
{%- if step == 'routine' -%}
  {%- do shared.pop('to_anomaly', none) -%}
  {%- set count = shared.get('routine_count', 0) + 1 -%}
  {%- if count >= params.anomaly_interval_events -%}
    {%- do shared.set('routine_count', 0) -%}
    {%- if params.anomaly_mode -%}
      {%- do shared.set('arc_no', (shared.get('arc_no', 0) % 9999) + 1) -%}
      {%- do shared.set('to_anomaly', true) -%}
    {%- endif -%}
  {%- else -%}
    {%- do shared.set('routine_count', count) -%}
  {%- endif -%}
  {%- set kind = module.rand.weighted_choice(['CreateInstance', 'UpdateInstance', 'UpdateFolder'], [56, 29, 15]) -%}
{%- else -%}
  {%- set kind = {'create_account': 'CreateServiceAccount', 'grant_role': 'SetFolderAccessBindings', 'create_key': 'CreateAccessKey'}[step] -%}
{%- endif -%}
{%- set is_anomaly = step != 'routine' -%}
{%- set service = 'iam' if kind in ['CreateServiceAccount', 'CreateAccessKey'] else ('resourcemanager' if kind in ['SetFolderAccessBindings', 'UpdateFolder'] else 'compute') -%}
{%- set subject_id = params.anomaly_subject_id if is_anomaly else params.normal_subject_id -%}
{%- set subject_name = params.anomaly_subject_name if is_anomaly else params.normal_subject_name -%}
{%- set source_ip = params.anomaly_source_ip if is_anomaly else params.normal_source_ip -%}
{%- set service_account_id = params.created_service_account_id ~ ('%04d' % shared.get('arc_no', 1)) -%}
{%- set service_account_name = params.created_service_account_name ~ '-' ~ ('%04d' % shared.get('arc_no', 1)) -%}
{%- set event_id = module.rand.crypto.uuid4() | string -%}
{%- set request_id = module.rand.crypto.uuid4() | string -%}
{%- set details = {} -%}
{%- if kind == 'CreateServiceAccount' -%}
  {%- do details.update({'service_account_id': service_account_id, 'service_account_name': service_account_name, 'description': 'Maintenance automation', 'labels': {'team': 'infra'}, 'status': 'ACTIVE'}) -%}
{%- elif kind == 'SetFolderAccessBindings' -%}
  {%- do details.update({'folder_id': params.folder_id, 'folder_name': 'production', 'access_binding_deltas': [{'action': 'ADD', 'access_binding': {'role_id': 'editor', 'subject_id': service_account_id, 'subject_type': 'SERVICE_ACCOUNT', 'subject_name': service_account_name}}]}) -%}
{%- elif kind == 'CreateAccessKey' -%}
  {%- do details.update({'service_account_id': service_account_id, 'service_account_name': service_account_name, 'access_key_id': 'ajeaccesskey' ~ ('%04d' % shared.get('arc_no', 1)), 'key_id': 'ajekey' ~ ('%04d' % shared.get('arc_no', 1)), 'description': 'Maintenance automation', 'created_at': timestamp.isoformat()}) -%}
{%- elif kind == 'UpdateFolder' -%}
  {%- do details.update({'folder_id': params.folder_id, 'folder_name': 'production'}) -%}
{%- else -%}
  {%- do details.update({'instance_id': 'fhmlabvm000001', 'instance_name': 'lab-vm-01', 'zone_id': 'ru-central1-a'}) -%}
{%- endif -%}
{%- set native = {'event_id': event_id, 'event_source': service, 'event_type': 'yandex.cloud.audit.' ~ service ~ '.' ~ kind, 'event_time': timestamp.isoformat(), 'authentication': {'authenticated': true, 'subject_type': 'FEDERATED_USER_ACCOUNT', 'subject_id': subject_id, 'subject_name': subject_name, 'federation_id': 'bpfcontosofed001', 'federation_name': 'contoso', 'federation_type': 'PRIVATE_FEDERATION'}, 'authorization': {'authorized': true}, 'resource_metadata': {'path': [{'resource_type': 'organization-manager.organization', 'resource_id': params.organization_id, 'resource_name': 'contoso-org'}, {'resource_type': 'resource-manager.cloud', 'resource_id': params.cloud_id, 'resource_name': 'contoso-cloud'}, {'resource_type': 'resource-manager.folder', 'resource_id': params.folder_id, 'resource_name': 'production'}]}, 'request_metadata': {'remote_address': source_ip, 'user_agent': 'yc/0.157', 'request_id': request_id}, 'event_status': 'DONE', 'details': details, 'request_parameters': {}, 'response': {}} -%}
{
  "@timestamp": {{ timestamp.isoformat() | tojson }},
  "ecs": {"version": "8.17.0"},
  "event": {"kind": "event", "module": "yandex_cloud", "dataset": "yandex_cloud.audit", "id": {{ event_id | tojson }}, "action": {{ kind | tojson }}, "category": {{ (['iam'] if service in ['iam', 'resourcemanager'] else ['configuration']) | tojson }}, "type": ["change"], "outcome": "success", "original": {{ native | tojson | tojson }}},
  "source": {"ip": {{ source_ip | tojson }}},
  "user": {"id": {{ subject_id | tojson }}, "name": {{ subject_name | tojson }}},
  "cloud": {"provider": "yandex", "account": {"id": {{ params.cloud_id | tojson }}}},
  "yandex_cloud": {"audit": {{ native | tojson }}}
}
