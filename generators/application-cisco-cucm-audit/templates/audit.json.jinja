{#- Cisco Unified CM 14 application audit file rows (|LogMessage form of
    the Cisco DevNet Audit00000001.log example) wrapped in ECS JSON.
    One input tick per second; each tick emits the earliest due row,
    stamped with its own millisecond time, or drops. Every administrator
    runs an independent random schedule of Administration sessions.
    Durations are in milliseconds. -#}
{%- set ts = timestamp.astimezone(module.datetime.timezone.utc) -%}
{%- set now = module.builtins.int(ts.timestamp() * 1000) -%}
{%- set guard_ms = 10800000 -%}
{%- macro d(lo, med, sig, hi) -%}
  {#- Offset lognormal in seconds, upper tail redrawn; returns ms. -#}
  {%- set ns = namespace(v=lo + module.rand.number.lognormal(module.math.log(med), sig)) -%}
  {%- for _ in range(16) if ns.v > hi -%}
    {%- set ns.v = lo + module.rand.number.lognormal(module.math.log(med), sig) -%}
  {%- endfor -%}
  {{- ([ns.v, hi] | min) * 1000 -}}
{%- endmacro -%}
{%- macro op_gap() -%}{{- d(2, 35, 1.0, 1800) -}}{%- endmacro -%}
{%- macro quick_gap() -%}{{- d(1.5, 8, 0.7, 300) -}}{%- endmacro -%}
{%- macro absence(med_h) -%}{{- d(0, med_h * 3600, 1.0, med_h * 3600 * 25) -}}{%- endmacro -%}
{%- macro ms(v) -%}{{- module.builtins.int(v | float) -}}{%- endmacro -%}
{%- if shared.get('admins') is none -%}
  {%- set schema = {'type': 'typed-dict', 'fields': {
    'anomaly_mode': {'type': 'typed-dict-field', 'schema': {'type': 'bool', 'strict': true}},
    'anomaly_interval_hours': {'type': 'typed-dict-field', 'schema': {'type': 'float', 'ge': 6, 'le': 8760}},
    'cucm_node': {'type': 'typed-dict-field', 'schema': {'type': 'str', 'strict': true, 'pattern': '^[A-Za-z0-9][A-Za-z0-9.-]{0,62}$'}}
  }} -%}
  {%- do module.pydantic_core.SchemaValidator(schema).validate_python(params) -%}
  {%- set admins = [] -%}
  {%- for row in samples.admins -%}
    {%- do admins.append({'user': row.user, 'ip': row.ip, 'alt_ip': row.alt_ip, 'med': row.median_hours, 'stage': 'idle', 'ops': [], 'sip': row.ip, 'episode': false, 'resume': none, 'last_key': none, 'hist': [], 'due': now + module.builtins.int(module.rand.number.floating(0, 1) * (absence(row.median_hours) | float))}) -%}
  {%- endfor -%}
  {%- set nodes = {} -%}
  {%- for row in samples.processnodes -%}{%- do nodes.update({row.name: row.present}) -%}{%- endfor -%}
  {%- set interval = module.builtins.int(params.anomaly_interval_hours * 3600000) -%}
  {%- do shared.update({'admins': admins, 'nodes': nodes, 'touched': {}, 'reserved': none, 'last_ms': now - 1, 'next_due': admins | map(attribute='due') | min, 'ep_active': false, 'ep_last_admin': none, 'ep_last_key': none, 'ep_start': now + interval + module.builtins.int(module.rand.number.floating(0, [1800000, interval / 8] | min))}) -%}
{%- endif -%}
{%- set admins = shared.get('admins') -%}
{%- set nodes = shared.get('nodes') -%}
{%- set touched = shared.get('touched') -%}
{%- set interval = module.builtins.int(params.anomaly_interval_hours * 3600000) -%}
{#- Episode start: the first tick at or after due + random delay with an
    administrator out of session (weighted by own session rate, not the
    previous episode's, no own session due within 3 h, no add in the
    last 3 h) and an absent processnode key untouched for 3 h (not the
    previous episode's). The episode is an extra session: the
    administrator's own schedule resumes unchanged afterwards. The next
    due is one interval after this start. -#}
{%- if params.anomaly_mode and not shared.get('ep_active') and now >= shared.get('ep_start') -%}
  {%- set ca = [] -%}
  {%- for a in admins -%}
    {%- if a.stage == 'idle' and loop.index0 != shared.get('ep_last_admin') and a.due > now + guard_ms and not (a.hist | selectattr('1', 'equalto', 'add') | selectattr('0', 'ge', now - guard_ms) | list) -%}{%- do ca.append(loop.index0) -%}{%- endif -%}
  {%- endfor -%}
  {%- set ck = [] -%}
  {%- for name, present in nodes | dictsort -%}
    {%- if not present and name != shared.get('ep_last_key') and now - touched.get(name, -guard_ms) >= guard_ms -%}{%- do ck.append(name) -%}{%- endif -%}
  {%- endfor -%}
  {%- if ca and ck -%}
    {%- set cw = [] -%}
    {%- for i in ca -%}{%- do cw.append(1.0 / admins[i].med) -%}{%- endfor -%}
    {%- set ai = module.rand.weighted_choice(ca, cw) -%}
    {%- set key = module.rand.choice(ck) -%}
    {%- set a = admins[ai] -%}
    {%- set start = now + module.rand.number.integer(0, 999) -%}
    {%- set ops = [['add', key, false], ['upd', key, true]] -%}
    {%- set more = namespace(go=module.rand.chance(0.45)) -%}
    {%- for _ in range(6) if more.go -%}
      {%- do ops.append(['upd', none, false]) -%}
      {%- set more.go = module.rand.chance(0.45) -%}
    {%- endfor -%}
    {%- do ops.append(['del', key, false]) -%}
    {%- do a.update({'episode': true, 'resume': a.due, 'due': start, 'pending_ops': ops}) -%}
    {%- do shared.update({'ep_active': true, 'reserved': key, 'ep_last_admin': ai, 'ep_last_key': key, 'ep_start': start + interval + module.builtins.int(module.rand.number.floating(0, [1800000, interval / 8] | min)), 'next_due': [shared.get('next_due'), start] | min}) -%}
  {%- endif -%}
{%- endif -%}
{%- if now < shared.get('next_due') -%}{{- dispatch.drop() -}}{%- endif -%}
{%- macro chain_done(a, key, t) -%}
  {#- True when this administrator added and then updated the key within
      the guard window, so deleting it now would complete the chain. -#}
  {%- set ns = namespace(add=none, hit=false) -%}
  {%- for h in a.hist if t - h[0] <= guard_ms and h[2] == key -%}
    {%- if h[1] == 'add' -%}{%- set ns.add = h[0] -%}
    {%- elif h[1] == 'upd' and ns.add is not none -%}{%- set ns.hit = true -%}{%- endif -%}
  {%- endfor -%}
  {{- 'y' if ns.hit else '' -}}
{%- endmacro -%}
{%- set out = namespace(a=none, op=none, key=none, rec=0) -%}
{%- for _ in range(24) if out.op is none and (admins | map(attribute='due') | min) <= now -%}
  {%- set pick = namespace(i=none) -%}
  {%- for i in range(admins | length) if pick.i is none or admins[i].due < admins[pick.i].due -%}{%- set pick.i = i -%}{%- endfor -%}
  {%- set a = admins[pick.i] -%}
  {%- set rec = [a.due, shared.get('last_ms') + 1] | max -%}
  {%- set frame = namespace(op=none, key=none) -%}
  {%- set nxt = namespace(due=none) -%}
  {%- if a.stage == 'idle' -%}
    {%- set ops = [] -%}
    {%- if a.episode -%}
      {%- do ops.extend(a.pending_ops) -%}
    {%- elif module.rand.chance(0.6) -%}
      {%- set cnt = namespace(n=1, go=true) -%}
      {%- for _ in range(11) if cnt.go -%}
        {%- if module.rand.chance(0.55) -%}{%- set cnt.n = cnt.n + 1 -%}{%- else -%}{%- set cnt.go = false -%}{%- endif -%}
      {%- endfor -%}
      {%- for _ in range(cnt.n) -%}
        {%- do ops.append([module.rand.weighted_choice(['upd', 'add', 'del'], [50, 25, 25]), none, false]) -%}
      {%- endfor -%}
    {%- endif -%}
    {%- do a.update({'stage': 'sess', 'ops': ops, 'last_key': none, 'sip': a.ip if module.rand.chance(0.85) else a.alt_ip}) -%}
    {%- set frame.op = 'login' -%}
  {%- elif a.ops -%}
    {%- set op = a.ops.pop(0) -%}
    {%- set kind = op[0] -%}
    {%- set reserved = shared.get('reserved') -%}
    {%- if kind == 'add' -%}
      {%- set cand = [] -%}
      {%- for name, present in nodes | dictsort if not present and name != reserved -%}{%- do cand.append(name) -%}{%- endfor -%}
      {%- set key = op[1] if op[1] is not none else (module.rand.choice(cand) if cand else none) -%}
      {%- if key is not none and not nodes[key] -%}
        {%- do nodes.update({key: true}) -%}
        {%- set frame.op = 'add' -%}{%- set frame.key = key -%}
        {%- if not a.episode -%}
          {%- if module.rand.chance(0.5) -%}
            {%- do a.ops.insert(0, ['upd', key, true]) -%}
          {%- elif module.rand.chance(0.6) -%}
            {#- Added by mistake or for a test, removed in the session. -#}
            {%- do a.ops.insert(module.rand.number.integer(0, a.ops | length), ['del', key, false]) -%}
          {%- endif -%}
        {%- endif -%}
      {%- endif -%}
    {%- elif kind == 'upd' -%}
      {%- set cand = [] -%}
      {%- for name, present in nodes | dictsort if present and (name != reserved or a.episode) -%}{%- do cand.append(name) -%}{%- endfor -%}
      {%- if op[1] is not none -%}
        {%- set key = op[1] -%}
      {%- elif a.last_key in cand and module.rand.chance(0.4) -%}
        {%- set key = a.last_key -%}
      {%- else -%}
        {%- set key = module.rand.choice(cand) if cand else none -%}
      {%- endif -%}
      {%- if key is not none and nodes[key] -%}
        {%- set frame.op = 'upd' -%}{%- set frame.key = key -%}
        {%- if module.rand.chance(0.25) -%}
          {#- Saved again seconds later (a second field fixed). -#}
          {%- do a.ops.insert(0, ['upd', key, true]) -%}
        {%- elif not a.episode and op[1] is none and module.rand.chance(0.08) -%}
          {%- do a.ops.insert(module.rand.number.integer(0, a.ops | length), ['del', key, false]) -%}
        {%- endif -%}
      {%- endif -%}
    {%- else -%}
      {%- set cand = [] -%}
      {%- for name, present in nodes | dictsort if present and name != reserved -%}{%- do cand.append(name) -%}{%- endfor -%}
      {%- set key = op[1] if op[1] is not none else (module.rand.choice(cand) if cand | length > 2 else none) -%}
      {%- if key is not none and nodes[key] and (a.episode or not chain_done(a, key, rec)) -%}
        {%- do nodes.update({key: false}) -%}
        {%- set frame.op = 'del' -%}{%- set frame.key = key -%}
      {%- endif -%}
    {%- endif -%}
    {%- if frame.op is not none -%}
      {%- do a.update({'last_key': frame.key}) -%}
      {%- do a.hist.append([rec, frame.op, frame.key]) -%}
      {%- do touched.update({frame.key: rec}) -%}
    {%- endif -%}
    {%- set nxt.due = rec + (ms(quick_gap()) | int if a.ops and a.ops[0][2] else ms(op_gap()) | int) -%}
  {%- else -%}
    {#- Session end: explicit logout, or the browser is closed and no row
        is written. -#}
    {%- if module.rand.chance(0.75) -%}{%- set frame.op = 'logout' -%}{%- endif -%}
    {%- do a.update({'stage': 'idle'}) -%}
    {%- if a.episode -%}
      {%- do a.update({'episode': false, 'pending_ops': none}) -%}
      {%- do shared.update({'ep_active': false, 'reserved': none}) -%}
      {%- set nxt.due = [a.resume, rec + 1] | max -%}
    {%- else -%}
      {%- set nxt.due = rec + ms(absence(a.med)) | int -%}
    {%- endif -%}
  {%- endif -%}
  {%- if nxt.due is none -%}{%- set nxt.due = rec + ms(op_gap()) | int -%}{%- endif -%}
  {%- do a.update({'due': nxt.due}) -%}
  {#- Bounded guard memory: this administrator's operations of the last 3 h. -#}
  {%- for _ in range(a.hist | length) if a.hist and rec - a.hist[0][0] > guard_ms -%}{%- do a.hist.pop(0) -%}{%- endfor -%}
  {%- if frame.op is not none -%}
    {%- set out.a = a -%}{%- set out.op = frame.op -%}{%- set out.key = frame.key -%}{%- set out.rec = rec -%}
    {%- do shared.set('last_ms', rec) -%}
  {%- endif -%}
{%- endfor -%}
{%- do shared.set('next_due', admins | map(attribute='due') | min) -%}
{%- if out.op is none -%}{{- dispatch.drop() -}}{%- endif -%}
{%- set a = out.a -%}
{%- set op = out.op -%}
{%- set moment = ts + module.datetime.timedelta(milliseconds=out.rec - now) -%}
{%- set user_name = a.user -%}
{%- set client_ip = a.sip -%}
{%- set record = none -%}
{%- if op == 'login' -%}
  {%- set severity = 6 -%}
  {%- set event_type = 'UserLogging' -%}
  {%- set resource_accessed = 'Cisco CallManager Administration' -%}
  {%- set audit_category = 'AdministrativeEvent' -%}
  {%- set component_id = 'Cisco CallManager Administration' -%}
  {%- set details_raw = 'Successfully Logged into Cisco Unified CM Admin Webpages' -%}
  {%- set action = 'user_login' -%}
  {%- set ecs_category = ['authentication', 'session'] -%}
  {%- set ecs_type = ['start'] -%}
{%- elif op == 'logout' -%}
  {%- set severity = 6 -%}
  {%- set event_type = 'UserLogging' -%}
  {%- set resource_accessed = 'CUCMAdmin' -%}
  {%- set audit_category = 'CriticalEvent' -%}
  {%- set component_id = 'Cisco CUCM Administration' -%}
  {%- set details_raw = 'Successfully Logged out Cisco Unified Administration Web Pages' -%}
  {%- set action = 'user_logout' -%}
  {%- set ecs_category = ['authentication', 'session'] -%}
  {%- set ecs_type = ['end'] -%}
{%- else -%}
  {%- set operation = {'add': 'added', 'upd': 'updated', 'del': 'deleted'}[op] -%}
  {%- set severity = 5 -%}
  {%- set event_type = 'GeneralConfigurationUpdate' -%}
  {%- set resource_accessed = 'CUCMAdmin' -%}
  {%- set audit_category = 'AdministrativeEvent' -%}
  {%- set component_id = 'Cisco CUCM Administration' -%}
  {%- set details_raw = ' record in table processnode with key field name = ' ~ out.key ~ ' ' ~ operation ~ ' ' -%}
  {%- set record = {'table': 'processnode', 'key_field': 'name', 'key_value': out.key, 'operation': operation} -%}
  {%- set action = 'processnode_' ~ operation -%}
  {%- set ecs_category = ['configuration'] -%}
  {%- set ecs_type = [{'add': 'creation', 'upd': 'change', 'del': 'deletion'}[op]] -%}
{%- endif -%}
{%- set native_time = moment.strftime('%H:%M:%S.%f')[:-3] -%}
{%- set original = native_time ~ ' |LogMessage   UserID : ' ~ user_name ~ '  ClientAddress : ' ~ client_ip ~ '  Severity : ' ~ severity ~ '  EventType : ' ~ event_type ~ '  ResourceAccessed: ' ~ resource_accessed ~ '  EventStatus : Success  CompulsoryEvent : No  AuditCategory : ' ~ audit_category ~ '  ComponentID : ' ~ component_id ~ '  CorrelationID :   AuditDetails : ' ~ details_raw ~ ' App ID: Cisco Tomcat Cluster ID:  Node ID: ' ~ params.cucm_node -%}
{%- set details = details_raw | trim -%}
{%- set audit = {'timestamp_local': native_time, 'user_id': user_name, 'client_address': client_ip, 'severity': severity, 'event_type': event_type, 'resource_accessed': resource_accessed, 'event_status': 'Success', 'compulsory_event': 'No', 'audit_category': audit_category, 'component_id': component_id, 'correlation_id': '', 'audit_details': details, 'app_id': 'Cisco Tomcat', 'cluster_id': '', 'node_id': params.cucm_node} -%}
{%- if record is not none -%}{%- do audit.update({'record': record}) -%}{%- endif -%}
{%- set payload = {'@timestamp': moment.isoformat(timespec='milliseconds'), 'ecs': {'version': '8.17.0'}, 'event': {'kind': 'event', 'category': ecs_category, 'type': ecs_type, 'outcome': 'success', 'dataset': 'cucm.audit', 'module': 'cucm', 'action': action, 'code': event_type, 'original': original}, 'host': {'name': params.cucm_node}, 'service': {'name': 'Cisco Unified Communications Manager', 'version': '14.0.1.10000-20'}, 'user': {'name': user_name}, 'source': {'ip': client_ip}, 'related': {'user': [user_name], 'ip': [client_ip], 'hosts': [params.cucm_node]}, 'message': details, 'cucm': {'audit': audit}} -%}
{{- payload | tojson -}}
