{%- set actor = samples.actors.weighted_pick('weight') -%}
{%- set obj = samples.objects.weighted_pick('weight') -%}
{%- set phase = vars.phase -%}
{%- set arc_no = shared.get('arc_no', 1) -%}
{%- set svc_name = 'svc_audit_%03d' % arc_no -%}
{%- set name = actor.name -%}
{%- set user_id = actor.id -%}
{%- set computer = actor.computer -%}
{%- set session = shared.get('session_' ~ actor.name, actor.session) -%}
{%- set connection = shared.get('connection_' ~ actor.name, actor.connection) -%}
{%- set event_name = '_$Access$_.Access' -%}
{%- set presentation = 'Доступ.Доступ' -%}
{%- set category = ['database'] -%}
{%- set event_type = ['access'] -%}
{%- set outcome = 'success' -%}
{%- set level = 'Information' -%}
{%- set metadata_name = obj.metadata -%}
{%- set metadata_presentation = obj.presentation -%}
{%- set comment = '' -%}
{%- set data = {'Action': 'Read'} -%}
{%- set data_presentation = 'Чтение данных' -%}
{%- set transaction_status = 'NotApplicable' -%}
{%- set transaction_id = '' -%}
{%- set target_name = '' -%}

{%- if phase == 'routine' -%}
  {%- set routine_count = (shared.get('routine_count', 0) + 1) % 400 -%}
  {%- do shared.set('routine_count', routine_count) -%}
  {%- if params.anomaly_mode and routine_count == 20 -%}
    {%- do shared.set('arc_no', (shared.get('arc_no', 0) % 9999) + 1) -%}
    {%- do shared.set('to_probe', true) -%}
  {%- endif -%}
  {%- set kind = module.rand.weighted_choice(
      ['access', 'authentication', 'denied', 'user_update'],
      [870, 120, 9, 1]) -%}
  {%- if kind == 'authentication' -%}
    {%- set session = (session + 1) % 100000000 -%}
    {%- set connection = (connection + 1) % 100000000 -%}
    {%- do shared.set('session_' ~ name, session) -%}
    {%- do shared.set('connection_' ~ name, connection) -%}
    {%- set event_name = '_$Session$_.Authentication' -%}
    {%- set presentation = 'Сеанс.Аутентификация' -%}
    {%- set category = ['authentication'] -%}
    {%- set event_type = ['start'] -%}
    {%- set metadata_name = '' -%}
    {%- set metadata_presentation = '' -%}
    {%- set data = {'CurrentOSUser': name} -%}
    {%- set data_presentation = 'Аутентификация пользователя' -%}
  {%- elif kind == 'denied' -%}
    {%- set event_name = '_$Access$_.AccessDenied' -%}
    {%- set presentation = 'Доступ.Отказ в доступе' -%}
    {%- set event_type = ['access', 'denied'] -%}
    {%- set outcome = 'failure' -%}
    {%- set level = 'Warning' -%}
    {%- set data = {'Right': 'Read'} -%}
    {%- set data_presentation = 'Отказ в чтении данных' -%}
  {%- elif kind == 'user_update' -%}
    {%- set name = 'admin01' -%}
    {%- set user_id = '00000000-0000-0000-0000-000000000105' -%}
    {%- set computer = 'ADM-WS-01' -%}
    {%- set session = shared.get('session_admin01', 1205) -%}
    {%- set connection = shared.get('connection_admin01', 305) -%}
    {%- set event_name = '_$User$_.Update' -%}
    {%- set presentation = 'Пользователи.Изменение пользователя' -%}
    {%- set category = ['iam'] -%}
    {%- set event_type = ['change'] -%}
    {%- set target_name = 'accountant02' -%}
    {%- set metadata_name = '' -%}
    {%- set metadata_presentation = '' -%}
    {%- set data = {'Name': target_name, 'LoginAllowed': true} -%}
    {%- set data_presentation = 'Изменены параметры пользователя' -%}
  {%- endif -%}
{%- elif phase == 'probe' -%}
  {%- do shared.pop('to_probe', none) -%}
  {%- set left = shared.get('probe_left', 4) - 1 -%}
  {%- do shared.set('probe_left', left) -%}
  {%- if left == 0 -%}
    {%- do shared.set('to_takeover', true) -%}
  {%- endif -%}
  {%- set name = 'admin01' -%}
  {%- set user_id = '00000000-0000-0000-0000-000000000105' -%}
  {%- set computer = 'UNMANAGED-WS-01' -%}
  {%- set session = 0 -%}
  {%- set connection = 0 -%}
  {%- set event_name = '_$Session$_.AuthenticationError' -%}
  {%- set presentation = 'Сеанс.Ошибка аутентификации' -%}
  {%- set category = ['authentication'] -%}
  {%- set event_type = ['start'] -%}
  {%- set outcome = 'failure' -%}
  {%- set level = 'Warning' -%}
  {%- set metadata_name = '' -%}
  {%- set metadata_presentation = '' -%}
  {%- set comment = 'Ошибка аутентификации' -%}
  {%- set data = {'CurrentOSUser': 'unknown'} -%}
  {%- set data_presentation = 'Неверные учетные данные' -%}
{%- elif phase == 'takeover' -%}
  {%- do shared.pop('to_takeover', none) -%}
  {%- set name = 'admin01' -%}
  {%- set user_id = '00000000-0000-0000-0000-000000000105' -%}
  {%- set computer = 'UNMANAGED-WS-01' -%}
  {%- set session = 90000 + arc_no * 2 -%}
  {%- set connection = 9000 + arc_no * 2 -%}
  {%- set event_name = '_$Session$_.Authentication' -%}
  {%- set presentation = 'Сеанс.Аутентификация' -%}
  {%- set category = ['authentication'] -%}
  {%- set event_type = ['start'] -%}
  {%- set metadata_name = '' -%}
  {%- set metadata_presentation = '' -%}
  {%- set data = {'CurrentOSUser': 'unknown'} -%}
  {%- set data_presentation = 'Аутентификация пользователя' -%}
{%- elif phase == 'new_user' -%}
  {%- set name = 'admin01' -%}
  {%- set user_id = '00000000-0000-0000-0000-000000000105' -%}
  {%- set computer = 'UNMANAGED-WS-01' -%}
  {%- set session = 90000 + arc_no * 2 -%}
  {%- set connection = 9000 + arc_no * 2 -%}
  {%- set event_name = '_$User$_.New' -%}
  {%- set presentation = 'Пользователи.Новый пользователь' -%}
  {%- set category = ['iam'] -%}
  {%- set event_type = ['creation'] -%}
  {%- set target_name = svc_name -%}
  {%- set metadata_name = '' -%}
  {%- set metadata_presentation = '' -%}
  {%- set data = {'Name': target_name, 'Roles': ['FullAccess'], 'LoginAllowed': true} -%}
  {%- set data_presentation = 'Создан пользователь с ролью FullAccess' -%}
{%- elif phase == 'backdoor_login' -%}
  {%- set name = svc_name -%}
  {%- set user_id = '00000000-0000-0000-0000-' ~ ('%012d' % (900 + arc_no)) -%}
  {%- set computer = 'UNMANAGED-WS-01' -%}
  {%- set session = 90001 + arc_no * 2 -%}
  {%- set connection = 9001 + arc_no * 2 -%}
  {%- set event_name = '_$Session$_.Authentication' -%}
  {%- set presentation = 'Сеанс.Аутентификация' -%}
  {%- set category = ['authentication'] -%}
  {%- set event_type = ['start'] -%}
  {%- set metadata_name = '' -%}
  {%- set metadata_presentation = '' -%}
  {%- set data = {'CurrentOSUser': 'unknown'} -%}
  {%- set data_presentation = 'Аутентификация пользователя' -%}
{%- elif phase == 'sensitive_access' -%}
  {%- set left = shared.get('reads_left', 12) - 1 -%}
  {%- do shared.set('reads_left', left) -%}
  {%- if left == 0 -%}
    {%- do shared.set('to_settings_update', true) -%}
  {%- endif -%}
  {%- set name = svc_name -%}
  {%- set user_id = '00000000-0000-0000-0000-' ~ ('%012d' % (900 + arc_no)) -%}
  {%- set computer = 'UNMANAGED-WS-01' -%}
  {%- set session = 90001 + arc_no * 2 -%}
  {%- set connection = 9001 + arc_no * 2 -%}
  {%- set metadata_name = 'InformationRegisters.PayrollAccruals' -%}
  {%- set metadata_presentation = 'Начисления сотрудников' -%}
  {%- set data = {'Action': 'Read', 'Fields': ['Employee', 'Amount'],
      'Employee': 'EMP-' ~ ('%04d' % (1000 + 12 - left))} -%}
  {%- set data_presentation = 'Чтение данных о начислениях' -%}
{%- elif phase == 'settings_update' -%}
  {%- do shared.pop('to_settings_update', none) -%}
  {%- set name = 'admin01' -%}
  {%- set user_id = '00000000-0000-0000-0000-000000000105' -%}
  {%- set computer = 'UNMANAGED-WS-01' -%}
  {%- set session = 90000 + arc_no * 2 -%}
  {%- set connection = 9000 + arc_no * 2 -%}
  {%- set event_name = '_$InfoBase$_.EventLogSettingsUpdate' -%}
  {%- set presentation = 'Информационная база.Изменение настроек журнала регистрации' -%}
  {%- set category = ['configuration'] -%}
  {%- set event_type = ['change'] -%}
  {%- set level = 'Warning' -%}
  {%- set metadata_name = '' -%}
  {%- set metadata_presentation = '' -%}
  {%- set comment = 'Изменен период разделения журнала' -%}
  {%- set data = {'SplitPeriod': 'Day'} -%}
  {%- set data_presentation = 'Период разделения изменен на день' -%}
{%- elif phase == 'log_reduce' -%}
  {%- do shared.set('probe_left', 4) -%}
  {%- do shared.set('reads_left', 12) -%}
  {%- set name = 'admin01' -%}
  {%- set user_id = '00000000-0000-0000-0000-000000000105' -%}
  {%- set computer = 'UNMANAGED-WS-01' -%}
  {%- set session = 90000 + arc_no * 2 -%}
  {%- set connection = 9000 + arc_no * 2 -%}
  {%- set event_name = '_$InfoBase$_.EventLogReduce' -%}
  {%- set presentation = 'Информационная база.Сокращение журнала регистрации' -%}
  {%- set category = ['configuration'] -%}
  {%- set event_type = ['deletion'] -%}
  {%- set level = 'Warning' -%}
  {%- set metadata_name = '' -%}
  {%- set metadata_presentation = '' -%}
  {%- set comment = 'Удалены старые записи журнала регистрации' -%}
  {%- set data = {} -%}
  {%- set data_presentation = 'Сокращение журнала регистрации' -%}
{%- endif -%}
{
  "@timestamp": {{ timestamp.isoformat() | tojson }},
  "ecs": {"version": {{ params.ecs_version | tojson }}},
  "event": {
    "kind": "event",
    "module": "one_c",
    "dataset": "one_c.event_log",
    "action": {{ event_name | tojson }},
    "category": {{ category | tojson }},
    "type": {{ event_type | tojson }},
    "outcome": {{ outcome | tojson }}
  },
  "host": {"name": {{ params.host_name | tojson }}},
  "service": {"name": {{ params.infobase | tojson }}},
  "user": {"id": {{ user_id | tojson }}, "name": {{ name | tojson }}
           {%- if target_name %}, "target": {"name": {{ target_name | tojson }} }{%- endif %}},
  "client": {"address": {{ computer | tojson }}},
  "related": {"user": [{{ name | tojson }}{%- if target_name %}, {{ target_name | tojson }}{%- endif %}],
              "hosts": [{{ computer | tojson }}]},
  "message": {{ presentation | tojson }},
  "one_c": {"event_log": {
    "level": {{ level | tojson }},
    "date": {{ timestamp.isoformat() | tojson }},
    "application": "Enterprise",
    "application_presentation": "1C:Enterprise",
    "event_name": {{ event_name | tojson }},
    "event_presentation": {{ presentation | tojson }},
    "user_id": {{ user_id | tojson }},
    "user_name": {{ name | tojson }},
    "computer": {{ computer | tojson }},
    "metadata_name": {{ metadata_name | tojson }},
    "metadata_presentation": {{ metadata_presentation | tojson }},
    "comment": {{ comment | tojson }},
    "data": {{ data | tojson }},
    "data_presentation": {{ data_presentation | tojson }},
    "transaction_status": {{ transaction_status | tojson }},
    "transaction_id": {{ transaction_id | tojson }},
    "connection": {{ connection }},
    "session": {{ session }},
    "server_name": {{ params.server_name | tojson }},
    "port": {{ params.server_port }},
    "sync_port": {{ params.sync_port }},
    "session_data_separation": {},
    "session_data_separation_presentation": []
  }}
}
