{%- set step = vars.step -%}
{%- set probe = step.startswith('probe_') -%}
{%- if step == 'routine_a' -%}
  {%- do shared.pop('to_probe', none) -%}
  {%- set count = shared.get('routine_count', 0) + 1 -%}
  {%- if count >= params.anomaly_interval_events -%}
    {%- do shared.set('routine_count', 0) -%}
    {%- if params.anomaly_mode -%}{%- do shared.set('to_probe', true) -%}{%- endif -%}
  {%- else -%}{%- do shared.set('routine_count', count) -%}{%- endif -%}
{%- endif -%}
{%- set source_ip = params.probe_source_ip if probe else '10.41.1.' ~ module.rand.number.integer(10, 180) -%}
{%- set source_port = module.rand.number.integer(40000, 60000) -%}
{%- set real_server = 'app01' if step == 'probe_404' else ('app02' if step == 'probe_403' else ('app03' if step == 'probe_200' else module.rand.choice(['app01','app02','app03']))) -%}
{%- set server_ip = '10.41.30.11' if real_server == 'app01' else ('10.41.30.12' if real_server == 'app02' else '10.41.30.13') -%}
{%- set url_path = '/admin' if probe else module.rand.choice(['/','/index.html','/assets/app.js','/api/items']) -%}
{%- set status = 404 if step == 'probe_404' else (403 if step == 'probe_403' else (200 if step == 'probe_200' else module.rand.weighted_choice([200,301,404,500],[82,8,8,2]))) -%}
{%- set duration = module.rand.number.integer(0, 2) -%}
{%- set inbound_bytes = module.rand.number.integer(90, 600) -%}
{%- set outbound_bytes = module.rand.number.integer(300, 3000) if status == 200 else module.rand.number.integer(200, 700) -%}
{%- set msg_id = shared.get('msg_id', 39233799) + 1 -%}
{%- do shared.set('msg_id', msg_id) -%}
{%- set native = {'date':timestamp.strftime('%Y-%m-%d'),'time':timestamp.strftime('%H:%M:%S'),'log_id':'0101008001','type':'traffic','subtype':'slb_http','pri':'information','vd':'root','msg_id':msg_id,'duration':duration,'ibytes':inbound_bytes,'obytes':outbound_bytes,'proto':6,'service':'http','src':source_ip,'src_port':source_port,'dst':params.virtual_ip,'dst_port':80,'trans_src':'10.41.30.1','trans_src_port':module.rand.number.integer(20000, 30000),'trans_dst':server_ip,'trans_dst_port':80,'policy':params.virtual_server,'action':'none','http_method':'get','http_host':params.virtual_ip,'http_agent':'curl/8.0','http_url':url_path,'http_qry':'none','http_referer':'none','http_cookie':'none','http_retcode':status,'user':'none','usrgrp':'none','auth_status':'none','srccountry':'Reserved','dstcountry':'Reserved','real_server':real_server} -%}
{%- set parts = [] -%}
{%- for key,value in native.items() -%}{%- do parts.append(key ~ '=' ~ value|string) -%}{%- endfor -%}
{%- set raw = parts|join(' ') -%}
{%- set out = {'@timestamp':timestamp.isoformat(),'ecs':{'version':'8.17.0'},'event':{'action':'slb-http-response','category':['web'],'code':'0101008001','dataset':'fortinet_fortiadc.log','kind':'event','original':raw,'type':['access']},'host':{'name':params.device_name},'source':{'ip':source_ip,'port':source_port},'destination':{'ip':params.virtual_ip,'port':80},'network':{'transport':'tcp','protocol':'http'},'http':{'request':{'method':'GET'},'response':{'status_code':status}},'url':{'path':url_path},'related':{'ip':[source_ip,params.virtual_ip,server_ip]},'fortinet':{'fortiadc':native}} -%}
{{- out | tojson -}}
