{%- set step = vars.step -%}
{%- set chain = step.startswith('chain_alert_') -%}
{%- if step == 'routine_a' -%}
  {%- do shared.pop('to_chain', none) -%}
  {%- set count = shared.get('routine_count', 0) + 1 -%}
  {%- if count >= params.anomaly_interval_events -%}
    {%- do shared.set('routine_count', 0) -%}
    {%- if params.anomaly_mode -%}{%- do shared.set('to_chain', true) -%}{%- endif -%}
  {%- else -%}{%- do shared.set('routine_count', count) -%}{%- endif -%}
{%- endif -%}
{%- if chain -%}
  {%- set index = step[-1]|int -%}
  {%- set targets = [
    {'user':'domain-admin@dc-01.example.test','host':'dc-01.example.test','ip':'10.20.2.11'},
    {'user':'backup-admin@backup-02.example.test','host':'backup-02.example.test','ip':'10.20.2.12'},
    {'user':'db-admin@db-01.example.test','host':'db-01.example.test','ip':'10.20.2.13'},
    {'user':'cloud-admin@jump-01.example.test','host':'jump-01.example.test','ip':'10.20.2.14'}
  ] -%}
  {%- set source_user = params.chain_source_user -%}
  {%- set source_host = params.chain_source_host -%}
  {%- set source_ip = params.chain_source_ip -%}
  {%- set target = targets[index - 1] -%}
{%- else -%}
  {%- set actors = [
    {'user':'app-operator@app-01.example.test','host':'app-01.example.test','ip':'10.20.10.21','target':{'user':'svc-app@app-02.example.test','host':'app-02.example.test','ip':'10.20.20.21'}},
    {'user':'db-reader@db-02.example.test','host':'db-02.example.test','ip':'10.20.10.22','target':{'user':'svc-db@db-03.example.test','host':'db-03.example.test','ip':'10.20.20.22'}},
    {'user':'helpdesk@help-01.example.test','host':'help-01.example.test','ip':'10.20.10.23','target':{'user':'svc-help@help-02.example.test','host':'help-02.example.test','ip':'10.20.20.23'}},
    {'user':'monitor@mon-01.example.test','host':'mon-01.example.test','ip':'10.20.10.24','target':{'user':'svc-mon@mon-02.example.test','host':'mon-02.example.test','ip':'10.20.20.24'}}
  ] -%}
  {%- set routine_index = shared.get('routine_count', 0) -%}
  {%- if routine_index % 9 == 0 -%}
    {%- set target = [
      {'user':'domain-admin@dc-01.example.test','host':'dc-01.example.test','ip':'10.20.2.11'},
      {'user':'backup-admin@backup-02.example.test','host':'backup-02.example.test','ip':'10.20.2.12'},
      {'user':'db-admin@db-01.example.test','host':'db-01.example.test','ip':'10.20.2.13'},
      {'user':'cloud-admin@jump-01.example.test','host':'jump-01.example.test','ip':'10.20.2.14'}
    ][(routine_index // 9) % 4] -%}
    {%- set source_user = params.chain_source_user -%}
    {%- set source_host = params.chain_source_host -%}
    {%- set source_ip = params.chain_source_ip -%}
  {%- else -%}
    {%- set actor = module.rand.choice(actors) -%}
    {%- set source_user = actor.user -%}
    {%- set source_host = actor.host -%}
    {%- set source_ip = actor.ip -%}
    {%- set target = actor.target -%}
  {%- endif -%}
{%- endif -%}
{%- set incident_id = module.rand.string.hex(24) -%}
{%- set detection_ms = (timestamp.timestamp() * 1000)|int -%}
{%- set pta_link = 'https://' ~ params.pta_link_host ~ '/incidents/' ~ incident_id -%}
{%- set extension = {'suser':source_user,'shost':source_host,'src':source_ip,'duser':target.user,'dhost':target.host,'dst':target.ip,'cs1Label':'ExtraData','cs1':'None','cs2Label':'EventID','cs2':incident_id,'deviceCustomDate1Label':'detectionDate','deviceCustomDate1':detection_ms|string,'cs3Label':'PTAlink','cs3':pta_link,'cs4Label':'ExternalLink','cs4':'None'} -%}
{%- set parts = [] -%}
{%- for key,value in extension.items() -%}{%- do parts.append(key ~ '=' ~ value) -%}{%- endfor -%}
{%- set raw = 'CEF:0|CyberArk|PTA|' ~ params.pta_version ~ '|1|Suspected credentials theft|8|' ~ parts|join(' ') -%}
{%- set out = {'@timestamp':timestamp.isoformat(),'ecs':{'version':'8.17.0'},'event':{'category':['threat'],'code':'1','dataset':'cyberark_pta.events','id':incident_id,'kind':'alert','original':raw,'reason':'Suspected credentials theft','reference':pta_link,'severity':8,'type':['info']},'observer':{'hostname':params.pta_host,'product':'PTA','vendor':'CyberArk','version':params.pta_version},'source':{'domain':source_host,'ip':source_ip,'user':{'email':source_user,'name':source_user.split('@')[0]}},'destination':{'domain':target.host,'ip':target.ip,'user':{'email':target.user,'name':target.user.split('@')[0]}},'related':{'hosts':[source_host,target.host],'ip':[source_ip,target.ip],'user':[source_user,target.user]},'cef':{'version':0,'device':{'vendor':'CyberArk','product':'PTA','version':params.pta_version,'event_class_id':'1'},'name':'Suspected credentials theft','severity':'8','extensions':extension},'cyberark_pta':{'log':{'event_type':'1'}}} -%}
{{- out | tojson -}}
