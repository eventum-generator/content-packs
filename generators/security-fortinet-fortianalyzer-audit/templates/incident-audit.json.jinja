{%- set previous = shared.get('previous_time') -%}
{%- set event_time = timestamp if previous is none or timestamp > previous else previous + module.datetime.timedelta(seconds=1) -%}
{%- do shared.set('previous_time', event_time) -%}
{%- set sequence = (shared.get('sequence', 0) + 1) % 1000000 -%}
{%- do shared.set('sequence', sequence) -%}
{%- set tick = (shared.get('tick', -1) + 1) % (params.anomaly_interval_events + 4) -%}
{%- do shared.set('tick', tick) -%}
{%- set chain = params.anomaly_mode and tick >= params.anomaly_interval_events -%}
{%- if chain -%}
  {%- set step = tick - params.anomaly_interval_events -%}
  {%- set kind = ['create', 'attachment_add', 'attachment_delete', 'delete'][step] -%}
  {%- if step == 0 -%}
    {%- do shared.set('anomaly_cycle', (shared.get('anomaly_cycle', 0) + 1) % 1000000) -%}
  {%- endif -%}
  {%- set incident_id = params.incident_prefix ~ '-' ~ (9000000 + shared.get('anomaly_cycle', 1)) -%}
  {%- set actor = 'system' if step < 2 else params.suspicious_analyst -%}
  {%- set severity = 'high' -%}
{%- else -%}
  {%- set kind = module.rand.weighted_choice(['create', 'update', 'attachment_add'], [35, 50, 15]) -%}
  {%- if kind == 'create' -%}
    {%- do shared.set('normal_incident_id', params.incident_prefix ~ '-' ~ (1000 + sequence)) -%}
  {%- endif -%}
  {%- set incident_id = shared.get('normal_incident_id', params.incident_prefix ~ '-1000') -%}
  {%- set actor = module.rand.choice(['soc_analyst', 'ir_analyst']) -%}
  {%- set severity = module.rand.choice(['low', 'medium']) -%}
{%- endif -%}
{%- if kind == 'create' -%}
  {%- set logid = '100001' -%}
  {%- set desc = 'New_Incident_Create' -%}
  {%- set message = 'Incident ' ~ incident_id ~ ' created' -%}
  {%- set event_type = ['creation'] -%}
{%- elif kind == 'update' -%}
  {%- set logid = '100002' -%}
  {%- set desc = 'Incident_Update' -%}
  {%- set message = 'Incident ' ~ incident_id ~ ' updated' -%}
  {%- set event_type = ['change'] -%}
{%- elif kind == 'attachment_add' -%}
  {%- set logid = '100005' -%}
  {%- set desc = 'Incident_Attachment_Add' -%}
  {%- set message = 'Attachment added to incident ' ~ incident_id -%}
  {%- set event_type = ['creation'] -%}
{%- elif kind == 'attachment_delete' -%}
  {%- set logid = '100006' -%}
  {%- set desc = 'Incident_Attachment_Delete' -%}
  {%- set message = 'Attachment deleted from incident ' ~ incident_id -%}
  {%- set event_type = ['deletion'] -%}
{%- else -%}
  {%- set logid = '100003' -%}
  {%- set desc = 'Incident_Delete' -%}
  {%- set message = 'Incident ' ~ incident_id ~ ' deleted' -%}
  {%- set event_type = ['deletion'] -%}
{%- endif -%}
{%- set ingest_time = event_time - module.datetime.timedelta(seconds=1) -%}
{%- set raw = 'id=' ~ (6826113487000000000 + sequence)
  ~ ' itime=' ~ ingest_time.strftime('%Y-%m-%d %H:%M:%S')
  ~ ' vd=' ~ params.adom
  ~ ' logid=' ~ logid
  ~ ' type=appevent subtype=incident level=information'
  ~ ' date=' ~ event_time.strftime('%Y-%m-%d')
  ~ ' time=' ~ event_time.strftime('%H:%M:%S')
  ~ ' user=' ~ actor
  ~ ' desc=' ~ desc
  ~ ' msg=' ~ message
  ~ ' incident_id=' ~ incident_id
  ~ ' incident_severity=' ~ severity
  ~ (' attachment=evidence-' ~ incident_id ~ '.json' if kind in ['attachment_add', 'attachment_delete'] else '')
  ~ ' adom=' ~ params.adom
  ~ ' devid=' ~ params.analyzer_id
  ~ ' dtime=' ~ ingest_time.strftime('%Y-%m-%d %H:%M:%S')
  ~ ' itime_t=' ~ (ingest_time.timestamp() | int) -%}
{%- set vendor = {'logid': logid, 'type': 'appevent', 'subtype': 'incident',
  'incident_id': incident_id, 'incident_severity': severity,
  'adom': params.adom, 'desc': desc} -%}
{%- if kind in ['attachment_add', 'attachment_delete'] -%}
  {%- do vendor.update({'attachment': 'evidence-' ~ incident_id ~ '.json'}) -%}
{%- endif -%}
{%- set record = {'@timestamp': event_time.isoformat(),
  'ecs': {'version': '8.17.0'},
  'event': {'kind': 'event', 'dataset': 'fortinet.fortianalyzer.appevent',
    'type': event_type, 'action': desc, 'code': logid, 'original': raw},
  'observer': {'name': params.analyzer_id, 'vendor': 'Fortinet', 'product': 'FortiAnalyzer'},
  'user': {'name': actor}, 'related': {'user': [actor]},
  'fortinet': {'fortianalyzer': vendor}} -%}
{{ record | tojson }}
