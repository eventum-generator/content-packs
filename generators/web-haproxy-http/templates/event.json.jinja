{%- set step = vars.step -%}
{%- set kind = step -%}
{%- if step == 'routine' -%}
  {%- do shared.pop('to_attack', none) -%}
  {%- set count = shared.get('routine_count', 0) + 1 -%}
  {%- if count >= params.anomaly_interval_events -%}
    {%- do shared.set('routine_count', 0) -%}
    {%- if params.anomaly_mode -%}{%- do shared.set('to_attack', true) -%}{%- endif -%}
  {%- else -%}{%- do shared.set('routine_count', count) -%}{%- endif -%}
  {%- set kind = 'request' -%}
{%- endif -%}
{%- set req = samples.requests.pick() -%}
{%- set method = req.method -%}{%- set path = req.path -%}
{%- set status = req.status -%}{%- set bytes = req.bytes -%}
{%- set server = req.backend -%}
{%- set src = '10.60.4.' ~ module.rand.number.integer(20, 180) -%}
{%- if kind.startswith('fail_') -%}
  {%- set method = 'POST' -%}{%- set path = '/login' -%}
  {%- set status = 401 -%}{%- set bytes = 310 -%}
  {%- set src = params.anomaly_ip -%}{%- set server = 'app1' -%}
{%- elif kind == 'login_success' -%}
  {%- set method = 'POST' -%}{%- set path = '/login' -%}
  {%- set status = 302 -%}{%- set bytes = 0 -%}
  {%- set src = params.anomaly_ip -%}{%- set server = 'app1' -%}
{%- elif kind == 'admin_export' -%}
  {%- set method = 'GET' -%}{%- set path = params.anomaly_path -%}
  {%- set status = 200 -%}{%- set bytes = 843220 -%}
  {%- set src = params.anomaly_ip -%}{%- set server = 'app1' -%}
{%- endif -%}
{%- set src_port = module.rand.number.integer(40000, 62000) -%}
{%- set no_server = status == 503 -%}
{%- set timers = '0/-1/-1/-1/0' if no_server else '2/0/1/15/19' -%}
{%- set termination = 'SC--' if no_server else '----' -%}
{%- set reqline = method ~ ' ' ~ path ~ ' HTTP/1.1' -%}
{%- set accept = timestamp.strftime('%d/%b/%Y:%H:%M:%S.%f')[:-3] -%}
{%- set body = src ~ ':' ~ src_port ~ ' [' ~ accept ~ '] ' ~ params.frontend_name ~ ' ' ~ params.backend_name ~ '/' ~ server ~ ' ' ~ timers ~ ' ' ~ status ~ ' ' ~ bytes ~ ' - - ' ~ termination ~ ' 1/1/1/1/0 0/0 "' ~ reqline ~ '"' -%}
{%- set original = timestamp.strftime('%b %d %H:%M:%S') ~ ' ' ~ params.proxy_name ~ ' haproxy[2431]: ' ~ body -%}
{%- set offset = shared.get('offset', 0) -%}
{%- do shared.set('offset', (offset + original|length + 1) % 2147483647) -%}
{%- set out = {'@timestamp':timestamp.isoformat(),'ecs':{'version':'8.17.0'},'agent':{'ephemeral_id':'aa110000-1111-4444-8888-123456789abc','id':'aa110000-1111-4444-8888-123456789abc','name':params.proxy_name,'type':'filebeat','version':'8.17.0'},'elastic_agent':{'id':'aa110000-1111-4444-8888-123456789abc','snapshot':false,'version':'8.17.0'},'data_stream':{'dataset':'haproxy.log','namespace':'default','type':'logs'},'event':{'agent_id_status':'verified','category':['web'],'dataset':'haproxy.log','duration':0 if no_server else 19000000,'ingested':timestamp.isoformat(),'kind':'event','original':original,'outcome':'failure' if status >= 400 else 'success','timezone':'+00:00'},'haproxy':{'backend_name':params.backend_name,'backend_queue':0,'bytes_read':bytes,'connection_wait_time_ms':-1 if no_server else 1,'connections':{'active':1,'backend':0 if no_server else 1,'frontend':1,'retries':0,'server':0 if no_server else 1},'frontend_name':params.frontend_name,'http':{'request':{'captured_cookie':'-','raw_request_line':reqline,'time_wait_ms':0,'time_wait_without_data_ms':-1 if no_server else 2},'response':{'captured_cookie':'-'}},'server_name':server,'server_queue':0,'termination_state':termination,'total_waiting_time_ms':-1 if no_server else 0},'host':{'name':params.proxy_name,'ip':[params.proxy_ip]},'http':{'request':{'method':method},'response':{'bytes':bytes,'status_code':status},'version':'1.1'},'input':{'type':'log'},'log':{'file':{'path':'/var/log/haproxy.log'},'offset':offset},'message':body,'process':{'name':'haproxy','pid':2431},'related':{'ip':[src]},'source':{'address':src,'ip':src,'port':src_port},'tags':['preserve_original_event','haproxy-log'],'url':{'original':path,'path':path}} -%}
{{- out | tojson -}}
