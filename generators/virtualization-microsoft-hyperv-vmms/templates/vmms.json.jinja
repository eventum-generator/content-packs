{#- Microsoft-Windows-Hyper-V-VMMS-Admin checkpoint and merge failures
    (event IDs 18014, 18012, 19100) as Winlogbeat-style ECS JSON with the
    raw event XML. Every input timestamp yields exactly one record: the
    earliest queued record that is due (stamped with its own microsecond
    time, never later than the input timestamp), otherwise the first
    record of a new failing series on an idle VM. Successful checkpoints
    and merges write nothing to the Admin channel. Times are in
    microseconds. -#}
{%- set ts = timestamp.astimezone(module.datetime.timezone.utc) -%}
{%- set now = module.builtins.int(ts.timestamp() * 1000000) -%}
{%- set hour = 3600000000 -%}
{%- macro d(lo, med, sig, hi) -%}
  {#- Offset lognormal in seconds, truncated by redrawing; returns us. -#}
  {%- set ns = namespace(v=lo + module.rand.number.lognormal(module.math.log(med), sig)) -%}
  {%- for _ in range(16) if ns.v > hi -%}
    {%- set ns.v = lo + module.rand.number.lognormal(module.math.log(med), sig) -%}
  {%- endfor -%}
  {{- module.builtins.int(([ns.v, hi] | min) * 1000000) -}}
{%- endmacro -%}
{#- Retry delay after a failed attempt, 18014 -> 18012 and
    18012 -> 19100 delays. -#}
{%- macro retry_gap() -%}{{- d(20, 360, 1.0, 7200) -}}{%- endmacro -%}
{%- macro fail_delay() -%}{{- d(0.00001, 0.00006, 0.8, 0.005) -}}{%- endmacro -%}
{%- macro merge_delay() -%}{{- d(0.002, 0.02, 0.9, 2) -}}{%- endmacro -%}
{%- set p_cancel = 0.55 -%}
{%- set p_merge = 0.4 -%}
{%- set p_retry = 0.6 -%}
{%- set p_retry_fail = 0.5 -%}
{%- set p_merge_only = 0.15 -%}
{%- set p_merge_again = 0.55 -%}
{#- Chain window: a merge failure is not logged (the merge succeeds)
    only when it would complete 18014, 18012, 19100, 18012, 19100, 18012,
    19100 on one VM inside this window; one second of margin covers the
    millisecond rounding of @timestamp. -#}
{%- set window = 21600000000 -%}
{%- set window_g = window + 1000000 -%}
{%- macro push(due, item) -%}
  {%- set s = shared.get('seq') + 1 -%}
  {%- do shared.set('seq', s) -%}
  {%- do module.heapq.heappush(shared.get('queue'), [due, s, item]) -%}
{%- endmacro -%}
{%- macro pick_start(lo, span) -%}
  {#- Time in [lo, lo + span) whose local hour is weighted by the
      failure-rate curve squared plus a small floor. -#}
  {%- set curve = shared.get('curve') -%}
  {%- set r = namespace(v=lo + module.rand.number.integer(0, span - 1), ok=false) -%}
  {%- for _ in range(500) if not r.ok -%}
    {%- set c = lo + module.rand.number.integer(0, span - 1) -%}
    {%- if module.rand.number.floating(0, 1.02) < curve[((c + shared.get('tzoff')) // hour) % 24] ** 2 + 0.02 -%}
      {%- set r.v = c -%}
      {%- set r.ok = true -%}
    {%- endif -%}
  {%- endfor -%}
  {{- r.v -}}
{%- endmacro -%}
{%- if shared.get('queue') is none -%}
  {%- set schema = {'type': 'typed-dict', 'fields': {
    'anomaly_mode': {'type': 'typed-dict-field', 'schema': {'type': 'bool', 'strict': true}},
    'anomaly_interval_hours': {'type': 'typed-dict-field', 'schema': {'type': 'float', 'ge': 6, 'le': 8760}}
  }} -%}
  {%- do module.pydantic_core.SchemaValidator(schema).validate_python(params) -%}
  {%- set hosts = {} -%}
  {%- set vms = [] -%}
  {%- set cum = [] -%}
  {%- set acc = namespace(w=0) -%}
  {%- for row in samples.vms -%}
    {%- if row.host not in hosts -%}
      {%- set threads = [] -%}
      {%- for _ in range(module.rand.number.integer(6, 14)) -%}{%- do threads.append(4 * module.rand.number.integer(100, 4000)) -%}{%- endfor -%}
      {%- do hosts.update({row.host: {'pid': 4 * module.rand.number.integer(250, 2500), 'threads': threads, 'record': module.rand.number.integer(2000, 400000)}}) -%}
    {%- endif -%}
    {#- Failure propensity of the VM, bounded within its tier: a VM
        with recurring checkpoint trouble fails a few times a day, any
        other VM about once in five to seven days. -#}
    {%- if row.checkpoint_trouble -%}
      {%- set w = 22 * ([[module.rand.number.lognormal(0, 0.2), 0.8] | max, 1.25] | min) -%}
    {%- else -%}
      {%- set w = 0.9 * ([[module.rand.number.lognormal(0, 0.3), 0.7] | max, 1.4] | min) -%}
    {%- endif -%}
    {%- set acc.w = acc.w + w -%}
    {%- do cum.append(acc.w) -%}
    {%- do vms.append({'name': row.vm_name, 'id': row.vm_id, 'host': row.host, 'trouble': row.checkpoint_trouble, 'w': w, 'busy': false, 'free': 0, 'ep_left': 0, 'ep_merges': 0, 'hist': []}) -%}
  {%- endfor -%}
  {#- Relative hourly failure rate (local hours): backup window
      22:00-05:00 against the daytime floor, as in patterns/. -#}
  {%- set curve = [] -%}
  {%- for h in range(24) -%}{%- do curve.append(1.0 if h < 5 or h >= 22 else 0.1667) -%}{%- endfor -%}
  {%- set interval = module.builtins.int(params.anomaly_interval_hours * hour) -%}
  {%- do shared.update({'queue': [], 'seq': 0, 'vms': vms, 'hosts': hosts, 'cum': cum, 'idx': range(vms | length) | list, 'curve': curve, 'tzoff': module.builtins.int(timestamp.utcoffset().total_seconds()) * 1000000, 'last_us': now - 1, 'ep_last_vm': none, 'ep_last_host': none}) -%}
  {%- do shared.update({'ep_due': pick_start(now, [interval, 24 * hour] | min) | int, 'ep_end': now + ([interval, 24 * hour] | min)}) -%}
{%- endif -%}
{%- set queue = shared.get('queue') -%}
{%- set vms = shared.get('vms') -%}
{%- set hosts = shared.get('hosts') -%}
{%- set interval = module.builtins.int(params.anomaly_interval_hours * hour) -%}
{#- Episode start: the first timestamp at or after the planned start
    with an idle VM with recurring checkpoint trouble (by failure
    propensity) that is neither the previous episode's VM nor on its host
    and whose records within the chain window hold no cancelled, failed
    and merge-failed sequence (so that the chain completes only on the
    episode's last merge failure). The episode is one failing series of
    that VM: its attempts use the background delays, but the first three
    fail with a merge failure. The next start is planned in a window of
    min(interval / 4, 6 h) centred one interval after this start,
    weighted by the curve squared; when no VM qualifies at the drawn
    start, the start is drawn again, the same way, in the rest of that
    window. Missed episodes are not replayed. -#}
{%- if params.anomaly_mode and now >= shared.get('ep_due') -%}
  {#- The episode is stamped from its planned start, which can lie
      before this timestamp: the VM must have no record after it, and
      the chain window is counted back from it. -#}
  {%- set start = [shared.get('ep_due'), shared.get('last_us') + 1] | max -%}
  {%- set cand = [] -%}
  {%- set cw = [] -%}
  {%- for i in range(vms | length) if vms[i].trouble and not vms[i].busy and vms[i].free < start and i != shared.get('ep_last_vm') and vms[i].host != shared.get('ep_last_host') -%}
    {%- set st = namespace(n=0) -%}
    {%- for x in vms[i].hist if st.n < 3 -%}
      {%- if x[0] >= start - window_g and x[1] == [18014, 18012, 19100][st.n] -%}{%- set st.n = st.n + 1 -%}{%- endif -%}
    {%- endfor -%}
    {%- if st.n < 3 -%}
      {%- do cand.append(i) -%}
      {%- do cw.append(vms[i].w) -%}
    {%- endif -%}
  {%- endfor -%}
  {%- if cand -%}
    {%- set vi = module.rand.weighted_choice(cand, cw) -%}
    {%- set w = [interval // 4, 6 * hour] | min -%}
    {%- do vms[vi].update({'busy': true, 'ep_left': 4 if module.rand.chance(0.3) else 3, 'ep_merges': 0}) -%}
    {%- do push(start, {'k': 'att', 'v': vi, 'first': true}) -%}
    {%- do shared.update({'ep_last_vm': vi, 'ep_last_host': vms[vi].host, 'ep_due': pick_start(start + interval - w // 2, w) | int, 'ep_end': start + interval - w // 2 + w}) -%}
  {%- elif shared.get('ep_end') - now > 1 -%}
    {%- do shared.set('ep_due', pick_start(now + 1, shared.get('ep_end') - now - 1) | int) -%}
  {%- endif -%}
{%- endif -%}
{%- macro completes(hist, t) -%}
  {#- 'y' when a 19100 at t completes the chain over the VM history. -#}
  {%- set seq = [18014, 18012, 19100, 18012, 19100, 18012] -%}
  {%- set ns = namespace(found=false) -%}
  {%- for i in range(hist | length) if not ns.found and hist[i][1] == 18014 and t - hist[i][0] <= window_g -%}
    {%- set st = namespace(n=1) -%}
    {%- for j in range(i + 1, hist | length) if st.n < 6 -%}
      {%- if hist[j][1] == seq[st.n] -%}{%- set st.n = st.n + 1 -%}{%- endif -%}
    {%- endfor -%}
    {%- if st.n == 6 -%}{%- set ns.found = true -%}{%- endif -%}
  {%- endfor -%}
  {{- 'y' if ns.found else '' -}}
{%- endmacro -%}
{%- set out = namespace(row=none, rec=0) -%}
{%- for _ in range(64) if out.row is none -%}
  {%- if queue and queue[0][0] <= now -%}
    {%- set top = module.heapq.heappop(queue) -%}
    {%- set item = top[2] -%}
    {%- set due = top[0] -%}
  {%- else -%}
    {#- Nothing due: a new failing series starts now on an idle VM,
        drawn by failure propensity. -#}
    {%- set pick = namespace(v=none) -%}
    {%- for _ in range(12) if pick.v is none -%}
      {%- set c = module.random.choices(shared.get('idx'), cum_weights=shared.get('cum'), k=1)[0] -%}
      {%- if not vms[c].busy and vms[c].free < now -%}{%- set pick.v = c -%}{%- endif -%}
    {%- endfor -%}
    {%- if pick.v is none -%}
      {%- set idle = [] -%}
      {%- for i in range(vms | length) if not vms[i].busy and vms[i].free < now -%}{%- do idle.append(i) -%}{%- endfor -%}
      {%- set pick.v = module.rand.choice(idle) -%}
    {%- endif -%}
    {%- do vms[pick.v].update({'busy': true}) -%}
    {%- set item = {'k': 'merge' if module.rand.chance(p_merge_only) else 'att', 'v': pick.v, 'first': true} -%}
    {%- set due = now -%}
  {%- endif -%}
  {%- set vm = vms[item.v] -%}
  {%- if item.k == 'row' -%}
    {%- set out.row = item -%}
    {%- set out.rec = [due, shared.get('last_us') + 1] | max -%}
    {%- do shared.set('last_us', out.rec) -%}
  {%- elif item.k == 'merge' -%}
    {#- The background merge of an earlier checkpoint's disk fails on its
        own and VMMS may retry it after a delay. -#}
    {%- if not completes(vm.hist, due) -%}
      {%- do push(due, {'k': 'row', 'v': item.v, 'code': 19100, 'thr': module.rand.choice(hosts[vm.host].threads)}) -%}
      {%- do vm.hist.append([due, 19100]) -%}
      {%- do vm.update({'free': [vm.free, due] | max}) -%}
    {%- endif -%}
    {%- if module.rand.chance(p_merge_again) -%}
      {%- set nd = due + (retry_gap() | int) -%}
      {%- do push(nd, {'k': 'merge', 'v': item.v}) -%}
    {%- else -%}
      {%- do vm.update({'busy': false}) -%}
    {%- endif -%}
  {%- elif item.k == 'retry' -%}
    {%- if vm.ep_left > 0 or module.rand.chance(p_retry_fail) -%}
      {%- do push(due, {'k': 'att', 'v': item.v, 'first': false}) -%}
    {%- else -%}
      {%- do vm.update({'busy': false}) -%}
    {%- endif -%}
  {%- elif item.k == 'att' -%}
    {#- One failed checkpoint attempt: optional 18014, then 18012 on the
        same VMMS worker thread, then an optional 19100. -#}
    {%- set episode = vm.ep_left > 0 -%}
    {%- set thr = module.rand.choice(hosts[vm.host].threads) -%}
    {%- set t = namespace(v=due) -%}
    {%- if (episode and item.first) or module.rand.chance(p_cancel) -%}
      {%- do push(t.v, {'k': 'row', 'v': item.v, 'code': 18014, 'thr': thr}) -%}
      {%- do vm.hist.append([t.v, 18014]) -%}
      {%- set t.v = t.v + (fail_delay() | int) -%}
    {%- endif -%}
    {%- do push(t.v, {'k': 'row', 'v': item.v, 'code': 18012, 'thr': thr}) -%}
    {%- do vm.hist.append([t.v, 18012]) -%}
    {%- do vm.update({'free': [vm.free, t.v] | max}) -%}
    {%- set forced = episode and vm.ep_merges < 3 -%}
    {%- if forced or module.rand.chance(p_merge) -%}
      {%- set mt = t.v + (merge_delay() | int) -%}
      {%- if forced or not completes(vm.hist, mt) -%}
        {%- do push(mt, {'k': 'row', 'v': item.v, 'code': 19100, 'thr': thr if module.rand.chance(0.5) else module.rand.choice(hosts[vm.host].threads)}) -%}
        {%- do vm.hist.append([mt, 19100]) -%}
        {%- do vm.update({'free': [vm.free, mt] | max}) -%}
        {%- if forced -%}{%- do vm.update({'ep_merges': vm.ep_merges + 1}) -%}{%- endif -%}
      {%- endif -%}
    {%- endif -%}
    {%- if episode -%}
      {%- do vm.update({'ep_left': vm.ep_left - 1}) -%}
    {%- endif -%}
    {%- if vm.ep_left > 0 or module.rand.chance(p_retry) -%}
      {%- set nd = t.v + (retry_gap() | int) -%}
      {%- do push(nd, {'k': 'retry', 'v': item.v}) -%}
    {%- else -%}
      {%- do vm.update({'busy': false}) -%}
    {%- endif -%}
  {%- endif -%}
  {#- Bounded history: rows older than the chain window are dropped. -#}
  {%- for _ in range(vm.hist | length) if vm.hist and due - vm.hist[0][0] > window_g -%}{%- do vm.hist.pop(0) -%}{%- endfor -%}
{%- endfor -%}
{#- Never reached in practice: every new series logs a record. -#}
{%- if out.row is none -%}{{- dispatch.drop() -}}{%- endif -%}
{%- set row = out.row -%}
{%- set rec = out.rec -%}
{%- set vm = vms[row.v] -%}
{%- set host = hosts[vm.host] -%}
{#- Other Admin records (not modeled) take record numbers in between. -#}
{%- set record_id = host.record + 1 + (module.rand.number.integer(1, 6) if module.rand.chance(0.3) else 0) -%}
{%- do host.update({'record': record_id}) -%}
{%- set moment = ts + module.datetime.timedelta(microseconds=rec - now) -%}
{%- set system_time = moment.strftime('%Y-%m-%dT%H:%M:%S.%f') ~ module.rand.number.integer(0, 9) ~ 'Z' -%}
{%- set code = row.code -%}
{%- if code == 18014 -%}
  {%- set action = 'checkpoint-cancelled' -%}
  {%- set message = "Checkpoint operation for '" ~ vm.name ~ "' was cancelled. (Virtual machine ID " ~ vm.id ~ ')' -%}
{%- elif code == 18012 -%}
  {%- set action = 'checkpoint-failed' -%}
  {%- set message = "Checkpoint operation for '" ~ vm.name ~ "' failed. (Virtual machine ID " ~ vm.id ~ ')' -%}
{%- else -%}
  {%- set action = 'disk-merge-failed' -%}
  {%- set message = "'" ~ vm.name ~ "' background disk merge failed to complete: The process cannot access the file because it is being used by another process. (0x80070020). (Virtual machine ID " ~ vm.id ~ ')' -%}
{%- endif -%}
{%- set user_data = {'VmName': vm.name, 'VmId': vm.id} -%}
{%- set error_xml = '' -%}
{%- if code == 19100 -%}
  {%- do user_data.update({'ErrorMessage': '%%2147942432', 'ErrorCode': '0x80070020'}) -%}
  {%- set error_xml = '<ErrorMessage>%%2147942432</ErrorMessage><ErrorCode>0x80070020</ErrorCode>' -%}
{%- endif -%}
{%- set xml = '<Event xmlns="http://schemas.microsoft.com/win/2004/08/events/event"><System><Provider Name="Microsoft-Windows-Hyper-V-VMMS" Guid="{6066f867-7ca1-4418-85fd-36e3f9c0600c}"/><EventID>' ~ code ~ '</EventID><Version>0</Version><Level>2</Level><Task>0</Task><Opcode>0</Opcode><Keywords>0x8000000000000000</Keywords><TimeCreated SystemTime="' ~ system_time ~ '"/><EventRecordID>' ~ record_id ~ '</EventRecordID><Correlation/><Execution ProcessID="' ~ host.pid ~ '" ThreadID="' ~ row.thr ~ '"/><Channel>Microsoft-Windows-Hyper-V-VMMS-Admin</Channel><Computer>' ~ vm.host ~ '</Computer><Security UserID="S-1-5-18"/></System><UserData><VmlEventLog xmlns="http://www.microsoft.com/Windows/Virtualization/Events"><VmName>' ~ vm.name ~ '</VmName><VmId>' ~ vm.id ~ '</VmId>' ~ error_xml ~ '</VmlEventLog></UserData></Event>' -%}
{%- set event = {
  '@timestamp': moment.isoformat(timespec='milliseconds').replace('+00:00', 'Z'),
  'ecs': {'version': '8.17.0'},
  'event': {'kind': 'event', 'category': ['host'], 'type': ['change'], 'action': action, 'code': code | string, 'provider': 'Microsoft-Windows-Hyper-V-VMMS', 'outcome': 'failure', 'original': xml},
  'host': {'name': vm.host},
  'log': {'level': 'error'},
  'message': message,
  'related': {'hosts': [vm.host]},
  'winlog': {'channel': 'Microsoft-Windows-Hyper-V-VMMS-Admin', 'computer_name': vm.host, 'event_id': code | string, 'provider_guid': '{6066f867-7ca1-4418-85fd-36e3f9c0600c}', 'provider_name': 'Microsoft-Windows-Hyper-V-VMMS', 'record_id': record_id, 'process': {'pid': host.pid, 'thread': {'id': row.thr}}, 'user': {'identifier': 'S-1-5-18'}, 'user_data': user_data, 'version': 0}
} -%}
{{- event | tojson -}}
