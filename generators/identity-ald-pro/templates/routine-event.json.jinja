{% from 'templates/_base.json.jinja' import kdc with context %}
{% do shared.pop('to_routine') %}
{% set principal = samples.principals.pick() %}
{% set roll = module.rand.number.integer(1, 100) %}
{% if roll <= 55 %}
  {% set output = kdc(principal.name, principal.ip, 'krbtgt/' ~ params.realm, 'as_issue', params) %}
{% elif roll <= 94 %}
  {% set output = kdc(principal.name, principal.ip, principal.service, 'tgs_issue', params) %}
{% else %}
  {% set output = kdc(principal.name, principal.ip, 'krbtgt/' ~ params.realm, 'preauth_failed', params) %}
{% endif %}
{% set count = shared.get('routine_count', 0) + 1 %}
{% if count >= 300 %}
  {% do shared.set('routine_count', 0) %}
  {% if params.anomaly_mode %}
    {% do shared.set('to_spray_failure', true) %}
  {% else %}
    {% do shared.set('to_routine', true) %}
  {% endif %}
{% else %}
  {% do shared.set('routine_count', count) %}
  {% do shared.set('to_routine', true) %}
{% endif %}
{{ output }}
