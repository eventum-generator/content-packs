{% from 'templates/_base.json.jinja' import kdc with context %}
{% do shared.pop('to_spray_failure') %}
{% set users = ['anna.ivanova', 'boris.smirnov', 'svc_backup', params.compromised_user] %}
{% set step = shared.get('spray_step', 0) %}
{% set name = users[step] %}
{% if step < 3 %}
  {% do shared.set('spray_step', step + 1) %}
  {% do shared.set('to_spray_failure', true) %}
{% else %}
  {% do shared.set('spray_step', 0) %}
  {% do shared.set('to_compromised_tgt', true) %}
{% endif %}
{{ kdc(name, params.attack_ip, 'krbtgt/' ~ params.realm, 'preauth_failed', params) }}
