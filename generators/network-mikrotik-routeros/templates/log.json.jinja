{%- set utc = timestamp.astimezone(module.datetime.timezone.utc) -%}
{%- set step = vars.step -%}
{%- set topic = 'dhcp,info' -%}
{%- set action = 'dhcp_assigned' -%}
{%- set category = ['network'] -%}
{%- set actor = none -%}
{%- set source_ip = none -%}
{%- set source_port = none -%}
{%- set destination_ip = none -%}
{%- set destination_port = none -%}
{%- set client_ip = none -%}
{%- set client_mac = none -%}
{%- set network_transport = none -%}
{%- set packet_length = none -%}
{%- set kind = step -%}
{%- if step == 'routine' -%}
  {%- do shared.pop('to_anomaly', none) -%}
  {%- set start = shared.get('start_epoch', utc.timestamp()) -%}
  {%- do shared.set('start_epoch', start) -%}
  {%- set phase = ((utc.timestamp() - start) // 60) | int % 1440 -%}
  {%- if phase == 20 -%}
    {%- set kind = 'external_login' -%}
  {%- elif phase == 25 -%}
    {%- set kind = 'external_logout' -%}
  {%- elif phase == 600 -%}
    {%- set kind = 'maintenance_login' -%}
  {%- elif phase == 602 -%}
    {%- set kind = 'rule_add' -%}
  {%- elif phase == 603 -%}
    {%- set kind = 'rule_move' -%}
  {%- elif phase == 604 -%}
    {%- set kind = 'rule_change' -%}
  {%- elif phase == 606 -%}
    {%- set kind = 'rule_remove' -%}
  {%- elif phase == 608 -%}
    {%- set kind = 'maintenance_logout' -%}
  {%- elif phase == 900 -%}
    {%- set kind = 'normal_login' -%}
  {%- elif phase == 910 -%}
    {%- set kind = 'normal_logout' -%}
  {%- else -%}
    {%- set kind = module.rand.weighted_choice(['dhcp', 'firewall'], [5, 95]) -%}
  {%- endif -%}
  {%- if params.anomaly_mode -%}
    {%- set interval = [params.anomaly_interval_hours | float, 1] | max * 3600 -%}
    {%- set due = shared.get('next_anomaly_epoch', start + interval) -%}
    {%- if utc.timestamp() >= due and kind in ['dhcp', 'firewall'] and phase not in range(14, 26) and phase not in range(594, 609) and phase not in range(894, 911) and not shared.get('sessions', []) and not shared.get('mangle_present', false) -%}
      {%- do shared.set('to_anomaly', true) -%}
      {%- do shared.set('next_anomaly_epoch', utc.timestamp() + interval) -%}
    {%- else -%}
      {%- do shared.set('next_anomaly_epoch', due) -%}
    {%- endif -%}
  {%- endif -%}
{%- endif -%}
{%- set external_ips = [params.anomaly_source_ip] + params.additional_external_source_ips -%}
{%- if kind in ['external_login', 'unusual_login'] -%}
  {%- set counter_key = 'external_cursor' if kind == 'external_login' else 'episode_cursor' -%}
  {%- set cursor = shared.get(counter_key, 0) % (external_ips | length) -%}
  {%- do shared.set(counter_key, (cursor + 1) % (external_ips | length)) -%}
  {%- do shared.set('external_ip' if kind == 'external_login' else 'episode_ip', external_ips[cursor]) -%}
{%- endif -%}
{%- if kind == 'dhcp' -%}
  {%- set clients = [
    ['10.30.10.101', '02:30:10:00:00:01', 'ws-01'],
    ['10.30.10.102', '02:30:10:00:00:02', 'ws-02'],
    ['10.30.10.103', '02:30:10:00:00:03', 'ws-03'],
    ['10.30.10.104', '02:30:10:00:00:04', 'ws-04'],
    ['10.30.10.105', '02:30:10:00:00:05', 'ws-05'],
    ['10.30.10.106', '02:30:10:00:00:06', 'ws-06'],
    ['10.30.10.107', '02:30:10:00:00:07', 'ws-07'],
    ['10.30.10.108', '02:30:10:00:00:08', 'ws-08']
  ] -%}
  {%- set client = module.rand.choice(clients) -%}
  {%- set client_ip = client[0] -%}
  {%- set client_mac = client[1] -%}
  {%- set active = shared.get('lease_' ~ client_ip, false) -%}
  {%- do shared.set('lease_' ~ client_ip, not active) -%}
  {%- set action = 'dhcp_deassigned' if active else 'dhcp_assigned' -%}
  {%- set message = 'defconf ' ~ ('deassigned' if active else 'assigned') ~ ' ' ~ client_ip ~ ' for ' ~ client_mac ~ ' ' ~ client[2] -%}
{%- elif kind == 'firewall' -%}
  {%- set topic = 'firewall,info' -%}
  {%- set action = 'firewall_log' -%}
  {%- set source_ip = '198.51.100.' ~ module.rand.number.integer(10, 200) -%}
  {%- set source_port = module.rand.number.integer(49152, 65535) -%}
  {%- set destination_ip = params.router_ip -%}
  {%- set destination_port = module.rand.choice([53, 161, 500, 4500]) -%}
  {%- set length = module.rand.number.integer(60, 320) -%}
  {%- set network_transport = 'udp' -%}
  {%- set packet_length = length -%}
  {%- set message = 'input: in:ether1 out:(none), src-mac 02:00:5E:10:00:01, proto UDP, ' ~ source_ip ~ ':' ~ source_port ~ '->' ~ destination_ip ~ ':' ~ destination_port ~ ', len ' ~ length -%}
{%- elif kind in ['external_login', 'external_logout', 'maintenance_login', 'maintenance_logout', 'normal_login', 'normal_logout', 'unusual_login', 'unusual_logout'] -%}
  {%- set topic = 'system,info,account' -%}
  {%- set category = ['authentication'] -%}
  {%- set actor = params.normal_user if kind.startswith('normal_') else params.anomaly_user -%}
  {%- set source_ip = params.normal_source_ip if kind.startswith('normal_') else params.admin_internal_source_ip if kind.startswith('maintenance_') else shared.get('episode_ip') if kind.startswith('unusual_') else shared.get('external_ip') -%}
  {%- set is_login = kind.endswith('login') -%}
  {%- set action = 'login' if is_login else 'logout' -%}
  {%- set sessions = shared.get('sessions', []) -%}
  {%- if is_login -%}
    {%- do sessions.append([actor, source_ip]) -%}
  {%- else -%}
    {%- do sessions.remove([actor, source_ip]) -%}
    {%- if kind == 'external_logout' -%}{%- do shared.pop('external_ip', none) -%}{%- endif -%}
    {%- if kind == 'unusual_logout' -%}{%- do shared.pop('episode_ip', none) -%}{%- endif -%}
  {%- endif -%}
  {%- do shared.set('sessions', sessions[-3:]) -%}
  {%- set message = 'user ' ~ actor ~ ' logged ' ~ ('in' if is_login else 'out') ~ ' from ' ~ source_ip ~ ' via winbox' -%}
{%- else -%}
  {%- set topic = 'system,info' -%}
  {%- set category = ['configuration'] -%}
  {%- set actor = params.anomaly_user -%}
  {%- if kind == 'rule_add' -%}
    {%- do shared.set('mangle_present', true) -%}
  {%- elif kind == 'rule_remove' -%}
    {%- do shared.set('mangle_present', false) -%}
  {%- endif -%}
  {%- set verb = {'rule_add': 'added', 'rule_move': 'moved', 'rule_change': 'changed', 'rule_remove': 'removed'}[kind] -%}
  {%- set action = 'mangle_rule_' ~ verb -%}
  {%- set message = 'mangle rule ' ~ verb ~ ' by ' ~ actor -%}
{%- endif -%}
{%- set pri = 134 -%}
{%- set original = '<' ~ pri ~ '>' ~ utc.strftime('%b %e %H:%M:%S') ~ ' ' ~ params.router_name ~ ' ' ~ topic ~ ' ' ~ message -%}
{
  "@timestamp": {{ utc.isoformat() | tojson }},
  "ecs": {"version": "8.17.0"},
  "event": {"kind": "event", "module": "mikrotik", "dataset": "mikrotik.routeros.syslog", "category": {{ category | tojson }}, "type": ["info"], "action": {{ action | tojson }}, "original": {{ original | tojson }}},
  "message": {{ message | tojson }},
  "observer": {"hostname": {{ params.router_name | tojson }}, "ip": {{ params.router_ip | tojson }}, "vendor": "MikroTik", "product": "RouterOS", "type": "router"},
  "log": {"syslog": {"priority": {{ pri }}, "facility": {"code": 16}, "severity": {"code": 6}}},
  "mikrotik": {"topics": {{ topic.split(',') | tojson }}}
  {%- if actor is not none %}, "user": {"name": {{ actor | tojson }}}{% endif %}
  {%- if source_ip is not none %}, "source": {"ip": {{ source_ip | tojson }}{% if source_port is not none %}, "port": {{ source_port }}, "mac": "02:00:5E:10:00:01"{% endif %}}{% endif %}
  {%- if destination_ip is not none %}, "destination": {"ip": {{ destination_ip | tojson }}, "port": {{ destination_port }}}{% endif %}
  {%- if network_transport is not none %}, "network": {"transport": {{ network_transport | tojson }}, "bytes": {{ packet_length }}}{% endif %}
  {%- if client_ip is not none %}, "client": {"ip": {{ client_ip | tojson }}, "mac": {{ client_mac | tojson }}}{% endif %}
}
