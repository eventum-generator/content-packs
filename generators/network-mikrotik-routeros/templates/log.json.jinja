{%- set step = vars.step -%}
{%- set topic = 'dhcp,info' -%}
{%- set message = 'defconf assigned 192.168.88.37 for B0:E4:5C:27:EF:F2 Samsung' -%}
{%- set action = 'dhcp_assigned' -%}
{%- set category = ['network'] -%}
{%- set source_ip = none -%}
{%- set actor = none -%}
{%- if step == 'routine' -%}
  {%- do shared.pop('to_anomaly', none) -%}
  {%- set count = shared.get('routine_count', 0) + 1 -%}
  {%- if count >= params.anomaly_interval_events -%}
    {%- do shared.set('routine_count', 0) -%}
    {%- if params.anomaly_mode -%}
      {%- do shared.set('to_anomaly', true) -%}
    {%- endif -%}
  {%- else -%}
    {%- do shared.set('routine_count', count) -%}
  {%- endif -%}
  {%- set kind = module.rand.weighted_choice(['dhcp_assign', 'dhcp_deassign', 'firewall', 'login', 'logout'], [45, 22, 25, 5, 3]) -%}
  {%- if kind == 'dhcp_deassign' -%}
    {%- set action = 'dhcp_deassigned' -%}
    {%- set message = 'defconf deassigned 192.168.88.37 for B0:E4:5C:27:EF:F2 Samsung' -%}
  {%- elif kind == 'firewall' -%}
    {%- set topic = 'firewall,info' -%}
    {%- set action = 'firewall_log' -%}
    {%- set message = 'input: in:ether1 out:(none), src-mac 00:21:29:6d:82:07, proto UDP, 10.1.101.1:520->10.1.101.255:520, len 452' -%}
  {%- elif kind == 'login' or kind == 'logout' -%}
    {%- set topic = 'system,info,account' -%}
    {%- set action = 'login' if kind == 'login' else 'logout' -%}
    {%- set category = ['authentication'] -%}
    {%- set actor = params.normal_user -%}
    {%- set source_ip = params.normal_source_ip -%}
    {%- set message = 'user ' ~ actor ~ ' logged ' ~ ('in' if kind == 'login' else 'out') ~ ' from ' ~ source_ip ~ ' via winbox' -%}
  {%- endif -%}
{%- elif step == 'unusual_login' -%}
  {%- set topic = 'system,info,account' -%}
  {%- set action = 'login' -%}
  {%- set category = ['authentication'] -%}
  {%- set actor = params.anomaly_user -%}
  {%- set source_ip = params.anomaly_source_ip -%}
  {%- set message = 'user ' ~ actor ~ ' logged in from ' ~ source_ip ~ ' via winbox' -%}
{%- else -%}
  {%- set topic = 'system,info' -%}
  {%- set category = ['configuration'] -%}
  {%- set actor = params.anomaly_user -%}
  {%- set action = {'rule_add': 'mangle_rule_added', 'rule_move': 'mangle_rule_moved', 'rule_change': 'mangle_rule_changed'}[step] -%}
  {%- set message = 'mangle rule ' ~ {'rule_add': 'added', 'rule_move': 'moved', 'rule_change': 'changed'}[step] ~ ' by ' ~ actor -%}
{%- endif -%}
{%- set pri = 134 -%}
{%- set original = '<' ~ pri ~ '>' ~ timestamp.strftime('%b %d %H:%M:%S') ~ ' ' ~ params.router_name ~ ' ' ~ topic ~ ' ' ~ message -%}
{
  "@timestamp": {{ timestamp.isoformat() | tojson }},
  "ecs": {"version": "8.17.0"},
  "event": {"kind": "event", "module": "mikrotik", "dataset": "mikrotik.routeros.syslog", "category": {{ category | tojson }}, "type": ["info"], "action": {{ action | tojson }}, "original": {{ original | tojson }}},
  "message": {{ message | tojson }},
  "observer": {"hostname": {{ params.router_name | tojson }}, "ip": {{ params.router_ip | tojson }}, "vendor": "MikroTik", "product": "RouterOS", "type": "router"},
  "log": {"syslog": {"priority": {{ pri }}, "facility": {"code": 16}, "severity": {"code": 6}}},
  "mikrotik": {"topics": {{ topic.split(',') | tojson }}},
  "user": {"name": {{ actor | tojson }}},
  "source": {"ip": {{ source_ip | tojson }}}
}
