{%- for key in ['to_candidate_add', 'to_group_add', 'to_password_replace', 'to_routine'] -%}{%- do shared.pop(key, none) -%}{%- endfor -%}
{%- set stage = vars.stage -%}
{%- set serial = (shared.get('serial', 0) % 999999) + 1 -%}{%- do shared.set('serial', serial) -%}
{%- set epoch = timestamp.timestamp() | int -%}
{%- set generalized = timestamp.strftime('%Y%m%d%H%M%SZ') -%}
{%- set csn = timestamp.strftime('%Y%m%d%H%M%S') ~ '.000000Z#' ~ '%06d'|format(serial) ~ '#000#000000' -%}
{%- set actors = ['cn=admin,' ~ params.base_dn, params.operator_dn, 'uid=svc-provision,ou=People,' ~ params.base_dn] -%}
{%- set actor_index = module.rand.weighted_choice([0, 1, 2], [50, 35, 15]) -%}
{%- set actor = actors[actor_index] -%}
{%- set peer_ip = ['10.24.1.10', '10.24.1.11', '10.24.1.12'][actor_index] -%}
{%- set peer_port = 52110 + actor_index -%}
{%- set conn = 1001 + actor_index -%}
{%- set known_services = shared.get('known_services', ['svc-app01', 'svc-scheduler', 'svc-monitor']) -%}
{%- set change = 'modify' -%}
{%- set operation = 'replace' -%}
{%- set attribute = 'description' -%}
{%- set value = 'Account profile review ' ~ '%06d'|format(serial) -%}
{%- set target_uid = 'employee' ~ '%03d'|format(module.rand.number.integer(1, 80)) -%}
{%- set dn = 'uid=' ~ target_uid ~ ',ou=People,' ~ params.base_dn -%}
{%- if stage == 'routine' -%}
  {%- set count = (shared.get('routine_count', 0) % 1000000) + 1 -%}
  {%- do shared.set('routine_count', count) -%}
  {%- if params.anomaly_mode -%}
    {%- set next_due = shared.get('next_anomaly_epoch', none) -%}
    {%- if next_due is none -%}
      {%- do shared.set('next_anomaly_epoch', epoch + params.anomaly_interval_hours * 3600) -%}
    {%- elif epoch >= next_due -%}
      {%- do shared.set('next_anomaly_epoch', epoch + params.anomaly_interval_hours * 3600) -%}
      {%- do shared.set('to_candidate_add', true) -%}
    {%- endif -%}
  {%- endif -%}
  {%- set routine_kind = 'account_add' if count == 30 else module.rand.weighted_choice(['metadata', 'password', 'member', 'account_add'], [88, 5, 5, 2]) -%}
  {%- if routine_kind == 'metadata' -%}
    {%- if module.rand.chance(15) -%}
      {%- set target_uid = module.rand.choice(known_services) -%}
      {%- set dn = 'uid=' ~ target_uid ~ ',ou=People,' ~ params.base_dn -%}
    {%- endif -%}
    {%- set attribute = module.rand.weighted_choice(['description', 'telephoneNumber', 'title', 'mail'], [50, 20, 20, 10]) -%}
    {%- set value = {'description': 'Account profile review ' ~ '%06d'|format(serial), 'telephoneNumber': '+1 555 ' ~ '%07d'|format(serial % 10000000), 'title': module.rand.choice(['Analyst', 'Engineer', 'Service Operator', 'Support Specialist']), 'mail': target_uid ~ '@corp.example'}[attribute] -%}
  {%- elif routine_kind == 'password' -%}
    {%- set target_uid = module.rand.choice(known_services) if module.rand.chance(30) else 'employee' ~ '%03d'|format(module.rand.number.integer(1, 80)) -%}
    {%- set dn = 'uid=' ~ target_uid ~ ',ou=People,' ~ params.base_dn -%}
    {%- set attribute = 'userPassword' -%}
  {%- elif routine_kind == 'member' -%}
    {%- set memberships = shared.get('memberships', []) -%}
    {%- if memberships|length >= 20 -%}
      {%- set pair = memberships.pop(0) -%}
      {%- set group_name = pair[0] -%}{%- set member_dn = pair[1] -%}
      {%- set operation = 'delete' -%}
    {%- else -%}
      {%- set member_index = (shared.get('member_index', 0) % 80) + 1 -%}{%- do shared.set('member_index', member_index) -%}
      {%- set group_name = params.privileged_group if member_index % 10 == 0 else ('app-operators' if member_index % 3 == 0 else 'vpn-users') -%}
      {%- set member_dn = 'uid=employee' ~ '%03d'|format(member_index) ~ ',ou=People,' ~ params.base_dn -%}
      {%- set operation = 'add' -%}
      {%- do memberships.append([group_name, member_dn]) -%}
    {%- endif -%}
    {%- do shared.set('memberships', memberships) -%}
    {%- set dn = 'cn=' ~ group_name ~ ',ou=Groups,' ~ params.base_dn -%}
    {%- set attribute = 'member' -%}{%- set value = member_dn -%}
  {%- else -%}
    {%- set service_seq = (shared.get('service_seq', 0) % 999999) + 1 -%}{%- do shared.set('service_seq', service_seq) -%}
    {%- set service_prefix = params.backdoor_uid if count == 30 or module.rand.chance(20) else 'svc-worker' -%}
    {%- set target_uid = service_prefix ~ '-' ~ '%06d'|format(service_seq) -%}
    {%- set dn = 'uid=' ~ target_uid ~ ',ou=People,' ~ params.base_dn -%}
    {%- set change = 'add' -%}{%- set attribute = 'uid' -%}{%- set value = target_uid -%}
    {%- do known_services.append(target_uid) -%}
    {%- if known_services|length > 40 -%}{%- do known_services.pop(0) -%}{%- endif -%}
    {%- do shared.set('known_services', known_services) -%}
  {%- endif -%}
{%- elif stage == 'candidate_add' -%}
  {%- set actor_index = 1 -%}{%- set actor = actors[1] -%}{%- set peer_ip = '10.24.1.11' -%}{%- set peer_port = 52111 -%}{%- set conn = 1002 -%}
  {%- set service_seq = (shared.get('service_seq', 0) % 999999) + 1 -%}{%- do shared.set('service_seq', service_seq) -%}
  {%- set target_uid = params.backdoor_uid ~ '-' ~ '%06d'|format(service_seq) -%}
  {%- do shared.set('chain_target_uid', target_uid) -%}
  {%- set dn = 'uid=' ~ target_uid ~ ',ou=People,' ~ params.base_dn -%}
  {%- set change = 'add' -%}{%- set attribute = 'uid' -%}{%- set value = target_uid -%}
  {%- do known_services.append(target_uid) -%}
  {%- if known_services|length > 40 -%}{%- do known_services.pop(0) -%}{%- endif -%}
  {%- do shared.set('known_services', known_services) -%}
  {%- if params.anomaly_mode -%}{%- do shared.set('to_group_add', true) -%}{%- else -%}{%- do shared.set('to_routine', true) -%}{%- endif -%}
{%- else -%}
  {%- set actor_index = 1 -%}{%- set actor = actors[1] -%}{%- set peer_ip = '10.24.1.11' -%}{%- set peer_port = 52111 -%}{%- set conn = 1002 -%}
  {%- set target_uid = shared.get('chain_target_uid') -%}
  {%- set member_dn = 'uid=' ~ target_uid ~ ',ou=People,' ~ params.base_dn -%}
  {%- if stage == 'group_add' -%}
    {%- set dn = 'cn=' ~ params.privileged_group ~ ',ou=Groups,' ~ params.base_dn -%}
    {%- set attribute = 'member' -%}{%- set operation = 'add' -%}{%- set value = member_dn -%}
    {%- do shared.set('to_password_replace', true) -%}
  {%- else -%}
    {%- set dn = member_dn -%}{%- set attribute = 'userPassword' -%}
    {%- do shared.set('to_routine', true) -%}
    {%- do shared.pop('chain_target_uid', none) -%}
  {%- endif -%}
{%- endif -%}
{%- set salt = '%08d'|format(serial) -%}
{%- if change == 'add' or attribute == 'userPassword' -%}
  {%- set digest = module.hashlib.sha1(('synthetic-only-' ~ serial ~ '-' ~ target_uid ~ salt).encode('ascii')).digest() -%}
  {%- set hash_value = '{SSHA}' ~ module.base64.b64encode(digest + salt.encode('ascii')).decode('ascii') -%}
  {%- if attribute == 'userPassword' -%}{%- set value = hash_value -%}{%- endif -%}
{%- endif -%}
{%- set prefix = '# ' ~ change ~ ' ' ~ epoch ~ ' ' ~ params.base_dn ~ ' ' ~ actor ~ ' IP=' ~ peer_ip ~ ':' ~ peer_port ~ ' conn=' ~ conn ~ '\ndn: ' ~ dn ~ '\nchangetype: ' ~ change ~ '\n' -%}
{%- if change == 'add' -%}
  {%- set cn = 'Service Account ' ~ '%06d'|format(service_seq) -%}
  {%- set body = 'objectClass: top\nobjectClass: person\nobjectClass: organizationalPerson\nobjectClass: inetOrgPerson\nuid: ' ~ target_uid ~ '\ncn: ' ~ cn ~ '\nsn: ' ~ 'Service' ~ '\nuserPassword: ' ~ hash_value ~ '\nstructuralObjectClass: inetOrgPerson\nentryUUID: ' ~ module.rand.crypto.uuid4() ~ '\ncreatorsName: ' ~ actor ~ '\ncreateTimestamp: ' ~ generalized ~ '\nmodifiersName: ' ~ actor ~ '\nmodifyTimestamp: ' ~ generalized ~ '\nentryCSN: ' ~ csn ~ '\n' -%}
{%- else -%}
  {%- set body = operation ~ ': ' ~ attribute ~ '\n' ~ attribute ~ ': ' ~ value ~ '\n-\nreplace: entryCSN\nentryCSN: ' ~ csn ~ '\n-\nreplace: modifiersName\nmodifiersName: ' ~ actor ~ '\n-\nreplace: modifyTimestamp\nmodifyTimestamp: ' ~ generalized ~ '\n-\n' -%}
{%- endif -%}
{%- set original = prefix ~ body ~ '# end ' ~ change ~ ' ' ~ epoch ~ '\n\n' -%}
{%- set event = {
  '@timestamp': timestamp.isoformat(),
  'ecs': {'version': '8.17.0'},
  'event': {'kind': 'event', 'category': ['iam'], 'type': ['creation'] if change == 'add' else ['change'], 'action': 'ldap-' ~ change, 'outcome': 'success', 'original': original},
  'host': {'name': params.host_name},
  'source': {'ip': peer_ip, 'port': peer_port},
  'user': {'name': actor},
  'related': {'user': [actor, member_dn if attribute == 'member' else dn], 'ip': [peer_ip]},
  'ldap': {'auditlog': {'base_dn': params.base_dn, 'actor_dn': actor, 'peer_ip': peer_ip, 'peer_port': peer_port, 'connection_id': conn, 'target_dn': dn, 'change_type': change, 'operation': operation if change == 'modify' else none, 'attribute': attribute, 'value': value, 'entry_csn': csn}}
} -%}
{{- event | tojson -}}
