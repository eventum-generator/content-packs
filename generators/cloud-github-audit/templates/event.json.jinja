{%- for mark in ['to_add_member', 'to_elevate_member', 'to_disable_protection', 'to_download_archive', 'to_delete_repo', 'to_routine'] -%}
  {%- do shared.pop(mark, none) -%}
{%- endfor -%}
{%- set stage = vars.stage -%}
{%- set actor_ids = {'alice': 32100011, 'bob': 32100012, 'ci-bot': 32100013} -%}
{%- if stage == 'routine' -%}
  {%- set action = module.rand.weighted_choice(['repo.add_topic', 'repo.create', 'repo.download_zip', 'org.add_member'], [60, 15, 20, 5]) -%}
  {%- set actor = module.rand.choice(['alice', 'bob', 'ci-bot']) -%}
  {%- set actor_id = actor_ids[actor] -%}
  {%- set repo = params.org ~ '/' ~ module.rand.choice(['api-gateway', 'billing-web', 'infra-modules', 'auth-service']) -%}
  {%- set repo_id = {'api-gateway': 111001, 'billing-web': 111002, 'infra-modules': 111003, 'auth-service': 111004}[repo.split('/')[-1]] -%}
  {%- if action == 'repo.create' -%}
    {%- set created = shared.get('created_repos', 0) + 1 -%}
    {%- do shared.set('created_repos', created) -%}
    {%- set repo = params.org ~ '/sandbox-' ~ created -%}
    {%- set repo_id = 200000 + created -%}
  {%- endif -%}
  {%- set n = shared.get('routine_count', 0) + 1 -%}
  {%- if n >= 400 -%}
    {%- do shared.set('routine_count', 0) -%}
    {%- if params.anomaly_mode -%}
      {%- set cycle = shared.get('attack_cycle', 0) + 1 -%}
      {%- do shared.set('attack_cycle', cycle) -%}
      {%- do shared.set('attack_repo', params.sensitive_repo ~ '-' ~ cycle) -%}
      {%- do shared.set('attack_repo_id', params.sensitive_repo_id + cycle) -%}
      {%- do shared.set('to_add_member', true) -%}
    {%- endif -%}
  {%- else -%}
    {%- do shared.set('routine_count', n) -%}
  {%- endif -%}
{%- else -%}
  {%- set actor = params.suspicious_actor -%}
  {%- set actor_id = params.suspicious_actor_id -%}
  {%- set repo = shared.get('attack_repo') -%}
  {%- set repo_id = shared.get('attack_repo_id') -%}
  {%- if stage == 'add_member' -%}
    {%- set action = 'repo.add_member' -%}
    {%- do shared.set('to_elevate_member', true) -%}
  {%- elif stage == 'elevate_member' -%}
    {%- set action = 'repo.update_member' -%}
    {%- do shared.set('to_disable_protection', true) -%}
  {%- elif stage == 'disable_protection' -%}
    {%- set action = 'protected_branch.destroy' -%}
    {%- do shared.set('to_download_archive', true) -%}
  {%- elif stage == 'download_archive' -%}
    {%- set action = 'repo.download_zip' -%}
    {%- do shared.set('to_delete_repo', true) -%}
  {%- else -%}
    {%- set action = 'repo.destroy' -%}
    {%- do shared.set('to_routine', true) -%}
  {%- endif -%}
{%- endif -%}
{%- set document_id = module.rand.string.letters(20) -%}
{%- set native = {
    '@timestamp': (timestamp.timestamp() * 1000)|int,
    '_document_id': document_id,
    'action': action, 'actor': actor, 'actor_id': actor_id,
    'created_at': (timestamp.timestamp() * 1000)|int,
    'org': params.org, 'org_id': params.org_id,
    'repo': repo, 'repo_id': repo_id,
    'visibility': 'private'
} -%}
{%- if action == 'repo.add_member' or action == 'repo.update_member' -%}
  {%- do native.update({'user': params.external_user, 'user_id': params.external_user_id}) -%}
  {%- if action == 'repo.add_member' -%}
    {%- do native.update({'permission': 'write'}) -%}
  {%- else -%}
    {%- do native.update({'old_repo_permission': 'write', 'new_repo_permission': 'admin'}) -%}
  {%- endif -%}
{%- elif action == 'protected_branch.destroy' -%}
  {%- do native.update({'name': 'main', 'admin_enforced': true}) -%}
{%- elif action == 'repo.add_topic' -%}
  {%- do native.update({'topic': module.rand.choice(['security', 'backend', 'infra'])}) -%}
{%- elif action == 'repo.create' -%}
  {%- do native.update({'operation_type': 'create'}) -%}
{%- elif action == 'org.add_member' -%}
  {%- set member_no = shared.get('new_members', 0) + 1 -%}
  {%- do shared.set('new_members', member_no) -%}
  {%- do native.update({'user': 'new-hire-' ~ member_no,
                         'user_id': 32100099 + member_no,
                         'permission': 'member'}) -%}
{%- endif -%}
{%- set related_users = [actor, native.user] if native.user is defined else [actor] -%}
{%- set category = action.split('.')[0] -%}
{%- set doc = {
    '@timestamp': timestamp.isoformat(),
    'agent': {'ephemeral_id': params.collector_ephemeral_id,
              'id': params.collector_id, 'name': 'github-audit-collector',
              'type': 'filebeat', 'version': params.collector_version},
    'data_stream': {'dataset': 'github.audit', 'namespace': 'default', 'type': 'logs'},
    'ecs': {'version': '8.17.0'},
    'elastic_agent': {'id': params.collector_id, 'snapshot': false,
                      'version': params.collector_version},
    'event': {'action': action, 'agent_id_status': 'verified',
              'category': ['configuration', 'web'],
              'created': timestamp.isoformat(), 'dataset': 'github.audit',
              'id': document_id, 'ingested': timestamp.isoformat(),
              'kind': 'event', 'module': 'github',
              'original': native|tojson,
              'type': ['access'] if action == 'repo.download_zip' else ['change']},
    'github': {'category': category, 'org': params.org,
               'repo': repo, 'visibility': 'private'},
    'input': {'type': 'httpjson'},
    'related': {'user': related_users},
    'tags': ['forwarded', 'github-audit', 'preserve_original_event'],
    'user': {'name': actor}
} -%}
{{- doc|tojson -}}
