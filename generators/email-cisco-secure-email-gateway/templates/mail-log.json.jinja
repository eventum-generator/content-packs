{#- Cisco Secure Email Gateway (AsyncOS 16.x) text mail_logs pushed over
    syslog, one virtual appliance with a single Management interface and
    one public listener (internal Exchange hosts relay through RELAYLIST).

    Four ticks per second each emit at most one log line, taken from a
    due-queue fed by independent random processes: outbound mail per
    internal user (thinned by the user's own working hours) and inbound
    internet mail. The anomaly episode only adds its own messages to the
    queue; it never suspends, delays or reshapes background mail.

    Line grammar follows the AsyncOS 16.5 "Text Mail Logs" examples;
    structured fields follow the Elastic cisco_secure_email_gateway
    ingest pipeline (default.yml, pipeline_text_mail_logs.yml). -#}
{%- set now = timestamp.timestamp() | int -%}
{%- set interval = params.anomaly_interval_hours | float -%}
{%- set big = params.large_message_bytes | int -%}
{#- Chain window; the background guard adds a few seconds for lines that
    a busy second pushes into the next one. -#}
{%- set window = 2400 -%}
{%- set guard = window + 10 -%}
{%- set ifip = params.interface_ip -%}

{%- if not shared.get('initialized', false) -%}
  {%- if not (1 <= interval <= 8760) -%}{{ module.math.sqrt(-1) }}{%- endif -%}
  {%- if params.users | length < 4 -%}{{ module.math.sqrt(-1) }}{%- endif -%}
  {%- set mx = {params.internal_domain: none} -%}
  {%- set style = {} -%}
  {%- for d in params.partner_domains + params.freemail_domains -%}
    {%- do mx.update({d.domain: d.ip}) -%}
    {%- do style.update({d.domain: module.rand.weighted_choice(['postfix', 'exchange'], [60, 40])}) -%}
  {%- endfor -%}
  {%- set contacts = [] -%}
  {%- for d in params.partner_domains -%}
    {%- for n in module.rand.choices(params.contact_names, 5) | unique -%}
      {%- do contacts.append(n ~ '.' ~ module.rand.string.letters_lowercase(1) ~ '@' ~ d.domain) -%}
    {%- endfor -%}
  {%- endfor -%}
  {%- set users = [] -%}
  {%- set weights = [] -%}
  {%- for name in params.users -%}
    {%- set fm = module.rand.choice(params.freemail_domains).domain -%}
    {%- do users.append({'addr': name ~ '@' ~ params.internal_domain,
        'personal': name ~ module.rand.number.integer(70, 99) ~ '@' ~ fm,
        'contacts': module.rand.choices(contacts, module.rand.number.integer(2, 6)) | unique | list,
        'relay': module.rand.choice(params.relay_hosts),
        'shift': [module.rand.number.floating(5.0, 9.5), module.rand.number.floating(7.5, 10.5)]}) -%}
    {%- do weights.append(module.rand.number.lognormal(0, 0.8)) -%}
  {%- endfor -%}
  {%- do shared.update({'initialized': true, 'users': users, 'weights': weights,
      'contacts': contacts, 'mx': mx, 'style': style,
      'mid': module.rand.number.integer(1000000, 90000000),
      'icid': module.rand.number.integer(1000000, 90000000),
      'dcid': module.rand.number.integer(100000, 9000000),
      'rcid': module.rand.number.integer(10000, 900000),
      'seq': 0, 'q': [], 'big': {},
      'next_due': now + (interval * 3600) | int, 'start_at': none, 'last_user': none}) -%}
{%- endif -%}

{%- set users = shared.get('users') -%}
{%- set q = shared.get('q') -%}
{%- set bigs = shared.get('big') -%}
{%- set hod = (now % 86400) / 3600 -%}
{%- set fresh = now != shared.get('last_sec') -%}
{%- do shared.set('last_sec', now) -%}
{%- if fresh and now % 600 == 0 -%}
  {%- for k in bigs | list -%}
    {%- set keep = bigs[k] | select('gt', now - 2 * guard) | list -%}
    {%- if keep -%}{%- do bigs.update({k: keep}) -%}{%- else -%}{%- do bigs.pop(k) -%}{%- endif -%}
  {%- endfor -%}
{%- endif -%}

{%- macro gap(median, sigma) -%}
{{- [(module.rand.number.lognormal(module.math.log(median), sigma)) | round | int, 0] | max -}}
{%- endmacro -%}

{%- macro nextid(key) -%}
  {%- do shared.set(key, shared.get(key) + 1) -%}{{- shared.get(key) -}}
{%- endmacro -%}

{#- Queue one line: due second, level, text, parsed fields. -#}
{%- macro enq(at, lvl, text, f) -%}
  {%- do shared.set('seq', shared.get('seq') + 1) -%}
  {%- do module.bisect.insort(q, (at, shared.get('seq'), {'lvl': lvl, 'text': text, 'f': f, 'tok': shared.get('_tok')})) -%}
{%- endmacro -%}

{%- macro activity(u) -%}
  {%- set into = (hod - u.shift[0]) % 24 -%}
  {{- 1.0 if into < u.shift[1] else (0.35 if into < u.shift[1] + 3 else 0.08) -}}
{%- endmacro -%}

{%- macro body_size() -%}
{{- (module.rand.number.lognormal(module.math.log(14000), 0.9)) | int + 900 -}}
{%- endmacro -%}

{#- Attachment payload in bytes: ordinary documents or large files. -#}
{%- macro att_size(kind) -%}
  {%- set s = namespace(v=0) -%}
  {%- for i in range(20) -%}
    {%- if s.v == 0 -%}
      {%- set v = module.rand.number.lognormal(module.math.log(450000 if kind == 'doc' else 6000000), 1.4 if kind == 'doc' else 0.55) * 1.37 -%}
      {%- if kind != 'chain' or v >= big -%}
        {%- if v < params.max_message_bytes - 60000 -%}{%- set s.v = v | int -%}{%- endif -%}
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}
  {{- s.v if s.v > 0 else 60000 -}}
{%- endmacro -%}

{%- macro sbrs_of(base) -%}
{{- '%.1f' | format(module.rand.number.clamp(base + module.rand.number.gauss(0, 0.4), -1.0, 10.0)) -}}
{%- endmacro -%}

{#- Seconds from connection to the Start line and from there to the
    ready line (transfer time grows with size), written to shared._plan. -#}
{%- macro lead_plan(dirn, size) -%}
  {%- set bw = module.rand.number.lognormal(module.math.log(2500000 if dirn == 'out' else 600000), 0.7) -%}
  {%- do shared.set('_plan', [gap(1.5, 1.0) | int, gap(2, 0.9) | int + (size / bw) | int]) -%}
{%- endmacro -%}

{#- One message through the gateway: injection, scanning, delivery.
    dirn: out (internal relay -> internet) or in (internet -> relay).
    rcpts: list of {a: address, bad: bool}. verdict (inbound only):
    clean, bulk, suspect, positive, virus. -#}
{%- macro mail(at, dirn, cip, rdns, verified, sgline, sender, rcpts, size, atts, verdict, subject, plan=none) -%}
  {%- if plan is none -%}{{- lead_plan(dirn, size) -}}{%- set plan = shared.get('_plan') -%}{%- endif -%}
  {%- set t = namespace(v=at) -%}
  {%- do shared.set('_tok', {}) -%}{%- set icid = '{I}' -%}
  {%- set mid = '{M}' -%}
  {%- set sid = mid | string -%}
  {%- set conn = {'connection_status': 'New', 'injection_connection_id': icid | string, 'interface': ifip, 'address': cip, 'verified': verified} -%}
  {{- enq(t.v, 'Info', 'New SMTP ICID ' ~ icid ~ ' interface Management (' ~ ifip ~ ') address ' ~ cip ~ ' reverse dns host ' ~ rdns ~ ' verified ' ~ verified,
      {'log': conn, 'proto': 'smtp', 'dns': rdns, 'rel': [ifip, cip] | unique | list}) -}}
  {{- enq(t.v, 'Info', 'ICID ' ~ icid ~ ' ' ~ sgline, {}) -}}
  {%- set t.v = t.v + plan[0] -%}
  {{- enq(t.v, 'Info', 'Start MID ' ~ mid ~ ' ICID ' ~ icid, {'log': {'connection_status': 'Start', 'injection_connection_id': icid | string}, 'email': {'message_id': sid}}) -}}
  {{- enq(t.v, 'Info', 'MID ' ~ mid ~ ' ICID ' ~ icid ~ ' From: <' ~ sender ~ '>', {'log': {'injection_connection_id': icid | string}, 'email': {'message_id': sid, 'from': {'address': [sender]}}}) -}}
  {%- for r in rcpts -%}
    {{- enq(t.v, 'Info', 'MID ' ~ mid ~ ' ICID ' ~ icid ~ ' RID ' ~ loop.index0 ~ ' To: <' ~ r.a ~ '>', {'log': {'injection_connection_id': icid | string, 'recipient_id': loop.index0 | string}, 'email': {'message_id': sid, 'to': {'address': [r.a]}}}) -}}
  {%- endfor -%}
  {%- set sdom = sender.split('@')[-1] -%}
  {%- set msgid = (module.rand.crypto.uuid4() | replace('-', '') | upper) ~ '@' ~ (rdns if dirn == 'out' else sdom) -%}
  {%- set t.v = t.v + plan[1] -%}
  {{- enq(t.v, 'Info', 'MID ' ~ mid ~ " Message-ID '<" ~ msgid ~ ">'", {'log': {'email': msgid}, 'email': {'message_id': sid}}) -}}
  {{- enq(t.v, 'Info', 'MID ' ~ mid ~ " Subject '" ~ subject ~ "'", {'email': {'message_id': sid}}) -}}
  {{- enq(t.v, 'Info', 'MID ' ~ mid ~ ' ready ' ~ size ~ ' bytes from <' ~ sender ~ '>', {'log': {'read_bytes': size}, 'email': {'message_id': sid, 'from': {'address': [sender]}}}) -}}
  {%- set table = 'outbound' if dirn == 'out' else 'inbound' -%}
  {{- enq(t.v, 'Info', 'MID ' ~ mid ~ ' matched all recipients for per-recipient policy DEFAULT in the ' ~ table ~ ' table', {'log': {'policy': 'DEFAULT'}, 'email': {'message_id': sid, 'direction': table}}) -}}
  {%- if dirn == 'in' and verdict in ['clean', 'bulk'] -%}
    {{- enq(t.v, 'Info', 'MID ' ~ mid ~ ' SPF: mailfrom identity ' ~ sender ~ ' Pass (v=spf1)', {'log': {'verified': 'Pass'}, 'proto': 'spf', 'email': {'message_id': sid, 'from': {'address': [sender]}}}) -}}
    {%- set sel = 'sel' ~ (sdom | length % 3 + 1) -%}
    {%- set det = 'd=' ~ sdom ~ ' s=' ~ sel ~ ' i=@' ~ sdom -%}
    {{- enq(t.v, 'Info', 'MID ' ~ mid ~ ' DKIM: pass signature verified (' ~ det ~ ')', {'log': {'verified': 'verified', 'details': det}, 'proto': 'dkim', 'email': {'message_id': sid}}) -}}
    {{- enq(t.v, 'Info', 'MID ' ~ mid ~ ' DMARC: Message from domain ' ~ sdom ~ ', DMARC pass (SPF aligned True, DKIM aligned True)', {'log': {'verified': 'pass', 'spf_aligned': true, 'dkim_aligned': true}, 'proto': 'dmarc', 'email': {'message_id': sid, 'from': {'address': [sdom]}}}) -}}
  {%- endif -%}
  {%- set t.v = t.v + gap(0.8, 1.0) | int -%}
  {{- enq(t.v, 'Info', 'ICID ' ~ icid ~ ' close', {'log': {'connection_status': 'close', 'injection_connection_id': icid | string}}) -}}
  {%- if dirn == 'in' -%}
    {%- set case = {'clean': 'CASE spam negative', 'bulk': 'CASE spam negative', 'suspect': 'CASE spam suspect', 'positive': 'CASE spam positive', 'virus': 'CASE spam negative'}[verdict] -%}
    {{- enq(t.v, 'Info', 'MID ' ~ mid ~ ' interim verdict using engine: ' ~ case, {'log': {'engine': case}, 'email': {'message_id': sid}}) -}}
    {%- set t.v = t.v + gap(1, 0.8) | int -%}
    {{- enq(t.v, 'Info', 'MID ' ~ mid ~ ' using engine: ' ~ case, {'log': {'engine': case}, 'email': {'message_id': sid}}) -}}
    {%- if verdict == 'bulk' -%}
      {{- enq(t.v, 'Info', 'MID ' ~ mid ~ ' using engine: GRAYMAIL positive', {'log': {'engine': 'GRAYMAIL positive'}, 'email': {'message_id': sid}}) -}}
    {%- endif -%}
    {%- if verdict in ['suspect', 'positive'] -%}
      {{- enq(t.v, 'Info', 'EUQ: Tagging MID ' ~ mid ~ ' for quarantine', {'email': {'message_id': sid}}) -}}
    {%- endif -%}
  {%- endif -%}
  {%- if verdict == 'virus' -%}
    {%- set vname = module.rand.choice(['Troj/DocDl-AGSR', 'Mal/DrodZp-A', 'Troj/Agent-BGXK', 'Mal/Phish-A']) -%}
    {{- enq(t.v, 'Info', 'MID ' ~ mid ~ " antivirus positive '" ~ vname ~ "'", {'email': {'message_id': sid}}) -}}
    {{- enq(t.v, 'Info', 'Message aborted MID ' ~ mid ~ ' Dropped by antivirus', {'email': {'message_id': sid}}) -}}
    {{- enq(t.v, 'Info', 'Message finished MID ' ~ mid ~ ' done', {'log': {'message_status': 'finished'}, 'email': {'message_id': sid}}) -}}
  {%- else -%}
    {{- enq(t.v, 'Info', 'MID ' ~ mid ~ ' interim AV verdict using Sophos CLEAN', {'log': {'engine': 'Sophos CLEAN'}, 'email': {'message_id': sid}}) -}}
    {{- enq(t.v, 'Info', 'MID ' ~ mid ~ ' antivirus negative', {'email': {'message_id': sid}}) -}}
    {%- for a in atts -%}
      {{- enq(t.v, 'Info', 'MID ' ~ mid ~ " attachment '" ~ a ~ "'", {'email': {'message_id': sid}}) -}}
    {%- endfor -%}
    {%- if dirn == 'in' -%}
      {{- enq(t.v, 'Info', 'MID ' ~ mid ~ ' Outbreak Filters: verdict negative', {'log': {'subject': 'Outbreak Filters', 'verdict_scale': 'negative'}, 'email': {'message_id': sid}}) -}}
    {%- endif -%}
    {%- set t.v = t.v + gap(1, 0.8) | int -%}
    {{- enq(t.v, 'Info', 'MID ' ~ mid ~ ' queued for delivery', {'log': {'message_status': 'queued'}, 'email': {'message_id': sid}}) -}}
    {%- if verdict in ['suspect', 'positive'] -%}
      {%- set rcid = '{R}' -%}
      {%- set t.v = t.v + gap(2, 0.7) | int -%}
      {{- enq(t.v, 'Info', 'RPC Delivery start RCID ' ~ rcid ~ ' MID ' ~ mid ~ ' to local IronPort Spam Quarantine', {'email': {'message_id': sid}}) -}}
      {%- set t.v = t.v + gap(1, 0.6) | int -%}
      {{- enq(t.v, 'Info', 'EUQ: Quarantined MID ' ~ mid, {'email': {'message_id': sid}}) -}}
      {{- enq(t.v, 'Info', 'RPC Message done RCID ' ~ rcid ~ ' MID ' ~ mid, {'email': {'message_id': sid}}) -}}
    {%- else -%}
      {#- One delivery connection per destination domain. -#}
      {%- set groups = {} -%}
      {%- for r in rcpts -%}
        {%- set d = params.internal_domain if dirn == 'in' else r.a.split('@')[-1] -%}
        {%- do groups.update({d: groups.get(d, []) + [loop.index0]}) -%}
      {%- endfor -%}
      {%- set t.v = t.v + gap(1, 0.8) | int -%}
      {%- set last = namespace(v=t.v) -%}
      {%- for d, rids in groups.items() -%}
        {%- set dcid = '{D' ~ loop.index0 ~ '}' -%}
        {%- set relay = module.rand.choice(params.relay_hosts) -%}
        {%- set dip = relay.ip if dirn == 'in' else shared.get('mx')[d] -%}
        {%- set u = namespace(v=t.v + gap(0.6, 0.9) | int) -%}
        {{- enq(u.v, 'Info', 'New SMTP DCID ' ~ dcid ~ ' interface ' ~ ifip ~ ' address ' ~ dip, {'log': {'message_status': 'New', 'delivery_connection_id': dcid | string, 'interface': ifip, 'address': dip}, 'proto': 'smtp', 'rel': [ifip, dip]}) -}}
        {%- set ridtxt = rids | join(', ') -%}
        {{- enq(u.v, 'Info', 'Delivery start DCID ' ~ dcid ~ ' MID ' ~ mid ~ ' to RID [' ~ ridtxt ~ ']', {'log': {'message_status': 'Delivery start', 'delivery_connection_id': dcid | string, 'recipient_id': ridtxt}, 'email': {'message_id': sid}}) -}}
        {%- set u.v = u.v + gap(1, 0.7) | int + (size / module.rand.number.lognormal(module.math.log(1500000 if dirn == 'in' else 700000), 0.7)) | int -%}
        {%- set ok = [] -%}
        {%- for i in rids -%}
          {%- if rcpts[i].bad -%}
            {{- enq(u.v, 'Info', 'Bounced: DCID ' ~ dcid ~ ' MID ' ~ mid ~ ' to RID ' ~ i ~ " - 5.1.0 - Unknown address error ('550', ['5.1.1 <" ~ rcpts[i].a ~ ">: Recipient address rejected: User unknown in virtual mailbox table']) []", {'email': {'message_id': sid}}) -}}
          {%- else -%}
            {%- do ok.append(i) -%}
          {%- endif -%}
        {%- endfor -%}
        {%- if ok -%}
          {%- set oktxt = ok | join(', ') -%}
          {{- enq(u.v, 'Info', 'Message done DCID ' ~ dcid ~ ' MID ' ~ mid ~ ' to RID [' ~ oktxt ~ ']', {'log': {'message_status': 'Message done', 'delivery_connection_id': dcid | string, 'recipient_id': oktxt}, 'email': {'message_id': sid}}) -}}
          {%- if dirn == 'in' -%}
            {%- set resp = "'2.6.0 <" ~ msgid ~ "> [InternalId=" ~ module.rand.number.integer(10000000000, 99999999999) ~ ', Hostname=' ~ relay.name | upper ~ "] Queued mail for delivery'" -%}
          {%- elif shared.get('style')[d] == 'postfix' -%}
            {%- set resp = "'2.0.0 Ok: queued as " ~ module.rand.string.hex(10) | upper ~ "'" -%}
          {%- else -%}
            {%- set resp = "'2.6.0 <" ~ msgid ~ "> [InternalId=" ~ module.rand.number.integer(10000000000, 99999999999) ~ ', Hostname=MX.' ~ d | upper ~ "] Queued mail for delivery'" -%}
          {%- endif -%}
          {{- enq(u.v, 'Info', 'MID ' ~ mid ~ ' RID [' ~ oktxt ~ '] Response ' ~ resp, {'log': {'recipient_id': oktxt, 'response': resp}, 'email': {'message_id': sid}}) -}}
        {%- endif -%}
        {%- set close_at = u.v + gap(5, 0.6) | int -%}
        {{- enq(close_at, 'Info', 'DCID ' ~ dcid ~ ' close', {'log': {'connection_status': 'close', 'delivery_connection_id': dcid | string}}) -}}
        {%- if u.v > last.v -%}{%- set last.v = u.v -%}{%- endif -%}
      {%- endfor -%}
      {%- set t.v = last.v -%}
    {%- endif -%}
    {{- enq(t.v, 'Info', 'Message finished MID ' ~ mid ~ ' done', {'log': {'message_status': 'finished'}, 'email': {'message_id': sid}}) -}}
  {%- endif -%}
{%- endmacro -%}

{#- Outbound message from one internal user. Final-step guard of the
    chain: a background message of `large_message_bytes` or more to the
    sender's own personal mailbox that would be the third such message
    within the chain window keeps its time and size, but goes to the
    user's other recipients (or one of the user's contacts) instead. -#}
{%- macro outbound(u, at, rcpts, kind, ep=false) -%}
  {%- set atts = [] -%}
  {%- set size = namespace(v=body_size() | int) -%}
  {%- if kind != 'none' -%}
    {%- set n = module.rand.weighted_choice([1, 2, 3], [70, 22, 8]) -%}
    {%- for i in range(n) -%}{%- do atts.append(module.rand.choice(params.attachment_names)) -%}{%- endfor -%}
    {%- set size.v = size.v + att_size(kind) | int -%}
  {%- endif -%}
  {{- lead_plan('out', size.v) -}}
  {%- set plan = shared.get('_plan') -%}
  {%- set ready_at = at + plan[0] + plan[1] -%}
  {%- set rc = namespace(v=rcpts, own=u.personal in rcpts | map(attribute='a') | list) -%}
  {%- if size.v >= big and rc.own and not ep -%}
    {%- set near = bigs.get(u.addr, []) | select('gt', ready_at - guard) | select('lt', ready_at + guard) | list -%}
    {%- set hit = namespace(v=false) -%}
    {%- for a in near -%}{%- set i = loop.index0 -%}
      {%- for b in near[i + 1:] -%}
        {%- if ([a, b, ready_at] | max) - ([a, b, ready_at] | min) <= guard -%}{%- set hit.v = true -%}{%- endif -%}
      {%- endfor -%}
    {%- endfor -%}
    {%- if hit.v -%}
      {%- set rest = rcpts | rejectattr('a', 'equalto', u.personal) | list -%}
      {%- set rc.v = rest if rest else [{'a': module.rand.choice(u.contacts), 'bad': false}] -%}
      {%- set rc.own = false -%}
    {%- endif -%}
  {%- endif -%}
  {%- if size.v >= big and rc.own -%}
    {%- do bigs.update({u.addr: (bigs.get(u.addr, []) + [ready_at])[-10:]}) -%}
  {%- endif -%}
  {%- set subj = module.rand.weighted_choice(['', 'RE: ', 'FW: '], [55, 30, 15]) ~ module.rand.choice(params.subjects) -%}
  {{- mail(at, 'out', u.relay.ip, u.relay.name, 'yes', 'RELAY SG RELAYLIST match ' ~ u.relay.ip ~ ' SBRS rfc1918',
      u.addr, rc.v, size.v, atts, 'clean', subj, plan) -}}
{%- endmacro -%}

{%- macro pick_rcpts(u) -%}
  {%- set n = module.rand.weighted_choice([1, 2, 3, 4], [78, 14, 6, 2]) -%}
  {%- set out = [] -%}
  {%- for i in range(n) -%}
    {%- set kind = module.rand.weighted_choice(['contact', 'personal', 'other', 'typo'], [76, 2, 20, 2]) -%}
    {%- if kind == 'contact' -%}{%- set a = module.rand.choice(u.contacts) -%}
    {%- elif kind == 'personal' -%}{%- set a = u.personal -%}
    {%- elif kind == 'other' -%}{%- set a = module.rand.choice(shared.get('contacts')) -%}
    {%- else -%}
      {%- set c = module.rand.choice(u.contacts) -%}
      {%- set a = c.split('@')[0][:-1] ~ module.rand.string.letters_lowercase(1) ~ c.split('@')[0][-1] ~ '@' ~ c.split('@')[1] -%}
    {%- endif -%}
    {%- if a not in out | map(attribute='a') | list -%}
      {%- do out.append({'a': a, 'bad': kind == 'typo'}) -%}
    {%- endif -%}
  {%- endfor -%}
  {%- do shared.set('_rcpts', out) -%}
{%- endmacro -%}

{#- Mail arrivals are drawn once per second. -#}
{%- if fresh -%}

{#- 1. Outbound background: one merged stream of independent users. -#}
{%- set u = module.rand.weighted_choice(users, shared.get('weights')) -%}
{%- if module.rand.chance(0.009 * activity(u) | float) -%}
  {{- pick_rcpts(u) -}}
  {%- set rcpts = shared.get('_rcpts') -%}
  {%- if module.rand.chance(0.18) -%}
    {#- A quick series to the same work recipients (split attachments,
        forwards); the own personal mailbox gets its series below. -#}
    {%- set rcpts = rcpts | rejectattr('a', 'equalto', u.personal) | list or [{'a': module.rand.choice(u.contacts), 'bad': false}] -%}
    {%- set kind = module.rand.weighted_choice(['doc', 'files', 'none'], [35, 55, 10]) -%}
    {%- set t = namespace(v=now) -%}
    {%- for i in range(module.rand.weighted_choice([2, 3, 4, 5], [50, 30, 14, 6])) -%}
      {{- outbound(u, t.v, rcpts, kind if module.rand.chance(0.85) else 'none') -}}
      {%- set t.v = t.v + gap(160, 0.8) | int + 5 -%}
    {%- endfor -%}
  {%- else -%}
    {{- outbound(u, now, rcpts, module.rand.weighted_choice(['none', 'doc', 'files'], [62, 32, 6])) -}}
  {%- endif -%}
{%- endif -%}

{#- 1b. Every user now and then sends mail to the own personal mailbox
    (files for home, travel documents), single or in a quick series,
    small or large. Users are drawn uniformly, then thinned by their own
    working hours. In a series each message draws its own content, so
    two large messages in one series are common and three are rare; the
    final-step guard in outbound() is only a backstop. -#}
{%- set pu = module.rand.choice(users) -%}
{%- if module.rand.chance(0.0019 * activity(pu) | float) -%}
  {%- set rcpts = [{'a': pu.personal, 'bad': false}] -%}
  {%- if module.rand.chance(0.1) -%}{%- do rcpts.append({'a': module.rand.choice(pu.contacts), 'bad': false}) -%}{%- endif -%}
  {%- set n = module.rand.weighted_choice([1, 2, 3, 4], [65, 20, 11, 4]) -%}
  {%- set t = namespace(v=now) -%}
  {%- for i in range(n) -%}
    {%- set kind = module.rand.weighted_choice(['none', 'doc', 'files'], [38, 32, 30] if n == 1 else [40, 25, 35]) -%}
    {{- outbound(pu, t.v, rcpts, kind) -}}
    {%- set t.v = t.v + gap(160, 0.8) | int + 5 -%}
  {%- endfor -%}
{%- endif -%}

{#- 2. Inbound background: internet mail to internal users. -#}
{%- set infac = 1.0 if 6 <= hod < 17 else 0.45 -%}
{%- if module.rand.chance(0.011 * infac) -%}
  {%- set r = module.rand.weighted_choice(users, shared.get('weights')) -%}
  {%- set kind = module.rand.weighted_choice(['partner', 'freemail', 'personal', 'newsletter', 'reject', 'spam', 'virus'], [44, 11, 3, 17, 16, 8, 1]) -%}
  {%- set rc = [{'a': r.addr, 'bad': false}] -%}
  {%- if kind in ['partner', 'freemail'] and module.rand.chance(0.18) -%}
    {%- set r2 = module.rand.choice(users) -%}
    {%- if r2.addr != r.addr -%}{%- do rc.append({'a': r2.addr, 'bad': false}) -%}{%- endif -%}
  {%- endif -%}
  {%- set subj = module.rand.weighted_choice(['', 'RE: '], [60, 40]) ~ module.rand.choice(params.subjects) -%}
  {%- set atts = [] -%}
  {%- set size = namespace(v=body_size() | int) -%}
  {%- if kind in ['partner', 'freemail', 'personal'] and module.rand.chance(0.3) -%}
    {%- do atts.append(module.rand.choice(params.attachment_names)) -%}
    {%- set size.v = size.v + att_size('doc') | int -%}
  {%- endif -%}
  {%- if kind == 'partner' -%}
    {%- set s = module.rand.choice(r.contacts if module.rand.chance(0.7) else shared.get('contacts')) -%}
    {%- set p = params.partner_domains | selectattr('domain', 'equalto', s.split('@')[1]) | first -%}
    {%- set sb = sbrs_of(p.sbrs) -%}
    {{- mail(now, 'in', p.ip, 'mx.' ~ p.domain, 'yes', 'ACCEPT SG UNKNOWNLIST match sbrs[-1.0:10.0] SBRS ' ~ sb, s, rc, size.v, atts, 'clean', subj) -}}
  {%- elif kind in ['freemail', 'personal'] -%}
    {%- if kind == 'personal' -%}
      {%- set s = r.personal -%}
    {%- else -%}
      {%- set s = module.rand.choice(params.contact_names) ~ module.rand.number.integer(1, 999) ~ '@' ~ module.rand.choice(params.freemail_domains).domain -%}
    {%- endif -%}
    {%- set f = params.freemail_domains | selectattr('domain', 'equalto', s.split('@')[1]) | first -%}
    {{- mail(now, 'in', f.ip, 'out.' ~ f.domain, 'yes', 'ACCEPT SG UNKNOWNLIST match sbrs[-1.0:10.0] SBRS ' ~ sbrs_of(f.sbrs), s, rc, size.v, atts, 'clean', subj) -}}
  {%- elif kind == 'newsletter' -%}
    {%- set nl = module.rand.choice(params.newsletter_senders) -%}
    {%- set size.v = (module.rand.number.lognormal(module.math.log(60000), 0.6)) | int -%}
    {{- mail(now, 'in', nl.ip, 'mta.' ~ nl.address.split('@')[1], 'yes', 'ACCEPT SG UNKNOWNLIST match sbrs[-1.0:10.0] SBRS ' ~ sbrs_of(nl.sbrs), nl.address, rc, size.v, [], 'bulk', module.rand.choice(['Weekly digest', 'Upcoming events', 'Your account summary', 'Special offer'])) -}}
  {%- else -%}
    {%- set cip = module.rand.choice(['192.0.2.', '198.18.', '198.19.']) -%}
    {%- set cip = cip ~ module.rand.number.integer(1, 254) if cip == '192.0.2.' else cip ~ module.rand.number.integer(0, 255) ~ '.' ~ module.rand.number.integer(1, 254) -%}
    {%- if kind == 'reject' -%}
      {%- do shared.set('_tok', {}) -%}{%- set icid = '{I}' -%}
      {%- set sb = '%.1f' | format(module.rand.number.floating(-9.8, -3.1)) -%}
      {{- enq(now, 'Info', 'New SMTP ICID ' ~ icid ~ ' interface Management (' ~ ifip ~ ') address ' ~ cip ~ ' reverse dns host unknown verified no', {'log': {'connection_status': 'New', 'injection_connection_id': icid | string, 'interface': ifip, 'address': cip, 'verified': 'no'}, 'proto': 'smtp', 'dns': 'unknown', 'rel': [ifip, cip]}) -}}
      {{- enq(now, 'Info', 'ICID ' ~ icid ~ ' REJECT SG BLOCKED_LIST match sbrs[-10.0:-3.0] SBRS ' ~ sb, {}) -}}
      {{- enq(now + gap(1, 0.8) | int, 'Info', 'ICID ' ~ icid ~ ' close', {'log': {'connection_status': 'close', 'injection_connection_id': icid | string}}) -}}
    {%- else -%}
      {%- set sb = '%.1f' | format(module.rand.number.floating(-2.9, 0.9)) -%}
      {%- set sg = 'SUSPECTLIST match sbrs[-3.0:-1.0]' if sb | float < -1.0 else 'UNKNOWNLIST match sbrs[-1.0:10.0]' -%}
      {%- set s = module.rand.string.letters_lowercase(module.rand.number.integer(5, 9)) ~ '@' ~ module.rand.string.letters_lowercase(module.rand.number.integer(5, 8)) ~ '.test' -%}
      {%- set v = 'virus' if kind == 'virus' else module.rand.weighted_choice(['positive', 'suspect'], [70, 30]) -%}
      {%- if v == 'virus' -%}{%- set atts = [module.rand.choice(['invoice.zip', 'scan.htm', 'order.docm'])] -%}{%- endif -%}
      {{- mail(now, 'in', cip, 'unknown', 'no', 'ACCEPT SG ' ~ sg ~ ' SBRS ' ~ sb, s, rc, (module.rand.number.lognormal(module.math.log(9000), 0.8)) | int + 600, atts, v, module.rand.choice(['Payment notice', 'Your parcel is waiting', 'Account verification', 'Invoice overdue'])) -}}
    {%- endif -%}
  {%- endif -%}
{%- endif -%}

{#- 3. Episode: due by source time, random start delay, then it begins
    on an opportunity drawn like personal mail (uniform user, thinned by
    working hours); next due counts from the actual start, no catch-up.
    One rotated user sends three to five large messages to the own
    personal mailbox, the first three inside the chain window. -#}
{%- if params.anomaly_mode -%}
  {%- if shared.get('start_at') is none and now >= shared.get('next_due') -%}
    {%- do shared.set('start_at', now + (module.rand.number.exponential(1 / 600)) | int) -%}
  {%- endif -%}
  {%- if shared.get('start_at') is not none and now >= shared.get('start_at') -%}
    {%- set eu = module.rand.choice(users) -%}
    {%- if eu.addr != shared.get('last_user') and module.rand.chance(activity(eu) | float / 900) -%}
      {%- set n = module.rand.weighted_choice([3, 4, 5], [55, 30, 15]) -%}
      {#- Gaps follow the background series law; the first three messages
          must fit the chain window, so only a draw exceeding it is
          redrawn. -#}
      {%- set g = namespace(v=[]) -%}
      {%- for j in range(50) -%}
        {%- if not g.v -%}
          {%- set d = [] -%}
          {%- for i in range(n - 1) -%}{%- do d.append(gap(160, 0.8) | int + 5) -%}{%- endfor -%}
          {%- if d[0] + d[1] <= window - 120 -%}{%- set g.v = d -%}{%- endif -%}
        {%- endif -%}
      {%- endfor -%}
      {%- set t = namespace(v=now) -%}
      {%- set rc = [{'a': eu.personal, 'bad': false}] -%}
      {%- for i in range(n) -%}
        {{- outbound(eu, t.v, rc, 'chain', true) -}}
        {%- if i < n - 1 -%}{%- set t.v = t.v + (g.v[i] if g.v else 160) -%}{%- endif -%}
      {%- endfor -%}
      {%- do shared.update({'start_at': none, 'last_user': eu.addr,
          'next_due': now + (interval * 3600) | int}) -%}
    {%- endif -%}
  {%- endif -%}
{%- endif -%}

{%- endif -%}

{#- 4. Emit the earliest due line, otherwise nothing. -#}
{%- if not q or q[0][0] > now -%}{{ dispatch.drop() }}{%- endif -%}
{%- set e = q.pop(0)[2] -%}
{%- set f = e.f -%}
{#- Connection and message IDs are taken when their first line is
    written, so every counter rises with log time. -#}
{%- set tok = e.tok -%}
{%- for ph in module.re.findall('[{]([IMR]|D[0-9]+)[}]', e.text) -%}
  {%- if tok.get(ph) is none -%}
    {%- do tok.update({ph: nextid({'I': 'icid', 'M': 'mid', 'R': 'rcid'}.get(ph, 'dcid'))}) -%}
  {%- endif -%}
{%- endfor -%}
{%- macro rs(s, tok) -%}
  {%- set n = namespace(v=s) -%}
  {%- for k, v in tok.items() -%}{%- set n.v = n.v.replace('{' ~ k ~ '}', v) -%}{%- endfor -%}
  {{- n.v -}}
{%- endmacro -%}
{%- set text = rs(e.text, tok) -%}
{%- set stamp = timestamp.strftime('%b ') ~ '%2d' | format(timestamp.day) ~ timestamp.strftime(' %H:%M:%S') -%}
{%- set raw = '<166>' ~ stamp ~ ' ' ~ params.host_name ~ ' mail_logs: ' ~ e.lvl ~ ': ' ~ text -%}
{%- set log = {'category': {'name': 'mail_logs'}, 'host': params.host_name, 'message': text} -%}
{%- for k, v in f.get('log', {}).items() -%}
  {%- do log.update({k: rs(v, tok) if v is string else v}) -%}
{%- endfor -%}
{%- set record = {'@timestamp': timestamp.strftime('%Y-%m-%dT%H:%M:%S') ~ '.000Z',
  'cisco_secure_email_gateway': {'log': log},
  'ecs': {'version': '8.17.0'},
  'event': {'dataset': 'cisco_secure_email_gateway.log', 'kind': 'event', 'original': raw, 'timezone': 'UTC'},
  'log': {'level': e.lvl | lower, 'syslog': {'priority': 166}},
  'tags': ['preserve_original_event']} -%}
{%- if f.get('email') -%}
  {%- set em = dict(f.email) -%}
  {%- if em.get('message_id') -%}{%- do em.update({'message_id': rs(em.message_id, tok)}) -%}{%- endif -%}
  {%- do record.update({'email': em}) -%}
{%- endif -%}
{%- if f.get('proto') -%}{%- do record.update({'network': {'protocol': f.proto}}) -%}{%- endif -%}
{%- if f.get('dns') -%}{%- do record.update({'dns': {'question': {'name': f.dns}}}) -%}{%- endif -%}
{%- if f.get('rel') -%}{%- do record.update({'related': {'ip': f.rel}}) -%}{%- endif -%}
{{ record | tojson }}
