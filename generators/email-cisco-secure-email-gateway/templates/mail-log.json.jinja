{%- for flag in ['to_start', 'to_sender', 'to_recipient_0', 'to_recipient_1', 'to_ready', 'to_antivirus', 'to_queued', 'to_outbound', 'to_delivery_start', 'to_icid_close', 'to_delivery_done', 'to_dcid_close', 'to_open'] -%}{%- do shared.pop(flag, none) -%}{%- endfor -%}
{%- set stage = vars.stage -%}
{%- if stage == 'open' -%}
  {%- set cycle = shared.get('cycle_count', 0) + 1 -%}
  {%- set anomalous = params.anomaly_mode and cycle >= 20 -%}
  {%- do shared.set('cycle_count', 0 if cycle >= 20 else cycle) -%}
  {%- set mid = shared.get('next_mid', 200257070) + 1 -%}
  {%- set icid = shared.get('next_icid', 282204970) + 1 -%}
  {%- set dcid = shared.get('next_dcid', 2386069) + 1 -%}
  {%- do shared.set('next_mid', 200257070 if mid >= 999999999 else mid) -%}
  {%- do shared.set('next_icid', 282204970 if icid >= 999999999 else icid) -%}
  {%- do shared.set('next_dcid', 2386069 if dcid >= 999999999 else dcid) -%}
  {%- do shared.set('mid', mid) -%}{%- do shared.set('icid', icid) -%}{%- do shared.set('dcid', dcid) -%}
  {%- do shared.set('anomalous', anomalous) -%}
  {%- do shared.set('sender', params.suspect_sender if anomalous else module.rand.choice(['alice@example.test', 'orders@example.test', 'bob@example.test'])) -%}
  {%- do shared.set('recipient_0', 'archive@' ~ params.external_domain if anomalous else module.rand.choice(['user@partner.example.test', 'team@example.test'])) -%}
  {%- do shared.set('recipient_1', 'audit@' ~ params.external_domain if anomalous else '') -%}
  {%- do shared.set('client_ip', params.suspect_ip if anomalous else module.rand.choice(['10.20.40.11', '10.20.40.12', '10.20.40.13'])) -%}
  {%- do shared.set('message_size', module.rand.number.integer(12000000, 18000000) if anomalous else module.rand.number.integer(1200, 45000)) -%}
  {%- do shared.set('to_start', true) -%}
{%- elif stage == 'start' -%}{%- do shared.set('to_sender', true) -%}
{%- elif stage == 'sender' -%}{%- do shared.set('to_recipient_0', true) -%}
{%- elif stage == 'recipient_0' -%}{%- do shared.set('to_recipient_1' if shared.get('anomalous') else 'to_ready', true) -%}
{%- elif stage == 'recipient_1' -%}{%- do shared.set('to_ready', true) -%}
{%- elif stage == 'ready' -%}{%- do shared.set('to_antivirus', true) -%}
{%- elif stage == 'antivirus' -%}{%- do shared.set('to_queued', true) -%}
{%- elif stage == 'queued' -%}{%- do shared.set('to_outbound', true) -%}
{%- elif stage == 'outbound' -%}{%- do shared.set('to_delivery_start', true) -%}
{%- elif stage == 'delivery_start' -%}{%- do shared.set('to_icid_close', true) -%}
{%- elif stage == 'icid_close' -%}{%- do shared.set('to_delivery_done', true) -%}
{%- elif stage == 'delivery_done' -%}{%- do shared.set('to_dcid_close', true) -%}
{%- else -%}{%- do shared.set('to_open', true) -%}{%- endif -%}
{%- set mid = shared.get('mid') -%}{%- set icid = shared.get('icid') -%}{%- set dcid = shared.get('dcid') -%}
{%- set sender = shared.get('sender') -%}{%- set recipient_0 = shared.get('recipient_0') -%}{%- set recipient_1 = shared.get('recipient_1') -%}
{%- set client_ip = shared.get('client_ip') -%}{%- set message_size = shared.get('message_size') -%}
{%- set recipients = [recipient_0, recipient_1] if shared.get('anomalous') else [recipient_0] -%}
{%- set rid = '[0, 1]' if shared.get('anomalous') else '[0]' -%}
{%- if stage == 'open' -%}{%- set detail = 'New SMTP ICID ' ~ icid ~ ' interface ' ~ params.interface_name ~ ' (' ~ params.interface_ip ~ ') address ' ~ client_ip ~ ' reverse dns host unknown verified no' -%}
{%- elif stage == 'start' -%}{%- set detail = 'Start MID ' ~ mid ~ ' ICID ' ~ icid -%}
{%- elif stage == 'sender' -%}{%- set detail = 'MID ' ~ mid ~ ' ICID ' ~ icid ~ ' From: <' ~ sender ~ '>' -%}
{%- elif stage == 'recipient_0' -%}{%- set detail = 'MID ' ~ mid ~ ' ICID ' ~ icid ~ ' RID 0 To: <' ~ recipient_0 ~ '>' -%}
{%- elif stage == 'recipient_1' -%}{%- set detail = 'MID ' ~ mid ~ ' ICID ' ~ icid ~ ' RID 1 To: <' ~ recipient_1 ~ '>' -%}
{%- elif stage == 'ready' -%}{%- set detail = 'MID ' ~ mid ~ ' ready ' ~ message_size ~ ' bytes from <' ~ sender ~ '>' -%}
{%- elif stage == 'antivirus' -%}{%- set detail = 'MID ' ~ mid ~ ' antivirus negative' -%}
{%- elif stage == 'queued' -%}{%- set detail = 'MID ' ~ mid ~ ' queued for delivery' -%}
{%- elif stage == 'outbound' -%}{%- set detail = 'New SMTP DCID ' ~ dcid ~ ' interface ' ~ params.interface_ip ~ ' address 203.0.113.45' -%}
{%- elif stage == 'delivery_start' -%}{%- set detail = 'Delivery start DCID ' ~ dcid ~ ' MID ' ~ mid ~ ' to RID ' ~ rid -%}
{%- elif stage == 'icid_close' -%}{%- set detail = 'ICID ' ~ icid ~ ' close' -%}
{%- elif stage == 'delivery_done' -%}{%- set detail = 'Message done DCID ' ~ dcid ~ ' MID ' ~ mid ~ ' to RID ' ~ rid -%}
{%- else -%}{%- set detail = 'DCID ' ~ dcid ~ ' close' -%}{%- endif -%}
{%- set stamp = timestamp.strftime('%a %b ') ~ timestamp.day ~ timestamp.strftime(' %H:%M:%S %Y') -%}
{%- set original = stamp ~ ' Info: ' ~ detail -%}
{%- set event_type = ['start'] if stage in ['open', 'outbound'] else ['end'] if stage in ['icid_close', 'dcid_close'] else ['info'] -%}
{%- set payload = {'@timestamp': timestamp.isoformat(), 'ecs': {'version': '8.17.0'}, 'event': {'kind': 'event', 'category': ['email'], 'type': event_type, 'action': stage.replace('_', '-'), 'original': original}, 'host': {'name': params.host_name, 'ip': [params.interface_ip]}, 'log': {'file': {'path': 'mail_logs'}, 'level': 'info'}, 'cisco': {'esa': {'message': detail}}} -%}
{%- if stage in ['open', 'start', 'sender', 'recipient_0', 'recipient_1', 'icid_close'] -%}{%- do payload.cisco.esa.update({'icid': icid}) -%}{%- endif -%}
{%- if stage in ['start', 'sender', 'recipient_0', 'recipient_1', 'ready', 'antivirus', 'queued', 'delivery_start', 'delivery_done'] -%}{%- do payload.cisco.esa.update({'mid': mid}) -%}{%- endif -%}
{%- if stage in ['outbound', 'delivery_start', 'delivery_done', 'dcid_close'] -%}{%- do payload.cisco.esa.update({'dcid': dcid}) -%}{%- endif -%}
{%- if stage == 'open' -%}{%- do payload.update({'source': {'ip': client_ip}, 'related': {'ip': [client_ip, params.interface_ip]}}) -%}{%- endif -%}
{%- if stage == 'outbound' -%}{%- do payload.update({'destination': {'ip': '203.0.113.45'}, 'related': {'ip': ['203.0.113.45', params.interface_ip]}}) -%}{%- endif -%}
{%- if stage in ['sender', 'ready'] -%}{%- do payload.update({'email': {'from': {'address': [sender]}}, 'related': {'user': [sender]}}) -%}{%- endif -%}
{%- if stage in ['recipient_0', 'recipient_1'] -%}
  {%- set recipient = recipient_0 if stage == 'recipient_0' else recipient_1 -%}
  {%- do payload.update({'email': {'to': {'address': [recipient]}}}) -%}
  {%- do payload.cisco.esa.update({'rid': 0 if stage == 'recipient_0' else 1}) -%}
{%- endif -%}
{%- if stage == 'ready' -%}{%- do payload.cisco.esa.update({'message_size': message_size}) -%}{%- endif -%}
{%- if stage in ['delivery_start', 'delivery_done'] -%}{%- do payload.cisco.esa.update({'rids': [0, 1] if shared.get('anomalous') else [0]}) -%}{%- endif -%}
{%- if stage == 'dcid_close' -%}
  {%- for key in ['mid', 'icid', 'dcid', 'anomalous', 'sender', 'recipient_0', 'recipient_1', 'client_ip', 'message_size'] -%}{%- do shared.pop(key, none) -%}{%- endfor -%}
{%- endif -%}
{{- payload | tojson -}}
