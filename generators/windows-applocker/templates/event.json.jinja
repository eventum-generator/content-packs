{#- Microsoft-Windows-AppLocker records (EXE and DLL: 8002-8004; MSI and
    Script: 8005-8007) as Winlogbeat-style ECS JSON with the raw event
    XML. One input tick per second; each tick emits the earliest due
    record, stamped with its own microsecond time, or drops. Users log on
    and off their workstations (admins visit random hosts); inside a
    session independent operations start applications, run scripts and
    installers, and try files from user-writable folders that the
    policy blocks. Times are in microseconds. -#}
{%- set ts = timestamp.astimezone(module.datetime.timezone.utc) -%}
{%- set now = module.builtins.int(ts.timestamp() * 1000000) -%}
{%- if shared.get('queue') is not none and now < shared.get('next_due') and not (params.anomaly_mode and now >= shared.get('ep_due')) -%}{{- dispatch.drop() -}}{%- endif -%}
{%- set hq = module.heapq -%}
{%- set sec = 1000000 -%}
{%- set hour = 3600 * sec -%}
{#- Chain window: a background launch of a proxy binary (rundll32,
    regsvr32, mshta, certutil, MSBuild) is dropped when its session has a
    blocked executable followed by a blocked script within this window. -#}
{%- set window = 1900 * sec -%}
{%- set rules = {
  'EXE:win': ['{A61C8B2C-A319-4CD0-9690-D2177CAD7B51}', '(Default Rule) All files located in the Windows folder', 'D:(XA;;FX;;;S-1-1-0;(APPID://PATH Contains "%WINDIR%\\*"))'],
  'EXE:pf': ['{921CC481-6E17-4653-8F75-050B80ACCA20}', '(Default Rule) All files located in the Program Files folder', 'D:(XA;;FX;;;S-1-1-0;(APPID://PATH Contains "%PROGRAMFILES%\\*"))'],
  'EXE:corp': ['{2B96EA72-3F7C-4B1C-A17D-79230F9D3B52}', 'Contoso line-of-business applications (CorpApps)', 'D:(XA;;FX;;;S-1-1-0;(APPID://PATH Contains "%OSDRIVE%\\CORPAPPS\\*"))'],
  'EXE:adm': ['{FD686D83-A829-4351-8FF4-27C7DE5755D2}', '(Default Rule) All files', 'D:(XA;;FX;;;S-1-5-32-544;(APPID://PATH Contains "*"))'],
  'SCRIPT:win': ['{73995B86-3A74-457F-864C-6F851516F1F8}', '(Default Rule) All scripts located in the Windows folder', 'D:(XA;;FX;;;S-1-1-0;(APPID://PATH Contains "%WINDIR%\\*"))'],
  'SCRIPT:pf': ['{E67A01CA-2F1B-4D6B-85CD-8850943ED704}', '(Default Rule) All scripts located in the Program Files folder', 'D:(XA;;FX;;;S-1-1-0;(APPID://PATH Contains "%PROGRAMFILES%\\*"))'],
  'SCRIPT:adm': ['{641D7CA0-C5A1-45C2-A8C2-E2322EFD44F3}', '(Default Rule) All scripts', 'D:(XA;;FX;;;S-1-5-32-544;(APPID://PATH Contains "*"))'],
  'MSI:win': ['{3185BE65-0620-4F74-95D7-C7EFA445AEE9}', '(Default Rule) All Windows Installer files in %systemdrive%\\Windows\\Installer', 'D:(XA;;FX;;;S-1-1-0;(APPID://PATH Contains "%WINDIR%\\INSTALLER\\*"))'],
  'MSI:ccm': ['{90DD4BE0-236C-41B8-83A8-87C9816D1C2F}', 'Configuration Manager client cache', 'D:(XA;;FX;;;S-1-1-0;(APPID://PATH Contains "%WINDIR%\\CCMCACHE\\*"))'],
  'MSI:adm': ['{FD8C1788-B026-4E32-828F-FAE29BBC8EBB}', '(Default Rule) All Windows Installer files', 'D:(XA;;FX;;;S-1-5-32-544;(APPID://PATH Contains "*.*"))']
} -%}
{%- macro ln(med, sig) -%}
  {#- Lognormal seconds with median med; returns microseconds. -#}
  {{- module.builtins.int(module.rand.number.lognormal(module.math.log(med), sig) * 1000000) -}}
{%- endmacro -%}
{%- macro push(due, item) -%}
  {%- set s = shared.get('seq') + 1 -%}
  {%- do shared.set('seq', s) -%}
  {%- do module.heapq.heappush(shared.get('queue'), [due, s, item]) -%}
{%- endmacro -%}
{%- macro newpid() -%}{{- 4 * module.rand.number.integer(250, 11000) -}}{%- endmacro -%}
{%- macro fill(path, user) -%}
  {#- Expand the user and random-folder placeholders of a sample path. -#}
  {{- path.replace('{U}', user).replace('{R}', module.rand.string.hex(8) | upper if module.rand.chance(0.5) else module.rand.crypto.uuid4() | upper) -}}
{%- endmacro -%}
{%- macro row(sid, due, ch, code, full, fqbn, hash, pol, rule, pid, ppid, extra) -%}
  {#- Queue one record. ch: 'exe' or 'msi' (channel). -#}
  {%- set sess = shared.get('sessions')[sid] -%}
  {%- set item = {'k': 'row', 's': sid, 'uu': sess.u, 'hh': sess.h, 'll': sess.logon, 'ch': ch, 'code': code, 'full': full, 'fqbn': fqbn, 'hash': hash, 'pol': pol, 'rule': rule, 'pid': pid, 'ppid': ppid} -%}
  {%- do item.update(extra) -%}
  {{- push(due, item) -}}
{%- endmacro -%}
{%- macro retries(t0, p_more) -%}
  {#- Times of one attempt and its repeats (a user retrying a blocked
      file), comma separated. -#}
  {%- set t = namespace(v=t0, out=[t0 | string], go=true) -%}
  {%- for _ in range(4) if t.go -%}
    {%- if module.rand.chance(p_more) -%}
      {%- set t.v = t.v + (ln(14, 1.0) | int) -%}
      {%- do t.out.append(t.v | string) -%}
    {%- else -%}{%- set t.go = false -%}{%- endif -%}
  {%- endfor -%}
  {{- t.out | join(',') -}}
{%- endmacro -%}
{%- macro run_app(sid, due, ai, extra) -%}
  {#- Allowed executable launch (8002). -#}
  {%- set a = shared.get('apps')[ai] -%}
  {%- set sess = shared.get('sessions')[sid] -%}
  {%- set low = a.full | lower -%}
  {%- set rk = 'EXE:win' if low.startswith('c:\\windows\\') else ('EXE:pf' if low.startswith('c:\\program files\\') else 'EXE:corp') -%}
  {%- set pid = newpid() | int -%}
  {%- set parent = (sess.explorer or newpid() | int) if module.rand.chance(0.75) or not sess.recent else module.rand.choice(sess.recent) -%}
  {%- set x = {'lol': a.lol} -%}
  {%- do x.update(extra) -%}
  {{- row(sid, due, 'exe', 8002, a.full, a.fqbn, a.hash, 'EXE', rk, pid, parent, x) -}}
  {%- do sess.recent.append(pid) -%}
  {%- if sess.recent | length > 12 -%}{%- do sess.recent.pop(0) -%}{%- endif -%}
  {{- pid -}}
{%- endmacro -%}
{%- macro try_user_file(sid, due, extra) -%}
  {#- A file from a user-writable folder: blocked for standard users
      (8004, with repeats), allowed by the admin rule for admins.
      Returns the time of the last attempt. -#}
  {%- set sess = shared.get('sessions')[sid] -%}
  {%- set u = shared.get('users')[sess.u] -%}
  {%- set f = shared.get('user_files')[module.rand.weighted_choice(shared.get('uf_idx'), shared.get('uf_w'))] -%}
  {%- set full = fill('C:\\Users\\{U}\\' ~ f.rel, u.name) -%}
  {%- set times = (retries(due, 0.0 if u.admin else 0.45) | string).split(',') -%}
  {%- for t in times -%}
    {%- if u.admin -%}
      {{- row(sid, t | int, 'exe', 8002, full, f.fqbn, f.hash, 'EXE', 'EXE:adm', newpid() | int, sess.explorer, extra) -}}
    {%- else -%}
      {{- row(sid, t | int, 'exe', 8004, full, f.fqbn, f.hash, 'EXE', none, newpid() | int, sess.explorer, extra) -}}
    {%- endif -%}
  {%- endfor -%}
  {{- times[-1] -}}
{%- endmacro -%}
{%- macro script_burst(sid, due, user_script, extra) -%}
  {#- Script host or msiexec start (8002), then scripts or packages it
      loads (8005). With user_script, one file from a user-writable
      folder is tried as well: blocked (8007, with repeats) on enforced
      hosts, audited (8006) on the pilot hosts, allowed for admins.
      Returns the time of the last record. -#}
  {%- set sess = shared.get('sessions')[sid] -%}
  {%- set u = shared.get('users')[sess.u] -%}
  {%- set host = shared.get('hosts')[sess.h] -%}
  {%- set hi = module.rand.choice(shared.get('shost_idx')) -%}
  {%- set pol = shared.get('apps')[hi].shost -%}
  {%- set pid = run_app(sid, due, hi, extra) | int -%}
  {%- set t = namespace(v=due) -%}
  {%- set n = namespace(v=0, go=true) -%}
  {%- for _ in range(6) if n.go -%}
    {%- if module.rand.chance(0.7 if pol == 'SCRIPT' else 0.4) -%}{%- set n.v = n.v + 1 -%}{%- else -%}{%- set n.go = false -%}{%- endif -%}
  {%- endfor -%}
  {%- set pool = shared.get('scripts') | selectattr('pol', 'equalto', pol) | list -%}
  {%- for _ in range(n.v) -%}
    {%- set t.v = t.v + (ln(0.6, 1.2) | int) -%}
    {%- set s = module.rand.choice(pool) -%}
    {%- set low = s.full | lower -%}
    {%- set rk = pol ~ (':win' if low.startswith('c:\\windows\\installer\\') or (pol == 'SCRIPT' and low.startswith('c:\\windows\\')) else (':ccm' if pol == 'MSI' else ':pf')) -%}
    {{- row(sid, t.v, 'msi', 8005, fill(s.full, u.name), s.fqbn, s.hash, pol, rk, pid, pid, extra) -}}
  {%- endfor -%}
  {%- if user_script -%}
    {%- set cand = shared.get('user_scripts') | selectattr('pol', 'equalto', pol) | list -%}
    {%- set s = module.rand.choice(cand) -%}
    {%- set full = fill('C:\\Users\\{U}\\' ~ s.rel, u.name) -%}
    {%- set times = (retries(t.v + (ln(4, 1.0) | int), 0.0 if u.admin else 0.35) | string).split(',') -%}
    {%- for tt in times -%}
      {%- set code = 8005 if u.admin else (8006 if host.script_audit else 8007) -%}
      {{- row(sid, tt | int, 'msi', code, full, s.fqbn, s.hash, pol, pol ~ ':adm' if u.admin else none, pid, pid, extra) -}}
    {%- endfor -%}
    {%- set t.v = times[-1] | int -%}
  {%- endif -%}
  {{- t.v -}}
{%- endmacro -%}
{%- macro pick_app(u, lol_only) -%}
  {%- set idx = shared.get('lol_idx') if lol_only else (shared.get('app_idx_dev') if u.dev else shared.get('app_idx')) -%}
  {%- set w = shared.get('lol_w') if lol_only else (shared.get('app_w_dev') if u.dev else shared.get('app_w')) -%}
  {{- module.rand.weighted_choice(idx, w) -}}
{%- endmacro -%}
{%- if shared.get('queue') is none -%}
  {%- set schema = {'type': 'typed-dict', 'fields': {
    'anomaly_mode': {'type': 'typed-dict-field', 'schema': {'type': 'bool', 'strict': true}},
    'anomaly_interval_hours': {'type': 'typed-dict-field', 'schema': {'type': 'float', 'ge': 6, 'le': 8760}}
  }} -%}
  {%- do module.pydantic_core.SchemaValidator(schema).validate_python(params) -%}
  {%- do shared.update({'queue': [], 'seq': 0, 'sessions': {}, 'sess_seq': 0}) -%}
  {%- set apps = [] -%}
  {%- for r in samples.apps -%}{%- do apps.append({'full': r.full, 'fqbn': r.fqbn, 'hash': r.hash, 'w': r.w, 'lol': r.lol, 'shost': r.shost, 'dev': r.dev}) -%}{%- endfor -%}
  {%- set lists = {'app_idx': [], 'app_w': [], 'app_idx_dev': [], 'app_w_dev': [], 'lol_idx': [], 'lol_w': [], 'shost_idx': [], 'uf_idx': [], 'uf_w': []} -%}
  {%- for a in apps -%}
    {%- if not a.dev -%}{%- do lists.app_idx.append(loop.index0) -%}{%- do lists.app_w.append(a.w) -%}{%- endif -%}
    {%- do lists.app_idx_dev.append(loop.index0) -%}{%- do lists.app_w_dev.append(a.w) -%}
    {%- if a.lol -%}{%- do lists.lol_idx.append(loop.index0) -%}{%- do lists.lol_w.append(a.w) -%}{%- endif -%}
    {%- if a.shost -%}{%- do lists.shost_idx.append(loop.index0) -%}{%- endif -%}
  {%- endfor -%}
  {%- set ufs = [] -%}
  {%- for r in samples.user_files -%}{%- do ufs.append({'rel': r.rel, 'fqbn': r.fqbn, 'hash': r.hash}) -%}{%- do lists.uf_idx.append(loop.index0) -%}{%- do lists.uf_w.append(r.w) -%}{%- endfor -%}
  {%- set scs = [] -%}
  {%- for r in samples.scripts -%}{%- do scs.append({'full': r.full, 'pol': r.pol, 'fqbn': r.fqbn, 'hash': r.hash}) -%}{%- endfor -%}
  {%- set uscs = [] -%}
  {%- for r in samples.user_scripts -%}{%- do uscs.append({'rel': r.rel, 'pol': r.pol, 'fqbn': r.fqbn, 'hash': r.hash}) -%}{%- endfor -%}
  {%- set hosts = [] -%}
  {%- for r in samples.hosts -%}
    {%- do hosts.append({'name': r.name, 'script_audit': r.script_audit, 'rec': {'exe': module.rand.number.integer(20000, 2000000), 'msi': module.rand.number.integer(500, 90000)}}) -%}
  {%- endfor -%}
  {%- set users = [] -%}
  {%- for r in samples.users -%}
    {%- set ui = loop.index0 -%}
    {%- do users.append({'name': r.name, 'sid': r.sid, 'host': r.host, 'dev': r.dev, 'admin': r.admin, 'pace': module.rand.number.lognormal(0, 0.35)}) -%}
    {#- First logon somewhere inside one typical off-duty gap. -#}
    {{- push(now + module.builtins.int(module.rand.number.floating(0, 1) * (ln(5 * 3600 if r.admin else 10 * 3600, 0.8) | int)), {'k': 'logon', 'u': ui}) -}}
  {%- endfor -%}
  {%- set interval = module.builtins.int(params.anomaly_interval_hours * hour) -%}
  {%- do shared.update(lists) -%}
  {%- do shared.update({'apps': apps, 'user_files': ufs, 'scripts': scs, 'user_scripts': uscs, 'hosts': hosts, 'users': users, 'last_us': now - 1, 'ep_last_user': none, 'ep_last_host': none, 'ep_due': now + hour + module.rand.number.integer(0, [hour, interval // 8] | min)}) -%}
{%- endif -%}
{%- set queue = shared.get('queue') -%}
{%- set hosts = shared.get('hosts') -%}
{%- set users = shared.get('users') -%}
{%- set sessions = shared.get('sessions') -%}
{%- set interval = module.builtins.int(params.anomaly_interval_hours * hour) -%}
{#- Episode: at the first tick at or after its start (due + random delay),
    a standard user logged on to their own enforced workstation, other
    than the previous episode's user and host, tries a file from a
    user-writable folder (blocked, 8004), then a script from one (blocked,
    8007), then starts a proxy binary that the Windows-folder rule allows
    (8002), all inside that ordinary session and within 25 minutes. The
    session's own operations go on around it; every file, delay and
    repeat count comes from the background generators. The next start is
    one interval after this start plus a new random delay; missed episodes
    are not replayed. With no eligible session open, the start waits for
    one (checked once a minute). -#}
{%- if params.anomaly_mode and now >= shared.get('ep_due') -%}
  {%- set cand = [] -%}
  {%- for sid, s in sessions.items() -%}
    {%- set u = users[s.u] -%}
    {%- if not s.ended and not u.admin and u.host == s.h and not hosts[s.h].script_audit and s.u != shared.get('ep_last_user') and s.h != shared.get('ep_last_host') and s.end > now + hour -%}{%- do cand.append(sid) -%}{%- endif -%}
  {%- endfor -%}
  {%- if cand -%}
    {%- set sid = module.rand.choice(cand) -%}
    {%- set s = sessions[sid] -%}
    {%- set start = now + module.rand.number.integer(0, 999999) -%}
    {%- set ep = {'ep': true} -%}
    {%- set t1 = try_user_file(sid, start, ep) | int -%}
    {%- set d = namespace(a=ln(120, 0.9) | int, b=ln(150, 0.9) | int) -%}
    {%- for _ in range(40) if d.a + d.b > 900 * sec -%}{%- set d.a = ln(120, 0.9) | int -%}{%- set d.b = ln(150, 0.9) | int -%}{%- endfor -%}
    {%- set t2 = script_burst(sid, t1 + d.a, true, ep) | int -%}
    {%- set _ = run_app(sid, t2 + d.b, pick_app(users[s.u], true) | int, ep) -%}
    {%- do shared.update({'ep_last_user': s.u, 'ep_last_host': s.h, 'ep_due': start + interval + module.rand.number.integer(0, [hour, interval // 8] | min)}) -%}
  {%- else -%}
    {%- do shared.set('ep_due', now + 60 * sec) -%}
  {%- endif -%}
{%- endif -%}
{%- if now < queue[0][0] -%}
  {%- do shared.set('next_due', queue[0][0]) -%}
  {{- dispatch.drop() -}}
{%- endif -%}
{%- set out = namespace(row=none, rec=0) -%}
{%- for _ in range(32) if out.row is none and queue and queue[0][0] <= now -%}
  {%- set top = hq.heappop(queue) -%}
  {%- set due = top[0] -%}
  {%- set item = top[2] -%}
  {%- if item.k == 'row' -%}
    {%- set sess = sessions.get(item.s) -%}
    {%- set t_emit = [due, shared.get('last_us') + 1] | max -%}
    {%- set held = namespace(v=none) -%}
    {%- if item.lol and not item.get('ep') and sess -%}
      {#- Chain guard: drop a background proxy-binary launch when a
          blocked executable followed by a blocked script lies within the
          window before it. -#}
      {%- for a in sess.t4 if held.v is none and t_emit - a <= window -%}
        {%- for b in sess.t7 if held.v is none and b >= a -%}{%- set held.v = a -%}{%- endfor -%}
      {%- endfor -%}
    {%- endif -%}
    {%- if held.v is not none -%}
    {%- else -%}
      {%- set out.row = item -%}
      {%- set out.rec = t_emit -%}
      {%- do shared.set('last_us', t_emit) -%}
      {%- if sess and item.code in [8004, 8007] -%}
        {%- set lst = sess.t4 if item.code == 8004 else sess.t7 -%}
        {%- do lst.append(t_emit) -%}
        {%- for _ in range(4) if lst and t_emit - lst[0] > window -%}{%- do lst.pop(0) -%}{%- endfor -%}
        {%- if lst | length > 16 -%}{%- do lst.pop(0) -%}{%- endif -%}
      {%- endif -%}
    {%- endif -%}
  {%- elif item.k == 'logon' -%}
    {#- Interactive logon: new logon ID and shell, then operations until
        logoff. Admins pick any host. -#}
    {%- set u = users[item.u] -%}
    {%- set h = u.host if u.host is not none else module.rand.number.integer(0, (hosts | length) - 1) -%}
    {%- set dur = ln(2400, 0.9) | int if u.admin else ln(22 * 3600, 0.5) | int -%}
    {%- set sid = shared.get('sess_seq') + 1 -%}
    {%- do shared.set('sess_seq', sid) -%}
    {%- set sid = sid | string -%}
    {%- do sessions.update({sid: {'u': item.u, 'h': h, 'logon': '0x' ~ '%x' | format(module.rand.number.integer(131072, 67108863)), 'explorer': 0, 'recent': [], 't4': [], 't7': [], 'end': due + dur, 'ended': false}}) -%}
    {%- set shell = namespace(v=0) -%}
    {%- for ai in range(shared.get('apps') | length) if shared.get('apps')[ai].full.endswith('explorer.exe') -%}{%- set shell.v = run_app(sid, due, ai, {}) | int -%}{%- endfor -%}
    {%- do sessions[sid].update({'explorer': shell.v}) -%}
    {{- push(due + (ln(40, 1.0) | int), {'k': 'op', 's': sid}) -}}
    {{- push(due + dur, {'k': 'logoff', 's': sid}) -}}
  {%- elif item.k == 'logoff' -%}
    {#- The session is kept for its queued records and the chain guard,
        then dropped. -#}
    {%- set sess = sessions[item.s] -%}
    {%- set u = users[sess.u] -%}
    {%- do sess.update({'ended': true}) -%}
    {{- push(due + 2 * hour, {'k': 'gc', 's': item.s}) -}}
    {{- push(due + (ln(5 * 3600, 0.9) | int if u.admin else ln(3 * 3600, 0.6) | int), {'k': 'logon', 'u': sess.u}) -}}
  {%- elif item.k == 'gc' -%}
    {%- do sessions.pop(item.s) -%}
  {%- elif item.k == 'op' and item.s in sessions and not sessions[item.s].ended -%}
    {#- One user operation; the next one follows after a lognormal gap
        scaled by the user's own pace. -#}
    {%- set sess = sessions[item.s] -%}
    {%- set u = users[sess.u] -%}
    {%- set r = module.rand.number.floating(0, 1) -%}
    {%- if r < 0.835 -%}
      {%- set _ = run_app(item.s, due, pick_app(u, false) | int, {}) -%}
    {%- elif r < 0.985 -%}
      {%- set _ = script_burst(item.s, due, module.rand.chance(0.04), {}) -%}
    {%- else -%}
      {#- A file from a user-writable folder; sometimes followed by a
          script attempt or a proxy-binary launch (partial chains). -#}
      {%- set t = try_user_file(item.s, due, {}) | int -%}
      {%- set r2 = module.rand.number.floating(0, 1) -%}
      {%- if r2 < 0.3 -%}
        {%- set t = script_burst(item.s, t + (ln(120, 0.9) | int), true, {}) | int -%}
        {%- if module.rand.chance(0.3) -%}{%- set _ = run_app(item.s, t + (ln(150, 0.9) | int), pick_app(u, true) | int, {}) -%}{%- endif -%}
      {%- elif r2 < 0.45 -%}
        {%- set _ = run_app(item.s, t + (ln(150, 0.9) | int), pick_app(u, true) | int, {}) -%}
      {%- endif -%}
    {%- endif -%}
    {{- push(due + module.builtins.int((ln(75, 1.25) | int) * u.pace), item) -}}
  {%- endif -%}
{%- endfor -%}
{%- do shared.set('next_due', queue[0][0] if queue else now + sec) -%}
{%- if out.row is none -%}{{- dispatch.drop() -}}{%- endif -%}
{%- set row = out.row -%}
{%- set u = users[row.uu] -%}
{%- set host = hosts[row.hh] -%}
{%- set ch = row.ch -%}
{#- Other records of the same channel (not modeled) take record numbers
    in between. -#}
{%- set record_id = host.rec[ch] + 1 + (module.rand.number.integer(1, 3) if module.rand.chance(0.03) else 0) -%}
{%- do host.rec.update({ch: record_id}) -%}
{%- set moment = ts + module.datetime.timedelta(microseconds=out.rec - now) -%}
{%- set system_time = moment.strftime('%Y-%m-%dT%H:%M:%S.%f') ~ module.rand.number.integer(0, 9) ~ 'Z' -%}
{%- set full = row.full -%}
{%- set low = full | lower -%}
{%- if low.startswith('c:\\windows\\system32\\') -%}{%- set fp = '%SYSTEM32%\\' ~ full[20:] | upper -%}
{%- elif low.startswith('c:\\windows\\') -%}{%- set fp = '%WINDIR%\\' ~ full[11:] | upper -%}
{%- elif low.startswith('c:\\program files\\') -%}{%- set fp = '%PROGRAMFILES%\\' ~ full[17:] | upper -%}
{%- else -%}{%- set fp = '%OSDRIVE%\\' ~ full[3:] | upper -%}{%- endif -%}
{%- set code = row.code -%}
{%- set rule = rules[row.rule] if row.rule else ['{00000000-0000-0000-0000-000000000000}', '-', '-'] -%}
{%- set level = {8002: [4, 'information'], 8005: [4, 'information'], 8003: [3, 'warning'], 8006: [3, 'warning'], 8004: [2, 'error'], 8007: [2, 'error']}[code] -%}
{%- set channel = 'Microsoft-Windows-AppLocker/EXE and DLL' if ch == 'exe' else 'Microsoft-Windows-AppLocker/MSI and Script' -%}
{%- if code in [8002, 8005] -%}{%- set message = fp ~ ' was allowed to run.' -%}
{%- elif code in [8003, 8006] -%}{%- set message = fp ~ ' was allowed to run but would have been prevented from running if the AppLocker policy were enforced.' -%}
{%- else -%}{%- set message = fp ~ ' was prevented from running.' -%}{%- endif -%}
{%- set data = [
  ['PolicyNameLength', row.pol | length], ['PolicyName', row.pol],
  ['RuleId', rule[0]], ['RuleNameLength', rule[1] | length], ['RuleName', rule[1]],
  ['RuleSddlLength', rule[2] | length], ['RuleSddl', rule[2]],
  ['TargetUser', u.sid], ['TargetProcessId', row.pid],
  ['FilePathLength', fp | length], ['FilePath', fp],
  ['FileHashLength', 32], ['FileHash', row.hash],
  ['FqbnLength', row.fqbn | length], ['Fqbn', row.fqbn],
  ['TargetLogonId', row.ll],
  ['FullFilePathLength', full | length], ['FullFilePath', full]
] -%}
{%- set thread = 4 * module.rand.number.integer(200, 9000) -%}
{%- set xml = namespace(v='<Event xmlns="http://schemas.microsoft.com/win/2004/08/events/event"><System><Provider Name="Microsoft-Windows-AppLocker" Guid="{cbda4dbf-8d5d-4f69-9578-be14aa540d22}"/><EventID>' ~ code ~ '</EventID><Version>0</Version><Level>' ~ level[0] ~ '</Level><Task>0</Task><Opcode>0</Opcode><Keywords>0x8000000000000000</Keywords><TimeCreated SystemTime="' ~ system_time ~ '"/><EventRecordID>' ~ record_id ~ '</EventRecordID><Correlation/><Execution ProcessID="' ~ row.ppid ~ '" ThreadID="' ~ thread ~ '"/><Channel>' ~ channel ~ '</Channel><Computer>' ~ host.name ~ '</Computer><Security UserID="' ~ u.sid ~ '"/></System><UserData><RuleAndFileData xmlns="http://schemas.microsoft.com/schemas/event/Microsoft.Windows/1.0.0.0">') -%}
{%- set user_data = {} -%}
{%- for key, value in data -%}
  {%- set xml.v = xml.v ~ '<' ~ key ~ '>' ~ (value | string).replace('&', '&amp;').replace('<', '&lt;').replace('>', '&gt;') ~ '</' ~ key ~ '>' -%}
  {%- do user_data.update({key: value}) -%}
{%- endfor -%}
{%- set xml.v = xml.v ~ '</RuleAndFileData></UserData></Event>' -%}
{%- do user_data.update({'xml_name': 'RuleAndFileData'}) -%}
{%- set file = {'hash': {'sha256': row.hash}, 'name': full.split('\\')[-1]} -%}
{%- set m = module.re.match('^(?:CN=(?P<cn>[^,\\\\]*)(?:, )?)?(?:O=(?P<o>.*?)(?:, L=(?P<l>.*?))?(?:, S=(?P<s>.*?))?, C=(?P<c>[^\\\\]*))?\\\\(?P<prod>[^\\\\]*)\\\\(?P<orig>[^\\\\]*)\\\\(?P<ver>.*)$', row.fqbn) if row.fqbn != '-' else none -%}
{%- if m -%}
  {%- set pe = {} -%}
  {%- for k, v in [['product', m.group('prod')], ['original_file_name', m.group('orig')], ['file_version', m.group('ver')]] if v -%}{%- do pe.update({k: v}) -%}{%- endfor -%}
  {%- set subject = {} -%}
  {%- if m.group('o') -%}{%- do subject.update({'organization': [m.group('o')]}) -%}{%- endif -%}
  {%- if m.group('l') -%}{%- do subject.update({'locality': m.group('l')}) -%}{%- endif -%}
  {%- if m.group('s') -%}{%- do subject.update({'state_or_province': [m.group('s')]}) -%}{%- endif -%}
  {%- if m.group('c') -%}{%- do subject.update({'country': [m.group('c')]}) -%}{%- endif -%}
  {%- if pe -%}{%- do file.update({'pe': pe}) -%}{%- endif -%}
  {%- do file.update({'x509': {'subject': subject}}) -%}
{%- endif -%}
{%- set dataset = 'windows.applocker_exe_and_dll' if ch == 'exe' else 'windows.applocker_msi_and_script' -%}
{%- set event = {
  '@timestamp': moment.isoformat(timespec='milliseconds').replace('+00:00', 'Z'),
  'ecs': {'version': '8.17.0'},
  'event': {'action': 'None', 'category': ['process'], 'code': code | string, 'dataset': dataset, 'kind': 'event', 'original': xml.v, 'provider': 'Microsoft-Windows-AppLocker', 'type': ['start']},
  'file': file,
  'host': {'name': host.name},
  'log': {'level': level[1]},
  'message': message,
  'process': {'pid': row.ppid},
  'tags': ['preserve_original_event'],
  'user': {'id': u.sid},
  'winlog': {
    'channel': channel, 'computer_name': host.name, 'event_id': code | string, 'level': level[1], 'opcode': 'Info',
    'process': {'pid': row.ppid, 'thread': {'id': thread}},
    'provider_guid': '{cbda4dbf-8d5d-4f69-9578-be14aa540d22}', 'provider_name': 'Microsoft-Windows-AppLocker',
    'record_id': record_id | string, 'task': 'None', 'time_created': moment.isoformat(timespec='milliseconds').replace('+00:00', 'Z'),
    'user': {'identifier': u.sid}, 'user_data': user_data, 'version': 0
  }
} -%}
{{- event | tojson -}}
