{#- ClearPass 6.11 Policy Manager Audit Records (RFC 5424 export) from
    one node. The input sets the volume and its hour-of-day curve; every
    input timestamp becomes exactly one audit record. A timestamp takes
    the earliest due record of a planned activity (a WebUI session, an
    outside password guess or, when anomaly_mode is true, the anomaly
    episode), stamped at its planned time; with nothing due it opens a
    new WebUI session of an idle administrator, weighted by activity. -#}
{#- Jinja has no raise statement: a missing-key lookup aborts the render
    with the message as the key. -#}
{%- macro invalid(message) -%}
  {%- do module.operator.getitem({}, message) -%}
{%- endmacro -%}
{#- Hourly volume of patterns/floor.yml + patterns/office.yml relative
    to the busiest hour (UTC); weights episode start times. -#}
{%- macro load(t) -%}
  {%- set hours = [0.056, 0.056, 0.056, 0.059, 0.071, 0.105, 0.176, 0.295,
      0.457, 0.647, 0.824, 0.952, 1.000, 0.947, 0.814, 0.630, 0.438, 0.273,
      0.157, 0.093, 0.065, 0.057, 0.056, 0.056] -%}
  {{- hours[((t % 86400) // 3600) | int] -}}
{%- endmacro -%}
{#- A start time in [lo, lo + width): drawn by rejection with weight
    load (first episode) or load^2 + 0.05 (later episodes). -#}
{%- macro draw_start(lo, width, squared) -%}
  {%- set pick = namespace(t=lo + module.rand.number.floating(0, width)) -%}
  {%- for _ in range(500) -%}
    {%- set c = load(pick.t) | float -%}
    {%- set w = (c * c + 0.05) / 1.05 if squared else c -%}
    {%- if module.rand.number.floating(0, 1) < w -%}{%- break -%}{%- endif -%}
    {%- set pick.t = lo + module.rand.number.floating(0, width) -%}
  {%- endfor -%}
  {{- pick.t -}}
{%- endmacro -%}
{%- set num = module.rand.number -%}
{%- set rand = module.rand -%}
{%- set hq = module.heapq -%}
{%- set ln = module.math.log -%}
{%- set now = timestamp.timestamp() -%}
{#- Chain window, counted from the first failed login. -#}
{%- set window = 1800 -%}
{%- set jump_host = '10.20.5.10' -%}
{%- set cfg_kinds = ['account_settings', 'cluster_parameter', 'log_change', 'key_add'] -%}
{#- Change-category weights of routine sessions and of maintenance
    sessions (logging and CLI access work). -#}
{%- set routine_weights = [44, 36, 12, 8] -%}
{%- set maintenance_weights = [10, 12, 40, 38] -%}
{#- Changes per session, and mistyped passwords before a login: the
    chance per client kind (password manager at the desk, VPN laptop,
    typed on the jump host) and the number of failures. -#}
{%- set change_counts = [1, 2, 3, 4, 5, 6, 7, 8] -%}
{%- set change_count_weights = [30, 22, 16, 11, 8, 6, 4, 3] -%}
{%- set typo_chance = {'desk': 0.01, 'vpn': 0.02, 'jump': 0.06} -%}
{%- set typo_counts = [1, 2, 3, 4, 5] -%}
{%- set typo_count_weights = [55, 24, 11, 6, 4] -%}
{%- if shared.get('heap') is none -%}
  {%- set ipv4 = '(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])(\\.(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])){3}' -%}
  {%- if params.anomaly_mode is not boolean -%}
    {{- invalid('anomaly_mode must be a boolean') -}}
  {%- endif -%}
  {%- if params.anomaly_interval_hours is not number or params.anomaly_interval_hours is boolean
      or not 3 <= params.anomaly_interval_hours <= 8760 -%}
    {{- invalid('anomaly_interval_hours must be a number in 3..8760') -}}
  {%- endif -%}
  {%- if params.node_ip is not string or not module.re.fullmatch(ipv4, params.node_ip) -%}
    {{- invalid('node_ip must be a dotted-quad IPv4 address') -}}
  {%- endif -%}
  {%- if params.admin_user is not string or not module.re.fullmatch('[A-Za-z0-9][A-Za-z0-9._@-]{0,63}', params.admin_user) -%}
    {{- invalid('admin_user must be an account name') -}}
  {%- endif -%}
  {#- The organisation (administrators, their desks, VPN addresses,
      activity weights and change propensity) is fixed for a node; all
      activity on top of it is random in every run. -#}
  {%- set org = module.random.Random('clearpass-org:' ~ params.node_ip) -%}
  {%- set admins = [{'user': params.admin_user, 'desk': '10.20.10.10'}] -%}
  {%- for row in samples.admins -%}
    {%- if row.user == params.admin_user -%}
      {{- invalid('admin_user must differ from the sample administrators') -}}
    {%- endif -%}
    {%- do admins.append({'user': row.user, 'desk': row.client_ip}) -%}
  {%- endfor -%}
  {%- set cum = [] -%}
  {%- set acc = namespace(v=0) -%}
  {%- for a in admins -%}
    {%- do a.update({'w': [[org.lognormvariate(0, 0.4), 0.6] | max, 1.8] | min,
        'change': org.uniform(0.35, 0.75),
        'vpn': ['10.8.' ~ org.randint(0, 3) ~ '.' ~ org.randint(2, 254),
                '10.8.' ~ org.randint(0, 3) ~ '.' ~ org.randint(2, 254)],
        'busy': 0, 'stale_ip': none, 'stale_until': 0}) -%}
    {%- set acc.v = acc.v + a.w -%}
    {%- do cum.append(acc.v) -%}
  {%- endfor -%}
  {%- set interval = params.anomaly_interval_hours * 3600 -%}
  {%- do shared.update({'heap': [], 'admins': admins, 'cum': cum, 'chains': {},
      'clock': {'prev': now, 'last': 0,
                'ep_start': draw_start(now, [interval, 86400] | min, false) | float},
      'last_ep': {'u': none, 'ip': none}}) -%}
{%- endif -%}
{%- set heap = shared.get('heap') -%}
{%- set clock = shared.get('clock') -%}
{%- set admins = shared.get('admins') -%}
{%- set cum = shared.get('cum') -%}
{#- Per account: its failed and successful logins [time, 'F' or 'S',
    client IP] and log service changes [time, 'L', none] of the last
    chain window. -#}
{%- set chains = shared.get('chains') -%}
{%- set dt = [now - clock.prev, 0] | max -%}
{%- do clock.update({'prev': now}) -%}
{#- Random arrivals over the time since the previous timestamp, at
    rates that do not depend on the record volume. -#}
{#- Password rotation (each administrator about every 45 days): the
    old password stays saved in the browser of one of the
    administrator's clients for about a day. -#}
{%- if num.floating(0, 1) < 1 - module.math.exp(-dt * admins | length / 45 / 86400) -%}
  {%- set a = rand.choice(admins) -%}
  {%- do a.update({'stale_ip': a.desk if rand.chance(0.5) else rand.choice(a.vpn),
      'stale_until': now + num.lognormal(ln(86400), 0.5)}) -%}
{%- endif -%}
{#- Password guesses against the WebUI from outside addresses, about
    every other day around the clock; never successful. -#}
{%- if num.floating(0, 1) < 1 - module.math.exp(-dt * 0.5 / 86400) -%}
  {%- set a = admins[0] if rand.chance(0.6) else rand.choice(admins) -%}
  {%- set ip = rand.choice(['198.51.100.', '203.0.113.', '192.0.2.']) ~ num.integer(1, 254) -%}
  {%- set t = namespace(v=[now, clock['last'] + 1] | max) -%}
  {%- set steps = [] -%}
  {%- for _ in range(rand.weighted_choice([1, 2, 3, 4, 5, 6], [40, 25, 15, 10, 6, 4])) -%}
    {%- do steps.append([t.v, 'F', ip]) -%}
    {%- set t.v = t.v + 1 + [num.lognormal(ln(8), 0.8), 80] | min -%}
  {%- endfor -%}
  {%- do hq.heappush(heap, [steps[0][0], num.floating(0, 1),
      {'a': a, 'steps': steps, 'i': 0, 'ep': false, 'w': routine_weights}]) -%}
{%- endif -%}
{%- if params.anomaly_mode and clock.ep_start <= now -%}
  {#- Episode: an administrator (weighted by activity, not the previous
      episode's) from one of that administrator's VPN addresses or the
      jump host (not the previous episode's address). Four failed
      logins with ordinary typing delays, the successful login, then a
      log service change and an SSH key addition with delays drawn from
      the ordinary change-delay law, drawn again until the episode fits
      the chain window. The administrator's own sessions go on as
      usual. The next start is drawn in a window of min(interval / 4,
      6 h) centred one interval after this actual start, weighted
      towards busy hours. -#}
  {%- set last = shared.get('last_ep') -%}
  {%- set pick = namespace(a=admins[module.bisect.bisect_right(cum, num.floating(0, cum[-1])) % admins | length]) -%}
  {%- for _ in range(50) -%}
    {%- if pick.a.user != last.u -%}{%- break -%}{%- endif -%}
    {%- set pick.a = admins[module.bisect.bisect_right(cum, num.floating(0, cum[-1])) % admins | length] -%}
  {%- endfor -%}
  {%- set ip = rand.choice((pick.a.vpn + [jump_host]) | reject('equalto', last.ip) | list) -%}
  {%- do last.update({'u': pick.a.user, 'ip': ip}) -%}
  {%- set t0 = [clock.ep_start, clock['last'] + 1] | max -%}
  {%- set t = namespace(v=t0) -%}
  {%- set steps = [] -%}
  {%- for _ in range(4) -%}
    {%- do steps.append([t.v, 'F', ip]) -%}
    {%- set t.v = t.v + 1 + [num.lognormal(ln(12), 0.7), 120] | min -%}
  {%- endfor -%}
  {%- do steps.append([t.v, 'S', ip]) -%}
  {%- set d = namespace(a=0, b=0) -%}
  {%- for _ in range(1000) -%}
    {%- set d.a = 5 + [num.lognormal(ln(150), 1.0), 3600] | min -%}
    {%- set d.b = 5 + [num.lognormal(ln(150), 1.0), 3600] | min -%}
    {%- if t.v - t0 + d.a + d.b <= window - 60 -%}{%- break -%}{%- endif -%}
  {%- endfor -%}
  {%- do steps.append([t.v + d.a, 'log_change', none]) -%}
  {%- do steps.append([t.v + d.a + d.b, 'key_add', none]) -%}
  {%- do hq.heappush(heap, [t0, num.floating(0, 1),
      {'a': pick.a, 'steps': steps, 'i': 0, 'ep': true, 'w': maintenance_weights}]) -%}
  {%- set interval = params.anomaly_interval_hours * 3600 -%}
  {%- set width = [interval / 4, 21600] | min -%}
  {%- do clock.update({'ep_start': draw_start(t0 + interval - width / 2, width, true) | float}) -%}
{%- endif -%}
{%- if heap and heap[0][0] <= now -%}
  {#- The earliest due record of a planned activity, at its planned
      time. -#}
  {%- set item = hq.heappop(heap)[2] -%}
  {%- set stamp = [item.steps[item.i][0], clock['last'] + 0.001] | max -%}
{%- else -%}
  {#- A new WebUI session of an idle administrator, weighted by
      activity. Routine sessions come from the desk, a VPN laptop or
      the jump host; maintenance sessions (logging and CLI access work)
      mostly from the jump host. A saved outdated password or mistyped
      passwords may come first; then changes minutes apart. -#}
  {%- set pick = namespace(a=none) -%}
  {%- for _ in range(30) -%}
    {%- set c = admins[module.bisect.bisect_right(cum, num.floating(0, cum[-1])) % admins | length] -%}
    {%- if c.busy <= now -%}{%- set pick.a = c -%}{%- break -%}{%- endif -%}
  {%- endfor -%}
  {%- if pick.a is none -%}
    {%- set pick.a = admins[module.bisect.bisect_right(cum, num.floating(0, cum[-1])) % admins | length] -%}
  {%- endif -%}
  {%- set a = pick.a -%}
  {%- set maintenance = rand.chance(0.12) -%}
  {%- if maintenance -%}
    {%- set src = 'jump' if rand.chance(0.8) else 'vpn' -%}
  {%- else -%}
    {%- set src = rand.weighted_choice(['desk', 'vpn', 'jump'], [62, 30, 8]) -%}
  {%- endif -%}
  {%- set ip = a.desk if src == 'desk' else jump_host if src == 'jump' else rand.choice(a.vpn) -%}
  {%- set t = namespace(v=now) -%}
  {%- set steps = [] -%}
  {%- if a.stale_until > now and ip == a.stale_ip and rand.chance(0.8) -%}
    {#- Saved outdated password: several attempts about half a minute
        apart; the administrator then types the new password (and
        usually updates the saved one) or gives up. -#}
    {%- set give_up = rand.chance(0.15) -%}
    {%- if rand.chance(0.6) -%}{%- do a.update({'stale_until': 0}) -%}{%- endif -%}
    {%- for _ in range(rand.weighted_choice([3, 4, 5, 6, 7], [30, 25, 20, 15, 10])) -%}
      {%- do steps.append([t.v, 'F', ip]) -%}
      {%- set t.v = t.v + 1 + [num.lognormal(ln(35), 0.6), 300] | min -%}
    {%- endfor -%}
  {%- elif rand.chance(typo_chance[src]) -%}
    {%- set give_up = rand.chance(0.05) -%}
    {%- for _ in range(rand.weighted_choice(typo_counts, typo_count_weights)) -%}
      {%- do steps.append([t.v, 'F', ip]) -%}
      {%- set t.v = t.v + 1 + [num.lognormal(ln(12), 0.7), 120] | min -%}
    {%- endfor -%}
  {%- else -%}
    {%- set give_up = false -%}
  {%- endif -%}
  {%- set w = maintenance_weights if maintenance else routine_weights -%}
  {%- if not give_up -%}
    {%- do steps.append([t.v, 'S', ip]) -%}
    {%- if maintenance or rand.chance(a.change) -%}
      {%- for _ in range(rand.weighted_choice(change_counts, change_count_weights)) -%}
        {%- set t.v = t.v + 5 + [num.lognormal(ln(150), 1.0), 3600] | min -%}
        {%- do steps.append([t.v, rand.weighted_choice(cfg_kinds, w), none]) -%}
      {%- endfor -%}
    {%- endif -%}
  {%- endif -%}
  {%- do a.update({'busy': steps[-1][0]}) -%}
  {%- set item = {'a': a, 'steps': steps, 'i': 0, 'ep': false, 'w': w} -%}
  {%- set stamp = [now, clock['last'] + 0.001] | max -%}
{%- endif -%}
{%- set step = item.steps[item.i] -%}
{%- do item.update({'i': item.i + 1}) -%}
{%- if item.i < item.steps | length -%}
  {%- do hq.heappush(heap, [item.steps[item.i][0], num.floating(0, 1), item]) -%}
{%- endif -%}
{%- do clock.update({'last': stamp}) -%}
{%- set user = item.a.user -%}
{%- set kind = {'F': 'login_failure', 'S': 'login_success'}.get(step[1], step[1]) -%}
{%- if kind == 'key_add' and not item.ep -%}
  {#- Guard: an ordinary SSH key addition that would complete the chain
      for this account with any combination of its records of the last
      window (four failures from one client, a success from that client,
      a log service change, in this order) becomes another change of the
      same session, drawn with the session's category weights. Scanning
      from the earliest failure of each client finds any such
      combination. -#}
  {%- set recent = chains.get(user, []) | selectattr(0, 'ge', stamp - window) | list -%}
  {%- set open = namespace(v=false) -%}
  {%- for fip in recent | selectattr(1, 'equalto', 'F') | map(attribute=2) | unique -%}
    {%- set g = namespace(n=0) -%}
    {%- for r in recent -%}
      {%- if g.n < 4 and r[1] == 'F' and r[2] == fip -%}
        {%- set g.n = g.n + 1 -%}
      {%- elif g.n == 4 and r[1] == 'S' and r[2] == fip -%}
        {%- set g.n = 5 -%}
      {%- elif g.n == 5 and r[1] == 'L' -%}
        {%- set g.n = 6 -%}
      {%- endif -%}
    {%- endfor -%}
    {%- if g.n == 6 -%}{%- set open.v = true -%}{%- endif -%}
  {%- endfor -%}
  {%- if open.v -%}
    {%- set kind = rand.weighted_choice(cfg_kinds[:3], item.w[:3]) -%}
  {%- endif -%}
{%- endif -%}
{%- set actor = {'user': user, 'client_ip': step[2]} -%}
{#- Chain-relevant history of the account, fed with every record. -#}
{%- set code = {'login_failure': 'F', 'login_success': 'S', 'log_change': 'L'}.get(kind) -%}
{%- if code -%}
  {%- set kept = chains.get(user, []) | selectattr(0, 'ge', stamp - window) | list -%}
  {%- do kept.append([stamp, code, step[2]]) -%}
  {%- do chains.update({user: kept}) -%}
{%- endif -%}
{%- set audit_dt = module.datetime.datetime.fromtimestamp(
    (stamp * 1000) // 1 / 1000, module.datetime.timezone.utc) -%}
{%- set export_dt = audit_dt + module.datetime.timedelta(
    seconds=module.rand.number.integer(6, 30),
    milliseconds=module.rand.number.integer(0, 999)) -%}
{#- Exports leave in record order, so export time never goes back. -#}
{%- set last_export = shared.get('last_export') -%}
{%- if last_export is not none and export_dt <= last_export -%}
  {%- set export_dt = last_export + module.datetime.timedelta(
      milliseconds=module.rand.number.integer(1, 400)) -%}
{%- endif -%}
{%- do shared.set('last_export', export_dt) -%}
{%- set audit_time = audit_dt.isoformat(timespec='milliseconds').replace('+00:00', 'Z') -%}
{%- set export_time = export_dt.isoformat(timespec='milliseconds').replace('+00:00', 'Z') -%}
{%- set pid = shared.get('process_id') -%}
{%- if pid is none -%}
  {%- set pid = module.rand.number.integer(10000, 60000) -%}
  {%- do shared.set('process_id', pid) -%}
{%- endif -%}
{%- set message_index = shared.get('message_index') -%}
{%- if message_index is none -%}
  {%- set message_index = module.rand.number.integer(10, 70) -%}
{%- endif -%}
{%- do shared.set('message_index', ((message_index - 1 + module.rand.number.integer(1, 3)) % 999999) + 1) -%}
{%- set message_id = message_index ~ '-1-0' -%}
{%- set origin = '[timeQuality tzKnown="1"][origin swVersion="'
    ~ params.software_version ~ '" software="PolicyManager" ip="'
    ~ params.node_ip ~ '" enterpriseId="1.3.6.1.4.1.14823"]' -%}
{%- if kind == 'login_success' -%}
  {%- set native_category = 'Logged in' -%}
  {%- set native_action = 'None' -%}
  {%- set level = 'INFO' -%}
  {%- set description = 'User: ' ~ actor.user ~ '\\nRole: Super Administrator'
      ~ '\\nAuthentication Source: Policy Manager Local Admin Users'
      ~ '\\nSession ID: ' ~ module.rand.string.hex(32)
      ~ '\\nClient IP Address: ' ~ actor.client_ip
      ~ '\\nSession Inactive Expiry Time: 359 mins' -%}
{%- elif kind == 'login_failure' -%}
  {%- set native_category = 'Login Failed' -%}
  {%- set native_action = 'None' -%}
  {%- set level = 'WARN' -%}
  {%- set description = 'User: ' ~ actor.user
      ~ '\\nClient IP Address: ' ~ actor.client_ip -%}
{%- elif kind == 'account_settings' -%}
  {%- set native_category = 'Account Settings' -%}
  {%- set native_action = 'MODIFY' -%}
  {%- set entity_name = 'Admin Users' -%}
{%- elif kind == 'cluster_parameter' -%}
  {%- set native_category = 'Cluster-wide Parameter' -%}
  {%- set native_action = 'MODIFY' -%}
  {%- set entity_name = module.rand.choice([
      'Disable TLSv1.3 support',
      'Automatically check for available Software Updates',
      'CLI Session Idle Timeout']) -%}
{%- elif kind == 'log_change' -%}
  {%- set native_category = 'Log Service Configuration' -%}
  {%- set native_action = 'MODIFY' -%}
  {%- set entity_name = 'Admin server' -%}
{%- else -%}
  {%- set native_category = 'SSH Public Key' -%}
  {%- set native_action = 'ADD' -%}
  {%- set entity_name = 'root@cp-node' -%}
{%- endif -%}
{%- if kind in ['login_success', 'login_failure'] -%}
  {%- set event_id = 3003 -%}
  {%- set detail = 'eventId="3003" Action="None" Category="'
      ~ native_category ~ '" Description="' ~ description
      ~ '" Level="' ~ level ~ '" Component="Policy Manager UI"' -%}
{%- else -%}
  {%- set event_id = 3001 -%}
  {%- set detail = 'eventId="3001" Action="' ~ native_action
      ~ '" Category="' ~ native_category ~ '" User="'
      ~ actor.user ~ '" EntityName="' ~ entity_name ~ '"' -%}
{%- endif -%}
{%- set original = '<' ~ params.syslog_priority ~ '>1 '
    ~ export_time ~ ' ' ~ params.node_ip ~ ' ClearPass ' ~ pid ~ ' '
    ~ message_id ~ ' ' ~ origin ~ '[clearPass@14823 ' ~ detail
    ~ ' CppmNode.CPPM-Node="' ~ params.node_ip
    ~ '" Timestamp="' ~ audit_time ~ '"]' -%}
{%- set event_meta = {'kind': 'event', 'dataset': 'clearpass.audit',
    'category': ['authentication'] if kind in ['login_success', 'login_failure']
        else ['configuration'],
    'type': ['start'] if kind == 'login_success' else ['denied']
        if kind == 'login_failure' else ['creation'] if kind == 'key_add'
        else ['change'],
    'action': kind.replace('_', '-'), 'original': original} -%}
{%- if kind in ['login_success', 'login_failure'] -%}
  {%- do event_meta.update({'outcome': 'success' if kind == 'login_success'
      else 'failure'}) -%}
{%- endif -%}
{%- set clearpass = {'event_id': event_id, 'action': native_action,
    'category': native_category, 'software_version': params.software_version,
    'audit_timestamp': audit_time, 'export_timestamp': export_time,
    'process_id': pid, 'message_id': message_id,
    'syslog_priority': params.syslog_priority} -%}
{%- if kind in ['login_success', 'login_failure'] -%}
  {%- do clearpass.update({'description': description,
      'level': level, 'component': 'Policy Manager UI'}) -%}
{%- else -%}
  {%- do clearpass.update({'entity_name': entity_name}) -%}
{%- endif -%}
{%- set event = {'@timestamp': audit_time,
    'ecs': {'version': '8.17.0'},
    'event': event_meta,
    'host': {'name': params.node_ip, 'ip': [params.node_ip]},
    'user': {'name': actor.user},
    'related': {'user': [actor.user]},
    'clearpass': clearpass} -%}
{%- if kind in ['login_success', 'login_failure'] -%}
  {%- do event.update({'source': {'ip': actor.client_ip}}) -%}
  {%- do event.related.update({'ip': [actor.client_ip]}) -%}
{%- endif -%}
{{- event | tojson -}}
