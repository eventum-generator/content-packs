{#- One Unbound 1.26.1 recursive resolver writing tagged query and
    reply lines to its own logfile. Every tick emits at most one line:
    the earliest due query or reply, otherwise nothing. Clients start
    lookups as independent random processes; the anomaly episode is
    one extra TXT run built by the same code. Times are integer
    microseconds. -#}
{%- set now = timestamp.timestamp() | int -%}
{%- set now_us = now * 1000000 -%}
{%- set utc = module.datetime.timezone.utc -%}
{%- set interval = params.anomaly_interval_hours | float -%}
{%- set zones = params.tunnel_domains -%}
{#- Chain window of the detector (zone A lookup to eighth TXT),
    shared by the background guard. -#}
{%- set chain_us = 600 * 1000000 -%}
{%- set lmax = 1.6 -%}
{%- set lmean = (10 * 1.6 + 4 * 0.9 + 10 * 0.33) / 24 -%}
{%- set rmax = params.sessions_per_second * lmax / lmean -%}
{%- macro load_at(h) -%}
{{- 1.6 if 7 <= h < 17 else (0.9 if 17 <= h < 21 else 0.33) -}}
{%- endmacro -%}
{#- A second in [a, b), density proportional to the load curve (sq
    false) or to its square plus a small floor (sq true). -#}
{%- macro pick_time(a, b, sq) -%}
  {%- set slots = [] -%}
  {%- set ws = [] -%}
  {%- for hh in range(a // 3600, (b - 1) // 3600 + 1) -%}
    {%- set lo = [hh * 3600, a] | max -%}
    {%- set hi = [hh * 3600 + 3600, b] | min -%}
    {%- if hi > lo -%}
      {%- set c = load_at(hh % 24) | float -%}
      {%- do slots.append([lo, hi]) -%}
      {%- do ws.append(((c * c + 0.05) if sq else c) * (hi - lo)) -%}
    {%- endif -%}
  {%- endfor -%}
  {%- set sl = module.rand.weighted_choice(slots, ws) -%}
  {{- module.rand.number.integer(sl[0], sl[1] - 1) -}}
{%- endmacro -%}
{#- Log-normal delay in microseconds. -#}
{%- macro gap_us(median, sigma, cap) -%}
{{- ([module.rand.number.lognormal(module.math.log(median), sigma), cap] | min * 1000000) | int -}}
{%- endmacro -%}

{%- if not shared.get('initialized', false) -%}
  {%- if not (2 <= interval <= 8760) -%}{{ module.math.sqrt(-1) }}{%- endif -%}
  {%- set clients = [] -%}
  {%- set weights = [] -%}
  {%- for i in range(params.client_count) -%}
    {%- do clients.append(params.client_prefix ~ (params.client_first + i)) -%}
    {%- do weights.append(module.rand.number.lognormal(0, 0.8)) -%}
  {%- endfor -%}
  {%- set pools = {} -%}
  {%- for z in zones -%}{%- do pools.update({z: []}) -%}{%- endfor -%}
  {%- do shared.update({'initialized': true, 'clients': clients, 'weights': weights,
      'queue': [], 'q_min': none, 'seq': 0, 'cache': {}, 'guard': {}, 'pools': pools,
      'arrival': now_us + (module.rand.number.exponential(rmax) * 1000000) | int,
      'start_at': pick_time(now, now + ([interval, 24] | min * 3600) | int, false) | int,
      'last_client': none, 'last_zone': none, 'used': {}}) -%}
{%- endif -%}
{%- set queue = shared.get('queue') -%}
{%- set pools = shared.get('pools') -%}

{%- macro add(rec) -%}
  {%- do shared.set('seq', shared.get('seq') + 1) -%}
  {%- do rec.update({'n': shared.get('seq')}) -%}
  {%- do queue.append(rec) -%}
  {%- if shared.get('q_min') is none or rec.due < shared.get('q_min') -%}
    {%- do shared.set('q_min', rec.due) -%}
  {%- endif -%}
{%- endmacro -%}

{#- TXT lookup of a 32-hex label under zone z. Most labels are new;
    some repeat a recent label of the same zone. The zone's answer to
    a label (data or NXDOMAIN) is fixed when the label first appears. -#}
{%- macro hex_query(c, z, t, ep) -%}
  {%- set pool = pools[z] -%}
  {%- if pool and module.rand.chance(0.15) -%}
    {%- set lab = module.rand.choice(pool) -%}
  {%- else -%}
    {%- set lab = [module.rand.string.hex(32),
        'NOERROR' if module.rand.chance(0.6) else 'NXDOMAIN',
        module.rand.number.integer(16, 200)] -%}
    {%- do pool.append(lab) -%}
    {%- if pool | length > 60 -%}{%- do pool.pop(0) -%}{%- endif -%}
  {%- endif -%}
  {%- set qname = lab[0] ~ '.' ~ z ~ '.' -%}
  {%- set size = (40 + qname | length + lab[2]) if lab[1] == 'NOERROR' else (91 + qname | length) -%}
  {{- add({'c': c, 'name': qname, 'type': 'TXT', 'zone': z, 'hex': true, 'rcode': lab[1],
      'size': size, 'ttl': 10 if lab[1] == 'NOERROR' else 60, 'ext': true, 'ep': ep, 'due': t}) -}}
{%- endmacro -%}

{#- Burst size: mostly one to three lookups; 3% are scans of a
    folder's worth of hashes (median 8). The first burst after a zone
    A lookup is never a scan. -#}
{%- macro burst_size(scan_ok) -%}
  {%- if scan_ok and module.rand.chance(0.03) -%}
    {%- set x = module.rand.number.lognormal(module.math.log(8), 0.4) -%}
  {%- else -%}
    {%- set x = module.rand.number.lognormal(module.math.log(1.6), 0.5) -%}
  {%- endif -%}
  {{- [[x | round | int, 1] | max, 40] | min -}}
{%- endmacro -%}

{#- A run of hex TXT lookups: bursts at a pace of seconds, separated
    by pauses of tens of minutes. -#}
{%- macro txt_run(c, z, t0, after_a) -%}
  {%- set s = namespace(t=t0) -%}
  {%- set bursts = module.rand.weighted_choice([1, 2, 3, 4, 5, 6, 8, 10], [40, 22, 13, 9, 6, 4, 3, 3]) -%}
  {%- for b in range(bursts) -%}
    {%- if b > 0 -%}{%- set s.t = s.t + gap_us(2400, 0.6, 14400) | int -%}{%- endif -%}
    {%- for i in range(burst_size(b > 0 or not after_a) | int) -%}
      {%- set s.t = s.t + gap_us(2.5, 0.9, 120) | int -%}
      {{- hex_query(c, z, s.t, false) -}}
    {%- endfor -%}
  {%- endfor -%}
{%- endmacro -%}

{#- Episode: one burst of eight lookups at the same pace, kept inside
    the chain window by scaling in the rare case it would overrun. -#}
{%- macro episode_burst(c, z, t0) -%}
  {%- set gaps = [] -%}
  {%- for i in range(8) -%}{%- do gaps.append(gap_us(2.5, 0.9, 120) | int) -%}{%- endfor -%}
  {%- set total = gaps | sum -%}
  {%- set limit = 560 * 1000000 -%}
  {%- set s = namespace(t=t0) -%}
  {%- for g in gaps -%}
    {%- set s.t = s.t + ((g * limit / total) | int if total > limit else g) -%}
    {{- hex_query(c, z, s.t, true) -}}
  {%- endfor -%}
{%- endmacro -%}

{%- macro zone_a(c, z, t, ep) -%}
  {%- set qname = z ~ '.' -%}
  {{- add({'c': c, 'name': qname, 'type': 'A', 'zone': z, 'hex': false, 'rcode': 'NOERROR',
      'size': 44 + qname | length, 'ttl': 60, 'ext': true, 'ep': ep, 'due': t}) -}}
{%- endmacro -%}

{%- macro plain_query(c, t) -%}
  {%- if module.rand.chance(0.8) -%}
    {%- set q = samples.questions.weighted_pick('weight') -%}
    {{- add({'c': c, 'name': q.name, 'type': q.type, 'zone': none, 'hex': false, 'rcode': q.rcode,
        'size': q.size, 'ttl': 45 if q.rcode == 'NXDOMAIN' else (180 if q.type in ['TXT', 'MX'] else 60),
        'ext': false, 'ep': false, 'due': t}) -}}
  {%- else -%}
    {%- set qname = 'host-%03d.corp.example.' | format(module.rand.number.integer(1, 100)) -%}
    {{- add({'c': c, 'name': qname, 'type': 'A', 'zone': none, 'hex': false, 'rcode': 'NOERROR',
        'size': 44 + qname | length, 'ttl': 60, 'ext': false, 'ep': false, 'due': t}) -}}
  {%- endif -%}
{%- endmacro -%}

{#- 1. Client lookups: one Poisson process per client (superposed,
    split by client weight), thinned by the hour-of-day load. -#}
{%- set hour = timestamp.astimezone(utc).hour -%}
{%- set arr = namespace(t=shared.get('arrival')) -%}
{%- for _ in range(64) -%}
  {%- if arr.t < now_us + 1000000 -%}
    {%- if module.rand.chance((load_at(hour) | float) / lmax) -%}
      {%- set c = module.rand.weighted_choice(shared.get('clients'), shared.get('weights')) -%}
      {%- set kind = module.rand.weighted_choice(['plain', 'zone', 'run'], [96, 2, 2]) -%}
      {%- if kind == 'plain' -%}
        {{- plain_query(c, arr.t) -}}
        {%- if module.rand.chance(0.3) -%}
          {{- plain_query(c, arr.t + gap_us(0.4, 1.2, 20) | int) -}}
        {%- endif -%}
      {%- elif kind == 'zone' -%}
        {%- set z = module.rand.choice(zones) -%}
        {{- zone_a(c, z, arr.t, false) -}}
        {%- if module.rand.chance(0.6) -%}
          {{- txt_run(c, z, arr.t, true) -}}
        {%- endif -%}
      {%- else -%}
        {%- set z = module.rand.choice(zones) -%}
        {{- txt_run(c, z, arr.t, false) -}}
      {%- endif -%}
      {%- if kind != 'plain' -%}
        {%- set u = shared.get('used').setdefault(c, []) -%}
        {%- if z not in u -%}{%- do u.append(z) -%}{%- endif -%}
      {%- endif -%}
    {%- endif -%}
    {%- set arr.t = arr.t + [(module.rand.number.exponential(rmax) * 1000000) | int, 1] | max -%}
  {%- endif -%}
{%- endfor -%}
{%- do shared.set('arrival', arr.t) -%}

{#- 2. Episode: the first starts within min(interval, 24 h), its time
    drawn from the load curve; each later one in a window of
    min(interval / 4, 6 h) centred on its due time (previous start
    plus the interval), weighted by the squared load curve. The
    client is drawn by background weight among clients that already
    use a telemetry zone, and uses one of its own zones; client and
    zone differ from the last episode. -#}
{%- if params.anomaly_mode and now >= shared.get('start_at') -%}
  {%- set cs = [] -%}
  {%- set cw = [] -%}
  {%- for c in shared.get('clients') -%}
    {%- set own = shared.get('used').get(c, []) | reject('equalto', shared.get('last_zone')) | list -%}
    {%- if c != shared.get('last_client') and own -%}
      {%- do cs.append(c) -%}
      {%- do cw.append(shared.get('weights')[loop.index0]) -%}
    {%- endif -%}
  {%- endfor -%}
  {%- if cs -%}
    {%- set ec = module.rand.weighted_choice(cs, cw) -%}
    {%- set ez = module.rand.choice(shared.get('used')[ec] | reject('equalto', shared.get('last_zone')) | list) -%}
    {%- set t0 = now_us + module.rand.number.integer(0, 999999) -%}
    {{- zone_a(ec, ez, t0, true) -}}
    {{- episode_burst(ec, ez, t0) -}}
    {%- set due = now + (interval * 3600) | int -%}
    {%- set half = ([interval / 4, 6] | min * 1800) | int -%}
    {%- do shared.update({'last_client': ec, 'last_zone': ez,
        'start_at': pick_time(due - half, due + half, true) | int}) -%}
  {%- endif -%}
{%- endif -%}

{#- 3. Emit the earliest due record, or nothing. -#}
{%- if shared.get('q_min') is none or shared.get('q_min') >= now_us + 1000000 -%}
  {{- dispatch.drop() -}}
{%- endif -%}
{%- set best = namespace(i=0) -%}
{%- for r in queue -%}
  {%- if r.due < queue[best.i].due or (r.due == queue[best.i].due and r.n < queue[best.i].n) -%}
    {%- set best.i = loop.index0 -%}
  {%- endif -%}
{%- endfor -%}
{%- set r = queue.pop(best.i) -%}
{%- do shared.set('q_min', (queue | map(attribute='due') | min) if queue else none) -%}
{%- set t = r.due -%}
{%- set is_reply = r.get('reply', false) -%}

{%- if not is_reply -%}
  {#- Replica of the chain detector per client: partial matches
      [next step, start, zone, episode]. Step 0 is an A lookup of a
      zone, steps 1-8 are hex TXT lookups under it, all within
      chain_us of step 0; completion starts over. A background TXT
      that would complete a background-only match is not logged. -#}
  {%- set guard = shared.get('guard') -%}
  {%- set parts = [] -%}
  {%- for p in guard.get(r.c, []) -%}
    {%- if t - p[1] <= chain_us -%}{%- do parts.append(p) -%}{%- endif -%}
  {%- endfor -%}
  {%- set m = namespace(done=none) -%}
  {%- set new = [] -%}
  {%- for p in parts -%}
    {%- if m.done is none -%}
      {%- if r.hex and p[2] == r.zone -%}
        {%- if p[0] == 8 -%}
          {%- set m.done = p -%}
        {%- else -%}
          {%- do new.append([p[0] + 1, p[1], p[2], p[3] or r.ep]) -%}
        {%- endif -%}
      {%- else -%}
        {%- do new.append(p) -%}
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}
  {%- if m.done is not none and not m.done[3] and not r.ep -%}
    {{- dispatch.drop() -}}
  {%- endif -%}
  {%- if m.done is not none -%}
    {%- do guard.pop(r.c, none) -%}
  {%- else -%}
    {%- if r.zone and r.type == 'A' -%}
      {%- do new.append([1, t, r.zone, r.ep]) -%}
    {%- endif -%}
    {%- if new -%}
      {%- do guard.update({r.c: new[-8:]}) -%}
    {%- else -%}
      {%- do guard.pop(r.c, none) -%}
    {%- endif -%}
  {%- endif -%}

  {#- Cache: an answer is served from cache between its arrival and
      its expiry; the cache holds at most 256 entries. -#}
  {%- set cache = shared.get('cache') -%}
  {%- set key = r.name ~ '|' ~ r.type -%}
  {%- set hit = cache.get(key) -%}
  {%- if hit and hit[0] <= t < hit[1] -%}
    {%- set from_cache = 1 -%}
    {%- set latency = 0 -%}
  {%- else -%}
    {%- set from_cache = 0 -%}
    {%- set latency = [module.rand.number.lognormal(module.math.log(45000 if r.ext else 12000), 0.8) | int, 300] | max -%}
    {%- if key not in cache and cache | length >= 256 -%}{%- do cache.pop(cache | first) -%}{%- endif -%}
    {%- do cache.update({key: [t + latency, t + latency + r.ttl * 1000000]}) -%}
  {%- endif -%}
  {%- set worker = module.rand.number.integer(0, params.worker_count - 1) -%}
  {{- add(dict(r, reply=true, worker=worker, from_cache=from_cache, latency=latency,
      due=t + latency + module.rand.number.integer(40, 900))) -}}
{%- endif -%}
{%- set worker = r.worker if is_reply else worker -%}

{%- set et = module.datetime.datetime.fromtimestamp(t // 1000000, utc).replace(microsecond=t % 1000000) -%}
{%- set log_clock = et.strftime('%Y-%m-%dT%H:%M:%S.') ~ ('%03d' | format(et.microsecond // 1000)) ~ '+00:00' -%}
{%- set message = ('reply: ' if is_reply else 'query: ') ~ r.c ~ ' ' ~ r.name ~ ' ' ~ r.type ~ ' IN' ~ (
    ' ' ~ r.rcode ~ ' ' ~ ('%d.%06d' | format(r.latency // 1000000, r.latency % 1000000)) ~ ' ' ~ r.from_cache ~ ' ' ~ r.size
    if is_reply else '') -%}
{%- set labels = r.name.rstrip('.').split('.') -%}
{%- set event = {
  '@timestamp': et.strftime('%Y-%m-%dT%H:%M:%S.%f+00:00'),
  'ecs': {'version': '8.17.0'},
  'event': {'kind': 'event', 'category': ['network'], 'type': ['end'] if is_reply else ['start'],
            'action': 'dns-reply' if is_reply else 'dns-query',
            'original': log_clock ~ ' unbound[' ~ params.process_id ~ ':' ~ worker ~ '] ' ~ message},
  'host': {'name': params.host_name},
  'process': {'name': 'unbound', 'pid': params.process_id},
  'source': {'ip': r.c},
  'related': {'ip': [r.c]},
  'dns': {'type': 'answer' if is_reply else 'query',
          'question': {'name': r.name, 'type': r.type, 'class': 'IN',
                       'registered_domain': labels[-2:] | join('.')},
          'response_code': r.rcode if is_reply else none},
  'unbound': {'worker_id': worker,
              'reply': {'time_to_resolve': r.latency / 1000000, 'from_cache': r.from_cache,
                        'response_size': r.size} if is_reply else none}
} -%}
{{- event | tojson -}}
