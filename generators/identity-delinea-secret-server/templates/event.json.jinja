{%- set step = vars.step -%}
{%- set chain = step.startswith('chain_view_') -%}
{%- if step == 'routine_a' -%}
  {%- do shared.pop('to_chain', none) -%}
  {%- set count = shared.get('routine_count', 0) + 1 -%}
  {%- if count >= params.anomaly_interval_events -%}
    {%- do shared.set('routine_count', 0) -%}
    {%- if params.anomaly_mode -%}{%- do shared.set('to_chain', true) -%}{%- endif -%}
  {%- else -%}{%- do shared.set('routine_count', count) -%}{%- endif -%}
{%- endif -%}
{%- if chain -%}
  {%- set index = step[-1]|int -%}
  {%- set secret_names = ['Domain Controller Admin', 'Backup Vault Root', 'Firewall Breakglass', 'Database Admin', 'Cloud Tenant Root'] -%}
  {%- set secret_name = secret_names[index - 1] -%}
  {%- set secret_id = 700 + index -%}
  {%- set user_name = params.chain_user -%}
  {%- set display_name = 'Privileged Auditor' -%}
  {%- set user_id = params.chain_user_id -%}
  {%- set source_ip = params.chain_source_ip -%}
  {%- set folder_name = params.chain_folder -%}
  {%- set folder_id = params.chain_folder_id -%}
{%- else -%}
  {%- set secrets = [
    {'id':12,'name':'Service Desk Portal','folder':'Operations','folder_id':11},
    {'id':23,'name':'Test Database Reader','folder':'Application','folder_id':12},
    {'id':34,'name':'Monitoring API','folder':'Monitoring','folder_id':13},
    {'id':45,'name':'Helpdesk Rotation','folder':'Operations','folder_id':11}
  ] -%}
  {%- set actors = [
    {'id':21,'name':'helpdesk-a','display':'Helpdesk A','ip':'10.20.10.21'},
    {'id':22,'name':'app-operator','display':'Application Operator','ip':'10.20.10.22'},
    {'id':31,'name':'monitoring-svc','display':'Monitoring Service','ip':'10.20.11.31'},
    {'id':32,'name':'db-reader','display':'Database Reader','ip':'10.20.11.32'}
  ] -%}
  {%- set routine_index = shared.get('routine_count', 0) -%}
  {%- if routine_index % 10 == 0 -%}
    {%- set selected = (routine_index // 10) % 5 -%}
    {%- set secret = {'id':701 + selected,'name':['Domain Controller Admin','Backup Vault Root','Firewall Breakglass','Database Admin','Cloud Tenant Root'][selected],'folder':params.chain_folder,'folder_id':params.chain_folder_id} -%}
    {%- set actor = {'id':params.chain_user_id,'name':params.chain_user,'display':'Privileged Auditor','ip':params.chain_source_ip} -%}
  {%- else -%}
    {%- set secret = module.rand.choice(secrets) -%}
    {%- set actor = module.rand.choice(actors) -%}
  {%- endif -%}
  {%- set secret_name = secret.name -%}
  {%- set secret_id = secret.id -%}
  {%- set user_name = actor.name -%}
  {%- set user_id = actor.id -%}
  {%- set display_name = actor.display -%}
  {%- set source_ip = actor.ip -%}
  {%- set folder_name = secret.folder -%}
  {%- set folder_id = secret.folder_id -%}
{%- endif -%}
{%- set receipt_time = timestamp.strftime('%b %d %Y %H:%M:%S') -%}
{%- set message = '[[SecretServer]] Event: [Secret] Action: [View] By User: ' ~ user_name ~ ' Item Name: ' ~ secret_name ~ ' (Item Id: ' ~ secret_id ~ ') Container Name: ' ~ folder_name ~ ' (Container Id: ' ~ folder_id ~ ')' -%}
{%- set extension = {'msg':message,'suid':user_id|string,'suser':user_name,'cs4':display_name,'cs4Label':'suser Display Name','src':source_ip,'rt':receipt_time,'fname':secret_name,'fileType':'Secret','fileId':secret_id|string,'cs3Label':'Folder','cs3':folder_name} -%}
{%- set parts = [] -%}
{%- for key, value in extension.items() -%}{%- if key != 'msg' -%}{%- do parts.append(key ~ '=' ~ value) -%}{%- endif -%}{%- endfor -%}
{%- set raw = timestamp.strftime('%b %d %H:%M:%S') ~ ' ' ~ params.server_host ~ ' CEF:0|Thycotic Software|Secret Server|' ~ params.device_version ~ '|10004|SECRET - VIEW|2|msg=' ~ message ~ '  ' ~ parts|join(' ') -%}
{%- set cef = {'version':0,'vendor':'Thycotic Software','product':'Secret Server','device_version':params.device_version,'class_id':'10004','name':'SECRET - VIEW','severity':2,'extension':extension} -%}
{%- set out = {'@timestamp':timestamp.isoformat(),'ecs':{'version':'8.17.0'},'event':{'action':'secret-view','category':['iam'],'code':'10004','dataset':'thycotic_ss.logs','kind':'event','original':raw,'type':['access']},'host':{'name':params.server_host},'observer':{'hostname':params.server_host,'product':'Secret Server','vendor':'Thycotic Software','version':params.device_version},'source':{'ip':source_ip},'user':{'name':user_name,'id':user_id|string,'full_name':display_name},'related':{'hosts':[params.server_host],'ip':[source_ip],'user':[user_name]},'thycotic_ss':{'event':{'secret':{'id':secret_id|string,'name':secret_name,'folder':folder_name,'folder_id':folder_id|string}},'cef':cef}} -%}
{{- out | tojson -}}
