{#- One Secret Server 11.3 instance sending SECRET - VIEW audit records
    over syslog/CEF. Each one-second tick emits at most one record: the
    earliest due view. People and automation accounts open secrets as
    independent random processes; the anomaly episode only queues its
    own views for one administrator and never touches the background. -#}
{%- set now = timestamp.timestamp() | int -%}
{%- set utc = module.datetime.timezone.utc -%}
{%- set interval = params.anomaly_interval_hours | float -%}
{%- set guard_s = 1800 -%}
{%- set tier0 = 'Tier 0 - Infrastructure' -%}
{%- set folders = {
    tier0: ['Domain Admin - ' ~ params.domain ~ '\\da.breakglass', 'KRBTGT Reset Account',
      'DC01 DSRM Password', 'DC02 DSRM Password', 'ESXi root - esx-cl01',
      'vCenter administrator@vsphere.local', 'Backup Vault Root - vbr01',
      'Firewall Breakglass - fw-edge-01', 'Entra ID Global Admin - breakglass',
      'PKI Root CA Local Admin', 'SCCM Network Access Account', 'Entra Connect Sync Account'],
    'Databases': ['SQL sa - sql-prd-01', 'SQL sa - sql-prd-02', 'Oracle SYS - ora-fin-01',
      'PostgreSQL postgres - pg-app-01', 'MongoDB admin - mdb-01', 'SQL Reporting Service Account'],
    'Network Devices': ['Core Switch enable - sw-core-01', 'Core Switch enable - sw-core-02',
      'WLC admin - wlc-01', 'VPN Gateway admin - vpn-01', 'Load Balancer admin - lb-01'],
    'Service Desk': ['Service Desk Portal Admin', 'Workstation Local Admin',
      'Printer Management Console', 'Meeting Room Kiosk'],
    'Applications': ['Jenkins API Token', 'GitLab Deploy Key - billing', 'Payments API Key - staging',
      'SMTP Relay Account', 'Monitoring API - zabbix', 'Jira Integration User']} -%}
{%- set people = [
    ['J.Smith', 'John Smith', 'admin'], ['M.Brown', 'Maria Brown', 'admin'],
    ['A.Kowalski', 'Adam Kowalski', 'admin'], ['D.Lee', 'David Lee', 'admin'],
    ['E.Novak', 'Eva Novak', 'admin'], ['R.Kumar', 'Ravi Kumar', 'admin'],
    ['S.Berg', 'Sofia Berg', 'admin'],
    ['L.Rossi', 'Luca Rossi', 'dba'], ['T.Nguyen', 'Tran Nguyen', 'dba'],
    ['H.Muller', 'Hanna Muller', 'dba'], ['O.Ivanov', 'Oleg Ivanov', 'dba'],
    ['P.Dubois', 'Pierre Dubois', 'network'], ['W.Taylor', 'Will Taylor', 'network'],
    ['Y.Hoffmann', 'Yvonne Hoffmann', 'network'], ['K.Wilson', 'Kate Wilson', 'network'],
    ['B.Clark', 'Ben Clark', 'helpdesk'], ['C.Davis', 'Chloe Davis', 'helpdesk'],
    ['G.White', 'Grace White', 'helpdesk'], ['N.Silva', 'Nuno Silva', 'helpdesk'],
    ['F.Garcia', 'Fernando Garcia', 'helpdesk'], ['I.Khan', 'Imran Khan', 'helpdesk'],
    ['V.Moreau', 'Victor Moreau', 'helpdesk'], ['Z.Lopez', 'Zoe Lopez', 'helpdesk'],
    ['M.Chen', 'Mei Chen', 'devops'], ['J.Young', 'Jack Young', 'devops'],
    ['K.Morgan', 'Kim Morgan', 'devops'], ['L.Walker', 'Liam Walker', 'devops'],
    ['N.Ward', 'Nora Ward', 'devops']] -%}
{%- set robots = [['svc.ansible', 'Ansible Automation', 'svc'],
    ['svc.jenkins', 'Jenkins Pipelines', 'svc']] -%}
{%- set role_folders = {
    'admin': [[tier0, 'Databases', 'Network Devices', 'Applications', 'Service Desk', 'personal'],
      [20, 8, 8, 8, 6, 50]],
    'dba': [['Databases', 'Applications', 'personal'], [65, 10, 25]],
    'network': [['Network Devices', tier0, 'personal'], [70, 6, 24]],
    'helpdesk': [['Service Desk', 'personal'], [75, 25]],
    'devops': [['Applications', 'Databases', 'personal'], [65, 10, 25]]} -%}

{#- Background load by UTC hour (office hours, evening, night). -#}
{%- macro curve(hh) -%}{{ 1.6 if 7 <= hh < 17 else (0.7 if 17 <= hh < 21 else 0.25) }}{%- endmacro -%}

{#- Episode start: a second drawn from [a, b), clock-hour slots weighted
    by the background load of their hour (squared plus a small floor
    when sq) and by their length, uniform inside the chosen slot. -#}
{%- macro draw(a, b, sq) -%}
  {%- set slots = [] -%}{%- set sw = [] -%}
  {%- for k in range((b - a) // 3600 + 2) -%}
    {%- set lo = [a - a % 3600 + k * 3600, a] | max -%}
    {%- set hi = [a - a % 3600 + (k + 1) * 3600, b] | min -%}
    {%- if hi > lo -%}
      {%- set f = curve(module.datetime.datetime.fromtimestamp(lo, utc).hour) | float -%}
      {%- do slots.append([lo, hi]) -%}
      {%- do sw.append(((f * f + 0.02) if sq else f) * (hi - lo)) -%}
    {%- endif -%}
  {%- endfor -%}
  {%- set slot = module.rand.weighted_choice(slots, sw) -%}
  {{- module.random.randint(slot[0], slot[1] - 1) -}}
{%- endmacro -%}

{%- if not shared.get('initialized', false) -%}
  {%- if not (2 <= interval <= 8760) -%}{{ module.math.sqrt(-1) }}{%- endif -%}
  {#- One fixed organisation: IDs, addresses, per-user activity and
      per-secret popularity come from a fixed seed, so every run models
      the same instance and only behaviour is random. -#}
  {%- set rnd = module.random.Random(3104) -%}
  {%- set ids = rnd.sample(range(3, 900), people | length + robots | length) -%}
  {%- set hosts = rnd.sample(range(20, 240), people | length) -%}
  {%- set fids = rnd.sample(range(8, 400), 5 + people | length) -%}
  {%- set sids = rnd.sample(range(10, 6000), 40 + people | length) -%}
  {%- set users = {} -%}
  {%- set secrets = {} -%}
  {%- set k = namespace(f=0, s=0) -%}
  {%- for name, items in folders.items() -%}
    {%- set fid = fids[k.f] -%}{%- set k.f = k.f + 1 -%}
    {%- set rows = [] -%}
    {%- for item in items -%}
      {%- do rows.append([sids[k.s], item, name, fid]) -%}{%- set k.s = k.s + 1 -%}
    {%- endfor -%}
    {%- set w = [] -%}
    {%- for r in rows -%}{%- do w.append(rnd.lognormvariate(0, 0.8)) -%}{%- endfor -%}
    {%- do secrets.update({name: [rows, w]}) -%}
  {%- endfor -%}
  {%- for p in people -%}
    {%- set i = loop.index0 -%}
    {%- set subnet = '10.20.5.' if p[2] in ['admin', 'network', 'dba'] else '10.20.12.' -%}
    {%- set item = p[1] ~ (' Personal Admin Account - ' ~ params.domain ~ '\\adm.'
        ~ p[0] | lower | replace('.', '') if p[2] in ['admin', 'network', 'dba']
        else ' Personal Credentials') -%}
    {%- do users.update({p[0]: {'id': ids[i], 'display': p[1], 'role': p[2],
        'ip': subnet ~ hosts[i], 'weight': rnd.lognormvariate(0, 0.7),
        'personal': [sids[k.s], item, p[1], fids[k.f]]}}) -%}
    {%- set k.f = k.f + 1 -%}{%- set k.s = k.s + 1 -%}
  {%- endfor -%}
  {%- for r in robots -%}
    {%- do users.update({r[0]: {'id': ids[people | length + loop.index0], 'display': r[1],
        'role': 'svc', 'ip': '10.20.40.' ~ (11 + loop.index0), 'weight': 1.0,
        'personal': none}}) -%}
  {%- endfor -%}
  {%- do shared.update({'initialized': true, 'users': users, 'secrets': secrets,
      'q': [], 'runs': {}, 'last_user': none, 'last_first': none,
      'start_at': draw(now, (now + ([interval, 24] | min) * 3600) | int, false) | int}) -%}
{%- endif -%}
{%- set users = shared.get('users') -%}
{%- set secrets = shared.get('secrets') -%}
{%- set q = shared.get('q') -%}
{%- set runs = shared.get('runs') -%}
{%- set load = (curve(timestamp.astimezone(utc).hour) | float) / 0.89 -%}

{%- macro gap(median, sigma) -%}
{{- [(module.rand.number.lognormal(module.math.log(median), sigma)) | round | int, 1] | max -}}
{%- endmacro -%}

{%- macro view(user, secret, at, episode=false) -%}
  {%- do q.append({'due': at, 'user': user, 'secret': secret, 'episode': episode}) -%}
{%- endmacro -%}

{#- A session: n views by one user, random gaps; each view either
    re-opens the previous secret or picks a new one from a folder. -#}
{%- macro session(user, n, median, sigma, stay, fl, fw) -%}
  {%- set t = namespace(at=now, s=none) -%}
  {%- for i in range(n) -%}
    {%- if i > 0 -%}{%- set t.at = t.at + gap(median, sigma) | int -%}{%- endif -%}
    {%- if t.s is none or not module.rand.chance(stay) -%}
      {%- set f = module.rand.weighted_choice(fl, fw) -%}
      {%- set t.s = users[user].personal if f == 'personal'
          else module.rand.weighted_choice(secrets[f][0], secrets[f][1]) -%}
    {%- endif -%}
    {{- view(user, t.s, t.at) -}}
  {%- endfor -%}
{%- endmacro -%}

{#- 1. People: one merged Poisson stream of independent users, weighted
    per user, modulated by office hours. -#}
{%- if module.rand.chance(0.009 * load) -%}
  {%- set names = [] -%}{%- set weights = [] -%}
  {%- for name, info in users.items() if info.role != 'svc' -%}
    {%- do names.append(name) -%}{%- do weights.append(info.weight) -%}
  {%- endfor -%}
  {%- set u = module.rand.weighted_choice(names, weights) -%}
  {%- set role = users[u].role -%}
  {%- if role == 'admin' and module.rand.chance(0.25) -%}
    {#- Infrastructure work: several Tier 0 credentials in a row. -#}
    {{- session(u, module.rand.weighted_choice([2, 3, 4, 5, 6, 7, 8, 9],
        [16, 18, 17, 14, 12, 10, 7, 6]), 35, 1.0, 0.25, [tier0, 'personal'], [85, 15]) -}}
  {%- else -%}
    {%- set rf = role_folders[role] -%}
    {{- session(u, module.rand.weighted_choice([1, 2, 3, 4, 5, 6], [40, 24, 14, 9, 7, 6]),
        40, 1.2, 0.3, rf[0], rf[1]) -}}
  {%- endif -%}
{%- endif -%}

{#- 2. Automation accounts fetch application secrets at any hour. -#}
{%- if module.rand.chance(0.002) -%}
  {{- session(module.rand.choice(['svc.ansible', 'svc.jenkins']),
      module.rand.weighted_choice([1, 2, 3, 4, 5, 6], [30, 22, 18, 12, 10, 8]),
      2, 0.7, 0.1, ['Applications'], [1]) -}}
{%- endif -%}

{#- 3. Episode, by source time. The first start is drawn within the
    first min(interval, 24 h) by the load curve; each later one within
    w = min(interval / 4, 6 h) centred on its due time (previous actual
    start + interval), by load squared plus a floor. The administrator
    is any but the previous episode's, by the background weights. -#}
{%- set ep = namespace(cand=[], w=[]) -%}
{%- if params.anomaly_mode and now >= shared.get('start_at') -%}
  {%- for name, info in users.items() -%}
    {%- if info.role == 'admin' and name != shared.get('last_user') -%}
      {%- set ep.cand = ep.cand + [name] -%}{%- set ep.w = ep.w + [info.weight] -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}
{%- if ep.cand -%}
  {%- set u = module.rand.weighted_choice(ep.cand, ep.w) -%}
  {%- set pool = secrets[tier0][0] -%}
  {%- set chosen = module.random.sample(pool, 5) -%}
  {%- if chosen[0][1] == shared.get('last_first') -%}
    {%- set chosen = chosen[1:] + chosen[:1] -%}
  {%- endif -%}
  {%- set t = namespace(at=now, seen=[]) -%}
  {%- for s in chosen -%}
    {%- if not loop.first -%}{%- set t.at = t.at + gap(35, 1.0) | int -%}{%- endif -%}
    {{- view(u, s, t.at, true) -}}
    {%- do t.seen.append(s) -%}
    {#- Like ordinary infrastructure work, some secrets are re-opened. -#}
    {%- if not loop.last and module.rand.chance(0.25) -%}
      {%- set t.at = t.at + gap(35, 1.0) | int -%}
      {{- view(u, module.rand.choice(t.seen), t.at, true) -}}
    {%- endif -%}
  {%- endfor -%}
  {%- set due = now + (interval * 3600) | int -%}
  {%- set w = ([interval / 4, 6] | min) * 3600 -%}
  {%- do shared.update({'last_user': u, 'last_first': chosen[0][1],
      'start_at': draw((due - w / 2) | int, (due + w / 2) | int, true) | int}) -%}
{%- endif -%}

{#- 4. Emit the earliest due view, otherwise nothing. -#}
{%- set sel = namespace(i=-1, due=now + 1) -%}
{%- for e in q -%}
  {%- if e.due <= now and e.due < sel.due -%}
    {%- set sel.i = loop.index0 -%}{%- set sel.due = e.due -%}
  {%- endif -%}
{%- endfor -%}
{%- if sel.i < 0 -%}{{ dispatch.drop() }}{%- endif -%}
{%- set e = q.pop(sel.i) -%}
{%- set user_name = e.user -%}
{%- set info = users[user_name] -%}
{%- set secret = e.secret -%}

{#- Guard on the final chain step only: the distinct Tier 0 secrets a
    user viewed in the last guard_s seconds (a true sliding window).
    An ordinary view that would be the fifth re-opens one of the four
    instead, at the same time. A fifth distinct secret (episode only)
    completes the pattern and starts the count afresh; the episode's
    remaining views are ordinary from then on. -#}
{%- if secret[2] == tier0 -%}
  {%- set win = runs.get(user_name, []) | selectattr('0', 'ge', now - guard_s) | list -%}
  {%- set ids = win | map(attribute='1') | unique | list -%}
  {%- if not e.episode and secret[0] not in ids and ids | length >= 4 -%}
    {%- set again = module.rand.choice(ids) -%}
    {%- set secret = secrets[tier0][0] | selectattr('0', 'equalto', again) | first -%}
  {%- endif -%}
  {%- do win.append([now, secret[0]]) -%}
  {%- if win | map(attribute='1') | unique | list | length >= 5 -%}
    {%- do runs.pop(user_name, none) -%}
    {%- for x in q if x.user == user_name -%}{%- do x.update({'episode': false}) -%}{%- endfor -%}
  {%- else -%}
    {%- do runs.update({user_name: win}) -%}
  {%- endif -%}
{%- endif -%}

{%- set occurred = module.datetime.datetime.fromtimestamp(now, utc) -%}
{%- set sent = module.datetime.datetime.fromtimestamp(now + gap(3, 0.9) | int, utc) -%}
{%- set rt = occurred.strftime('%b %d %Y %H:%M:%S') -%}
{%- set header = sent.strftime('%b ') ~ ('%2d' | format(sent.day)) ~ sent.strftime(' %H:%M:%S') -%}
{%- set msg = '[[SecretServer]] Event: [Secret] Action: [View] By User: ' ~ user_name
  ~ ' Item Name: ' ~ secret[1] ~ ' (Item Id: ' ~ secret[0] ~ ') Container Name: '
  ~ secret[2] ~ ' (Container Id: ' ~ secret[3] ~ ')' -%}
{%- set raw = header ~ ' ' ~ params.server_host ~ ' CEF:0|Thycotic Software|Secret Server|'
  ~ params.device_version ~ '|10004|SECRET - VIEW|2|msg=' ~ msg ~ '  suid=' ~ info.id
  ~ ' suser=' ~ user_name ~ ' cs4=' ~ info.display ~ ' cs4Label=suser Display Name src='
  ~ info.ip ~ ' rt=' ~ rt ~ ' fname=' ~ secret[1] ~ ' fileType=Secret fileId=' ~ secret[0]
  ~ ' cs3Label=Folder cs3=' ~ secret[2] -%}
{%- set record = {'@timestamp': sent.strftime('%Y-%m-%dT%H:%M:%S.000Z'),
  'ecs': {'version': '8.11.0'},
  'event': {'action': 'view', 'category': ['iam'], 'code': '10004',
    'dataset': 'thycotic_ss.logs', 'kind': 'event', 'original': raw,
    'provider': 'secret', 'type': ['info']},
  'host': {'name': params.server_host},
  'message': msg,
  'observer': {'hostname': params.server_host, 'product': 'Secret Server',
    'vendor': 'Thycotic Software', 'version': params.device_version},
  'related': {'hosts': [params.server_host], 'ip': [info.ip], 'user': [user_name]},
  'source': {'ip': info.ip},
  'thycotic_ss': {'event': {'secret': {'folder': secret[2], 'id': secret[0] | string,
    'name': secret[1]}, 'time': occurred.strftime('%Y-%m-%dT%H:%M:%S.000Z')}},
  'user': {'full_name': info.display, 'id': info.id | string, 'name': user_name}} -%}
{{ record | tojson }}
