{#- One Secret Server 11.3 instance sending SECRET - VIEW audit records
    over syslog/CEF. Every input timestamp is one record. A staff
    timestamp emits a due episode view, else the earliest due view of a
    running session, or else starts a new session and emits its first
    view; a job timestamp is the next secret of that scheduled
    automation job. The anomaly episode queues its own views for one
    administrator next to the background sessions and never cancels or
    moves them. -#}
{%- set now = timestamp.timestamp() | int -%}
{%- set utc = module.datetime.timezone.utc -%}
{%- set interval = params.anomaly_interval_hours | float -%}
{%- set window_s = 1800 -%}
{%- set tier0 = 'Tier 0 - Infrastructure' -%}
{%- set role_folders = {
    'admin': [[tier0, 'Databases', 'Network Devices', 'Applications', 'Service Desk', 'personal'],
      [20, 8, 8, 8, 6, 50]],
    'dba': [['Databases', 'Applications', 'personal'], [65, 10, 25]],
    'network': [['Network Devices', tier0, 'personal'], [70, 6, 24]],
    'helpdesk': [['Service Desk', 'personal'], [75, 25]],
    'devops': [['Applications', 'Databases', 'personal'], [65, 10, 25]]} -%}

{#- Staff volume by UTC hour (office hours, evening, night); the same
    shape as the staff time patterns. -#}
{%- macro curve(hh) -%}{{ 1.6 if 7 <= hh < 17 else (0.7 if 17 <= hh < 21 else 0.25) }}{%- endmacro -%}

{#- Episode start: a second drawn from [a, b), clock-hour slots weighted
    by the staff volume of their hour squared plus a small floor and by
    their length, uniform inside the chosen slot. -#}
{%- macro draw(a, b) -%}
  {%- set slots = [] -%}{%- set sw = [] -%}
  {%- for k in range((b - a) // 3600 + 2) -%}
    {%- set lo = [a - a % 3600 + k * 3600, a] | max -%}
    {%- set hi = [a - a % 3600 + (k + 1) * 3600, b] | min -%}
    {%- if hi > lo -%}
      {%- set f = curve(module.datetime.datetime.fromtimestamp(lo, utc).hour) | float -%}
      {%- do slots.append([lo, hi]) -%}
      {%- do sw.append((f * f + 0.02) * (hi - lo)) -%}
    {%- endif -%}
  {%- endfor -%}
  {%- set slot = module.rand.weighted_choice(slots, sw) -%}
  {{- module.random.randint(slot[0], slot[1] - 1) -}}
{%- endmacro -%}

{%- if not shared.get('initialized', false) -%}
  {%- if not (2 <= interval <= 8760) -%}{{ module.math.sqrt(-1) }}{%- endif -%}
  {#- The organisation (accounts, addresses, activity weights, secrets
      and their popularity, automation jobs) comes from samples/. -#}
  {%- set secrets = {} -%}
  {%- set byid = {} -%}
  {%- for i in range(samples.secrets | length) -%}
    {%- set r = samples.secrets[i] -%}
    {%- set row = [r.secret_id | int, r.name | replace('{domain}', params.domain), r.folder,
        r.folder_id | int] -%}
    {%- if r.folder not in secrets -%}{%- do secrets.update({r.folder: [[], [], []]}) -%}{%- endif -%}
    {%- do secrets[r.folder][0].append(row) -%}
    {%- do secrets[r.folder][2].append(r.popularity | float) -%}
    {%- do byid.update({row[0]: row}) -%}
  {%- endfor -%}
  {%- for f in secrets -%}
    {%- do secrets[f][1].extend(module.itertools.accumulate(secrets[f][2])) -%}
  {%- endfor -%}
  {%- set users = {} -%}
  {%- set people = [] -%}{%- set pw = [] -%}
  {%- set admins = [] -%}
  {%- for i in range(samples.users | length) -%}
    {%- set r = samples.users[i] -%}
    {%- set personal = none -%}
    {%- if r.role != 'svc' -%}
      {%- set item = r.display_name ~ (' Personal Admin Account - ' ~ params.domain ~ '\\adm.'
          ~ r.username | lower | replace('.', '') if r.role in ['admin', 'network', 'dba']
          else ' Personal Credentials') -%}
      {%- set personal = [r.personal_id | int, item, r.display_name, r.personal_folder_id | int] -%}
      {%- do people.append(r.username) -%}{%- do pw.append(r.weight | float) -%}
      {%- if r.role == 'admin' -%}{%- do admins.append(r.username) -%}{%- endif -%}
    {%- endif -%}
    {%- do users.update({r.username: {'id': r.user_id | int, 'display': r.display_name,
        'role': r.role, 'ip': r.ip, 'weight': r.weight | float, 'personal': personal}}) -%}
  {%- endfor -%}
  {%- set jobs = {} -%}
  {%- for i in range(samples.jobs | length) -%}
    {%- set r = samples.jobs[i] -%}
    {%- if r.job not in jobs -%}{%- do jobs.update({r.job: []}) -%}{%- endif -%}
    {%- do jobs[r.job].append([r.username, byid[r.secret_id | int]]) -%}
  {%- endfor -%}
  {%- do shared.update({'initialized': true, 'users': users, 'secrets': secrets, 'byid': byid,
      'people': people, 'pcum': module.itertools.accumulate(pw) | list, 'admins': admins,
      'jobs': jobs, 'cursor': {}, 'q': [], 'eq': [], 'ctr': {'n': 0}, 'runs': {}, 'ep': none,
      'last_user': none, 'last_first': none, 'last_set': [], 'arm': none,
      'start_at': draw(now, (now + ([interval, 24] | min) * 3600) | int) | int,
      'start_end': (now + ([interval, 24] | min) * 3600) | int}) -%}
{%- endif -%}
{%- set users = shared.get('users') -%}
{%- set secrets = shared.get('secrets') -%}
{%- set q = shared.get('q') -%}
{%- set eq = shared.get('eq') -%}
{%- set ctr = shared.get('ctr') -%}
{%- set runs = shared.get('runs') -%}

{%- macro gap(median, sigma) -%}
{{- [(module.rand.number.lognormal(module.math.log(median), sigma)) | round | int, 1] | max -}}
{%- endmacro -%}

{#- Inverse CDF from 21 quantiles (0%, 5%, ..., 100%), linear inside a
    step. -#}
{%- macro qdraw(tab) -%}
  {%- set x = module.random.random() * 20 -%}{%- set i = x | int -%}
  {{- [(tab[i] + (tab[i + 1] - tab[i]) * (x - i)) | round | int, 1] | max -}}
{%- endmacro -%}

{#- Timing of ordinary runs of four distinct Tier 0 secrets by one user,
    in seconds: from the last view of another Tier 0 secret before the
    run to its first view (without / with an earlier view of the first
    secret), from that earlier view to the first view (after other
    Tier 0 work / without it), and from the first view to the fourth
    distinct secret. -#}
{%- set ogap_alone = [1, 11, 17, 24, 32, 39, 47, 59, 78, 92, 112, 146, 197, 349, 553, 947, 1154, 1407, 1617, 1713, 1797] -%}
{%- set ogap_same = [1, 22, 39, 53, 67, 91, 105, 131, 159, 187, 248, 300, 512, 645, 897, 1127, 1275, 1441, 1572, 1685, 1799] -%}
{%- set sgap_busy = [1, 8, 14, 19, 23, 29, 35, 41, 47, 53, 61, 68, 77, 94, 111, 161, 249, 376, 935, 1420, 1799] -%}
{%- set sgap_idle = [1, 11, 14, 20, 23, 26, 29, 34, 39, 43, 49, 56, 68, 76, 86, 100, 116, 143, 200, 486, 1797] -%}
{%- set span4 = [11, 82, 103, 125, 145, 167, 189, 209, 234, 264, 294, 340, 399, 469, 587, 745, 960, 1187, 1423, 1622, 1800] -%}

{%- macro pick(folder) -%}
{{- module.random.choices(secrets[folder][0], cum_weights=secrets[folder][1])[0][0] -}}
{%- endmacro -%}

{%- macro push(user, secret, at, episode=false) -%}
  {%- do ctr.update({'n': ctr.n + 1}) -%}
  {%- do module.heapq.heappush(eq if episode else q, [at, ctr.n, user, secret, episode]) -%}
{%- endmacro -%}

{#- A session: n views by one user, random gaps; each view either
    re-opens the previous secret or picks a new one from a folder. -#}
{%- macro session(user, n, median, sigma, stay, fl, fw) -%}
  {%- set t = namespace(at=now, s=none) -%}
  {%- for i in range(n) -%}
    {%- if i > 0 -%}{%- set t.at = t.at + gap(median, sigma) | int -%}{%- endif -%}
    {%- if t.s is none or not module.rand.chance(stay) -%}
      {%- set f = module.rand.weighted_choice(fl, fw) -%}
      {%- set t.s = users[user].personal if f == 'personal'
          else shared.get('byid')[pick(f) | int] -%}
    {%- endif -%}
    {{- push(user, t.s, t.at) -}}
  {%- endfor -%}
{%- endmacro -%}

{%- if 'people' in tags -%}
  {#- Episode, by source time. The first start is drawn within the
      first min(interval, 24 h), each later one within w = min(interval
      / 4, 6 h) centred on its due time (previous actual start +
      interval), both by the staff volume curve squared plus a floor.
      The administrator is any but the previous episode's, by the
      background weights. -#}
  {%- if params.anomaly_mode and shared.get('ep') is none and now >= shared.get('start_at') - window_s -%}
    {#- Lead-in, drawn once per episode like the lead-in of ordinary
        runs of four distinct Tier 0 secrets in the same hours: whether
        the administrator viewed other Tier 0 secrets shortly before the
        run (busy) and how long before, and whether the first secret was
        already viewed once shortly before the run. The run starts at
        start_at; a busy episode waits for an administrator whose last
        Tier 0 view is that long ago, at most half an hour and not past
        the start window, then it starts idle. -#}
    {%- set start_at = shared.get('start_at') -%}
    {%- set start_end = shared.get('start_end') -%}
    {%- set arm = shared.get('arm') -%}
    {%- if arm is none or (arm.busy and (now - arm.since > window_s or now > start_end)) -%}
      {%- set day = 7 <= module.datetime.datetime.fromtimestamp([start_at, now] | max, utc).hour < 21 -%}
      {%- set busy = arm is none and module.rand.chance(0.22 if day else 0.18) -%}
      {%- set same = module.rand.chance((0.43 if day else 0.25) if busy else (0.22 if day else 0.2)) -%}
      {%- set lead = namespace(d=0, sg=0, same=same) -%}
      {%- if busy -%}
        {#- The other Tier 0 view comes before the earlier view of the
            first secret. -#}
        {%- set lead.d = qdraw(ogap_same if same else ogap_alone) | int -%}
        {%- if same -%}
          {%- set lead.sg = lead.d -%}
          {%- for attempt in range(20) -%}
            {%- if lead.sg >= lead.d -%}{%- set lead.sg = qdraw(sgap_busy) | int -%}{%- endif -%}
          {%- endfor -%}
          {%- if lead.sg >= lead.d -%}{%- set lead.same = false -%}{%- set lead.sg = 0 -%}{%- endif -%}
        {%- endif -%}
      {%- elif same -%}
        {%- set lead.sg = qdraw(sgap_idle) | int -%}
        {%- if arm is not none and now + lead.sg > start_end -%}
          {%- set lead.same = false -%}{%- set lead.sg = 0 -%}
        {%- endif -%}
      {%- endif -%}
      {%- set arm = {'busy': busy, 'same': lead.same, 'd': lead.d, 'sg': lead.sg,
          'since': start_at - lead.sg if arm is none else now} -%}
      {%- do shared.set('arm', arm) -%}
    {%- endif -%}
    {#- Candidates: no Tier 0 view due in a running session; busy: the
        last Tier 0 view the lead-in time ago and at most three distinct
        Tier 0 secrets in the last half hour; idle: no Tier 0 view in
        the last half hour. -#}
    {%- set cand = namespace(u=[], w=[], rec=[]) -%}
    {%- if now >= arm.since -%}
      {%- set qt = [] -%}
      {%- for it in q -%}{%- if it[3][2] == tier0 -%}{%- do qt.append(it[2]) -%}{%- endif -%}{%- endfor -%}
      {%- for a in shared.get('admins') if a != shared.get('last_user') and a not in qt -%}
        {%- set win = runs.get(a, []) | selectattr('0', 'ge', now - window_s) | list -%}
        {%- set ids = win | map(attribute='1') | unique | list -%}
        {%- if arm.busy and win and ids | length <= 3
            and arm.d - arm.sg <= now - win[-1][0] <= arm.d - arm.sg + 30 -%}
          {%- do cand.u.append(a) -%}{%- do cand.w.append(users[a].weight) -%}{%- do cand.rec.append(ids) -%}
        {%- elif not arm.busy and not win -%}
          {%- do cand.u.append(a) -%}{%- do cand.w.append(users[a].weight) -%}{%- do cand.rec.append([]) -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}
    {%- if cand.u -%}
      {%- set j = module.random.choices(range(cand.u | length), weights=cand.w)[0] -%}
      {%- set u = cand.u[j] -%}{%- set rec = cand.rec[j] -%}
      {#- Five distinct secrets: the first and the fifth new, the middle
          three the administrator's current ones plus new ones; new ones
          drawn by the background popularity, the set and the first one
          differing from the previous episode's. -#}
      {%- set pool = namespace(rows=[], w=[], new=[]) -%}
      {%- for r in secrets[tier0][0] -%}
        {%- if r[0] not in rec -%}
          {%- do pool.rows.append(r) -%}{%- do pool.w.append(secrets[tier0][2][loop.index0]) -%}
        {%- endif -%}
      {%- endfor -%}
      {%- for i in range(5 - rec | length) -%}
        {%- set j = module.random.choices(range(pool.rows | length), weights=pool.w)[0] -%}
        {%- do pool.new.append(pool.rows.pop(j)) -%}{%- do pool.w.pop(j) -%}
      {%- endfor -%}
      {%- set new = pool.new -%}
      {%- if new[0][0] == shared.get('last_first') -%}
        {%- set new = new[-1:] + new[1:-1] + new[:1] -%}
      {%- endif -%}
      {%- set middle = new[1:-1] -%}
      {%- for sid in rec -%}{%- do middle.append(shared.get('byid')[sid]) -%}{%- endfor -%}
      {%- set chosen = new[:1] + module.random.sample(middle, 3) + new[-1:] -%}
      {%- if chosen | map(attribute='0') | sort | list == shared.get('last_set') -%}
        {%- set j = module.random.choices(range(pool.rows | length), weights=pool.w)[0] -%}
        {%- set chosen = chosen[:4] + [pool.rows[j]] -%}
      {%- endif -%}
      {#- The run starts at x1, after an optional earlier view of its first
          secret. Four distinct secrets with re-opens of all but the
          first, in the order and gaps of the infrastructure-session law,
          stretched so that the fourth distinct one comes as long after
          the first as in ordinary runs. The fifth distinct secret
          follows alone 25-28 minutes after x1 (later only when the run
          is longer), so the first secret leaves the half hour soon
          after the fifth. After that the administrator may go on
          re-opening the other four, as infrastructure work goes on past
          its fourth distinct secret. -#}
      {%- set x1 = now + arm.sg -%}
      {%- set t = namespace(at=0, seen=[], items=[], d4=0) -%}
      {%- for s in chosen[:4] -%}
        {%- if not loop.first -%}{%- set t.at = t.at + gap(35, 1.0) | int -%}{%- endif -%}
        {%- do t.items.append([t.at, s]) -%}
        {%- if loop.last -%}{%- set t.d4 = t.at -%}{%- endif -%}
        {%- if not loop.first -%}{%- do t.seen.append(s) -%}{%- endif -%}
        {%- if t.seen and module.rand.chance(0.25) -%}
          {%- set t.at = t.at + gap(35, 1.0) | int -%}
          {%- do t.items.append([t.at, module.random.choice(t.seen)]) -%}
        {%- endif -%}
      {%- endfor -%}
      {%- set t4 = [qdraw(span4) | int, 1740] | min -%}
      {%- set plan = namespace(items=[[now, chosen[0]]] if arm.same else [], last=x1) -%}
      {%- for it in t.items -%}
        {%- set at = x1 + ((it[0] * t4 / t.d4) | round | int if it[0] <= t.d4 else t4 + it[0] - t.d4) -%}
        {%- if at <= x1 + 1780 -%}
          {%- do plan.items.append([at, it[1]]) -%}{%- set plan.last = at -%}
        {%- endif -%}
      {%- endfor -%}
      {%- set t = namespace(at=x1 + module.random.randint(1500, 1680)) -%}
      {%- if t.at <= plan.last -%}{%- set t.at = [plan.last + gap(35, 1.0) | int, x1 + 1795] | min -%}{%- endif -%}
      {%- do plan.items.append([t.at, chosen[4]]) -%}
      {%- set tail = module.rand.weighted_choice([0, 1, 2, 3, 4, 5, 6], [29, 28, 18, 12, 7, 4, 2]) -%}
      {%- for i in range(tail) -%}
        {%- set t.at = [t.at + gap(35, 1.0) | int, x1 + window_s + 30] | max -%}
        {%- do plan.items.append([t.at, module.random.choice(chosen[1:])]) -%}
      {%- endfor -%}
      {%- for it in plan.items -%}{{- push(u, it[1], it[0], true) -}}{%- endfor -%}
      {%- set due = x1 + (interval * 3600) | int -%}
      {%- set w = ([interval / 4, 6] | min) * 3600 -%}
      {%- do shared.update({'ep': {'user': u, 'done': false, 'left': plan.items | length},
          'last_user': u, 'last_first': chosen[0][0], 'arm': none,
          'last_set': chosen | map(attribute='0') | sort | list,
          'start_at': draw((due - w / 2) | int, (due + w / 2) | int) | int,
          'start_end': (due + w / 2) | int}) -%}
    {%- endif -%}
  {%- endif -%}

  {#- A due episode view goes first; else the earliest due session
      view; nothing due: a person starts a session, picked by activity
      weight. -#}
  {%- if eq and eq[0][0] <= now -%}
    {%- set item = module.heapq.heappop(eq) -%}
  {%- else -%}
    {%- if not q or q[0][0] > now -%}
      {%- set u = module.random.choices(shared.get('people'), cum_weights=shared.get('pcum'))[0] -%}
      {%- set role = users[u].role -%}
      {%- if role == 'admin' and module.rand.chance(0.25) -%}
        {#- Infrastructure work: several Tier 0 credentials in a row. -#}
        {{- session(u, module.rand.weighted_choice([2, 3, 4, 5, 6, 7, 8, 9],
            [16, 18, 17, 14, 12, 10, 7, 6]), 35, 1.0, 0.25, [tier0, 'personal'], [85, 15]) -}}
      {%- else -%}
        {%- set rf = role_folders[role] -%}
        {{- session(u, module.rand.weighted_choice([1, 2, 3, 4, 5, 6], [40, 24, 14, 9, 7, 6]),
            40, 1.2, 0.3, rf[0], rf[1]) -}}
      {%- endif -%}
    {%- endif -%}
    {%- set item = module.heapq.heappop(q) -%}
  {%- endif -%}
{%- else -%}
  {#- A scheduled job fetches its secrets in a fixed order. -#}
  {%- set steps = shared.get('jobs')[tags[0]] -%}
  {%- set cursor = shared.get('cursor') -%}
  {%- set c = cursor.get(tags[0], 0) -%}
  {%- do cursor.update({tags[0]: (c + 1) % (steps | length)}) -%}
  {%- set item = [now, 0, steps[c][0], steps[c][1], false] -%}
{%- endif -%}
{%- set user_name = item[2] -%}
{%- set info = users[user_name] -%}
{%- set secret = item[3] -%}
{%- set epi = shared.get('ep') -%}
{%- set is_step = item[4] and epi is not none and not epi.done -%}
{%- if item[4] and epi is not none -%}{%- do epi.update({'left': epi.left - 1}) -%}{%- endif -%}

{#- Guard on the final chain step only. A Tier 0 view completes the
    pattern when the user viewed four other distinct Tier 0 secrets in
    the last window_s seconds. An episode view may complete it once;
    any other view that would complete it re-opens the user's latest
    Tier 0 secret instead (four distinct in the window), or, while an
    episode's five distinct secrets are still in the window, opens a
    secret from the user's other folders. Same time, same user. -#}
{%- if secret[2] == tier0 -%}
  {%- set win = runs.get(user_name, []) | selectattr('0', 'ge', now - window_s) | list -%}
  {%- set ids = win | map(attribute='1') | unique | list -%}
  {%- if ids | reject('equalto', secret[0]) | list | length >= 4 -%}
    {%- if is_step -%}
      {%- do epi.update({'done': true}) -%}
    {%- elif ids | length == 4 -%}
      {%- set secret = shared.get('byid')[win[-1][1]] -%}
    {%- else -%}
      {%- set rf = role_folders[info.role] -%}
      {%- set fl = [] -%}{%- set fw = [] -%}
      {%- for f in rf[0] -%}
        {%- if f != tier0 -%}{%- do fl.append(f) -%}{%- do fw.append(rf[1][loop.index0]) -%}{%- endif -%}
      {%- endfor -%}
      {%- set f = module.rand.weighted_choice(fl, fw) -%}
      {%- set secret = info.personal if f == 'personal' else shared.get('byid')[pick(f) | int] -%}
    {%- endif -%}
  {%- endif -%}
  {%- if secret[2] == tier0 -%}{%- do win.append([now, secret[0]]) -%}{%- endif -%}
  {%- do runs.update({user_name: win}) -%}
{%- endif -%}
{%- if epi is not none and epi.left <= 0 -%}{%- do shared.set('ep', none) -%}{%- endif -%}

{%- set occurred = module.datetime.datetime.fromtimestamp(now, utc) -%}
{%- set sent = module.datetime.datetime.fromtimestamp(now + gap(3, 0.9) | int, utc) -%}
{%- set rt = occurred.strftime('%b %d %Y %H:%M:%S') -%}
{%- set header = sent.strftime('%b ') ~ ('%2d' | format(sent.day)) ~ sent.strftime(' %H:%M:%S') -%}
{%- set msg = '[[SecretServer]] Event: [Secret] Action: [View] By User: ' ~ user_name
  ~ ' Item Name: ' ~ secret[1] ~ ' (Item Id: ' ~ secret[0] ~ ') Container Name: '
  ~ secret[2] ~ ' (Container Id: ' ~ secret[3] ~ ')' -%}
{%- set raw = header ~ ' ' ~ params.server_host ~ ' CEF:0|Thycotic Software|Secret Server|'
  ~ params.device_version ~ '|10004|SECRET - VIEW|2|msg=' ~ msg ~ '  suid=' ~ info.id
  ~ ' suser=' ~ user_name ~ ' cs4=' ~ info.display ~ ' cs4Label=suser Display Name src='
  ~ info.ip ~ ' rt=' ~ rt ~ ' fname=' ~ secret[1] ~ ' fileType=Secret fileId=' ~ secret[0]
  ~ ' cs3Label=Folder cs3=' ~ secret[2] -%}
{%- set record = {'@timestamp': sent.strftime('%Y-%m-%dT%H:%M:%S.000Z'),
  'ecs': {'version': '8.11.0'},
  'event': {'action': 'view', 'category': ['iam'], 'code': '10004',
    'dataset': 'thycotic_ss.logs', 'kind': 'event', 'original': raw,
    'provider': 'secret', 'type': ['info']},
  'host': {'name': params.server_host},
  'message': msg,
  'observer': {'hostname': params.server_host, 'product': 'Secret Server',
    'vendor': 'Thycotic Software', 'version': params.device_version},
  'related': {'hosts': [params.server_host], 'ip': [info.ip], 'user': [user_name]},
  'source': {'ip': info.ip},
  'thycotic_ss': {'event': {'secret': {'folder': secret[2], 'id': secret[0] | string,
    'name': secret[1]}, 'time': occurred.strftime('%Y-%m-%dT%H:%M:%S.000Z')}},
  'user': {'full_name': info.display, 'id': info.id | string, 'name': user_name}} -%}
{{ record | tojson }}
