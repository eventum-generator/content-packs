{%- from 'templates/_base.json.jinja' import render with context -%}
{%- set flow = shared.get('current') -%}
{%- set native = {'time': timestamp.isoformat(), 'type': 'response',
                  'auth': flow.auth, 'request': flow.request,
                  'response': {'mount_type': flow.request.mount_type,
                               'mount_point': flow.request.mount_point}} -%}
{%- if flow.denied -%}
  {%- do native.update({'error': 'permission denied'}) -%}
{%- elif flow.request.operation == 'read' and flow.request.path.startswith(params.secret_mount ~ '/data/') -%}
  {%- do native.response.update({'data': {'data': {'value': 'hmac-sha256:' ~ module.hashlib.sha256(flow.request.path.encode()).hexdigest()}}}) -%}
{%- endif -%}
{{- render(native, flow.actor, flow.ip) -}}
