{%- set utc = timestamp.astimezone(module.datetime.timezone.utc) -%}
{%- set logged_at = utc.replace(microsecond=module.rand.number.integer(0,999) * 1000) -%}
{%- set step = vars.step -%}
{%- set kind = step -%}
{%- if step == 'routine' -%}
  {%- do shared.pop('to_attack', none) -%}
  {%- if params.anomaly_mode -%}
    {#- Recurrence: the first start is uniform over the first
        min(interval, 24 h) of the run; each next one is uniform in a
        window of width min(interval / 4, 6 h) centred on the actual
        start plus the interval. -#}
    {%- set interval = [params.anomaly_interval_hours | float, 1] | max * 3600 -%}
    {%- set due = shared.get('next_episode_epoch', none) -%}
    {%- if due is none -%}
      {%- do shared.set('next_episode_epoch', utc.timestamp() + module.rand.number.floating(0, [interval, 86400] | min)) -%}
    {%- elif utc.timestamp() >= due -%}
      {%- set half = ([interval / 4, 21600] | min) / 2 -%}
      {%- do shared.set('to_attack', true) -%}
      {%- do shared.set('next_episode_epoch', utc.timestamp() + interval + module.rand.number.floating(-half, half)) -%}
    {%- endif -%}
  {%- endif -%}
  {%- set kind = module.rand.weighted_choice(['get','connect','denied','conditional'], [70,18,7,5]) -%}
{%- endif -%}
{%- set client = samples.clients[0] if module.rand.chance(0.10) else samples.clients.pick() -%}
{%- set resource = samples.restricted.pick() if kind == 'denied' else samples.resources.pick() -%}
{%- set src = params.anomaly_ip if client.target else client.ip -%}
{%- set actor = params.anomaly_user if client.target else client.user -%}
{%- set url = params.anomaly_url if resource.target else resource.url -%}
{%- set origin = params.anomaly_origin_ip if resource.target else resource.origin_ip -%}
{%- set domain = url.split('/')[2].split(':')[0] -%}
{%- set mime = resource.mime -%}
{#- Background reloads of a blocked page: an ordinary 403 denial of a
    named user starts, in 10% of cases, one to four more denials of the
    same user and URL 5-30 s apart. -#}
{%- if step == 'routine' -%}
  {%- set burst = shared.get('deny_burst', none) -%}
  {%- if burst is not none and utc.timestamp() >= burst.due -%}
    {%- set kind = 'denied' -%}
    {%- set src = burst.src -%}{%- set actor = burst.actor -%}{%- set url = burst.url -%}
    {%- set origin = '-' -%}{%- set domain = url.split('/')[2].split(':')[0] -%}
    {%- set resource = {'cacheable': false, 'target': false, 'mime': 'text/html', 'bytes': 1500} -%}
    {%- if burst.left > 1 -%}
      {%- set burst = {'src': src, 'actor': actor, 'url': url, 'left': burst.left - 1, 'due': utc.timestamp() + module.rand.weighted_choice([5, 10, 15, 20, 30], [50, 20, 12, 10, 8]) - 1} -%}
    {%- else -%}
      {%- set burst = none -%}
    {%- endif -%}
  {%- elif burst is none and kind == 'denied' and actor != '-' and module.rand.chance(0.1) -%}
    {%- set burst = {'src': src, 'actor': actor, 'url': url, 'left': module.rand.weighted_choice([1, 2, 3, 4], [50, 25, 15, 10]), 'due': utc.timestamp() + module.rand.weighted_choice([5, 10, 15, 20, 30], [50, 20, 12, 10, 8]) - 1} -%}
  {%- endif -%}
  {%- do shared.set('deny_burst', burst) -%}
{%- endif -%}
{%- set method = 'GET' -%}
{%- set status = 200 -%}
{%- set result = 'TCP_MISS' -%}
{%- set peer = 'HIER_DIRECT' -%}
{%- set peer_host = origin -%}
{%- set duration = module.rand.number.integer(80, 3500) -%}
{%- set variance = module.rand.number.integer(98, 102) if resource.cacheable else module.rand.number.integer(75, 125) -%}
{%- set estimated_bytes = (resource.bytes * variance / 100)|int -%}
{%- set bytes = estimated_bytes if estimated_bytes > 180 else 180 -%}
{%- set cache = shared.get('cache', {}) -%}
{%- for cached_url in cache.keys() | list -%}
  {%- if cache[cached_url].expires_at <= logged_at.timestamp() -%}
    {%- do cache.pop(cached_url) -%}
  {%- endif -%}
{%- endfor -%}
{%- do shared.set('cache', cache) -%}
{#- Guard: an ordinary 200 GET that would complete three denials and
    one 200 GET of the same user and URL, the first denial at most
    chain_window_s earlier, is sent to another URL of the pool at the
    same time. The episode's own last download completes the chain and
    clears the history of its user and URL. -#}
{%- set chain_window_s = 300 -%}
{%- set now_s = logged_at.timestamp() -%}
{%- set history = shared.get('access_history', {}) -%}
{%- set hkey = actor ~ ' ' ~ url -%}
{%- set h = history.get(hkey, {'fails': [], 'armed': none}) -%}
{%- if step == 'routine' and actor != '-' and h.armed is not none and h.armed >= now_s - chain_window_s and (kind == 'get' or (kind == 'conditional' and not (resource.cacheable and url in cache))) -%}
  {%- set others = [] -%}
  {%- for i in range(samples.resources | length) if (params.anomaly_url if samples.resources[i].target else samples.resources[i].url) != url -%}{%- do others.append(samples.resources[i]) -%}{%- endfor -%}
  {%- set resource = module.rand.choice(others) -%}
  {%- set url = params.anomaly_url if resource.target else resource.url -%}
  {%- set origin = params.anomaly_origin_ip if resource.target else resource.origin_ip -%}
  {%- set domain = url.split('/')[2].split(':')[0] -%}
  {%- set mime = resource.mime -%}
  {%- set peer_host = origin -%}
  {%- set variance = module.rand.number.integer(98, 102) if resource.cacheable else module.rand.number.integer(75, 125) -%}
  {%- set estimated_bytes = (resource.bytes * variance / 100)|int -%}
  {%- set bytes = estimated_bytes if estimated_bytes > 180 else 180 -%}
  {%- set hkey = actor ~ ' ' ~ url -%}
  {%- set h = history.get(hkey, {'fails': [], 'armed': none}) -%}
{%- endif -%}
{%- if kind == 'connect' -%}
  {%- set tunnel = samples.tunnels.pick() -%}
  {%- set method = 'CONNECT' -%}{%- set result = 'TCP_TUNNEL' -%}{%- set url = tunnel.hostport -%}
  {%- set domain = tunnel.domain -%}{%- set origin = tunnel.origin_ip -%}
  {%- set peer_host = origin -%}{%- set mime = '-' -%}
  {%- set bytes = module.rand.number.integer(10000, 120000) -%}
  {%- set duration = module.rand.number.integer(800, 12000) -%}
{%- elif kind == 'denied' or step.startswith('deny_') -%}
  {%- set result = 'TCP_DENIED' -%}{%- set peer = 'HIER_NONE' -%}
  {%- set peer_host = '-' -%}{%- set status = 403 if step.startswith('deny_') or actor != '-' else 407 -%}
  {%- set mime = 'text/html' -%}
  {%- set bytes = module.rand.number.integer(1200, 2400) -%}
  {%- set duration = module.rand.number.integer(0, 12) -%}
  {%- if step.startswith('deny_') -%}
    {%- set src = params.anomaly_ip -%}{%- set actor = params.anomaly_user -%}
    {%- set url = params.anomaly_url -%}{%- set origin = params.anomaly_origin_ip -%}
    {%- set domain = url.split('/')[2].split(':')[0] -%}
  {%- endif -%}
{%- elif step.startswith('allowed_') -%}
  {%- set src = params.anomaly_ip -%}{%- set actor = params.anomaly_user -%}
  {%- set url = params.anomaly_url -%}{%- set origin = params.anomaly_origin_ip -%}
  {%- set domain = url.split('/')[2].split(':')[0] -%}{%- set peer_host = origin -%}
  {%- set mime = 'text/csv' -%}
  {%- set bytes = module.rand.number.integer(1800000, 2800000) -%}
  {%- set duration = module.rand.number.integer(1800, 2800) -%}
{%- elif kind == 'get' and resource.cacheable and url in cache -%}
  {%- set result = 'TCP_HIT' -%}{%- set peer = 'HIER_NONE' -%}
  {%- set peer_host = '-' -%}{%- set duration = module.rand.number.integer(1, 20) -%}
  {%- set bytes = cache[url].bytes -%}
{%- elif kind == 'conditional' and resource.cacheable and url in cache -%}
  {%- set result = 'TCP_IMS_HIT' -%}{%- set status = 304 -%}
  {%- set peer = 'HIER_NONE' -%}{%- set peer_host = '-' -%}
  {%- set bytes = module.rand.number.integer(210, 360) -%}
  {%- set duration = module.rand.number.integer(0, 12) -%}
{%- endif -%}
{%- if step == 'routine' and status == 200 and method == 'GET' and result == 'TCP_MISS' and resource.cacheable -%}
  {%- do cache.update({url: {'bytes':bytes, 'expires_at':logged_at.timestamp() + 3600}}) -%}
  {%- if cache | length > 24 -%}
    {%- do cache.pop((cache.keys() | list)[0]) -%}
  {%- endif -%}
  {%- do shared.set('cache', cache) -%}
{%- endif -%}
{%- if actor != '-' -%}
  {%- set hkey = actor ~ ' ' ~ url -%}
  {%- set h = history.get(hkey, {'fails': [], 'armed': none}) -%}
  {%- set fails = h.fails | select('ge', now_s - chain_window_s) | list -%}
  {%- set armed = h.armed if h.armed is not none and h.armed >= now_s - chain_window_s else none -%}
  {%- if result == 'TCP_DENIED' -%}
    {%- do fails.append(now_s) -%}
  {%- elif status == 200 and method == 'GET' and fails | length >= 3 -%}
    {%- set armed = [armed if armed is not none else fails[-3], fails[-3]] | max -%}
  {%- endif -%}
  {%- if step == 'allowed_2' or (not fails and armed is none) -%}
    {%- do history.pop(hkey, none) -%}
  {%- else -%}
    {%- do history.update({hkey: {'fails': fails[-8:], 'armed': armed}}) -%}
  {%- endif -%}
  {%- do shared.set('access_history', history) -%}
{%- endif -%}
{%- set epoch = '%.3f' % logged_at.timestamp() -%}
{%- set original = epoch ~ ' ' ~ ('%6d' % duration) ~ ' ' ~ src ~ ' ' ~ result ~ '/' ~ status ~ ' ' ~ bytes ~ ' ' ~ method ~ ' ' ~ url ~ ' ' ~ actor ~ ' ' ~ peer ~ '/' ~ peer_host ~ ' ' ~ mime -%}
{%- set offset = shared.get('offset', 0) -%}
{%- do shared.set('offset', offset + original.encode('utf-8')|length + 1) -%}
{%- set related_ip = [src] if peer_host == '-' else [src,peer_host] -%}
{%- set out = {'@timestamp':logged_at.isoformat(),'ecs':{'version':'8.17.0'},'agent':{'ephemeral_id':'5a110000-1111-4444-8888-123456789abc','id':'5a110000-1111-4444-8888-123456789abc','name':params.proxy_name,'type':'filebeat','version':'8.17.0'},'elastic_agent':{'id':'5a110000-1111-4444-8888-123456789abc','snapshot':false,'version':'8.17.0'},'data_stream':{'dataset':'squid.log','namespace':'default','type':'logs'},'event':{'agent_id_status':'verified','category':['web'],'dataset':'squid.log','duration':duration * 1000000,'ingested':logged_at.isoformat(),'kind':'event','module':'squid','original':original,'outcome':'failure' if status >= 400 else 'success','type':['access']},'http':{'request':{'method':method}},'input':{'type':'filestream'},'log':{'file':{'path':'/var/log/squid/access.log'},'offset':offset},'observer':{'hostname':params.proxy_name,'ip':params.proxy_ip,'product':'Squid','type':'proxy','vendor':'Squid'},'related':{'ip':related_ip},'source':{'address':src,'ip':src},'squid':{'peer_status':peer,'result_code':result,'status_code':status},'tags':['preserve_original_event','squid-log'],'url':{'original':url}} -%}
{%- do out.update({'destination':{'address':peer_host if peer_host != '-' else domain,'bytes':bytes}}) -%}
{%- if peer_host != '-' -%}{%- do out['destination'].update({'ip':peer_host}) -%}{%- endif -%}
{%- if actor != '-' -%}{%- do out['source'].update({'user':{'name':actor}}) -%}{%- do out['related'].update({'user':[actor]}) -%}{%- endif -%}
{%- if mime != '-' -%}{%- do out['squid'].update({'content_type':mime}) -%}{%- endif -%}
{%- if method != 'CONNECT' -%}
  {%- do out['url'].update({'domain':domain,'scheme':'http','path':'/' ~ url.split('/', 3)[-1] if '/' in url[7:] else '/'}) -%}
  {%- do out['related'].update({'hosts':[domain]}) -%}
{%- endif -%}
{{- out | tojson -}}
