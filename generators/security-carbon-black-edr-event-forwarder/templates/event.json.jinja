{%- set step = vars.step -%}
{%- set chain = step.startswith('chain_') -%}
{%- set epoch = timestamp.timestamp()|int -%}
{%- if step == 'routine_start' -%}
  {%- do shared.pop('to_chain', none) -%}
  {%- do shared.pop('to_childproc', none) -%}
  {%- do shared.pop('to_regmod', none) -%}
  {%- do shared.pop('to_filemod', none) -%}
  {%- do shared.pop('chain_process', none) -%}
  {%- do shared.pop('routine_child_process', none) -%}
  {%- set count = shared.get('routine_count', 0) + 1 -%}
  {%- if count % 11 == 0 -%}{%- do shared.set('to_childproc', true) -%}
  {%- elif count % 7 == 0 -%}{%- do shared.set('to_regmod', true) -%}
  {%- elif count % 3 == 0 -%}{%- do shared.set('to_filemod', true) -%}{%- endif -%}
  {%- if count >= params.anomaly_interval_events -%}
    {%- do shared.set('routine_count', 0) -%}
    {%- if params.anomaly_mode -%}{%- do shared.set('to_chain', true) -%}{%- endif -%}
  {%- else -%}{%- do shared.set('routine_count', count) -%}{%- endif -%}
  {%- set actors = [
    {'host':'WS-ENG-01','sensor':11,'prefix':'0000000b','user':'engineer@example.test','path':'c:\\program files\\browser\\browser.exe','parent_path':'c:\\windows\\explorer.exe','remote_ip':'198.51.100.10','domain':'updates.example.test'},
    {'host':'WS-HR-02','sensor':12,'prefix':'0000000c','user':'hr@example.test','path':'c:\\program files\\collab\\collab.exe','parent_path':'c:\\windows\\explorer.exe','remote_ip':'198.51.100.11','domain':'chat.example.test'},
    {'host':'WS-OPS-03','sensor':13,'prefix':'0000000d','user':'operator@example.test','path':'c:\\program files\\monitor\\agent.exe','parent_path':'c:\\windows\\services.exe','remote_ip':'198.51.100.12','domain':'telemetry.example.test'},
    {'host':'WS-FIN-04','sensor':14,'prefix':'0000000e','user':'analyst@example.test','path':'c:\\program files\\browser\\browser.exe','parent_path':'c:\\windows\\explorer.exe','remote_ip':'198.51.100.13','domain':'portal.example.test'},
    {'host':params.chain_host,'sensor':params.chain_sensor_id,'prefix':'00000007','user':params.chain_user,'path':'c:\\windows\\system32\\windowspowershell\\v1.0\\powershell.exe','parent_path':'c:\\windows\\explorer.exe','remote_ip':'198.51.100.14','domain':'updates.example.test','cmdline':'"c:\\windows\\system32\\windowspowershell\\v1.0\\powershell.exe" -NoProfile -File C:\\ProgramData\\Contoso\\health.ps1'}
  ] -%}
  {%- set actor = module.rand.choice(actors) -%}
  {%- set process_guid = actor.prefix ~ '-0000-' ~ module.rand.string.hex(4) ~ '-' ~ module.rand.string.hex(4) ~ '-' ~ module.rand.string.hex(12) -%}
  {%- set parent_guid = actor.prefix ~ '-0000-' ~ module.rand.string.hex(4) ~ '-' ~ module.rand.string.hex(4) ~ '-' ~ module.rand.string.hex(12) -%}
  {%- set ctx = {'host':actor.host,'sensor':actor.sensor,'user':actor.user,'path':actor.path,'parent_path':actor.parent_path,'remote_ip':actor.remote_ip,'domain':actor.domain,'local_ip':'10.20.10.' ~ actor.sensor,'local_port':module.rand.number.integer(40000, 60000),'remote_port':443,'pid':module.rand.number.integer(2000, 9000),'parent_pid':1500,'guid':process_guid,'parent_guid':parent_guid,'md5':module.rand.string.hex(32)|upper,'parent_md5':module.rand.string.hex(32)|upper,'cmdline':actor.get('cmdline', '"' ~ actor.path ~ '"')} -%}
  {%- do shared.set('routine_process', ctx) -%}
{%- elif step == 'chain_childproc' -%}
  {%- set prefix = '00000007' -%}
  {%- set process_guid = prefix ~ '-0000-' ~ module.rand.string.hex(4) ~ '-' ~ module.rand.string.hex(4) ~ '-' ~ module.rand.string.hex(12) -%}
  {%- set parent_guid = prefix ~ '-0000-' ~ module.rand.string.hex(4) ~ '-' ~ module.rand.string.hex(4) ~ '-' ~ module.rand.string.hex(12) -%}
  {%- set path = 'c:\\windows\\system32\\windowspowershell\\v1.0\\powershell.exe' -%}
  {%- set parent_path = 'c:\\program files\\microsoft office\\root\\office16\\winword.exe' -%}
  {%- set ctx = {'host':params.chain_host,'sensor':params.chain_sensor_id,'user':params.chain_user,'path':path,'parent_path':parent_path,'remote_ip':'198.51.100.77','domain':'','local_ip':params.chain_local_ip,'local_port':module.rand.number.integer(40000, 60000),'remote_port':443,'pid':module.rand.number.integer(2000, 9000),'parent_pid':1840,'guid':process_guid,'parent_guid':parent_guid,'md5':'E3F7D643F0133A6BCB598EAD3B4F1C76','parent_md5':'6DC27F4A5FD57F6C917F3E63F2C4E37F','cmdline':'"' ~ path ~ '" -NoProfile -WindowStyle Hidden -File C:\\ProgramData\\Contoso\\maint.ps1'} -%}
  {%- do shared.set('chain_process', ctx) -%}
{%- else -%}
  {%- set ctx = shared.get('chain_process') if chain else shared.get('routine_child_process') if step == 'routine_child_start' else shared.get('routine_process') -%}
{%- endif -%}
{%- set process_link = params.link_base ~ '/#analyze/' ~ ctx.guid ~ '/1' -%}
{%- set parent_link = params.link_base ~ '/#analyze/' ~ ctx.parent_guid ~ '/1' -%}
{%- set sensor_link = params.link_base ~ '/#/host/' ~ ctx.sensor -%}
{%- if step == 'routine_start' or step == 'routine_child_start' or step == 'chain_procstart' -%}
  {%- set native = {'cb_server':params.cb_server,'command_line':ctx.cmdline,'computer_name':ctx.host,'event_type':'proc','expect_followon_w_md5':false,'link_parent':parent_link,'link_process':process_link,'link_sensor':sensor_link,'md5':ctx.md5,'parent_create_time':epoch-3 if step == 'routine_child_start' else epoch-120,'parent_md5':ctx.parent_md5,'parent_path':ctx.parent_path,'parent_process_guid':ctx.parent_guid,'path':ctx.path,'pid':ctx.pid,'process_guid':ctx.guid,'sensor_id':ctx.sensor,'timestamp':epoch,'type':'ingress.event.procstart','username':ctx.user} -%}
  {%- set category = 'process' -%}
  {%- set event_type = ['start'] -%}
{%- elif step.endswith('childproc') -%}
  {%- set child_guid = ctx.guid if chain else ctx.guid[:8] ~ '-0000-' ~ module.rand.string.hex(4) ~ '-' ~ module.rand.string.hex(4) ~ '-' ~ module.rand.string.hex(12) -%}
  {%- set child_link = process_link if chain else params.link_base ~ '/#analyze/' ~ child_guid ~ '/1' -%}
  {%- set child_md5 = ctx.md5 if chain else module.rand.string.hex(32)|upper -%}
  {%- set parent_process_guid = ctx.parent_guid if chain else ctx.guid -%}
  {%- set parent_process_link = parent_link if chain else process_link -%}
  {%- set parent_pid = ctx.parent_pid if chain else ctx.pid -%}
  {%- if not chain -%}
    {%- set child_path = 'c:\\windows\\system32\\conhost.exe' if 'powershell' in ctx.path else ctx.path -%}
    {%- set child_ctx = {'host':ctx.host,'sensor':ctx.sensor,'user':ctx.user,'path':child_path,'parent_path':ctx.path,'remote_ip':ctx.remote_ip,'domain':ctx.domain,'local_ip':ctx.local_ip,'local_port':ctx.local_port,'remote_port':ctx.remote_port,'pid':module.rand.number.integer(9001, 16000),'parent_pid':ctx.pid,'guid':child_guid,'parent_guid':ctx.guid,'md5':child_md5,'parent_md5':ctx.md5,'cmdline':'"' ~ child_path ~ '"'} -%}
    {%- do shared.set('routine_child_process', child_ctx) -%}
  {%- endif -%}
  {%- set native = {'cb_server':params.cb_server,'child_process_guid':child_guid,'computer_name':ctx.host,'created':true,'event_type':'childproc','link_child':child_link,'link_process':parent_process_link,'link_sensor':sensor_link,'md5':child_md5,'pid':parent_pid,'process_guid':parent_process_guid,'sensor_id':ctx.sensor,'timestamp':epoch,'type':'ingress.event.childproc'} -%}
  {%- set category = 'process' -%}
  {%- set event_type = ['start'] -%}
{%- elif step.endswith('regmod') -%}
  {%- set registry_path = '\\registry\\user\\s-1-5-21-1000-1000-1000-1001\\software\\microsoft\\windows\\currentversion\\run\\updater' if chain else '\\registry\\user\\s-1-5-21-1000-1000-1000-' ~ (ctx.sensor + 1000) ~ '\\software\\contoso\\settings\\lastsync' -%}
  {%- set native = {'action':'writeval','actiontype':2,'cb_server':params.cb_server,'computer_name':ctx.host,'event_type':'regmod','link_process':process_link,'link_sensor':sensor_link,'md5':ctx.md5,'path':registry_path,'pid':ctx.pid,'process_guid':ctx.guid,'sensor_id':ctx.sensor,'timestamp':epoch,'type':'ingress.event.regmod'} -%}
  {%- set category = 'registry' -%}
  {%- set event_type = ['change'] -%}
{%- elif step.endswith('filemod') -%}
  {%- set file_path = 'c:\\users\\alice\\appdata\\roaming\\updater\\cache.dat' if chain else 'c:\\users\\' ~ ctx.user.split('@')[0] ~ '\\appdata\\local\\temp\\session-cache.dat' -%}
  {%- set native = {'action':'lastwrite','actiontype':8,'cb_server':params.cb_server,'computer_name':ctx.host,'event_type':'filemod','filetype':0,'filetype_name':'Unknown','link_process':process_link,'link_sensor':sensor_link,'md5':ctx.md5,'path':file_path,'pid':ctx.pid,'process_guid':ctx.guid,'sensor_id':ctx.sensor,'timestamp':epoch,'type':'ingress.event.filemod'} -%}
  {%- set category = 'file' -%}
  {%- set event_type = ['change'] -%}
{%- else -%}
  {%- set native = {'cb_server':params.cb_server,'computer_name':ctx.host,'direction':'outbound','domain':ctx.domain,'event_type':'netconn','ipv4':ctx.remote_ip,'link_process':process_link,'link_sensor':sensor_link,'local_ip':ctx.local_ip,'local_port':ctx.local_port,'md5':ctx.md5,'pid':ctx.pid,'port':ctx.remote_port,'process_guid':ctx.guid,'protocol':6,'remote_ip':ctx.remote_ip,'remote_port':ctx.remote_port,'sensor_id':ctx.sensor,'timestamp':epoch,'type':'ingress.event.netconn'} -%}
  {%- set category = 'network' -%}
  {%- set event_type = ['connection'] -%}
{%- endif -%}
{%- set process_id = ctx.parent_guid if step == 'chain_childproc' else ctx.guid -%}
{%- set process_pid = ctx.parent_pid if step == 'chain_childproc' else ctx.pid -%}
{%- set process_path = ctx.parent_path if step == 'chain_childproc' else ctx.path -%}
{%- set process = {'entity_id':process_id,'pid':process_pid,'executable':process_path} -%}
{%- if step == 'routine_start' or step == 'routine_child_start' or step == 'chain_procstart' -%}{%- do process.update({'command_line':ctx.cmdline,'parent':{'entity_id':ctx.parent_guid,'executable':ctx.parent_path}}) -%}{%- endif -%}
{%- set out = {'@timestamp':timestamp.isoformat(),'ecs':{'version':'8.17.0'},'event':{'action':native.type,'category':[category],'dataset':'carbon_black_edr.event_forwarder','kind':'event','original':native|tojson,'type':event_type},'host':{'name':ctx.host},'observer':{'name':params.cb_server,'product':'EDR','vendor':'Carbon Black'},'user':{'name':ctx.user},'process':process,'related':{'hosts':[ctx.host],'user':[ctx.user]},'carbon_black':{'edr':native}} -%}
{%- if category == 'network' -%}
  {%- do out.update({'source':{'ip':ctx.local_ip,'port':ctx.local_port},'destination':{'ip':ctx.remote_ip,'port':ctx.remote_port},'network':{'direction':'outbound','transport':'tcp'}}) -%}
  {%- do out.related.update({'ip':[ctx.local_ip,ctx.remote_ip]}) -%}
{%- elif category == 'file' -%}{%- do out.update({'file':{'path':native.path}}) -%}
{%- elif category == 'registry' -%}{%- do out.update({'registry':{'path':native.path}}) -%}
{%- endif -%}
{{- out | tojson -}}
