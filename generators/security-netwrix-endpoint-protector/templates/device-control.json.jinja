{#- Netwrix Endpoint Protector Device Control SIEM export (Standard
    format, Exclude Headers on), wrapped in ECS JSON with the native
    message body in event.original. The input sets the rate and the
    hour-of-day curve; every timestamp becomes exactly one record. Each
    timestamp takes the earliest due record of an open device activity;
    when none is due, it starts a new activity of an idle user who is
    at work at that hour, picked by activity weight, or brings the next
    planned record forward while enough activities are open. An
    episode is one more activity of such a user. An activity is an
    approved-device session (Connected, file operations, Disconnected)
    or a personal device plugged in (Blocked, sometimes re-plugged,
    sometimes followed by an approved-device session). -#}
{%- set ts = timestamp.astimezone(module.datetime.timezone.utc) -%}
{%- set nows = module.builtins.int(ts.timestamp()) -%}
{%- set now = module.builtins.int(ts.timestamp() * 1000000) -%}
{%- set hq = module.heapq -%}
{%- set hour_us = 3600000000 -%}
{%- set lsec = nows + module.builtins.int(params.utc_offset_hours * 3600) -%}
{%- set day = lsec // 86400 -%}
{%- set hour = (lsec % 86400) // 3600 -%}
{#- Chain window: a Blocked record and five File Write records to one
    approved device within one hour. -#}
{%- set window = 3601 -%}
{%- macro ln(med, sig) -%}
  {#- Lognormal seconds with median med; returns microseconds. -#}
  {{- module.builtins.int(module.rand.number.lognormal(module.math.log(med), sig) * 1000000) -}}
{%- endmacro -%}
{%- macro clip(x, lo, hi) -%}{{- [[x, lo] | max, hi] | min -}}{%- endmacro -%}
{%- macro push(due, it) -%}
  {%- set S = shared.get('s') -%}
  {%- do S.update({'seq': S.seq + 1}) -%}
  {%- do module.heapq.heappush(S.queue, [due, S.seq, it]) -%}
  {%- set u = S.users[it.u] -%}
  {%- if u.pend == 0 -%}{%- do S.update({'open': S.open + 1}) -%}{%- endif -%}
  {%- do u.update({'pend': u.pend + 1}) -%}
{%- endmacro -%}
{%- macro pick_file(d) -%}
  {{- d.pool[[module.bisect.bisect_right(d.cum, module.rand.number.floating(0, d.cum[-1])), d.pool | length - 1] | min] -}}
{%- endmacro -%}
{%- macro session(t0, ui, dev, ep) -%}
  {#- One approved device plugged in: Connected, file operations in
      quick succession with occasional pauses (a bulk copy writes its
      files seconds apart), Disconnected. Phone-charging users read
      from their sticks more and bulk-copy less than others. An
      episode session writes exactly five files, like a short bulk
      copy. -#}
  {%- set S = shared.get('s') -%}
  {%- set u = S.users[ui] -%}
  {%- set d = S.depts[u.dept] -%}
  {%- set has = S.devices[dev].files | length > 0 -%}
  {%- set drive = module.rand.weighted_choice(['E:', 'F:', 'D:', 'G:'], [70, 18, 8, 4]) -%}
  {%- set base = {'u': ui, 'dev': dev, 'drive': drive, 'f': none, 're': false, 'ep': ep} -%}
  {%- do push(t0, dict(base, ev='Connected')) -%}
  {%- if ep -%}
    {%- set mode = 'bulk' -%}
    {%- set ops = ['File Write'] * 5 -%}
  {%- else -%}
    {%- set mode = module.rand.weighted_choice(['browse', 'drop', 'mixed', 'bulk', 'idle'], [40, 30, 20, 4, 6] if u.heavy else [34, 30, 20, 10, 6]) -%}
    {%- if mode == 'browse' and not has -%}{%- set mode = 'drop' -%}{%- endif -%}
    {%- if mode == 'browse' -%}
      {%- set ops = ['File Read'] * module.rand.weighted_choice([1, 2, 3, 4, 6, 9], [30, 22, 16, 12, 12, 8]) -%}
    {%- elif mode == 'drop' -%}
      {%- set ops = ['File Write'] * module.rand.weighted_choice([1, 2, 3, 4], [45, 28, 17, 10]) -%}
      {%- if has and module.rand.chance(0.3) -%}{%- set ops = ['File Read'] + ops -%}{%- endif -%}
    {%- elif mode == 'mixed' -%}
      {%- set ops = [] -%}
      {%- for _ in range(module.rand.number.integer(3, 14)) -%}
        {%- do ops.append(module.rand.weighted_choice(['File Read', 'File Write', 'File Delete'], [50, 35, 15])) -%}
      {%- endfor -%}
    {%- elif mode == 'bulk' -%}
      {%- set nb = [[module.builtins.int(module.rand.number.lognormal(module.math.log(11), 0.65)), 1] | max, 60] | min -%}
      {%- set ops = ['File Write'] * nb -%}
      {%- if has and module.rand.chance(0.25) -%}{%- set ops = ['File Delete'] * module.rand.number.integer(1, 4) + ops -%}{%- endif -%}
    {%- else -%}
      {%- set ops = [] -%}
    {%- endif -%}
  {%- endif -%}
  {%- set t = namespace(v=t0 + (ln(15, 0.9) | int)) -%}
  {%- for op in ops -%}
    {%- if op == 'File Write' -%}
      {%- do push(t.v, dict(base, ev=op, f=pick_file(d), re=module.rand.chance(0.1))) -%}
    {%- else -%}
      {%- do push(t.v, dict(base, ev=op)) -%}
    {%- endif -%}
    {%- if op == 'File Write' and mode == 'bulk' -%}
      {%- set t.v = t.v + (ln(2, 0.8) | int) -%}
    {%- else -%}
      {%- set t.v = t.v + (ln(25, 1.2) | int) -%}
      {%- if module.rand.chance(0.08) -%}{%- set t.v = t.v + (ln(240, 0.9) | int) -%}{%- endif -%}
    {%- endif -%}
  {%- endfor -%}
  {%- do push(t.v + (ln(150, 1.1) | int), dict(base, ev='Disconnected')) -%}
{%- endmacro -%}
{%- macro attempt(t0, ui, ep) -%}
  {#- Personal device plugged in: Blocked, re-plugged and blocked again
      within a minute or two in 40% of cases per attempt, and in half
      of the attempts (always in an episode) followed a few minutes
      later by an approved device. -#}
  {%- set S = shared.get('s') -%}
  {%- set u = S.users[ui] -%}
  {%- set pd = module.rand.choice(u.personal) -%}
  {%- set t = namespace(v=t0, go=true) -%}
  {%- for _ in range(5) if t.go -%}
    {%- do push(t.v, {'ev': 'Blocked', 'u': ui, 'dev': pd, 'drive': '', 'f': none, 're': false, 'ep': ep}) -%}
    {%- set t.go = module.rand.chance(0.4) -%}
    {%- if t.go -%}{%- set t.v = t.v + (ln(35, 0.8) | int) -%}{%- endif -%}
  {%- endfor -%}
  {%- if ep or module.rand.chance(0.5) -%}
    {%- set dev = u.own if u.own and (ep or module.rand.chance(u.own_p)) else module.rand.choice(S.depts[u.dept].shared) -%}
    {%- do session(t.v + ([ln(150, 0.9) | int, 900000000] | min), ui, dev, ep) -%}
  {%- endif -%}
{%- endmacro -%}
{%- macro pick_time(a, b, pw) -%}
  {#- A moment in [a, b) weighted by the hour-of-day load to the power
      pw (plus a small floor for pw 2). -#}
  {%- set S = shared.get('s') -%}
  {%- set off = module.builtins.int(params.utc_offset_hours * 3600) * 1000000 -%}
  {%- set slots = [] -%}
  {%- set ws = [] -%}
  {%- set t = namespace(v=a) -%}
  {%- for _ in range(400) if t.v < b -%}
    {%- set l = t.v + off -%}
    {%- set hend = [b, t.v + 3600000000 - (l % 3600000000)] | min -%}
    {%- set c = S.curve[(l // 3600000000) % 24] / (S.curve | max) -%}
    {%- do slots.append([t.v, hend]) -%}
    {%- do ws.append(((c ** pw) + (0.01 if pw == 2 else 0)) * (hend - t.v)) -%}
    {%- set t.v = hend -%}
  {%- endfor -%}
  {%- set s = module.rand.weighted_choice(slots, ws) -%}
  {{- module.rand.number.integer(s[0], [s[0], s[1] - 1] | max) -}}
{%- endmacro -%}
{%- if shared.get('s') is none -%}
  {%- set schema = {'type': 'typed-dict', 'fields': {
    'anomaly_mode': {'type': 'typed-dict-field', 'schema': {'type': 'bool', 'strict': true}},
    'anomaly_interval_hours': {'type': 'typed-dict-field', 'schema': {'type': 'float', 'ge': 6, 'le': 8760}},
    'epp_server': {'type': 'typed-dict-field', 'schema': {'type': 'str', 'min_length': 1}},
    'staff_count': {'type': 'typed-dict-field', 'schema': {'type': 'int', 'ge': 100, 'le': 5000}},
    'utc_offset_hours': {'type': 'typed-dict-field', 'schema': {'type': 'float', 'ge': -12, 'le': 14}}
  }} -%}
  {%- do module.pydantic_core.SchemaValidator(schema).validate_python(params) -%}
  {#- The estate (staff, workstations, devices, files) comes from a
      fixed seed, so every run models the same office; only behaviour
      is random. -#}
  {%- set rnd = module.random.Random(9604) -%}
  {%- set ext_med = {} -%}
  {%- for r in samples.file_types -%}{%- do ext_med.update({r.extension: r.median_bytes | int}) -%}{%- endfor -%}
  {%- set approved = [] -%}
  {%- set approved_w = [] -%}
  {%- set personal = [] -%}
  {%- set personal_w = [] -%}
  {%- set phones = [] -%}
  {%- set phones_w = [] -%}
  {%- for r in samples.device_models -%}
    {%- set m = [r.vid, r.pid, r.type, r.name] -%}
    {%- if r.policy == 'approved' -%}
      {%- do approved.append(m) -%}{%- do approved_w.append(r.weight | int) -%}
    {%- else -%}
      {%- do personal.append(m) -%}{%- do personal_w.append(r.weight | int) -%}
      {%- if r.type in ['iPods / iPhones / iPads', 'Smartphones / Handhelds / PDAs'] -%}
        {%- do phones.append(m) -%}{%- do phones_w.append(r.weight | int) -%}
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}
  {%- set periods = ['Q1', 'Q2', 'Q3', 'Q4', '2025', '2026', 'Jan', 'Mar', 'Jun', 'Sep', 'Oct', 'Nov', 'v2', 'final', 'draft'] -%}
  {%- set hexd = '0123456789ABCDEF' -%}
  {%- set alnum = '0123456789ABCDEFGHJKLMNPRSTUVWXYZ' -%}
  {%- macro serial(n, alphabet) -%}{%- for _ in range(n) -%}{{- rnd.choice(alphabet) -}}{%- endfor -%}{%- endmacro -%}
  {%- set devices = {} -%}
  {%- macro new_device(model) -%}
    {%- set s = serial(16 if model[2] != 'iPods / iPhones / iPads' else 24, hexd if model[0] != '04E8' or model[1] != '6860' else alnum) -%}
    {%- do devices.update({s: {'vid': model[0], 'pid': model[1], 'type': model[2], 'name': model[3], 'files': {}}}) -%}
    {{- s -}}
  {%- endmacro -%}
  {%- set files = {} -%}
  {%- set depts = [] -%}
  {%- for r in samples.departments -%}
    {%- set d = {'code': r.code, 'folder': r.folder, 'w': r.weight, 'pool': [], 'cum': [], 'shared': []} -%}
    {%- set acc = namespace(v=0.0) -%}
    {%- for _ in range(40) -%}
      {%- set ext = rnd.choice(r.extensions) -%}
      {%- set nm = (rnd.choice(r.words) ~ ' ' ~ rnd.choice(periods)) | capitalize ~ '.' ~ ext -%}
      {%- set sub = rnd.choices(['', 'Export\\', 'Work\\', 'Archive\\'], [50, 20, 20, 10])[0] -%}
      {%- set path = r.folder ~ '\\' ~ sub ~ nm -%}
      {%- if path not in files -%}
        {%- do files.update({path: {'path': path, 'ext': ext, 'size': [module.builtins.int(rnd.lognormvariate(module.math.log(ext_med[ext]), 0.9)), 120] | max, 'hash': module.hashlib.md5((path ~ '%08x' | format(rnd.getrandbits(32))).encode()).hexdigest()}}) -%}
        {%- set acc.v = acc.v + rnd.lognormvariate(0, 1.0) -%}
        {%- do d.pool.append(path) -%}
        {%- do d.cum.append(acc.v) -%}
      {%- endif -%}
    {%- endfor -%}
    {%- for _ in range(2) -%}
      {%- do d.shared.append(new_device(rnd.choices(approved, approved_w)[0]) | trim) -%}
    {%- endfor -%}
    {%- do depts.append(d) -%}
  {%- endfor -%}
  {#- Manuals and installers found on most company sticks. -#}
  {%- set common = ['Manuals\\Quick start.pdf', 'Setup\\VPN client.msi', 'Setup\\Printer driver.zip', 'Readme.txt'] -%}
  {%- for p in common -%}
    {%- set ext = p.split('.')[-1] -%}
    {%- do files.update({p: {'path': p, 'ext': ext, 'size': [module.builtins.int(rnd.lognormvariate(module.math.log(ext_med[ext]), 0.6)), 120] | max, 'hash': module.hashlib.md5((p ~ '%08x' | format(rnd.getrandbits(32))).encode()).hexdigest()}}) -%}
  {%- endfor -%}
  {%- set surnames = [] -%}
  {%- for r in samples.surnames -%}{%- do surnames.append(r.surname) -%}{%- endfor -%}
  {%- set dept_ix = range(depts | length) | list -%}
  {%- set dept_w = depts | map(attribute='w') | list -%}
  {%- set ops_ix = [] -%}
  {%- for d in depts -%}{%- if d.code in ['OPS', 'IT'] -%}{%- do ops_ix.append(loop.index0) -%}{%- endif -%}{%- endfor -%}
  {%- set ouis = ['D4-81-D7', '3C-52-82', '00-1B-21', 'F8-B4-6A', '54-BF-64', '8C-EC-4B', 'B0-7B-25'] -%}
  {#- Staff: about a tenth are duty staff (Operations and IT) on
      alternating 12-hour day or night shifts at head office; the rest
      work a single office day in their own office's zone (head office,
      or a branch 2 h or 4 h east or 1 h west). A small tier of users
      (five duty staff per shift and about 2% of office staff) plug
      their own phone into the workstation several times a day (to
      charge it) and use their own company stick often. -#}
  {%- set nd = [20, (params.staff_count * 0.1) | round | int] | max -%}
  {%- set users = [] -%}
  {%- set taken = {} -%}
  {%- for i in range(params.staff_count) -%}
    {%- set duty = ('day' if i % 2 == 0 else 'night') if i < nd else none -%}
    {%- set heavy = i < 20 or (i >= nd and rnd.random() < 0.02) -%}
    {%- set di = rnd.choice(ops_ix) if duty else rnd.choices(dept_ix, dept_w)[0] -%}
    {%- set d = depts[di] -%}
    {%- set base = rnd.choice('adeiklmnoprstvy') ~ rnd.choice(surnames) -%}
    {%- set nm = namespace(v=base) -%}
    {%- for k in range(2, 30) if nm.v in taken -%}{%- set nm.v = base ~ k -%}{%- endfor -%}
    {%- do taken.update({nm.v: true}) -%}
    {%- set host = namespace(v=d.code ~ '-WS-' ~ '%03d' | format(rnd.randint(1, 399))) -%}
    {%- for _ in range(50) if host.v in taken -%}{%- set host.v = d.code ~ '-WS-' ~ '%03d' | format(rnd.randint(1, 399)) -%}{%- endfor -%}
    {%- do taken.update({host.v: true}) -%}
    {%- set tz = 0 if duty else rnd.choices([0, 2, 4, -1], [75, 12, 8, 5])[0] -%}
    {%- if duty -%}
      {%- set st = 8.0 if duty == 'day' else 20.0 -%}
      {%- set len = 12.0 -%}
    {%- else -%}
      {%- set st = (clip(rnd.gauss(8.8, 0.6), 7.0, 11.0) | float) - tz -%}
      {%- set len = clip(rnd.gauss(9.0, 0.6), 7.5, 10.5) | float -%}
    {%- endif -%}
    {%- if heavy -%}
      {%- set own = new_device(rnd.choices(approved, approved_w)[0]) | trim -%}
      {%- set pers = [new_device(rnd.choices(phones, phones_w)[0]) | trim] -%}
      {%- set p_block = 0.5 -%}
    {%- else -%}
      {%- set own = new_device(rnd.choices(approved, approved_w)[0]) | trim if rnd.random() < 0.7 else none -%}
      {%- set pers = [] -%}
      {%- for _ in range(rnd.choices([0, 1, 2], [35, 45, 20])[0]) -%}
        {%- do pers.append(new_device(rnd.choices(personal, personal_w)[0]) | trim) -%}
      {%- endfor -%}
      {%- set p_block = clip(rnd.lognormvariate(module.math.log(0.07), 0.7), 0.01, 0.3) | float if pers else 0 -%}
    {%- endif -%}
    {%- do users.append({
      'i': i, 'name': nm.v, 'dept': di,
      'host': host.v,
      'ip': '10.20.' ~ (di * 8 + rnd.randint(0, 3)) ~ '.' ~ rnd.randint(10, 250),
      'mac': rnd.choice(ouis) ~ '-' ~ serial(2, hexd) ~ '-' ~ serial(2, hexd) ~ '-' ~ serial(2, hexd),
      'hw': rnd.choice(['5CG', 'CZC', 'MXL', 'PF']) ~ serial(7, alnum),
      'os': rnd.choices(['Windows 11 Enterprise', 'Windows 10 Enterprise', 'Windows 11 Pro'], [55, 35, 10])[0],
      'ver': rnd.choices(['5.9.4', '5.9.3'], [80, 20])[0],
      'tz': tz, 'duty': duty, 'phase': (i // 2) % 2, 'st': st, 'len': len,
      'own': own, 'own_p': 0.9 if heavy else 0.75, 'personal': pers, 'heavy': heavy, 'p_block': p_block,
      'w': (clip(rnd.lognormvariate(0, 0.5), 1.6 if heavy else 0.4, 2.5) | float) * (3.0 if heavy else 1.0),
      'pend': 0, 'blk': []
    }) -%}
  {%- endfor -%}
  {#- Devices start with some files: department files on shared and
      own sticks, manuals and installers on about a third. -#}
  {%- for d in depts -%}
    {%- for s in d.shared -%}
      {%- for _ in range(rnd.randint(2, 6)) -%}{%- do devices[s].files.update({rnd.choice(d.pool): true}) -%}{%- endfor -%}
    {%- endfor -%}
  {%- endfor -%}
  {%- for u in users if u.own -%}
    {%- for _ in range(rnd.randint(1, 8)) -%}{%- do devices[u.own].files.update({rnd.choice(depts[u.dept].pool): true}) -%}{%- endfor -%}
  {%- endfor -%}
  {%- for s, dv in devices.items() if dv.type in ['Removable Storage Devices', 'External HDDs / portable hard disks'] -%}
    {%- for p in common if rnd.random() < 0.35 -%}{%- do dv.files.update({p: true}) -%}{%- endfor -%}
  {%- endfor -%}
  {#- Records per hour of the head-office day; the same rates as the
      patterns/*.yml input files, used only to place episode starts. -#}
  {%- set curve = [43, 43, 43, 43, 43, 188, 188, 360, 929, 1470, 1470, 1470, 1470, 1470, 1470, 1470, 1470, 929, 216, 43, 43, 43, 43, 43] -%}
  {%- set interval = module.builtins.int(params.anomaly_interval_hours * 3600) * 1000000 -%}
  {%- do shared.set('s', {'queue': [], 'seq': 0, 'users': users, 'devices': devices, 'files': files, 'depts': depts, 'curve': curve, 'day': none, 'tabs': none,
    'interval': interval, 'ep_at': 0, 'ep_last': none, 'ep_open': 0, 'ep_n': 0, 'open': 0, 'gap': 30.0, 'prev': ts.timestamp()}) -%}
  {%- set S = shared.get('s') -%}
  {#- First episode: within min(interval, 24 h) of the start, at an hour
      drawn from the hour-of-day load. -#}
  {%- do S.update({'ep_at': pick_time(now, now + ([interval, 24 * hour_us] | min), 1) | int}) -%}
{%- endif -%}
{%- set S = shared.get('s') -%}
{%- set U = S.users -%}
{%- set queue = S.queue -%}
{#- Once per head-office day: who is at work in each hour. Office
    staff start within about 20 minutes of their usual time and are
    away on about 4% of days; duty staff work every other day. -#}
{%- if S.day != day -%}
  {%- set tabs = [] -%}
  {%- for _ in range(24) -%}{%- do tabs.append({'u': [], 'c': [], 't': 0.0}) -%}{%- endfor -%}
  {%- for u in U -%}
    {%- if u.duty -%}
      {%- for h in range(24) -%}
        {%- set on = (8 <= h < 20) if u.duty == 'day' else (h >= 20 or h < 8) -%}
        {%- set wd = day - 1 if u.duty == 'night' and h < 8 else day -%}
        {%- if on and (wd + u.phase) % 2 == 0 -%}
          {%- set tb = tabs[h] -%}
          {%- do tb.update({'t': tb.t + u.w}) -%}
          {%- do tb.u.append(u.i) -%}
          {%- do tb.c.append(tb.t) -%}
        {%- endif -%}
      {%- endfor -%}
    {%- elif not module.rand.chance(0.04) -%}
      {%- set st = u.st + module.rand.number.gauss(0, 0.3) -%}
      {%- set en = st + u.len -%}
      {%- for h in range(module.math.floor(st), module.math.ceil(en)) -%}
        {%- set ov = ([h + 1, en] | min) - ([h, st] | max) -%}
        {%- if ov > 0 -%}
          {%- set tb = tabs[h % 24] -%}
          {%- do tb.update({'t': tb.t + u.w * ov}) -%}
          {%- do tb.u.append(u.i) -%}
          {%- do tb.c.append(tb.t) -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}
  {%- endfor -%}
  {%- do S.update({'day': day, 'tabs': tabs}) -%}
{%- endif -%}
{#- Open activities are kept near a target that follows the current
    record rate (a smoothed gap between records), so that records come
    out close to their planned times: a due record goes first; with no
    record due, a new activity starts while fewer than the target are
    open, otherwise the next planned record comes out now. -#}
{%- do S.update({'gap': 0.95 * S.gap + 0.05 * ([[ts.timestamp() - S.prev, 0] | max, 3600] | min), 'prev': ts.timestamp()}) -%}
{%- set target = [1, 73.0 / [S.gap, 0.001] | max] | max -%}
{%- set out = namespace(row=none, started=false) -%}
{%- for _ in range(40) if out.row is none -%}
  {%- if queue and (queue[0][0] <= now or S.open >= target or out.started) -%}
    {%- set it = hq.heappop(queue)[2] -%}
    {%- set u = U[it.u] -%}
    {%- do u.update({'pend': u.pend - 1}) -%}
    {%- if u.pend == 0 -%}{%- do S.update({'open': S.open - 1}) -%}{%- endif -%}
    {%- set dv = S.devices[it.dev] -%}
    {%- if it.ev == 'Blocked' -%}
      {%- set keep = [] -%}
      {%- for b in u.blk if nows - b.t <= window -%}{%- do keep.append(b) -%}{%- endfor -%}
      {%- do keep.append({'t': nows, 'd': it.dev, 'c': {}}) -%}
      {%- do u.update({'blk': keep[-10:]}) -%}
      {%- set out.row = it -%}
    {%- elif it.ev == 'Connected' -%}
      {%- for b in u.blk if nows - b.t <= window and b.d != it.dev and it.dev not in b.c -%}{%- do b.c.update({it.dev: 0}) -%}{%- endfor -%}
      {%- set out.row = it -%}
    {%- elif it.ev == 'File Write' -%}
      {#- Guard on the exact final step: a write that would be the fifth
          to this device within an hour of a Blocked record (after the
          device was connected) is not made, unless it is the episode's
          own fifth write. -#}
      {%- set g = namespace(full=false) -%}
      {%- for b in u.blk if nows - b.t <= window and it.dev in b.c and b.c[it.dev] >= 4 -%}{%- set g.full = true -%}{%- endfor -%}
      {%- if g.full and not (it.ep and it.ep == S.ep_open) -%}
        {%- do S.update({'guard': S.get('guard', 0) + 1}) -%}
      {%- else -%}
        {%- if g.full -%}{%- do S.update({'ep_open': 0}) -%}{%- endif -%}
        {%- for b in u.blk if nows - b.t <= window and it.dev in b.c -%}{%- do b.c.update({it.dev: b.c[it.dev] + 1}) -%}{%- endfor -%}
        {%- set p = module.rand.choice(dv.files.keys() | list) if it.re and dv.files else it.f -%}
        {%- do dv.files.update({p: true}) -%}
        {%- do it.update({'f': p}) -%}
        {%- set out.row = it -%}
      {%- endif -%}
    {%- elif it.ev == 'Disconnected' -%}
      {%- for p in dv.files.keys() | list -%}
        {%- if dv.files | length > 80 -%}{%- do dv.files.pop(p) -%}{%- endif -%}
      {%- endfor -%}
      {%- set out.row = it -%}
    {%- elif dv.files -%}
      {#- File Read or File Delete of a file that is on the device now. -#}
      {%- set p = module.rand.choice(dv.files.keys() | list) -%}
      {%- if it.ev == 'File Delete' -%}{%- do dv.files.pop(p) -%}{%- endif -%}
      {%- do it.update({'f': p}) -%}
      {%- set out.row = it -%}
    {%- endif -%}
  {%- elif not out.started -%}
    {%- set out.started = true -%}
    {%- set tb = S.tabs[hour] -%}
    {%- set ep = namespace(ui=none) -%}
    {#- Episode: at its planned moment, an idle phone-charging user who
        is at work, had no Blocked record in the last hour and did not
        take the previous episode plugs the phone in, is blocked and
        copies five files to the own company stick. -#}
    {%- if params.anomaly_mode and now >= S.ep_at -%}
      {%- set cand = [] -%}
      {%- set cw = [] -%}
      {%- for i in tb.u -%}
        {%- set c = U[i] -%}
        {%- if c.heavy and c.pend == 0 and c.name != S.ep_last -%}
          {%- set fresh = namespace(v=true) -%}
          {%- for b in c.blk if nows - b.t <= window -%}{%- set fresh.v = false -%}{%- endfor -%}
          {%- if fresh.v -%}{%- do cand.append(i) -%}{%- do cw.append(c.w) -%}{%- endif -%}
        {%- endif -%}
      {%- endfor -%}
      {%- if cand -%}
        {%- set ep.ui = module.rand.weighted_choice(cand, cw) -%}
        {%- set due = now + S.interval -%}
        {%- set w = [S.interval // 4, 6 * hour_us] | min -%}
        {%- do S.update({'ep_n': S.ep_n + 1, 'ep_last': U[ep.ui].name, 'ep_at': pick_time(due - w // 2, due + w // 2, 2) | int}) -%}
        {%- do S.update({'ep_open': S.ep_n}) -%}
        {%- do attempt(now, ep.ui, S.ep_n) -%}
      {%- endif -%}
    {%- endif -%}
    {%- if ep.ui is none -%}
      {%- set pick = namespace(ui=none) -%}
      {%- for _ in range(8) if pick.ui is none -%}
        {%- set i = tb.u[[module.bisect.bisect_right(tb.c, module.rand.number.floating(0, tb.t)), tb.u | length - 1] | min] if tb.u else module.rand.number.integer(0, U | length - 1) -%}
        {%- if U[i].pend == 0 -%}{%- set pick.ui = i -%}{%- endif -%}
      {%- endfor -%}
      {%- for i in tb.u if pick.ui is none and U[i].pend == 0 -%}{%- set pick.ui = i -%}{%- endfor -%}
      {%- if pick.ui is none -%}{%- set pick.ui = tb.u[0] if tb.u else 0 -%}{%- endif -%}
      {%- set u = U[pick.ui] -%}
      {%- if u.personal and module.rand.chance(u.p_block) -%}
        {%- do attempt(now, pick.ui, 0) -%}
      {%- else -%}
        {%- do session(now, pick.ui, u.own if u.own and module.rand.chance(u.own_p) else module.rand.choice(S.depts[u.dept].shared), 0) -%}
      {%- endif -%}
    {%- endif -%}
  {%- endif -%}
{%- endfor -%}
{%- if out.row is none -%}{{- dispatch.drop() -}}{%- endif -%}
{%- set r = out.row -%}
{%- set u = U[r.u] -%}
{%- set dv = S.devices[r.dev] -%}
{%- set f = S.files[r.f] if r.f else none -%}
{%- set client = ts.replace(microsecond=0) -%}
{%- set server = client + module.datetime.timedelta(seconds=module.builtins.int(module.rand.number.lognormal(module.math.log(2), 0.9))) -%}
{#- Server columns use the server's zone; client columns the
    workstation's (head office, or a branch office some hours away). -#}
{%- set tz = module.datetime.timedelta(hours=params.utc_offset_hours) -%}
{%- set ctz = module.datetime.timedelta(hours=params.utc_offset_hours + u.tz) -%}
{%- set fmt = '%Y-%m-%d %H:%M:%S' -%}
{%- set native = {
  'Log ID': module.rand.crypto.uuid4() | replace('-', ''),
  'Event Name': r.ev,
  'Client Computer': u.host,
  'IP Address': u.ip,
  'MAC Address': u.mac,
  'Serial Number': u.hw,
  'OS': u.os,
  'Client User': u.name,
  'Device Type': dv.type,
  'Device': dv.name,
  'Device VID': dv.vid,
  'Device PID': dv.pid,
  'Device Serial': r.dev,
  'EPP Client Version': u.ver,
  'File Name': r.drive ~ '\\' ~ f.path if f else '',
  'File Hash': f.hash if f else '',
  'File Type': f.ext | upper if f else '',
  'File Size': f.size | string if f else '',
  'Justification': '',
  'Time Interval': '',
  'Date/Time(Server)': (server + tz).strftime(fmt),
  'Date/Time(Client)': (client + ctz).strftime(fmt),
  'Date/Time(Server UTC)': server.strftime(fmt),
  'Date/Time(Client UTC)': client.strftime(fmt),
  'Shadow Exists': 'No',
  'Repository Type': ''
} -%}
{%- set order = ['Log ID', 'Event Name', 'Client Computer', 'IP Address', 'MAC Address', 'Serial Number', 'OS', 'Client User', 'Device Type', 'Device', 'Device VID', 'Device PID', 'Device Serial', 'EPP Client Version', 'File Name', 'File Hash', 'File Type', 'File Size', 'Justification', 'Time Interval', 'Date/Time(Server)', 'Date/Time(Client)', 'Date/Time(Server UTC)', 'Date/Time(Client UTC)', 'Shadow Exists', 'Repository Type'] -%}
{%- set parts = [] -%}
{%- for k in order -%}{%- do parts.append('[' ~ k ~ '] ' ~ native[k]) -%}{%- endfor -%}
{%- set log_type = 'Device Control – ' ~ r.ev -%}
{%- set ecs_ev = {
  'Connected': [['host'], ['start'], 'success'],
  'Disconnected': [['host'], ['end'], 'success'],
  'Blocked': [['host'], ['denied'], 'failure'],
  'File Read': [['file'], ['access'], 'success'],
  'File Write': [['file'], ['change'], 'success'],
  'File Delete': [['file'], ['deletion'], 'success']
}[r.ev] -%}
{%- set event = {
  '@timestamp': client.strftime('%Y-%m-%dT%H:%M:%SZ'),
  'ecs': {'version': '8.17.0'},
  'event': {'kind': 'event', 'category': ecs_ev[0], 'type': ecs_ev[1], 'outcome': ecs_ev[2], 'action': r.ev | lower | replace(' ', '_'), 'dataset': 'endpoint_protector.device_control', 'module': 'endpoint_protector', 'id': native['Log ID'], 'original': log_type ~ ': ' ~ parts | join(' | ')},
  'message': log_type,
  'observer': {'name': params.epp_server, 'product': 'Endpoint Protector', 'vendor': 'Netwrix', 'version': '5.9.4'},
  'host': {'name': u.host, 'ip': [u.ip], 'mac': [u.mac], 'os': {'name': u.os}},
  'user': {'name': u.name},
  'source': {'ip': u.ip},
  'related': {'hosts': [u.host], 'ip': [u.ip], 'user': [u.name]},
  'endpoint_protector': {'device_control': {'fields': native}}
} -%}
{%- if f -%}
  {%- do event.update({'file': {'path': native['File Name'], 'name': f.path.split('\\')[-1], 'extension': f.ext, 'size': f.size}}) -%}
{%- endif -%}
{{- event | tojson -}}
