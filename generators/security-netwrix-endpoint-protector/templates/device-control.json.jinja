{%- for flag in ['next_routine_file', 'next_routine_disconnected', 'next_routine_connected', 'next_anomaly_connected', 'next_anomaly_write_first', 'next_anomaly_write_second', 'next_anomaly_disconnected'] -%}{%- do shared.pop(flag, none) -%}{%- endfor -%}
{%- set kind = vars.kind -%}
{%- if kind == 'routine_connected' -%}
  {%- set cycle = shared.get('routine_count', 0) -%}
  {%- set index = (cycle % 4) + 1 -%}
  {%- if index == 1 -%}
    {%- do shared.set('client_computer', params.suspect_computer) -%}
    {%- do shared.set('client_ip', params.suspect_client_ip) -%}
    {%- do shared.set('client_user', params.suspect_user) -%}
    {%- do shared.set('device_serial', params.suspect_device_serial) -%}
    {%- do shared.set('client_mac', '02-1A-11-42-27-77') -%}
    {%- do shared.set('computer_serial', 'WS-SN-2077') -%}
  {%- else -%}
    {%- do shared.set('client_computer', 'OPS-WS-0' ~ index) -%}
    {%- do shared.set('client_ip', '10.50.4.' ~ (20 + index)) -%}
    {%- do shared.set('client_user', 'operator' ~ index) -%}
    {%- do shared.set('device_serial', 'USB-MANAGED-00' ~ index) -%}
    {%- do shared.set('client_mac', '02-1A-11-42-27-0' ~ index) -%}
    {%- do shared.set('computer_serial', 'WS-SN-20' ~ index) -%}
  {%- endif -%}
  {%- do shared.set('next_routine_file', true) -%}
  {%- set event_name = 'Connected' -%}
  {%- set file_name = '' -%}
  {%- set file_type = '' -%}
  {%- set file_size = '' -%}
  {%- set file_hash = '' -%}
{%- elif kind == 'routine_file' -%}
  {%- do shared.set('next_routine_disconnected', true) -%}
  {%- set cycle = shared.get('routine_count', 0) -%}
  {%- if cycle % 4 == 0 -%}
    {%- set event_name = 'File Write' -%}
    {%- if cycle % 8 == 0 -%}
      {%- set file_name = 'E:/exports/payroll-q3.csv' -%}
      {%- set file_type = 'CSV' -%}
      {%- set file_size = '17892480' -%}
      {%- set file_hash = '98f13708210194c475687be6106a3b84' -%}
    {%- else -%}
      {%- set file_name = 'E:/exports/customer-export.zip' -%}
      {%- set file_type = 'ZIP' -%}
      {%- set file_size = '43122688' -%}
      {%- set file_hash = '415290769594460e2e485922904f345d' -%}
    {%- endif -%}
  {%- else -%}
    {%- set event_name = 'File Read' -%}
    {%- set file_name = 'E:/manuals/operations-guide.pdf' -%}
    {%- set file_type = 'PDF' -%}
    {%- set file_size = '244800' -%}
    {%- set file_hash = 'cfcd208495d565ef66e7dff9f98764da' -%}
  {%- endif -%}
{%- elif kind == 'routine_disconnected' -%}
  {%- set cycle = shared.get('routine_count', 0) + 1 -%}
  {%- if cycle >= params.routine_sessions_before_chain -%}
    {%- do shared.set('routine_count', 0) -%}
    {%- do shared.set('next_anomaly_connected' if params.anomaly_mode else 'next_routine_connected', true) -%}
  {%- else -%}
    {%- do shared.set('routine_count', cycle) -%}
    {%- do shared.set('next_routine_connected', true) -%}
  {%- endif -%}
  {%- set event_name = 'Disconnected' -%}
  {%- set file_name = '' -%}
  {%- set file_type = '' -%}
  {%- set file_size = '' -%}
  {%- set file_hash = '' -%}
{%- elif kind == 'anomaly_connected' -%}
  {%- do shared.set('client_computer', params.suspect_computer) -%}
  {%- do shared.set('client_ip', params.suspect_client_ip) -%}
  {%- do shared.set('client_user', params.suspect_user) -%}
  {%- do shared.set('device_serial', params.suspect_device_serial) -%}
  {%- do shared.set('client_mac', '02-1A-11-42-27-77') -%}
  {%- do shared.set('computer_serial', 'WS-SN-2077') -%}
  {%- do shared.set('next_anomaly_write_first', true) -%}
  {%- set event_name = 'Connected' -%}
  {%- set file_name = '' -%}
  {%- set file_type = '' -%}
  {%- set file_size = '' -%}
  {%- set file_hash = '' -%}
{%- elif kind == 'anomaly_write_first' -%}
  {%- do shared.set('next_anomaly_write_second', true) -%}
  {%- set event_name = 'File Write' -%}
  {%- set file_name = 'E:/exports/payroll-q3.csv' -%}
  {%- set file_type = 'CSV' -%}
  {%- set file_size = '17892480' -%}
  {%- set file_hash = '98f13708210194c475687be6106a3b84' -%}
{%- elif kind == 'anomaly_write_second' -%}
  {%- do shared.set('next_anomaly_disconnected', true) -%}
  {%- set event_name = 'File Write' -%}
  {%- set file_name = 'E:/exports/customer-export.zip' -%}
  {%- set file_type = 'ZIP' -%}
  {%- set file_size = '43122688' -%}
  {%- set file_hash = '415290769594460e2e485922904f345d' -%}
{%- else -%}
  {%- do shared.set('next_routine_connected', true) -%}
  {%- set event_name = 'Disconnected' -%}
  {%- set file_name = '' -%}
  {%- set file_type = '' -%}
  {%- set file_size = '' -%}
  {%- set file_hash = '' -%}
{%- endif -%}
{%- set client_computer = shared.get('client_computer') -%}
{%- set client_ip = shared.get('client_ip') -%}
{%- set client_user = shared.get('client_user') -%}
{%- set device_serial = shared.get('device_serial') -%}
{%- set field_order = ['Log ID', 'Event Name', 'Client Computer', 'IP Address', 'MAC Address', 'Serial Number', 'OS', 'Client User', 'Device Type', 'Device', 'Device VID', 'Device PID', 'Device Serial', 'EPP Client Version', 'File Name', 'File Hash', 'File Type', 'File Size', 'Justification', 'Time Interval', 'Date/Time(Server)', 'Date/Time(Client)', 'Date/Time(Server UTC)', 'Date/Time(Client UTC)', 'Shadow Exists', 'Repository Type'] -%}
{%- set native = {'Log ID': module.rand.crypto.uuid4() | replace('-', ''), 'Event Name': event_name, 'Client Computer': client_computer, 'IP Address': client_ip, 'MAC Address': shared.get('client_mac'), 'Serial Number': shared.get('computer_serial'), 'OS': 'Windows 11 Enterprise', 'Client User': client_user, 'Device Type': 'USB Storage', 'Device': 'USB Mass Storage Device', 'Device VID': '0781', 'Device PID': '5581', 'Device Serial': device_serial, 'EPP Client Version': '5.9.4', 'File Name': file_name, 'File Hash': file_hash, 'File Type': file_type, 'File Size': file_size, 'Justification': '', 'Time Interval': '', 'Date/Time(Server)': timestamp.strftime('%Y-%m-%d %H:%M:%S'), 'Date/Time(Client)': timestamp.strftime('%Y-%m-%d %H:%M:%S'), 'Date/Time(Server UTC)': timestamp.strftime('%Y-%m-%dT%H:%M:%SZ'), 'Date/Time(Client UTC)': timestamp.strftime('%Y-%m-%dT%H:%M:%SZ'), 'Shadow Exists': 'No', 'Repository Type': ''} -%}
{%- set components = [] -%}
{%- for field in field_order -%}{%- do components.append('[' ~ field ~ '] ' ~ native[field]) -%}{%- endfor -%}
{%- set original = 'Device Control – ' ~ event_name ~ ': ' ~ (components | join(' | ')) -%}
{%- set is_file = event_name in ['File Read', 'File Write'] -%}
{%- set ecs_category = ['file'] if is_file else ['host'] -%}
{%- set ecs_type = ['access'] if event_name == 'File Read' else (['change'] if event_name == 'File Write' else (['start'] if event_name == 'Connected' else ['end'])) -%}
{%- set payload = {'@timestamp': timestamp.isoformat(), 'ecs': {'version': '8.17.0'}, 'event': {'kind': 'event', 'category': ecs_category, 'type': ecs_type, 'outcome': 'success', 'dataset': 'endpoint_protector.device_control', 'module': 'endpoint_protector', 'action': event_name | lower | replace(' ', '_'), 'original': original, 'id': native['Log ID']}, 'observer': {'name': params.epp_server, 'product': 'Endpoint Protector', 'vendor': 'Netwrix', 'version': '5.9.4'}, 'host': {'name': client_computer, 'ip': [client_ip]}, 'user': {'name': client_user}, 'related': {'hosts': [client_computer, params.epp_server], 'ip': [client_ip], 'user': [client_user]}, 'source': {'ip': client_ip}, 'message': 'Device Control – ' ~ event_name, 'endpoint_protector': {'device_control': {'fields': native, 'device_serial': device_serial}}} -%}
{%- if is_file -%}
  {%- do payload.update({'file': {'path': file_name, 'size': file_size | int, 'extension': file_type | lower}}) -%}
{%- endif -%}
{{- payload | tojson -}}
