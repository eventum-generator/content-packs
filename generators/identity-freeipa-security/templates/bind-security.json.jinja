{%- set previous_time = shared.get('previous_time') -%}
{%- set event_time = timestamp if previous_time is none or timestamp > previous_time else previous_time + module.datetime.timedelta(seconds=1) -%}
{%- do shared.set('previous_time', event_time) -%}
{%- set interval = params.anomaly_interval_events | int -%}
{%- set tick = (shared.get('tick', 0) + 1) % (interval + 4) -%}
{%- do shared.set('tick', tick) -%}
{%- set chain = params.anomaly_mode and tick >= interval -%}
{%- set step = tick - interval if chain else -1 -%}
{%- set conn_id = (shared.get('conn_id', 0) % 2147483646) + 1 -%}
{%- do shared.set('conn_id', conn_id) -%}
{%- if chain -%}
  {%- set dn = 'cn=Directory Manager' -%}
  {%- set client_ip = params.suspicious_ip -%}
  {%- set success = step == 3 -%}
  {%- set root_dn = true -%}
{%- else -%}
  {%- set uid = module.rand.choice(['anna.ivanova', 'pavel.smirnov', 'svc-monitor', 'olga.kim', 'dmitry.orlov']) -%}
  {%- set dn = 'uid=' ~ uid ~ ',cn=users,cn=accounts,' ~ params.directory_suffix -%}
  {%- set client_ip = module.rand.choice(['10.20.1.21', '10.20.1.22', '10.20.1.23', '10.20.1.24']) -%}
  {%- set success = module.rand.number.integer(1, 10) != 1 -%}
  {%- set root_dn = false -%}
{%- endif -%}
{%- set event_name = 'BIND_SUCCESS' if success else 'BIND_FAILED' -%}
{%- set msg = '' if success else 'INVALID_PASSWORD' -%}
{%- set date = '[' ~ event_time.strftime('%d/%b/%Y:%H:%M:%S.%f') ~ '000 ' ~ event_time.strftime('%z') ~ ']' -%}
{%- set utc_time = '%.9f' | format(event_time.timestamp()) -%}
{%- set raw -%}{"date":{{ date | tojson }},"utc_time":{{ utc_time | tojson }},"event":{{ event_name | tojson }},"dn":{{ dn | tojson }},"bind_method":"SIMPLE","root_dn":{{ root_dn | tojson }},"client_ip":{{ client_ip | tojson }},"server_ip":{{ params.server_ip | tojson }},"ldap_version":3,"conn_id":{{ conn_id }},"op_id":0,"msg":{{ msg | tojson }}}{%- endset -%}
{"@timestamp":{{ event_time.isoformat() | tojson }},"ecs":{"version":"8.17.0"},"event":{"kind":"event","module":"freeipa","dataset":"freeipa.security","action":{{ event_name | lower | tojson }},"category":["authentication"],"type":["start"],"outcome":{{ ('success' if success else 'failure') | tojson }},"original":{{ raw | tojson }}},"host":{"name":{{ params.server_host | tojson }},"ip":[{{ params.server_ip | tojson }}]},"source":{"ip":{{ client_ip | tojson }}},"user":{"name":{{ dn | tojson }}},"freeipa":{"security":{"event":{{ event_name | tojson }},"dn":{{ dn | tojson }},"bind_method":"SIMPLE","root_dn":{{ root_dn | tojson }},"conn_id":{{ conn_id }},"op_id":0,"msg":{{ msg | tojson }}}}}
