{%- for flag in ['to_start', 'to_chunk_1', 'to_chunk_2', 'to_chunk_3', 'to_chunk_4', 'to_done', 'to_routine'] -%}{%- do shared.pop(flag, none) -%}{%- endfor -%}
{%- set stage = vars.stage -%}
{%- if stage == 'routine' -%}
  {%- set count = shared.get('routine_count', 0) + 1 -%}
  {%- if count >= 48 -%}
    {%- do shared.set('routine_count', 0) -%}
    {%- if params.anomaly_mode -%}
      {%- do shared.set('chain_id', module.rand.string.hex(8)) -%}
      {%- do shared.set('to_start', true) -%}
    {%- endif -%}
  {%- else -%}{%- do shared.set('routine_count', count) -%}{%- endif -%}
  {%- set qtype = module.rand.weighted_choice(['A', 'AAAA', 'MX'], [70, 20, 10]) -%}
  {%- set qname = module.rand.choice(['www.example.test', 'mail.example.test', 'updates.example.test', 'vpn.example.test']) -%}
  {%- set client_ip = module.rand.choice(['10.20.40.11', '10.20.40.12', '10.20.40.13']) -%}
{%- else -%}
  {%- set client_ip = params.suspect_ip -%}
  {%- if stage == 'start' -%}
    {%- set qtype = 'A' -%}
    {%- set qname = 'start.' ~ shared.get('chain_id') ~ '.' ~ params.tunnel_domain -%}
    {%- do shared.set('to_chunk_1', true) -%}
  {%- elif stage.startswith('chunk_') -%}
    {%- set qtype = 'TXT' -%}
    {%- set qname = module.rand.string.hex(48) ~ '.' ~ shared.get('chain_id') ~ '.' ~ params.tunnel_domain -%}
    {%- set chunk = stage[-1] | int -%}
    {%- do shared.set('to_chunk_' ~ (chunk + 1), true) if chunk < 4 else shared.set('to_done', true) -%}
  {%- else -%}
    {%- set qtype = 'A' -%}
    {%- set qname = 'done.' ~ shared.get('chain_id') ~ '.' ~ params.tunnel_domain -%}
    {%- do shared.set('to_routine', true) -%}
    {%- do shared.pop('chain_id', none) -%}
  {%- endif -%}
{%- endif -%}
{%- set client_port = module.rand.number.integer(10000, 59999) -%}
{%- set client_object = module.rand.string.hex(8) -%}
{%- set stamp = timestamp.strftime('%Y-%m-%dT%H:%M:%S.%f')[:23] -%}
{%- set original = stamp ~ ' client @0x' ~ client_object ~ ' ' ~ client_ip ~ '#' ~ client_port ~ ' (' ~ qname ~ '): query: ' ~ qname ~ ' IN ' ~ qtype ~ ' - (' ~ params.server_ip ~ ')' -%}
{%- set payload = {'@timestamp': timestamp.isoformat(), 'ecs': {'version': '8.17.0'}, 'event': {'kind': 'event', 'category': ['network'], 'type': ['protocol'], 'action': 'dns-query', 'original': original}, 'host': {'name': params.host_name}, 'source': {'ip': client_ip, 'port': client_port}, 'destination': {'ip': params.server_ip, 'port': 53}, 'network': {'protocol': 'dns', 'transport': 'udp'}, 'dns': {'type': 'query', 'question': {'name': qname, 'class': 'IN', 'type': qtype}}, 'related': {'ip': [client_ip, params.server_ip]}, 'bind9': {'query': {'client_object': '@0x' ~ client_object, 'flags': '-'}}} -%}
{{- payload | tojson -}}
