{#- One S-Terra Gate 4.1 remote-access concentrator: vpnsvc syslog lines
    for S-Terra Client users behind branch-office NAT addresses and
    mobile-carrier NAT. The input sets the line rate and its hour-of-day
    curve; every timestamp is one line. A timestamp carries the earliest
    due queued line (the rest of a connection, a session end, a retry,
    an episode step), logged at its own due time; when nothing is due
    an idle user starts a new connection attempt, drawn by activity
    weight. The anomaly episode picks idle users as background does and
    never touches a running session. -#}
{%- set now = timestamp.timestamp() | int -%}
{%- set utc = module.datetime.timezone.utc -%}
{%- set interval = params.anomaly_interval_hours | float -%}
{%- set window = 2700 -%}
{%- set sels = {
    'office': ['10.20.0.0/16', 'IPsec:Protect:RA-MAP:10:OFFICE-NET', 'IPsecAction:RA-MAP:10'],
    'mgmt': ['10.0.10.0/24', 'IPsec:Protect:RA-MAP:20:MGMT-NET', 'IPsecAction:RA-MAP:20']} -%}
{#- Episode users A and B come from the busier users of the site, so
    each of them connects from the site address many times in every
    few days of ordinary traffic. -#}
{%- set ep_min_w = 1.3 -%}

{#- Relative line rate by Moscow hour (UTC+3); the curve of patterns/. -#}
{%- macro hload(t) -%}
  {%- set h = ((t | int) // 3600 + 3) % 24 -%}
  {{- [0.12, 0.12, 0.12, 0.12, 0.12, 0.12, 0.12, 0.38, 0.55, 0.8, 0.8, 0.8,
      0.8, 0.8, 0.8, 0.8, 0.8, 0.8, 0.55, 0.45, 0.38, 0.3, 0.22, 0.16][h] -}}
{%- endmacro -%}

{%- macro gap(median, sigma) -%}
  {{- [module.random.lognormvariate(module.math.log(median), sigma) | round | int, 1] | max -}}
{%- endmacro -%}

{%- if not shared.get('initialized', false) -%}
  {%- if not (2 <= interval <= 8760) -%}{{ module.math.sqrt(-1) }}{%- endif -%}
  {#- A fixed estate: per-user activity weight and failure propensity
      come from a fixed seed, bounded so every user stays active; only
      behaviour is random. -#}
  {%- set rnd = module.random.Random(4186) -%}
  {%- set sites = [] -%}
  {%- set site_idx = {} -%}
  {%- for row in samples.sites -%}
    {%- do site_idx.update({row.site: loop.index0}) -%}
    {%- do sites.append({'ip': row.address, 'members': [], 'admins': [], 'ab': []}) -%}
  {%- endfor -%}
  {%- set pools = {} -%}
  {%- for row in samples.carriers -%}
    {%- do pools.setdefault(row.carrier, []).append(row.address) -%}
  {%- endfor -%}
  {%- set carriers = pools.values() | list -%}
  {%- set users = [] -%}
  {%- set cum = [] -%}
  {%- set acc = namespace(t=0.0) -%}
  {%- for row in samples.users -%}
    {%- set admin = row.role == 'admin' -%}
    {%- set w = rnd.uniform(3.5, 4.5) if admin else [[rnd.lognormvariate(0, 0.6), 0.35] | max, 3.0] | min -%}
    {%- set s = site_idx[row.site] -%}
    {%- set u = users | length -%}
    {%- do users.append({'id': row.login ~ '@' ~ params.user_domain, 'site': s, 'w': w,
        'admin': admin, 'busy': false, 'car': rnd.randrange(carriers | length),
        'fail': [rnd.lognormvariate(module.math.log(0.04), 0.7), 0.3] | min}) -%}
    {%- set acc.t = acc.t + w -%}
    {%- do cum.append(acc.t) -%}
    {%- do sites[s].members.append(u) -%}
    {%- if admin -%}{%- do sites[s].admins.append(u) -%}
    {%- elif w >= ep_min_w -%}{%- do sites[s].ab.append(u) -%}{%- endif -%}
  {%- endfor -%}
  {#- IKECFG pool 10.99.0.0/21 (hosts .10-.249 of each /24). -#}
  {%- set pool = [] -%}
  {%- for a in range(8) -%}{%- for b in range(10, 250) -%}{%- do pool.append('10.99.' ~ a ~ '.' ~ b) -%}{%- endfor -%}{%- endfor -%}
  {%- do shared.update({'initialized': true, 'users': users, 'cum': cum, 'sites': sites,
      'carriers': carriers, 'pool': pool, 'inuse': {}, 'heap': [], 'fh': {},
      'ctr': {'seq': 0, 'id': rnd.randint(200, 9000), 'last': 0, 'total': acc.t},
      'ep': {'start_at': none, 'retry': 0, 'active': false, 'last_c': none, 'last_p': none}}) -%}
{%- endif -%}
{%- set users = shared.get('users') -%}
{%- set cum = shared.get('cum') -%}
{%- set sites = shared.get('sites') -%}
{%- set carriers = shared.get('carriers') -%}
{%- set pool = shared.get('pool') -%}
{%- set inuse = shared.get('inuse') -%}
{%- set heap = shared.get('heap') -%}
{%- set fh = shared.get('fh') -%}
{%- set ctr = shared.get('ctr') -%}
{%- set ep = shared.get('ep') -%}

{#- Holder for a process built by new_session / new_series. -#}
{%- set ns_new = {'p': none} -%}

{%- macro push(at, proc) -%}
  {%- do ctr.update({'seq': ctr.seq + 1}) -%}
  {%- do module.heapq.heappush(heap, [at | int, ctr.seq, proc]) -%}
{%- endmacro -%}

{%- macro next_id() -%}
  {%- do ctr.update({'id': ctr.id + 1}) -%}
  {{- ctr.id -}}
{%- endmacro -%}

{#- A NAT source port not already used by a live attempt from `ip`. -#}
{%- macro take_port(ip) -%}
  {%- set r = namespace(p=0) -%}
  {%- for i in range(16) -%}
    {%- set r.p = module.random.randint(1024, 65000) -%}
    {%- if (ip ~ ':' ~ r.p) not in inuse -%}{%- break -%}{%- endif -%}
  {%- endfor -%}
  {%- do inuse.update({ip ~ ':' ~ r.p: 1}) -%}
  {{- r.p -}}
{%- endmacro -%}

{#- Distinct identities that failed from `ip` within the chain window
    before `t`; older entries are removed. -#}
{%- macro failed_ids(ip, t) -%}
  {%- set h = fh.get(ip) -%}
  {%- set r = namespace(n=0) -%}
  {%- if h -%}
    {%- for k in h | list -%}
      {%- if h[k] < t - window -%}{%- do h.pop(k) -%}{%- else -%}{%- set r.n = r.n + 1 -%}{%- endif -%}
    {%- endfor -%}
    {%- if not h -%}{%- do fh.pop(ip) -%}{%- endif -%}
  {%- endif -%}
  {{- r.n -}}
{%- endmacro -%}

{#- Draw an idle user by activity weight: rejection sampling over the
    cumulative weights, then a scan. -#}
{%- macro draw() -%}
  {%- set r = namespace(u=-1) -%}
  {%- for i in range(256) -%}
    {%- set j = [module.bisect.bisect_right(cum, module.random.random() * ctr.total), cum | length - 1] | min -%}
    {%- if not users[j].busy -%}{%- set r.u = j -%}{%- break -%}{%- endif -%}
  {%- endfor -%}
  {%- if r.u < 0 -%}
    {%- for j in range(users | length) if not users[j].busy -%}
      {%- if r.u < 0 -%}{%- set r.u = j -%}{%- endif -%}
    {%- endfor -%}
  {%- endif -%}
  {{- r.u -}}
{%- endmacro -%}

{#- Weighted pick of a user index from a candidate list, -1 if empty. -#}
{%- macro wpick(cands) -%}
  {%- if cands -%}
    {%- set w = [] -%}
    {%- for c in cands -%}{%- do w.append(users[c].w) -%}{%- endfor -%}
    {{- module.rand.weighted_choice(cands, w) -}}
  {%- else -%}-1{%- endif -%}
{%- endmacro -%}

{#- A new ISAKMP session of user u; administrators often open the
    management tunnel, sometimes together with the office tunnel. -#}
{%- macro new_session(u, ip, port, is_ep) -%}
  {%- set user = users[u] -%}
  {%- set plan = ['office'] -%}
  {%- if user.admin and (is_ep or module.random.random() < 0.8) -%}
    {%- set plan = ['mgmt', 'office'] if module.random.random() < 0.5 else ['mgmt'] -%}
  {%- endif -%}
  {%- do ns_new.update({'p': {'t': 'sess', 'u': u, 'ip': ip, 'port': port, 'ep': is_ep,
      'ph': 'created', 'plan': plan, 'i': 0, 'm': 0, 'sas': [],
      'dur': [[gap(5400 / user.w ** 0.5, 0.9) | int, 28800] | min, 60] | max}}) -%}
{%- endmacro -%}

{#- A series of k failed attempts (retry gaps from the same law as
    every other retry); `ok` decides whether a session follows. -#}
{%- macro new_series(u, ip, port, k, ok) -%}
  {%- set gaps = [] -%}
  {%- for i in range(k - 1) -%}{%- do gaps.append(gap(35, 0.9) | int) -%}{%- endfor -%}
  {%- do ns_new.update({'p': {'t': 'fail', 'u': u, 'ip': ip, 'port': port, 'gaps': gaps, 'ok': ok}}) -%}
{%- endmacro -%}

{%- macro user_ip(u) -%}
  {{- sites[users[u].site].ip if module.random.random() < 0.8 else module.random.choice(carriers[users[u].car]) -}}
{%- endmacro -%}

{#- 1. Episode scheduling, by source time. The first start falls within
    min(interval, 24 h) of the first line, its hour drawn from the
    hour-of-day curve. Each later start is due one interval after the
    actual previous start and falls in a window of
    w = min(interval / 4, 6 h) centred on the due time, weighted by the
    squared curve plus a small floor. -#}
{%- macro pick_start(lo, hi, squared) -%}
  {%- set s = namespace(slots=[], w=[]) -%}
  {%- set top = lo - lo % 3600 -%}
  {%- for k in range((hi - top) // 3600 + 1) -%}
    {%- set a = [top + k * 3600, lo] | max -%}
    {%- set b = [top + (k + 1) * 3600, hi] | min -%}
    {%- if b > a -%}
      {%- set h = hload(a) | float -%}
      {%- set s.slots = s.slots + [[a, b]] -%}
      {%- set s.w = s.w + [((h * h + 0.02) if squared else h) * (b - a)] -%}
    {%- endif -%}
  {%- endfor -%}
  {%- set slot = module.rand.weighted_choice(s.slots, s.w) -%}
  {{- module.random.randint(slot[0], slot[1] - 1) -}}
{%- endmacro -%}
{%- if params.anomaly_mode and ep.start_at is none -%}
  {%- do ep.update({'start_at': pick_start(now, now + ([interval, 24] | min * 3600) | int, false) | int}) -%}
{%- endif -%}
{%- if params.anomaly_mode and not ep.active and now >= ep.start_at and now >= ep.retry -%}
  {#- Episode, all from one branch address P: failed attempts of an
      identity A, then of another identity B, then administrator C of
      that branch opens the management tunnel. C and the site are drawn
      by background weight among idle administrators, not repeating the
      previous administrator or address; A and B are drawn later, when
      their step comes, among idle busier users of the site. -#}
  {%- set cands = [] -%}
  {%- for s in sites if s.admins and s.ip != ep.last_p -%}
    {%- set n_ab = namespace(n=0) -%}
    {%- for a in s.ab if not users[a].busy -%}{%- set n_ab.n = n_ab.n + 1 -%}{%- endfor -%}
    {%- if n_ab.n >= 2 -%}
      {%- for c in s.admins if not users[c].busy and c != ep.last_c -%}{%- do cands.append(c) -%}{%- endfor -%}
    {%- endif -%}
  {%- endfor -%}
  {%- set c = wpick(cands) | int -%}
  {%- if c >= 0 -%}
    {{- push(now, {'t': 'ep', 'stage': 'A', 'site': users[c].site, 'c': c, 't0': now, 'a': none}) -}}
    {%- set due = now + (interval * 3600) | int -%}
    {%- set half = (([interval / 4, 6] | min) * 1800) | int -%}
    {%- do ep.update({'active': true, 'last_p': sites[users[c].site].ip,
        'start_at': pick_start([due - half, now + 1] | max, [due + half, now + 2] | max, true) | int}) -%}
  {%- else -%}
    {%- do ep.update({'retry': now + 60}) -%}
  {%- endif -%}
{%- endif -%}

{#- 2. Background: about once or twice a day a site-wide problem (an
    expired CRL, a NAT change) makes idle users behind one branch
    address fail within minutes; most of them connect later. -#}
{%- if module.random.random() < 0.00004 -%}
  {%- set sizes = [] -%}
  {%- for s in sites -%}{%- do sizes.append(s.members | length) -%}{%- endfor -%}
  {%- set si = module.rand.weighted_choice(range(sites | length) | list, sizes) -%}
  {%- set idle = [] -%}
  {%- for u in sites[si].members if not users[u].busy -%}{%- do idle.append(u) -%}{%- endfor -%}
  {%- if idle | length >= 2 -%}
    {%- set hit = module.random.sample(idle, 2) -%}
    {%- for u in idle if u not in hit and module.random.random() < 0.04 -%}{%- do hit.append(u) -%}{%- endfor -%}
    {%- for u in hit -%}
      {%- do users[u].update({'busy': true}) -%}
      {%- set ip = sites[si].ip -%}
      {{- new_series(u, ip, take_port(ip) | int, module.rand.weighted_choice([1, 2, 3], [50, 32, 18]),
          module.random.random() < 0.6) -}}
      {{- push(now + gap(420, 1.2) | int, ns_new.p) -}}
    {%- endfor -%}
  {%- endif -%}
{%- endif -%}

{#- 3. Take the earliest due queued line, logged at its own due time or
    right after the previous line if that is later. An episode step
    turns into the first line of its user's attempt. -#}
{%- set ns = namespace(p=none, t=now) -%}
{%- for i in range(16) -%}
  {%- if not heap or heap[0][0] > now -%}{%- break -%}{%- endif -%}
  {%- set entry = module.heapq.heappop(heap) -%}
  {%- set d = [entry[0], ctr.last] | max -%}
  {%- set p = entry[2] -%}
  {%- if p.t != 'ep' -%}
    {%- set ns.p = p -%}{%- set ns.t = d -%}{%- break -%}
  {%- endif -%}
  {%- set site = sites[p.site] -%}
  {%- if p.stage in ['A', 'B'] -%}
    {%- set cands = [] -%}
    {%- for a in site.ab if not users[a].busy -%}{%- do cands.append(a) -%}{%- endfor -%}
    {%- set a = wpick(cands) | int -%}
    {%- if a >= 0 -%}
      {%- do users[a].update({'busy': true}) -%}
      {{- new_series(a, site.ip, take_port(site.ip) | int,
          module.rand.weighted_choice([1, 2, 3, 4], [45, 30, 15, 10]), module.random.random() < 0.75) -}}
      {%- set t0 = d if p.stage == 'A' else p.t0 -%}
      {%- set end = d + ns_new.p.gaps | sum -%}
      {%- if p.stage == 'A' -%}
        {{- push([end + gap(60, 1.0) | int, t0 + 1200] | min,
            {'t': 'ep', 'stage': 'B', 'site': p.site, 'c': p.c, 't0': t0}) -}}
      {%- else -%}
        {{- push([d + 5, [end + gap(150, 0.8) | int, t0 + 2000] | min] | max,
            {'t': 'ep', 'stage': 'C', 'site': p.site, 'c': p.c, 't0': t0}) -}}
      {%- endif -%}
      {%- set ns.p = ns_new.p -%}{%- set ns.t = d -%}{%- break -%}
    {%- elif d < p.t0 + 1800 -%}
      {{- push(d + 30, p) -}}
    {%- else -%}
      {%- do ep.update({'active': false, 'retry': now + 60}) -%}
    {%- endif -%}
  {%- else -%}
    {%- set c = p.c if not users[p.c].busy else -1 -%}
    {%- if c < 0 -%}
      {%- set cands = [] -%}
      {%- for x in site.admins if not users[x].busy and x != ep.last_c -%}{%- do cands.append(x) -%}{%- endfor -%}
      {%- set c = wpick(cands) | int -%}
    {%- endif -%}
    {%- if c >= 0 -%}
      {%- do users[c].update({'busy': true}) -%}
      {{- new_session(c, site.ip, take_port(site.ip) | int, true) -}}
      {%- do ep.update({'active': false, 'last_c': c}) -%}
      {%- set ns.p = ns_new.p -%}{%- set ns.t = d -%}{%- break -%}
    {%- elif d < p.t0 + 2400 -%}
      {{- push(d + 20, p) -}}
    {%- else -%}
      {%- do ep.update({'active': false, 'retry': now + 60}) -%}
    {%- endif -%}
  {%- endif -%}
{%- endfor -%}
{%- if ns.p is none -%}
  {#- Nothing due: an idle user starts a connection attempt. -#}
  {%- set u = draw() | int -%}
  {%- do users[u].update({'busy': true}) -%}
  {%- set ip = user_ip(u) -%}
  {%- set port = take_port(ip) | int -%}
  {%- if module.random.random() < users[u].fail -%}
    {{- new_series(u, ip, port, module.rand.weighted_choice([1, 2, 3, 4], [45, 30, 15, 10]),
        module.random.random() < 0.75) -}}
  {%- else -%}
    {{- new_session(u, ip, port, false) -}}
  {%- endif -%}
  {%- set ns.p = ns_new.p -%}
{%- endif -%}

{#- 4. Emit the line of this step and queue the next one. -#}
{%- set p = ns.p -%}
{%- set t = ns.t -%}
{%- do ctr.update({'last': t}) -%}
{%- set user = users[p.u] -%}
{%- set e = {'uid': user.id, 'ip': p.ip, 'port': p.port} -%}
{%- if p.t == 'fail' -%}
  {%- do e.update({'kind': 'fail'}) -%}
  {%- set _ = failed_ids(p.ip, t) -%}
  {%- do fh.setdefault(p.ip, {}).update({user.id: t}) -%}
  {%- if p.gaps -%}
    {{- push(t + p.gaps.pop(0), p) -}}
  {%- elif p.ok -%}
    {{- new_session(p.u, p.ip, p.port, false) -}}
    {{- push(t + gap(60, 1.0) | int, ns_new.p) -}}
  {%- else -%}
    {%- do inuse.pop(p.ip ~ ':' ~ p.port, none) -%}
    {%- do user.update({'busy': false}) -%}
  {%- endif -%}
{%- elif p.ph == 'created' -%}
  {%- do p.update({'n': next_id() | int, 'ph': 'cfg'}) -%}
  {%- do e.update({'kind': 'created', 'isakmp': p.n}) -%}
  {{- push(t + module.random.randint(0, 1), p) -}}
{%- elif p.ph == 'cfg' -%}
  {%- set cfg = pool.pop(module.random.randrange(pool | length)) -%}
  {%- do p.update({'cfg': cfg, 'm': p.m + 1, 'ph': 'est'}) -%}
  {%- do e.update({'kind': 'cfg', 'isakmp': p.n, 'm': p.m, 'cfg': cfg}) -%}
  {{- push(t + module.random.randint(0, 2), p) -}}
{%- elif p.ph == 'est' -%}
  {#- Guard on the final chain step only: an ordinary management tunnel
      from an address where two different identities failed within the
      chain window goes to the office network instead. -#}
  {%- if p.i == 0 and not p.ep and p.plan[0] == 'mgmt' and (failed_ids(p.ip, t) | int) >= 2 -%}
    {%- do p.update({'plan': ['office']}) -%}
  {%- endif -%}
  {%- set k = next_id() | int -%}
  {%- do p.sas.append(k) -%}
  {%- do p.update({'m': p.m + 1}) -%}
  {%- do e.update({'kind': 'est', 'isakmp': p.n, 'm': p.m, 'cfg': p.cfg, 'ipsec': k, 'sel': sels[p.plan[p.i]]}) -%}
  {%- if p.i + 1 < p.plan | length -%}
    {%- do p.update({'i': p.i + 1}) -%}
    {{- push(t + module.random.randint(0, 2), p) -}}
  {%- else -%}
    {%- do p.update({'i': 0, 'ph': 'del'}) -%}
    {{- push(t + p.dur, p) -}}
  {%- endif -%}
{%- elif p.ph == 'del' -%}
  {%- do p.update({'m': p.m + 1, 'ph': 'closed'}) -%}
  {%- do e.update({'kind': 'del_ipsec', 'isakmp': p.n, 'm': p.m, 'ipsec': p.sas[p.i]}) -%}
  {{- push(t + module.random.randint(0, 1), p) -}}
{%- elif p.ph == 'closed' -%}
  {%- set rx = gap(p.dur * 900, 1.2) | int -%}
  {%- do e.update({'kind': 'closed_ipsec', 'isakmp': p.n, 'ipsec': p.sas[p.i], 'rx': rx,
      'tx': (rx * module.random.lognormvariate(module.math.log(4), 0.8)) | int}) -%}
  {%- if p.i + 1 < p.sas | length -%}
    {%- do p.update({'i': p.i + 1, 'ph': 'del'}) -%}
    {{- push(t + module.random.randint(0, 1), p) -}}
  {%- else -%}
    {%- do p.update({'ph': 'del_isakmp'}) -%}
    {{- push(t + module.random.randint(0, 2), p) -}}
  {%- endif -%}
{%- elif p.ph == 'del_isakmp' -%}
  {%- do p.update({'m': p.m + 1, 'ph': 'closed_isakmp'}) -%}
  {%- do e.update({'kind': 'del_isakmp', 'isakmp': p.n, 'm': p.m}) -%}
  {{- push(t + module.random.randint(0, 1), p) -}}
{%- else -%}
  {%- do e.update({'kind': 'closed_isakmp', 'isakmp': p.n}) -%}
  {%- do pool.append(p.cfg) -%}
  {%- do inuse.pop(p.ip ~ ':' ~ p.port, none) -%}
  {%- do user.update({'busy': false}) -%}
{%- endif -%}

{%- set uid = e.uid -%}
{%- set peer = e.ip ~ ':' ~ e.port -%}
{%- if e.kind == 'fail' -%}
  {%- set msg = ['0010011C', 'MSG_ID_LP_INCOMING_CONNECTION_FAILURE', 'LP', 'ERR', none,
      'Incoming connection failed. Peer ' ~ peer ~ ', id "' ~ uid ~ '"'] -%}
{%- elif e.kind == 'created' -%}
  {%- set msg = ['10000005', 'MSG_ID_IKE_SA_CREATED', 'IKE', 'INFO', none,
      'ISAKMP connection ' ~ e.isakmp ~ ' created, peer ' ~ peer ~ ', id "' ~ uid ~ '"'] -%}
{%- elif e.kind == 'cfg' -%}
  {%- set msg = ['10002001', 'MSG_ID_IKE_IKECFG_ASSIGNED', 'IKE', 'INFO', e.m,
      'IKECFG address ' ~ e.cfg ~ ' assigned to peer ' ~ peer ~ ', id "' ~ uid ~ '", proxy ARP enabled'] -%}
{%- elif e.kind == 'est' -%}
  {%- set sel = e.sel -%}
  {%- set msg = ['00100119', 'MSG_ID_LP_HOST_CONNECTED', 'LP', 'NOTICE', e.m,
      'IPSec connection ' ~ e.ipsec ~ ' established, traffic selector ' ~ e.cfg ~ '->' ~ sel[0]
      ~ ', peer ' ~ peer ~ ', id "' ~ uid ~ '", Filter ' ~ sel[1] ~ ', IPsecAction ' ~ sel[2]
      ~ ', IKERule IKERule:RA-MAP:10'] -%}
{%- elif e.kind == 'del_ipsec' -%}
  {%- set msg = ['1000001A', 'MSG_ID_IKE_DELETION_RECV', 'IKE', 'INFO', e.m,
      'Received deletion for IPSec connection ' ~ e.ipsec ~ ' - ESP'] -%}
{%- elif e.kind == 'closed_ipsec' -%}
  {%- set msg = ['0010011D', 'MSG_ID_LP_CONNECTION_CLOSED', 'LP', 'NOTICE', none,
      'IPSec connection ' ~ e.ipsec ~ ' closed: ' ~ e.tx ~ ' bytes sent, ' ~ e.rx ~ ' received: deleted by peer'] -%}
{%- elif e.kind == 'del_isakmp' -%}
  {%- set msg = ['1000001A', 'MSG_ID_IKE_DELETION_RECV', 'IKE', 'INFO', e.m,
      'Received deletion for ISAKMP connection ' ~ e.isakmp] -%}
{%- else -%}
  {%- set msg = ['10000006', 'MSG_ID_IKE_SA_CLOSED', 'IKE', 'INFO', none,
      'ISAKMP connection ' ~ e.isakmp ~ ' closed, peer ' ~ peer ~ ', id "' ~ uid ~ '"'] -%}
{%- endif -%}
{%- set session_id = '<' ~ e.isakmp ~ ':' ~ msg[4] ~ '>' if msg[4] is not none else none -%}

{%- set dt = module.datetime.datetime.fromtimestamp(t, utc) -%}
{%- set clock = dt.strftime('%b') ~ ' ' ~ '%2d' | format(dt.day) ~ ' ' ~ dt.strftime('%H:%M:%S') -%}
{%- set raw = clock ~ ' ' ~ params.gateway_host ~ ' vpnsvc: ' ~ msg[0] ~ ' '
    ~ (session_id ~ ' ' if session_id else '') ~ msg[5] -%}
{%- set actions = {'fail': 'incoming-connection-failed', 'created': 'isakmp-connection-created',
    'cfg': 'ikecfg-address-assigned', 'est': 'ipsec-connection-established',
    'del_ipsec': 'deletion-received', 'closed_ipsec': 'ipsec-connection-closed',
    'del_isakmp': 'deletion-received', 'closed_isakmp': 'isakmp-connection-closed'} -%}
{%- set types = {'fail': ['start', 'connection'], 'created': ['start', 'connection'],
    'cfg': ['allowed', 'connection'], 'est': ['start', 'connection'],
    'del_ipsec': ['info'], 'closed_ipsec': ['end', 'connection'],
    'del_isakmp': ['info'], 'closed_isakmp': ['end', 'connection']} -%}
{%- set vg = {'msg_id': msg[0], 'msg_name': msg[1], 'section': msg[2], 'severity': msg[3]} -%}
{%- if e.kind != 'fail' -%}{%- do vg.update({'isakmp_connection_id': e.isakmp}) -%}{%- endif -%}
{%- if session_id -%}{%- do vg.update({'session_id': session_id}) -%}{%- endif -%}
{%- if e.kind in ['est', 'del_ipsec', 'closed_ipsec'] -%}{%- do vg.update({'ipsec_connection_id': e.ipsec}) -%}{%- endif -%}
{%- if e.kind == 'cfg' -%}{%- do vg.update({'ikecfg_address': e.cfg}) -%}{%- endif -%}
{%- if e.kind == 'est' -%}
  {%- do vg.update({'traffic_selector': e.cfg ~ '->' ~ sel[0], 'filter': sel[1],
      'ipsec_action': sel[2], 'ike_rule': 'IKERule:RA-MAP:10'}) -%}
{%- endif -%}
{%- if e.kind == 'closed_ipsec' -%}
  {%- do vg.update({'bytes_sent': e.tx, 'bytes_received': e.rx, 'reason': 'deleted by peer'}) -%}
{%- endif -%}
{%- set peer_rows = e.kind in ['fail', 'created', 'cfg', 'est', 'closed_isakmp'] -%}
{%- if peer_rows -%}{%- do vg.update({'ike_id': uid}) -%}{%- endif -%}
{%- set event = {'kind': 'event', 'module': 's_terra', 'dataset': 's_terra.vpn_gate',
    'category': ['network', 'authentication'] if e.kind == 'fail' else ['network'],
    'type': types[e.kind], 'action': actions[e.kind], 'code': msg[0],
    'original': raw} -%}
{%- if e.kind == 'fail' -%}{%- do event.update({'outcome': 'failure'}) -%}
{%- elif e.kind in ['created', 'cfg', 'est'] -%}{%- do event.update({'outcome': 'success'}) -%}{%- endif -%}
{%- set record = {'@timestamp': dt.isoformat(), 'ecs': {'version': '8.17.0'},
    'event': event, 'log': {'level': msg[3] | lower},
    'observer': {'hostname': params.gateway_host, 'vendor': 'S-Terra',
      'product': 'S-Terra Gate', 'version': '4.1', 'type': 'vpn'},
    'process': {'name': 'vpnsvc'},
    's_terra': {'vpn_gate': vg}} -%}
{%- if peer_rows -%}
  {%- do record.update({'source': {'ip': e.ip, 'port': e.port}, 'user': {'name': uid},
      'related': {'ip': [e.ip] + ([e.cfg] if e.kind in ['cfg', 'est'] else []), 'user': [uid]}}) -%}
{%- endif -%}
{%- if e.kind == 'closed_ipsec' -%}
  {%- do record.update({'source': {'bytes': e.rx}, 'destination': {'bytes': e.tx}}) -%}
{%- endif -%}
{{ record | tojson }}
