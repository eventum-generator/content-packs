{%- set previous = shared.get('previous_time') -%}
{%- set event_time = timestamp if previous is none or timestamp > previous else previous + module.datetime.timedelta(seconds=1) -%}
{%- do shared.set('previous_time', event_time) -%}
{%- set tick = (shared.get('tick', -1) + 1) % (params.anomaly_interval_events + 6) -%}
{%- do shared.set('tick', tick) -%}
{%- if tick == 0 -%}
  {%- do shared.set('cycle', (shared.get('cycle', -1) + 1) % 10000) -%}
{%- endif -%}
{%- set cycle = shared.get('cycle', 0) -%}
{%- set chain = params.anomaly_mode and tick >= params.anomaly_interval_events -%}
{%- set step = tick - params.anomaly_interval_events if chain else -1 -%}
{%- set is_create = tick % 2 == 0 -%}
{%- if chain -%}
  {%- set peer_ip = params.unstable_peer_ip -%}
  {%- set connection_id = 810000 + cycle * 3 + (step // 2) -%}
  {%- set peer_id = 'unstable-branch.example' -%}
{%- else -%}
  {%- set peer_index = (tick // 2) % 4 -%}
  {%- set peer_ip = ['192.0.2.10', '192.0.2.11', '192.0.2.12', '192.0.2.13'][peer_index] -%}
  {%- set connection_id = 1000 + cycle * (params.anomaly_interval_events // 2) + (tick // 2) -%}
  {%- set peer_id = ['branch-a.example', 'branch-b.example', 'branch-c.example', 'branch-d.example'][peer_index] -%}
{%- endif -%}
{%- set message = 'ISAKMP connection ' ~ connection_id ~ (' created, peer ' if is_create else ' closed, peer ') ~ peer_ip ~ ':500, id "' ~ peer_id ~ '"' -%}
{%- set event_code = '10000005' if is_create else '10000006' -%}
{%- set action = 'ike_sa_created' if is_create else 'ike_sa_closed' -%}
{%- set event_type = ['start'] if is_create else ['end'] -%}
{%- set record = {
  '@timestamp': event_time.isoformat(),
  'ecs': {'version': '8.17.0'},
  'event': {'kind': 'event', 'dataset': 's_terra.vpn_gate', 'category': ['network'], 'type': event_type, 'action': action, 'code': event_code, 'original': message},
  'observer': {'name': params.gateway_name, 'vendor': 'S-Terra', 'product': 'VPN Gate'},
  'destination': {'ip': peer_ip, 'port': 500, 'domain': peer_id},
  'network': {'transport': 'udp', 'protocol': 'isakmp'},
  'related': {'ip': [peer_ip]},
  's_terra': {'vpn_gate': {'connection_id': connection_id, 'peer_id': peer_id, 'severity': 'INFO'}}
} -%}
{{ record | tojson }}
