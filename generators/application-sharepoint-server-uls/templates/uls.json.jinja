{%- for flag in ['next_routine_sql', 'next_routine_params', 'next_routine_begin', 'next_anomaly_begin', 'next_anomaly_sql', 'next_anomaly_params'] -%}{%- do shared.pop(flag, none) -%}{%- endfor -%}
{%- set phase = vars.phase -%}
{%- set track = vars.track -%}
{%- if phase == 'begin' -%}
  {%- set workflow_id = params.suspect_workflow_id if track == 'anomaly' else module.rand.crypto.uuid4() | string -%}
  {%- set correlation_id = module.rand.crypto.uuid4() | string -%}
  {%- if track == 'anomaly' -%}
    {%- set site_id = shared.get('suspect_site_id') or module.rand.crypto.uuid4() | string -%}
    {%- set web_id = shared.get('suspect_web_id') or module.rand.crypto.uuid4() | string -%}
    {%- set item_id = shared.get('suspect_item_id') or module.rand.crypto.uuid4() | string -%}
    {%- set list_id = shared.get('suspect_list_id') or module.rand.crypto.uuid4() | string -%}
    {%- do shared.update({'suspect_site_id': site_id, 'suspect_web_id': web_id, 'suspect_item_id': item_id, 'suspect_list_id': list_id}) -%}
  {%- else -%}
    {%- set site_id = module.rand.crypto.uuid4() | string -%}
    {%- set web_id = module.rand.crypto.uuid4() | string -%}
    {%- set item_id = module.rand.crypto.uuid4() | string -%}
    {%- set list_id = module.rand.crypto.uuid4() | string -%}
  {%- endif -%}
  {%- do shared.update({'workflow_id': workflow_id, 'correlation_id': correlation_id, 'site_id': site_id, 'web_id': web_id, 'item_id': item_id, 'list_id': list_id}) -%}
  {%- if track == 'anomaly' -%}
    {%- do shared.set('anomaly_attempt', shared.get('anomaly_attempt', 0) + 1) -%}
    {%- do shared.set('next_anomaly_sql', true) -%}
  {%- else -%}
    {%- do shared.set('next_routine_sql', true) -%}
  {%- endif -%}
{%- else -%}
  {%- set workflow_id = shared.get('workflow_id') -%}
  {%- set correlation_id = shared.get('correlation_id') -%}
  {%- set site_id = shared.get('site_id') -%}
  {%- set web_id = shared.get('web_id') -%}
  {%- set item_id = shared.get('item_id') -%}
  {%- set list_id = shared.get('list_id') -%}
  {%- if phase == 'sql' -%}
    {%- do shared.set('next_anomaly_params' if track == 'anomaly' else 'next_routine_params', true) -%}
  {%- elif track == 'anomaly' -%}
    {%- if shared.get('anomaly_attempt', 0) < 3 -%}
      {%- do shared.set('next_anomaly_begin', true) -%}
    {%- else -%}
      {%- do shared.set('anomaly_attempt', 0) -%}
      {%- do shared.set('next_routine_begin', true) -%}
    {%- endif -%}
  {%- else -%}
    {%- set routine_count = shared.get('routine_count', 0) + 1 -%}
    {%- if routine_count >= params.routine_workflows_before_chain -%}
      {%- do shared.set('routine_count', 0) -%}
      {%- do shared.set('next_anomaly_begin' if params.anomaly_mode else 'next_routine_begin', true) -%}
    {%- else -%}
      {%- do shared.set('routine_count', routine_count) -%}
      {%- do shared.set('next_routine_begin', true) -%}
    {%- endif -%}
  {%- endif -%}
{%- endif -%}
{%- if phase == 'begin' -%}
  {%- set area = 'SharePoint Foundation' -%}
  {%- set category = 'Legacy Workflow Infrastructure' -%}
  {%- set native_id = 'ahk8y' -%}
  {%- set level = 'Verbose' -%}
  {%- set action = 'workflow_begin' -%}
  {%- set message = 'In RunWorkflowElev(), begin processing events for instance: ' ~ workflow_id -%}
{%- elif phase == 'sql' -%}
  {%- set area = 'SharePoint Foundation' -%}
  {%- set category = 'Database' -%}
  {%- set native_id = 'b6p4' -%}
  {%- set level = 'VerboseEx' -%}
  {%- set action = 'workflow_association_lookup' -%}
  {%- set message = "SqlCommand: ; EXEC proc_getworkflowassociations '" ~ site_id ~ "', '" ~ web_id ~ "', '" ~ item_id ~ "', '" ~ list_id ~ "', @contenttypeid, @RequestGuid OUTPUT" -%}
{%- else -%}
  {%- set area = 'SharePoint Foundation' -%}
  {%- set category = 'Database' -%}
  {%- set native_id = 'tzkv' -%}
  {%- set level = 'Verbose' -%}
  {%- set action = 'workflow_association_lookup' -%}
  {%- set message = "SqlCommand: 'proc_GetWorkflowAssociations' CommandType: StoredProcedure CommandTimeout: 0 Parameter: '@RETURN_VALUE' Type: Int Size: 0 Direction: ReturnValue Value: Parameter: '@SiteId' Type: UniqueIdentifier Size: 0 Direction: Input Value: '" ~ site_id ~ "' Parameter: '@WebId' Type: UniqueIdentifier Size: 0 Direction: Input Value: '" ~ web_id ~ "' Parameter: '@Id' Type: UniqueIdentifier Size: 0 Direction: Input Value: '" ~ item_id ~ "' Parameter: '@ListId' Type: UniqueIdentifier Size: 0 Direction: Input Value: '" ~ list_id ~ "' Parameter: '@ContentTypeId' Type: VarBinary Size: 512 Direction: Input Value: Parameter: '@RequestGuid' Type: UniqueIdentifier Size: 0 Direction: Input Value: '" ~ correlation_id ~ "'" -%}
{%- endif -%}
{%- set native_time = timestamp.strftime('%m/%d/%Y %H:%M:%S.%f')[:-4] -%}
{%- set native_line = [native_time, 'OWSTIMER.EXE (0x9318)', '0x6DF0', area, category, native_id, level, message, correlation_id] | join('\t') -%}
{%- set payload = {'@timestamp': timestamp.isoformat(), 'ecs': {'version': '8.17.0'}, 'event': {'kind': 'event', 'category': ['process'], 'type': ['info'], 'dataset': 'sharepoint.uls', 'module': 'sharepoint', 'action': action, 'code': native_id, 'original': native_line}, 'host': {'name': params.farm_host}, 'service': {'name': 'SharePoint Server', 'version': '2016'}, 'process': {'name': 'OWSTIMER.EXE', 'pid': 37656, 'thread': {'id': 28144}}, 'message': message, 'log': {'level': level | lower}, 'related': {'hosts': [params.farm_host]}, 'sharepoint': {'uls': {'timestamp_local': native_time, 'process': 'OWSTIMER.EXE (0x9318)', 'thread_id': '0x6DF0', 'area': area, 'category': category, 'event_id': native_id, 'level': level, 'message': message, 'correlation_id': correlation_id}, 'workflow': {'instance_id': workflow_id, 'site_id': site_id, 'web_id': web_id, 'item_id': item_id, 'list_id': list_id}}} -%}
{{- payload | tojson -}}
