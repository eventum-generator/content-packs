{%- set previous = shared.get('previous_time') -%}
{%- set event_time = timestamp if previous is none or timestamp > previous else previous + module.datetime.timedelta(seconds=1) -%}
{%- do shared.set('previous_time', event_time) -%}
{%- set tick = (shared.get('tick', -1) + 1) % (params.anomaly_interval_events + 5) -%}
{%- do shared.set('tick', tick) -%}
{%- set chain = params.anomaly_mode and tick >= params.anomaly_interval_events -%}
{%- if chain -%}
  {%- set user_name = params.target_user -%}
  {%- set user_id = params.target_user_id -%}
  {%- set source_ip = params.target_source_ip -%}
  {%- set chain_count = (shared.get('chain_count', 0) + 1) % 900000 -%}
  {%- do shared.set('chain_count', chain_count) -%}
  {%- set alert_id = 100000 + chain_count -%}
{%- else -%}
  {%- set actor = module.rand.choice([
    ('analyst-one', '3451141c-bac6-467c-8d72-85e0fab569ce', '192.0.2.11'),
    ('analyst-two', 'a51de0aa-3f3d-4daa-a3f5-1714bf5e91ab', '192.0.2.12'),
    ('soc-lead', '9446b38d-318b-4647-a109-e15432fa9365', '192.0.2.13')]) -%}
  {%- set user_name = actor[0] -%}
  {%- set user_id = actor[1] -%}
  {%- set source_ip = actor[2] -%}
  {%- set alert_id = module.rand.number.integer(1000, 8999) -%}
{%- endif -%}
{%- set event_ms = (event_time.timestamp() * 1000) | int -%}
{%- set event_time_str = event_time.strftime('%d %b %Y %H:%M:%S.%f')[:-3] -%}
{%- set raw = event_time.isoformat(timespec='microseconds') ~ ' '
  ~ params.device_name ~ ' fortisoar-audit-log: '
  ~ 'CEF:0|Fortinet Inc|FortiSOAR|' ~ params.device_version
  ~ '|Alert Deleted|Alert Deleted|1|'
  ~ 'devid="' ~ params.device_id ~ '" vd="enterprise" level="warning"'
  ~ ' type="Audit Log" msg="Alert [' ~ alert_id ~ '] Deleted "'
  ~ ' src="' ~ source_ip ~ '" suid="' ~ user_id ~ '"'
  ~ ' suser="' ~ user_name ~ '" end=' ~ event_ms
  ~ ' playbookName="" playbookId="" eventTimeStr="'
  ~ event_time_str ~ '"' -%}
{%- set record = {'@timestamp': event_time.isoformat(),
  'ecs': {'version': '8.17.0'},
  'event': {'kind': 'event', 'dataset': 'fortinet.fortisoar.audit',
    'category': ['api'], 'type': ['deletion'], 'action': 'alert_deleted',
    'code': 'Alert Deleted', 'original': raw},
  'host': {'name': params.device_name},
  'user': {'name': user_name, 'id': user_id},
  'source': {'ip': source_ip},
  'related': {'user': [user_name], 'ip': [source_ip]},
  'fortinet': {'fortisoar': {'alert_id': alert_id, 'device_id': params.device_id,
    'virtual_domain': 'enterprise', 'level': 'warning',
    'log_type': 'Audit Log'}}} -%}
{{ record | tojson }}
