{%- set step = vars.step -%}
{%- set source_ip = module.rand.choice(['10.20.1.23', '10.20.1.45', '10.20.2.18', '192.0.2.36']) -%}
{%- set user_name = '-' -%}
{%- set method = 'GET' -%}
{%- set path = '/Default.htm' -%}
{%- set query = '-' -%}
{%- set status = 200 -%}
{%- set duration = module.rand.number.integer(2, 86) -%}
{%- set bytes_in = module.rand.number.integer(130, 700) -%}
{%- set bytes_out = module.rand.number.integer(1100, 9800) -%}
{%- if step == 'routine' -%}
  {%- do shared.pop('to_anomaly', none) -%}
  {%- set count = shared.get('routine_count', 0) + 1 -%}
  {%- if count >= params.anomaly_interval_events -%}
    {%- do shared.set('routine_count', 0) -%}
    {%- if params.anomaly_mode -%}
      {%- do shared.set('to_anomaly', true) -%}
    {%- endif -%}
  {%- else -%}
    {%- do shared.set('routine_count', count) -%}
  {%- endif -%}
  {%- set kind = module.rand.weighted_choice(['page', 'asset', 'api', 'missing', 'denied'], [48, 31, 13, 6, 2]) -%}
  {%- if kind == 'asset' -%}
    {%- set path = module.rand.choice(['/DeptLogo.gif', '/styles/site.css', '/scripts/site.js']) -%}
    {%- set bytes_out = module.rand.number.integer(3000, 45000) -%}
  {%- elif kind == 'api' -%}
    {%- set path = '/api/status' -%}
    {%- set query = 'site=main' -%}
    {%- set bytes_out = 450 -%}
  {%- elif kind == 'missing' -%}
    {%- set path = '/favicon-old.ico' -%}
    {%- set status = 404 -%}
    {%- set bytes_out = 230 -%}
  {%- elif kind == 'denied' -%}
    {%- set path = '/admin/' -%}
    {%- set status = 403 -%}
    {%- set bytes_out = 280 -%}
  {%- endif -%}
{%- else -%}
  {%- set source_ip = params.anomaly_source_ip -%}
  {%- set bytes_out = 270 -%}
  {%- if step == 'probe_one' -%}
    {%- set path = '/backup/' -%}
    {%- set status = 404 -%}
  {%- elif step == 'probe_two' -%}
    {%- set path = '/admin/' -%}
    {%- set status = 403 -%}
  {%- elif step == 'denied' -%}
    {%- set path = '/exports/' -%}
    {%- set status = 403 -%}
  {%- elif step == 'download' -%}
    {%- set path = '/exports/payroll.csv' -%}
    {%- set user_name = 'CONTOSO\\svc-reports' -%}
    {%- set status = 200 -%}
    {%- set bytes_out = 8341712 -%}
  {%- endif -%}
{%- endif -%}
{%- set fields = [source_ip, user_name, timestamp.strftime('%m/%d/%y'), timestamp.strftime('%H:%M:%S'), params.site_id, params.server_name, params.server_ip, duration, bytes_in, bytes_out, status, 0, method, path, query] -%}
{%- set original = fields | join(', ') -%}
{
  "@timestamp": {{ timestamp.isoformat() | tojson }},
  "ecs": {"version": "8.17.0"},
  "event": {"kind": "event", "module": "iis", "dataset": "iis.access", "category": ["web"], "type": ["access"], "action": "http_request", "outcome": {{ ('success' if status < 400 else 'failure') | tojson }}, "original": {{ original | tojson }}},
  "host": {"name": {{ params.server_name | tojson }}, "ip": {{ params.server_ip | tojson }}},
  "source": {"ip": {{ source_ip | tojson }}},
  "user": {"name": {{ user_name | tojson }}},
  "http": {"request": {"method": {{ method | tojson }}, "bytes": {{ bytes_in }}}, "response": {"status_code": {{ status }}, "bytes": {{ bytes_out }}}},
  "url": {"path": {{ path | tojson }}, "query": {{ query | tojson }}},
  "iis": {"access": {"service": {{ params.site_id | tojson }}, "server_name": {{ params.server_name | tojson }}, "server_ip": {{ params.server_ip | tojson }}, "client_ip": {{ source_ip | tojson }}, "username": {{ user_name | tojson }}, "date": {{ timestamp.strftime('%m/%d/%y') | tojson }}, "time": {{ timestamp.strftime('%H:%M:%S') | tojson }}, "time_taken": {{ duration }}, "client_bytes_sent": {{ bytes_in }}, "server_bytes_sent": {{ bytes_out }}, "service_status_code": {{ status }}, "windows_status_code": 0, "request_type": {{ method | tojson }}, "target": {{ path | tojson }}, "parameters": {{ query | tojson }}}}
}
