{%- set ticks = module.rand.number.integer(0, 9999999) -%}
{%- set utc_timestamp = timestamp.astimezone(module.datetime.timezone.utc).replace(microsecond=ticks // 10) -%}
{%- for key in ['to_auth_failures', 'to_auth_success', 'to_routine'] -%}{%- do shared.pop(key, none) -%}{%- endfor -%}
{%- set stage = vars.stage -%}
{%- set stations = {
  'anna': 'DA-7A-11-31-8C-42',
  'boris': 'DA-7A-11-4D-2E-91',
  'irina': 'DA-7A-11-72-5B-C8',
  'pavel': 'DA-7A-11-19-A3-6F',
  'marina': 'DA-7A-11-5C-87-23',
  'elena': 'DA-7A-11-84-1D-B5',
  'denis': 'DA-7A-11-3B-9E-70',
  'sveta': 'DA-7A-11-68-2A-D4',
  'roman': 'DA-7A-11-2F-C1-85',
  'viktor': 'DA-7A-11-9A-34-6B',
  'olga': 'DA-7A-11-45-D8-1F',
  'sergey': 'DA-7A-11-7E-20-A9',
  'nikita': 'DA-7A-11-14-B6-3C',
  'daria': 'DA-7A-11-6D-93-F2',
  'alexey': 'DA-7A-11-28-4F-C7',
  'inna': 'DA-7A-11-8B-51-0E',
  'igor': 'DA-7A-11-37-A2-D6',
  'natalia': 'DA-7A-11-5E-7C-19',
  'anton': 'DA-7A-11-91-3D-A4'
} -%}
{%- set users = (stations.keys()|list) + [params.target_user] -%}
{%- set now_s = utc_timestamp.timestamp() -%}
{%- set interval_s = params.anomaly_interval_seconds | float -%}
{%- set chain_window_s = 300 -%}
{%- set denials = shared.get('denials', {}) -%}
{%- set user = module.rand.choice(users) -%}
{%- set station = module.rand.choice(['DA-7A-11-4A-8E-3B', params.suspicious_station]) if user == params.target_user else stations[user] -%}
{%- set code = 6272 -%}
{%- if stage == 'routine' -%}
  {#- Background retry bursts: an ordinary denial starts, with some
      probability, one to six more denials of the same account and
      station 30-120 s apart; 80% of bursts end with a grant. -#}
  {%- set retry = shared.get('retry', none) -%}
  {%- if retry is not none and now_s >= retry.due -%}
    {%- set user = retry.user -%}
    {%- set station = retry.station -%}
    {%- if retry.left > 0 -%}
      {%- set code = 6273 -%}
      {%- do retry.update({'left': retry.left - 1, 'due': now_s + module.rand.weighted_choice([30, 60, 90, 120], [45, 30, 15, 10]) - 1}) -%}
      {%- if retry.left == 0 and not retry.ok -%}{%- set retry = none -%}{%- endif -%}
    {%- else -%}
      {%- set code = 6272 -%}
      {%- set retry = none -%}
    {%- endif -%}
  {%- else -%}
    {%- set code = module.rand.weighted_choice([6272, 6273, 6274], [91.8, 8, 0.2]) -%}
    {%- if code == 6273 and retry is none and module.rand.chance(0.3) -%}
      {%- set retry = {'user': user, 'station': station, 'left': module.rand.weighted_choice([1, 2, 3, 4, 5, 6], [40, 25, 15, 10, 6, 4]), 'ok': module.rand.chance(0.8), 'due': now_s + module.rand.weighted_choice([30, 60, 90, 120], [45, 30, 15, 10]) - 1} -%}
    {%- endif -%}
  {%- endif -%}
  {%- do shared.set('retry', retry) -%}
  {#- Recurrence: the first start is uniform over the first
      min(interval, 24 h) of the run; each next one is uniform in a
      window of width min(interval / 4, 6 h) centred on the actual
      start plus the interval. -#}
  {%- if shared.get('next_anomaly_at') is none -%}
    {%- do shared.set('next_anomaly_at', now_s + module.rand.number.floating(0, [interval_s, 86400] | min)) -%}
  {%- endif -%}
  {%- if params.anomaly_mode and now_s >= shared.get('next_anomaly_at') -%}
    {%- set half = ([interval_s / 4, 21600] | min) / 2 -%}
    {%- do shared.set('fail_count', 0) -%}
    {%- do shared.set('to_auth_failures', true) -%}
    {%- do shared.set('next_anomaly_at', now_s + interval_s + module.rand.number.floating(-half, half)) -%}
  {%- endif -%}
  {#- Guard: a grant that would complete four denials of the same
      account and station, the first at most chain_window_s earlier,
      does not happen (the retrying user gives up); the tick stays
      empty. -#}
  {%- if code == 6272 and (denials.get(user ~ '|' ~ station, []) | select('ge', now_s - chain_window_s) | list | length) >= 4 -%}
    {{- dispatch.drop() -}}
  {%- endif -%}
{%- elif stage == 'auth_failures' -%}
  {%- set user = params.target_user -%}
  {%- set station = params.suspicious_station -%}
  {%- set code = 6273 -%}
  {%- set count = shared.get('fail_count', 0) + 1 -%}
  {%- do shared.set('fail_count', count) -%}
  {%- if count >= 4 -%}{%- do shared.set('to_auth_success', true) -%}{%- endif -%}
{%- else -%}
  {%- set user = params.target_user -%}
  {%- set station = params.suspicious_station -%}
  {%- set code = 6272 -%}
  {%- do shared.set('fail_count', 0) -%}
  {%- do shared.set('to_routine', true) -%}
{%- endif -%}
{#- Denial history per account and station for the guard; the episode's
    own grant completes the chain and clears the history of its key. -#}
{%- set key = user ~ '|' ~ station -%}
{%- set recent = denials.get(key, []) | select('ge', now_s - chain_window_s) | list -%}
{%- if code == 6273 -%}
  {%- do recent.append(now_s) -%}
{%- endif -%}
{%- if stage == 'auth_success' or not recent -%}
  {%- do denials.pop(key, none) -%}
{%- else -%}
  {%- do denials.update({key: recent}) -%}
{%- endif -%}
{%- do shared.set('denials', denials) -%}
{%- set denied = code != 6272 -%}
{%- set seq = shared.get('record_id', 210000) + 1 -%}{%- do shared.set('record_id', seq) -%}
{%- set data = {
  'SubjectUserSid': 'S-1-0-0' if code == 6273 else 'S-1-5-21-3124921703-1242075836-1035668124-' ~ (1101 + users.index(user)),
  'SubjectUserName': user,
  'SubjectDomainName': params.domain,
  'FullyQualifiedSubjectUserName': params.domain ~ '\\' ~ user,
  'SubjectMachineSID': 'S-1-0-0',
  'SubjectMachineName': '-',
  'FullyQualifiedSubjectMachineName': '-',
  'MachineInventory': '-',
  'CalledStationID': params.access_point_bssid ~ ':' ~ params.ssid,
  'CallingStationID': station,
  'NASIPv4Address': params.radius_client_ip,
  'NASIPv6Address': '-',
  'NASIdentifier': params.radius_client_name,
  'NASPortType': 'Wireless - IEEE 802.11',
  'NASPort': '0',
  'ClientName': params.radius_client_name,
  'ClientIPAddress': params.radius_client_ip,
  'ProxyPolicyName': params.connection_policy,
  'NetworkPolicyName': params.network_policy,
  'AuthenticationProvider': 'Windows',
  'AuthenticationServer': params.host_name,
  'AuthenticationType': 'EAP' if code == 6274 else 'PEAP',
  'EAPType': '-' if code == 6274 else 'Microsoft: Secured password (EAP-MSCHAP v2)',
  'AccountSessionIdentifier': '-'
} -%}
{%- if code == 6272 -%}
  {%- do data.update({'QuarantineState': 'Full Access', 'QuarantineSessionIdentifier': '-', 'LoggingResult': 'Accounting information was written to the local log file.'}) -%}
{%- elif code == 6273 -%}
  {%- do data.update({'ReasonCode': '16', 'Reason': 'Authentication failed due to a user credentials mismatch. Either the user name provided does not map to an existing user account or the password was incorrect.', 'LoggingResult': 'Accounting information was written to the local log file.'}) -%}
{%- else -%}
  {%- do data.pop('MachineInventory') -%}
  {%- do data.update({'ReasonCode': '1', 'Reason': 'An internal error occurred. Check the system event log for additional information.'}) -%}
{%- endif -%}
{%- set ns = namespace(xml= '<Event xmlns="http://schemas.microsoft.com/win/2004/08/events/event"><System><Provider Name="Microsoft-Windows-Security-Auditing" Guid="{54849625-5478-4994-A5BA-3E3B0328C30D}"/><EventID>' ~ code ~ '</EventID><Version>1</Version><Level>0</Level><Task>12552</Task><Opcode>0</Opcode><Keywords>' ~ ('0x8010000000000000' if denied else '0x8020000000000000') ~ '</Keywords><TimeCreated SystemTime="' ~ utc_timestamp.strftime('%Y-%m-%dT%H:%M:%S.') ~ ('%07d' % ticks) ~ '00Z' ~ '"/><EventRecordID>' ~ seq ~ '</EventRecordID><Correlation/><Execution ProcessID="584" ThreadID="4712"/><Channel>Security</Channel><Computer>' ~ params.host_name ~ '</Computer><Security/></System><EventData>') -%}
{%- for key, value in data.items() -%}
  {%- set ns.xml = ns.xml ~ '<Data Name="' ~ key ~ '">' ~ (value|e) ~ '</Data>' -%}
{%- endfor -%}
{%- set ns.xml = ns.xml ~ '</EventData></Event>' -%}
{%- set event = {
  '@timestamp': utc_timestamp.isoformat(),
  'ecs': {'version': '8.17.0'},
  'log': {'level': 'information'},
  'event': {'code': code|string, 'kind': 'event', 'category': ['authentication'], 'type': ['end'], 'outcome': 'failure' if denied else 'success', 'action': 'radius-request-discarded' if code == 6274 else ('radius-access-denied' if denied else 'radius-access-granted'), 'provider': 'Microsoft-Windows-Security-Auditing', 'original': ns.xml},
  'host': {'name': params.host_name},
  'observer': {'name': params.host_name, 'type': 'radius'},
  'user': {'name': user, 'domain': params.domain, 'id': data.SubjectUserSid} if code != 6273 else {'name': user, 'domain': params.domain},
  'source': {'mac': station},
  'client': {'ip': params.radius_client_ip},
  'related': {'user': [user], 'ip': [params.radius_client_ip]},
  'winlog': {'channel': 'Security', 'provider_name': 'Microsoft-Windows-Security-Auditing', 'event_id': code|string, 'record_id': seq|string, 'computer_name': params.host_name, 'task': 'Network Policy Server', 'keywords': ['Audit Failure'] if denied else ['Audit Success'], 'opcode': 'Info', 'time_created': utc_timestamp.strftime('%Y-%m-%dT%H:%M:%S.') ~ ('%07d' % ticks) ~ 'Z', 'event_data': data}
} -%}
{{- event | tojson -}}
