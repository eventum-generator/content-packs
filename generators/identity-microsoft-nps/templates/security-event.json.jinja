{%- for key in ['to_auth_failures', 'to_auth_success', 'to_routine'] -%}{%- do shared.pop(key, none) -%}{%- endfor -%}
{%- set stage = vars.stage -%}
{%- set user = module.rand.choice(['anna', 'boris', 'irina', 'pavel', 'marina']) -%}
{%- set station = module.rand.choice(['02-42-AC-11-00-12', '02-42-AC-11-00-28', '02-42-AC-11-00-3A']) -%}
{%- set code = 6272 -%}
{%- if stage == 'routine' -%}
  {%- set code = module.rand.weighted_choice([6272, 6273, 6274], [86, 12, 2]) -%}
  {%- set count = shared.get('routine_count', 0) + 1 -%}
  {%- if count >= 100 -%}
    {%- do shared.set('routine_count', 0) -%}
    {%- if params.anomaly_mode -%}{%- do shared.set('fail_count', 0) -%}{%- do shared.set('to_auth_failures', true) -%}{%- endif -%}
  {%- else -%}{%- do shared.set('routine_count', count) -%}{%- endif -%}
{%- elif stage == 'auth_failures' -%}
  {%- set user = params.target_user -%}
  {%- set station = params.suspicious_station -%}
  {%- set code = 6273 -%}
  {%- set count = shared.get('fail_count', 0) + 1 -%}
  {%- do shared.set('fail_count', count) -%}
  {%- if count >= 4 -%}{%- do shared.set('to_auth_success', true) -%}{%- endif -%}
{%- else -%}
  {%- set user = params.target_user -%}
  {%- set station = params.suspicious_station -%}
  {%- set code = 6272 -%}
  {%- do shared.set('fail_count', 0) -%}
  {%- do shared.set('to_routine', true) -%}
{%- endif -%}
{%- set denied = code != 6272 -%}
{%- set seq = shared.get('record_id', 210000) + 1 -%}{%- do shared.set('record_id', seq) -%}
{%- set data = {
  'SubjectUserSid': 'S-1-0-0',
  'SubjectUserName': user,
  'SubjectDomainName': params.domain,
  'FullyQualifiedSubjectUserName': params.domain ~ '\\' ~ user,
  'SubjectMachineSID': 'S-1-0-0',
  'SubjectMachineName': '-',
  'FullyQualifiedSubjectMachineName': '-',
  'MachineInventory': '-',
  'CalledStationID': '02-42-AC-11-00-01:CORP',
  'CallingStationID': station,
  'NASIPv4Address': params.radius_client_ip,
  'NASIPv6Address': '-',
  'NASIdentifier': 'office-wifi-ap',
  'NASPortType': 'Wireless - IEEE 802.11',
  'NASPort': '0',
  'ClientName': params.radius_client_name,
  'ClientIPAddress': params.radius_client_ip,
  'ProxyPolicyName': params.connection_policy,
  'NetworkPolicyName': '-' if denied else params.network_policy,
  'AuthenticationProvider': 'Windows',
  'AuthenticationServer': params.host_name,
  'AuthenticationType': 'PEAP',
  'EAPType': 'Microsoft: Secured password (EAP-MSCHAP v2)',
  'AccountSessionIdentifier': '-',
  'ReasonCode': '16' if code == 6273 else ('3' if code == 6274 else '0'),
  'Reason': 'Authentication failed due to a user credentials mismatch' if code == 6273 else ('The RADIUS Request message that Network Policy Server received from the network access server was malformed.' if code == 6274 else 'The connection request was successfully authenticated'),
  'LoggingResult': 'Accounting information was written to the local log file.'
} -%}
{%- set ns = namespace(xml= '<Event xmlns="http://schemas.microsoft.com/win/2004/08/events/event"><System><Provider Name="Microsoft-Windows-Security-Auditing" Guid="{54849625-5478-4994-A5BA-3E3B0328C30D}"/><EventID>' ~ code ~ '</EventID><Version>1</Version><Level>0</Level><Task>12552</Task><Opcode>0</Opcode><Keywords>' ~ ('0x8010000000000000' if denied else '0x8020000000000000') ~ '</Keywords><TimeCreated SystemTime="' ~ timestamp.isoformat() ~ '"/><EventRecordID>' ~ seq ~ '</EventRecordID><Correlation/><Execution ProcessID="584" ThreadID="4712"/><Channel>Security</Channel><Computer>' ~ params.host_name ~ '</Computer><Security/></System><EventData>') -%}
{%- for key, value in data.items() -%}
  {%- set ns.xml = ns.xml ~ '<Data Name="' ~ key ~ '">' ~ (value|e) ~ '</Data>' -%}
{%- endfor -%}
{%- set ns.xml = ns.xml ~ '</EventData></Event>' -%}
{%- set event = {
  '@timestamp': timestamp.isoformat(),
  'ecs': {'version': '8.17.0'},
  'event': {'code': code|string, 'kind': 'event', 'category': ['authentication'], 'type': ['start'] if not denied else ['start', 'denied'], 'outcome': 'failure' if denied else 'success', 'action': 'radius-request-discarded' if code == 6274 else ('radius-access-denied' if denied else 'radius-access-granted'), 'provider': 'Microsoft-Windows-Security-Auditing', 'original': ns.xml},
  'host': {'name': params.host_name},
  'observer': {'name': params.host_name, 'type': 'radius'},
  'user': {'name': user, 'domain': params.domain},
  'source': {'mac': station},
  'client': {'ip': params.radius_client_ip},
  'related': {'user': [user], 'ip': [params.radius_client_ip]},
  'winlog': {'channel': 'Security', 'provider_name': 'Microsoft-Windows-Security-Auditing', 'event_id': code, 'record_id': seq, 'computer_name': params.host_name, 'task': 'Network Policy Server', 'event_data': data}
} -%}
{{- event | tojson -}}
