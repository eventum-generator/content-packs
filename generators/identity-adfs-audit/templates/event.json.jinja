{%- set step = vars.step -%}
{%- if step == 'routine' -%}
  {%- do shared.pop('to_attack', none) -%}
  {%- set count = shared.get('routine_count', 0) + 1 -%}
  {%- if count >= params.anomaly_interval_events -%}
    {%- do shared.set('routine_count', 0) -%}
    {%- if params.anomaly_mode -%}{%- do shared.set('to_attack', true) -%}{%- endif -%}
  {%- else -%}{%- do shared.set('routine_count', count) -%}{%- endif -%}
{%- endif -%}
{%- set sample = samples.relying_parties.pick() -%}
{%- set actor = sample.user -%}{%- set src = sample.ip -%}{%- set rp = sample.rp -%}
{%- if step != 'routine' -%}
  {%- set actor = params.anomaly_user -%}{%- set src = params.anomaly_ip -%}
  {%- set rp = {'token_1':'urn:corp:finance','token_2':'urn:corp:hr','token_3':'urn:corp:vpn','token_4':'urn:corp:erp','token_5':'urn:corp:admin'}[step] -%}
{%- endif -%}
{%- set record_id = (shared.get('record_id', 10000) % 2147483647) + 1 -%}
{%- do shared.set('record_id', record_id) -%}
{%- set activity = '{' ~ module.rand.crypto.uuid4() ~ '}' -%}
{%- set audit_xml = '<AuditBase xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="AppTokenAudit">' ~ '<AuditType>AppToken</AuditType><AuditResult>Success</AuditResult><FailureType>None</FailureType><ErrorCode>N/A</ErrorCode><ContextComponents>' ~ '<Component xsi:type="ResourceAuditComponent"><RelyingParty>' ~ (rp|e) ~ '</RelyingParty><ClaimsProvider>AD AUTHORITY</ClaimsProvider><UserId>' ~ (actor|e) ~ '</UserId></Component>' ~ '<Component xsi:type="AuthNAuditComponent"><PrimaryAuth>urn:oasis:names:tc:SAML:2.0:ac:classes:PasswordProtectedTransport</PrimaryAuth><DeviceAuth>false</DeviceAuth><DeviceId>N/A</DeviceId><MfaPerformed>false</MfaPerformed><MfaMethod>N/A</MfaMethod><TokenBindingProvidedId>true</TokenBindingProvidedId><TokenBindingReferredId>false</TokenBindingReferredId><SsoBindingValidationLevel>TokenBoundAndValid</SsoBindingValidationLevel></Component>' ~ '<Component xsi:type="ProtocolAuditComponent"><OAuthClientId>N/A</OAuthClientId><OAuthGrant>N/A</OAuthGrant></Component>' ~ '<Component xsi:type="RequestAuditComponent"><Server>https://' ~ params.server_name ~ '/adfs/services/trust</Server><AuthProtocol>WSFederation</AuthProtocol><NetworkLocation>Intranet</NetworkLocation><IpAddress>' ~ src ~ '</IpAddress><ForwardedIpAddress /><ProxyIpAddress>N/A</ProxyIpAddress><NetworkIpAddress>N/A</NetworkIpAddress><ProxyServer>N/A</ProxyServer><UserAgentString>Mozilla/5.0</UserAgentString><Endpoint>/adfs/ls</Endpoint></Component>' ~ '</ContextComponents></AuditBase>' -%}
{%- set original = '<Event xmlns="http://schemas.microsoft.com/win/2004/08/events/event"><System><Provider Name="AD FS Auditing"/><EventID>1200</EventID><Version>0</Version><Level>0</Level><Task>3</Task><Opcode>0</Opcode><TimeCreated SystemTime="' ~ timestamp.isoformat() ~ '"/><EventRecordID>' ~ record_id ~ '</EventRecordID><Correlation ActivityID="' ~ activity ~ '"/><Channel>Security</Channel><Computer>' ~ params.server_name ~ '</Computer></System><EventData><Data>' ~ activity ~ '</Data><Data>' ~ (audit_xml|e) ~ '</Data></EventData></Event>' -%}
{%- set out = {'@timestamp':timestamp.isoformat(),'ecs':{'version':'8.17.0'},'adfs':{'audit':{'audit_type':'AppToken','audit_result':'Success','relying_party':rp,'user_id':actor,'ip_address':src,'activity_id':activity}},'event':{'action':'token-issued','category':['authentication'],'code':'1200','dataset':'adfs.audit','kind':'event','original':original,'outcome':'success','type':['allowed']},'host':{'name':params.server_name},'message':'The Federation Service issued a valid token. See XML for details.','related':{'ip':[src],'user':[actor]},'source':{'ip':src},'tags':['adfs-audit','preserve_original_event'],'user':{'name':actor},'winlog':{'channel':'Security','event_id':1200,'provider_name':'AD FS Auditing','record_id':record_id,'activity_id':activity}} -%}
{{- out | tojson -}}
