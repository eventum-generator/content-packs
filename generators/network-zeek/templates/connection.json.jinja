{%- set flow_no = shared.get('flow_no', 0) + 1 -%}
{%- do shared.set('flow_no', flow_no) -%}
{%- set stage = flow_no % 120 -%}
{%- set attack = params.anomaly_mode and stage >= 1 and stage <= 8 -%}
{%- if attack -%}
  {%- set src = params.suspicious_client_ip -%}
  {%- if stage == 1 or stage == 5 -%}
    {%- set protocol = 'dns' -%}
  {%- elif stage == 8 -%}
    {%- set protocol = 'http' -%}
  {%- else -%}
    {%- set protocol = 'ssl' -%}
  {%- endif -%}
{%- else -%}
  {%- set src = module.rand.choice(['10.20.8.12', '10.20.8.31', '10.20.8.44', '10.20.9.18', '10.20.9.22']) -%}
  {%- set protocol = module.rand.weighted_choice(['dns', 'ssl', 'http'], [55, 35, 10]) -%}
{%- endif -%}
{%- if protocol == 'dns' -%}
  {%- set dst = params.dns_server_ip -%}
  {%- set port = 53 -%}
  {%- set transport = 'udp' -%}
{%- elif protocol == 'ssl' -%}
  {%- set dst = params.suspicious_ip if attack else module.rand.choice(['203.0.113.25', '203.0.113.42', '203.0.113.80']) -%}
  {%- set port = 443 -%}
  {%- set transport = 'tcp' -%}
{%- else -%}
  {%- set dst = params.suspicious_ip if attack else module.rand.choice(['203.0.113.25', '203.0.113.42']) -%}
  {%- set port = 80 -%}
  {%- set transport = 'tcp' -%}
{%- endif -%}
{%- set src_port = module.rand.number.integer(49152, 65535) -%}
{%- set uid = 'C' ~ module.rand.string.letters(8) ~ module.rand.string.digits(8) -%}
{%- set orig_bytes = module.rand.number.integer(50, 650) if not (attack and stage == 8) else 900000 -%}
{%- set resp_bytes = module.rand.number.integer(100, 7500) -%}
{%- set duration = module.rand.number.integer(4000, 950000) -%}
{%- set orig_pkts = module.rand.number.integer(1, 8) if not (attack and stage == 8) else 780 -%}
{%- set resp_pkts = module.rand.number.integer(1, 12) -%}
{%- set native = {
    'ts': timestamp.timestamp(), 'uid': uid,
    'id.orig_h': src, 'id.orig_p': src_port,
    'id.resp_h': dst, 'id.resp_p': port,
    'proto': transport, 'service': 'http' if protocol == 'http' else ('ssl' if protocol == 'ssl' else 'dns'),
    'duration': duration / 1000000, 'orig_bytes': orig_bytes,
    'resp_bytes': resp_bytes, 'conn_state': 'SF',
    'local_orig': true, 'local_resp': protocol == 'dns',
    'missed_bytes': 0, 'history': 'Dd' if protocol == 'dns' else 'ShADadFf',
    'orig_pkts': orig_pkts, 'orig_ip_bytes': orig_bytes + 28 * orig_pkts,
    'resp_pkts': resp_pkts, 'resp_ip_bytes': resp_bytes + 28 * resp_pkts,
    'tunnel_parents': []
} -%}
{%- do shared.set('current', {
    'uid': uid, 'src': src, 'src_port': src_port,
    'dst': dst, 'dst_port': port, 'transport': transport,
    'protocol': protocol, 'attack': attack, 'stage': stage,
    'orig_bytes': orig_bytes, 'resp_bytes': resp_bytes
}) -%}
{%- set dataset = 'zeek.connection' -%}
{%- set doc = {
    '@timestamp': timestamp.isoformat(),
    'agent': {'ephemeral_id': params.sensor_ephemeral_id, 'id': params.sensor_id,
              'name': params.sensor_name, 'type': 'filebeat', 'version': params.sensor_version},
    'data_stream': {'dataset': dataset, 'namespace': 'default', 'type': 'logs'},
    'destination': {'address': dst, 'bytes': resp_bytes + 28 * resp_pkts,
                    'ip': dst, 'packets': resp_pkts, 'port': port},
    'ecs': {'version': '8.17.0'},
    'elastic_agent': {'id': params.sensor_id, 'snapshot': false, 'version': params.sensor_version},
    'event': {'agent_id_status': 'verified', 'category': ['network'],
              'created': timestamp.isoformat(), 'dataset': dataset,
              'duration': duration * 1000, 'id': uid,
              'ingested': timestamp.isoformat(), 'kind': 'event',
              'original': native|tojson, 'type': ['connection', 'start', 'end']},
    'host': {'name': params.sensor_name},
    'input': {'type': 'filestream'},
    'log': {'file': {'path': '/opt/zeek/logs/current/conn.log'}},
    'network': {'bytes': orig_bytes + resp_bytes + 28 * (orig_pkts + resp_pkts),
                'direction': 'internal' if protocol == 'dns' else 'outbound',
                'packets': orig_pkts + resp_pkts,
                'protocol': native.service, 'transport': transport},
    'related': {'ip': [src, dst]},
    'source': {'address': src, 'bytes': orig_bytes + 28 * orig_pkts,
               'ip': src, 'packets': orig_pkts, 'port': src_port},
    'tags': ['zeek-connection'],
    'zeek': {'connection': {'history': native.history, 'local_orig': true,
                           'local_resp': protocol == 'dns', 'missed_bytes': 0,
                           'state': 'SF', 'state_message': 'Normal establishment and termination.'},
             'session_id': uid}
} -%}
{{- doc|tojson -}}
