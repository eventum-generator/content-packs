{#- Zeek 8 conn/dns/http/ssl records from one sensor, as ECS JSON with the
    compact native JSON line in event.original.

    One collector poll every two seconds reads the earliest completed
    record, or nothing. Flows are planned ahead into a pending queue:
    protocol records complete before their delayed connection summary.

    Background: one merged Poisson stream of independent clients. Each
    tick draws a client by its own weight and accepts it with a
    probability that follows its own hour-of-day curve (the shared curve
    shifted by up to 3 h). A client keeps up to three resolved names for
    their TTL, talks to any of them over TLS or HTTP, and re-resolves a
    known name or looks up a new one.

    Episode (anomaly_mode): one rotated client resolves a fresh node name
    of the watched domain, makes 5-7 TLS connections to it, resolves it
    again and uploads a large body with POST. The episode only adds flows;
    it never touches the background queue, cache or history.

    Guard: a background POST that would complete that ordered sequence
    (same client, same name, within the chain window from the first DNS
    answer) keeps its time and body but gets a 503 answer. -#}
{%- set utc = module.datetime.timezone.utc -%}
{%- set clock = timestamp.astimezone(utc).timestamp() -%}
{%- set window = 1800 -%}
{%- set hour = 3600 -%}
{%- set interval = params.anomaly_interval_hours | float * hour -%}

{%- if not shared.get('initialized', false) -%}
  {%- set clients = params.client_ips | unique | list -%}
  {%- if clients | length > 32 or clients | length < 4 -%}{{ dispatch.exhaust() }}{%- endif -%}
  {%- if interval < 6 * hour -%}{{ dispatch.exhaust() }}{%- endif -%}
  {%- for ip in clients -%}
    {%- if module.ipaddress.ip_address(ip) not in module.ipaddress.ip_network('10.0.0.0/8') -%}{{ dispatch.exhaust() }}{%- endif -%}
  {%- endfor -%}
  {%- if params.suspicious_ips | unique | list | length < 2 -%}{{ dispatch.exhaust() }}{%- endif -%}
  {%- for ip in [params.dns_server_ip] + params.suspicious_ips -%}
    {%- if module.ipaddress.ip_address(ip).version != 4 -%}{{ dispatch.exhaust() }}{%- endif -%}
  {%- endfor -%}
  {%- for name in [params.suspicious_name, params.internal_domain] -%}
    {%- if name | length > 100 -%}{{ dispatch.exhaust() }}{%- endif -%}
    {%- for label in name.split('.') -%}
      {%- if label | length > 63 or not module.re.fullmatch('[a-z0-9](?:[a-z0-9-]*[a-z0-9])?', label) -%}{{ dispatch.exhaust() }}{%- endif -%}
    {%- endfor -%}
  {%- endfor -%}
  {#- Office-hours activity by UTC hour; each client runs it shifted. -#}
  {%- set curve = [0.22, 0.2, 0.2, 0.2, 0.22, 0.28, 0.4, 0.6, 0.85, 1.0, 1.0, 0.95,
      0.85, 0.92, 1.0, 0.97, 0.88, 0.7, 0.52, 0.4, 0.33, 0.28, 0.25, 0.23] -%}
  {%- set weights = [] -%}
  {%- set shifts = {} -%}
  {%- for ip in clients -%}
    {%- do weights.append(module.rand.number.lognormal(0, 0.7)) -%}
    {%- do shifts.update({ip: module.rand.number.floating(-3, 3)}) -%}
  {%- endfor -%}
  {%- do shared.update({'initialized': true, 'clients': clients, 'weights': weights,
      'shifts': shifts, 'curve': curve, 'pending': [], 'dns_cache': {}, 'hist': {},
      'ep_at': none, 'ep_client': none, 'ep_ip': none}) -%}
{%- endif -%}

{%- set clients = shared.get('clients') -%}
{%- set curve = shared.get('curve') -%}
{%- set pending = shared.get('pending') -%}
{%- set cache = shared.get('dns_cache') -%}
{%- set hist = shared.get('hist') -%}

{%- macro rid(prefix) -%}
{#- Opaque Zeek-like UID/FUID: prefix plus 16-17 base62 characters. -#}
{{- prefix ~ module.rand.choices('ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789' | list, module.rand.weighted_choice([17, 16], [80, 20])) | join -}}
{%- endmacro -%}

{%- macro pick_start(lo, span) -%}
{#- Time in [lo, lo + span) with its UTC hour weighted by curve^2 + 0.02. -#}
{%- set top = (curve | max) ** 2 + 0.02 -%}
{%- set r = namespace(v=lo + module.rand.number.floating(0, span), ok=false) -%}
{%- for _ in range(400) if not r.ok -%}
  {%- set c = lo + module.rand.number.floating(0, span) -%}
  {%- if module.rand.number.floating(0, top) < curve[((c // hour) | int) % 24] ** 2 + 0.02 -%}
    {%- set r.v = c -%}{%- set r.ok = true -%}
  {%- endif -%}
{%- endfor -%}
{{- '%.6f' | format(r.v) -}}
{%- endmacro -%}

{#- Resolve a new name: answer IP and whether it is a watched node name. -#}
{%- macro new_name(out) -%}
  {%- set kind = module.rand.weighted_choice(['portal', 'mail', 'db', 'node', 'missing'], [30, 20, 25, 10, 4]) -%}
  {%- if kind == 'portal' -%}{%- do out.update({'name': 'portal.example.net', 'ip': '203.0.113.25'}) -%}
  {%- elif kind == 'mail' -%}{%- do out.update({'name': 'mail.example.net', 'ip': '203.0.113.42'}) -%}
  {%- elif kind == 'db' -%}{%- do out.update({'name': 'db.' ~ params.internal_domain, 'ip': '10.20.0.15'}) -%}
  {%- elif kind == 'node' -%}{%- do out.update({'name': 'node-' ~ module.rand.string.hex(8) ~ '.' ~ params.suspicious_name, 'ip': module.rand.choice(params.suspicious_ips)}) -%}
  {%- else -%}{%- do out.update({'name': 'missing.' ~ params.internal_domain, 'ip': none}) -%}
  {%- endif -%}
{%- endmacro -%}

{#- Plan one flow: protocol record plus connection summary into pending.
    spec: src, protocol, start, name, ip, and for http optional method
    and status. Returns nothing; fills spec.ts with the protocol time. -#}
{%- macro plan(spec) -%}
  {%- set src = spec.src -%}
  {%- set protocol = spec.protocol -%}
  {#- Zeek JSON doubles carry at most six decimals: microsecond times. -#}
  {%- set start = spec.start | round(6) -%}
  {%- set uid = rid('C') -%}
  {%- set src_port = module.rand.number.integer(32768, 60999) -%}
  {%- set f = namespace(name=spec.name, dst=params.dns_server_ip, dest_port=53, orig=0, resp=0, duration=0, proto_ts=start, ready=start, native={}, request='', response='') -%}
  {%- if protocol == 'dns' -%}
    {%- set ok = spec.ip is not none -%}
    {%- set ttl = module.rand.choice([1800, 3600, 7200]) -%}
    {%- set rtt_us = module.rand.number.clamp(module.rand.number.lognormal(module.math.log(12000), 0.5), 1000, 120000) | int -%}
    {%- set f.duration = rtt_us / 1000000 -%}
    {%- set f.ready = start + f.duration -%}
    {#- One question; compressed A answer or uncompressed authority SOA. -#}
    {%- set f.orig = 18 + f.name | length -%}
    {%- set f.resp = f.orig + (16 if ok else 3 * params.internal_domain | length + 50) -%}
    {%- set f.native = {'ts': start, 'uid': uid, 'id.orig_h': src, 'id.orig_p': src_port, 'id.resp_h': f.dst, 'id.resp_p': 53,
      'proto': 'udp', 'trans_id': module.rand.number.integer(0, 65535)} -%}
    {%- if ok -%}{%- do f.native.update({'rtt': f.duration}) -%}{%- endif -%}
    {%- do f.native.update({'query': f.name,
      'qclass': 1, 'qclass_name': 'C_INTERNET', 'qtype': 1, 'qtype_name': 'A', 'rcode': 0 if ok else 3,
      'rcode_name': 'NOERROR' if ok else 'NXDOMAIN', 'AA': false, 'TC': false, 'RD': true, 'RA': ok, 'Z': 0}) -%}
    {%- if ok -%}
      {%- do f.native.update({'answers': [spec.ip], 'TTLs': [ttl | float]}) -%}
      {%- do spec.update({'expires': f.ready + ttl}) -%}
    {%- endif -%}
    {%- do f.native.update({'rejected': false}) -%}
    {%- set conn_ready = start + 10 -%}
    {%- set orig_pkts = 1 -%}{%- set resp_pkts = 1 -%}
    {%- set orig_ip_bytes = f.orig + 28 -%}{%- set resp_ip_bytes = f.resp + 28 -%}
  {%- else -%}
    {%- set f.dst = spec.ip -%}
    {%- set f.proto_ts = (start + spec.get('connect_us', module.rand.number.clamp(module.rand.number.lognormal(module.math.log(25000), 0.4), 1000, 180000) | int) / 1000000) | round(6) -%}
    {%- if protocol == 'http' -%}
      {%- set f.dest_port = 80 -%}
      {%- set method = spec.method -%}
      {%- set uri = '/upload' if method == 'POST' else module.rand.choice(['/health', '/index.html', '/api/items']) -%}
      {%- set status = spec.status if method == 'POST' else module.rand.weighted_choice([200, 304, 404], [88, 9, 3]) -%}
      {%- if status == 404 -%}{%- set uri = '/missing.json' -%}{%- endif -%}
      {%- set content_type = 'text/html' if uri == '/index.html' and status == 200 else 'application/json' -%}
      {%- set message = {200: 'OK', 304: 'Not Modified', 404: 'Not Found', 503: 'Service Unavailable'}[status] -%}
      {%- set body = spec.body if method == 'POST' else 0 -%}
      {%- set response_body = 0 if status == 304 else (module.rand.number.integer(20, 160) if method == 'POST' and status == 200 else (256 if status in [404, 503] else {'/health': 200, '/index.html': 14000, '/api/items': 8400}[uri])) -%}
      {%- set f.request = method ~ ' ' ~ uri ~ ' HTTP/1.1\r\nHost: ' ~ f.name ~ '\r\nUser-Agent: curl/8.5.0\r\nConnection: close\r\n' -%}
      {%- if status == 304 -%}{%- set f.request = f.request ~ 'If-None-Match: "v1"\r\n' -%}{%- endif -%}
      {%- if body > 0 -%}{%- set f.request = f.request ~ 'Content-Type: application/octet-stream\r\nContent-Length: ' ~ body ~ '\r\n' -%}{%- endif -%}
      {%- set f.request = f.request ~ '\r\n' -%}
      {#- Receive the request body before creating response headers. -#}
      {%- set f.orig = f.request | length + body -%}
      {%- set processing_us = module.rand.number.integer(10000, 120000) -%}
      {%- set link_mbps = module.rand.number.integer(10, 40) -%}
      {%- set header_at = f.proto_ts + (f.orig * 8 / link_mbps + processing_us) / 1000000 -%}
      {%- set date = module.datetime.datetime.fromtimestamp(header_at, utc).strftime('%a, %d %b %Y %H:%M:%S GMT') -%}
      {%- set f.response = 'HTTP/1.1 ' ~ status ~ ' ' ~ message ~ '\r\nDate: ' ~ date ~ '\r\nConnection: close\r\n' -%}
      {%- if method == 'GET' and status in [200, 304] -%}{%- set f.response = f.response ~ 'ETag: "v1"\r\n' -%}{%- endif -%}
      {%- if status != 304 -%}{%- set f.response = f.response ~ 'Content-Type: ' ~ content_type ~ '\r\nContent-Length: ' ~ response_body ~ '\r\n' -%}{%- endif -%}
      {%- set f.response = f.response ~ '\r\n' -%}
      {%- set f.resp = f.response | length + response_body -%}
      {#- Selected uncompressed Content-Length messages, 10-40 Mbit/s link. -#}
      {%- set transaction_us = processing_us + ((f.orig + f.resp) * 8 / link_mbps) | int -%}
      {%- set f.ready = f.proto_ts + transaction_us / 1000000 -%}
      {%- set f.native = {'ts': f.proto_ts, 'uid': uid, 'id.orig_h': src, 'id.orig_p': src_port, 'id.resp_h': f.dst, 'id.resp_p': 80,
        'trans_depth': 1, 'method': method, 'host': f.name, 'uri': uri, 'version': '1.1', 'user_agent': 'curl/8.5.0',
        'request_body_len': body, 'response_body_len': response_body, 'status_code': status, 'status_msg': message, 'tags': []} -%}
      {%- if body > 0 -%}{%- do f.native.update({'orig_fuids': [rid('F')], 'orig_mime_types': ['application/octet-stream']}) -%}{%- endif -%}
      {%- if response_body > 0 -%}{%- do f.native.update({'resp_fuids': [rid('F')], 'resp_mime_types': [content_type]}) -%}{%- endif -%}
    {%- else -%}
      {%- set f.dest_port = 443 -%}
      {%- set handshake_us = module.rand.number.integer(20000, 150000) -%}
      {%- set f.ready = f.proto_ts + handshake_us / 1000000 -%}
      {#- No PSK, HRR or compatibility CCS. Only C/S visible before encrypted records. -#}
      {%- set f.native = {'ts': f.proto_ts, 'uid': uid, 'id.orig_h': src, 'id.orig_p': src_port, 'id.resp_h': f.dst, 'id.resp_p': 443,
        'version': 'TLSv13', 'cipher': module.rand.choice(['TLS_AES_128_GCM_SHA256', 'TLS_AES_256_GCM_SHA384']),
        'curve': 'x25519', 'server_name': f.name, 'resumed': false, 'established': true, 'ssl_history': 'Cs'} -%}
      {%- set f.orig = module.rand.number.integer(600, 5000) -%}
      {%- set f.resp = module.rand.number.integer(3500, 14000) -%}
    {%- endif -%}
    {#- FIN in both directions, then trailing ACK excluded from conn.duration. -#}
    {%- set productive_end = (f.ready if protocol == 'http' else f.ready + module.rand.number.integer(10000, 400000) / 1000000) + 1000 / 1000000 -%}
    {%- set f.duration = ((productive_end - start) * 1000000) | round | int / 1000000 -%}
    {%- set conn_ready = start + f.duration + 5 -%}
    {%- set orig_segments = (f.orig + 1447) // 1448 -%}{%- set resp_segments = (f.resp + 1447) // 1448 -%}
    {%- set orig_pkts = orig_segments + (resp_segments + 1) // 2 + 4 -%}
    {%- set resp_pkts = resp_segments + (orig_segments + 1) // 2 + 3 -%}
    {%- set orig_ip_bytes = f.orig + 60 + 52 * (orig_pkts - 1) -%}
    {%- set resp_ip_bytes = f.resp + 60 + 52 * (resp_pkts - 1) -%}
  {%- endif -%}
  {%- set conn = {'ts': start, 'uid': uid, 'id.orig_h': src, 'id.orig_p': src_port, 'id.resp_h': f.dst, 'id.resp_p': f.dest_port,
    'proto': 'udp' if protocol == 'dns' else 'tcp', 'service': protocol, 'duration': f.duration,
    'orig_bytes': f.orig, 'resp_bytes': f.resp, 'conn_state': 'SF', 'local_orig': true,
    'local_resp': f.dst.startswith('10.'), 'missed_bytes': 0, 'history': 'Dd' if protocol == 'dns' else 'ShADadFf',
    'orig_pkts': orig_pkts, 'orig_ip_bytes': orig_ip_bytes, 'resp_pkts': resp_pkts, 'resp_ip_bytes': resp_ip_bytes, 'ip_proto': 17 if protocol == 'dns' else 6} -%}
  {%- do pending.append({'dataset': protocol, 'ready': f.ready, 'native': f.native}) -%}
  {%- do pending.append({'dataset': 'connection', 'ready': conn_ready, 'native': conn}) -%}
  {%- do spec.update({'ts': f.native.ts}) -%}
{%- endmacro -%}

{#- 1. Background: at most one new flow per tick. -#}
{%- set cand = module.rand.weighted_choice(clients, shared.get('weights')) -%}
{%- set local_hour = ((clock / hour + shared.get('shifts')[cand]) | int) % 24 -%}
{%- if pending | length < 64 and module.rand.chance(0.3 * curve[local_hour]) -%}
  {%- set src = cand -%}
  {%- set start = clock + module.rand.number.integer(0, 1999999) / 1000000 -%}
  {#- Up to three live name mappings per client, used concurrently. -#}
  {%- set entries = cache.get(src, []) -%}
  {%- set live = entries | selectattr('expires', 'gt', start + 0.2) | list -%}
  {%- set protocol = module.rand.weighted_choice(['dns', 'ssl', 'http'], [35, 45, 20]) if live else 'dns' -%}
  {%- set spec = {'src': src, 'protocol': protocol, 'start': start} -%}
  {%- if protocol == 'dns' -%}
    {#- Re-resolve a known name, or look up a new one. -#}
    {%- if entries and module.rand.chance(0.2 if live else 0.5) -%}
      {%- set entry = module.rand.choice(live if live else entries) -%}
      {%- do spec.update({'name': entry.name, 'ip': entry.ip}) -%}
    {%- else -%}
      {{- new_name(spec) -}}
    {%- endif -%}
    {{- plan(spec) -}}
    {%- if spec.ip is not none -%}
      {%- set kept = live | rejectattr('name', 'equalto', spec.name) | list -%}
      {%- do kept.append({'name': spec.name, 'ip': spec.ip, 'expires': spec.expires}) -%}
      {%- do cache.update({src: kept[-3:]}) -%}
    {%- endif -%}
  {%- else -%}
    {%- set entry = module.rand.choice(live) -%}
    {%- do spec.update({'name': entry.name, 'ip': entry.ip}) -%}
    {%- if protocol == 'http' -%}
      {%- set method = module.rand.weighted_choice(['GET', 'POST'], [75, 25]) -%}
      {%- do spec.update({'method': method, 'status': 200 if module.rand.chance(0.97) else 503,
          'body': module.rand.number.integer(250000, 2000000)}) -%}
    {%- endif -%}
    {%- if protocol == 'http' and spec.method == 'POST' and spec.status == 200 and spec.name.endswith('.' ~ params.suspicious_name) -%}
      {#- Guard: DNS answer for this name, then 5 TLS to it, then another
          DNS for it, all within the chain window before this POST. -#}
      {%- do spec.update({'connect_us': module.rand.number.clamp(module.rand.number.lognormal(module.math.log(25000), 0.4), 1000, 180000) | int}) -%}
      {%- set post_ts = (start | round(6) + spec.connect_us / 1000000) | round(6) -%}
      {%- set g = namespace(state=0, tls=0) -%}
      {%- for e in hist.get(src, []) | sort(attribute='t') if e.n == spec.name and e.t >= post_ts - window -%}
        {%- if g.state == 0 and e.k == 'dns' -%}{%- set g.state = 1 -%}
        {%- elif g.state == 1 and e.k == 'ssl' -%}{%- set g.tls = g.tls + 1 -%}{%- if g.tls >= 5 -%}{%- set g.state = 2 -%}{%- endif -%}
        {%- elif g.state == 2 and e.k == 'dns' -%}{%- set g.state = 3 -%}
        {%- endif -%}
      {%- endfor -%}
      {%- if g.state == 3 -%}{%- do spec.update({'status': 503}) -%}{%- endif -%}
    {%- endif -%}
    {{- plan(spec) -}}
  {%- endif -%}
  {#- History of watched-name DNS/TLS per client, for the guard only. -#}
  {%- if spec.name.endswith('.' ~ params.suspicious_name) and protocol in ['dns', 'ssl'] -%}
    {%- set kept = hist.get(src, []) | selectattr('t', 'gt', clock - window - 60) | list -%}
    {%- do kept.append({'t': spec.ts, 'k': protocol, 'n': spec.name}) -%}
    {%- do hist.update({src: kept[-48:]}) -%}
  {%- endif -%}
{%- endif -%}

{#- 2. Episode: first start in the first min(interval, 24 h), later ones in
    a window of min(interval / 4, 6 h) centred one interval after the
    actual start; hours weighted by curve^2 + 0.02, then a random delay.
    No catch-up. Client and destination rotate. -#}
{%- if params.anomaly_mode -%}
  {%- if shared.get('ep_at') is none -%}
    {%- do shared.set('ep_at', (pick_start(clock, [interval, 24 * hour] | min) | float) + module.rand.number.exponential(1 / 240)) -%}
  {%- endif -%}
  {%- if clock >= shared.get('ep_at') -%}
    {%- set others = [] -%}{%- set ow = [] -%}
    {%- for ip in clients if ip != shared.get('ep_client') -%}
      {%- do others.append(ip) -%}{%- do ow.append(shared.get('weights')[clients.index(ip)]) -%}
    {%- endfor -%}
    {%- set src = module.rand.weighted_choice(others, ow) -%}
    {%- set dst = module.rand.choice(params.suspicious_ips | reject('equalto', shared.get('ep_ip')) | list) -%}
    {%- set name = 'node-' ~ module.rand.string.hex(8) ~ '.' ~ params.suspicious_name -%}
    {%- set n_tls = module.rand.weighted_choice([5, 6, 7], [50, 30, 20]) -%}
    {%- set gaps = [] -%}
    {%- for i in range(n_tls) -%}{%- do gaps.append(module.rand.number.lognormal(module.math.log(110), 0.45)) -%}{%- endfor -%}
    {%- do gaps.append(module.rand.number.lognormal(module.math.log(70), 0.6)) -%}
    {%- do gaps.append(module.rand.number.lognormal(module.math.log(60), 0.6)) -%}
    {%- set scale = [1.0, 1500 / (gaps | sum)] | min -%}
    {%- set t = namespace(v=clock + module.rand.number.integer(0, 1999999) / 1000000) -%}
    {%- set spec = {'src': src, 'protocol': 'dns', 'start': t.v, 'name': name, 'ip': dst} -%}
    {{- plan(spec) -}}
    {%- for i in range(n_tls) -%}
      {%- set t.v = t.v + gaps[i] * scale -%}
      {{- plan({'src': src, 'protocol': 'ssl', 'start': t.v, 'name': name, 'ip': dst}) -}}
    {%- endfor -%}
    {%- set t.v = t.v + gaps[n_tls] * scale -%}
    {{- plan({'src': src, 'protocol': 'dns', 'start': t.v, 'name': name, 'ip': dst}) -}}
    {%- set t.v = t.v + gaps[n_tls + 1] * scale -%}
    {{- plan({'src': src, 'protocol': 'http', 'start': t.v, 'name': name, 'ip': dst, 'method': 'POST', 'status': 200,
        'body': module.rand.number.integer(250000, 2000000)}) -}}
    {%- set w = [interval / 4, 6 * hour] | min -%}
    {%- do shared.update({'ep_client': src, 'ep_ip': dst,
        'ep_at': (pick_start(clock + interval - w / 2, w) | float) + module.rand.number.exponential(1 / 240)}) -%}
  {%- endif -%}
{%- endif -%}

{#- 3. Collector poll: emit the earliest completed record. -#}
{%- set pending = pending | sort(attribute='ready') -%}
{%- do shared.set('pending', pending) -%}
{%- if not pending or pending[0].ready > clock -%}{{ dispatch.drop() }}{%- endif -%}
{%- set record = pending.pop(0) -%}
{%- set native = record.native -%}
{%- set protocol = record.dataset -%}
{%- set dataset = 'zeek.' ~ protocol -%}
{%- set at = module.datetime.datetime.fromtimestamp(native.ts, utc).isoformat(timespec='microseconds') -%}
{%- set read_ts = clock + module.rand.number.integer(1000, 1900000) / 1000000 -%}
{%- set read_at = module.datetime.datetime.fromtimestamp(read_ts, utc).isoformat(timespec='microseconds') -%}
{%- set ingest_at = module.datetime.datetime.fromtimestamp(read_ts + module.rand.number.lognormal(module.math.log(1.2), 0.5), utc).isoformat(timespec='microseconds') -%}
{%- set native_parts = [] -%}
{%- for key, value in native.items() -%}{%- do native_parts.append((key | tojson) ~ ':' ~ (value | tojson)) -%}{%- endfor -%}
{%- set raw = '{' ~ native_parts | join(',') ~ '}' -%}
{%- set doc = {'@timestamp': at, 'ecs': {'version': '8.17.0'},
  'agent': {'type': 'filebeat', 'name': params.sensor_name, 'id': params.sensor_id, 'ephemeral_id': params.sensor_ephemeral_id, 'version': params.sensor_version},
  'observer': {'name': params.sensor_name, 'product': 'Zeek', 'type': 'ids', 'version': '8.0.0'}, 'host': {'name': params.sensor_name},
  'data_stream': {'type': 'logs', 'dataset': dataset, 'namespace': 'default'},
  'event': {'kind': 'event', 'category': ['network'], 'type': ['connection', 'protocol', 'info'], 'dataset': dataset, 'module': 'zeek',
    'id': native.uid, 'created': read_at, 'ingested': ingest_at, 'original': raw}, 'message': raw,
  'source': {'address': native['id.orig_h'], 'ip': native['id.orig_h'], 'port': native['id.orig_p']},
  'destination': {'address': native['id.resp_h'], 'ip': native['id.resp_h'], 'port': native['id.resp_p']},
  'network': {'transport': 'udp' if protocol == 'dns' or (protocol == 'connection' and native.proto == 'udp') else 'tcp'},
  'related': {'ip': [native['id.orig_h'], native['id.resp_h']]}, 'tags': ['zeek-' ~ protocol],
  'log': {'file': {'path': '/opt/zeek/logs/current/' ~ ('conn' if protocol == 'connection' else protocol) ~ '.log'}},
  'input': {'type': 'filestream'}, 'zeek': {'session_id': native.uid}} -%}
{%- set parsed = {} -%}
{%- for key, value in native.items() if key not in ['ts', 'uid', 'id.orig_h', 'id.orig_p', 'id.resp_h', 'id.resp_p'] -%}{%- do parsed.update({key: value}) -%}{%- endfor -%}
{%- if protocol == 'connection' -%}
  {%- do parsed.update({'state': parsed.pop('conn_state'), 'state_message': 'Normal establishment and termination.'}) -%}
  {%- do doc.source.update({'bytes': native.orig_bytes, 'packets': native.orig_pkts}) -%}
  {%- do doc.destination.update({'bytes': native.resp_bytes, 'packets': native.resp_pkts}) -%}
  {%- do doc.network.update({'bytes': native.orig_bytes + native.resp_bytes, 'packets': native.orig_pkts + native.resp_pkts, 'protocol': native.service}) -%}
  {%- do doc.event.update({'duration': (native.duration * 1000000000) | round | int, 'type': ['connection', 'end'], 'outcome': 'success'}) -%}
{%- elif protocol == 'dns' -%}
  {%- do doc.network.update({'protocol': 'dns'}) -%}
  {%- set dns = {'id': native.trans_id | string, 'type': 'answer', 'question': {'name': native.query, 'type': 'A', 'class': 'IN'}, 'response_code': native.rcode_name, 'header_flags': ['RD', 'RA'] if native.RA else ['RD']} -%}
  {%- if native.rcode == 0 -%}
    {%- do dns.update({'resolved_ip': native.answers, 'answers': [{'name': native.query, 'type': 'A', 'class': 'IN', 'data': native.answers[0], 'ttl': native.TTLs[0] | int}]}) -%}
  {%- endif -%}
  {%- do parsed.update({'trans_id': native.trans_id | string}) -%}
  {%- do doc.update({'dns': dns}) -%}{%- do doc.event.update({'outcome': 'success' if native.rcode == 0 else 'failure'}) -%}
{%- elif protocol == 'http' -%}
  {%- do doc.network.update({'protocol': 'http'}) -%}
  {%- do doc.event.update({'action': native.method, 'category': ['network', 'web'], 'outcome': 'success' if native.status_code < 400 else 'failure'}) -%}
  {%- do doc.update({'http': {'version': '1.1', 'request': {'method': native.method, 'body': {'bytes': native.request_body_len}}, 'response': {'status_code': native.status_code, 'body': {'bytes': native.response_body_len}}},
    'url': {'domain': native.host, 'original': native.uri, 'path': native.uri}, 'user_agent': {'original': native.user_agent, 'name': 'curl', 'version': '8.5.0'}}) -%}
{%- else -%}
  {%- do doc.network.update({'protocol': 'tls'}) -%}
  {%- do doc.update({'tls': {'version': '1.3', 'version_protocol': 'tls', 'cipher': native.cipher, 'curve': native.curve, 'resumed': false, 'established': true, 'client': {'server_name': native.server_name}}}) -%}
{%- endif -%}
{%- do doc.zeek.update({protocol: parsed}) -%}
{{- doc | tojson -}}
