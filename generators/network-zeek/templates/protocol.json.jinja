{%- set flow = shared.get('current') -%}
{%- set uid = flow.uid -%}
{%- set src = flow.src -%}
{%- set dst = flow.dst -%}
{%- set protocol = flow.protocol -%}
{%- set dataset = 'zeek.' ~ protocol -%}
{%- set doc = {
    '@timestamp': timestamp.isoformat(),
    'agent': {'ephemeral_id': params.sensor_ephemeral_id, 'id': params.sensor_id,
              'name': params.sensor_name, 'type': 'filebeat', 'version': params.sensor_version},
    'data_stream': {'dataset': dataset, 'namespace': 'default', 'type': 'logs'},
    'destination': {'address': dst, 'ip': dst, 'port': flow.dst_port},
    'ecs': {'version': '8.17.0'},
    'elastic_agent': {'id': params.sensor_id, 'snapshot': false, 'version': params.sensor_version},
    'event': {'agent_id_status': 'verified', 'category': ['network'],
              'created': timestamp.isoformat(), 'dataset': dataset,
              'id': uid, 'ingested': timestamp.isoformat(), 'kind': 'event',
              'type': ['connection', 'protocol', 'info']},
    'host': {'name': params.sensor_name},
    'input': {'type': 'filestream'},
    'log': {'file': {'path': '/opt/zeek/logs/current/' ~ protocol ~ '.log'}},
    'network': {'transport': flow.transport},
    'related': {'ip': [src, dst]},
    'source': {'address': src, 'ip': src, 'port': flow.src_port},
    'tags': ['zeek-' ~ protocol],
    'zeek': {'session_id': uid}
} -%}
{%- if protocol == 'dns' -%}
  {%- set query = params.suspicious_name if flow.attack else module.rand.choice(['www.example.net', 'mail.example.net', 'db.' ~ params.internal_domain, 'portal.example.net']) -%}
  {%- set answer = params.suspicious_ip if flow.attack else module.rand.choice(['203.0.113.25', '203.0.113.42', '10.20.0.15']) -%}
  {%- set ok = flow.attack or module.rand.chance(0.96) -%}
  {%- set trans_id = module.rand.number.integer(1, 65535) -%}
  {%- set ttl = module.rand.choice([60, 120, 300, 600]) -%}
  {%- set rcode = 0 if ok else 3 -%}
  {%- set rcode_name = 'NOERROR' if ok else 'NXDOMAIN' -%}
  {%- set answers = [answer] if ok else [] -%}
  {%- set ttls = [ttl] if ok else [] -%}
  {%- set native = {
      'ts': timestamp.timestamp(), 'uid': uid,
      'id.orig_h': src, 'id.orig_p': flow.src_port,
      'id.resp_h': dst, 'id.resp_p': flow.dst_port,
      'proto': 'udp', 'trans_id': trans_id, 'query': query,
      'qclass': 1, 'qclass_name': 'C_INTERNET', 'qtype': 1, 'qtype_name': 'A',
      'rcode': rcode, 'rcode_name': rcode_name,
      'AA': false, 'TC': false, 'RD': true, 'RA': true, 'Z': 0,
      'answers': answers, 'TTLs': ttls, 'rejected': false
  } -%}
  {%- do doc.update({
      'dns': {'answers': [{'data': answer, 'ttl': ttl}] if ok else [],
              'header_flags': ['RD', 'RA'], 'id': trans_id,
              'resolved_ip': [answer] if ok else [],
              'response_code': rcode_name, 'type': 'answer'},
      'network': {'protocol': 'dns', 'transport': 'udp'},
      'zeek': {'session_id': uid,
               'dns': {'AA': false, 'RA': true, 'RD': true, 'TC': false,
                       'TTLs': ttls, 'answers': answers,
                       'query': query, 'rcode': rcode,
                       'rcode_name': rcode_name, 'rejected': false,
                       'trans_id': trans_id}}
  }) -%}
  {%- do doc.event.update({'outcome': 'success' if ok else 'failure'}) -%}
{%- elif protocol == 'http' -%}
  {%- set method = 'POST' if flow.attack else 'GET' -%}
  {%- set domain = params.suspicious_name if flow.attack else 'portal.example.net' -%}
  {%- set uri = '/upload' if flow.attack else module.rand.choice(['/health', '/index.html', '/api/items']) -%}
  {%- set status_code = 200 if flow.attack else module.rand.weighted_choice([200, 304, 404], [90, 8, 2]) -%}
  {%- set status_msg = 'OK' if status_code == 200 else ('Not Modified' if status_code == 304 else 'Not Found') -%}
  {%- set request_bytes = 900000 if flow.attack else 0 -%}
  {%- set response_bytes = flow.resp_bytes -%}
  {%- set file_id = 'F' ~ module.rand.string.letters(12) -%}
  {%- set native = {
      'ts': timestamp.timestamp(), 'uid': uid,
      'id.orig_h': src, 'id.orig_p': flow.src_port,
      'id.resp_h': dst, 'id.resp_p': flow.dst_port,
      'trans_depth': 1, 'method': method, 'host': domain,
      'uri': uri, 'version': '1.1', 'user_agent': 'curl/8.5.0',
      'request_body_len': request_bytes,
      'response_body_len': response_bytes,
      'status_code': status_code, 'status_msg': status_msg,
      'tags': [], 'resp_fuids': [file_id], 'resp_mime_types': ['application/json']
  } -%}
  {%- do doc.event.update({'action': method,
                           'outcome': 'success' if status_code < 400 else 'failure',
                           'category': ['network', 'web']}) -%}
  {%- do doc.update({
      'http': {'request': {'body': {'bytes': request_bytes}, 'method': method},
               'response': {'body': {'bytes': response_bytes}, 'status_code': status_code},
               'version': '1.1'},
      'url': {'domain': domain, 'original': uri, 'path': uri},
      'user_agent': {'device': {'name': 'Other'}, 'name': 'curl',
                     'original': 'curl/8.5.0', 'version': '8.5.0'},
      'zeek': {'session_id': uid,
               'http': {'resp_fuids': [file_id], 'resp_mime_types': ['application/json'],
                        'status_msg': status_msg, 'tags': [], 'trans_depth': 1}}
  }) -%}
{%- else -%}
  {%- set name = params.suspicious_name if flow.attack else 'portal.example.net' -%}
  {%- set common_name = name -%}
  {%- set subject = 'CN=' ~ common_name ~ ',O=Example Corp,L=Moscow,ST=Moscow,C=RU' -%}
  {%- set issuer = 'CN=Example Test CA,O=Example Corp,C=RU' -%}
  {%- set file_id = 'F' ~ module.rand.string.letters(12) -%}
  {%- set native = {
      'ts': timestamp.timestamp(), 'uid': uid,
      'id.orig_h': src, 'id.orig_p': flow.src_port,
      'id.resp_h': dst, 'id.resp_p': flow.dst_port,
      'version': 'TLSv13', 'cipher': 'TLS_AES_256_GCM_SHA384',
      'curve': 'x25519', 'server_name': name,
      'resumed': false, 'established': true,
      'cert_chain_fuids': [file_id], 'client_cert_chain_fuids': [],
      'subject': subject, 'issuer': issuer, 'validation_status': 'ok'
  } -%}
  {%- do doc.update({
      'client': {'address': src}, 'server': {'address': dst},
      'tls': {'cipher': native.cipher, 'curve': 'x25519',
              'established': true, 'resumed': false,
              'server': {'issuer': issuer, 'subject': subject,
                         'x509': {'issuer': {'common_name': ['Example Test CA'],
                                             'country': ['RU'], 'organization': ['Example Corp']},
                                  'subject': {'common_name': [common_name],
                                              'country': ['RU'], 'locality': ['Moscow'],
                                              'organization': ['Example Corp'],
                                              'state_or_province': ['Moscow']}}},
              'version': '1.3', 'version_protocol': 'tls'},
      'zeek': {'session_id': uid,
               'ssl': {'cipher': native.cipher, 'curve': 'x25519',
                       'established': true, 'resumed': false,
                       'server': {'cert_chain_fuids': [file_id],
                                  'issuer': {'common_name': 'Example Test CA', 'country': 'RU',
                                             'organization': 'Example Corp'},
                                  'name': name,
                                  'subject': {'common_name': common_name, 'country': 'RU',
                                              'locality': 'Moscow', 'organization': 'Example Corp',
                                              'state': 'Moscow'}},
                       'validation': {'status': 'ok'}, 'version': 'TLSv13'}}
  }) -%}
  {%- do doc.event.update({'type': ['connection', 'protocol']}) -%}
{%- endif -%}
{%- do doc.event.update({'original': native|tojson}) -%}
{{- doc|tojson -}}
