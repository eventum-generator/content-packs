{%- if params.anomaly_mode -%}
{%- from 'templates/_base.json.jinja' import render with context -%}
{%- if vars.arc -%}
  {%- set pod = shared.get('arc_pod') -%}
{%- else -%}
  {%- set pod = samples.pods.pick() -%}
{%- endif -%}
{%- set local_port = module.rand.number.integer(32768, 60999) -%}
{%- set connection = pod.pod_ip ~ ':' ~ local_port ~ '->10.96.0.1:443' -%}
{%- set command = 'curl -ks https://kubernetes.default.svc.cluster.local/api' -%}
{%- set body = 'Unexpected connection to K8s API Server from container | connection=' ~ connection ~
  ' lport=' ~ local_port ~ ' rport=443 fd_type=ipv4 fd_proto=tcp evt_type=connect user=' ~ pod.uid ~
  ' user_uid=0 user_loginuid=-1 process=curl proc_exepath=/usr/bin/curl parent=bash command=' ~
  command ~ ' terminal=34816 container_id=' ~ pod.container_id ~ ' container_name=' ~ pod.container_name -%}
{%- set raw_extra = {
  'evt.category': 'net', 'fd.name': connection, 'fd.lport': local_port,
  'fd.rip': '10.96.0.1', 'fd.rport': 443, 'fd.type': 'ipv4',
  'fd.typechar': '4', 'fd.sip.name': 'kubernetes.default.svc.cluster.local',
  'fd.l4proto': 'tcp'
} -%}
{%- set parsed_extra = {
  'evt': {'time': {'iso8601': (timestamp.timestamp() * 1000) | int},
          'type': 'connect', 'category': 'net'},
  'fd': {'name': connection, 'lport': local_port,
         'rip': '10.96.0.1', 'rport': 443, 'type': 'ipv4',
         'typechar': '4', 'sip': {'name': 'kubernetes.default.svc.cluster.local'},
         'l4proto': 'tcp'}
} -%}
{%- set rendered = render(pod, 'Contact K8S API Server From Container', 'Notice', 'T1565',
    ['maturity_stable', 'container', 'network', 'k8s', 'mitre_discovery', 'T1565'],
    'connect', ['network'], ['connection'], 'curl', '/usr/bin/curl', 'bash', command, 34816,
    body, raw_extra, parsed_extra) -%}
{%- if vars.arc -%}
  {%- do shared.pop('arc_pod') -%}
{%- endif -%}
{{- rendered -}}
{%- else -%}
{%- include 'templates/shell.json.jinja' -%}
{%- endif -%}
