{%- from 'templates/_base.json.jinja' import render with context -%}
{%- if vars.arc and params.anomaly_mode -%}
  {%- set pod = shared.get('arc_pod') -%}
{%- else -%}
  {%- set pod = samples.pods.pick() -%}
{%- endif -%}
{%- set file_path = '/etc/shadow' -%}
{%- set command = 'python3 /tmp/check_users.py' -%}
{%- set body = 'Sensitive file opened for reading by non-trusted program | file=' ~ file_path ~
  ' evt_type=openat user=' ~ pod.uid ~ ' user_uid=0 user_loginuid=-1 process=python3' ~
  ' proc_exepath=/usr/bin/python3 parent=bash command=' ~ command ~ ' terminal=34816' ~
  ' container_id=' ~ pod.container_id ~ ' container_name=' ~ pod.container_name -%}
{{- render(pod, 'Read sensitive file untrusted', 'Warning', 'T1555',
    ['T1555', 'container', 'filesystem', 'host', 'maturity_stable', 'mitre_credential_access'],
    'openat', ['process'], ['access'], 'python3', '/usr/bin/python3', 'bash', command, 34816,
    body, {'fd.name': file_path}, {'fd': {'name': file_path}}) -}}
