{%- from 'templates/_base.json.jinja' import render with context -%}
{%- if vars.arc and params.anomaly_mode -%}
  {%- set picked = samples.pods.pick() -%}
  {%- set pod = dict(
    container_id=picked.container_id, container_name=picked.container_name,
    pod_name=picked.pod_name, namespace=picked.namespace, pod_ip=picked.pod_ip,
    image=picked.image, node=picked.node, node_id=picked.node_id,
    node_ip=picked.node_ip, node_mac=picked.node_mac, uid=picked.uid
  ) -%}
  {%- do shared.set('arc_pod', pod) -%}
{%- else -%}
  {%- set pod = samples.pods.pick() -%}
{%- endif -%}
{%- set body = 'A shell was spawned in a container with an attached terminal | evt_type=execve user=' ~ pod.uid ~
  ' user_uid=0 user_loginuid=-1 process=bash proc_exepath=/bin/bash parent=runc command=bash terminal=34816' ~
  ' container_id=' ~ pod.container_id ~ ' container_name=' ~ pod.container_name -%}
{{- render(pod, 'Terminal shell in container', 'Notice', 'T1059',
    ['maturity_stable', 'container', 'shell', 'mitre_execution', 'T1059'],
    'execve', ['process'], ['start'], 'bash', '/bin/bash', 'runc', 'bash', 34816,
    body, {'evt.arg.flags': 0}, {}) -}}
