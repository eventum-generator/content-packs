{%- macro render(pod, rule, priority, technique, rule_tags, evt_type,
                category, event_type, proc_name, proc_exe, parent_name,
                cmdline, tty, output_body, raw_extra, parsed_extra) -%}
{%- set event_time = timestamp.strftime('%Y-%m-%dT%H:%M:%S.%f') ~ '000Z' -%}
{%- set output_time = timestamp.strftime('%Y-%m-%dT%H:%M:%S.%f') ~ '000+0000' -%}
{%- set output_text = output_time ~ ': ' ~ priority ~ ' ' ~ output_body -%}
{%- set raw_fields = {
  'container.id': pod.container_id,
  'container.name': pod.container_name,
  'container.image.repository': pod.image,
  'evt.time.iso8601': (timestamp.timestamp() * 1000000000) | int,
  'evt.type': evt_type,
  'k8s.ns.name': pod.namespace,
  'k8s.pod.name': pod.pod_name,
  'proc.cmdline': cmdline,
  'proc.exepath': proc_exe,
  'proc.name': proc_name,
  'proc.pname': parent_name,
  'proc.tty': tty,
  'user.loginuid': -1,
  'user.name': pod.uid,
  'user.uid': 0
} -%}
{%- do raw_fields.update(raw_extra) -%}
{%- set parsed_fields = {
  'container': {
    'id': pod.container_id,
    'name': pod.container_name,
    'image': {'repository': pod.image}
  },
  'evt': {
    'time': {'iso8601': (timestamp.timestamp() * 1000) | int},
    'type': evt_type
  },
  'k8s': {'ns': {'name': pod.namespace}, 'pod': {'name': pod.pod_name}},
  'proc': {
    'cmdline': cmdline,
    'exepath': proc_exe,
    'name': proc_name,
    'pname': parent_name,
    'tty': tty
  },
  'user': {'loginuid': -1, 'name': pod.uid, 'uid': '0'}
} -%}
{%- do parsed_fields.update(parsed_extra) -%}
{%- set native = {
  'hostname': pod.node,
  'output': output_text,
  'output_fields': raw_fields,
  'priority': priority,
  'rule': rule,
  'source': 'syscall',
  'tags': rule_tags,
  'time': event_time
} -%}
{%- set native_json = module.json.dumps(native, ensure_ascii=False, separators=(',', ':')) -%}
{%- set offset_key = 'log_offset:' ~ pod.node -%}
{%- set offset = shared.get(offset_key, 0) -%}
{%- do shared.set(offset_key, (offset + (native_json | length) + 1) % 104857600) -%}
{
  "@timestamp": {{ timestamp.isoformat() | tojson }},
  "agent": {
    "ephemeral_id": {{ pod.node_id | tojson }},
    "id": {{ pod.node_id | tojson }},
    "name": {{ ('elastic-agent-' ~ pod.node) | tojson }},
    "type": "filebeat",
    "version": {{ params.agent_version | tojson }}
  },
  "container": {
    "id": {{ pod.container_id | tojson }},
    "name": {{ pod.container_name | tojson }}
  },
  "data_stream": {
    "dataset": "falco.alerts",
    "namespace": {{ params.data_stream_namespace | tojson }},
    "type": "logs"
  },
  "ecs": {"version": {{ params.ecs_version | tojson }}},
  "elastic_agent": {
    "id": {{ pod.node_id | tojson }},
    "snapshot": false,
    "version": {{ params.agent_version | tojson }}
  },
  "event": {
    "agent_id_status": "verified",
    "category": {{ category | tojson }},
    "dataset": "falco.alerts",
    "ingested": {{ timestamp.isoformat() | tojson }},
    "kind": "alert",
    "original": {{ native_json | tojson }},
    "provider": "syscall",
    "severity": 47,
    "timezone": "+00:00",
    "type": {{ event_type | tojson }}
  },
  "falco": {
    "hostname": {{ pod.node | tojson }},
    "output": {{ output_text | tojson }},
    "output_fields": {{ parsed_fields | tojson }},
    "priority": {{ priority | tojson }},
    "rule": {{ rule | tojson }},
    "source": "syscall",
    "tags": {{ rule_tags | tojson }},
    "time": {{ event_time | tojson }}
  },
  "host": {
    "architecture": "x86_64",
    "containerized": true,
    "hostname": {{ pod.node | tojson }},
    "id": {{ pod.node_id | tojson }},
    "ip": [{{ pod.node_ip | tojson }}],
    "mac": [{{ pod.node_mac | tojson }}],
    "name": {{ pod.node | tojson }},
    "os": {
      "codename": "jammy",
      "family": "debian",
      "kernel": "5.15.0-91-generic",
      "name": "Ubuntu",
      "platform": "ubuntu",
      "type": "linux",
      "version": "22.04"
    }
  },
  "input": {"type": "log"},
  "log": {
    "file": {"path": {{ params.log_path | tojson }}},
    "offset": {{ offset | tojson }}
  },
  "message": {{ rule | tojson }},
  "observer": {
    "hostname": {{ pod.node | tojson }},
    "product": "falco",
    "type": "sensor",
    "vendor": "sysdig"
  },
  "process": {
    "command_line": {{ cmdline | tojson }},
    "executable": {{ proc_exe | tojson }},
    "name": {{ proc_name | tojson }},
    "parent": {"name": {{ parent_name | tojson }}},
    "user": {"id": "0", "name": {{ pod.uid | tojson }}}
  },
  "related": {"hosts": [{{ pod.node | tojson }}]},
  "rule": {"name": {{ rule | tojson }}},
  "tags": ["preserve_original_event", "preserve_falco_fields"],
  "threat.technique.id": [{{ technique | tojson }}]
}
{%- endmacro -%}
