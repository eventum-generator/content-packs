{%- for key in ['to_rapid_hop', 'to_routine'] -%}{%- do shared.pop(key, none) -%}{%- endfor -%}
{%- set stage = vars.stage -%}
{%- if stage == 'routine' -%}
  {%- set user = module.rand.choice(['alice', 'bob', 'device-ops']) -%}
  {%- set mac = module.rand.choice(['0200.5e10.0001', '0200.5e10.0002', '0200.5e10.0003']) -%}
  {%- set client_ip = module.rand.choice(['10.20.30.11', '10.20.30.12', '10.20.30.13']) -%}
  {%- set ap = module.rand.choice(['AP-Floor1', 'AP-Floor2', 'AP-Floor3']) -%}
  {%- set kind = module.rand.weighted_choice(['run', 'delete', 'ip_update'], [65, 20, 15]) -%}
  {%- set count = shared.get('routine_count', 0) + 1 -%}
  {%- if count >= 45 -%}
    {%- do shared.set('routine_count', 0) -%}
    {%- if params.anomaly_mode -%}{%- do shared.set('hop_count', 0) -%}{%- do shared.set('to_rapid_hop', true) -%}{%- endif -%}
  {%- else -%}{%- do shared.set('routine_count', count) -%}{%- endif -%}
{%- else -%}
  {%- set count = shared.get('hop_count', 0) + 1 -%}
  {%- set user = params.suspicious_user -%}{%- set mac = params.suspicious_mac -%}{%- set client_ip = params.suspicious_ip -%}
  {%- set kind = ['run', 'delete', 'run', 'delete', 'run', 'ip_update'][count - 1] -%}
  {%- set ap = 'AP-Floor1' if count <= 2 else 'AP-Floor2' if count <= 4 else 'AP-Floor3' -%}
  {%- if count >= 6 -%}{%- do shared.set('hop_count', 0) -%}{%- do shared.set('to_routine', true) -%}{%- else -%}{%- do shared.set('hop_count', count) -%}{%- endif -%}
{%- endif -%}
{%- if kind == 'run' -%}
  {%- set code = 'CLIENT_MOVED_TO_RUN_STATE' -%}
  {%- set tail = 'associated to AP (' ~ ap ~ ') with SSID (' ~ params.ssid ~ ')' -%}
{%- elif kind == 'delete' -%}
  {%- set code = 'CLIENT_MOVED_TO_DELETE_STATE' -%}
  {%- set tail = 'disconnected from AP (' ~ ap ~ ') with SSID (' ~ params.ssid ~ ')' -%}
{%- else -%}
  {%- set code = 'CLIENT_IP_UPDATED' -%}
  {%- set tail = 'IP address updated, associated to AP (' ~ ap ~ ') with SSID (' ~ params.ssid ~ ')' -%}
{%- endif -%}
{%- set original = timestamp.strftime('%b %d %H:%M:%S.') ~ ('%03d'|format(timestamp.microsecond // 1000)) ~ ' UTC: %CLIENT_ORCH_LOG-7-' ~ code ~ ': Chassis 1 R0/0: wncd: Username (' ~ user ~ '), MAC: ' ~ mac ~ ', IP ' ~ client_ip ~ ' ' ~ tail -%}
{%- set event = {
  '@timestamp': timestamp.isoformat(),
  'ecs': {'version': '8.17.0'},
  'event': {'kind': 'event', 'category': ['network'], 'type': ['start'] if kind == 'run' else ['end'] if kind == 'delete' else ['change'], 'action': kind.replace('_', '-'), 'code': code, 'original': original},
  'host': {'name': params.controller_name},
  'log': {'level': 'debug'},
  'process': {'name': 'wncd'},
  'user': {'name': user},
  'client': {'ip': client_ip, 'mac': mac},
  'related': {'ip': [client_ip], 'user': [user]},
  'cisco_wlc': {'ap_name': ap, 'ssid': params.ssid, 'chassis': '1 R0/0', 'client_state': kind}
} -%}
{{- event | tojson -}}
