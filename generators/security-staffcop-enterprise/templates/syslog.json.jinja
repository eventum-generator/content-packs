{%- for flag in ['to_shot_1', 'to_shot_2', 'to_policy_shot', 'to_stat', 'to_routine'] -%}{%- do shared.pop(flag, none) -%}{%- endfor -%}
{%- set stage = vars.stage -%}
{%- set sequence = shared.get('event_id', 468000) + 1 -%}
{%- if sequence > 999999 -%}{%- set sequence = 468001 -%}{%- endif -%}
{%- do shared.set('event_id', sequence) -%}
{%- if stage == 'routine' -%}
  {%- set count = shared.get('routine_count', 0) + 1 -%}
  {%- if count >= 32 -%}
    {%- do shared.set('routine_count', 0) -%}
    {%- if params.anomaly_mode -%}{%- do shared.set('to_shot_1', true) -%}{%- endif -%}
  {%- else -%}{%- do shared.set('routine_count', count) -%}{%- endif -%}
  {%- set endpoint_index = (count - 1) % params.routine_endpoint_count + 1 -%}
  {%- set user_name = 'employee' ~ endpoint_index -%}
  {%- set computer = 'WS-' ~ (100 + endpoint_index) -%}
  {%- set ip = '10.20.4.' ~ (40 + endpoint_index) -%}
  {%- set action = 'Screenshot' -%}
  {%- set policies = [params.policy_screenshot] if count % 5 == 0 else [] -%}
{%- else -%}
  {%- set user_name = params.suspect_user -%}
  {%- set computer = params.suspect_computer -%}
  {%- set ip = params.suspect_ip -%}
  {%- set action = 'Stat' if stage == 'stat' else 'Screenshot' -%}
  {%- set policies = [params.policy_screenshot, params.policy_sensitive] if stage == 'stat' else ([params.policy_screenshot] if stage == 'policy_shot' else []) -%}
  {%- if stage == 'shot_1' -%}{%- do shared.set('to_shot_2', true) -%}
  {%- elif stage == 'shot_2' -%}{%- do shared.set('to_policy_shot', true) -%}
  {%- elif stage == 'policy_shot' -%}{%- do shared.set('to_stat', true) -%}
  {%- else -%}{%- do shared.set('to_routine', true) -%}{%- endif -%}
{%- endif -%}
{%- set event_time = timestamp - module.datetime.timedelta(minutes=3) -%}
{%- set syslog_time = timestamp.strftime('%b ') ~ timestamp.day ~ timestamp.strftime(' %H:%M:%S') -%}
{%- set body_time = event_time.strftime('%b ') ~ event_time.day ~ event_time.strftime(' %H:%M:%S') -%}
{%- set original = syslog_time ~ ' ' ~ params.syslog_host ~ ' staffcop: id="' ~ sequence ~ '" time="' ~ body_time ~ '" event="' ~ action ~ '" computer="' ~ computer ~ '" ip="' ~ ip ~ '" user="' ~ user_name ~ '" app="' ~ params.application ~ '"' -%}
{%- if policies -%}{%- set original = original ~ ' policy_1="' ~ policies[0] ~ '"' -%}{%- endif -%}
{%- if policies | length > 1 -%}{%- set original = original ~ ' policy_2="' ~ policies[1] ~ '"' -%}{%- endif -%}
{%- set payload = {'@timestamp': event_time.isoformat(), 'ecs': {'version': '8.17.0'}, 'event': {'kind': 'event', 'category': ['host'], 'type': ['info'], 'action': action, 'id': sequence ~ '', 'original': original}, 'host': {'name': computer, 'ip': [ip]}, 'observer': {'name': params.syslog_host}, 'user': {'name': user_name}, 'process': {'name': params.application}, 'related': {'user': [user_name], 'ip': [ip], 'hosts': [computer]}, 'staffcop': {'event_time': event_time.isoformat(), 'forwarded_at': timestamp.isoformat(), 'policy_matches': policies}} -%}
{{- payload | tojson -}}
