{#- Staffcop Enterprise 5.8 Syslog connector, native key-value lines.
    Every one-second tick emits at most one record: the earliest due
    step of an active work bout. Employees start bouts independently
    (Poisson, per-employee rate, personal working-hours curve); a bout
    is a few screenshots in one application, sometimes closed by a
    Stat record. The anomaly episode is one extra bout sequence of a
    finance employee and never touches the background. -#}
{%- set now = timestamp.timestamp() | int -%}
{%- set utc = module.datetime.timezone.utc -%}
{%- set interval = params.anomaly_interval_hours | float -%}
{%- set window = 2700 -%}
{%- set p_fin = params.policy_finance -%}
{%- set p_ps = params.policy_printscreen -%}
{%- set p_cloud = params.policy_cloud -%}
{%- set p_social = params.policy_social -%}
{%- set p_msg = params.policy_messengers -%}
{%- set apps_by_dept = {
    'finance': [['excel', '1cv8', 'winword', 'chrome', 'msedge', 'outlook', 'telegram', 'explorer'],
                [30, 22, 8, 17, 6, 10, 4, 3]],
    'sales': [['excel', 'winword', 'chrome', 'msedge', 'outlook', 'telegram', '1cv8', 'explorer'],
              [10, 10, 30, 5, 20, 12, 8, 5]],
    'dev': [['code', 'chrome', 'telegram', 'outlook', 'explorer', 'excel', 'winword'],
            [35, 30, 10, 8, 7, 5, 5]],
    'hr': [['winword', 'excel', 'chrome', 'outlook', 'telegram', '1cv8', 'explorer'],
           [25, 15, 20, 20, 8, 7, 5]],
    'it': [['chrome', 'explorer', 'code', 'outlook', 'telegram', 'excel', 'winword'],
           [25, 15, 15, 15, 10, 10, 10]]} -%}
{%- set fin_prob_fin = {'excel': 0.15, '1cv8': 0.15, 'winword': 0.10,
    'outlook': 0.06, 'explorer': 0.06, 'chrome': 0.04, 'msedge': 0.04} -%}
{%- set fin_prob_other = {'excel': 0.012, 'winword': 0.012, '1cv8': 0.012} -%}
{%- set browsers = ['chrome', 'msedge'] -%}
{%- set office = ['excel', '1cv8', 'winword', 'outlook', 'explorer'] -%}

{%- if not shared.get('initialized', false) -%}
  {%- if not (2 <= interval <= 8760) -%}{{ module.math.sqrt(-1) }}{%- endif -%}
  {%- set users = [] -%}
  {%- for row in samples.employees -%}
    {%- do users.append({'user': row.user, 'computer': row.computer,
        'ip': row.ip, 'dept': row.department, 'fin': row.finance == 'yes',
        'rate': module.rand.number.lognormal(module.math.log(5.0), 0.4),
        'shift': module.rand.number.clamp(module.rand.number.gauss(0, 0.7), -2, 2)}) -%}
  {%- endfor -%}
  {%- set total = namespace(v=0) -%}
  {%- for u in users -%}{%- set total.v = total.v + u.rate -%}{%- endfor -%}
  {%- do shared.update({'initialized': true, 'users': users,
      'rate_sum': total.v, 'bouts': [], 'seq': {},
      'id': module.rand.number.integer(400000, 900000),
      'dumps': [now + module.rand.number.integer(1, 300)],
      'next_due': now + (interval * 3600) | int, 'episode_wait': false,
      'last_actor': none}) -%}
{%- endif -%}
{%- set users = shared.get('users') -%}
{%- set bouts = shared.get('bouts') -%}
{%- set seq = shared.get('seq') -%}

{#- Working-hours intensity of one employee (0..1), on the log clock
    shifted by the employee's personal offset; weekends are quiet. -#}
{%- macro load(u) -%}
  {%- set h = (timestamp.hour + timestamp.minute / 60 + u.shift) % 24 -%}
  {%- if h < 7 -%}{%- set v = 0.02 -%}
  {%- elif h < 9 -%}{%- set v = 0.02 + (h - 7) / 2 * 0.98 -%}
  {%- elif h < 13 -%}{%- set v = 1.0 -%}
  {%- elif h < 14 -%}{%- set v = 0.55 -%}
  {%- elif h < 18 -%}{%- set v = 1.0 -%}
  {%- elif h < 20 -%}{%- set v = 1.0 - (h - 18) / 2 * 0.9 -%}
  {%- elif h < 23 -%}{%- set v = 0.1 - (h - 20) / 3 * 0.08 -%}
  {%- else -%}{%- set v = 0.02 -%}{%- endif -%}
  {{- v * (0.08 if timestamp.weekday() >= 5 else 1.0) -}}
{%- endmacro -%}

{%- macro gap_in() -%}
{{- [module.rand.number.lognormal(module.math.log(40), 0.8) | round | int, 1] | max -}}
{%- endmacro -%}

{#- Policies matched by one screenshot of employee u in app; forced
    policies are added on top of the same independent draws. -#}
{%- macro draw(u, app, out, force) -%}
  {%- set fp = (fin_prob_fin if u.fin else fin_prob_other).get(app, 0) -%}
  {%- if p_fin in force or module.rand.chance(fp) -%}{%- do out.append(p_fin) -%}{%- endif -%}
  {%- if p_ps in force or module.rand.chance(0.012) -%}{%- do out.append(p_ps) -%}{%- endif -%}
  {%- if app in browsers -%}
    {%- if p_cloud in force or module.rand.chance(0.12) -%}{%- do out.append(p_cloud) -%}{%- endif -%}
    {%- if module.rand.chance(0.07 if app == 'chrome' else 0.05) -%}{%- do out.append(p_social) -%}{%- endif -%}
  {%- endif -%}
  {%- if app == 'telegram' and module.rand.chance(0.45) -%}{%- do out.append(p_msg) -%}{%- endif -%}
{%- endmacro -%}

{#- Policies of a Stat record closing a bout: each policy the bout
    matched is carried with p=0.85; finance staff often match the
    finance policy on web and mail activity (bank and tax portals). -#}
{%- macro stat_draw(u, app, seen, out) -%}
  {%- for p in seen -%}
    {%- if module.rand.chance(0.85) -%}{%- do out.append(p) -%}{%- endif -%}
  {%- endfor -%}
  {%- if u.fin and (app in browsers or app == 'outlook') and p_fin not in out
      and module.rand.chance(0.6) -%}
    {%- do out.append(p_fin) -%}
  {%- endif -%}
{%- endmacro -%}

{#- 1. Independent bout arrivals, thinned by each employee's load. -#}
{%- if module.rand.chance(shared.get('rate_sum') / 3600) -%}
  {%- set w = [] -%}
  {%- set tot = namespace(v=0) -%}
  {%- for u in users -%}
    {%- set x = u.rate * (load(u) | float) -%}
    {%- do w.append(x) -%}{%- set tot.v = tot.v + x -%}
  {%- endfor -%}
  {%- if tot.v > 0 and module.rand.chance(tot.v / shared.get('rate_sum')) -%}
    {%- set ui = module.rand.weighted_choice(range(users | length) | list, w) -%}
    {%- set d = apps_by_dept[users[ui].dept] -%}
    {%- do bouts.append({'u': ui, 'app': module.rand.weighted_choice(d[0], d[1]),
        'left': 1 + module.rand.number.exponential(1 / 2.5) | int,
        'stat': module.rand.chance(0.35), 'seen': [], 'due': now,
        'plan': none}) -%}
  {%- endif -%}
{%- endif -%}

{#- 2. Episode: due by source time; the start hazard follows the mean
    working-hours load of finance staff (mean delay 45 min at full
    load); next due from the actual start, no catch-up. -#}
{%- if params.anomaly_mode -%}
  {%- if not shared.get('episode_wait') and now >= shared.get('next_due') -%}
    {%- do shared.set('episode_wait', true) -%}
  {%- endif -%}
  {%- if shared.get('episode_wait') -%}
    {%- set cand = [] -%}
    {%- set cw = [] -%}
    {%- set tot = namespace(v=0, r=0) -%}
    {%- for u in users -%}
      {%- if u.fin -%}
        {%- set x = u.rate * (load(u) | float) -%}
        {%- set tot.v = tot.v + x -%}{%- set tot.r = tot.r + u.rate -%}
        {%- if u.user != shared.get('last_actor') -%}
          {%- do cand.append(loop.index0) -%}{%- do cw.append(x) -%}
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}
    {%- if tot.v > 0 and module.rand.chance(tot.v / tot.r / 2700) -%}
      {%- set ui = module.rand.weighted_choice(cand, cw) -%}
      {%- set u = users[ui] -%}
      {%- set d = apps_by_dept[u.dept] -%}
      {%- set ow = [] -%}
      {%- for a in office -%}{%- do ow.append(d[1][d[0].index(a)] if a in d[0] else 0) -%}{%- endfor -%}
      {%- set bw = [] -%}
      {%- for a in browsers -%}{%- do bw.append(d[1][d[0].index(a)] if a in d[0] else 0) -%}{%- endfor -%}
      {%- set doc_app = module.rand.weighted_choice(office, ow) -%}
      {%- set web_app = module.rand.weighted_choice(browsers, bw) -%}
      {%- set g = namespace(a=0, b=0, c=0) -%}
      {%- for attempt in range(10) -%}
        {%- if attempt == 0 or g.a + g.b + g.c > 1500 -%}
          {%- set g.a = gap_in() | int -%}
          {%- set g.b = [module.rand.number.lognormal(module.math.log(150), 0.7) | round | int, 1] | max -%}
          {%- set g.c = gap_in() | int -%}
        {%- endif -%}
      {%- endfor -%}
      {%- do bouts.append({'u': ui, 'app': doc_app, 'left': 0, 'stat': false,
          'seen': [], 'due': now, 'plan': [
            {'at': now, 'kind': 'Screenshot', 'app': doc_app, 'force': [p_fin]},
            {'at': now + g.a, 'kind': 'Screenshot', 'app': doc_app, 'force': [p_ps]},
            {'at': now + g.a + g.b, 'kind': 'Screenshot', 'app': web_app, 'force': [p_cloud]},
            {'at': now + g.a + g.b + g.c, 'kind': 'Stat', 'app': web_app, 'force': [p_cloud, p_fin]}]}) -%}
      {%- do shared.update({'episode_wait': false, 'last_actor': u.user,
          'next_due': now + (interval * 3600) | int}) -%}
    {%- endif -%}
  {%- endif -%}
{%- endif -%}

{#- 3. Earliest due bout step, otherwise nothing. -#}
{%- set pick = namespace(i=-1, due=now + 1) -%}
{%- for b in bouts -%}
  {%- if b.due <= now and b.due < pick.due -%}
    {%- set pick.i = loop.index0 -%}{%- set pick.due = b.due -%}
  {%- endif -%}
{%- endfor -%}
{%- if pick.i < 0 -%}{{ dispatch.drop() }}{%- endif -%}

{%- set b = bouts[pick.i] -%}
{%- set u = users[b.u] -%}
{%- set pols = [] -%}
{%- if b.plan is not none -%}
  {%- set step = b.plan.pop(0) -%}
  {%- set action = step.kind -%}
  {%- set app = step.app -%}
  {%- set episode = true -%}
  {%- if action == 'Screenshot' -%}
    {{- draw(u, app, pols, step.force) -}}
    {%- if app in browsers -%}{%- do b.update({'seen': pols | list}) -%}{%- endif -%}
  {%- else -%}
    {%- for p in step.force -%}{%- do pols.append(p) -%}{%- endfor -%}
    {%- for p in b.seen -%}
      {%- if p not in pols and module.rand.chance(0.85) -%}{%- do pols.append(p) -%}{%- endif -%}
    {%- endfor -%}
  {%- endif -%}
  {%- if b.plan -%}{%- do b.update({'due': b.plan[0].at}) -%}{%- else -%}{%- do bouts.pop(pick.i) -%}{%- endif -%}
{%- else -%}
  {%- set app = b.app -%}
  {%- set episode = false -%}
  {%- if b.left > 0 -%}
    {%- set action = 'Screenshot' -%}
    {{- draw(u, app, pols, []) -}}
    {%- for p in pols -%}{%- if p not in b.seen -%}{%- do b.seen.append(p) -%}{%- endif -%}{%- endfor -%}
    {%- do b.update({'left': b.left - 1}) -%}
    {%- if b.left > 0 or b.stat -%}
      {%- do b.update({'due': now + gap_in() | int}) -%}
    {%- else -%}{%- do bouts.pop(pick.i) -%}{%- endif -%}
  {%- else -%}
    {%- set action = 'Stat' -%}
    {{- stat_draw(u, app, b.seen, pols) -}}
    {%- do bouts.pop(pick.i) -%}
  {%- endif -%}
{%- endif -%}

{#- Per-employee chain tracker (finance screenshot -> PrintScreen ->
    cloud storage -> Stat with cloud and finance policies). Guard on
    the final step only: an ordinary Stat that would complete the full
    ordered chain loses its finance policy. -#}
{%- macro matches(i, action, pols) -%}
  {%- if i == 0 -%}{{ action == 'Screenshot' and p_fin in pols }}
  {%- elif i == 1 -%}{{ action == 'Screenshot' and p_ps in pols }}
  {%- elif i == 2 -%}{{ action == 'Screenshot' and p_cloud in pols }}
  {%- else -%}{{ action == 'Stat' and p_cloud in pols and p_fin in pols }}{%- endif -%}
{%- endmacro -%}
{%- set parts = [] -%}
{%- for p in seq.get(u.user, []) -%}
  {%- if now - p[1] <= window -%}{%- do parts.append(p) -%}{%- endif -%}
{%- endfor -%}
{%- if not episode and matches(3, action, pols) == 'True' -%}
  {%- if parts | selectattr(0, 'equalto', 3) | list -%}
    {%- do pols.remove(p_fin) -%}
  {%- endif -%}
{%- endif -%}
{%- set nxt = [] -%}
{%- set fin = namespace(done=false) -%}
{%- for p in parts -%}
  {%- if not fin.done -%}
    {%- if matches(p[0], action, pols) == 'True' -%}
      {%- if p[0] == 3 -%}{%- set fin.done = true -%}
      {%- else -%}{%- do nxt.append([p[0] + 1, p[1]]) -%}{%- endif -%}
    {%- else -%}{%- do nxt.append(p) -%}{%- endif -%}
  {%- endif -%}
{%- endfor -%}
{%- if fin.done -%}
  {%- do seq.pop(u.user, none) -%}
{%- else -%}
  {%- if matches(0, action, pols) == 'True' -%}{%- do nxt.append([1, now]) -%}{%- endif -%}
  {%- if nxt -%}{%- do seq.update({u.user: nxt[-8:]}) -%}{%- else -%}{%- do seq.pop(u.user, none) -%}{%- endif -%}
{%- endif -%}

{#- Server event id (other event types consume ids too) and the
    five-minute connector dump that carries this record. -#}
{%- set event_id = shared.get('id') + 1 + module.rand.number.exponential(1 / 2.0) | int -%}
{%- do shared.set('id', event_id) -%}
{%- set dumps = shared.get('dumps') -%}
{%- set target = now + module.rand.number.lognormal(module.math.log(15), 1.0) | int -%}
{%- for i in range(40) -%}
  {%- if dumps[-1] < target -%}
    {%- do dumps.append(dumps[-1] + 300 + module.rand.number.lognormal(module.math.log(2), 0.5) | round | int) -%}
  {%- endif -%}
{%- endfor -%}
{%- for i in range(dumps | length) -%}
  {%- if dumps | length > 1 and dumps[0] < now -%}{%- do dumps.pop(0) -%}{%- endif -%}
{%- endfor -%}
{%- set dump_at = dumps | select('ge', target) | first -%}
{%- set dump_time = module.datetime.datetime.fromtimestamp(dump_at, utc) -%}

{%- set shuffled = module.rand.shuffle(pols) if pols | length > 1 else pols -%}
{%- macro clock(t) -%}{{ t.strftime('%b ') ~ ('%2d' % t.day) ~ t.strftime(' %H:%M:%S') }}{%- endmacro -%}
{%- set line = clock(dump_time) ~ ' ' ~ params.syslog_host ~ ' staffcop: id="' ~ event_id
    ~ '" time="' ~ clock(timestamp) ~ '" event="' ~ action ~ '" computer="' ~ u.computer
    ~ '" ip="' ~ u.ip ~ '" user="' ~ u.user ~ '" app="' ~ app ~ '"' -%}
{%- set text = namespace(v=line) -%}
{%- for p in shuffled -%}{%- set text.v = text.v ~ ' policy_' ~ loop.index ~ '="' ~ p ~ '"' -%}{%- endfor -%}
{%- set line = text.v -%}
{%- set payload = {'@timestamp': timestamp.isoformat(), 'ecs': {'version': '8.17.0'},
    'event': {'kind': 'event', 'category': ['host'], 'type': ['info'], 'action': action,
      'id': event_id | string, 'created': dump_time.isoformat(),
      'dataset': 'staffcop.syslog', 'original': line},
    'observer': {'hostname': params.syslog_host, 'vendor': 'Atom Security',
      'product': 'Staffcop Enterprise'},
    'log': {'syslog': {'hostname': params.syslog_host, 'appname': 'staffcop'}},
    'host': {'name': u.computer, 'ip': [u.ip]}, 'user': {'name': u.user},
    'process': {'name': app},
    'related': {'user': [u.user], 'ip': [u.ip], 'hosts': [u.computer]}} -%}
{%- if shuffled -%}{%- do payload.update({'rule': {'name': shuffled | list}}) -%}{%- endif -%}
{{- payload | tojson -}}
