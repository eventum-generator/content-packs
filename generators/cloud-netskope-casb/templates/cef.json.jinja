{%- for flag in ['to_policy_delete', 'to_download_1', 'to_download_2', 'to_download_3', 'to_routine'] -%}{%- do shared.pop(flag, none) -%}{%- endfor -%}
{%- set stage = vars.stage -%}
{%- if stage == 'routine' -%}
  {%- set count = shared.get('routine_count', 0) + 1 -%}
  {%- if count >= 40 -%}
    {%- do shared.set('routine_count', 0) -%}
    {%- if params.anomaly_mode -%}{%- do shared.set('to_policy_delete', true) -%}{%- endif -%}
  {%- else -%}{%- do shared.set('routine_count', count) -%}{%- endif -%}
  {%- set is_audit = count % 7 == 0 -%}
  {%- set user_name = params.policy_admin if is_audit else params.routine_user -%}
{%- else -%}
  {%- set is_audit = stage == 'policy_delete' -%}
  {%- set user_name = params.suspect_user -%}
  {%- if stage == 'policy_delete' -%}{%- do shared.set('to_download_1', true) -%}
  {%- elif stage == 'download_1' -%}{%- do shared.set('to_download_2', true) -%}
  {%- elif stage == 'download_2' -%}{%- do shared.set('to_download_3', true) -%}
  {%- else -%}{%- do shared.set('to_routine', true) -%}{%- endif -%}
{%- endif -%}
{%- set epoch = timestamp.timestamp() | int -%}
{%- set header = '<14>' ~ timestamp.strftime('%b %d %H:%M:%S') ~ ' ' ~ params.shipper_host ~ ' CEF:0|Netskope|' ~ params.tenant_name ~ '|NULL|' -%}
{%- if is_audit -%}
  {%- set original = header ~ 'audit|NULL|High|auditLogEvent=Deleted Inline Policy auditType=admin_audit_logs suser=' ~ user_name ~ ' timestamp=' ~ epoch -%}
  {%- set event = {'kind': 'event', 'category': ['configuration'], 'type': ['deletion'], 'action': 'Deleted Inline Policy', 'outcome': 'success', 'original': original} -%}
  {%- set data = {'type': 'audit', 'audit_type': 'admin_audit_logs', 'audit_log_event': 'Deleted Inline Policy'} -%}
{%- else -%}
  {%- set original = header ~ 'application|NULL|Unknown|act=Download appcategory=Cloud Storage applicationType=nspolicy browser=unknown cci=89 ccl=high device=Other dst=' ~ params.destination_ip ~ ' os=unknown requestClientApplication=Box sourceServiceName=Box src=' ~ params.source_ip ~ ' suser=' ~ user_name ~ ' timestamp=' ~ epoch -%}
  {%- set event = {'kind': 'event', 'category': ['file'], 'type': ['access'], 'action': 'Download', 'outcome': 'success', 'original': original} -%}
  {%- set data = {'type': 'application', 'application': 'Box', 'application_category': 'Cloud Storage', 'client_confidence_index': 89, 'client_confidence_level': 'high'} -%}
{%- endif -%}
{%- set payload = {'@timestamp': timestamp.isoformat(), 'ecs': {'version': '8.17.0'}, 'event': event, 'host': {'name': params.shipper_host}, 'user': {'email': user_name}, 'related': {'user': [user_name]}, 'netskope': data} -%}
{%- if not is_audit -%}{%- do payload.update({'source': {'ip': params.source_ip}, 'destination': {'ip': params.destination_ip}, 'related': {'user': [user_name], 'ip': [params.source_ip, params.destination_ip]}}) -%}{%- endif -%}
{{- payload | tojson -}}
