{%- from 'templates/_base.json.jinja' import render with context -%}
{#- Client errors (4xx). Most are returned by the backend (origin_status ==
    downstream status); 429 is produced by Traefik's rateLimit middleware
    before the request reaches a backend (origin_status 0). Never retried. -#}
{%- set route = samples.routes.weighted_pick('weight') -%}
{%- set src_ip = module.rand.network.ip_v4_public() -%}
{%- set src_port = module.rand.number.integer(1024, 65535) -%}
{%- set http_version = module.rand.weighted_choice(["2.0", "1.1", "1.0"], [60, 38, 2]) -%}
{%- set method_weights = [] -%}
{%- for m in route.methods -%}
  {%- do method_weights.append({"GET": 80, "HEAD": 6, "POST": 14, "PUT": 4, "DELETE": 3, "PATCH": 2, "OPTIONS": 2}.get(m, 5)) -%}
{%- endfor -%}
{%- set method = module.rand.weighted_choice(route.methods, method_weights) -%}
{%- set status = module.rand.weighted_choice([404, 401, 403, 429, 400], [45, 20, 15, 12, 8]) -%}
{#- Origin status and upstream latency -#}
{%- if status == 429 -%}
  {%- set origin_status = 0 -%}
  {%- set origin_duration = module.rand.number.integer(40000, 250000) -%}
{%- else -%}
  {%- set origin_status = status -%}
  {%- set lat_mu = {"fast": 15.2, "normal": 17.37, "slow": 19.21}[route.latency] -%}
  {%- set lat_sigma = {"fast": 0.5, "normal": 0.7, "slow": 0.85}[route.latency] -%}
  {%- set origin_duration = module.rand.number.clamp(module.rand.number.lognormal(lat_mu, lat_sigma), 100000, 60000000000) | int -%}
{%- endif -%}
{%- set overhead = module.rand.number.clamp(module.rand.number.lognormal(11.7, 0.4), 20000, 50000000) | int -%}
{%- set resp_bytes = module.rand.number.clamp(module.rand.number.lognormal(6.0, 0.8), 0, 50000) | int -%}
{%- if method in ["POST", "PUT", "PATCH"] -%}
  {%- set req_bytes = module.rand.number.clamp(module.rand.number.lognormal(6.5, 1.0), 0, 2000000) | int -%}
{%- else -%}
  {%- set req_bytes = 0 -%}
{%- endif -%}
{%- set full_path = module.rand.choice(route.paths) -%}
{{ render(route, src_ip, src_port, method, status, origin_status, resp_bytes, req_bytes, origin_duration, overhead, 0, http_version, full_path) }}
