{%- from 'templates/_base.json.jinja' import render with context -%}
{#- Upstream errors (5xx) generated by Traefik when the backend fails. The
    origin produced no valid response, so origin_status is 0 and the origin
    content size is 0. Retry attempts correlate with the failure mode:
      502 Bad Gateway      - backend reset/refused the connection
      503 Service Unavailable - no healthy server in the load balancer
      504 Gateway Timeout  - backend exceeded the response timeout -#}
{%- set route = samples.routes.weighted_pick('weight') -%}
{%- set src_ip = module.rand.network.ip_v4_public() -%}
{%- set src_port = module.rand.number.integer(1024, 65535) -%}
{%- set http_version = module.rand.weighted_choice(["2.0", "1.1", "1.0"], [60, 38, 2]) -%}
{%- set method_weights = [] -%}
{%- for m in route.methods -%}
  {%- do method_weights.append({"GET": 80, "HEAD": 6, "POST": 14, "PUT": 4, "DELETE": 3, "PATCH": 2, "OPTIONS": 2}.get(m, 5)) -%}
{%- endfor -%}
{%- set method = module.rand.weighted_choice(route.methods, method_weights) -%}
{%- set status = module.rand.weighted_choice([502, 503, 504], [45, 35, 20]) -%}
{%- set origin_status = 0 -%}
{#- Upstream latency and retries by failure mode -#}
{%- if status == 504 -%}
  {%- set origin_duration = module.rand.number.integer(28000000000, 32000000000) -%}
  {%- set retries = module.rand.weighted_choice([0, 1, 2], [50, 35, 15]) -%}
  {%- set resp_bytes = 16 -%}
{%- elif status == 502 -%}
  {%- set origin_duration = module.rand.number.clamp(module.rand.number.lognormal(14.5, 0.9), 100000, 20000000000) | int -%}
  {%- set retries = module.rand.weighted_choice([0, 1, 2, 3], [25, 35, 25, 15]) -%}
  {%- set resp_bytes = 12 -%}
{%- else -%}
  {%- set origin_duration = module.rand.number.integer(40000, 400000) -%}
  {%- set retries = module.rand.weighted_choice([1, 2, 3], [40, 35, 25]) -%}
  {%- set resp_bytes = 20 -%}
{%- endif -%}
{%- set overhead = module.rand.number.clamp(module.rand.number.lognormal(11.7, 0.4), 20000, 50000000) | int -%}
{%- if method in ["POST", "PUT", "PATCH"] -%}
  {%- set req_bytes = module.rand.number.clamp(module.rand.number.lognormal(6.5, 1.0), 0, 2000000) | int -%}
{%- else -%}
  {%- set req_bytes = 0 -%}
{%- endif -%}
{%- set full_path = module.rand.choice(route.paths) -%}
{{ render(route, src_ip, src_port, method, status, origin_status, resp_bytes, req_bytes, origin_duration, overhead, retries, http_version, full_path) }}
