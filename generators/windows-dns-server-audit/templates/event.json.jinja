{%- set step = vars.step -%}
{%- set now = timestamp.astimezone(module.datetime.timezone.utc) -%}
{%- if step == 'routine' -%}
  {%- if not shared.get('maintenance_next_at') -%}
    {%- do shared.set('maintenance_next_at', now + module.datetime.timedelta(seconds=100)) -%}
    {%- do shared.set('anomaly_next_at', now + module.datetime.timedelta(seconds=params.anomaly_interval_seconds)) -%}
  {%- endif -%}
  {%- if shared.get('policy_active') and shared.get('policy_kind') == 'maintenance' and now >= shared.get('policy_delete_at') -%}
    {%- do shared.set('to_background_delete', true) -%}
  {%- elif not shared.get('policy_active') -%}
    {%- if params.anomaly_mode and now >= shared.get('anomaly_next_at') -%}
      {%- do shared.set('to_attack', true) -%}
    {%- elif now >= shared.get('maintenance_next_at') -%}
      {%- do shared.set('to_background_create', true) -%}
    {%- endif -%}
  {%- endif -%}
  {%- if shared.get('policy_active') and now >= shared.get('ignored_next_at') and now < shared.get('policy_delete_at') -%}
    {%- do shared.set('to_ignored', true) -%}
    {%- do shared.set('ignored_next_at', now + module.datetime.timedelta(seconds=480)) -%}
    {%- set q = {'qname': 'beacon.' ~ params.anomaly_zone ~ '.', 'qtype': '1', 'client_ip': params.client_ip} -%}
  {%- else -%}
    {%- set selected = samples.queries.pick() -%}
    {%- set q = {'qname': selected.qname, 'qtype': selected.qtype, 'client_ip': params.client_ip if selected.qname.startswith('www.') else selected.client_ip, 'answer_ip': selected.answer_ip} -%}
  {%- endif -%}
  {%- do q.update({'xid': module.rand.number.integer(1, 65535), 'port': module.rand.number.integer(49152, 65535), 'guid': '{' ~ (module.rand.crypto.uuid4()|string|upper) ~ '}', 'received_at': now}) -%}
  {%- do shared.set('pending_query', q) -%}
{%- elif step.startswith('attack_query_') -%}
  {%- set q = {'qname': 'beacon.' ~ params.anomaly_zone ~ '.', 'qtype': '1', 'client_ip': params.client_ip, 'xid': module.rand.number.integer(1, 65535), 'port': module.rand.number.integer(49152, 65535), 'guid': '{' ~ (module.rand.crypto.uuid4()|string|upper) ~ '}', 'received_at': now} -%}
  {%- do shared.set('pending_query', q) -%}
{%- elif step in ['normal_response', 'ignored_background'] or step.startswith('attack_ignored_') -%}
  {%- set q = shared.pop('pending_query') -%}
  {%- if step == 'ignored_background' -%}{%- do shared.pop('to_ignored', none) -%}{%- endif -%}
{%- endif -%}
{%- set is_query = step == 'routine' or step.startswith('attack_query_') -%}
{%- set is_ignored = step == 'ignored_background' or step.startswith('attack_ignored_') -%}
{%- set is_response = step == 'normal_response' -%}
{%- set is_audit = not (is_query or is_ignored or is_response) -%}
{%- set event_time = q.received_at + module.datetime.timedelta(milliseconds=3) if is_ignored or is_response else now -%}
{%- set dataset = 'microsoft_dnsserver.audit' if is_audit else 'microsoft_dnsserver.analytical' -%}
{%- set eid = '577' if step in ['policy_create', 'attack_create'] else '580' if is_audit else '256' if is_query else '259' if is_ignored else '257' -%}
{%- set winlog = {'channel': 'Microsoft-Windows-DNSServer/Audit' if is_audit else 'Microsoft-Windows-DNS-Server/Analytical', 'provider_guid': '{eb79061a-a566-4698-9119-3ed2807060e7}', 'provider_name': 'Microsoft-Windows-DNSServer', 'event_data': {}} -%}
{%- set out = {'@timestamp': event_time.isoformat(), 'ecs': {'version': '8.17.0'}, 'event': {'code': eid, 'provider': 'Microsoft-Windows-DNSServer', 'kind': 'event', 'dataset': dataset}, 'data_stream': {'type': 'logs', 'dataset': dataset, 'namespace': 'default'}, 'host': {'name': params.server_name, 'hostname': params.server_name, 'ip': [params.server_ip], 'os': {'name': 'Windows Server 2022 Datacenter', 'family': 'windows', 'platform': 'windows', 'type': 'windows'}}, 'input': {'type': 'winlog' if is_audit else 'etw'}, 'log': {'level': 'information' if not is_ignored else 'error'}, 'winlog': winlog} -%}
{%- if is_audit -%}
  {%- set record = shared.get('audit_record_id', 0) + 1 -%}
  {%- do shared.set('audit_record_id', record) -%}
  {%- do winlog.update({'api': 'wineventlog', 'computer_name': params.server_name, 'event_id': eid, 'record_id': record|string, 'opcode': 'Info', 'task': 'POLICY_OP', 'keywords': ['AUDIT_POLICY'], 'user': {'domain': params.server_name.split('.')[0]|upper, 'identifier': 'S-1-5-21-1000000000-1000000000-1000000000-500', 'name': params.admin_name, 'type': 'User'}}) -%}
  {%- do out.event.update({'action': 'POLICY_OP', 'category': ['configuration'], 'type': ['creation'] if eid == '577' else ['deletion'], 'sequence': record}) -%}
  {%- do out.update({'user': {'name': params.admin_name}, 'related': {'user': [params.admin_name]}}) -%}
  {%- if eid == '577' -%}
    {%- do shared.pop('to_background_create', none) -%}
    {%- do shared.pop('to_attack', none) -%}
    {%- set policy = params.policy_name ~ '-' ~ module.rand.crypto.uuid4()|string -%}
    {%- do shared.set('policy_active', policy) -%}
    {%- if step == 'attack_create' -%}
      {%- do shared.set('policy_kind', 'short') -%}
      {%- do shared.set('anomaly_next_at', now + module.datetime.timedelta(seconds=params.anomaly_interval_seconds)) -%}
    {%- else -%}
      {%- do shared.set('policy_kind', 'maintenance') -%}
      {%- do shared.set('policy_delete_at', now + module.datetime.timedelta(seconds=1800)) -%}
      {%- do shared.set('ignored_next_at', now + module.datetime.timedelta(seconds=480)) -%}
      {%- do shared.set('maintenance_next_at', now + module.datetime.timedelta(seconds=7200)) -%}
    {%- endif -%}
    {%- set criteria = 'FQDN=EQ,*.' ~ params.anomaly_zone -%}
    {%- set msg = 'A server level policy ' ~ policy ~ ' for Query processing  has been created on server ' ~ params.server_name ~ ' with following properties: Processing order:1; Criteria:' ~ criteria ~ '; Action:Ignore; Condition:And; IsEnabled:True.' -%}
    {%- do winlog.event_data.update({'Policy': policy, 'Condition': 'And', 'Action': 'Ignore', 'Type': 'Query processing', 'ProcessingOrder': '1', 'IsEnabled': 'True', 'ServerName': params.server_name, 'Criteria': criteria}) -%}
    {%- do out.update({'microsoft_dnsserver': {'audit': {'policy': policy, 'condition': 'And', 'action': 'Ignore', 'type': 'Query processing', 'processing_order': '1', 'is_enabled': 'True', 'name_server': params.server_name, 'criteria': criteria}}}) -%}
  {%- else -%}
    {%- do shared.pop('to_background_delete', none) -%}
    {%- set policy = shared.pop('policy_active') -%}
    {%- do shared.pop('policy_kind', none) -%}
    {%- do shared.pop('policy_delete_at', none) -%}
    {%- do shared.pop('ignored_next_at', none) -%}
    {%- set msg = 'The server level policy ' ~ policy ~ ' has been deleted from server ' ~ params.server_name ~ '.' -%}
    {%- do winlog.event_data.update({'Policy': policy, 'ServerName': params.server_name}) -%}
    {%- do out.update({'microsoft_dnsserver': {'audit': {'policy': policy, 'name_server': params.server_name}}}) -%}
  {%- endif -%}
{%- else -%}
  {%- set name = namespace(wire='') -%}
  {%- for label in q.qname.rstrip('.').split('.') -%}
    {%- set name.wire = name.wire ~ ('%02X' % (label|length)) ~ label.encode('ascii').hex().upper() -%}
  {%- endfor -%}
  {%- set question = name.wire ~ '00' ~ ('%04X' % (q.qtype|int)) ~ '0001' -%}
  {%- set xid_hex = '%04X' % q.xid -%}
  {%- set guid = q.guid -%}
  {%- set data = {'TCP': '0', 'InterfaceIP': params.server_ip, 'QNAME': q.qname, 'QTYPE': q.qtype, 'XID': q.xid|string, 'AdditionalInfo': '.'} -%}
  {%- do winlog.update({'task': 'LOOK_UP', 'keywords': ['QUERY_RECEIVED' if is_query else 'IGNORED_QUERY' if is_ignored else 'RESPONSE_SUCCESS'], 'flags': ['64_BIT_HEADER', 'EXTENDED_INFO', 'PROCESSOR_INDEX'], 'flags_raw': '0x241', 'opcode_raw': 0, 'version': 0, 'session': 'Microsoft-Windows-DNSServer-Analytical.etl', 'keywords_raw': '0x8000000000000001' if is_query else '0x8000000000000008' if is_ignored else '0x8000000000000002', 'level': 'Error' if is_ignored else 'Information', 'level_raw': 2 if is_ignored else 4, 'task_raw': 1, 'provider_message': 'Microsoft-Windows-DNS-Server', 'event_data': data}) -%}
  {%- do out.event.update({'severity': 2 if is_ignored else 4, 'category': ['network'], 'type': ['protocol']}) -%}
  {%- do out.update({'log': {'level': 'error' if is_ignored else 'information', 'file': {'path': 'Microsoft-Windows-DNSServer-Analytical.etl'}}, 'dns': {'id': q.xid|string, 'question': {'name': q.qname.rstrip('.'), 'type': 'A'}}, 'microsoft_dnsserver': {'analytical': {'question_name': q.qname, 'question_type': 'A', 'xid': q.xid|string, 'interface_ip': params.server_ip, 'additional_info': '.'}}}) -%}
  {%- if is_query -%}
    {%- set packet = '0x' ~ xid_hex ~ '01000001000000000000' ~ question -%}
    {%- do data.update({'Source': q.client_ip, 'RD': '1', 'Port': q.port|string, 'Flags': '256', 'PacketData': packet, 'BufferSize': ((packet|length - 2) // 2)|string, 'GUID': guid}) -%}
    {%- do out.update({'source': {'ip': q.client_ip, 'port': q.port}, 'related': {'ip': [q.client_ip]}, 'message': 'QUERY_RECEIVED: TCP=0; InterfaceIP=' ~ params.server_ip ~ '; Source=' ~ q.client_ip ~ '; RD=1; QNAME=' ~ q.qname ~ '; QTYPE=' ~ q.qtype ~ '; XID=' ~ q.xid ~ '; Port=' ~ q.port ~ '; Flags=256; PacketData=' ~ packet ~ '; AdditionalInfo = VirtualizationInstanceOptionValue: .; GUID=' ~ guid}) -%}
    {%- do out.microsoft_dnsserver.analytical.update({'description': 'Query received', 'source': {'ip': q.client_ip, 'port': q.port}, 'guid': guid, 'packet_data': packet, 'bytes_sent': (packet|length - 2) // 2}) -%}
    {%- do out.dns.update({'header_flags': ['RD']}) -%}
  {%- elif is_ignored -%}
    {%- do data.update({'Source': q.client_ip, 'Reason': 'Policy', 'Zone': params.normal_zone, 'PolicyName': shared.get('policy_active')}) -%}
    {%- do out.update({'source': {'ip': q.client_ip}, 'related': {'ip': [q.client_ip]}, 'message': 'IGNORED_QUERY: TCP=0; InterfaceIP=' ~ params.server_ip ~ '; Source=' ~ q.client_ip ~ '; Reason=Policy; QNAME=' ~ q.qname ~ '; QTYPE=' ~ q.qtype ~ '; XID=' ~ q.xid ~ '; Zone=' ~ params.normal_zone ~ '; PolicyName=' ~ shared.get('policy_active') ~ '; AdditionalInfo = VirtualizationInstance: .'}) -%}
    {%- do out.microsoft_dnsserver.analytical.update({'description': 'Ignored query', 'source': {'ip': q.client_ip}, 'reason': 'Policy', 'zone': params.normal_zone, 'policy_name': shared.get('policy_active')}) -%}
  {%- else -%}
    {%- set ip = namespace(wire='') -%}
    {%- for octet in q.answer_ip.split('.') -%}{%- set ip.wire = ip.wire ~ ('%02X' % (octet|int)) -%}{%- endfor -%}
    {%- set packet = '0x' ~ xid_hex ~ '85000001000100000000' ~ question ~ 'C00C000100010000012C0004' ~ ip.wire -%}
    {%- do data.update({'Destination': q.client_ip, 'AA': '1', 'AD': '0', 'DNSSEC': '0', 'RCODE': '0', 'Port': q.port|string, 'Flags': '34048', 'Scope': 'Default', 'Zone': params.normal_zone, 'PolicyName': 'NULL', 'PacketData': packet, 'BufferSize': ((packet|length - 2) // 2)|string, 'ElapsedTime': '3', 'GUID': guid}) -%}
    {%- do out.update({'destination': {'ip': q.client_ip, 'port': q.port}, 'related': {'ip': [q.client_ip]}, 'message': 'RESPONSE_SUCCESS: TCP=0; InterfaceIP=' ~ params.server_ip ~ '; Destination=' ~ q.client_ip ~ '; AA=1; AD=0; QNAME=' ~ q.qname ~ '; QTYPE=' ~ q.qtype ~ '; XID=' ~ q.xid ~ '; DNSSEC=0; RCODE=0; Port=' ~ q.port ~ '; Flags=34048; Scope=Default; Zone=' ~ params.normal_zone ~ '; PolicyName=NULL; PacketData=' ~ packet ~ '; AdditionalInfo= VirtualizationInstance:.; ElapsedTime=3; GUID=' ~ guid}) -%}
    {%- do out.microsoft_dnsserver.analytical.update({'description': 'Response success', 'destination': {'ip': q.client_ip, 'port': q.port}, 'response_code': 'NoError', 'dnssec': '0', 'scope': 'Default', 'zone': params.normal_zone, 'elapsed_time': '3', 'guid': guid, 'packet_data': packet, 'bytes_sent': (packet|length - 2) // 2}) -%}
    {%- do out.dns.update({'response_code': 'NoError', 'header_flags': ['AA', 'RD']}) -%}
  {%- endif -%}
{%- endif -%}
{%- if is_audit -%}{%- do out.update({'message': msg}) -%}{%- endif -%}
{{- out | tojson -}}
