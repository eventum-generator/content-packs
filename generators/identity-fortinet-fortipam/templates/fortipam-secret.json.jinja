{#- One FortiPAM appliance: secret-request (2304064604) and
    clear-text-view (2303064603) logs. The input sets the rate and the
    hour-of-day curve; every timestamp becomes exactly one record. A
    timestamp takes the next due record of the anomaly episode, else
    the earliest due next record of an open user session, else it opens
    a new session for a user drawn by activity weight. The episode
    queues its own records for one user, who starts no ordinary session
    from its request until 30 minutes after it. -#}
{%- set utc = module.datetime.timezone.utc -%}
{%- set occurred = timestamp.astimezone(utc) -%}
{%- set now = occurred.timestamp() -%}
{%- set sec = now | int -%}
{%- set usec = occurred.microsecond -%}
{%- set interval = params.anomaly_interval_hours | float -%}
{%- set window = 1800 -%}

{#- Records per hour of day (UTC). It repeats the rates of patterns/*.yml
    and only places episode starts and the episode users' secrets; the
    input alone sets the record rate. Episodes start 07:00-20:00, where
    the rate carries a 30-minute sequence. -#}
{%- set hrate = [15] * 7 + [81] + [173] * 10 + [81] * 3 + [15] * 3 -%}
{%- set day_records = 2204 -%}
{%- set frequent = 3.0 -%}
{%- set frequent_request = 1.8 -%}
{%- set role_folders = {
    'pam': [['admin', 'Windows Servers', 'Linux Servers', 'Cloud'], [40, 20, 20, 20]],
    'windows': [['Windows Servers', 'Workstations', 'Databases'], [70, 20, 10]],
    'unix': [['Linux Servers', 'Databases', 'Cloud'], [70, 18, 12]],
    'dba': [['Databases', 'Linux Servers', 'Windows Servers'], [70, 15, 15]],
    'network': [['Network', 'admin'], [75, 25]],
    'helpdesk': [['Workstations', 'Windows Servers'], [80, 20]],
    'cloud': [['Cloud', 'Linux Servers'], [65, 35]]} -%}

{%- if not shared.get('initialized', false) -%}
  {%- if not (2 <= interval <= 8760) -%}{{ module.math.sqrt(-1) }}{%- endif -%}
  {#- One fixed organisation from samples/: secrets with a popularity
      weight and an approval flag, users with a role and an activity
      weight. folders[f] = [secrets, weights, approval-gated secrets,
      their weights]. -#}
  {%- set secrets = [] -%}
  {%- set folders = {} -%}
  {%- for i in range(samples.secrets | length) -%}
    {%- set r = samples.secrets[i] -%}
    {%- do secrets.append({'id': r.id | int, 'name': r.name, 'account': r.account,
        'target': r.target, 'folder': r.folder, 'uuid': r.uuid,
        'approval': r.approval == 'true'}) -%}
    {%- if r.folder not in folders -%}{%- do folders.update({r.folder: [[], [], [], []]}) -%}{%- endif -%}
    {%- set fo = folders[r.folder] -%}
    {%- do fo[0].append(i) -%}{%- do fo[1].append(r.weight | float) -%}
    {%- if r.approval == 'true' -%}{%- do fo[2].append(i) -%}{%- do fo[3].append(r.weight | float) -%}{%- endif -%}
  {%- endfor -%}
  {%- set names = [] -%}{%- set roles = [] -%}{%- set uw = [] -%}{%- set cum = [] -%}
  {%- set acc = namespace(w=0.0) -%}
  {%- for i in range(samples.users | length) -%}
    {%- set r = samples.users[i] -%}
    {%- do names.append(r.name) -%}{%- do roles.append(r.role) -%}
    {%- do uw.append(r.weight | float) -%}
    {%- set acc.w = acc.w + r.weight | float -%}{%- do cum.append(acc.w) -%}
  {%- endfor -%}
  {#- Episode users and secrets: the expected daily records of a
      user/secret pair follow from the session law below (1.839 views
      picked by folder and popularity plus 0.393 approval-gated picks
      per session of 2.232 records), its daily requests likewise (0.218
      approval-gated request picks per session). An episode secret S is
      an approval-gated secret the user requests at least 1.8 times a
      day in ordinary work, and the user opens five other secrets at
      least three times a day. pq[role][s] = [records, requests] per
      record of the role. -#}
  {%- set pq = {} -%}
  {%- for role, rf in role_folders.items() -%}
    {%- set p = {} -%}
    {%- set ft = rf[1] | sum -%}
    {%- for k in range(rf[0] | length) -%}
      {%- set fo = folders[rf[0][k]] -%}
      {%- set share = rf[1][k] / ft -%}
      {%- set tw = fo[1] | sum -%}{%- set ta = fo[3] | sum -%}
      {%- for j in range(fo[0] | length) -%}
        {%- set a = fo[1][j] / ta if fo[0][j] in fo[2] else 0 -%}
        {%- do p.update({fo[0][j]: [share * (1.839 * fo[1][j] / tw + 0.393 * a) / 2.232,
            share * 0.218 * a / 2.232]}) -%}
      {%- endfor -%}
    {%- endfor -%}
    {%- do pq.update({role: p}) -%}
  {%- endfor -%}
  {%- set eligible = [] -%}{%- set ep_sets = {} -%}
  {%- for u in range(names | length) -%}
    {%- set f = [[], [], [], []] -%}
    {%- set scale = day_records * uw[u] / acc.w -%}
    {%- for s, v in pq[roles[u]].items() if scale * v[0] >= frequent -%}
      {%- do f[0].append(s) -%}{%- do f[1].append(scale * v[0]) -%}
    {%- endfor -%}
    {%- for s, v in pq[roles[u]].items() if scale * v[1] >= frequent_request -%}
      {%- if f[0] | reject('equalto', s) | list | length >= 5 -%}
        {%- do f[2].append(s) -%}{%- do f[3].append(scale * v[1]) -%}
      {%- endif -%}
    {%- endfor -%}
    {%- if f[2] -%}{%- do eligible.append(u) -%}{%- do ep_sets.update({u: f}) -%}{%- endif -%}
  {%- endfor -%}
  {%- do shared.update({'initialized': true, 'secrets': secrets, 'folders': folders,
      'names': names, 'roles': roles, 'uw': uw, 'cum': cum, 'total': acc.w,
      'eligible': eligible, 'ep_sets': ep_sets, 'heap': [], 'seq': 0, 'trk': {},
      'epq': [], 'ep_user': none, 'ep_t0': none, 'ep_until': 0, 'start_at': none,
      'last_user': none, 'last_secret': none}) -%}
{%- endif -%}
{%- set secrets = shared.get('secrets') -%}
{%- set folders = shared.get('folders') -%}
{%- set names = shared.get('names') -%}
{%- set roles = shared.get('roles') -%}
{%- set heap = shared.get('heap') -%}
{%- set epq = shared.get('epq') -%}
{%- set trk = shared.get('trk') -%}

{%- macro gap(median, sigma) -%}
{{- [module.random.lognormvariate(module.math.log(median), sigma) | round | int, 1] | max -}}
{%- endmacro -%}

{#- A secret from the user's folders, weighted by folder and popularity. -#}
{%- macro pick(u, approval=false) -%}
  {%- set rf = role_folders[roles[u]] -%}
  {%- set fo = folders[module.rand.weighted_choice(rf[0], rf[1])] -%}
  {{- module.rand.weighted_choice(fo[2], fo[3]) if approval else module.rand.weighted_choice(fo[0], fo[1]) -}}
{%- endmacro -%}

{#- 1. Episode schedule by source time. The first start falls within
    the first min(interval, 24 h), its time drawn from the hour-of-day
    rate. Every later start falls in a window of width
    w = min(interval / 4, 6 h) centred on the due time (previous actual
    start + interval), weighted by the squared rate plus a small floor;
    missed time is never caught up. Starts fall 07:00-19:30, so the
    whole 30 minutes after a start keep the daytime rate; a window with
    no such time moves to the next 07:00-08:00. -#}
{%- macro draw(lo, hi, power, floor) -%}
  {%- set slots = [] -%}{%- set sw = [] -%}
  {%- set top = lo - lo % 3600 -%}
  {%- for j in range(((hi - top) // 3600) | int + 1) -%}
    {%- set a = [top + j * 3600, lo] | max -%}
    {%- set h = (((top + j * 3600) // 3600) % 24) | int -%}
    {%- set b = [top + (j + 1) * 3600 - (1800 if h == 19 else 0), hi] | min -%}
    {%- if b > a and 7 <= h < 20 -%}
      {%- do slots.append([a, b]) -%}{%- do sw.append(((hrate[h] / 173) ** power + floor) * (b - a)) -%}
    {%- endif -%}
  {%- endfor -%}
  {%- if slots -%}
    {%- set slot = module.rand.weighted_choice(slots, sw) -%}
    {{- module.random.uniform(slot[0], slot[1]) -}}
  {%- else -%}
    {%- set d = hi - hi % 86400 + 25200 -%}
    {%- set d = d if d >= hi else d + 86400 -%}
    {{- module.random.uniform(d, d + 3600) -}}
  {%- endif -%}
{%- endmacro -%}

{%- macro open_requests(u) -%}
  {%- set c = namespace(n=0) -%}
  {%- for r in trk.get(u, []) if now - r.t0 <= window + 1 -%}{%- set c.n = c.n + 1 -%}{%- endfor -%}
  {{- c.n -}}
{%- endmacro -%}

{%- if params.anomaly_mode -%}
  {%- if shared.get('start_at') is none -%}
    {%- do shared.set('start_at', draw(now, now + [interval * 3600, 86400] | min, 1, 0) | float) -%}
  {%- elif now >= shared.get('start_at') and not epq -%}
    {#- A busy user weighted like the background, not the previous one,
        with no open request and no open session; a request for an
        approval-gated secret S the user often requests, its view after
        approval, then views of five more of the user's frequent secrets
        with ordinary re-views in between. The gaps between views come
        from the background law; the approval delay too, limited to the
        range that puts the last view in the three minutes before
        30 minutes less six mean record intervals of that hour (25-28
        minutes in office hours) after the request. Until 30 minutes
        after the request the user starts no ordinary session. With no
        free user or plan the start waits for the next timestamp. Rows:
        [due, kind, secret, final, re-view]. -#}
    {%- set busy = [] -%}
    {%- for e in heap -%}{%- do busy.append(e[2]) -%}{%- endfor -%}
    {%- set cand = [] -%}{%- set cw = [] -%}
    {%- for u in shared.get('eligible') if u != shared.get('last_user') and u not in busy
        and open_requests(u) | int == 0 -%}
      {%- do cand.append(u) -%}{%- do cw.append(shared.get('uw')[u]) -%}
    {%- endfor -%}
    {%- if cand -%}
      {%- set u = module.rand.weighted_choice(cand, cw) -%}
      {%- set f = shared.get('ep_sets')[u] -%}
      {%- set ai = [] -%}{%- set aw = [] -%}
      {%- for k in range(f[2] | length) if f[2][k] != shared.get('last_secret') or f[2] | length == 1 -%}
        {%- do ai.append(f[2][k]) -%}{%- do aw.append(f[3][k]) -%}
      {%- endfor -%}
      {%- set s0 = module.rand.weighted_choice(ai, aw) -%}
      {%- set nd = module.statistics.NormalDist(module.math.log(360), 1.1) -%}
      {%- set top = window - 6 * 3600 / hrate[(((now + 1600) // 3600) % 24) | int] -%}
      {%- set ep = namespace(plan=[]) -%}
      {%- for attempt in range(20) if not ep.plan -%}
        {%- set pool = namespace(i=[], w=[]) -%}
        {%- for k in range(f[0] | length) if f[0][k] != s0 -%}
          {%- set pool.i = pool.i + [f[0][k]] -%}{%- set pool.w = pool.w + [f[1][k]] -%}
        {%- endfor -%}
        {%- set t = namespace(at=0, prev=s0, n=0) -%}
        {%- set views = [] -%}
        {%- for i in range(40) if t.n < 5 -%}
          {%- set t.at = t.at + gap(45, 1.1) | int -%}
          {%- if module.rand.chance(0.3) -%}
            {%- do views.append([t.at, 'view', t.prev, false, true]) -%}
          {%- else -%}
            {%- set k = module.rand.weighted_choice(range(pool.i | length) | list, pool.w) -%}
            {%- set t.prev = pool.i[k] -%}
            {%- set pool.i = pool.i[:k] + pool.i[k + 1:] -%}{%- set pool.w = pool.w[:k] + pool.w[k + 1:] -%}
            {%- set t.n = t.n + 1 -%}
            {%- do views.append([t.at, 'view', t.prev, t.n == 5, false]) -%}
          {%- endif -%}
        {%- endfor -%}
        {%- if t.n == 5 and t.at <= top - 240 -%}
          {%- set lo = nd.cdf(module.math.log(top - 180 - t.at)) -%}
          {%- set hi = nd.cdf(module.math.log(top - t.at)) -%}
          {%- set d = module.math.exp(nd.inv_cdf(module.random.uniform(lo, hi))) | round | int -%}
          {%- set ep.plan = [[0, 'request', s0, false, false], [d, 'view', s0, false, false]] -%}
          {%- for r in views -%}{%- do ep.plan.append([d + r[0], r[1], r[2], r[3], r[4]]) -%}{%- endfor -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}
    {%- if cand and ep.plan -%}
      {%- for r in ep.plan -%}{%- do epq.append([now + r[0], r[1], r[2], r[3], r[4]]) -%}{%- endfor -%}
      {%- set due = now + interval * 3600 -%}
      {%- set w = [interval * 900, 21600] | min -%}
      {%- do shared.update({'ep_user': u, 'last_user': u, 'last_secret': s0,
          'ep_t0': now, 'ep_until': now + window + 1,
          'start_at': draw(due - w / 2, due + w / 2, 2, 0.05) | float}) -%}
    {%- endif -%}
  {%- endif -%}
{%- endif -%}

{#- 2. The record of this timestamp. An episode running late for its
    30 minutes (less than three mean record intervals per remaining
    view left, plus one) drops its pending re-views and logs its next
    view at once. -#}
{%- set row = namespace(user=none, kind=none, s=none, episode=false, final=false) -%}
{%- set late = namespace(v=false, need=0) -%}
{%- if epq and epq[0][0] > now -%}
  {%- for r in epq if not r[4] -%}{%- set late.need = late.need + 1 -%}{%- endfor -%}
  {%- set late.v = shared.get('ep_t0') + window - 10 - now
      < 3 * (late.need + 1) * 3600 / hrate[((now // 3600) % 24) | int] -%}
  {%- if late.v -%}
    {%- set keep = epq | rejectattr('4') | list -%}
    {%- do epq.clear() -%}{%- do epq.extend(keep) -%}
  {%- endif -%}
{%- endif -%}
{%- if epq and (epq[0][0] <= now or late.v) -%}
  {%- set e = epq.pop(0) -%}
  {%- set row.user = shared.get('ep_user') -%}{%- set row.kind = e[1] -%}{%- set row.s = e[2] -%}
  {%- set row.episode = true -%}{%- set row.final = e[3] -%}
{%- elif heap and heap[0][0] <= now -%}
  {%- set e = module.heapq.heappop(heap) -%}
  {%- set row.user = e[2] -%}{%- set row.kind = e[3][e[4]][0] -%}{%- set row.s = e[3][e[4]][1] -%}
  {%- if e[4] + 1 < e[3] | length -%}
    {%- do shared.set('seq', shared.get('seq') + 1) -%}
    {%- do module.heapq.heappush(heap, (now + e[3][e[4] + 1][2], shared.get('seq'), e[2], e[3], e[4] + 1)) -%}
  {%- endif -%}
{%- else -%}
  {#- A new session of a user drawn by activity weight. Most sessions
      view one to five secrets, re-opening the previous one at times;
      one in five requests an approval-gated secret, usually views it
      after approval and sometimes more secrets, and sometimes requests
      a second one. Each next record is due a random gap after the
      previous one was logged. -#}
  {#- The episode user starts no ordinary session until 30 minutes
      after the episode's request: such a draw goes to another user. -#}
  {%- set nu = namespace(u=-1) -%}
  {%- for i in range(50) if nu.u < 0 or (nu.u == shared.get('ep_user') and now < shared.get('ep_until')) -%}
    {%- set x = module.bisect.bisect(shared.get('cum'), module.random.random() * shared.get('total')) -%}
    {%- set nu.u = [x, names | length - 1] | min -%}
  {%- endfor -%}
  {%- set u = nu.u -%}
  {%- set steps = [] -%}
  {%- if module.rand.chance(0.8) -%}
    {%- set ref = namespace(s=none) -%}
    {%- for i in range(module.rand.weighted_choice([1, 2, 3, 4, 5], [40, 26, 16, 10, 8])) -%}
      {%- if ref.s is none or not module.rand.chance(0.3) -%}{%- set ref.s = pick(u) | int -%}{%- endif -%}
      {%- do steps.append(['view', ref.s, 0 if i == 0 else gap(45, 1.1) | int]) -%}
    {%- endfor -%}
  {%- else -%}
    {%- set s0 = pick(u, true) | int -%}
    {%- set rows = [[0, 'request', s0]] -%}
    {%- if module.rand.chance(0.09) -%}
      {%- do rows.append([gap(90, 1.0) | int, 'request', s0 if module.rand.chance(0.5) else pick(u, true) | int]) -%}
    {%- endif -%}
    {%- if module.rand.chance(0.78) -%}
      {%- set t = namespace(at=gap(360, 1.1) | int, s=s0) -%}
      {%- do rows.append([t.at, 'view', s0]) -%}
      {%- if module.rand.chance(0.35) -%}
        {%- for i in range(module.rand.weighted_choice([1, 2, 3, 4], [50, 28, 14, 8])) -%}
          {%- set t.at = t.at + gap(45, 1.1) | int -%}
          {%- if not module.rand.chance(0.3) -%}{%- set t.s = pick(u) | int -%}{%- endif -%}
          {%- do rows.append([t.at, 'view', t.s]) -%}
        {%- endfor -%}
      {%- endif -%}
    {%- endif -%}
    {%- set prev = namespace(at=0) -%}
    {%- for r in rows | sort(attribute='0') -%}
      {%- do steps.append([r[1], r[2], r[0] - prev.at]) -%}{%- set prev.at = r[0] -%}
    {%- endfor -%}
  {%- endif -%}
  {%- set row.user = u -%}{%- set row.kind = steps[0][0] -%}{%- set row.s = steps[0][1] -%}
  {%- if steps | length > 1 -%}
    {%- do shared.set('seq', shared.get('seq') + 1) -%}
    {%- do module.heapq.heappush(heap, (now + steps[1][2], shared.get('seq'), u, steps, 1)) -%}
  {%- endif -%}
{%- endif -%}

{#- 3. Sequence tracker with the detector's semantics: per user, each
    request of the last 30 minutes with the time of the first view of
    its secret and the distinct other secrets viewed after it. A view
    completes a sequence when it is not the requested secret and four
    other distinct secrets besides it were viewed after that first view.
    Guard on the final step only: an ordinary view that would complete a
    sequence opens a requested secret again instead (a second request
    for it when every such view would complete one too); its time is
    kept. The episode's last view completes its own sequence. -#}
{%- set reqs = [] -%}
{%- for r in trk.get(row.user, []) if now - r.t0 <= window + 1 -%}{%- do reqs.append(r) -%}{%- endfor -%}
{%- macro completes(x) -%}
  {%- set c = namespace(v=false) -%}
  {%- for r in reqs if not c.v and r.t1 is not none and x != r.a -%}
    {%- if r.o | reject('equalto', x) | list | length >= 4 -%}{%- set c.v = true -%}{%- endif -%}
  {%- endfor -%}
  {{- 'y' if c.v else '' -}}
{%- endmacro -%}
{%- set g = namespace(kind=row.kind, s=row.s, final=row.final) -%}
{%- if row.kind == 'view' and row.final -%}
  {%- set own = namespace(r=none) -%}
  {%- for r in reqs if r.t0 == shared.get('ep_t0') -%}{%- set own.r = r -%}{%- endfor -%}
  {%- if own.r is none or own.r.t1 is none -%}
    {%- set g.final = false -%}
  {%- elif own.r.o | reject('equalto', g.s) | list | length < 4 or g.s == own.r.a -%}
    {#- Earlier views of the sequence were changed: view one more of the
        user's frequent secrets first. -#}
    {%- set f = shared.get('ep_sets')[row.user] -%}
    {%- set spare = [] -%}{%- set spw = [] -%}
    {%- for k in range(f[0] | length) if f[0][k] not in own.r.o and f[0][k] != own.r.a -%}
      {%- do spare.append(f[0][k]) -%}{%- do spw.append(f[1][k]) -%}
    {%- endfor -%}
    {%- if own.r.o | length >= 4 and spare -%}
      {%- set g.s = module.rand.weighted_choice(spare, spw) -%}
    {%- else -%}
      {%- set g.final = false -%}
      {%- if spare -%}
        {%- do epq.insert(0, [now + gap(45, 1.1) | int, 'view', module.rand.weighted_choice(spare, spw), true, false]) -%}
      {%- endif -%}
    {%- endif -%}
  {%- endif -%}
{%- endif -%}
{%- if g.kind == 'view' and not g.final and completes(g.s) -%}
  {%- set alt = namespace(s=none, first=none) -%}
  {%- for r in reqs if r.t1 is not none -%}
    {%- if alt.first is none -%}{%- set alt.first = r.a -%}{%- endif -%}
    {%- if alt.s is none and not completes(r.a) -%}{%- set alt.s = r.a -%}{%- endif -%}
  {%- endfor -%}
  {%- if alt.s is not none -%}{%- set g.s = alt.s -%}
  {%- else -%}{%- set g.kind = 'request' -%}{%- set g.s = alt.first -%}
  {%- endif -%}
{%- endif -%}
{%- if g.kind == 'request' -%}
  {%- do reqs.append({'t0': now, 'a': g.s, 't1': none, 'o': []}) -%}
  {%- if row.episode -%}{%- do shared.set('ep_t0', now) -%}{%- endif -%}
{%- else -%}
  {%- for r in reqs -%}
    {%- if r.t1 is none -%}
      {%- if g.s == r.a -%}{%- do r.update({'t1': now}) -%}{%- endif -%}
    {%- elif g.s != r.a and g.s not in r.o -%}
      {%- do r.o.append(g.s) -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}
{%- if reqs -%}{%- do trk.update({row.user: reqs}) -%}
{%- elif row.user in trk -%}{%- do trk.pop(row.user) -%}
{%- endif -%}

{#- 4. The record. -#}
{%- set user_name = names[row.user] -%}
{%- set secret = secrets[g.s] -%}
{%- set date = occurred.strftime('%Y-%m-%d') -%}
{%- set time = occurred.strftime('%H:%M:%S') -%}
{%- set eventtime = sec * 1000000000 + usec * 1000 + module.random.randint(0, 999) -%}
{%- if g.kind == 'request' -%}
  {%- set minutes = module.rand.weighted_choice([30, 60, 120, 240, 480], [30, 34, 18, 12, 6]) -%}
  {%- set start = module.datetime.datetime.fromtimestamp(sec - sec % 60, utc) -%}
  {%- set expiry = start + module.datetime.timedelta(minutes=minutes) -%}
  {%- set logid = '2304064604' -%}
  {%- set kv = {'type': 'secret', 'subtype': 'secret-request', 'eventtype': 'secret-request',
      'action': 'pass', 'operation': 'request', 'secretid': secret.id, 'secret': secret.name,
      'account': secret.account, 'uuid': secret.uuid, 'user': user_name,
      'starttime': start.strftime('%Y-%m-%d %H:%M:%S'),
      'expirytime': expiry.strftime('%Y-%m-%d %H:%M:%S'), 'msg': 'Created secret request.'} -%}
  {%- set raw = 'date=' ~ date ~ ' time=' ~ time ~ ' devname="' ~ params.device_name
    ~ '" devid="' ~ params.device_name ~ '" eventtime=' ~ eventtime ~ ' tz="+0000" logid="'
    ~ logid ~ '" type="secret" subtype="secret-request" eventtype="secret-request"'
    ~ ' action="pass" operation="request" secretid=' ~ secret.id ~ ' secret="' ~ secret.name
    ~ '" account="' ~ secret.account ~ '" uuid="' ~ secret.uuid ~ '" user="' ~ user_name
    ~ '" starttime="' ~ kv.starttime ~ '" expirytime="' ~ kv.expirytime
    ~ '" msg="Created secret request."' -%}
{%- else -%}
  {%- set logid = '2303064603' -%}
  {%- set kv = {'type': 'secret', 'subtype': 'clear-text', 'eventtype': 'clear-text',
      'action': 'resp', 'agent': 'GUI', 'operation': 'clear-text-view', 'secretid': secret.id,
      'secret': secret.name, 'account': secret.account, 'target': secret.target,
      'folder': secret.folder, 'uuid': secret.uuid, 'user': user_name,
      'msg': 'Clear text view allowed.'} -%}
  {%- set raw = 'date=' ~ date ~ ' time=' ~ time ~ ' eventtime=' ~ eventtime
    ~ ' tz="+0000" logid="' ~ logid ~ '" type="secret" subtype="clear-text"'
    ~ ' eventtype="clear-text" action="resp" agent="GUI" operation="clear-text-view"'
    ~ ' secretid=' ~ secret.id ~ ' secret="' ~ secret.name ~ '" account="' ~ secret.account
    ~ '" target="' ~ secret.target ~ '" folder="' ~ secret.folder ~ '" uuid="' ~ secret.uuid
    ~ '" user="' ~ user_name ~ '" msg="Clear text view allowed."' -%}
{%- endif -%}
{%- do kv.update({'logid': logid, 'eventtime': eventtime, 'tz': '+0000'}) -%}
{%- set record = {'@timestamp': occurred.strftime('%Y-%m-%dT%H:%M:%S') ~ ('.%06dZ' | format(usec)),
  'ecs': {'version': '8.17.0'},
  'event': {'kind': 'event', 'dataset': 'fortinet.fortipam', 'module': 'fortinet',
    'category': ['iam'], 'type': ['creation'] if g.kind == 'request' else ['info'],
    'code': logid, 'action': kv.operation, 'outcome': 'success', 'original': raw},
  'observer': {'vendor': 'Fortinet', 'product': 'FortiPAM',
    'hostname': params.device_name, 'serial_number': params.device_name},
  'user': {'name': user_name},
  'related': {'user': [user_name], 'ip': [secret.target]} if g.kind == 'view'
    else {'user': [user_name]},
  'fortinet': {'fortipam': kv}} -%}
{{ record | tojson }}
