{#- One FortiPAM appliance: secret-request (2304064604) and
    clear-text-view (2303064603) logs. Each one-second tick emits at
    most one record: the earliest due one. Users open sessions as
    independent random processes; the anomaly episode only queues its
    own records for one user and never touches the background. -#}
{%- set utc = module.datetime.timezone.utc -%}
{%- set now = timestamp.timestamp() | int -%}
{%- set interval = params.anomaly_interval_hours | float -%}
{%- set window = 1800 -%}
{%- set last = 6 -%}

{%- set folders = {
    'admin': [['fpam-local-admin', 'admin'], ['fgt-edge-01', 'admin'],
      ['fgt-edge-02', 'admin'], ['fortiauth-01', 'admin'], ['faz-01', 'admin']],
    'Windows Servers': [['dc01', 'Administrator'], ['dc02', 'Administrator'],
      ['file-srv-01', 'svc-backup'], ['app-srv-03', 'Administrator'],
      ['rds-gw-01', 'Administrator'], ['sccm-01', 'svc-sccm'],
      ['print-srv-01', 'Administrator'], ['exch-01', 'svc-exchange']],
    'Linux Servers': [['web-prd-01', 'root'], ['web-prd-02', 'root'],
      ['k8s-master-01', 'root'], ['build-01', 'jenkins'], ['bastion-01', 'root'],
      ['mon-01', 'zabbix'], ['log-01', 'root'], ['git-01', 'git']],
    'Databases': [['sql-prd-01', 'sa'], ['sql-prd-02', 'sa'], ['ora-fin-01', 'SYS'],
      ['pg-app-01', 'postgres'], ['pg-app-02', 'postgres'], ['mdb-01', 'admin']],
    'Network': [['sw-core-01', 'admin'], ['sw-core-02', 'admin'], ['wlc-01', 'admin'],
      ['vpn-gw-01', 'admin'], ['lb-01', 'root'], ['sw-access-12', 'admin']],
    'Workstations': [['ws-laps-fin', 'localadmin'], ['ws-laps-hr', 'localadmin'],
      ['ws-laps-it', 'localadmin'], ['kiosk-01', 'kiosk'], ['ws-laps-dev', 'localadmin']],
    'Cloud': [['aws-prod-root', 'root'], ['aws-prod-iam', 'break-glass'],
      ['azure-ga', 'ga-breakglass'], ['m365-admin', 'admin'], ['gcp-billing', 'owner']]} -%}
{%- set surnames = ['petrov', 'novak', 'smith', 'brown', 'lee', 'kumar', 'berg',
    'rossi', 'nguyen', 'muller', 'ivanov', 'dubois', 'taylor', 'hoffmann', 'wilson',
    'clark', 'davis', 'white', 'silva', 'garcia', 'khan', 'moreau', 'lopez', 'chen',
    'young', 'morgan', 'walker', 'ward', 'fischer', 'kowalski', 'sato', 'jensen',
    'costa', 'martin', 'haas', 'olsen', 'bauer', 'reyes', 'park', 'singh', 'wagner',
    'meyer', 'popescu', 'horvat', 'larsen', 'ahmed', 'baker', 'carter', 'evans',
    'foster', 'green', 'hughes', 'king', 'lewis', 'mills', 'nash', 'owen', 'price',
    'reed', 'stone'] -%}
{%- set role_mix = ['pam'] * 3 + ['windows'] * 10 + ['unix'] * 9 + ['dba'] * 6
    + ['network'] * 7 + ['helpdesk'] * 17 + ['cloud'] * 8 -%}
{%- set role_folders = {
    'pam': [['admin', 'Windows Servers', 'Linux Servers', 'Cloud'], [40, 20, 20, 20]],
    'windows': [['Windows Servers', 'Workstations', 'Databases'], [70, 20, 10]],
    'unix': [['Linux Servers', 'Databases', 'Cloud'], [70, 18, 12]],
    'dba': [['Databases', 'Linux Servers', 'Windows Servers'], [70, 15, 15]],
    'network': [['Network', 'admin'], [75, 25]],
    'helpdesk': [['Workstations', 'Windows Servers'], [80, 20]],
    'cloud': [['Cloud', 'Linux Servers'], [65, 35]]} -%}
{%- set subnets = {'admin': '10.20.0.', 'Windows Servers': '10.20.10.',
    'Linux Servers': '10.20.20.', 'Databases': '10.20.30.', 'Network': '10.20.1.',
    'Workstations': '10.30.40.', 'Cloud': '10.40.0.'} -%}

{%- macro load(hour) -%}
{{- 1.7 if 8 <= hour < 18 else (0.8 if 7 <= hour < 8 or 18 <= hour < 21 else 0.15) -}}
{%- endmacro -%}

{%- if not shared.get('initialized', false) -%}
  {%- if not (2 <= interval <= 8760) -%}{{ module.math.sqrt(-1) }}{%- endif -%}
  {#- One fixed organisation: IDs, addresses, UUIDs, approval flags,
      per-user activity and per-secret popularity come from a fixed
      seed; only behaviour is random. -#}
  {%- set rnd = module.random.Random(4604) -%}
  {%- set total = namespace(n=0) -%}
  {%- for f, items in folders.items() -%}{%- set total.n = total.n + items | length -%}{%- endfor -%}
  {%- set ids = rnd.sample(range(12, 3200), total.n) -%}
  {%- set hosts = rnd.sample(range(10, 250), total.n) -%}
  {%- set k = namespace(i=0) -%}
  {%- set secrets = {} -%}
  {%- for f, items in folders.items() -%}
    {%- set rows = [] -%}
    {%- set weights = [] -%}
    {%- for item in items -%}
      {%- set i = k.i -%}{%- set k.i = k.i + 1 -%}
      {%- set uuid = '%08x-%04x-5%03x-%04x-%012x' | format(rnd.getrandbits(32),
          rnd.getrandbits(16), rnd.getrandbits(12), rnd.getrandbits(16), rnd.getrandbits(48)) -%}
      {%- do rows.append({'id': ids[i], 'name': item[0], 'account': item[1],
          'target': subnets[f] ~ hosts[i], 'folder': f, 'uuid': uuid,
          'approval': loop.index0 < 2 or rnd.random() < 0.3}) -%}
      {%- do weights.append(rnd.lognormvariate(0, 0.8)) -%}
    {%- endfor -%}
    {%- do secrets.update({f: [rows, weights]}) -%}
  {%- endfor -%}
  {%- set users = {} -%}
  {%- for name in surnames -%}
    {%- do users.update({'abcdefghijklmnoprstvyz'[rnd.randrange(22)] ~ '.' ~ name:
        {'role': role_mix[loop.index0], 'weight': rnd.lognormvariate(0, 0.5)}}) -%}
  {%- endfor -%}
  {%- do shared.update({'initialized': true, 'users': users, 'secrets': secrets,
      'q': [], 'parts': {}, 'next_due': now + (interval * 3600) | int,
      'start_at': none, 'last_user': none, 'last_secret': none}) -%}
{%- endif -%}
{%- set users = shared.get('users') -%}
{%- set secrets = shared.get('secrets') -%}
{%- set q = shared.get('q') -%}
{%- set parts = shared.get('parts') -%}
{%- set hour = timestamp.astimezone(utc).hour -%}

{%- macro gap(median, sigma) -%}
{{- [module.rand.number.lognormal(module.math.log(median), sigma) | round | int, 1] | max -}}
{%- endmacro -%}

{%- macro pick(user, approval_only=false, exclude=[]) -%}
  {#- A secret from the user's folders, weighted by folder and
      popularity; returns its folder and index. -#}
  {%- set rf = role_folders[users[user].role] -%}
  {%- for attempt in range(40) -%}
    {%- set f = module.rand.weighted_choice(rf[0], rf[1]) -%}
    {%- set idx = module.rand.weighted_choice(range(secrets[f][0] | length) | list, secrets[f][1]) -%}
    {%- set s = secrets[f][0][idx] -%}
    {%- if (not approval_only or s.approval) and s.id not in exclude -%}
      {{- f ~ '|' ~ idx -}}{%- break -%}
    {%- endif -%}
  {%- endfor -%}
{%- endmacro -%}

{%- macro secret_of(ref) -%}
  {%- set r = ref.split('|') -%}{{- secrets[r[0]][0][r[1] | int].id -}}
{%- endmacro -%}

{%- macro push(at, user, kind, ref, episode=false) -%}
  {%- do q.append({'due': at | int, 'user': user, 'kind': kind, 'ref': ref,
      'episode': episode}) -%}
{%- endmacro -%}

{#- A view session: n clear-text views, random gaps; each view either
    re-opens the previous secret or picks one from the user's folders. -#}
{%- macro views(user, start, n, first=none) -%}
  {%- set t = namespace(at=start, ref=first) -%}
  {%- for i in range(n) -%}
    {%- if i > 0 or first is not none -%}{%- set t.at = t.at + gap(45, 1.1) | int -%}{%- endif -%}
    {%- if t.ref is none or not module.rand.chance(0.3) -%}{%- set t.ref = pick(user) -%}{%- endif -%}
    {{- push(t.at, user, 'view', t.ref) -}}
  {%- endfor -%}
{%- endmacro -%}

{#- 1. Background: one merged Poisson stream of independent users,
    weighted per user and modulated by the hour of day. -#}
{%- if module.rand.chance(0.004 * (load(hour) | float)) -%}
  {%- set names = users.keys() | list -%}
  {%- set weights = [] -%}
  {%- for name in names -%}{%- do weights.append(users[name].weight) -%}{%- endfor -%}
  {%- set u = module.rand.weighted_choice(names, weights) -%}
  {%- if module.rand.chance(0.8) -%}
    {{- views(u, now, module.rand.weighted_choice([1, 2, 3, 4, 5], [40, 26, 16, 10, 8])) -}}
  {%- else -%}
    {#- Request flow: a request for an approval-gated secret, then
        (after approval) usually a view of it, sometimes more views and
        sometimes a second request a little later. -#}
    {%- set ref = pick(u, true) -%}
    {{- push(now, u, 'request', ref) -}}
    {%- if module.rand.chance(0.09) -%}
      {{- push(now + gap(90, 1.0) | int, u, 'request',
          ref if module.rand.chance(0.5) else pick(u, true)) -}}
    {%- endif -%}
    {%- if module.rand.chance(0.78) -%}
      {%- set at = now + gap(360, 1.1) | int -%}
      {{- push(at, u, 'view', ref) -}}
      {%- if module.rand.chance(0.35) -%}
        {{- views(u, at, module.rand.weighted_choice([1, 2, 3, 4], [50, 28, 14, 8]), ref) -}}
      {%- endif -%}
    {%- endif -%}
  {%- endif -%}
{%- endif -%}

{#- 2. Episode schedule by source time. The first start falls within
    the first min(interval, 24 h), its time drawn from the background
    hour-of-day load. Every later start falls in a window of width
    w = min(interval / 4, 6 h) centred on the due time (previous
    actual start + interval), weighted by load^2 plus a small floor;
    missed time is never caught up. -#}
{%- macro draw(lo, hi, power, floor) -%}
  {%- set slots = [] -%}{%- set sw = [] -%}
  {%- set top = lo - lo % 3600 -%}
  {%- for j in range((hi - top) // 3600 + 1) -%}
    {%- set a = [top + j * 3600, lo] | max -%}
    {%- set b = [top + (j + 1) * 3600, hi] | min -%}
    {%- if b > a -%}
      {%- set l = load(module.datetime.datetime.fromtimestamp(a, utc).hour) | float -%}
      {%- do slots.append([a, b]) -%}{%- do sw.append((l ** power + floor) * (b - a)) -%}
    {%- endif -%}
  {%- endfor -%}
  {%- set slot = module.rand.weighted_choice(slots, sw) -%}
  {{- module.random.randint(slot[0], slot[1] - 1) -}}
{%- endmacro -%}
{%- if params.anomaly_mode and shared.get('start_at') is none -%}
  {%- set first = now + ([interval * 3600, 86400] | min | int) -%}
  {%- do shared.set('start_at', draw(now, first, 1, 0) | int) -%}
{%- endif -%}
{%- if params.anomaly_mode and shared.get('start_at') is not none
    and now >= shared.get('start_at') -%}
  {#- A user weighted like the background, not the previous one; a
      request for one of their approval-gated secrets, its view after
      approval, then clear-text views of five more of their secrets,
      with ordinary re-views, all within the chain window. -#}
  {%- set names = [] -%}{%- set weights = [] -%}
  {%- for name, info in users.items() if name != shared.get('last_user') -%}
    {%- do names.append(name) -%}{%- do weights.append(info.weight) -%}
  {%- endfor -%}
  {%- set u = module.rand.weighted_choice(names, weights) -%}
  {%- set ep = namespace(plan=[], ok=false) -%}
  {%- for attempt in range(30) if not ep.ok -%}
    {%- set ref = pick(u, true, [shared.get('last_secret')]) -%}
    {%- set t = namespace(at=now + gap(360, 1.1) | int, seen=[secret_of(ref) | int], refs=[ref], plan=[]) -%}
    {%- do t.plan.append([now, 'request', ref]) -%}
    {%- do t.plan.append([t.at, 'view', ref]) -%}
    {%- for i in range(20) if t.seen | length < last -%}
      {%- set t.at = t.at + gap(45, 1.1) | int -%}
      {%- if module.rand.chance(0.3) -%}
        {%- do t.plan.append([t.at, 'view', t.refs[-1]]) -%}
      {%- else -%}
        {%- set r2 = pick(u, false, t.seen) -%}
        {%- if r2 -%}
          {%- do t.seen.append(secret_of(r2) | int) -%}{%- do t.refs.append(r2) -%}
          {%- do t.plan.append([t.at, 'view', r2]) -%}
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}
    {%- if t.seen | length == last and t.at - now <= window - 120 -%}
      {%- set ep.plan = t.plan -%}{%- set ep.ok = true -%}
      {%- do shared.set('last_secret', t.seen[0]) -%}
    {%- endif -%}
  {%- endfor -%}
  {%- for row in ep.plan -%}{{- push(row[0], u, row[1], row[2], true) -}}{%- endfor -%}
  {%- set due = now + (interval * 3600) | int -%}
  {%- set w = [interval * 900, 21600] | min | int -%}
  {%- do shared.update({'last_user': u, 'next_due': due,
      'start_at': draw(due - w // 2, due + w // 2, 2, 0.05) | int}) -%}
{%- endif -%}

{#- 3. Emit the earliest due record, otherwise nothing. -#}
{%- set sel = namespace(i=-1, due=now + 1) -%}
{%- for e in q -%}
  {%- if e.due <= now and e.due < sel.due -%}{%- set sel.i = loop.index0 -%}{%- set sel.due = e.due -%}{%- endif -%}
{%- endfor -%}
{%- if sel.i < 0 -%}{{ dispatch.drop() }}{%- endif -%}
{%- set e = q.pop(sel.i) -%}
{%- set user_name = e.user -%}
{%- set r = e.ref.split('|') -%}
{%- set secret = secrets[r[0]][0][r[1] | int] -%}
{%- set usec = module.random.randint(0, 999999) -%}
{%- set t_now = now + usec / 1000000 -%}

{#- Chain tracker: request S -> view S -> views of five more distinct
    secrets by one user within the window, with the detector's
    semantics (steps skip other rows, up to 8 open partials, completion
    resets the user). Guard on the final step only: an ordinary view
    that would complete a chain re-opens a secret the chain already
    holds instead; its time is kept. -#}
{%- set ps = parts.get(user_name, []) | selectattr('0', 'ge', t_now - window) | list -%}
{%- if e.kind == 'view' and not e.episode -%}
  {%- set block = namespace(keep=none) -%}
  {%- for p in ps if p[1] == last and secret.id not in p[2] -%}
    {%- set block.keep = p[2] if block.keep is none else (block.keep | select('in', p[2]) | list) -%}
  {%- endfor -%}
  {%- if block.keep is not none -%}
    {%- set again = module.rand.choice(block.keep or ps[0][2]) -%}
    {%- set found = namespace(s=none) -%}
    {%- for f, rows in secrets.items() -%}
      {%- for s in rows[0] if s.id == again -%}{%- set found.s = s -%}{%- endfor -%}
    {%- endfor -%}
    {%- set secret = found.s -%}
  {%- endif -%}
{%- endif -%}
{%- set nx = namespace(parts=[], done=false) -%}
{%- for p in ps if not nx.done -%}
  {%- if e.kind == 'view' and ((p[1] == 1 and secret.id == p[2][0])
      or (p[1] >= 2 and secret.id not in p[2])) -%}
    {%- if p[1] == last -%}{%- set nx.done = true -%}
    {%- else -%}{%- set nx.parts = nx.parts + [[p[0], p[1] + 1, p[2] + ([secret.id] if p[1] >= 2 else [])]] -%}
    {%- endif -%}
  {%- else -%}
    {%- set nx.parts = nx.parts + [p] -%}
  {%- endif -%}
{%- endfor -%}
{%- if nx.done -%}{%- set nx.parts = [] -%}
{%- elif e.kind == 'request' -%}{%- set nx.parts = nx.parts + [[t_now, 1, [secret.id]]] -%}
{%- endif -%}
{%- if nx.parts and not nx.done -%}{%- do parts.update({user_name: nx.parts[-8:]}) -%}
{%- elif user_name in parts -%}{%- do parts.pop(user_name) -%}
{%- endif -%}

{%- set occurred = module.datetime.datetime.fromtimestamp(now, utc) -%}
{%- set date = occurred.strftime('%Y-%m-%d') -%}
{%- set time = occurred.strftime('%H:%M:%S') -%}
{%- set eventtime = now * 1000000000 + usec * 1000 + module.random.randint(0, 999) -%}
{%- if e.kind == 'request' -%}
  {%- set minutes = module.rand.weighted_choice([30, 60, 120, 240, 480], [30, 34, 18, 12, 6]) -%}
  {%- set start = module.datetime.datetime.fromtimestamp(now - now % 60, utc) -%}
  {%- set expiry = start + module.datetime.timedelta(minutes=minutes) -%}
  {%- set logid = '2304064604' -%}
  {%- set kv = {'type': 'secret', 'subtype': 'secret-request', 'eventtype': 'secret-request',
      'action': 'pass', 'operation': 'request', 'secretid': secret.id, 'secret': secret.name,
      'account': secret.account, 'uuid': secret.uuid, 'user': user_name,
      'starttime': start.strftime('%Y-%m-%d %H:%M:%S'),
      'expirytime': expiry.strftime('%Y-%m-%d %H:%M:%S'), 'msg': 'Created secret request.'} -%}
  {%- set raw = 'date=' ~ date ~ ' time=' ~ time ~ ' devname="' ~ params.device_name
    ~ '" devid="' ~ params.device_name ~ '" eventtime=' ~ eventtime ~ ' tz="+0000" logid="'
    ~ logid ~ '" type="secret" subtype="secret-request" eventtype="secret-request"'
    ~ ' action="pass" operation="request" secretid=' ~ secret.id ~ ' secret="' ~ secret.name
    ~ '" account="' ~ secret.account ~ '" uuid="' ~ secret.uuid ~ '" user="' ~ user_name
    ~ '" starttime="' ~ kv.starttime ~ '" expirytime="' ~ kv.expirytime
    ~ '" msg="Created secret request."' -%}
{%- else -%}
  {%- set logid = '2303064603' -%}
  {%- set kv = {'type': 'secret', 'subtype': 'clear-text', 'eventtype': 'clear-text',
      'action': 'resp', 'agent': 'GUI', 'operation': 'clear-text-view', 'secretid': secret.id,
      'secret': secret.name, 'account': secret.account, 'target': secret.target,
      'folder': secret.folder, 'uuid': secret.uuid, 'user': user_name,
      'msg': 'Clear text view allowed.'} -%}
  {%- set raw = 'date=' ~ date ~ ' time=' ~ time ~ ' eventtime=' ~ eventtime
    ~ ' tz="+0000" logid="' ~ logid ~ '" type="secret" subtype="clear-text"'
    ~ ' eventtype="clear-text" action="resp" agent="GUI" operation="clear-text-view"'
    ~ ' secretid=' ~ secret.id ~ ' secret="' ~ secret.name ~ '" account="' ~ secret.account
    ~ '" target="' ~ secret.target ~ '" folder="' ~ secret.folder ~ '" uuid="' ~ secret.uuid
    ~ '" user="' ~ user_name ~ '" msg="Clear text view allowed."' -%}
{%- endif -%}
{%- do kv.update({'logid': logid, 'eventtime': eventtime, 'tz': '+0000'}) -%}
{%- set record = {'@timestamp': occurred.strftime('%Y-%m-%dT%H:%M:%S') ~ ('.%06dZ' | format(usec)),
  'ecs': {'version': '8.17.0'},
  'event': {'kind': 'event', 'dataset': 'fortinet.fortipam', 'module': 'fortinet',
    'category': ['iam'], 'type': ['creation'] if e.kind == 'request' else ['info'],
    'code': logid, 'action': kv.operation, 'outcome': 'success', 'original': raw},
  'observer': {'vendor': 'Fortinet', 'product': 'FortiPAM',
    'hostname': params.device_name, 'serial_number': params.device_name},
  'user': {'name': user_name},
  'related': {'user': [user_name], 'ip': [secret.target]} if e.kind == 'view'
    else {'user': [user_name]},
  'fortinet': {'fortipam': kv}} -%}
{{ record | tojson }}
