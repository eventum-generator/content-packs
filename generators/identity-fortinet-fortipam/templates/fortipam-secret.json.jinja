{%- set previous = shared.get('previous_time') -%}
{%- set event_time = timestamp if previous is none or timestamp > previous else previous + module.datetime.timedelta(seconds=1) -%}
{%- do shared.set('previous_time', event_time) -%}
{%- set tick = (shared.get('tick', -1) + 1) % (params.anomaly_interval_events + 4) -%}
{%- do shared.set('tick', tick) -%}
{%- set chain = params.anomaly_mode and tick >= params.anomaly_interval_events -%}
{%- set step = tick - params.anomaly_interval_events if chain else -1 -%}
{%- if chain -%}
  {%- set kind = 'secret_request' if step == 0 else 'clear_text_view' -%}
  {%- set user_name = params.target_user -%}
  {%- set secret_id = params.target_secret_id -%}
  {%- set secret = params.target_secret -%}
  {%- set account = params.target_account -%}
  {%- set target = params.target_ip -%}
{%- else -%}
  {%- set kind = module.rand.weighted_choice(['secret_request', 'clear_text_view'], [30, 70]) -%}
  {%- set user_name = module.rand.choice(['admin-one', 'admin-two', 'helpdesk']) -%}
  {%- set asset = module.rand.choice([(101, 'lab-vault', 'labuser', '10.20.30.21'), (102, 'web-admin', 'webadmin', '10.20.30.22'), (103, 'db-reader', 'dbreader', '10.20.30.23')]) -%}
  {%- set secret_id = asset[0] -%}
  {%- set secret = asset[1] -%}
  {%- set account = asset[2] -%}
  {%- set target = asset[3] -%}
{%- endif -%}
{%- set event_ns = (event_time.timestamp() | int) * 1000000000 -%}
{%- set date = event_time.strftime('%Y-%m-%d') -%}
{%- set time = event_time.strftime('%H:%M:%S') -%}
{%- set event_uuid = module.rand.crypto.uuid4() -%}
{%- if kind == 'secret_request' -%}
  {%- set logid = '2304064604' -%}
  {%- set raw = 'date=' ~ date ~ ' time=' ~ time
    ~ ' devname="' ~ params.device_name ~ '" devid="' ~ params.device_name ~ '"'
    ~ ' eventtime=' ~ event_ns ~ ' tz="+0000" logid="' ~ logid ~ '"'
    ~ ' type="secret" subtype="secret-request" eventtype="secret-request"'
    ~ ' action="pass" operation="request" secretid=' ~ secret_id
    ~ ' secret="' ~ secret ~ '" account="' ~ account ~ '" uuid="' ~ event_uuid ~ '"'
    ~ ' user="' ~ user_name ~ '" starttime="' ~ date ~ ' ' ~ time ~ '"'
    ~ ' expirytime="' ~ (event_time + module.datetime.timedelta(minutes=30)).strftime('%Y-%m-%d %H:%M:%S') ~ '"'
    ~ ' msg="Created secret request."' -%}
{%- else -%}
  {%- set logid = '2303064603' -%}
  {%- set raw = 'date=' ~ date ~ ' time=' ~ time ~ ' eventtime=' ~ event_ns
    ~ ' tz="+0000" logid="' ~ logid ~ '" type="secret" subtype="clear-text"'
    ~ ' eventtype="clear-text" action="resp" agent="GUI" operation="clear-text-view"'
    ~ ' secretid=' ~ secret_id ~ ' secret="' ~ secret ~ '" account="' ~ account ~ '"'
    ~ ' target="' ~ target ~ '" folder="admin" uuid="' ~ event_uuid ~ '"'
    ~ ' user="' ~ user_name ~ '" msg="Clear text view allowed."' -%}
{%- endif -%}
{%- set record = {'@timestamp': event_time.isoformat(),
  'ecs': {'version': '8.17.0'},
  'event': {'kind': 'event', 'dataset': 'fortinet.fortipam',
    'category': ['iam'], 'type': ['info'], 'code': logid,
    'action': kind, 'original': raw},
  'host': {'name': params.device_name}, 'user': {'name': user_name},
  'related': {'user': [user_name]},
  'fortinet': {'fortipam': {'secret_id': secret_id, 'secret_name': secret,
    'account': account, 'target': target if kind == 'clear_text_view' else none,
    'uuid': event_uuid}}} -%}
{{ record | tojson }}
