{#- One F5 BIG-IP AFM (11.3) message per one-second tick at most, in
    the ArcSight CEF format: Network Event (23003137) records for
    accepted, opened, closed and dropped traffic, and Network DoS
    Event records for attack start, samples and stop. Background is a
    superposition of independent per-client random processes; the
    anomaly episode only adds records for one client and never touches
    the background queue. -#}
{%- set now = timestamp.timestamp() | int -%}
{%- set utc = module.datetime.timezone.utc -%}
{%- set interval = params.anomaly_interval_hours | float -%}
{%- set within = 3600 -%}
{%- set dos_names = ['TCP SYN Flood', 'UDP Flood', 'ICMPv4 Flood', 'Bad TCP checksum',
    'TCP RST Flood', 'Single Endpoint Flood', 'Single Endpoint Sweep', 'IP Fragment Overlap',
    'DNS Response Flood', 'LAND Attack'] -%}
{%- set dos_weights = [26, 18, 14, 10, 8, 7, 6, 5, 4, 2] -%}

{#- Background load by UTC hour (7-19 busy, 19-23 evening, night). -#}
{%- macro load_at(h) -%}
{{- (1.35 if 7 <= h < 19 else (0.9 if 19 <= h < 23 else 0.45)) / 0.975 -}}
{%- endmacro -%}

{#- Draw an episode start in [a, b): 10-minute slots weighted by the
    background load curve (sq: curve^2 + 0.05, curve max 1), uniform
    within a slot. -#}
{%- macro draw_start(a, b, sq) -%}
  {%- set base = (a // 600) * 600 -%}
  {%- set lows = [] -%}{%- set highs = [] -%}{%- set ws = [] -%}
  {%- for i in range((b - base) // 600 + 1) -%}
    {%- set lo = [a, base + i * 600] | max -%}
    {%- set hi = [b, base + (i + 1) * 600] | min -%}
    {%- if hi > lo -%}
      {%- set c = (load_at(((base + i * 600) % 86400) // 3600) | float) * 0.975 / 1.35 -%}
      {%- do lows.append(lo) -%}{%- do highs.append(hi) -%}
      {%- do ws.append((hi - lo) * (c * c + 0.05 if sq else c)) -%}
    {%- endif -%}
  {%- endfor -%}
  {%- set j = module.rand.weighted_choice(range(ws | length) | list, ws) -%}
  {%- do shared.set('start_at',
      module.rand.number.integer(lows[j], highs[j] - 1)) -%}
{%- endmacro -%}

{%- if not shared.get('initialized', false) -%}
  {%- if not (2 <= interval <= 8760) -%}{{ module.math.sqrt(-1) }}{%- endif -%}
  {%- if params.client_count < 20 or params.client_count > 500 -%}{{ module.math.sqrt(-1) }}{%- endif -%}
  {%- set clients = [] -%}
  {%- set weights = [] -%}
  {%- set seen = [] -%}
  {%- for n in range(params.client_count * 4) -%}
    {%- if clients | length < params.client_count -%}
      {%- set ip = module.rand.weighted_choice(['198.51.100.', '192.0.2.'], [60, 40])
          ~ module.rand.number.integer(1, 254) -%}
      {%- if ip not in seen -%}
        {%- do seen.append(ip) -%}
        {%- do clients.append(ip) -%}
        {%- do weights.append(module.rand.number.lognormal(0, 1.0)) -%}
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}
  {%- set servers = params.virtual_servers -%}
  {%- set addresses = [] -%}
  {%- set addr_w = {} -%}
  {%- for vs in servers -%}
    {%- set checked = module.ipaddress.IPv4Address(vs.address) -%}
    {%- if vs.logging not in ['rule', 'flow'] or vs.protocol not in ['TCP', 'UDP'] -%}
      {{ module.math.sqrt(-1) }}
    {%- endif -%}
    {%- if vs.address not in addresses -%}
      {%- do addresses.append(vs.address) -%}
    {%- endif -%}
    {%- do addr_w.update({vs.address: addr_w.get(vs.address, 0) + vs.weight}) -%}
  {%- endfor -%}
  {%- set addr_weights = [] -%}
  {%- for ip in addresses -%}{%- do addr_weights.append(addr_w[ip]) -%}{%- endfor -%}
  {%- if addresses | length < 2 -%}{{ module.math.sqrt(-1) }}{%- endif -%}
  {%- do shared.update({'initialized': true, 'clients': clients, 'weights': weights,
      'addresses': addresses, 'addr_weights': addr_weights,
      'vs_weights': servers | map(attribute='weight') | list,
      'q': [], 'm': {}, 'start_at': none,
      'last_client': none, 'last_address': none}) -%}
  {#- First episode inside the first min(interval, 24 h), its time of
      day drawn from the background load curve. -#}
  {%- if params.anomaly_mode -%}
    {{- draw_start(now, now + ([interval, 24] | min * 3600) | int, false) -}}
  {%- endif -%}
{%- endif -%}
{%- set q = shared.get('q') -%}
{%- set mstate = shared.get('m') -%}
{%- set servers = params.virtual_servers -%}
{%- set hour = timestamp.astimezone(utc).hour -%}
{%- set load = load_at(hour) | float -%}

{%- macro gap(median, sigma) -%}
{{- [(module.rand.number.lognormal(module.math.log(median), sigma)) | round | int, 1] | max -}}
{%- endmacro -%}

{#- Queue one allowed connection to a virtual server; the Accept or
    Open record is due at `at`. A flow-logging virtual server queues
    its Closed record when the Open is emitted. -#}
{%- macro open_conn(client, vs, at, episode=false) -%}
  {%- if vs.port == 53 -%}
    {%- set dur = 0 -%}
  {%- elif vs.port == 80 -%}
    {%- set dur = gap(6, 1.3) | int -%}
  {%- elif vs.port == 25 -%}
    {%- set dur = gap(4, 1.0) | int -%}
  {%- else -%}
    {%- set dur = gap(1500, 1.2) | int -%}
  {%- endif -%}
  {%- do q.append({'due': at, 'kind': 'start', 'episode': episode,
      's': {'client': client, 'vs': vs, 'dur': dur}}) -%}
{%- endmacro -%}

{%- macro deny(client, address, port, at, episode=false) -%}
  {%- do q.append({'due': at, 'kind': 'deny', 'episode': episode,
      's': {'client': client, 'address': address, 'port': port}}) -%}
{%- endmacro -%}

{#- Dropped attempts on several closed ports of one public address,
    then optionally an allowed connection to a virtual server on that
    address. The same law serves background and the episode. -#}
{%- macro probe_burst(client, address, ports, follow, episode=false) -%}
  {%- set t = namespace(v=now) -%}
  {%- for port in ports -%}
    {%- if not loop.first -%}{%- set t.v = t.v + gap(20, 1.1) | int -%}{%- endif -%}
    {%- for a in range(module.rand.weighted_choice([1, 2, 3], [55, 32, 13])) -%}
      {%- if not loop.first -%}{%- set t.v = t.v + gap(3, 0.7) | int -%}{%- endif -%}
      {{- deny(client, address, port, t.v, episode) -}}
    {%- endfor -%}
  {%- endfor -%}
  {%- if follow -%}
    {%- set here = servers | selectattr('address', 'equalto', address) | list -%}
    {{- open_conn(client, module.rand.weighted_choice(here, here | map(attribute='weight') | list),
        t.v + gap(90, 1.0) | int, episode) -}}
  {%- endif -%}
{%- endmacro -%}

{#- 1. Background arrivals, independent Poisson streams. -#}
{%- set clients = shared.get('clients') -%}
{%- set weights = shared.get('weights') -%}
{%- if module.rand.chance(0.055 * load) -%}
  {%- set c = module.rand.weighted_choice(clients, weights) -%}
  {%- set vs = module.rand.weighted_choice(servers, shared.get('vs_weights')) -%}
  {%- set t = namespace(v=now) -%}
  {%- for n in range(module.rand.weighted_choice([1, 2, 3, 4], [62, 22, 10, 6])) -%}
    {%- if not loop.first -%}{%- set t.v = t.v + gap(15, 1.4) | int -%}{%- endif -%}
    {{- open_conn(c, vs, t.v) -}}
  {%- endfor -%}
{%- endif -%}
{%- if module.rand.chance(0.0055) -%}
  {#- Internet background noise: a client hitting closed ports of a
      public address - a scanner, a misconfigured tool, a user trying
      another protocol - sometimes followed by ordinary use. -#}
  {%- set c = module.rand.weighted_choice(clients, weights) -%}
  {%- set a = module.rand.weighted_choice(shared.get('addresses'), shared.get('addr_weights')) -%}
  {%- set k = module.rand.weighted_choice([1, 2, 3, 4, 5], [50, 24, 14, 8, 4]) -%}
  {{- probe_burst(c, a, module.rand.shuffle(params.closed_ports | list)[:k], module.rand.chance(0.5)) -}}
{%- endif -%}
{%- if module.rand.chance(1 / 7200) -%}
  {#- Network DoS attack lifecycle: Started, dropped samples, Stopped. -#}
  {%- set c = module.rand.weighted_choice(clients, weights) -%}
  {%- set vs = module.rand.weighted_choice(servers, shared.get('vs_weights')) -%}
  {%- set name = module.rand.weighted_choice(dos_names, dos_weights) -%}
  {%- set aid = module.rand.number.integer(1000000000, 4294967295) -%}
  {%- set t = namespace(v=now) -%}
  {%- do q.append({'due': t.v, 'kind': 'dos', 'episode': false,
      's': {'status': 'Attack Started', 'id': aid, 'name': name}}) -%}
  {%- for n in range(module.rand.weighted_choice([1, 2, 3, 4, 5, 6, 8, 12], [18, 18, 16, 14, 11, 9, 8, 6])) -%}
    {%- set t.v = t.v + gap(40, 1.1) | int -%}
    {%- do q.append({'due': t.v, 'kind': 'dos', 'episode': false,
        's': {'status': 'Attack Sampled', 'id': aid, 'name': name, 'client': c, 'vs': vs,
        'spt': module.rand.number.integer(1024, 65535)}}) -%}
  {%- endfor -%}
  {%- do q.append({'due': t.v + gap(60, 1.0) | int, 'kind': 'dos', 'episode': false,
      's': {'status': 'Attack Stopped', 'id': aid, 'name': name}}) -%}
{%- endif -%}

{#- 2. Episode: the next start is drawn in a window of
    w = min(interval / 4, 6 h) centred on due = this start + interval,
    weighted by the load curve squared plus a floor. -#}
{%- if params.anomaly_mode and now >= shared.get('start_at') -%}
  {%- set pool = namespace(c=[], w=[]) -%}
  {%- for ip in clients -%}
    {%- if ip != shared.get('last_client') -%}
      {%- do pool.c.append(ip) -%}{%- do pool.w.append(weights[loop.index0]) -%}
    {%- endif -%}
  {%- endfor -%}
  {%- set c = module.rand.weighted_choice(pool.c, pool.w) -%}
  {%- set apool = namespace(a=[], w=[]) -%}
  {%- for ip in shared.get('addresses') -%}
    {%- if ip != shared.get('last_address') -%}
      {%- do apool.a.append(ip) -%}{%- do apool.w.append(shared.get('addr_weights')[loop.index0]) -%}
    {%- endif -%}
  {%- endfor -%}
  {%- set a = module.rand.weighted_choice(apool.a, apool.w) -%}
  {%- set k = module.rand.weighted_choice([3, 4, 5], [58, 28, 14]) -%}
  {{- probe_burst(c, a, module.rand.shuffle(params.closed_ports | list)[:k], true, true) -}}
  {%- do shared.update({'last_client': c, 'last_address': a}) -%}
  {%- set due = now + (interval * 3600) | int -%}
  {%- set half = ([interval / 4, 6] | min * 1800) | int -%}
  {{- draw_start(due - half, due + half, true) -}}
{%- endif -%}

{#- 3. Emit the earliest due record, otherwise nothing. -#}
{%- set pick = namespace(i=-1, due=now + 1) -%}
{%- for e in q -%}
  {%- if e.due <= now and e.due < pick.due -%}
    {%- set pick.i = loop.index0 -%}{%- set pick.due = e.due -%}
  {%- endif -%}
{%- endfor -%}
{%- if pick.i < 0 -%}{{ dispatch.drop() }}{%- endif -%}
{%- set e = q.pop(pick.i) -%}
{%- set s = e.s -%}
{%- set kind = e.kind -%}

{#- Guard on the final chain step over every binding: an Accept/Open
    completes a chain when its client was dropped on three or more
    distinct ports of that address in the preceding `within` s (no cap,
    no reset). A background allowed connection that would complete one
    is not made; episode records never are dropped. -#}
{%- if kind == 'deny' -%}
  {%- set hk = s.client ~ '>' ~ s.address -%}
  {%- set recent = mstate.get(hk, []) | selectattr('0', 'ge', now - within) | list -%}
  {%- do recent.append([now, s.port]) -%}
  {%- do mstate.update({hk: recent}) -%}
{%- elif kind == 'start' -%}
  {%- set hk = s.client ~ '>' ~ s.vs.address -%}
  {%- set recent = mstate.get(hk, []) | selectattr('0', 'ge', now - within) | list -%}
  {%- do mstate.update({hk: recent}) -%}
  {%- if not e.episode and recent | map(attribute='1') | unique | list | length >= 3 -%}
    {{ dispatch.drop() }}
  {%- endif -%}
  {#- Source port not in use by an open flow of the same client to the
      same virtual server (a live 4-tuple is never reused). -#}
  {%- set busy = q | selectattr('kind', 'equalto', 'close')
      | map(attribute='s') | selectattr('client', 'equalto', s.client)
      | map(attribute='spt') | list -%}
  {%- set sp = namespace(v=module.rand.number.integer(1024, 65535)) -%}
  {%- for i in range(8) -%}
    {%- if sp.v in busy -%}{%- set sp.v = module.rand.number.integer(1024, 65535) -%}{%- endif -%}
  {%- endfor -%}
  {%- do s.update({'spt': sp.v}) -%}
  {%- if s.vs.logging == 'flow' -%}
    {%- do q.append({'due': now + s.dur, 'kind': 'close', 'episode': e.episode, 's': s}) -%}
  {%- endif -%}
{%- endif -%}

{#- 4. The CEF message, key order as in the External Monitoring
    Implementations 13.0.0 AFM and Network DoS examples. -#}
{%- set rt = module.datetime.datetime.fromtimestamp(now, utc) -%}
{%- set rt_text = rt.strftime('%b %d %Y %H:%M:%S') -%}
{%- set head = 'CEF:0|F5|Advanced Firewall Module|' ~ params.product_version ~ '|' -%}
{%- set rd = params.route_domain | string -%}
{%- if kind == 'dos' -%}
  {%- set sampled = s.status == 'Attack Sampled' -%}
  {%- set act = 'Drop' if sampled else 'None' -%}
  {%- set src_ip = s.client if sampled else none -%}
  {%- set dst_ip = s.vs.address if sampled else none -%}
  {%- set src_port = s.spt if sampled else none -%}
  {%- set dst_port = s.vs.port if sampled else none -%}
  {%- set vlan = params.vlan if sampled else '' -%}
  {%- set vname = s.vs.name if sampled else '' -%}
  {%- set proto = s.vs.protocol if sampled else none -%}
  {%- set raw = head ~ s.name ~ '|' ~ act ~ '|8|dvchost=' ~ params.bigip_host
    ~ ' dvc=' ~ params.bigip_management_ip ~ ' rt=' ~ rt_text ~ ' act=' ~ act
    ~ ' cn1=' ~ s.id ~ ' cn1Label=attack_id cs1=' ~ s.status ~ ' cs1Label=attack_status'
    ~ ' src=' ~ (src_ip or '') ~ ' spt=' ~ (src_port or '') ~ ' dst=' ~ (dst_ip or '')
    ~ ' dpt=' ~ (dst_port or '') ~ ' cs2=' ~ vlan ~ ' cs2Label=vlan'
    ~ ' cs3=' ~ vname ~ ' cs3Label=virtual_name cn4=' ~ rd ~ ' cn4Label=route_domain'
    ~ ' c6a2= c6a2Label=source_address c6a3= c6a3Label=destination_address' -%}
  {%- set afm = {'attack_id': s.id | string, 'attack_status': s.status,
      'attack_name': s.name, 'action': act, 'route_domain': params.route_domain} -%}
  {%- if sampled -%}{%- do afm.update({'vlan': vlan, 'virtual_name': vname}) -%}{%- endif -%}
  {%- set event = {'kind': 'event',
      'category': ['network', 'intrusion_detection'],
      'type': ['start'] if s.status == 'Attack Started' else (['denied'] if sampled else ['end']),
      'action': s.status | lower | replace(' ', '_'), 'code': '23003138'} -%}
  {%- set rule_name = none -%}
{%- else -%}
  {%- if kind == 'deny' -%}
    {%- set act = 'Drop' -%}
    {%- set src_ip = s.client -%}{%- set dst_ip = s.address -%}{%- set dst_port = s.port -%}
    {%- set src_port = module.rand.number.integer(1024, 65535) -%}
    {%- set proto = 'TCP' -%}
    {%- set vname = '' -%}{%- set vlabel = 'Global' -%}
    {%- set drop_reason = 'Policy' -%}{%- set rule_name = params.deny_rule -%}
  {%- else -%}
    {%- set act = ('Accept' if s.vs.logging == 'rule' else 'Open') if kind == 'start' else 'Closed' -%}
    {%- set src_ip = s.client -%}{%- set dst_ip = s.vs.address -%}{%- set dst_port = s.vs.port -%}
    {%- set src_port = s.spt -%}{%- set proto = s.vs.protocol -%}
    {%- set vname = s.vs.name -%}{%- set vlabel = 'virtual_name' -%}
    {%- set drop_reason = '' -%}{%- set rule_name = s.vs.rule if act == 'Accept' else '' -%}
  {%- endif -%}
  {%- set vlan = params.vlan -%}
  {%- set raw = head ~ '23003137|Network Event|8|rt=' ~ rt_text ~ ' dvchost=' ~ params.bigip_host
    ~ ' dvc=' ~ params.bigip_management_ip ~ ' src=' ~ src_ip ~ ' spt=' ~ src_port
    ~ ' dst=' ~ dst_ip ~ ' dpt=' ~ dst_port ~ ' proto=' ~ proto
    ~ ' cs1=' ~ vname ~ ' cs1Label=' ~ vlabel ~ ' cs2=' ~ vlan ~ ' cs2Label=vlan act=' ~ act
    ~ ' c6a2= c6a2Label=source_address c6a3= c6a3Label=destination_address'
    ~ ' cs3=' ~ drop_reason ~ ' cs3Label=drop_reason cn4=' ~ rd ~ ' cn4Label=route_domain'
    ~ ' cs5=' ~ rule_name ~ ' cs5Label=acl_rule_name' -%}
  {%- set afm = {'action': act, 'vlan': vlan, 'route_domain': params.route_domain,
      'drop_reason': drop_reason, 'acl_rule_name': rule_name} -%}
  {%- if vname -%}{%- do afm.update({'virtual_name': vname}) -%}{%- else -%}{%- do afm.update({'context_type': 'Global'}) -%}{%- endif -%}
  {%- set event = {'kind': 'event', 'category': ['network'],
      'type': {'Accept': ['connection', 'allowed'], 'Open': ['connection', 'start'],
        'Closed': ['connection', 'end'], 'Drop': ['connection', 'denied']}[act],
      'action': act | lower, 'code': '23003137'} -%}
{%- endif -%}
{%- do event.update({'severity': 8, 'original': raw}) -%}

{#- 5. ECS document. -#}
{%- set related = [] -%}
{%- set record = {'@timestamp': rt.isoformat(), 'ecs': {'version': '8.17.0'},
  'event': event,
  'observer': {'name': params.bigip_host, 'ip': [params.bigip_management_ip],
    'vendor': 'F5', 'product': 'Advanced Firewall Module', 'type': 'firewall',
    'version': params.product_version}} -%}
{%- if src_ip -%}
  {%- do record.update({'source': {'ip': src_ip, 'port': src_port},
      'destination': {'ip': dst_ip, 'port': dst_port},
      'network': {'transport': proto | lower, 'type': 'ipv4'}}) -%}
  {%- do related.extend([src_ip, dst_ip]) -%}
{%- endif -%}
{%- do related.append(params.bigip_management_ip) -%}
{%- do record.update({'related': {'ip': related}}) -%}
{%- if rule_name -%}{%- do record.update({'rule': {'name': rule_name}}) -%}{%- endif -%}
{%- do record.update({'f5': {'afm': afm}}) -%}
{{ record | tojson }}
