{%- set step = vars.step -%}
{%- set probe = step.startswith('probe_') -%}
{%- if step == 'routine_a' -%}
  {%- do shared.pop('to_probe', none) -%}
  {%- set count = shared.get('routine_count', 0) + 1 -%}
  {%- if count >= params.anomaly_interval_events -%}
    {%- do shared.set('routine_count', 0) -%}
    {%- if params.anomaly_mode -%}{%- do shared.set('to_probe', true) -%}{%- endif -%}
  {%- else -%}{%- do shared.set('routine_count', count) -%}{%- endif -%}
{%- endif -%}
{%- set denied = probe and step != 'probe_https' or (not probe and module.rand.chance(0.18)) -%}
{%- set source_ip = params.probe_source_ip if probe else '10.40.1.' ~ module.rand.number.integer(10, 180) -%}
{%- set destination_ip = params.probe_destination_ip if probe else '10.40.20.' ~ module.rand.number.integer(20, 180) -%}
{%- set destination_port = 22 if step == 'probe_ssh' else (445 if step == 'probe_smb' else (3389 if step == 'probe_rdp' else (443 if step == 'probe_https' else module.rand.choice([53, 80, 443, 8443])))) -%}
{%- set source_port = module.rand.number.integer(40000, 60000) -%}
{%- set connection_id = shared.get('connection_id', 100000) + 1 -%}
{%- do shared.set('connection_id', connection_id) -%}
{%- set duration = 0 if denied else module.rand.number.integer(0, 15) -%}
{%- set sent_pkts = 0 if denied else module.rand.number.integer(2, 16) -%}
{%- set recv_pkts = 0 if denied else module.rand.number.integer(1, 20) -%}
{%- set sent_bytes = 0 if denied else sent_pkts * module.rand.number.integer(70, 900) -%}
{%- set recv_bytes = 0 if denied else recv_pkts * module.rand.number.integer(90, 1100) -%}
{%- set rule_id = 0 if denied else 5 -%}
{%- set code = '010102600002' if denied else '010101600001' -%}
{%- set subtype = 'Denied' if denied else 'Allowed' -%}
{%- set status = 'Deny' if denied else 'Allow' -%}
{%- set raw = 'device="SFW" date=' ~ timestamp.strftime('%Y-%m-%d') ~ ' time=' ~ timestamp.strftime('%H:%M:%S') ~ ' timezone="UTC" device_name="' ~ params.device_name ~ '" device_id=' ~ params.device_id ~ ' log_id=' ~ code ~ ' log_type="Firewall" log_component="Firewall Rule" log_subtype="' ~ subtype ~ '" status="' ~ status ~ '" priority=Information duration=' ~ duration ~ ' fw_rule_id=' ~ rule_id ~ ' policy_type=1 user_name="" user_gp="" iap=0 ips_policy_id=0 appfilter_policy_id=0 in_interface="Port2" out_interface="Port1" src_ip=' ~ source_ip ~ ' dst_ip=' ~ destination_ip ~ ' protocol="TCP" src_port=' ~ source_port ~ ' dst_port=' ~ destination_port ~ ' sent_pkts=' ~ sent_pkts ~ ' recv_pkts=' ~ recv_pkts ~ ' sent_bytes=' ~ sent_bytes ~ ' recv_bytes=' ~ recv_bytes ~ ' srczonetype="LAN" srczone="LAN" dstzonetype="LAN" dstzone="LAN" connid="' ~ ('' if denied else connection_id|string) ~ '" hb_health="No Heartbeat" message="" appresolvedby="Signature" app_is_cloud=0 log_occurrence=1' -%}
{%- set native = {'device':'SFW','date':timestamp.strftime('%Y-%m-%d'),'time':timestamp.strftime('%H:%M:%S'),'timezone':'UTC','device_name':params.device_name,'device_id':params.device_id,'log_id':code,'log_type':'Firewall','log_component':'Firewall Rule','log_subtype':subtype,'status':status,'priority':'Information','duration':duration,'fw_rule_id':rule_id,'policy_type':1,'user_name':'','user_gp':'','iap':0,'ips_policy_id':0,'appfilter_policy_id':0,'in_interface':'Port2','out_interface':'Port1','src_ip':source_ip,'dst_ip':destination_ip,'protocol':'TCP','src_port':source_port,'dst_port':destination_port,'sent_pkts':sent_pkts,'recv_pkts':recv_pkts,'sent_bytes':sent_bytes,'recv_bytes':recv_bytes,'srczonetype':'LAN','srczone':'LAN','dstzonetype':'LAN','dstzone':'LAN','connid':'' if denied else connection_id|string,'hb_health':'No Heartbeat','message':'','appresolvedby':'Signature','app_is_cloud':0,'log_occurrence':1} -%}

{%- set source_mac = '02:40:01:00:00:%02x' % (source_ip.split('.')[-1]|int) -%}
{%- set destination_mac = '02:40:20:00:00:%02x' % (destination_ip.split('.')[-1]|int) -%}
{%- do native.update({'src_mac':source_mac,'dst_mac':destination_mac,'src_country_code':'R1','dst_country_code':'R1','application':'','application_risk':0,'application_technology':'','application_category':'','tran_src_ip':'','tran_src_port':0,'tran_dst_ip':'','tran_dst_port':0,'dir_disp':'','vconnid':''}) -%}
{%- set raw = raw ~ ' src_mac=' ~ source_mac ~ ' dst_mac=' ~ destination_mac ~ ' src_country_code=R1 dst_country_code=R1 application="" application_risk=0 application_technology="" application_category="" tran_src_ip= tran_src_port=0 tran_dst_ip= tran_dst_port=0 dir_disp="" vconnid=""' -%}

{%- set out = {'@timestamp':timestamp.isoformat(),'ecs':{'version':'8.17.0'},'event':{'action':'firewall-deny' if denied else 'firewall-allow','category':['network'],'code':code,'dataset':'sophos_firewall.log','kind':'event','original':raw,'type':['denied'] if denied else ['allowed']},'host':{'name':params.device_name,'id':params.device_id},'source':{'ip':source_ip,'port':source_port},'destination':{'ip':destination_ip,'port':destination_port},'network':{'transport':'tcp'},'related':{'ip':[source_ip,destination_ip]},'sophos':{'firewall':native}} -%}
{{- out | tojson -}}
