{%- set step = vars.step -%}
{%- if step == 'routine' -%}
  {%- do shared.pop('to_attack', none) -%}
  {%- set n = shared.get('routine_count', 0) + 1 -%}
  {%- if n >= params.anomaly_interval_events -%}
    {%- do shared.set('routine_count', 0) -%}
    {%- if params.anomaly_mode -%}{%- do shared.set('to_attack', true) -%}{%- endif -%}
  {%- else -%}{%- do shared.set('routine_count', n) -%}{%- endif -%}
{%- endif -%}
{%- set attack = step != 'routine' -%}
{%- set blocked = step.startswith('blocked') or (not attack and module.rand.chance(0.07)) -%}
{%- set src = params.attack_source_ip if attack else '10.60.1.' ~ module.rand.number.integer(10, 150) -%}
{%- set uri = ('/admin/export' if step == 'passed' else ('/admin/export' if step == 'blocked_1' else '/admin/export')) if attack else module.rand.choice(['/','/health','/products','/api/search']) -%}
{%- set support_id = 18205860747014045000 + ((shared.get('support_counter', 18205860747014045000) - 18205860747014045000) % 1000000000) + 1 -%}{%- do shared.set('support_counter',support_id) -%}
{%- set source_port = module.rand.number.integer(40000, 60000) -%}
{%- set signature = '200021069' if blocked else 'Successful Request' -%}
{%- set name = 'Automated client access "wget"' if blocked else 'Successful Request' -%}
{%- set severity = 5 if blocked else 2 -%}
{%- set status = 'blocked' if blocked else 'passed' -%}
{%- set user_agent = 'Wget/1.21' if blocked else 'Mozilla/5.0' -%}
{%- set full_request = 'GET ' ~ uri ~ ' HTTP/1.1\\r\\nHost: app.corp.example\\r\\nUser-Agent: ' ~ user_agent ~ '\\r\\n\\r\\n' -%}
{%- set fields = {'dvchost':params.device_name,'dvc':params.device_ip,'cs1':params.policy_name,'cs1Label':'policy_name','cs2':params.policy_class,'cs2Label':'http_class_name','externalId':support_id,'act':status,'cn1':0 if blocked else 200,'cn1Label':'response_code','src':src,'spt':source_port,'dst':params.virtual_server_ip,'dpt':443,'requestMethod':'GET','app':'HTTPS','deviceCustomDate1':'Sep 01 2026 00:00:00','deviceCustomDate1Label':'policy_apply_date','cs5':'N/A','cs5Label':'x_forwarded_for_header_value','rt':timestamp.strftime('%b %d %Y %H:%M:%S'),'deviceExternalId':0,'cs4':'Non-browser Client' if blocked else 'N/A','cs4Label':'attack_type','cs6':'N/A','cs6Label':'geo_location','c6a1':'','c6a1Label':'device_address','c6a2':'','c6a2Label':'source_address','c6a3':'','c6a3Label':'destination_address','c6a4':'N/A','c6a4Label':'ip_address_intelligence','msg':'N/A','suid':module.rand.string.hex(16),'suser':'N/A','request':uri,'cs3Label':'full_request','cs3':full_request} -%}
{%- set parts = [] -%}{%- for key,value in fields.items() -%}{%- do parts.append(key ~ '=' ~ value|string) -%}{%- endfor -%}
{%- set raw = ('<131>' if blocked else '<134>') ~ timestamp.strftime('%b %d %H:%M:%S') ~ ' ' ~ params.device_name ~ ' ASM:CEF:0|F5|ASM|' ~ params.device_version ~ '|' ~ signature ~ '|' ~ name ~ '|' ~ severity ~ '|' ~ parts|join(' ') -%}
{%- set out = {'@timestamp':timestamp.isoformat(),'ecs':{'version':'8.17.0'},'event':{'action':'request-blocked' if blocked else 'request-passed','category':['web'],'code':signature,'dataset':'f5.asm','kind':'alert' if blocked else 'event','original':raw,'outcome':'failure' if blocked else 'success','type':['denied'] if blocked else ['allowed']},'host':{'name':params.device_name,'ip':[params.device_ip]},'source':{'ip':src,'port':source_port},'destination':{'ip':params.virtual_server_ip,'port':443},'http':{'request':{'method':'GET'},'response':{'status_code':0 if blocked else 200}},'url':{'path':uri.split('?')[0]},'related':{'ip':[src,params.virtual_server_ip]},'f5':{'asm':{'policy_name':params.policy_name,'http_class_name':params.policy_class,'support_id':support_id,'request_status':status,'attack_type':'Non-browser Client' if blocked else None}}} -%}
{{- out | tojson -}}
