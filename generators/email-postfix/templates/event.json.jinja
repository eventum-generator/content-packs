{#- Postfix 3.8.3+ submission relay: smtpd, cleanup, qmgr and smtp
    records of authenticated SMTP submissions. The input sets the rate
    and the hour-of-day curve; every timestamp becomes exactly one
    record. A timestamp takes the earliest due record of a session in
    progress (a retried AUTH, cleanup, queue activation, a delivery, the
    queue removal, a resend after a rejected recipient); when none is
    due it starts a new submission by a staff mail client ('staff' tag)
    or an application ('app' tag), or the anomaly episode once due. -#}
{#- Jinja has no raise statement: a missing-key lookup aborts the render
    with the message as the key. -#}
{%- macro invalid(message) -%}
  {%- do module.operator.getitem({}, message) -%}
{%- endmacro -%}
{%- macro delay_text(microseconds) -%}
  {%- set seconds = microseconds // 1000000 -%}
  {%- set resolution = 10000 if seconds == 0 else 100000 if seconds < 10 else 1000000 -%}
  {%- set rounded = ((microseconds + resolution // 2) // resolution) * resolution -%}
  {%- set seconds = rounded // 1000000 -%}
  {%- set fraction = ('%06d' % (rounded % 1000000)).rstrip('0') -%}
  {{- seconds -}}{%- if fraction -%}.{{- fraction -}}{%- endif -%}
{%- endmacro -%}
{%- set num = module.rand.number -%}
{%- set rand = module.rand -%}
{%- set hq = module.heapq -%}
{%- set utc = timestamp.astimezone(module.datetime.timezone.utc) -%}
{%- set now = utc.timestamp() -%}
{%- set sec = now | int -%}
{#- Chain window: three SASL failures and an authenticated submission
    of one user and client IP, counted from the first failure. -#}
{%- set window = 120 -%}
{#- UTC hour-of-day load of staff submissions relative to the peak hour.
    It repeats patterns/staff-*.yml (uniform floor plus a beta(6.5, 6)
    working-day curve) and weights episode start times. -#}
{%- set hourly = [0.06, 0.06, 0.063, 0.076, 0.109, 0.173, 0.272, 0.406, 0.563, 0.723, 0.864,
    0.962, 1.0, 0.971, 0.878, 0.738, 0.572, 0.407, 0.265, 0.162, 0.099, 0.07, 0.061, 0.06] -%}
{#- A start time in [lo, lo + width), drawn by rejection with weight
    curve^2 + 0.05. -#}
{%- macro draw_start(lo, width) -%}
  {%- set pick = namespace(t=lo + (module.rand.number.floating(0, width) | int)) -%}
  {%- for _ in range(500) -%}
    {%- set c = hourly[(pick.t // 3600) % 24] -%}
    {%- if module.rand.number.floating(0, 1) < (c * c + 0.05) / 1.05 -%}{%- break -%}{%- endif -%}
    {%- set pick.t = lo + (module.rand.number.floating(0, width) | int) -%}
  {%- endfor -%}
  {{- pick.t -}}
{%- endmacro -%}
{%- if shared.get('q') is none -%}
  {%- set ipv4 = '(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])(\\.(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])){3}' -%}
  {%- set name = '[A-Za-z0-9][A-Za-z0-9.-]{0,252}' -%}
  {%- set address = '[A-Za-z0-9._+-]{1,64}@[A-Za-z0-9.-]{1,35}' -%}
  {%- if params.anomaly_mode is not boolean -%}
    {{- invalid('anomaly_mode must be a boolean') -}}
  {%- endif -%}
  {%- if params.anomaly_interval_hours is not number or params.anomaly_interval_hours is boolean
      or not 1 <= params.anomaly_interval_hours <= 8760 -%}
    {{- invalid('anomaly_interval_hours must be a number in 1..8760') -}}
  {%- endif -%}
  {%- if params.mail_host is not string or not module.re.fullmatch(name, params.mail_host) -%}
    {{- invalid('mail_host must be an ASCII hostname') -}}
  {%- endif -%}
  {%- if params.mail_ip is not string or not module.re.fullmatch(ipv4, params.mail_ip) -%}
    {{- invalid('mail_ip must be a dotted-quad IPv4 address') -}}
  {%- endif -%}
  {#- Senders: staff mail clients (one workstation or VPN laptop each)
      and applications. A staff member's share of submissions is fixed
      for the run within 0.45..2.2 of the median, so every user sends
      mail every working day. -#}
  {%- set staff = [] -%}
  {%- set apps = [] -%}
  {%- for src, out, kind in [[samples.users, staff, 'staff'], [samples.senders, apps, 'app']] -%}
    {%- for row in src -%}
      {%- if not module.re.fullmatch(address, row.user) or not module.re.fullmatch(ipv4, row.ip)
          or not module.re.fullmatch(name, row.client) -%}
        {{- invalid('users.json and senders.json rows need user, ip and client') -}}
      {%- endif -%}
      {%- set weight = num.clamp(module.math.exp(num.gauss(0, 0.45)), 0.45, 2.2) if kind == 'staff' else row.share -%}
      {%- do out.append({'u': row.user, 'ip': row.ip, 'client': row.client,
          'helo': row.helo if kind == 'staff' else row.client, 'kind': kind, 'w': weight,
          'key': row.user ~ '|' ~ row.ip}) -%}
    {%- endfor -%}
  {%- endfor -%}
  {%- if staff | length < 4 or apps | length < 1 or staff | length + apps | length > 2000 -%}
    {{- invalid('users.json needs at least 4 rows, senders.json at least 1') -}}
  {%- endif -%}
  {%- if samples.recipients | length < 5 or samples.unknown_recipients | length < 1 -%}
    {{- invalid('recipients.json needs at least 5 rows, unknown_recipients.json at least 1') -}}
  {%- endif -%}
  {%- set cum = {'staff': [], 'app': []} -%}
  {%- for kind, rows in [['staff', staff], ['app', apps]] -%}
    {%- set acc = namespace(v=0) -%}
    {%- for a in rows -%}
      {%- set acc.v = acc.v + a.w -%}
      {%- do cum[kind].append(acc.v) -%}
    {%- endfor -%}
  {%- endfor -%}
  {#- Episode users: the busier half of the staff. -#}
  {%- set median = (staff | map(attribute='w') | sort | list)[staff | length // 2] -%}
  {%- set eligible = staff | selectattr('w', 'ge', median) | list -%}
  {%- set interval = (params.anomaly_interval_hours * 3600) | int -%}
  {%- do shared.update({'q': [], 'seq': 0, 'staff': staff, 'apps': apps, 'cum': cum,
      'eligible': eligible,
      'recipients': samples.recipients | map('list') | list,
      'unknown': samples.unknown_recipients | map(attribute='email') | list,
      'procs': {'smtpd': [], 'cleanup': [], 'smtp': []},
      'pid_next': num.integer(18000, 60000), 'qmgr_pid': num.integer(900, 3000),
      'fails': {}, 'guard_fires': 0,
      'ep_start': draw_start(sec, [interval, 86400] | min) | int, 'ep_last': none}) -%}
{%- endif -%}
{%- set q = shared.get('q') -%}
{%- set procs = shared.get('procs') -%}
{%- set fails = shared.get('fails') -%}
{#- A Postfix service process for one job: an idle process of that
    service when one exists (idle processes exit after max_idle = 100 s,
    and after max_use = 100 jobs), otherwise a newly spawned one with the
    next process ID. The process is appended to 'out'. A process
    released with a future time stays busy until then. -#}
{%- macro acquire(svc, t, out) -%}
  {%- set pool = procs[svc] -%}
  {%- set idle = [] -%}
  {%- for p in pool | list -%}
    {%- if not p.busy and t - p.last > 100 -%}
      {%- do pool.remove(p) -%}
    {%- elif not p.busy and p.last <= t -%}
      {%- do idle.append(p) -%}
    {%- endif -%}
  {%- endfor -%}
  {%- if idle -%}
    {%- set p = module.rand.choice(idle) -%}
  {%- else -%}
    {%- set p = {'pid': shared.get('pid_next'), 'busy': false, 'last': t, 'uses': 0} -%}
    {%- set nxt = shared.get('pid_next') + module.rand.number.integer(1, 9) -%}
    {%- do shared.set('pid_next', nxt if nxt < 4194304 else module.rand.number.integer(300, 1000)) -%}
    {%- do pool.append(p) -%}
  {%- endif -%}
  {%- do p.update({'busy': true, 'uses': p.uses + 1}) -%}
  {%- do out.append(p) -%}
{%- endmacro -%}
{%- macro release(svc, p, t) -%}
  {%- do p.update({'busy': false, 'last': t}) -%}
  {%- if p.uses >= 100 and p in procs[svc] -%}{%- do procs[svc].remove(p) -%}{%- endif -%}
{%- endmacro -%}
{%- macro push(due, step) -%}
  {%- do shared.set('seq', shared.get('seq') + 1) -%}
  {%- do module.heapq.heappush(q, [due, shared.get('seq'), step]) -%}
{%- endmacro -%}
{#- Pause between two AUTH attempts of one session: a person retyping a
    password, or an application's retry backoff. -#}
{%- macro retry_gap(actor) -%}
  {%- if actor.kind == 'staff' -%}
    {{- module.rand.number.clamp(module.math.exp(module.rand.number.gauss(module.math.log(12), 0.5)), 4, 60) -}}
  {%- else -%}
    {{- module.rand.number.floating(5, 20) -}}
  {%- endif -%}
{%- endmacro -%}
{#- ---------------------------------------------------------------- pick -#}
{%- set ns = namespace(step=none) -%}
{%- if q and q[0][0] <= now -%}
  {%- set ns.step = hq.heappop(q)[2] -%}
{%- elif params.anomaly_mode and sec >= shared.get('ep_start') -%}
  {#- Anomaly episode: a busy staff user other than the previous
      episode's, from the user's own client address, fails SASL LOGIN
      three times, then authenticates and submits a message for five
      recipients. The next episode is due one interval after this
      start, in a window of a quarter interval (at most 6 h) around the
      due time, weighted towards busy hours. -#}
  {%- set eligible = shared.get('eligible') -%}
  {%- set pick = namespace(a=rand.choice(eligible)) -%}
  {%- for _ in range(50) -%}
    {%- if pick.a.u != shared.get('ep_last') and num.floating(0, 2.2) < pick.a.w -%}{%- break -%}{%- endif -%}
    {%- set pick.a = rand.choice(eligible) -%}
  {%- endfor -%}
  {%- set interval = (params.anomaly_interval_hours * 3600) | int -%}
  {%- set width = [interval // 4, 21600] | min -%}
  {%- do shared.update({'ep_last': pick.a.u,
      'ep_start': draw_start(sec + interval - width // 2, width) | int}) -%}
  {#- The user's own retry pace, redrawn until the four attempts fit in
      100 s. -#}
  {%- set gaps = namespace(v=[]) -%}
  {%- for _ in range(100) -%}
    {%- set gaps.v = [retry_gap(pick.a) | float, retry_gap(pick.a) | float, retry_gap(pick.a) | float] -%}
    {%- if gaps.v | sum <= 100 -%}{%- break -%}{%- endif -%}
  {%- endfor -%}
  {%- set ns.step = {'k': 'auth', 's': {'a': pick.a, 'fl': 3, 'fin': 'ok', 'ep': true, 'n': 5, 'new': true, 'gaps': gaps.v}} -%}
{%- else -%}
  {%- set kind = 'staff' if 'staff' in tags else 'app' -%}
  {%- set rows = shared.get('staff') if kind == 'staff' else shared.get('apps') -%}
  {%- set cum = shared.get('cum')[kind] -%}
  {%- set i = module.bisect.bisect_right(cum, num.floating(0, cum[-1])) -%}
  {%- set actor = rows[[i, rows | length - 1] | min] -%}
  {%- set r = num.floating(0, 1) -%}
  {%- if kind == 'staff' -%}
    {#- Staff: 3% of submissions start with a mistyped or outdated
        password (one failure 65%, two 25%, three 10%); after one or two
        failures the user usually gets it right, after three the user
        gives up. 4% address an unknown local recipient. -#}
    {%- if r < 0.03 -%}
      {%- set k = rand.weighted_choice([1, 2, 3], [65, 25, 10]) -%}
      {%- set fin = 'ok' if k < 3 and num.floating(0, 1) < 0.92 else 'quit' -%}
      {%- set ns.step = {'k': 'auth', 's': {'a': actor, 'fl': k, 'fin': fin, 'ep': false, 'new': true}} -%}
    {%- elif r < 0.07 -%}
      {%- set ns.step = {'k': 'reject', 's': {'a': actor, 'new': true}} -%}
    {%- else -%}
      {%- set ns.step = {'k': 'auth', 's': {'a': actor, 'fl': 0, 'fin': 'ok', 'ep': false, 'new': true}} -%}
    {%- endif -%}
  {%- else -%}
    {#- Applications: a rare single failure (a credential refreshed a
        moment late) retried after a short backoff; rare rejects. -#}
    {%- if r < 0.004 -%}
      {%- set ns.step = {'k': 'auth', 's': {'a': actor, 'fl': 1, 'fin': 'ok', 'ep': false, 'new': true}} -%}
    {%- elif r < 0.007 -%}
      {%- set ns.step = {'k': 'reject', 's': {'a': actor, 'new': true}} -%}
    {%- else -%}
      {%- set ns.step = {'k': 'auth', 's': {'a': actor, 'fl': 0, 'fin': 'ok', 'ep': false, 'new': true}} -%}
    {%- endif -%}
  {%- endif -%}
{%- endif -%}
{%- set step = ns.step -%}
{%- set s = step.s -%}
{%- if step.k == 'start' -%}
  {#- A resend after a rejected recipient: a new authenticated session. -#}
  {%- set s = {'a': s.a, 'fl': 0, 'fin': 'ok', 'ep': false, 'new': true} -%}
  {%- set step = {'k': 'auth', 's': s} -%}
{%- endif -%}
{%- if s.get('new') -%}
  {%- set held = [] -%}
  {%- do acquire('smtpd', now, held) -%}
  {%- do s.update({'new': false, 'p': held[0]}) -%}
{%- endif -%}
{%- set a = s.a -%}
{#- --------------------------------------------------------------- record -#}
{%- set out_ns = namespace(service='smtpd', pid=0, action='queue-created', outcome='success',
    category=['email'], type=['info'], level='info', msg='', queue='', auth=false,
    email=none, recipient_count=none, message_id=none) -%}
{%- if step.k == 'auth' -%}
  {%- set out_ns.pid = s.p.pid -%}
  {%- set out_ns.auth = true -%}
  {%- set hist = fails.get(a.key, []) -%}
  {%- set guarded = s.fl == 0 and not s.ep and hist | length >= 3 and sec - hist[-3] <= window -%}
  {%- if guarded -%}{%- do shared.set('guard_fires', shared.get('guard_fires') + 1) -%}{%- endif -%}
  {%- if s.fl > 0 or guarded -%}
    {%- set out_ns.action = 'sasl-auth-failed' -%}
    {%- set out_ns.outcome = 'failure' -%}
    {%- set out_ns.category = ['authentication', 'email'] -%}
    {%- set out_ns.type = ['denied'] -%}
    {%- set out_ns.level = 'warning' -%}
    {%- set out_ns.msg = 'warning: ' ~ a.client ~ '[' ~ a.ip ~ ']: SASL LOGIN authentication failed: authentication failure, sasl_username=' ~ a.u -%}
    {%- do fails.update({a.key: (hist + [sec])[-3:]}) -%}
    {%- if guarded -%}
      {%- do s.update({'fl': 0, 'fin': 'quit'}) -%}
    {%- else -%}
      {%- do s.update({'fl': s.fl - 1}) -%}
    {%- endif -%}
    {%- if s.fl > 0 or s.fin == 'ok' -%}
      {%- do push(now + (s.gaps.pop(0) if s.get('gaps') else retry_gap(a) | float), {'k': 'auth', 's': s}) -%}
    {%- else -%}
      {%- do release('smtpd', s.p, now) -%}
    {%- endif -%}
  {%- else -%}
    {#- Authenticated: the first accepted RCPT creates the queue file.
        Short queue ID: five hex digits of the creation microseconds
        and the queue file inode number in hex. -#}
    {%- set qid = ('%05X' % utc.microsecond) ~ ('%X' % num.integer(65536, 1048575)) -%}
    {%- if a.kind == 'staff' -%}
      {%- set size = num.clamp(num.lognormal(11.0, 1.3), 800, 10240000) | int -%}
      {%- set n = s.get('n') or rand.weighted_choice([1, 2, 3, 4, 5], [68, 16, 8, 4, 4]) -%}
    {%- else -%}
      {%- set size = num.clamp(num.lognormal(8.9, 0.8), 600, 2000000) | int -%}
      {%- set n = rand.weighted_choice([1, 2, 5], [88, 10, 2]) -%}
    {%- endif -%}
    {%- do s.update({'qid': qid, 'created': now, 'arrival': now - num.floating(0.005, 0.05),
        'size': size, 'n': n, 'data': size / num.floating(1000000, 8000000)}) -%}
    {%- set out_ns.queue = qid -%}
    {%- set out_ns.msg = qid ~ ': client=' ~ a.client ~ '[' ~ a.ip ~ '], sasl_method=LOGIN, sasl_username=' ~ a.u -%}
    {%- do push(now + num.floating(0.02, 0.3), {'k': 'cleanup', 's': s}) -%}
  {%- endif -%}
{%- elif step.k == 'reject' -%}
  {%- set to = rand.choice(shared.get('unknown')) -%}
  {%- set out_ns.pid = s.p.pid -%}
  {%- set out_ns.auth = true -%}
  {%- set out_ns.action = 'smtp-reject' -%}
  {%- set out_ns.outcome = 'failure' -%}
  {%- set out_ns.type = ['denied'] -%}
  {%- set out_ns.email = {'from': {'address': [a.u]}, 'to': {'address': [to]}} -%}
  {%- set out_ns.msg = 'NOQUEUE: reject: RCPT from ' ~ a.client ~ '[' ~ a.ip ~ ']: 550 5.1.1 <' ~ to ~ '>: Recipient address rejected: User unknown; from=<' ~ a.u ~ '> to=<' ~ to ~ '> proto=ESMTP helo=<' ~ a.helo ~ '> sasl_username=<' ~ a.u ~ '>' -%}
  {%- do release('smtpd', s.p, now) -%}
  {#- Most staff users correct the address and send again a minute or
      so later. -#}
  {%- if a.kind == 'staff' and num.floating(0, 1) < 0.75 -%}
    {%- do push(now + num.clamp(module.math.exp(num.gauss(module.math.log(60), 0.6)), 15, 400),
        {'k': 'start', 's': {'a': a}}) -%}
  {%- endif -%}
{%- elif step.k == 'cleanup' -%}
  {%- set held = [] -%}
  {%- do acquire('cleanup', now, held) -%}
  {%- set out_ns.service = 'cleanup' -%}
  {%- set out_ns.pid = held[0].pid -%}
  {%- set out_ns.action = 'message-cleanup' -%}
  {%- set out_ns.queue = s.qid -%}
  {#- The client's message has no Message-ID; cleanup adds one from the
      queue file creation time. -#}
  {%- set out_ns.message_id = '<' ~ module.datetime.datetime.fromtimestamp(s.created | int, module.datetime.timezone.utc).strftime('%Y%m%d%H%M%S') ~ '.' ~ s.qid ~ '@' ~ params.mail_host ~ '>' -%}
  {%- set out_ns.msg = s.qid ~ ': message-id=' ~ out_ns.message_id -%}
  {%- set done = [now, s.created + s.data] | max -%}
  {%- do release('cleanup', held[0], done) -%}
  {%- do release('smtpd', s.p, done) -%}
  {%- do push(done + num.floating(0.01, 0.2), {'k': 'qmgr', 's': s}) -%}
{%- elif step.k == 'qmgr' -%}
  {%- set out_ns.service = 'qmgr' -%}
  {%- set out_ns.pid = shared.get('qmgr_pid') -%}
  {%- set out_ns.action = 'queue-active' -%}
  {%- set out_ns.queue = s.qid -%}
  {%- set out_ns.recipient_count = s.n -%}
  {%- set out_ns.email = {'from': {'address': [a.u]}} -%}
  {%- set out_ns.msg = s.qid ~ ': from=<' ~ a.u ~ '>, size=' ~ s.size ~ ', nrcpt=' ~ s.n ~ ' (queue active)' -%}
  {%- do s.update({'active': now, 'left': s.n}) -%}
  {#- One smtp delivery agent per recipient (single-recipient transport):
      connection setup and size-dependent transmission time. -#}
  {%- for row in module.random.sample(shared.get('recipients'), s.n) -%}
    {%- set held = [] -%}
    {%- do acquire('smtp', now, held) -%}
    {%- set conn = num.clamp(num.exponential(12.5), 0.01, 0.35) -%}
    {%- set xmit = [s.size / num.floating(500000, 2000000) + 0.04, 0.05] | max -%}
    {%- do push(now + num.floating(0, 0.05) + conn + xmit,
        {'k': 'smtp', 's': s, 'p': held[0], 'to': row, 'c': conn, 'd': xmit}) -%}
  {%- endfor -%}
{%- elif step.k == 'smtp' -%}
  {%- set out_ns.service = 'smtp' -%}
  {%- set out_ns.pid = step.p.pid -%}
  {%- set out_ns.action = 'delivery-sent' -%}
  {%- set out_ns.queue = s.qid -%}
  {%- set out_ns.email = {'to': {'address': [step.to[0]]}} -%}
  {#- delay: arrival to delivery; delays: arrival to active queue, active
      wait, connection setup, transmission. Setup and transmission are
      scaled down if the record came sooner than they add up to. -#}
  {%- set avail = now - s.active -%}
  {%- set scale = [1, avail * 0.98 / (step.c + step.d)] | min -%}
  {%- set c_us = (step.c * scale * 1000000) | int -%}
  {%- set d_us = (step.d * scale * 1000000) | int -%}
  {%- set total_us = ((now - s.arrival) * 1000000) | int -%}
  {%- set a_us = ((s.active - s.arrival) * 1000000) | int -%}
  {%- set b_us = [((avail * 1000000) | int) - c_us - d_us, 0] | max -%}
  {%- set out_ns.msg = s.qid ~ ': to=<' ~ step.to[0] ~ '>, relay=' ~ step.to[1] ~ '[' ~ step.to[2] ~ ']:25, delay=' ~ delay_text(total_us) ~ ', delays=' ~ delay_text(a_us) ~ '/' ~ delay_text(b_us) ~ '/' ~ delay_text(c_us) ~ '/' ~ delay_text(d_us) ~ ', dsn=2.0.0, status=sent (250 2.0.0 Ok)' -%}
  {%- do release('smtp', step.p, now) -%}
  {%- do s.update({'left': s.left - 1}) -%}
  {%- if s.left == 0 -%}
    {%- do push(now + num.floating(0.001, 0.05), {'k': 'removed', 's': s}) -%}
  {%- endif -%}
{%- else -%}
  {%- set out_ns.service = 'qmgr' -%}
  {%- set out_ns.pid = shared.get('qmgr_pid') -%}
  {%- set out_ns.action = 'queue-removed' -%}
  {%- set out_ns.type = ['end'] -%}
  {%- set out_ns.queue = s.qid -%}
  {%- set out_ns.msg = s.qid ~ ': removed' -%}
{%- endif -%}
{%- set service = out_ns.service -%}
{%- set original = utc.strftime('%b %e %H:%M:%S') ~ ' ' ~ params.mail_host ~ ' postfix/' ~ service ~ '[' ~ out_ns.pid ~ ']: ' ~ out_ns.msg -%}
{%- set out = {'@timestamp': utc.replace(microsecond=0).isoformat(), 'ecs': {'version': '8.17.0'},
    'event': {'action': out_ns.action, 'category': out_ns.category, 'dataset': 'postfix.syslog',
      'kind': 'event', 'original': original, 'outcome': out_ns.outcome, 'type': out_ns.type},
    'host': {'name': params.mail_host, 'ip': [params.mail_ip]},
    'log': {'level': out_ns.level, 'syslog': {'appname': 'postfix/' ~ service}},
    'message': out_ns.msg,
    'observer': {'hostname': params.mail_host, 'ip': params.mail_ip, 'product': 'Postfix', 'type': 'mail', 'vendor': 'Postfix'},
    'postfix': {'service': service},
    'process': {'name': 'postfix/' ~ service, 'pid': out_ns.pid},
    'related': {'hosts': [params.mail_host]},
    'tags': ['postfix', 'preserve_original_event']} -%}
{%- if out_ns.queue -%}{%- do out.postfix.update({'queue_id': out_ns.queue}) -%}{%- endif -%}
{%- if out_ns.message_id -%}{%- do out.postfix.update({'message_id': out_ns.message_id}) -%}{%- endif -%}
{%- if out_ns.recipient_count -%}{%- do out.postfix.update({'recipient_count': out_ns.recipient_count}) -%}{%- endif -%}
{%- if out_ns.auth -%}
  {%- do out.update({'source': {'ip': a.ip}, 'user': {'name': a.u}}) -%}
  {%- do out.postfix.update({'sasl': {'username': a.u}}) -%}
  {%- do out.related.update({'ip': [a.ip], 'user': [a.u]}) -%}
{%- endif -%}
{%- if out_ns.email -%}{%- do out.update({'email': out_ns.email}) -%}{%- endif -%}
{{- out | tojson -}}
