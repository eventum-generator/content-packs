{#- Cisco IOS remote TCP syslog, as the Elastic Cisco IOS integration
    stores it. One input tick per second; each tick emits the earliest due
    record at the tick time plus a random millisecond, or drops.
    Independent background processes: business flows, odd-port denies,
    internet probes on EDGE_FILTER, per-pair retries to restricted
    management servers, per-administrator SSH sessions (typos, give-ups,
    configuration, temporary ACL permits and their removal), a config
    backup poller and interface flaps. Times are epoch seconds. -#}
{%- set ts = timestamp.astimezone(module.datetime.timezone.utc) -%}
{%- set now = module.builtins.int(ts.timestamp()) -%}
{%- if shared.get('queue') is not none and now < shared.get('next_due') and not (params.anomaly_mode and now >= shared.get('ep_due')) -%}{{- dispatch.drop() -}}{%- endif -%}
{%- set hq = module.heapq -%}
{#- Chain window: a denied flow to a restricted server on 443, three
    failed logins, a successful login and a configuration change from the
    same address, then a permitted flow from it to that server. -#}
{%- set window = 1800 -%}
{%- set hour = 3600 -%}
{%- macro ln(med, sig) -%}
  {{- [module.builtins.int(module.rand.number.lognormal(module.math.log(med), sig)), 1] | max -}}
{%- endmacro -%}
{%- macro ex(mean) -%}
  {{- [module.builtins.int(module.rand.number.exponential(1.0 / mean)), 1] | max -}}
{%- endmacro -%}
{%- macro push(due, item) -%}
  {%- set s = shared.get('seq') + 1 -%}
  {%- do shared.set('seq', s) -%}
  {%- do module.heapq.heappush(shared.get('queue'), [due, s, item]) -%}
{%- endmacro -%}
{%- macro pick_start(lo, span) -%}
  {#- Time in [lo, lo + span) with its UTC hour weighted by the admin
      activity curve squared plus a small floor. -#}
  {%- set curve = shared.get('curve') -%}
  {%- set top = (curve | max) ** 2 + 0.02 -%}
  {%- set r = namespace(v=lo + module.rand.number.integer(0, span - 1), ok=false) -%}
  {%- for _ in range(500) if not r.ok -%}
    {%- set c = lo + module.rand.number.integer(0, span - 1) -%}
    {%- if module.rand.number.floating(0, top) < curve[(c // hour) % 24] ** 2 + 0.02 -%}
      {%- set r.v = c -%}
      {%- set r.ok = true -%}
    {%- endif -%}
  {%- endfor -%}
  {{- r.v -}}
{%- endmacro -%}
{%- macro free_seq() -%}
  {#- Random free ACE sequence number ahead of the logged deny 100. -#}
  {%- set used = shared.get('resv') | map(attribute='seq') | list -%}
  {{- module.rand.choice(range(41, 100) | reject('in', used) | list) -}}
{%- endmacro -%}
{%- macro session(ai, t0, nf, ok, act, pi, seq, test, ep, cap) -%}
  {#- Queue one SSH session of account ai: nf failed attempts, then a
      success (or a give-up), then the action: none (show commands are
      not logged), generic configuration, a temporary permit of pair pi
      with ACE seq, or removal of that ACE. Episodes pass ep, a leading
      denied flow of the pair and a cap on the whole span. -#}
  {%- set g = namespace(v=[], ok=false) -%}
  {%- set ncmd = module.rand.weighted_choice([1, 2, 3], [50, 35, 15]) if act == 'cfg' else 2 -%}
  {%- for _ in range(60) if not g.ok -%}
    {%- set g.v = [ln(90, 0.8) | int if ep else 0] -%}
    {%- for _ in range(nf) -%}{%- do g.v.append(ln(7, 0.8) | int) -%}{%- endfor -%}
    {%- for _ in range(ncmd) -%}{%- do g.v.append(ln(15, 0.9) | int) -%}{%- endfor -%}
    {%- do g.v.append(ln(25, 0.8) | int) -%}
    {%- do g.v.append(ln(45, 0.9) | int) -%}
    {%- set g.ok = cap == 0 or (g.v | sum) <= cap -%}
  {%- endfor -%}
  {%- set acct = shared.get('accts')[ai] -%}
  {%- set vty = module.rand.weighted_choice([0, 1, 2, 3, 4], [45, 25, 15, 10, 5]) -%}
  {%- set t = namespace(v=t0, i=0) -%}
  {%- if ep -%}
    {%- set p = shared.get('pairs')[pi] -%}
    {{- push(t.v, {'k': 'row', 'kind': 'flow', 'src': p.c, 'dst': p.s, 'dport': 443, 'acl': params.acl_name, 'ep': true}) -}}
  {%- endif -%}
  {%- set t.v = t.v + g.v[0] -%}
  {%- for _ in range(nf) -%}
    {{- push(t.v, {'k': 'row', 'kind': 'fail', 'a': ai}) -}}
    {%- set t.i = t.i + 1 -%}
    {%- set t.v = t.v + g.v[t.i] -%}
  {%- endfor -%}
  {%- if ok -%}
    {{- push(t.v, {'k': 'row', 'kind': 'succ', 'a': ai}) -}}
    {%- if act != 'none' -%}
      {%- set cmds = [] -%}
      {%- if act == 'cfg' -%}
        {%- for c in range(ncmd) -%}
          {%- do cmds.append([module.rand.choice(['interface GigabitEthernet0/' ~ module.rand.number.integer(1, 3), 'description uplink dist-sw-0' ~ module.rand.number.integer(1, 4), 'ntp server 10.30.0.5', 'logging buffered 64000', 'snmp-server location DC1 row ' ~ module.rand.number.integer(1, 9), 'ip route 10.60.0.0 255.255.0.0 10.30.0.254', 'ip access-list extended EDGE_FILTER', 'no ip http server']), none]) -%}
        {%- endfor -%}
      {%- else -%}
        {%- set p = shared.get('pairs')[pi] -%}
        {%- do cmds.append(['ip access-list extended ' ~ params.acl_name, none]) -%}
        {%- if act == 'permit' -%}
          {%- do cmds.append([seq ~ ' permit tcp host ' ~ p.c ~ ' host ' ~ p.s ~ ' eq 443 log', ['open', pi, seq]]) -%}
        {%- else -%}
          {%- do cmds.append(['no ' ~ seq, ['close', pi, seq]]) -%}
        {%- endif -%}
      {%- endif -%}
      {%- for c in cmds -%}
        {%- set t.i = t.i + 1 -%}
        {%- set t.v = t.v + g.v[t.i] -%}
        {{- push(t.v, {'k': 'row', 'kind': 'cmd', 'a': ai, 'cmd': c[0], 'eff': c[1]}) -}}
      {%- endfor -%}
      {%- if act == 'permit' -%}
        {{- push(t.v + (ln(2700, 0.9) | int), {'k': 'rm', 'p': pi, 'seq': seq}) -}}
      {%- endif -%}
      {%- set t.v = t.v + g.v[-2] -%}
      {{- push(t.v, {'k': 'row', 'kind': 'cfgi', 'a': ai, 'vty': vty}) -}}
      {%- if act == 'permit' and test -%}
        {%- set p = shared.get('pairs')[pi] -%}
        {{- push(t.v + g.v[-1], {'k': 'row', 'kind': 'flow', 'src': p.c, 'dst': p.s, 'dport': 443, 'acl': params.acl_name, 'ep': ep}) -}}
      {%- endif -%}
    {%- endif -%}
  {%- endif -%}
{%- endmacro -%}
{%- macro fails() -%}
  {{- module.rand.weighted_choice([0, 1, 2, 3, 4, 5], [820, 110, 45, 15, 7, 3]) -}}
{%- endmacro -%}
{%- if shared.get('queue') is none -%}
  {%- set schema = {'type': 'typed-dict', 'fields': {
    'router_ip': {'type': 'typed-dict-field', 'schema': {'type': 'str', 'min_length': 7}},
    'acl_name': {'type': 'typed-dict-field', 'schema': {'type': 'str', 'pattern': '^[A-Za-z][A-Za-z0-9_-]*$'}},
    'anomaly_mode': {'type': 'typed-dict-field', 'schema': {'type': 'bool', 'strict': true}},
    'anomaly_interval_hours': {'type': 'typed-dict-field', 'schema': {'type': 'float', 'ge': 4, 'le': 8760}}
  }} -%}
  {%- do module.pydantic_core.SchemaValidator(schema).validate_python(params) -%}
  {#- Admin activity by UTC hour (relative rate, peak 1). -#}
  {%- do shared.update({'queue': [], 'seq': 0, 'curve': [0.08, 0.06, 0.06, 0.08, 0.15, 0.35, 0.7, 0.95, 1.0, 1.0, 0.95, 0.9, 0.95, 1.0, 0.9, 0.7, 0.45, 0.3, 0.22, 0.18, 0.14, 0.12, 0.1, 0.09]}) -%}
  {%- set accts = [] -%}
  {%- set pairs = [] -%}
  {%- for row in samples.admins -%}
    {%- do accts.append({'user': row.user, 'ip': row.ip, 'w': row.weight}) -%}
    {%- do pairs.append({'c': row.ip, 's': row.target}) -%}
    {{- push(now + ex(2 * hour / row.weight) | int, {'k': 'adm', 'a': loop.index0}) -}}
  {%- endfor -%}
  {%- do accts.append({'user': 'oxidized', 'ip': '10.30.1.50', 'w': 0}) -%}
  {%- for row in samples.restricted -%}
    {%- do pairs.append({'c': row.client, 's': row.server}) -%}
  {%- endfor -%}
  {%- for p in pairs -%}
    {{- push(now + ex(1200) | int, {'k': 'retry', 'p': loop.index0}) -}}
  {%- endfor -%}
  {%- set cl = [] -%}
  {%- set clw = [] -%}
  {%- for row in samples.clients -%}{%- do cl.append(row.ip) -%}{%- do clw.append(row.weight) -%}{%- endfor -%}
  {%- for row in samples.admins -%}{%- do cl.append(row.ip) -%}{%- do clw.append(1.0) -%}{%- endfor -%}
  {%- set sv = [] -%}
  {%- set svw = [] -%}
  {%- for row in samples.services -%}{%- do sv.append([row.ip, row.port]) -%}{%- do svw.append(row.weight) -%}{%- endfor -%}
  {{- push(now + ex(6) | int, {'k': 'biz'}) -}}
  {{- push(now + ex(240) | int, {'k': 'odd'}) -}}
  {{- push(now + ex(75) | int, {'k': 'scan'}) -}}
  {{- push(now + ex(3600) | int, {'k': 'nms'}) -}}
  {{- push(now + ex(10 * hour) | int, {'k': 'flap'}) -}}
  {%- set interval = module.builtins.int(params.anomaly_interval_hours * hour) -%}
  {%- do shared.update({'accts': accts, 'pairs': pairs, 'cl': cl, 'clw': clw, 'sv': sv, 'svw': svw, 'resv': [], 'active': [], 'recent': [], 'mt': {}, 'msg_seq': module.rand.number.integer(100000, 2000000), 'peer': params.router_ip ~ ':' ~ module.rand.number.integer(20000, 60999), 'ep_last': none, 'ep_due': pick_start(now, [interval, 24 * hour] | min) | int}) -%}
{%- endif -%}
{%- set queue = shared.get('queue') -%}
{%- set accts = shared.get('accts') -%}
{%- set pairs = shared.get('pairs') -%}
{%- set curve = shared.get('curve') -%}
{%- set interval = module.builtins.int(params.anomaly_interval_hours * hour) -%}
{#- Episode: at the first tick at or after its drawn start, plus a
    lognormal delay, the workstation of an administrator other than the
    previous episode's (weighted like background sessions) tries its
    restricted server on 443 and is denied; the administrator's account
    then fails three to five times from that workstation, logs in, inserts
    a temporary permit for exactly that pair, the change is notified and
    the flow is permitted. Removal follows the background hold and is
    done by any administrator. The first start falls within the first
    min(interval, 24 h); each later one in a window of min(interval / 4,
    6 h) centred one interval after the actual start, both weighted by the
    admin curve squared. Missed episodes are not replayed. -#}
{%- if params.anomaly_mode and now >= shared.get('ep_due') -%}
  {%- set resv = shared.get('resv') | map(attribute='p') | list -%}
  {%- set cand = range(accts | length - 1) | reject('in', resv) | reject('equalto', shared.get('ep_last')) | list -%}
  {%- if not cand -%}{%- set cand = range(accts | length - 1) | reject('in', resv) | list -%}{%- endif -%}
  {%- if cand -%}
    {%- set wts = [] -%}
    {%- for i in cand -%}{%- do wts.append(accts[i].w) -%}{%- endfor -%}
    {%- set ai = module.rand.weighted_choice(cand, wts) -%}
    {%- set seq = free_seq() | int -%}
    {%- do shared.get('resv').append({'p': ai, 'seq': seq}) -%}
    {%- set start = now + (ln(60, 1.0) | int) -%}
    {%- set nf = module.rand.weighted_choice([3, 4, 5], [15, 7, 3]) -%}
    {{- session(ai, start, nf, true, 'permit', ai, seq, true, true, window - 300) -}}
    {%- set w = [interval // 4, 6 * hour] | min -%}
    {%- do shared.update({'ep_last': ai, 'ep_due': pick_start(start + interval - w // 2, w) | int}) -%}
  {%- else -%}
    {%- do shared.set('ep_due', now + 600) -%}
  {%- endif -%}
{%- endif -%}
{%- if now < queue[0][0] -%}
  {%- do shared.set('next_due', queue[0][0]) -%}
  {{- dispatch.drop() -}}
{%- endif -%}
{%- set out = namespace(row=none) -%}
{%- for _ in range(32) if out.row is none and queue and queue[0][0] <= now -%}
  {%- set top = hq.heappop(queue) -%}
  {%- set due = top[0] -%}
  {%- set item = top[2] -%}
  {%- set c = curve[(due // hour) % 24] -%}
  {%- if item.k == 'row' -%}
    {%- set out.row = item -%}
  {%- elif item.k == 'biz' -%}
    {#- Business connections to permitted services, with short bursts. -#}
    {{- push(due + ex(6) | int, item) -}}
    {%- if module.rand.chance(0.15 + 0.85 * c) -%}
      {%- set src = module.rand.weighted_choice(shared.get('cl'), shared.get('clw')) -%}
      {%- set svc = module.rand.weighted_choice(shared.get('sv'), shared.get('svw')) -%}
      {%- set t = namespace(v=due) -%}
      {%- for _ in range(module.rand.weighted_choice([1, 2, 3], [75, 18, 7])) -%}
        {{- push(t.v, {'k': 'row', 'kind': 'flow', 'src': src, 'dst': svc[0], 'dport': svc[1], 'acl': params.acl_name}) -}}
        {%- set t.v = t.v + (ln(3, 1.0) | int) -%}
      {%- endfor -%}
    {%- endif -%}
  {%- elif item.k == 'odd' -%}
    {{- push(due + ex(240) | int, item) -}}
    {%- if module.rand.chance(0.3 + 0.7 * c) -%}
      {{- push(due, {'k': 'row', 'kind': 'flow', 'src': module.rand.weighted_choice(shared.get('cl'), shared.get('clw')), 'dst': module.rand.choice(shared.get('sv'))[0], 'dport': module.rand.weighted_choice([23, 135, 139, 5985, 8080], [15, 25, 20, 25, 15]), 'acl': params.acl_name}) -}}
    {%- endif -%}
  {%- elif item.k == 'scan' -%}
    {#- Unsolicited internet TCP to the outside address, denied. -#}
    {{- push(due + ex(75) | int, item) -}}
    {%- set src = module.rand.choice(['198.51.100.', '203.0.113.']) ~ module.rand.number.integer(1, 254) -%}
    {%- set port = module.rand.weighted_choice([22, 23, 443, 445, 3389, 5060, 8080], [25, 20, 12, 15, 14, 6, 8]) -%}
    {%- set t = namespace(v=due) -%}
    {%- for _ in range(module.rand.weighted_choice([1, 2, 3, 4], [70, 16, 9, 5])) -%}
      {{- push(t.v, {'k': 'row', 'kind': 'flow', 'src': src, 'dst': '192.0.2.10', 'dport': port, 'acl': 'EDGE_FILTER'}) -}}
      {%- set t.v = t.v + (ln(2, 1.0) | int) -%}
    {%- endfor -%}
  {%- elif item.k == 'retry' -%}
    {#- A client application retrying a restricted management server. -#}
    {{- push(due + ex(1200) | int, item) -}}
    {%- if module.rand.chance(0.35 + 0.65 * c) -%}
      {%- set p = pairs[item.p] -%}
      {{- push(due, {'k': 'row', 'kind': 'flow', 'src': p.c, 'dst': p.s, 'dport': 443, 'acl': params.acl_name}) -}}
    {%- endif -%}
  {%- elif item.k == 'adm' -%}
    {#- Session arrival of one administrator, thinned by the curve. -#}
    {%- set acct = accts[item.a] -%}
    {{- push(due + ex(2 * hour / acct.w) | int, item) -}}
    {%- if module.rand.chance(c) -%}
      {%- set nf = fails() | int -%}
      {%- set ok = nf == 0 or module.rand.chance(0.9) -%}
      {%- set act = module.rand.weighted_choice(['none', 'cfg', 'permit'], [40, 35, 25]) if ok else 'none' -%}
      {%- set pi = none -%}
      {%- set seq = none -%}
      {%- if act == 'permit' -%}
        {%- set resv = shared.get('resv') | map(attribute='p') | list -%}
        {%- set free = range(pairs | length) | reject('in', resv) | list -%}
        {%- if item.a not in resv and module.rand.chance(0.5) -%}
          {%- set pi = item.a -%}
        {%- elif free -%}
          {%- set pi = module.rand.choice(free) -%}
        {%- endif -%}
        {%- if pi is none -%}
          {%- set act = 'cfg' -%}
        {%- else -%}
          {%- set seq = free_seq() | int -%}
          {%- do shared.get('resv').append({'p': pi, 'seq': seq}) -%}
        {%- endif -%}
      {%- endif -%}
      {{- session(item.a, due, nf, ok, act, pi, seq, module.rand.chance(0.7), false, 0) -}}
    {%- endif -%}
  {%- elif item.k == 'rm' -%}
    {#- Removal of a temporary permit by any administrator. -#}
    {%- set ws = accts[:-1] | map(attribute='w') | list -%}
    {%- set ai = module.rand.weighted_choice(range(ws | length) | list, ws) -%}
    {{- session(ai, due, fails() | int, true, 'remove', item.p, item.seq, false, false, 0) -}}
  {%- elif item.k == 'nms' -%}
    {#- Config backup poller; after a password change it gives up after
        three failed attempts on a poll. -#}
    {{- push(due + ex(3600) | int, item) -}}
    {%- set nf = 3 if module.rand.chance(0.12) else (1 if module.rand.chance(0.04) else 0) -%}
    {%- set t = namespace(v=due) -%}
    {%- for _ in range(nf) -%}
      {{- push(t.v, {'k': 'row', 'kind': 'fail', 'a': accts | length - 1}) -}}
      {%- set t.v = t.v + (ln(20, 0.5) | int) -%}
    {%- endfor -%}
    {%- if nf < 3 -%}{{- push(t.v, {'k': 'row', 'kind': 'succ', 'a': accts | length - 1}) -}}{%- endif -%}
  {%- elif item.k == 'flap' -%}
    {{- push(due + ex(10 * hour) | int, item) -}}
    {%- set ifc = 'GigabitEthernet0/' ~ module.rand.number.integer(1, 3) -%}
    {{- push(due, {'k': 'row', 'kind': 'line', 'ifc': ifc, 'up': false}) -}}
    {{- push(due + (ln(40, 1.0) | int), {'k': 'row', 'kind': 'line', 'ifc': ifc, 'up': true}) -}}
  {%- endif -%}
{%- endfor -%}
{%- do shared.set('next_due', queue[0][0] if queue else now + 1) -%}
{%- if out.row is none -%}{{- dispatch.drop() -}}{%- endif -%}
{%- set row = out.row -%}
{%- set kind = row.kind -%}
{%- set ms = module.rand.number.integer(0, 999) -%}
{%- set tf = now + ms / 1000 -%}
{%- set mt = shared.get('mt') -%}
{%- set tracked = accts[:-1] | map(attribute='ip') | list -%}
{%- set x = namespace(ip=none, cls=none, dst=none) -%}
{%- set ext = {} -%}
{%- set ios = {} -%}
{%- set ev_type = ['info'] -%}
{%- set action = none -%}
{%- if kind == 'flow' -%}
  {%- set src = row.src -%}
  {%- set dst = row.dst -%}
  {%- set dport = row.dport -%}
  {%- set acl = row.acl -%}
  {%- set active = shared.get('active') | selectattr('c', 'equalto', src) | selectattr('s', 'equalto', dst) | list -%}
  {%- set permitted = acl == params.acl_name and ((dport == 443 and active) or [dst, dport] in shared.get('sv')) -%}
  {#- Guard: a background permitted flow that would complete the chain
      for its source inside the window is not logged (the host did not
      connect); everything else keeps its time. -#}
  {%- if permitted and dport == 443 and src in tracked and not row.get('ep') -%}
    {%- for p in mt.get(src, []) if p[0] == 6 and p[2] == dst and tf - p[1] <= window -%}
      {{- dispatch.drop() -}}
    {%- endfor -%}
  {%- endif -%}
  {#- One first-packet record per ACL, action and five-tuple inside the
      five-minute log interval: a colliding source port is redrawn. -#}
  {%- set recent = shared.get('recent') | selectattr('t', 'gt', now - 300) | list -%}
  {%- set keys = recent | map(attribute='key') | list -%}
  {%- set sp = namespace(v=module.rand.number.integer(49152, 65535)) -%}
  {%- for _ in range(20) if (acl ~ permitted ~ src ~ sp.v ~ dst ~ dport) in keys -%}
    {%- set sp.v = module.rand.number.integer(49152, 65535) -%}
  {%- endfor -%}
  {%- do recent.append({'key': acl ~ permitted ~ src ~ sp.v ~ dst ~ dport, 't': now}) -%}
  {%- do shared.set('recent', recent[-512:]) -%}
  {%- set sport = sp.v -%}
  {%- set fac, sev, code = 'SEC', 6, 'IPACCESSLOGP' -%}
  {%- set msg = 'list ' ~ acl ~ ' ' ~ ('permitted' if permitted else 'denied') ~ ' tcp ' ~ src ~ '(' ~ sport ~ ') -> ' ~ dst ~ '(' ~ dport ~ '), 1 packet' -%}
  {%- set action = 'allow' if permitted else 'deny' -%}
  {%- set ev_type = ['info', 'allowed' if permitted else 'denied'] -%}
  {#- Community ID v1 (seed 0). -#}
  {%- set a1 = module.ipaddress.ip_address(src).packed -%}
  {%- set a2 = module.ipaddress.ip_address(dst).packed -%}
  {%- if a1 < a2 or (a1 == a2 and sport < dport) -%}
    {%- set blob = module.struct.pack('!H', 0) + a1 + a2 + module.struct.pack('!BBHH', 6, 0, sport, dport) -%}
  {%- else -%}
    {%- set blob = module.struct.pack('!H', 0) + a2 + a1 + module.struct.pack('!BBHH', 6, 0, dport, sport) -%}
  {%- endif -%}
  {%- set cid = '1:' ~ module.base64.b64encode(module.hashlib.sha1(blob).digest()).decode() -%}
  {%- do ios.update({'access_list': acl}) -%}
  {%- do ext.update({'source': {'address': src, 'ip': src, 'packets': 1, 'port': sport}, 'destination': {'address': dst, 'ip': dst, 'port': dport}, 'network': {'community_id': cid, 'packets': 1, 'transport': 'tcp', 'type': 'ipv4'}, 'related': {'ip': [src, dst]}}) -%}
  {%- set x.ip = src -%}
  {%- if acl == params.acl_name and dport == 443 -%}{%- set x.cls = 'allow443' if permitted else 'deny443' -%}{%- endif -%}
  {%- set x.dst = dst -%}
{%- elif kind in ['fail', 'succ'] -%}
  {%- set acct = accts[row.a] -%}
  {%- set bad = kind == 'fail' -%}
  {%- set fac, sev, code = 'SEC_LOGIN', 4 if bad else 5, 'LOGIN_FAILED' if bad else 'LOGIN_SUCCESS' -%}
  {%- set msg = ('Login failed' if bad else 'Login Success') ~ ' [user: ' ~ acct.user ~ '] [Source: ' ~ acct.ip ~ '] [localport: 22]' ~ (' [Reason: Login Authentication Failed]' if bad else '') ~ ' at ' ~ ts.strftime('%H:%M:%S UTC %a %b ') ~ ts.day ~ ts.strftime(' %Y') -%}
  {%- if not bad -%}
    {%- do ios.update({'action': 'Login'}) -%}
    {%- do ext.update({'destination': {'port': 22}, 'network': {'type': 'ipv4'}, 'related': {'ip': [acct.ip], 'user': [acct.user]}, 'source': {'address': acct.ip, 'ip': acct.ip, 'user': {'name': acct.user}}}) -%}
  {%- endif -%}
  {%- set x.ip = acct.ip -%}
  {%- set x.cls = kind -%}
{%- elif kind == 'cmd' -%}
  {%- set fac, sev, code = 'PARSER', 5, 'CFGLOG_LOGGEDCMD' -%}
  {%- set msg = 'User:' ~ accts[row.a].user ~ '  logged command:' ~ row.cmd -%}
  {%- if row.eff -%}
    {%- set p = pairs[row.eff[1]] -%}
    {%- if row.eff[0] == 'open' -%}
      {%- do shared.get('active').append({'c': p.c, 's': p.s, 'seq': row.eff[2]}) -%}
    {%- else -%}
      {%- do shared.set('active', shared.get('active') | rejectattr('seq', 'equalto', row.eff[2]) | list) -%}
      {%- do shared.set('resv', shared.get('resv') | rejectattr('seq', 'equalto', row.eff[2]) | list) -%}
    {%- endif -%}
  {%- endif -%}
{%- elif kind == 'cfgi' -%}
  {%- set acct = accts[row.a] -%}
  {%- set fac, sev, code = 'SYS', 5, 'CONFIG_I' -%}
  {%- set msg = 'Configured from console by ' ~ acct.user ~ ' on vty' ~ row.vty ~ ' (' ~ acct.ip ~ ')' -%}
  {%- set x.ip = acct.ip -%}
  {%- set x.cls = 'cfgi' -%}
{%- else -%}
  {%- set fac, sev, code = 'LINEPROTO', 5, 'UPDOWN' -%}
  {%- set msg = 'Line protocol on Interface ' ~ row.ifc ~ ', changed state to ' ~ ('up' if row.up else 'down') -%}
{%- endif -%}
{#- Chain tracker for administrator workstations, same semantics as a
    streaming ordered matcher keyed by address: every denied 443 flow
    opens a partial, rows advance partials in order, a partial older
    than the window is dropped, completion resets the address. -#}
{%- if x.ip in tracked -%}
  {%- set parts = mt.get(x.ip, []) | selectattr('1', 'ge', tf - window) | list -%}
  {%- set st = namespace(new=[], done=false) -%}
  {%- for p in parts if not st.done -%}
    {%- set need = ['deny443', 'fail', 'fail', 'fail', 'succ', 'cfgi', 'allow443'][p[0]] -%}
    {%- if x.cls == need and (p[0] < 6 or x.dst == p[2]) -%}
      {%- if p[0] == 6 -%}
        {%- set st.done = true -%}
      {%- else -%}
        {%- do st.new.append([p[0] + 1, p[1], p[2]]) -%}
      {%- endif -%}
    {%- else -%}
      {%- do st.new.append(p) -%}
    {%- endif -%}
  {%- endfor -%}
  {%- if st.done -%}
    {%- do mt.update({x.ip: []}) -%}
  {%- else -%}
    {%- if x.cls == 'deny443' -%}{%- do st.new.append([1, tf, x.dst]) -%}{%- endif -%}
    {%- do mt.update({x.ip: st.new[-8:]}) -%}
  {%- endif -%}
{%- endif -%}
{%- set mseq = shared.get('msg_seq') + 1 + module.rand.weighted_choice([0, 1, 2, 3, 5], [60, 20, 10, 6, 4]) -%}
{%- do shared.set('msg_seq', mseq) -%}
{%- set pri = 184 + sev -%}
{%- set frac = '.%03d' | format(ms) -%}
{%- set original = '<' ~ pri ~ '>' ~ mseq ~ ': ' ~ ts.strftime('%b ') ~ ('%2d' | format(ts.day)) ~ ts.strftime(' %Y %H:%M:%S') ~ frac ~ ': %' ~ fac ~ '-' ~ sev ~ '-' ~ code ~ ': ' ~ msg -%}
{%- set ingested = module.datetime.datetime.fromtimestamp(tf + module.rand.number.lognormal(module.math.log(1.5), 0.7), module.datetime.timezone.utc) -%}
{%- set event = {'agent_id_status': 'verified', 'category': ['network'], 'code': code, 'dataset': 'cisco_ios.log', 'ingested': ingested.strftime('%Y-%m-%dT%H:%M:%SZ'), 'original': original, 'provider': 'firewall', 'sequence': mseq, 'severity': sev, 'timezone': '+00:00', 'type': ev_type} -%}
{%- if action -%}{%- do event.update({'action': action}) -%}{%- endif -%}
{%- do ios.update({'facility': fac, 'message_count': mseq}) -%}
{%- set out = {
  '@timestamp': ts.strftime('%Y-%m-%dT%H:%M:%S') ~ frac ~ 'Z',
  'agent': {'ephemeral_id': '960a0fda-a7b7-4362-9018-34b1d0d119c4', 'id': 'f00ff835-626e-4a18-a8a2-0bb3ebb7503f', 'name': 'syslog-collector', 'type': 'filebeat', 'version': '8.17.0'},
  'cisco': {'ios': ios},
  'data_stream': {'dataset': 'cisco_ios.log', 'namespace': 'default', 'type': 'logs'},
  'ecs': {'version': '8.17.0'},
  'elastic_agent': {'id': 'f00ff835-626e-4a18-a8a2-0bb3ebb7503f', 'snapshot': false, 'version': '8.17.0'},
  'event': event,
  'input': {'type': 'tcp'},
  'log': {'level': 'warning' if sev == 4 else ('notification' if sev == 5 else 'informational'), 'source': {'address': shared.get('peer')}, 'syslog': {'priority': pri}},
  'message': msg,
  'observer': {'product': 'IOS', 'type': 'firewall' if fac == 'SEC' else ('switch' if fac == 'LINEPROTO' else 'router'), 'vendor': 'Cisco'},
  'tags': ['preserve_original_event', 'cisco-ios', 'forwarded']
} -%}
{%- do out.update(ext) -%}
{{- module.json.dumps(out) -}}
