{%- for key in ['to_skyline_success', 'to_attack_failure', 'to_attack_success', 'to_routine'] -%}{%- do shared.pop(key, none) -%}{%- endfor -%}
{%- set stage = vars.stage -%}
{%- if stage == 'routine' -%}
  {%- set count = shared.get('routine_count', 0) + 1 -%}
  {%- if count >= 65 -%}
    {%- do shared.set('routine_count', 0) -%}
    {%- if params.anomaly_mode -%}{%- do shared.set('attack_failures', 0) -%}{%- do shared.set('to_attack_failure', true) -%}{%- endif -%}
  {%- else -%}{%- do shared.set('routine_count', count) -%}{%- endif -%}
  {%- set skyline = module.rand.chance(0.20) -%}
  {%- if skyline -%}
    {%- set user_name = params.skyline_user -%}{%- set client_ip = params.skyline_ip -%}{%- set outcome = 'failure' -%}{%- do shared.set('to_skyline_success', true) -%}
  {%- else -%}
    {%- set user_name = module.rand.choice(['ops-admin', 'network-admin', 'monitor']) -%}{%- set client_ip = module.rand.choice(['10.20.1.11', '10.20.1.12', '10.20.1.13']) -%}{%- set outcome = 'success' -%}
  {%- endif -%}
{%- elif stage == 'skyline_success' -%}
  {%- set user_name = params.skyline_user -%}{%- set client_ip = params.skyline_ip -%}{%- set outcome = 'success' -%}{%- do shared.set('to_routine', true) -%}
{%- elif stage == 'attack_failure' -%}
  {%- set user_name = params.admin_user -%}{%- set client_ip = params.suspect_ip -%}{%- set outcome = 'failure' -%}
  {%- set count = shared.get('attack_failures', 0) + 1 -%}
  {%- if count >= 4 -%}{%- do shared.set('attack_failures', 0) -%}{%- do shared.set('to_attack_success', true) -%}{%- else -%}{%- do shared.set('attack_failures', count) -%}{%- endif -%}
{%- else -%}
  {%- set user_name = params.admin_user -%}{%- set client_ip = params.suspect_ip -%}{%- set outcome = 'success' -%}{%- do shared.set('to_routine', true) -%}
{%- endif -%}
{%- set iso_time = timestamp.strftime('%Y-%m-%dT%H:%M:%S.%f')[:23] ~ 'Z' -%}
{%- set original = iso_time ~ ' ' ~ params.manager_host ~ ' NSX 21593 SYSTEM [nsx@6876 audit="true" comp="nsx-manager" level="INFO" subcomp="http"] UserName=' ~ user_name ~ '@' ~ client_ip ~ ', ModuleName="ACCESS_CONTROL", Operation="LOGIN", Operation status="' ~ outcome ~ '"' -%}
{%- set event = {
  '@timestamp': timestamp.isoformat(),
  'ecs': {'version': '8.17.0'},
  'event': {'kind': 'event', 'category': ['authentication'], 'type': ['denied'] if outcome == 'failure' else ['start'], 'action': 'login-failure' if outcome == 'failure' else 'login-success', 'outcome': outcome, 'original': original},
  'host': {'name': params.manager_host},
  'log': {'file': {'path': '/var/log/syslog'}, 'level': 'info'},
  'source': {'ip': client_ip},
  'user': {'name': user_name},
  'related': {'ip': [client_ip], 'user': [user_name]},
  'vmware': {'nsx': {'module_name': 'ACCESS_CONTROL', 'operation': 'LOGIN', 'operation_status': outcome, 'component': 'nsx-manager', 'subcomponent': 'http'}}
} -%}
{{- event | tojson -}}
