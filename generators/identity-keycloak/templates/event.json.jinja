{%- for key in ['to_spray', 'to_breach', 'to_token', 'to_role_grant', 'to_audit_change', 'to_routine'] -%}
  {%- do shared.pop(key, none) -%}
{%- endfor -%}
{%- set stage = vars.stage -%}
{%- set event_time = timestamp + module.datetime.timedelta(
    seconds=module.rand.number.integer(1, 45),
    milliseconds=module.rand.number.integer(0, 999)) -%}
{%- set ingest_time = event_time + module.datetime.timedelta(
    seconds=module.rand.number.integer(1, 4)) -%}
{%- set users = [
    {'name': 'alice', 'id': '364ba1fb-f8c5-45ac-a57c-a39f3bd4b3a0', 'ip': '10.20.8.12', 'client': 'portal'},
    {'name': 'bob', 'id': '08558a58-3690-4ee3-bdcc-4df76d84c23b', 'ip': '10.20.8.31', 'client': 'hr-app'},
    {'name': 'carol', 'id': '81515fb3-c87c-4768-9607-d0d4543a5d33', 'ip': '10.20.9.18', 'client': 'mail-ui'},
    {'name': 'dmitry', 'id': '06d6371d-36ad-4c74-ad71-92c418d6b6ca', 'ip': '10.20.8.52', 'client': 'portal'},
    {'name': 'irina', 'id': 'e32ea9c9-eef4-4472-8d1c-431cbf9f065b', 'ip': '10.20.9.43', 'client': 'hr-app'},
    {'name': params.compromised_user, 'id': params.compromised_user_id,
     'ip': params.suspicious_ip, 'client': 'security-admin-console'}
] -%}
{%- set actor = module.rand.choice(users) -%}
{%- set name = actor.name -%}
{%- set uid = actor.id -%}
{%- set ip = actor.ip -%}
{%- set client = actor.client -%}
{%- set kind = 'LOGIN' -%}
{%- set op = none -%}
{%- set resource_type = none -%}
{%- set resource_path = none -%}
{%- set representation = none -%}
{%- set error = none -%}
{%- set session_id = none -%}
{%- set code_id = none -%}
{%- set token_id = none -%}
{%- set refresh_token_id = none -%}
{%- set n = shared.get('routine_count', 0) -%}
{%- if stage == 'routine' -%}
  {%- set n = (n % 1000000) + 1 -%}
  {%- do shared.set('routine_count', n) -%}
  {%- if n % 107 == 22 and shared.get('role_assigned', true) -%}
    {%- set kind = 'ADMIN_EVENT' -%}
    {%- set op = 'DELETE' -%}
  {%- elif n % 107 == 0 and not shared.get('role_assigned', true) -%}
    {%- set kind = 'ADMIN_EVENT' -%}
    {%- set op = 'CREATE' -%}
  {%- elif n % 119 == 0 -%}
    {%- set kind = 'ADMIN_EVENT' -%}
    {%- set op = 'UPDATE' -%}
  {%- elif n % 29 == 0 -%}
    {%- set kind = 'LOGIN_ERROR' -%}
  {%- elif shared.get('active_session') is not none and n % 3 == 0 and not shared.get('active_session').tokenized -%}
    {%- set kind = 'CODE_TO_TOKEN' -%}
  {%- elif shared.get('active_session') is not none and n % 5 == 0 and shared.get('active_session').tokenized -%}
    {%- set kind = 'LOGOUT' -%}
  {%- else -%}
    {%- set kind = module.rand.weighted_choice(['LOGIN', 'LOGIN_ERROR'], [85, 15]) -%}
  {%- endif -%}
  {%- if n % 29 == 0 and kind == 'LOGIN_ERROR' -%}
    {%- set actor = users[5] -%}
  {%- elif n % 41 == 0 and kind == 'LOGIN' -%}
    {%- set actor = users[5] -%}
  {%- endif -%}
  {%- if kind == 'ADMIN_EVENT' -%}
    {%- set actor = users[5] -%}
  {%- endif -%}
  {%- set name = actor.name -%}
  {%- set uid = actor.id -%}
  {%- set ip = actor.ip -%}
  {%- set client = actor.client -%}
  {%- if kind == 'LOGIN_ERROR' -%}
    {%- set error = 'invalid_user_credentials' -%}
    {%- set code_id = module.rand.crypto.uuid4() -%}
  {%- elif kind == 'LOGIN' -%}
    {%- set session_id = module.rand.crypto.uuid4() -%}
    {%- set code_id = session_id -%}
    {%- do shared.set('active_session', {'name': name, 'id': uid, 'ip': ip,
          'client': client, 'session_id': session_id, 'tokenized': false}) -%}
  {%- elif kind == 'CODE_TO_TOKEN' or kind == 'LOGOUT' -%}
    {%- set active = shared.get('active_session') -%}
    {%- set name = active.name -%}
    {%- set uid = active.id -%}
    {%- set ip = active.ip -%}
    {%- set client = active.client -%}
    {%- set session_id = active.session_id -%}
    {%- if kind == 'CODE_TO_TOKEN' -%}
      {%- set code_id = session_id -%}
      {%- set token_id = 'onrtac:' ~ module.rand.crypto.uuid4() -%}
      {%- set refresh_token_id = module.rand.crypto.uuid4() -%}
      {%- do shared.set('active_session', {'name': name, 'id': uid, 'ip': ip,
            'client': client, 'session_id': session_id, 'tokenized': true}) -%}
    {%- else -%}
      {%- do shared.pop('active_session') -%}
    {%- endif -%}
  {%- endif -%}
  {%- if params.anomaly_mode and n >= params.anomaly_after_events and not shared.get('role_assigned', true) and not shared.get('anomaly_done', false) -%}
    {%- do shared.set('spray_count', 0) -%}
    {%- do shared.set('to_spray', true) -%}
  {%- endif -%}
{%- elif stage == 'spray' -%}
  {%- set spray_count = shared.get('spray_count', 0) + 1 -%}
  {%- do shared.set('spray_count', spray_count) -%}
  {%- set actor = users[5] if spray_count == 5 else users[spray_count - 1] -%}
  {%- set kind = 'LOGIN_ERROR' -%}
  {%- set name = actor.name -%}
  {%- set uid = actor.id -%}
  {%- set ip = params.suspicious_ip -%}
  {%- set client = 'security-admin-console' -%}
  {%- set error = 'invalid_user_credentials' -%}
  {%- set code_id = module.rand.crypto.uuid4() -%}
  {%- if spray_count == 5 -%}
    {%- do shared.set('to_breach', true) -%}
  {%- endif -%}
{%- elif stage == 'breach' -%}
  {%- set actor = users[5] -%}
  {%- set name = actor.name -%}
  {%- set uid = actor.id -%}
  {%- set ip = actor.ip -%}
  {%- set client = actor.client -%}
  {%- set session_id = module.rand.crypto.uuid4() -%}
  {%- set code_id = session_id -%}
  {%- do shared.set('anomaly_session', session_id) -%}
  {%- do shared.set('to_token', true) -%}
{%- elif stage == 'token' -%}
  {%- set kind = 'CODE_TO_TOKEN' -%}
  {%- set actor = users[5] -%}
  {%- set name = actor.name -%}
  {%- set uid = actor.id -%}
  {%- set ip = actor.ip -%}
  {%- set client = actor.client -%}
  {%- set session_id = shared.pop('anomaly_session') -%}
  {%- set code_id = session_id -%}
  {%- set token_id = 'onrtac:' ~ module.rand.crypto.uuid4() -%}
  {%- set refresh_token_id = module.rand.crypto.uuid4() -%}
  {%- do shared.set('to_role_grant', true) -%}
{%- elif stage == 'role_grant' -%}
  {%- set kind = 'ADMIN_EVENT' -%}
  {%- set op = 'CREATE' -%}
  {%- do shared.set('to_audit_change', true) -%}
{%- else -%}
  {%- set kind = 'ADMIN_EVENT' -%}
  {%- set op = 'UPDATE' -%}
  {%- do shared.set('anomaly_done', true) -%}
  {%- do shared.set('to_routine', true) -%}
{%- endif -%}
{%- if op is not none -%}
  {%- if op == 'CREATE' or op == 'DELETE' -%}
    {%- do shared.set('role_assigned', op == 'CREATE') -%}
  {%- endif -%}
  {%- set name = params.compromised_user -%}
  {%- set uid = params.compromised_user_id -%}
  {%- set ip = params.suspicious_ip -%}
  {%- set client = 'security-admin-console' -%}
  {%- set resource_type = 'REALM' if op == 'UPDATE' else 'REALM_ROLE_MAPPING' -%}
  {%- set resource_path = 'events/config' if op == 'UPDATE' else 'users/' ~ params.target_user_id ~ '/role-mappings/realm' -%}
  {%- if op == 'UPDATE' -%}
    {%- set representation = ({'eventsEnabled': true, 'adminEventsEnabled': true,
          'adminEventsDetailsEnabled': true, 'eventsListeners': ['jboss-logging'],
          'eventsExpiration': 604800}|tojson) -%}
  {%- else -%}
    {%- set representation = ([{'id': params.privileged_role_id,
                               'name': params.privileged_role_name}]|tojson) -%}
  {%- endif -%}
{%- endif -%}
{%- set level = 'WARN' if error else 'INFO' -%}
{%- if op is not none -%}
  {%- set message = 'operationType=' ~ (op|tojson)
      ~ ', realmId=' ~ (params.realm_id|tojson)
      ~ ', realmName=' ~ (params.realm|tojson)
      ~ ', clientId=' ~ (client|tojson)
      ~ ', userId=' ~ (uid|tojson)
      ~ ', ipAddress=' ~ (ip|tojson)
      ~ ', resourceType=' ~ (resource_type|tojson)
      ~ ', resourcePath=' ~ (resource_path|tojson) -%}
  {%- if representation is not none -%}
    {%- set message = message ~ ', representation=' ~ (representation|tojson) -%}
  {%- endif -%}
{%- else -%}
  {%- set message = 'type=' ~ (kind|tojson)
      ~ ', realmId=' ~ (params.realm_id|tojson)
      ~ ', realmName=' ~ (params.realm|tojson)
      ~ ', clientId=' ~ (client|tojson)
      ~ ', userId=' ~ (uid|tojson) -%}
  {%- if session_id is not none -%}
    {%- set message = message ~ ', sessionId=' ~ (session_id|tojson) -%}
  {%- endif -%}
  {%- set message = message ~ ', ipAddress=' ~ (ip|tojson) -%}
  {%- if error is not none -%}
    {%- set message = message ~ ', error=' ~ (error|tojson) -%}
  {%- endif -%}
  {%- if kind == 'LOGIN' or kind == 'LOGIN_ERROR' -%}
    {%- set message = message ~ ', auth_method=' ~ ('openid-connect'|tojson)
        ~ ', auth_type=' ~ ('code'|tojson)
        ~ ', response_type=' ~ ('code'|tojson)
        ~ ', redirect_uri=' ~ ('https://sso.corp.example/callback'|tojson)
        ~ ', consent=' ~ ('no_consent_required'|tojson)
        ~ ', code_id=' ~ (code_id|tojson)
        ~ ', username=' ~ (name|tojson)
        ~ ', response_mode=' ~ ('query'|tojson) -%}
  {%- elif kind == 'CODE_TO_TOKEN' -%}
    {%- set message = message ~ ', token_id=' ~ (token_id|tojson)
        ~ ', grant_type=' ~ ('authorization_code'|tojson)
        ~ ', refresh_token_type=' ~ ('Refresh'|tojson)
        ~ ', scope=' ~ ('openid profile email'|tojson)
        ~ ', refresh_token_id=' ~ (refresh_token_id|tojson)
        ~ ', code_id=' ~ (code_id|tojson)
        ~ ', client_auth_method=' ~ ('client-secret'|tojson) -%}
  {%- endif -%}
{%- endif -%}
{%- set full_line = event_time.strftime('%Y-%m-%d %H:%M:%S,%f')[:23] ~ ' ' ~ level ~ '  [org.keycloak.events] (executor-thread-1) ' ~ message -%}
{%- set offset = shared.get('log_offset', 0) -%}
{%- do shared.set('log_offset', offset + (full_line|length) + 1) -%}
{%- set event = {
    'agent_id_status': 'verified', 'dataset': 'keycloak.log',
    'ingested': ingest_time.isoformat(), 'original': full_line,
    'timezone': '+00:00', 'kind': 'event',
    'action': (op ~ '-' ~ resource_type) if op else kind,
    'outcome': 'failure' if error else ('success' if kind == 'LOGIN' else 'unknown'),
    'category': ['iam'] if op else ['authentication'],
    'type': (['info', 'admin', 'creation' if op == 'CREATE' else 'deletion' if op == 'DELETE' else 'change'] if op else
             ['info', 'start'] if kind == 'LOGIN' else
             ['info', 'end'] if kind == 'LOGOUT' else ['info'])
} -%}
{%- if op is not none -%}
  {%- do event.update({'code': op ~ '-' ~ resource_type}) -%}
{%- elif error is not none -%}
  {%- do event.update({'code': error}) -%}
{%- endif -%}
{%- set kc = {'realm': {'id': params.realm_id}, 'client': {'id': client},
             'event_type': 'admin' if op else 'login'} -%}
{%- if op is not none -%}
  {%- do kc.update({'admin': {'operation': op,
      'resource': {'type': resource_type, 'path': resource_path}}}) -%}
{%- else -%}
  {%- set login = {'type': kind} -%}
  {%- if kind == 'LOGIN' or kind == 'LOGIN_ERROR' -%}
    {%- do login.update({'auth_method': 'openid-connect', 'auth_type': 'code',
       'redirect_uri': 'https://sso.corp.example/callback'}) -%}
  {%- endif -%}
  {%- if code_id is not none -%}
    {%- do login.update({'code_id': code_id}) -%}
  {%- endif -%}
  {%- do kc.update({'login': login}) -%}
  {%- if session_id is not none -%}
    {%- do kc.update({'session': {'id': session_id}}) -%}
  {%- endif -%}
{%- endif -%}
{%- set related_users = [uid, params.target_user_id] if op == 'CREATE' or op == 'DELETE' else [uid] -%}
{%- set doc = {
    '@timestamp': event_time.isoformat(),
    'agent': {'ephemeral_id': params.collector_ephemeral_id, 'id': params.collector_id,
              'name': params.hostname, 'type': 'filebeat', 'version': params.collector_version},
    'data_stream': {'dataset': 'keycloak.log', 'namespace': 'default', 'type': 'logs'},
    'ecs': {'version': '8.17.0'},
    'elastic_agent': {'id': params.collector_id, 'snapshot': false, 'version': params.collector_version},
    'event': event,
    'host': {'architecture': 'x86_64', 'containerized': true,
             'hostname': params.hostname, 'id': '5082ec46978249e68488c21de3f64030',
             'ip': [params.host_ip], 'mac': ['02-42-0A-14-01-0F'],
             'name': params.hostname,
             'os': {'codename': 'bookworm', 'family': 'debian',
                    'kernel': '6.1.0', 'name': 'Debian', 'platform': 'debian',
                    'type': 'linux', 'version': '12'}},
    'input': {'type': 'filestream'},
    'keycloak': kc,
    'log': {'file': {'device_id': '2049', 'inode': '537921',
                      'path': '/opt/keycloak/data/log/keycloak.log'},
            'level': level, 'logger': 'org.keycloak.events', 'offset': offset},
    'message': message,
    'process': {'thread': {'name': 'executor-thread-1'}},
    'tags': ['keycloak-log'],
    'source': {'address': ip, 'ip': ip}, 'related': {'ip': [ip], 'user': related_users},
    'user': {'id': uid}
} -%}
{%- if op is none and kind != 'CODE_TO_TOKEN' and kind != 'LOGOUT' -%}
  {%- do doc.user.update({'name': name}) -%}
{%- endif -%}
{%- if op == 'CREATE' or op == 'DELETE' -%}
  {%- do doc.update({'user': {'id': uid, 'target': {'id': params.target_user_id}}}) -%}
{%- endif -%}
{{- doc|tojson -}}
