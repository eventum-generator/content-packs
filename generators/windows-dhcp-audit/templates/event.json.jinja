{%- set step = vars.step -%}
{%- set kind = step -%}
{%- if step == 'routine' -%}
  {%- do shared.pop('to_attack', none) -%}
  {%- set count = shared.get('routine_count', 0) + 1 -%}
  {%- if count >= params.anomaly_interval_events -%}
    {%- do shared.set('routine_count', 0) -%}
    {%- if params.anomaly_mode -%}{%- do shared.set('to_attack', true) -%}{%- endif -%}
  {%- else -%}
    {%- do shared.set('routine_count', count) -%}
  {%- endif -%}
  {%- set kind = module.rand.weighted_choice(['assign','renew','release','dns_request_routine','dns_success','dns_failure_routine','failover_drop'],[45,30,8,8,5,2,2]) -%}
{%- endif -%}
{%- set client = samples.clients.pick() -%}
{%- set ip = client.ip -%}
{%- set hostname = client.hostname -%}
{%- set client_id = client.client_id -%}
{%- set code = '10' -%}
{%- set label = 'Assign' -%}
{%- set action = 'dhcp-assign' -%}
{%- set outcome = 'success' -%}
{%- set reason = 'A lease was assigned.' -%}
{%- if kind in ['lease_1','release_1','lease_2','release_2','lease_3','dns_request','dns_failed'] -%}
  {%- set ip = params.anomaly_ips[0] if kind in ['lease_1','release_1'] else (params.anomaly_ips[1] if kind in ['lease_2','release_2'] else params.anomaly_ips[2]) -%}
  {%- set hostname = params.anomaly_hostname -%}
  {%- set client_id = params.anomaly_client_id -%}
{%- endif -%}
{%- if kind in ['release','release_1','release_2'] -%}
  {%- set code = '12' -%}{%- set label = 'Release' -%}{%- set action = 'dhcp-release' -%}{%- set reason = 'The client released its lease.' -%}
{%- elif kind == 'renew' -%}
  {%- set code = '11' -%}{%- set label = 'Renew' -%}{%- set action = 'dhcp-renew' -%}{%- set reason = 'The client renewed its lease.' -%}
{%- elif kind in ['dns_request','dns_request_routine'] -%}
  {%- set code = '30' -%}{%- set label = 'DNS Update Request' -%}{%- set action = 'dhcp-dns-update' -%}{%- set reason = 'DNS update request to the named DNS server.' -%}
{%- elif kind == 'dns_success' -%}
  {%- set code = '32' -%}{%- set label = 'DNS Update Successful' -%}{%- set action = 'dhcp-dns-update' -%}{%- set reason = 'DNS update successful.' -%}
{%- elif kind in ['dns_failed','dns_failure_routine'] -%}
  {%- set code = '31' -%}{%- set label = 'DNS Update Failed' -%}{%- set action = 'dhcp-dns-update' -%}{%- set outcome = 'failure' -%}{%- set reason = 'DNS update failed.' -%}
{%- elif kind == 'failover_drop' -%}
  {%- set code = '36' -%}{%- set label = 'Packet dropped because of Client ID hash mismatch or standby server.' -%}{%- set action = 'dhcp-failover-drop' -%}{%- set outcome = 'failure' -%}{%- set reason = 'Packet dropped because the server is in failover standby role or the hash of the client ID does not match.' -%}
{%- endif -%}
{%- set mac = client_id[0:2] ~ '-' ~ client_id[2:4] ~ '-' ~ client_id[4:6] ~ '-' ~ client_id[6:8] ~ '-' ~ client_id[8:10] ~ '-' ~ client_id[10:12] -%}
{%- set date = timestamp.strftime('%m/%d/%y') -%}
{%- set time = timestamp.strftime('%H:%M:%S') -%}
{%- set error = '10054' if code == '31' else '0' -%}
{%- set line = code ~ ',' ~ date ~ ',' ~ time ~ ',' ~ label ~ ',' ~ ip ~ ',' ~ hostname ~ ',' ~ client_id ~ ',,0,6,,,,,,,,,' ~ error -%}
{%- set offset = shared.get('offset', 0) -%}
{%- do shared.set('offset', (offset + line|length + 2) % 2147483647) -%}
{%- set seq = (shared.get('sequence', 0) % 2147483647) + 1 -%}
{%- do shared.set('sequence', seq) -%}
{%- set out = {'@timestamp':timestamp.isoformat(),'ecs':{'version':'8.17.0'},'event':{'action':action,'category':['network'],'code':code,'agent_id_status':'verified','ingested':timestamp.isoformat(),'dataset':'microsoft_dhcp.log','kind':'event','original':line,'outcome':outcome,'reason':reason,'sequence':seq,'timezone':'UTC','type':['connection'] if code not in ['12','36'] else (['end'] if code == '12' else ['connection','denied'])},'agent':{'ephemeral_id':'a1b2c3d4-1111-4444-8888-123456789abc','id':'a1b2c3d4-1111-4444-8888-123456789abc','name':params.server_name,'type':'filebeat','version':'8.17.0'},'elastic_agent':{'id':'a1b2c3d4-1111-4444-8888-123456789abc','snapshot':false,'version':'8.17.0'},'data_stream':{'dataset':'microsoft_dhcp.log','namespace':'default','type':'logs'},'host':{'name':params.server_name,'ip':[params.server_ip],'mac':['02-42-AC-11-00-10']},'input':{'type':'log'},'log':{'file':{'path':'C:\\Windows\\System32\\Dhcp\\DhcpSrvLog-Fri.log'},'offset':offset},'message':label,'observer':{'hostname':params.server_name,'ip':[params.server_ip],'mac':['02-42-AC-11-00-10']},'source':{'address':hostname,'domain':hostname,'ip':ip,'mac':mac},'related':{'ip':[ip],'hosts':[hostname]},'tags':['preserve_original_event','microsoft_dhcp']} -%}
{{- out | tojson -}}
