{%- set previous = shared.get('previous_time') -%}
{%- set event_time = timestamp if previous is none or timestamp > previous else previous + module.datetime.timedelta(seconds=1) -%}
{%- do shared.set('previous_time', event_time) -%}
{%- set tick = (shared.get('tick', -1) + 1) % (params.anomaly_interval_events + 4) -%}
{%- do shared.set('tick', tick) -%}
{%- set chain = params.anomaly_mode and tick >= params.anomaly_interval_events -%}
{%- set step = tick - params.anomaly_interval_events if chain else -1 -%}
{%- if chain -%}
  {%- set kind = ['Detected','CleanupFailed','Detected','CleanedUp'][step] -%}
  {%- set host_name = params.target_host -%}
  {%- set file_path = params.target_file -%}
  {%- set threat = params.threat_name -%}
{%- else -%}
  {%- set kind = module.rand.weighted_choice(['Detected','CleanedUp','HIPSDetected'], [10, 80, 10]) -%}
  {%- set host_name = module.rand.choice(['linux-web-01.example.test','linux-dev-02.example.test','linux-db-03.example.test']) -%}
  {%- set file_path = module.rand.choice(['/tmp/update.sh','/home/user/Downloads/tool.bin','/opt/app/cache/pkg.so']) -%}
  {%- set threat = module.rand.choice(['Mal/Generic-S','PUA/Generic-A','Troj/Example-B']) -%}
{%- endif -%}
{%- set class_id = 'Event::Endpoint::Threat::' ~ kind -%}
{%- set severity = 8 if kind in ['Detected','CleanupFailed','HIPSDetected'] else 5 -%}
{%- set raw = 'CEF:0|sophos|sophos central|1.0|' ~ class_id ~ '|'
  ~ threat ~ '|' ~ severity ~ '|'
  ~ 'rt=' ~ event_time.isoformat() ~ ' end=' ~ event_time.isoformat()
  ~ ' dhost=' ~ host_name ~ ' filePath=' ~ file_path
  ~ ' suser=analyst@example.test' -%}
{%- set record = {'@timestamp': event_time.isoformat(),
  'ecs': {'version': '8.17.0'},
  'event': {'kind': 'alert', 'dataset': 'sophos.central', 'module': 'sophos',
    'category': ['malware'],
    'type': ['info'],
    'code': class_id, 'action': kind, 'original': raw},
  'host': {'name': host_name},
  'file': {'path': file_path},
  'user': {'email': 'analyst@example.test'},
  'sophos': {'central': {'event_type': class_id, 'severity': severity, 'threat_name': threat}}} -%}
{{ record | tojson }}
