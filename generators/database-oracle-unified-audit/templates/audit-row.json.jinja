{%- set event_no = shared.get('event_no', 0) + 1 -%}
{%- do shared.set('event_no', event_no) -%}
{%- set sessions = shared.get('sessions', {}) -%}
{%- set attack_step = shared.get('attack_step', 0) -%}
{%- set force_target_logoff = false -%}
{%- set target_key = params.target_user ~ '@' ~ params.attacker_host -%}
{%- if params.anomaly_mode and attack_step == 0 and event_no >=
    shared.get('next_anomaly_at', params.anomaly_after_events + 1) -%}
  {%- if target_key in sessions -%}
    {%- set force_target_logoff = true -%}
  {%- else -%}
    {%- set attack_step = 1 -%}
    {%- do shared.set('next_anomaly_at',
        event_no + params.anomaly_interval_events) -%}
  {%- endif -%}
{%- endif -%}
{%- if attack_step > 0 -%}
  {%- do shared.set('attack_step', 0 if attack_step == 8
      else attack_step + 1) -%}
{%- endif -%}
{%- set username = none -%}
{%- set userhost = none -%}
{%- set os_username = 'svc_app' -%}
{%- set program = 'JDBC Thin Client' -%}
{%- set action = none -%}
{%- set workload = 'reporting' -%}
{%- set role = none -%}
{%- set target = none -%}
{%- set return_code = 0 -%}
{%- if force_target_logoff -%}
  {%- set username = params.target_user -%}
  {%- set userhost = params.attacker_host -%}
  {%- set os_username = 'ops' -%}
  {%- set program = 'sqlplus' -%}
  {%- set workload = 'finance' -%}
  {%- set action = 'LOGOFF' -%}
{%- elif 1 <= attack_step <= 8 -%}
  {%- set username = params.target_user -%}
  {%- set userhost = params.attacker_host -%}
  {%- set os_username = 'ops' -%}
  {%- set program = 'sqlplus' -%}
  {%- set workload = 'finance' -%}
  {%- if attack_step <= 4 -%}
    {%- set action = 'LOGON' -%}
    {%- set return_code = 1017 -%}
  {%- elif attack_step == 5 -%}
    {%- set action = 'LOGON' -%}
  {%- elif attack_step == 6 -%}
    {%- set action = 'SELECT' -%}
  {%- elif attack_step == 7 -%}
    {%- set action = 'GRANT' -%}
    {%- set role = 'PAYROLL_READ' -%}
    {%- set target = params.grantee -%}
  {%- else -%}
    {%- set action = 'LOGOFF' -%}
  {%- endif -%}
{%- elif event_no in [20, 40, 80, 120, 160, 200, 220, 240] -%}
  {%- set os_username = 'ops' -%}
  {%- set program = 'sqlplus' -%}
  {%- if event_no <= 160 -%}
    {%- set username = params.target_user -%}
    {%- set userhost = params.attacker_host -%}
    {%- set workload = 'finance' -%}
    {%- if event_no == 160 -%}
      {%- set action = 'LOGON' -%}
      {%- set return_code = 1017 -%}
    {%- elif event_no == 20 -%}
      {%- set action = 'SELECT' if target_key in sessions else 'LOGON' -%}
    {%- elif event_no == 40 -%}
      {%- set action = 'SELECT' if target_key in sessions else 'LOGON' -%}
    {%- elif event_no == 80 -%}
      {%- set action = 'GRANT' if target_key in sessions else 'LOGON' -%}
      {%- if action == 'GRANT' -%}
        {%- set role = 'PAYROLL_READ' -%}
        {%- set target = 'BI_ANALYST' -%}
      {%- endif -%}
    {%- else -%}
      {%- set action = 'LOGOFF' if target_key in sessions else 'LOGON' -%}
    {%- endif -%}
  {%- else -%}
    {%- set username = 'SEC_ADMIN' -%}
    {%- set userhost = 'admin01.corp.example' -%}
    {%- set sec_key = username ~ '@' ~ userhost -%}
    {%- if event_no == 200 -%}
      {%- set action = 'SELECT' if sec_key in sessions else 'LOGON' -%}
    {%- elif event_no == 220 -%}
      {%- set action = 'GRANT' if sec_key in sessions else 'LOGON' -%}
      {%- if action == 'GRANT' -%}
        {%- set role = 'APP_REPORTER' -%}
        {%- set target = params.grantee -%}
      {%- endif -%}
    {%- else -%}
      {%- set action = 'LOGOFF' if sec_key in sessions else 'LOGON' -%}
    {%- endif -%}
  {%- endif -%}
{%- else -%}
  {%- if event_no > 300 and module.rand.number.integer(1, 100) <= 3 -%}
    {%- set username = params.target_user -%}
    {%- set userhost = params.attacker_host -%}
    {%- set os_username = 'ops' -%}
    {%- set program = 'sqlplus' -%}
    {%- set workload = 'finance' -%}
  {%- else -%}
    {%- set client = samples.clients.pick() -%}
    {%- set username = client.username -%}
    {%- set userhost = client.userhost -%}
    {%- set os_username = client.os_username -%}
    {%- set program = client.program -%}
    {%- set workload = client.workload -%}
  {%- endif -%}
  {%- set key = username ~ '@' ~ userhost -%}
  {%- if key not in sessions -%}
    {%- set action = 'LOGON' -%}
  {%- else -%}
    {%- set roll = module.rand.number.integer(1, 100) -%}
    {%- if roll <= 3 -%}{%- set action = 'LOGOFF' -%}
    {%- elif workload == 'finance' and roll <= 4 -%}
      {%- set action = 'GRANT' -%}
      {%- set role = 'PAYROLL_READ' -%}
      {%- set target = 'BI_ANALYST' -%}
    {%- elif workload == 'hr' and roll <= 13 -%}{%- set action = 'UPDATE' -%}
    {%- else -%}{%- set action = 'SELECT' -%}{%- endif -%}
  {%- endif -%}
{%- endif -%}
{%- set key = username ~ '@' ~ userhost -%}
{%- if action == 'LOGON' -%}
  {%- set sessionid = shared.get('next_sessionid', 100000) + 1 -%}
  {%- do shared.set('next_sessionid', sessionid) -%}
  {%- set entry_id = 1 -%}
  {%- set statement_id = 1 -%}
  {%- if return_code == 0 -%}
    {%- do sessions.update({key: {'sessionid': sessionid, 'entry': 1, 'statement': 1}}) -%}
  {%- endif -%}
{%- else -%}
  {%- set session = sessions[key] -%}
  {%- set sessionid = session.sessionid -%}
  {%- set entry_id = session.entry + 1 -%}
  {%- set statement_id = session.statement + 1 -%}
  {%- if action == 'LOGOFF' -%}
    {%- do sessions.pop(key) -%}
  {%- else -%}
    {%- do sessions.update({key: {'sessionid': sessionid, 'entry': entry_id, 'statement': statement_id}}) -%}
  {%- endif -%}
{%- endif -%}
{%- do shared.set('sessions', sessions) -%}
{%- set schema = none -%}
{%- set object = none -%}
{%- set sql = none -%}
{%- if action == 'SELECT' -%}
  {%- if workload == 'finance' -%}
    {%- set schema = 'FINANCE' -%}
    {%- set object = 'PAYROLL' -%}
    {%- set sql = 'SELECT EMPLOYEE_ID, BANK_ACCOUNT FROM FINANCE.PAYROLL' -%}
  {%- elif workload == 'hr' -%}
    {%- set schema = 'HR' -%}
    {%- set object = 'EMPLOYEES' -%}
    {%- set sql = 'SELECT EMPLOYEE_ID, DEPARTMENT_ID FROM HR.EMPLOYEES WHERE DEPARTMENT_ID = 50' -%}
  {%- else -%}
    {%- set schema = 'REPORTING' -%}
    {%- set object = 'DAILY_SALES' -%}
    {%- set sql = 'SELECT SALE_DATE, NET_AMOUNT FROM REPORTING.DAILY_SALES WHERE REGION_ID = 4' -%}
  {%- endif -%}
{%- elif action == 'UPDATE' -%}
  {%- set schema = 'HR' -%}
  {%- set object = 'EMPLOYEES' -%}
  {%- set sql = "UPDATE HR.EMPLOYEES SET PHONE_NUMBER = '515.123.4567' WHERE EMPLOYEE_ID = 100" -%}
{%- elif action == 'GRANT' -%}
  {%- set sql = 'GRANT ' ~ role ~ ' TO ' ~ target -%}
{%- endif -%}
{%- set policy = 'ORA_LOGON_FAILURES' if return_code == 1017 else 'APP_SESSION_AUDIT' if action in ['LOGON', 'LOGOFF'] else 'APP_DATA_AUDIT' if action in ['SELECT', 'UPDATE'] else 'ORA_ACCOUNT_MGMT' -%}
{%- if program == 'sqlplus' -%}{%- set program = ('sqlplus@' ~ userhost ~ ' (TNS V1-V3)')[:48] -%}{%- endif -%}
{%- set clock = timestamp.strftime('%Y-%m-%d %H:%M:%S.%f') -%}
{%- set row = {
  'AUDIT_TYPE': 'Standard',
  'SESSIONID': sessionid,
  'ENTRY_ID': entry_id,
  'STATEMENT_ID': statement_id,
  'EVENT_TIMESTAMP': clock,
  'EVENT_TIMESTAMP_UTC': clock,
  'ACTION_NAME': action,
  'RETURN_CODE': return_code,
  'DBUSERNAME': username,
  'OS_USERNAME': os_username,
  'USERHOST': userhost,
  'CLIENT_PROGRAM_NAME': program,
  'DBID': params.database_id,
  'INSTANCE_ID': 1,
  'OBJECT_SCHEMA': schema,
  'OBJECT_NAME': object,
  'SQL_TEXT': sql,
  'SQL_BINDS': none,
  'ROLE': role,
  'TARGET_USER': target,
  'UNIFIED_AUDIT_POLICIES': policy,
  'CURRENT_USER': username if return_code == 0 else none
} -%}
{{- row | tojson -}}
