{# One organization, personal Disk owners; synthetic cadence/sessions/maintenance, native API keys only. #}
{%- set tick = timestamp.timestamp() | int -%}
{%- set window = 900 -%}
{%- set interval = params.anomaly_interval_hours * 3600 if params.anomaly_interval_hours is number else 0 -%}
{%- if shared.get('last_source_time') is not none and tick-shared.get('last_source_time') != 60 -%}
  {%- do module.builtins.exec('raise ValueError("selected profile requires exactly one timestamp per source minute")') -%}
{%- endif -%}
{%- do shared.set('last_source_time',tick) -%}
{# The operation happens at a random second of its minute slot; every clock below derives from it, so order stays strict. #}
{%- set now = tick + module.rand.number.integer(0,59) -%}
{%- set utc = module.datetime.datetime.fromtimestamp(now, module.datetime.timezone.utc) -%}
{%- if not shared.get('inventory') -%}
  {%- if params.anomaly_mode is not boolean or params.anomaly_interval_hours is not number or params.anomaly_interval_hours < 6 or params.anomaly_interval_hours != params.anomaly_interval_hours or params.anomaly_interval_hours > 8760 -%}
    {%- do module.builtins.exec('raise ValueError("anomaly_mode must be boolean; anomaly_interval_hours must be finite and between 6 and 8760")') -%}
  {%- endif -%}
  {%- if params.org_id is not integer or params.org_id < 1 or params.compromised_uid is not integer or params.compromised_uid < 1 -%}
    {%- do module.builtins.exec('raise ValueError("org_id and compromised_uid must be positive integers")') -%}
  {%- endif -%}
  {%- if not params.compromised_name or '@' not in params.compromised_login or ',' in params.compromised_login or not params.organization_domain or '@' in params.organization_domain or ',' in params.organization_domain -%}
    {%- do module.builtins.exec('raise ValueError("account names/domain must be nonempty; login must contain @ and cannot contain comma")') -%}
  {%- endif -%}
  {%- set pool = {params.sensitive_path: params.sensitive_media_type} -%}
  {%- for row in samples.files -%}{%- do pool.update({row[0]: row[1]}) -%}{%- endfor -%}
  {%- if pool | length != (samples.files | length) + 1 -%}
    {%- do module.builtins.exec('raise ValueError("file paths must be distinct")') -%}
  {%- endif -%}
  {%- for path, category in pool.items() -%}
    {%- if not path.startswith('disk:/') or not path.split('/')[-1] or not ((path.lower().endswith('.docx') and category == 'document') or (path.lower().endswith('.xlsx') and category == 'spreadsheet')) -%}
      {%- do module.builtins.exec('raise ValueError("selected file profile requires disk:/ filename and matching DOCX document/XLSX spreadsheet category")') -%}
    {%- endif -%}
  {%- endfor -%}
  {# The extra account holds the configured sensitive file and the first three sampled files. #}
  {%- set extra_paths = [params.sensitive_path] -%}
  {%- for row in samples.files -%}{%- if loop.index0 < 3 -%}{%- do extra_paths.append(row[0]) -%}{%- endif -%}{%- endfor -%}
  {%- set owners = [{'login':params.compromised_login,'name':params.compromised_name,'uid':params.compromised_uid,'ip':params.compromised_usual_ip,'paths':extra_paths}] -%}
  {%- for row in samples.users -%}
    {%- do owners.append({'login':row[0]~'@'~params.organization_domain,'name':row[1],'uid':row[2],'ip':row[3],'paths':row[4] | list}) -%}
  {%- endfor -%}
  {%- if owners | length != 6 or owners | map(attribute='uid') | unique | list | length != 6 or owners | map(attribute='login') | unique | list | length != 6 -%}
    {%- do module.builtins.exec('raise ValueError("inventory requires six unique account IDs/logins")') -%}
  {%- endif -%}
  {%- set doc_net = module.ipaddress.ip_network('2001:db8::/32') -%}
  {%- set alternate = module.ipaddress.ip_interface(params.alternate_ip) -%}
  {%- set contexts = [] -%}
  {%- for owner in owners -%}
    {%- set usual = module.ipaddress.ip_interface(owner.ip) -%}
    {%- if owner.uid is not integer or owner.uid < 1 or not owner.name or ',' in owner.login or usual == alternate -%}
      {%- do module.builtins.exec('raise ValueError("owners require positive integer UID, display name and different usual/alternate addresses")') -%}
    {%- endif -%}
    {%- if owner.paths | length < 2 or owner.paths | length > 4 or owner.paths | unique | list | length != owner.paths | length or owner.paths | reject('in', pool) | list -%}
      {%- do module.builtins.exec('raise ValueError("each owner holds two to four distinct inventory files")') -%}
    {%- endif -%}
    {%- do owner.update({'files':[]}) -%}
    {%- for path in owner.paths -%}{%- do owner.files.append([path,pool[path]]) -%}{%- endfor -%}
    {%- for address in [usual,alternate] -%}
      {%- if address.version != 6 or address.network.prefixlen != 128 or address.ip not in doc_net -%}
        {%- do module.builtins.exec('raise ValueError("selected synthetic profile requires 2001:db8::/32 client addresses rendered as /128")') -%}
      {%- endif -%}
      {%- set debt = [] -%}
      {%- for file in owner.files -%}{%- do debt.extend([[file[0],'employees'],[file[0],'all']]) -%}{%- endfor -%}
      {%- do contexts.append({'owner':owner,'ip':address | string,'plan':[],'pace':[50,25,15,10],'next_at':tick,'debt':debt,'parts':[],'ep':none}) -%}
    {%- endfor -%}
    {%- do owner.update({'ips':[usual | string,alternate | string]}) -%}
  {%- endfor -%}
  {%- do shared.update({'inventory':owners,'contexts':contexts,'links':{},'pending':none,'lock':none,'cursor':0,'due':now+module.rand.number.floating(0,[interval,86400] | min)}) -%}
{%- endif -%}
{%- set owners = shared.get('inventory') -%}
{%- set contexts = shared.get('contexts') -%}
{%- set links = shared.get('links') -%}
{%- set pending = shared.get('pending') -%}
{%- set lock = shared.get('lock') -%}
{# Chain-guard memory: per client (UID and address), the partial sign-in -> view F -> `all` publication of F sequences of its records,
   as a sequence matcher sees them: [next step, sign-in time, F], kept for 15 minutes after the sign-in. #}
{%- for context in contexts -%}
  {%- if context.parts -%}{%- do context.update({'parts':context.parts | selectattr(1,'ge',now-window) | list}) -%}{%- endif -%}
{%- endfor -%}
{%- set running = contexts | selectattr('ep') | first -%}
{%- if params.anomaly_mode and not running and not pending and now >= shared.get('due') -%}
  {%- set cursor = shared.get('cursor') -%}
  {%- set owner = owners[cursor % 6] -%}
  {%- set pending = {'owner':owner,'file':owner.files[(cursor // 6) % (owner.files | length)],'ip':owner.ips[1]} -%}
  {%- do shared.set('pending',pending) -%}
{%- endif -%}
{%- set choice = namespace(kind=none, owner=none, ip=none, file=none, rights=none, context=none) -%}
{# A running episode is one more session plan; it takes a tick only when its next step is due, like any session.
   It never waits more than eight minutes for its next step, so it ends within the 15-minute window. #}
{%- if running and running.next_at <= tick and now-running.ep > 480 -%}
  {%- set choice.context = running -%}
{%- else -%}
  {# Each link gets its own removal time (30-50 minutes after publication); the owner acts on the earliest due link with probability 0.5 per minute, so removals drift a few minutes in both modes. #}
  {%- set cleanup = namespace(key=none,until=none) -%}
  {%- for key,link in links.items() -%}
    {%- if now >= link.until and (cleanup.until is none or link.until < cleanup.until) -%}
      {%- set cleanup.key = key -%}{%- set cleanup.until = link.until -%}
    {%- endif -%}
  {%- endfor -%}
  {%- if cleanup.key is not none and module.rand.chance(0.5) -%}
    {%- set link = links.pop(cleanup.key) -%}
    {%- set choice.kind = 'disk_fs-set-private' -%}{%- set choice.owner = link.owner -%}{%- set choice.file = link.file -%}
    {%- set choice.ip = link.ip if module.rand.chance(0.7) else (link.owner.ips | reject('equalto',link.ip) | first) -%}
  {%- elif pending -%}
    {# A due client starts like any idle client starting a session (at most three run at once), once its target is private. #}
    {%- set reserved = contexts | selectattr('ip','equalto',pending.ip) | selectattr('owner.uid','equalto',pending.owner.uid) | first -%}
    {%- if not reserved.plan and (contexts | selectattr('plan') | list | length) < 3 and (pending.owner.uid,pending.file[0]) not in links and module.rand.chance(0.25) -%}
      {# The episode is a sharing-session plan of that client. The next start is drawn uniformly within +/- w/2 of one interval
         after this actual start, w = min(interval / 4, 6 h); the target stays reserved until the episode publishes it. #}
      {%- set f = pending.file -%}
      {%- do reserved.update({'plan':[['id_cookie.set',none],['disk_fs-view',f],['disk_fs-set-public',f,'all'],['disk_fs-get-download-url',f]],'pace':[80,15,5,0],'ep':now}) -%}
      {%- set half = ([interval / 4, 21600] | min) / 2 -%}
      {%- do shared.update({'pending':none,'lock':pending,'due':now+interval+module.rand.number.floating(-half,half),'cursor':shared.get('cursor')+1}) -%}
      {%- set lock = pending -%}
      {%- set pending = none -%}
      {%- set choice.context = reserved -%}
    {%- endif -%}
  {%- endif -%}
{%- endif -%}
{%- if choice.kind is none -%}
  {# Ordinary browser sessions: up to three interleaved per-client plans of one to five operations minutes apart. #}
  {%- set active = contexts | selectattr('plan') | list -%}
  {%- set due = active | selectattr('next_at','le',tick) | sort(attribute='next_at') | list -%}
  {%- set idle = contexts | rejectattr('plan') | list -%}
  {%- if choice.context is not none -%}
  {%- elif due and (active | length >= 3 or module.rand.chance(0.7)) -%}
    {%- set choice.context = due | first -%}
  {%- elif active | length < 3 -%}
    {%- set context = module.rand.choice(idle) -%}
    {%- set files = context.owner.files -%}
    {%- set a = module.rand.choice(files) -%}
    {%- set b = module.rand.choice(files | reject('equalto',a) | list) -%}
    {%- set signin = [['id_cookie.set',none]] if module.rand.chance(0.5) else [] -%}
    {%- set kind = module.rand.weighted_choice(['single','browse','share','burst','edit'],[40,28,14,10,8]) -%}
    {%- if kind == 'single' -%}
      {%- set plan = [[module.rand.weighted_choice(['disk_fs-view','disk_fs-get-download-url','disk_fs-store'],[55,25,15]),a]] -%}
    {%- elif kind == 'browse' -%}
      {%- set plan = signin + [['disk_fs-view',a]] -%}
      {%- for _ in range(module.rand.number.integer(1,3)) -%}
        {%- do plan.append(module.rand.weighted_choice([['disk_fs-view',b],['disk_fs-get-download-url',a],['disk_fs-get-download-url',b],['disk_fs-store',a],['disk_fs-view',a]],[30,30,15,10,15])) -%}
      {%- endfor -%}
    {%- elif kind == 'share' -%}
      {# Share a random file of this owner that is currently private; most shares open the file first.
         Until every file/rights pair of this client has occurred once (a startup transient, never refilled), picks lean towards a missing pair. #}
      {%- set candidates = [] -%}
      {%- for file in files -%}
        {%- if (context.owner.uid,file[0]) not in links and not (pending and context.owner.uid == pending.owner.uid and file[0] == pending.file[0]) and not (lock and context.owner.uid == lock.owner.uid and file[0] == lock.file[0]) -%}{%- do candidates.append(file) -%}{%- endif -%}
      {%- endfor -%}
      {%- set a = module.rand.choice(candidates) if candidates else a -%}
      {%- set macro = module.rand.weighted_choice(['employees','all'],[55,45]) -%}
      {%- set missing = context.debt | selectattr(0,'in',candidates | map(attribute=0) | list) | list -%}
      {%- if missing and module.rand.chance(0.6) -%}
        {%- set pick = module.rand.choice(missing) -%}
        {%- set a = candidates | selectattr(0,'equalto',pick[0]) | first -%}{%- set macro = pick[1] -%}
      {%- endif -%}
      {%- set b = module.rand.choice(files | reject('equalto',a) | list) -%}
      {%- set plan = signin + ([['disk_fs-view',a]] if module.rand.chance(0.7) else []) + [['disk_fs-set-public',a,macro]] -%}
      {%- set follow = module.rand.weighted_choice([['disk_fs-get-download-url',a],['disk_fs-view',b],['disk_fs-get-download-url',b],['disk_fs-store',a],none],[40,20,15,10,15]) -%}
      {%- if follow is not none -%}{%- do plan.append(follow) -%}{%- endif -%}
    {%- elif kind == 'burst' -%}
      {%- set plan = [['disk_fs-view',a],['disk_fs-get-download-url',a],['disk_fs-get-download-url',b]] -%}
    {%- else -%}
      {%- set plan = [['disk_fs-view',a],['disk_fs-store',a]] + ([['disk_fs-get-download-url',a]] if module.rand.chance(0.5) else []) -%}
    {%- endif -%}
    {%- do context.update({'plan':plan,'pace':[80,15,5,0] if kind == 'share' else [50,25,15,10]}) -%}
    {%- set choice.context = context -%}
  {%- else -%}
    {%- set choice.context = active | sort(attribute='next_at') | first -%}
  {%- endif -%}
  {%- set context = choice.context -%}
  {%- set step = context.plan.pop(0) -%}
  {%- do context.update({'next_at':tick + module.rand.weighted_choice([60,120,180,300],context.pace)}) -%}
  {# Session steps are scheduled on minute slots; the second inside the slot is drawn independently. #}
  {%- set choice.owner = context.owner -%}{%- set choice.ip = context.ip -%}
  {%- set choice.kind = step[0] -%}{%- set choice.file = step[1] if step[1] is not none else module.rand.choice(context.owner.files) -%}
  {%- if choice.kind == 'disk_fs-set-public' -%}
    {%- if context.ep and lock -%}{%- do shared.set('lock',none) -%}{%- endif -%}
    {%- if (choice.owner.uid,choice.file[0]) not in links and (context.ep or not (pending and choice.owner.uid == pending.owner.uid and choice.file[0] == pending.file[0]) and not (lock and choice.owner.uid == lock.owner.uid and choice.file[0] == lock.file[0])) -%}
      {%- set choice.rights = {'macros':step[2],'rights':'read'} -%}
      {%- if [choice.file[0],step[2]] in context.debt -%}{%- do context.debt.remove([choice.file[0],step[2]]) -%}{%- endif -%}
      {%- do links.update({(choice.owner.uid,choice.file[0]):{'owner':choice.owner,'file':choice.file,'ip':choice.ip,'until':now + 60*(module.rand.number.triangular(30,50,33) | round | int)}}) -%}
    {%- else -%}{%- set choice.kind = 'disk_fs-view' -%}{%- endif -%}
  {%- endif -%}
  {# Ordinary traffic never completes sign-in -> view F -> `all` publication of F -> download of F within 15 minutes of the
     sign-in: such a download is not recorded, and its minute slot stays empty. The episode's own download completes its chain. #}
  {%- if choice.kind == 'disk_fs-get-download-url' and not context.ep and context.parts | selectattr(0,'equalto',3) | selectattr(2,'equalto',choice.file[0]) | list -%}
    {%- do dispatch.drop() -%}
  {%- endif -%}
  {%- if context.ep and not context.plan -%}{%- do context.update({'ep':none}) -%}{%- endif -%}
{%- endif -%}
{%- if choice.context is not none -%}
  {%- set context = choice.context -%}
  {%- if choice.kind == 'id_cookie.set' -%}
    {%- set step = 0 -%}
  {%- elif choice.kind == 'disk_fs-view' -%}
    {%- set step = 1 -%}
  {%- elif choice.kind == 'disk_fs-set-public' and choice.rights.macros == 'all' -%}
    {%- set step = 2 -%}
  {%- elif choice.kind == 'disk_fs-get-download-url' -%}
    {%- set step = 3 -%}
  {%- else -%}
    {%- set step = none -%}
  {%- endif -%}
  {%- if step is not none -%}
    {%- set m = namespace(new=[], done=false) -%}
    {%- for p in context.parts -%}
      {%- if not m.done -%}
        {%- if p[0] == step and (step == 1 or p[2] == choice.file[0]) -%}
          {%- if step == 3 -%}{%- set m.done = true -%}
          {%- else -%}{%- do m.new.append([step + 1, p[1], choice.file[0] if step == 1 else p[2]]) -%}{%- endif -%}
        {%- else -%}
          {%- do m.new.append(p) -%}
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}
    {%- if step == 0 -%}{%- do m.new.append([1, now, none]) -%}{%- endif -%}
    {%- do context.update({'parts':[] if m.done else m.new[-8:]}) -%}
  {%- endif -%}
{%- endif -%}
{%- if choice.kind == 'id_cookie.set' -%}
  {%- set service = 'ID' -%}
  {%- set meta = {'device_id':none if module.rand.chance(0.5) else '', 'revision':'1'} -%}
  {# Request ID mirrors the five published examples: @<4-6 digits>,<epoch>.<6-7 digits>,<16 digits>,<34 hex, 33rd is a>,<uid>,<login>. Components stay opaque. #}
  {%- set early = module.rand.chance(0.2) -%}
  {%- set clock = (now-1) ~ '.9' ~ module.rand.string.digits(module.rand.choice([4,5,5,5,5])) if early else now ~ '.' ~ module.rand.string.digits(module.rand.choice([5,6,6,6,6])) -%}
  {%- set clock = clock ~ module.rand.choice('123456789') -%}
  {%- set width = module.rand.choice([4,5,6]) -%}
  {%- set request_id = '@' ~ module.rand.number.integer(10**(width-1),10**width-1) ~ ',' ~ clock ~ ',' ~ module.rand.number.integer(10**15,10**16-1) ~ ',' ~ module.rand.string.hex(32) ~ 'a' ~ module.rand.string.hex(1) ~ ',' ~ choice.owner.uid ~ ',' ~ choice.owner.login -%}
{%- else -%}
  {%- set service = 'Web' -%}
  {%- set meta = {'unixtime':now,'tgt_rawaddress':choice.file[0],'resource_name':choice.file[0].split('/')[-1],'resource_type':'file'} -%}
  {%- if choice.kind != 'disk_fs-set-private' -%}{%- do meta.update({'resource_media_type':choice.file[1]}) -%}{%- endif -%}
  {%- if choice.rights is not none -%}{%- do meta.update({'public_rights':choice.rights}) -%}{%- endif -%}
  {%- set request_id = module.rand.crypto.uuid4() -%}
{%- endif -%}
{%- set item = {'user_login':choice.owner.login,'user_name':choice.owner.name,'event':{'status':'Success','idempotency_id':module.rand.crypto.uuid4(),'uid':choice.owner.uid,'service':service,'ip':choice.ip,'occurred_at':utc.isoformat(),'org_id':params.org_id,'is_system':false,'meta':meta,'request_id':request_id,'type':choice.kind}} -%}
{{- item | tojson -}}
