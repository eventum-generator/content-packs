{%- for key in ['to_unusual_login', 'to_sensitive_view', 'to_public_link', 'to_download', 'to_routine'] -%}
  {%- do shared.pop(key, none) -%}
{%- endfor -%}
{%- set stage = vars.stage -%}
{%- set actor = module.rand.choice([['anna', 1130000000100001], ['boris', 1130000000100002], ['irina', 1130000000100003], ['pavel', 1130000000100004], ['marina', 1130000000100005]]) -%}
{%- set login = actor[0] ~ '@' ~ params.organization_domain -%}
{%- set uid = actor[1] -%}
{%- set ip = module.rand.choice(['10.20.7.14', '10.20.7.32', '10.20.8.17']) -%}
{%- set kind = 'disk_fs-view' -%}
{%- set status = 'Success' -%}
{%- set service = 'Web' -%}
{%- set meta = {} -%}
{%- set path = module.rand.choice(['disk:/team/roadmap.pdf', 'disk:/projects/plan.xlsx', 'disk:/hr/handbook.pdf']) -%}
{%- if stage == 'routine' -%}
  {%- set kind = module.rand.weighted_choice(['id_cookie.set', 'disk_fs-view', 'disk_fs-get-download-url', 'disk_fs-store', 'disk_fs-set-private'], [32, 36, 18, 10, 4]) -%}
  {%- if kind == 'id_cookie.set' -%}
    {%- set service = 'ID' -%}
    {%- set meta = {'device_id': none, 'revision': '1'} -%}
  {%- else -%}
    {%- set meta = {'unixtime': timestamp.timestamp()|int, 'tgt_rawaddress': path, 'resource_name': path.split('/')[-1], 'resource_type': 'file', 'resource_media_type': 'application/pdf' if path.endswith('.pdf') else 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'} -%}
  {%- endif -%}
  {%- set count = shared.get('routine_count', 0) + 1 -%}
  {%- if count >= 80 -%}
    {%- do shared.set('routine_count', 0) -%}
    {%- if params.anomaly_mode -%}{%- do shared.set('to_unusual_login', true) -%}{%- endif -%}
  {%- else -%}
    {%- do shared.set('routine_count', count) -%}
  {%- endif -%}
{%- else -%}
  {%- set login = params.compromised_login -%}
  {%- set uid = params.compromised_uid -%}
  {%- set ip = params.suspicious_ip -%}
  {%- set path = params.sensitive_path -%}
  {%- set service = 'ID' if stage == 'unusual_login' else 'Web' -%}
  {%- set kind = {'unusual_login': 'id_cookie.set', 'sensitive_view': 'disk_fs-view', 'public_link': 'disk_fs-set-public', 'download': 'disk_fs-get-download-url'}[stage] -%}
  {%- if stage == 'unusual_login' -%}
    {%- set meta = {'device_id': none, 'revision': '1'} -%}
    {%- do shared.set('to_sensitive_view', true) -%}
  {%- else -%}
    {%- set meta = {'unixtime': timestamp.timestamp()|int, 'tgt_rawaddress': path, 'resource_name': path.split('/')[-1], 'resource_type': 'file', 'resource_media_type': 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'} -%}
    {%- if stage == 'sensitive_view' -%}
      {%- do shared.set('to_public_link', true) -%}
    {%- elif stage == 'public_link' -%}
      {%- do meta.update({'public_rights': {'macros': 'all', 'rights': 'read'}}) -%}
      {%- do shared.set('to_download', true) -%}
    {%- else -%}
      {%- do shared.set('to_routine', true) -%}
    {%- endif -%}
  {%- endif -%}
{%- endif -%}
{%- set item = {'user_login': login, 'user_name': login.split('@')[0], 'event': {'status': status, 'idempotency_id': module.rand.crypto.uuid4(), 'uid': uid, 'service': service, 'ip': ip, 'occurred_at': timestamp.isoformat(), 'org_id': params.org_id, 'is_system': false, 'meta': meta, 'request_id': module.rand.crypto.uuid4(), 'type': kind}} -%}
{{- item | tojson -}}
