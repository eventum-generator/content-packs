{%- for key in ['to_unusual_login', 'to_sensitive_view', 'to_public_link', 'to_download', 'to_routine'] -%}{%- do shared.pop(key, none) -%}{%- endfor -%}
{%- set stage = vars.stage -%}
{%- set row = samples.users.pick() -%}
{%- set actor = [row[0], row[1], row[2], row[3]] if not module.rand.chance(0.1) else ['admin', 'Администратор системы', params.compromised_uid, '198.51.100.90'] -%}
{%- set file = samples.files.pick() -%}
{%- set path = file[0] -%}
{%- set kind = 'disk_fs-view' -%}
{%- set public_rights = none -%}
{%- set links = shared.get('public_links', {}) -%}
{%- if stage == 'routine' -%}
  {%- set count = (shared.get('routine_count', 0) + 1) % 160 -%}{%- do shared.set('routine_count', count) -%}
  {%- if count == 20 -%}
    {%- set actor = ['admin', 'Администратор системы', params.compromised_uid, params.alternate_ip] -%}
    {%- set kind = 'id_cookie.set' -%}
  {%- elif count == 40 -%}
    {%- set actor = ['admin', 'Администратор системы', params.compromised_uid, params.alternate_ip] -%}
    {%- set kind = 'disk_fs-view' -%}{%- set path = params.sensitive_path -%}
  {%- elif count == 60 -%}
    {%- set actor = ['admin', 'Администратор системы', params.compromised_uid, params.alternate_ip] -%}
    {%- set kind = 'disk_fs-set-public' -%}{%- set path = params.sensitive_path -%}
    {%- set public_rights = {'macros': 'all', 'rights': 'read'} -%}
    {%- do links.update({path: actor}) -%}{%- do shared.set('public_links', links) -%}
  {%- elif count == 80 -%}
    {%- set actor = ['admin', 'Администратор системы', params.compromised_uid, params.alternate_ip] -%}
    {%- set kind = 'disk_fs-get-download-url' -%}{%- set path = params.sensitive_path -%}
  {%- elif count in [100, 140] and params.sensitive_path in links -%}
    {%- set kind = 'disk_fs-set-private' -%}{%- set path = params.sensitive_path -%}
    {%- set actor = links.pop(path) -%}{%- do shared.set('public_links', links) -%}
  {%- else -%}
    {%- set kind = module.rand.weighted_choice(['id_cookie.set', 'disk_fs-view', 'disk_fs-get-download-url', 'disk_fs-store', 'disk_fs-set-public', 'disk_fs-set-private'], [25, 37, 18, 12, 5, 3]) -%}
    {%- if kind == 'disk_fs-set-public' -%}
      {%- set available = [] -%}
      {%- for candidate in samples.files -%}{%- if candidate[0] not in links -%}{%- do available.append(candidate) -%}{%- endif -%}{%- endfor -%}
      {%- if available -%}
        {%- set path = module.rand.choice(available)[0] -%}
        {%- set public_rights = {'macros': module.rand.weighted_choice(['employees', 'all'], [85, 15]), 'rights': 'read'} -%}
        {%- do links.update({path: actor}) -%}{%- do shared.set('public_links', links) -%}
      {%- else -%}{%- set kind = 'disk_fs-view' -%}{%- endif -%}
    {%- elif kind == 'disk_fs-set-private' -%}
      {%- set open_regular = [] -%}
      {%- for candidate in samples.files -%}{%- if candidate[0] in links -%}{%- do open_regular.append(candidate[0]) -%}{%- endif -%}{%- endfor -%}
      {%- if open_regular -%}
        {%- set path = module.rand.choice(open_regular) -%}
        {%- set actor = links.pop(path) -%}{%- do shared.set('public_links', links) -%}
      {%- else -%}{%- set kind = 'disk_fs-view' -%}{%- endif -%}
    {%- endif -%}
  {%- endif -%}
  {%- if count == 120 and params.anomaly_mode and not shared.get('anomaly_done', false) -%}
    {%- do shared.set('anomaly_done', true) -%}{%- do shared.set('to_unusual_login', true) -%}
  {%- endif -%}
{%- else -%}
  {%- set actor = ['admin', 'Администратор системы', params.compromised_uid, params.alternate_ip] -%}
  {%- set path = params.sensitive_path -%}
  {%- set kind = {'unusual_login': 'id_cookie.set', 'sensitive_view': 'disk_fs-view', 'public_link': 'disk_fs-set-public', 'download': 'disk_fs-get-download-url'}[stage] -%}
  {%- if stage == 'unusual_login' -%}{%- do shared.set('to_sensitive_view', true) -%}{%- endif -%}
  {%- if stage == 'sensitive_view' -%}{%- do shared.set('to_public_link', true) -%}{%- endif -%}
  {%- if stage == 'public_link' -%}
    {%- set public_rights = {'macros': 'all', 'rights': 'read'} -%}
    {%- do links.update({path: actor}) -%}{%- do shared.set('public_links', links) -%}
    {%- do shared.set('to_download', true) -%}
  {%- endif -%}
  {%- if stage == 'download' -%}{%- do shared.set('to_routine', true) -%}{%- endif -%}
{%- endif -%}
{%- set login = params.compromised_login if actor[0] == 'admin' else actor[0] ~ '@' ~ params.organization_domain -%}
{%- set meta = {} -%}
{%- if kind == 'id_cookie.set' -%}
  {%- set service = 'ID' -%}
  {%- set meta = {'device_id': none if module.rand.chance(0.5) else '', 'revision': '1'} -%}
  {%- set request_id = '@' ~ module.rand.number.integer(100000, 999999) ~ ',' ~ (timestamp.timestamp()|int) ~ '.' ~ module.rand.string.digits(7) ~ ',' ~ module.rand.string.digits(16) ~ ',' ~ module.rand.string.hex(32) ~ ',' ~ actor[2] ~ ',' ~ login -%}
{%- else -%}
  {%- set service = 'Web' -%}
  {%- set meta = {'unixtime': timestamp.timestamp()|int, 'tgt_rawaddress': path, 'resource_name': path.split('/')[-1]} -%}
  {%- if kind != 'disk_fs-set-private' -%}
    {%- set media_type = 'application/pdf' if path.endswith('.pdf') else ('application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' if path.endswith('.xlsx') else 'application/octet-stream') -%}
    {%- do meta.update({'resource_type': 'file', 'resource_media_type': media_type}) -%}
  {%- endif -%}
  {%- if public_rights -%}{%- do meta.update({'public_rights': public_rights}) -%}{%- endif -%}
  {%- set request_id = module.rand.crypto.uuid4() -%}
{%- endif -%}
{%- set item = {'user_login': login, 'user_name': actor[1], 'event': {'status': 'Success', 'idempotency_id': module.rand.crypto.uuid4(), 'uid': actor[2], 'service': service, 'ip': actor[3], 'occurred_at': timestamp.isoformat(), 'org_id': params.org_id, 'is_system': false, 'meta': meta, 'request_id': request_id, 'type': kind}} -%}
{{- item | tojson -}}
