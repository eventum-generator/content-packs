{%- set step = vars.step -%}
{%- set kind = step -%}
{%- if step == 'routine' -%}
  {%- do shared.pop('to_attack', none) -%}
  {%- set count = shared.get('routine_count', 0) + 1 -%}
  {%- if count >= params.anomaly_interval_events -%}
    {%- do shared.set('routine_count', 0) -%}
    {%- if params.anomaly_mode -%}{%- do shared.set('to_attack', true) -%}{%- endif -%}
  {%- else -%}
    {%- do shared.set('routine_count', count) -%}
  {%- endif -%}
  {%- set kind = module.rand.weighted_choice(['normal_login','normal_logout','normal_fail','normal_config'],[65,20,10,5]) -%}
{%- endif -%}
{%- set seq = (shared.get('sequence', 100000) % 99999999) + 1 -%}
{%- do shared.set('sequence', seq) -%}
{%- set version = shared.get('config_version', 2700) -%}
{%- set actor = params.anomaly_admin if kind in ['login_fail_1','login_fail_2','login_fail_3','login_success','disable_auth_logging','delete_collector'] else params.normal_admin -%}
{%- set src = params.anomaly_admin_ip if actor == params.anomaly_admin else params.normal_admin_ip -%}
{%- set code = '51001' -%}
{%- set desc = 'Administrator-Login: Administrator authentication succeeded' -%}
{%- set outcome = 'success' -%}
{%- set event_type = ['admin','info'] -%}
{%- set category = ['iam','authentication'] -%}
{%- set action = 'administrator-login' -%}
{%- set operation = 'Administrator authentication successful.' -%}
{%- set detail = {} -%}
{%- if kind in ['login_fail_1','login_fail_2','login_fail_3','normal_fail'] -%}
  {%- set code = '51000' -%}
  {%- set desc = 'Administrator-Login: Administrator authentication failed' -%}
  {%- set operation = 'Authentication failed due to invalid user or password' -%}
  {%- set outcome = 'failure' -%}
  {%- set event_type = ['admin','denied'] -%}
{%- elif kind == 'normal_logout' -%}
  {%- set code = '51002' -%}
  {%- set desc = 'Administrator-Login: Administrator logged off' -%}
  {%- set operation = 'User logged out' -%}
  {%- set event_type = ['admin','end'] -%}
{%- elif kind in ['normal_config','disable_auth_logging'] -%}
  {%- set code = '52001' -%}
  {%- set desc = 'Configuration-Changes: Changed configuration' -%}
  {%- set operation = 'LoggingCategories "Passed Authentications" has been edited successfully.' if kind == 'disable_auth_logging' else 'LoggingCategories "System Statistics" has been edited successfully.' -%}
  {%- set target = 'Passed Authentications' if kind == 'disable_auth_logging' else 'System Statistics' -%}
  {%- set local = 'disable' if kind == 'disable_auth_logging' else 'enable' -%}
  {%- set assigned = '{}' if kind == 'disable_auth_logging' else '{LogCollector}' -%}
  {%- set change = 'Object modified: Local Logging = ' ~ local ~ '; Assigned Targets = ' ~ assigned -%}
  {%- set action = 'configuration-changes' -%}
  {%- set category = ['iam','configuration'] -%}
  {%- set event_type = ['change','info'] -%}
  {%- do detail.update({'config_change':{'data':change,'attributes':[{'name':'Local Logging','value':local},{'name':'Assigned Targets','value':[] if kind == 'disable_auth_logging' else ['LogCollector']}]},'component':'Administration','object':{'type':'UPSCategory','name':target},'local_logging':local,'assigned_targets':[] if kind == 'disable_auth_logging' else ['LogCollector'],'failure':{'flag':false},'request_response':{'type':'initial'}}) -%}
  {%- set version = version + 1 -%}{%- do shared.set('config_version', version) -%}
{%- elif kind == 'delete_collector' -%}
  {%- set code = '52002' -%}
  {%- set desc = 'Configuration-Changes: Deleted configuration' -%}
  {%- set change = 'Object deleted: Name=RemoteCollector; IP Address=10.40.0.20' -%}
  {%- set action = 'configuration-changes' -%}
  {%- set category = ['iam','configuration'] -%}
  {%- set event_type = ['deletion','info'] -%}
  {%- set operation = '' -%}
  {%- do detail.update({'config_change':{'data':change},'object':{'type':'UPSLogTarget','name':'RemoteCollector','internal':{'id':'38bcf4bf-f61a-4028-8b69-ef94eceb2a8d'}},'component':'Administration'}) -%}
  {%- set version = version + 1 -%}{%- do shared.set('config_version', version) -%}
{%- endif -%}
{%- set mid = '%010d' % seq -%}
{%- set pre = timestamp.strftime('%Y-%m-%d %H:%M:%S.%f')[:-3] ~ ' +00:00 ' ~ mid ~ ' ' ~ code ~ ' NOTICE ' ~ desc ~ ', ConfigVersionId=' ~ version ~ ', AdminInterface=GUI, AdminIPAddress=' ~ src ~ ', ' -%}
{%- set pre = pre ~ ('AdminSession=AdminGUI_Session, ' if code in ['51001','51002'] else '') ~ 'AdminName=' ~ actor ~ ', ' -%}
{%- if code in ['51000','51001','51002'] -%}
  {%- set pre = pre ~ 'OperationMessageText=' ~ operation ~ ',' -%}
{%- elif code == '52001' -%}
  {%- set pre = pre ~ 'FailureFlag=false, RequestResponseType=initial, ConfigChangeData=' ~ change ~ ', ObjectType=UPSCategory, ObjectName=' ~ target ~ ', OperationMessageText=' ~ operation ~ ',' -%}
{%- else -%}
  {%- set pre = pre ~ 'ConfigChangeData=' ~ change ~ ', ObjectType=UPSLogTarget, ObjectName=RemoteCollector,' -%}
{%- endif -%}
{%- set original = '<181>' ~ timestamp.strftime('%b %d %H:%M:%S') ~ ' ' ~ params.ise_name ~ ' CISE_Administrative_and_Operational_Audit ' ~ mid ~ ' 1 0 ' ~ pre -%}
{%- set cise = {'acs':{'instance':params.ise_name},'admin':{'interface':'GUI'},'category':{'name':'CISE_Administrative_and_Operational_Audit'},'config_version':{'id':version},'message':{'code':code,'description':desc,'id':mid},'segment':{'number':0,'total':1}} -%}
{%- if code in ['51001','51002'] -%}{%- do cise.admin.update({'session':'AdminGUI_Session'}) -%}{%- endif -%}
{%- if operation -%}{%- do cise.update({'operation_message':{'text':operation}}) -%}{%- endif -%}
{%- do cise.update(detail) -%}
{%- set out = {'@timestamp':timestamp.isoformat(),'ecs':{'version':'8.17.0'},'event':{'action':action,'category':category,'code':code,'dataset':'cisco_ise.log','kind':'event','original':original,'outcome':outcome,'sequence':seq,'timezone':'+00:00','type':event_type},'agent':{'ephemeral_id':'15e00000-1111-4444-8888-123456789abc','id':'15e00000-1111-4444-8888-123456789abc','name':'syslog-collector','type':'filebeat','version':'8.17.0'},'elastic_agent':{'id':'15e00000-1111-4444-8888-123456789abc','snapshot':false,'version':'8.17.0'},'cisco_ise':{'log':cise},'client':{'ip':src,'user':{'name':actor}},'data_stream':{'dataset':'cisco_ise.log','namespace':'default','type':'logs'},'host':{'hostname':params.ise_name,'ip':[params.ise_ip]},'input':{'type':'udp'},'log':{'level':'notice','source':{'address':params.ise_ip ~ ':514'},'syslog':{'priority':181,'severity':{'name':'notice'}}},'message':pre,'related':{'hosts':[params.ise_name],'ip':[src,params.ise_ip],'user':[actor]},'tags':['preserve_original_event','cisco-ise','forwarded'],'user':{'name':actor}} -%}
{{- out | tojson -}}
