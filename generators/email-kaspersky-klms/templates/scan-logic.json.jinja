{%- set tick = (shared.get('tick', -1) + 1) % 160 -%}
{%- do shared.set('tick', tick) -%}
{%- if params.anomaly_mode and tick == 120 and not shared.get('anomaly_done', false) -%}
  {%- do shared.set('anomaly_done', true) -%}{%- do shared.set('chain_step', 0) -%}
{%- endif -%}
{%- set step = shared.get('chain_step', -1) -%}
{%- set in_chain = step >= 0 -%}
{%- set special = in_chain or tick in [20, 40, 60, 80, 81] -%}
{%- set av = (in_chain and step == 3) or tick == 81 -%}
{%- if not in_chain and not special -%}
  {%- set av = shared.get('last_message') is not none and module.rand.chance(0.12) -%}
{%- endif -%}
{%- if av -%}
  {%- set message = shared.pop('last_message') -%}
  {%- set message_id = message[0] -%}
  {%- set relay_ip = message[1] -%}
  {%- set sender = message[2] -%}
  {%- set recipient = message[3] -%}
  {%- set size = message[4] -%}
{%- else -%}
  {%- set message_id = module.rand.string.hex(16) -%}
  {%- set relay_ip = params.unusual_relay_ip if special else module.rand.choice(['198.51.100.11', '198.51.100.12', '198.51.100.13']) -%}
  {%- set sender = params.unusual_sender if special else module.rand.choice(['news@partner.example.test', 'alerts@vendor.example.test', 'orders@shop.example.test']) -%}
  {%- set recipient = params.target_recipient if special else module.rand.choice(['ops@example.test', 'support@example.test', 'sales@example.test']) -%}
  {%- set size = module.rand.number.clamp(module.rand.number.lognormal(10, 1.2) | int, 500, 30000000) -%}
  {%- do shared.set('last_message', [message_id, relay_ip, sender, recipient, size]) -%}
{%- endif -%}
{%- set failed = (in_chain and step < 3) or tick in [20, 40, 60, 80] -%}
{%- if not av and not failed and not special -%}{%- set failed = module.rand.chance(0.07) -%}{%- endif -%}
{%- set infected = av and (in_chain or tick == 81 or module.rand.chance(0.08)) -%}
{%- set class_id = 'LMS_EV_SCAN_LOGIC_AV_STATUS' if av else 'LMS_EV_SCAN_LOGIC_MA_STATUS' -%}
{%- set name = 'antivirus scan status' if av else 'mail authentication status' -%}
{%- set act = 'Reject' if infected or failed else 'Skip' -%}
{%- set status = ('Infected' if infected else 'Clean') if av else ('ViolationFound' if failed else 'ViolationNotFound') -%}
{%- set fields = ['cs1=' ~ message_id, 'cs1Label=MessageId', 'src=' ~ relay_ip, 'act=' ~ act,
  'fsize=' ~ size, 'suser=' ~ sender, 'duser=' ~ recipient,
  'cs2=Default', 'cs2Label=Rules'] -%}
{%- if not av -%}
  {%- set verdict = 'Fail' if failed else 'Pass' -%}
  {%- do fields.extend(['cs4=' ~ verdict, 'cs4Label=SpfVerdict',
    'cs5=' ~ verdict, 'cs5Label=DkimVerdict',
    'cs6=' ~ verdict, 'cs6Label=DmarcVerdict']) -%}
{%- endif -%}
{%- do fields.append('outcome=' ~ status) -%}
{%- set raw = timestamp.strftime('%B %d, %Y %H:%M:%S') ~ ' ' ~ params.mail_host
  ~ ' CEF:0|AO Kaspersky Lab|Kaspersky Linux Mail Security|'
  ~ params.product_version ~ '|' ~ class_id ~ '|' ~ name ~ '|'
  ~ ('High' if infected else 'Low') ~ '|' ~ (fields | join(' ')) -%}
{%- set klms = {'class_id': class_id} -%}
{%- if not av -%}{%- do klms.update({'spf': verdict, 'dkim': verdict, 'dmarc': verdict}) -%}{%- endif -%}
{%- set record = {'@timestamp': timestamp.isoformat(),
  'ecs': {'version': '8.17.0'},
  'event': {'kind': 'event', 'dataset': 'kaspersky.klms',
    'category': ['malware'] if av else ['email'],
    'type': ['info'], 'code': class_id, 'action': act.lower(), 'original': raw},
  'observer': {'hostname': params.mail_host, 'vendor': 'Kaspersky',
    'product': 'Kaspersky Linux Mail Security', 'version': params.product_version},
  'source': {'ip': relay_ip},
  'email': {'local_id': message_id, 'from': {'address': [sender]}, 'to': {'address': [recipient]}},
  'kaspersky': {'klms': klms}} -%}
{%- if in_chain -%}
  {%- if step == 3 -%}{%- do shared.pop('chain_step') -%}
  {%- else -%}{%- do shared.set('chain_step', step + 1) -%}{%- endif -%}
{%- endif -%}
{{ record | tojson }}
