{%- from 'templates/_base.json.jinja' import render, arc_tick, arc_step,
    register_session, steer with context -%}
{#- CONNECT, accepted. The session opens here and the events that follow
    run inside it, reusing its ID, account and client. The credentials
    the intruder guessed open their session the same way - the account
    is legitimate, the source host is not.

    Only a successful credential check leads here, so the session it
    staged is the one that opens. -#}
{%- do arc_tick() -%}
{%- set auth = shared.get('last_auth') -%}
{%- do shared.set('picked', auth.s) -%}
{%- do register_session() -%}
{%- set s = shared.get('picked') -%}
{%- set is_breach = shared.get('arc', 'quiet') == 'breach' and auth.is_arc -%}
{%- if is_breach -%}
  {%- do shared.set('arc_session', s) -%}
{%- endif -%}
{%- set ev = {
    'policy_name': 'Z_session connect',
    'audit_level': 'INFO',
    'action': 'CONNECT',
    'action_status': 'SUCCESSFUL',
    'category': ['authentication', 'session'],
    'type': ['start']
} -%}
{%- if is_breach -%}
  {%- do arc_step() -%}
{%- endif -%}
{%- do steer(['data_read', 'auth_validate'], [88, 12]) -%}
{{ render(ev, s) }}
