{%- from 'templates/_base.json.jinja' import render, arc_tick, use_session,
    steer with context -%}
{#- EXECUTE on a stored procedure. The repository procedures that hand
    out activated roles fall under the design-time privilege policy
    rather than the procedure policy, because granting through them is
    an authorization change carried out by a procedure call. -#}
{%- do arc_tick() -%}
{%- do use_session('app') -%}
{%- set s = shared.get('picked') -%}
{%- set proc = samples.objects_procedures.weighted_pick('weight') -%}
{%- set repo = proc.schema == '_SYS_REPO' -%}
{%- set statement = 'CALL "' ~ proc.schema ~ '"."' ~ proc.object ~ '" ('
    ~ proc.args | join(', ') ~ ')' -%}
{%- set ev = {
    'policy_name': '_SAP_designtime privileges' if repo
                   else 'Z_procedure execution',
    'audit_level': 'INFO',
    'action': 'EXECUTE',
    'action_status': 'SUCCESSFUL' if module.rand.chance(0.96)
                     else 'UNSUCCESSFUL',
    'category': ['database'],
    'type': ['access'],
    'target_schema': proc.schema,
    'target_object': proc.object,
    'statement_string': statement
} -%}
{%- do steer(['data_read', 'auth_validate'], [88, 12]) -%}
{{ render(ev, s) }}
