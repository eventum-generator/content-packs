{%- from 'templates/_base.json.jinja' import render, arc_tick, use_session,
    steer with context -%}
{#- Changes to the system configuration, and to the license key that
    sits alongside them under its own two policies. A parameter change
    is the one action that fills the component, section, parameter, old
    value and new value positions of the trail, so the previous setting
    travels with the event - including the changes that weaken the
    system, such as auditing switched off or password lock time cut. -#}
{%- do arc_tick() -%}
{%- do use_session('admin') -%}
{%- set s = shared.get('picked') -%}
{%- set action = module.rand.weighted_choice(
    ['SYSTEM CONFIGURATION CHANGE', 'SET SYSTEM LICENSE', 'STOP SERVICE',
     'UNSET SYSTEM LICENSE'],
    [78, 10, 8, 4]) -%}
{%- set ev = {
    'policy_name': '_SAP_configuration changes',
    'audit_level': 'INFO',
    'action': action,
    'action_status': 'SUCCESSFUL' if module.rand.chance(0.95)
                     else 'UNSUCCESSFUL',
    'category': ['configuration'],
    'type': ['change']
} -%}
{%- if action == 'SYSTEM CONFIGURATION CHANGE' -%}
  {%- set change = samples.config_parameters.weighted_pick('weight') -%}
  {%- do ev.update({
      'component': change.component,
      'section': change.section,
      'parameter': change.parameter,
      'old_value': change.old,
      'new_value': change.new,
      'statement_string': 'ALTER SYSTEM ALTER CONFIGURATION (\''
          ~ change.component ~ '\', \'SYSTEM\') SET (\'' ~ change.section
          ~ '\', \'' ~ change.parameter ~ '\') = \'' ~ change.new
          ~ '\' WITH RECONFIGURE'
  }) -%}
{%- elif action == 'STOP SERVICE' -%}
  {%- do ev.update({
      'category': ['configuration', 'process'],
      'type': ['change', 'end'],
      'statement_string': 'ALTER SYSTEM STOP SERVICE (\''
          ~ params.hana_host.split('.')[0] ~ '\', ' ~ params.hana_port ~ ')'
  }) -%}
{%- elif action == 'SET SYSTEM LICENSE' -%}
  {%- do ev.update({
      'policy_name': '_SAP_license addition',
      'statement_string': 'SET SYSTEM LICENSE \'XXXXXXXXXXXXX\''
  }) -%}
{%- else -%}
  {%- do ev.update({
      'policy_name': '_SAP_license deletion',
      'type': ['deletion'],
      'statement_string': 'UNSET SYSTEM LICENSE ALL'
  }) -%}
{%- endif -%}
{%- do steer(['data_read', 'auth_validate'], [90, 10]) -%}
{{ render(ev, s) }}
