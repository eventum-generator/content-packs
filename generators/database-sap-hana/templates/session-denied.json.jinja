{%- from 'templates/_base.json.jinja' import render, arc_tick, steer
    with context -%}
{#- CONNECT, refused. Repeats the account and client of the credential
    check that failed - only a failed check leads here - and names the
    reason in the comment field, which is where HANA reports why a logon
    was rejected. -#}
{%- do arc_tick() -%}
{%- set auth = shared.get('last_auth') -%}
{%- set s = auth.s -%}
{%- set reason = auth.reason -%}
{%- set ev = {
    'policy_name': '_SAP_session connect',
    'audit_level': 'ALERT',
    'action': 'CONNECT',
    'action_status': 'UNSUCCESSFUL',
    'category': ['authentication', 'session'],
    'type': ['start'],
    'comment': reason
} -%}
{%- do steer(['auth_validate', 'data_read'], [58, 42]) -%}
{{ render(ev, s) }}
