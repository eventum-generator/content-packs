{%- from 'templates/_base.json.jinja' import render, arc_tick, use_session,
    steer with context -%}
{#- Backups taken, catalog entries deleted and, rarely, a recovery. The
    policy SAP recommends here covers manually executed statements, so
    a scheduled backup produces no event and every one of these was run
    by an administrator. -#}
{%- do arc_tick() -%}
{%- do use_session('admin') -%}
{%- set s = shared.get('picked') -%}
{%- set action = module.rand.weighted_choice(
    ['BACKUP DATA', 'BACKUP CATALOG DELETE', 'RECOVER DATA'], [76, 20, 4]) -%}
{%- set stamp = timestamp.strftime('%Y%m%d_%H%M') -%}
{%- if action == 'BACKUP DATA' -%}
  {%- set scope = module.rand.weighted_choice(
      ['COMPLETE', 'INCREMENTAL', 'DIFFERENTIAL'], [34, 48, 18]) -%}
  {%- if module.rand.chance(0.55) -%}
    {%- set statement = 'BACKUP DATA'
        ~ ('' if scope == 'COMPLETE' else ' ' ~ scope)
        ~ ' USING BACKINT (\'' ~ scope ~ '_' ~ stamp ~ '\')' -%}
  {%- else -%}
    {%- set statement = 'BACKUP DATA'
        ~ ('' if scope == 'COMPLETE' else ' ' ~ scope)
        ~ ' USING FILE (\'' ~ params.backup_path ~ '/' ~ scope ~ '_'
        ~ stamp ~ '\')' -%}
  {%- endif -%}
  {%- set type = ['admin'] -%}
{%- elif action == 'BACKUP CATALOG DELETE' -%}
  {%- set backup_id = ((timestamp - module.datetime.timedelta(
      days=module.rand.number.integer(14, 90))).timestamp() * 1000) | int -%}
  {%- set statement = 'BACKUP CATALOG DELETE ALL BEFORE BACKUP_ID '
      ~ backup_id -%}
  {%- set type = ['deletion'] -%}
{%- else -%}
  {%- set statement = 'RECOVER DATA USING FILE (\'' ~ params.backup_path
      ~ '/COMPLETE_' ~ stamp ~ '\') CLEAR LOG' -%}
  {%- set type = ['admin', 'change'] -%}
{%- endif -%}
{%- set ev = {
    'policy_name': '_SAP_recover database',
    'audit_level': 'INFO',
    'action': action,
    'action_status': 'SUCCESSFUL' if module.rand.chance(0.97)
                     else 'UNSUCCESSFUL',
    'category': ['database'],
    'type': type,
    'statement_string': statement
} -%}
{%- do steer(['data_read', 'auth_validate'], [92, 8]) -%}
{{ render(ev, s) }}
