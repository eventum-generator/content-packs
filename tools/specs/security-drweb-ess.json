{
 "timestamp": {"path": "@timestamp"},
 "actors": [
  {"name": "host", "path": "host.name"},
  {"name": "user", "path": "user.name"},
  {"name": "host_fail", "path": "host.name",
   "when": {"path": "event.outcome", "values": ["failure"]}},
  {"name": "auth_id", "path": "host.id",
   "when": {"path": "event.action", "values": ["station-authorization-failed", "station-id-duplicate"]}},
  {"name": "blocked_user", "path": "user.name",
   "when": {"path": "event.action", "values": ["application-control-blocked"]}},
  {"name": "preventive_user", "path": "user.name",
   "when": {"path": "event.action", "values": ["preventive-protection-allowed"]}},
  {"name": "detect_host", "path": "host.name",
   "when": {"path": "event.action", "values": ["security-threat-detected"]}},
  {"name": "infected_scan_host", "path": "host.name",
   "when": {"all": [{"path": "event.action", "values": ["scan-completed"]},
                    {"path": "message", "regex": " 1 infected\\.$"}]}},
  {"name": "file", "path": "file.path"}
 ],
 "action": {"paths": ["event.action"]},
 "target": {"paths": ["file.path"]},
 "failure": {"path": "event.outcome", "values": ["failure"]},
 "pairs": [
  {"name": "scan_run", "key": {"path": "host.name"},
   "open": {"path": "event.action", "values": ["security-threat-detected"]},
   "close": {"all": [{"path": "event.action", "values": ["scan-completed"]},
                     {"path": "message", "regex": " 1 infected\\.$"}]}}
 ],
 "chain_seq": {
  "key": {"path": "host.name"},
  "within": 5700,
  "steps": [
   {"match": {"path": "event.action", "values": ["application-control-blocked"]}, "bind": {"F": "file.path"}},
   {"match": {"path": "event.action", "values": ["preventive-protection-allowed"]}},
   {"match": {"path": "event.action", "values": ["security-threat-detected"]}, "eq": {"F": "file.path"}},
   {"match": {"all": [{"path": "event.action", "values": ["scan-completed"]},
                      {"path": "message", "regex": " 1 infected\\.$"}]}},
   {"match": {"path": "event.action", "values": ["station-authorization-failed"]}},
   {"match": {"path": "event.action", "values": ["station-id-duplicate"]}}
  ]
 }
}
