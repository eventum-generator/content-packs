{
 "timestamp": {"path": "@timestamp"},
 "actors": [
  {"name": "endpoint", "path": "host.name"},
  {"name": "endpoint_file", "paths": ["host.name", "file.path"], "target": {"paths": ["sophos_central.event.threat"]},
   "when": {"path": "sophos_central.event.group", "values": ["MALWARE", "PUA"]}},
  {"name": "failing_endpoint", "path": "host.name",
   "when": {"path": "event.code", "values": ["Event::Endpoint::Threat::CleanupFailed", "Event::Endpoint::Threat::PuaCleanupFailed"]}},
  {"name": "detecting_endpoint", "path": "host.name",
   "when": {"path": "event.code", "values": ["Event::Endpoint::Threat::Detected"]}},
  {"name": "threat", "path": "sophos_central.event.threat"}
 ],
 "action": {"paths": ["event.code"]},
 "target": {"paths": ["file.path"]},
 "include": {"path": "sophos_central.event.group", "values": ["MALWARE", "PUA", "UPDATING", "PROTECTION"]},
 "failure": {"path": "event.code", "values": ["Event::Endpoint::Threat::CleanupFailed", "Event::Endpoint::Threat::PuaCleanupFailed"]},
 "success": {"path": "event.code", "values": ["Event::Endpoint::Threat::CleanedUp"]},
 "chain_seq": {
  "key": {"paths": ["host.name", "sophos_central.event.threat", "file.path"]},
  "within": 7200,
  "steps": [
   {"match": {"path": "event.code", "values": ["Event::Endpoint::Threat::Detected"]}},
   {"match": {"path": "event.code", "values": ["Event::Endpoint::Threat::CleanupFailed"]}},
   {"match": {"path": "event.code", "values": ["Event::Endpoint::Threat::Detected"]}},
   {"match": {"path": "event.code", "values": ["Event::Endpoint::Threat::CleanedUp"]}}
  ]
 },
 "pairs": [
  {"name": "detect_to_clean", "key": {"paths": ["host.name", "file.path"]},
   "open": {"path": "event.code", "values": ["Event::Endpoint::Threat::Detected"]},
   "close": {"path": "event.code", "values": ["Event::Endpoint::Threat::CleanedUp"]}}
 ],
 "features": [
  {"name": "detect_twice", "key": {"paths": ["host.name", "file.path"]}, "within": 3600,
   "steps": [
    {"match": {"path": "event.code", "values": ["Event::Endpoint::Threat::Detected"]}},
    {"match": {"path": "event.code", "values": ["Event::Endpoint::Threat::Detected"]}}
   ]},
  {"name": "fail_then_manual_clean", "key": {"paths": ["host.name", "file.path"]}, "within": 7200,
   "steps": [
    {"match": {"path": "event.code", "values": ["Event::Endpoint::Threat::CleanupFailed"]}},
    {"match": {"path": "event.code", "values": ["Event::Endpoint::Threat::CleanedUp"]}}
   ]}
 ],
 "day_s": 86400,
 "near_s": 3600,
 "text_time_paths": ["event.original"],
 "skip_const_paths_regex": "^(ecs\\.version|organization\\.id|event\\.severity)$"
}
