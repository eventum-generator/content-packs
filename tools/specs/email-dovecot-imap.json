{
 "timestamp": {
  "path": "@timestamp"
 },
 "actors": [
  {
   "name": "user",
   "path": "user.name"
  },
  {
   "name": "ip",
   "path": "source.ip"
  },
  {
   "name": "pair",
   "paths": [
    "user.name",
    "source.ip"
   ]
  },
  {
   "name": "user_fail",
   "path": "user.name",
   "when": {
    "path": "event.action",
    "values": [
     "login-failure"
    ]
   }
  },
  {
   "name": "ip_fail",
   "path": "source.ip",
   "when": {
    "path": "event.action",
    "values": [
     "login-failure"
    ]
   }
  },
  {
   "name": "pair_fail",
   "paths": [
    "user.name",
    "source.ip"
   ],
   "when": {
    "path": "event.action",
    "values": [
     "login-failure"
    ]
   }
  },
  {
   "name": "pair_pop3",
   "paths": [
    "user.name",
    "source.ip"
   ],
   "when": {
    "path": "service.type",
    "values": [
     "pop3"
    ]
   }
  }
 ],
 "action": {
  "paths": [
   "event.action",
   "service.type",
   "source.ip"
  ],
  "regex": "^(login-\\w+|imap|pop3|10\\.8|10|\\d+)"
 },
 "failure": {
  "path": "event.action",
  "values": [
   "login-failure"
  ]
 },
 "success": {
  "path": "event.action",
  "values": [
   "login-success"
  ]
 },
 "chain_seq": {
  "key": {
   "path": "user.name"
  },
  "same": [
   "source.ip"
  ],
  "within": 900,
  "steps": [
   {
    "match": {
     "path": "event.action",
     "values": [
      "login-failure"
     ]
    }
   },
   {
    "match": {
     "path": "event.action",
     "values": [
      "login-failure"
     ]
    }
   },
   {
    "match": {
     "path": "event.action",
     "values": [
      "login-failure"
     ]
    }
   },
   {
    "match": {
     "path": "event.action",
     "values": [
      "login-failure"
     ]
    }
   },
   {
    "match": {
     "all": [
      {
       "path": "event.action",
       "values": [
        "login-success"
       ]
      },
      {
       "path": "service.type",
       "values": [
        "imap"
       ]
      }
     ]
    }
   },
   {
    "match": {
     "all": [
      {
       "path": "event.action",
       "values": [
        "login-success"
       ]
      },
      {
       "path": "service.type",
       "values": [
        "pop3"
       ]
      }
     ]
    }
   }
  ]
 },
 "text_time_paths": [
  "event.original"
 ]
}