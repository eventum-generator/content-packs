{
 "timestamp": {"path": "@timestamp"},
 "actors": [
  {"name": "service", "path": "event.original", "regex": "<Data Name='(?:ServiceName|param1)'>([^<]+)<"},
  {"name": "host", "path": "host.name"},
  {"name": "service_host", "paths": ["host.name", "winlog.event_data.param1"],
   "when": {"path": "event.code", "values": ["7036", "7034", "7040"]}},
  {"name": "installer", "path": "winlog.user.identifier",
   "when": {"path": "event.code", "values": ["7045"]}},
  {"name": "installer_host", "paths": ["winlog.user.identifier", "host.name"],
   "when": {"path": "event.code", "values": ["7045", "7040"]}},
  {"name": "installer_service", "paths": ["winlog.user.identifier", "winlog.event_data.ServiceName"],
   "when": {"path": "event.code", "values": ["7045"]}},
  {"name": "crash_service_host", "paths": ["host.name", "winlog.event_data.param1"],
   "when": {"path": "event.code", "values": ["7034"]}}
 ],
 "action": {"paths": ["event.code"]},
 "target": {"paths": ["host.name"]},
 "failure": {"path": "event.code", "values": ["7034"]},
 "pairs": [
  {"name": "service_run", "key": {"paths": ["host.name", "winlog.event_data.param1"]},
   "open": {"all": [{"path": "event.code", "values": ["7036"]}, {"path": "winlog.event_data.param2", "values": ["running"]}]},
   "close": {"any": [{"path": "event.code", "values": ["7034"]},
                     {"all": [{"path": "event.code", "values": ["7036"]}, {"path": "winlog.event_data.param2", "values": ["stopped"]}]}]}}
 ],
 "chain_seq": {
  "key": {"path": "event.original", "regex": "<Data Name='(?:ServiceName|param1)'>([^<]+)<"},
  "within": 1800,
  "steps": [
   {"match": {"path": "event.code", "values": ["7045"]},
    "bind": {"H": "host.name", "U": "winlog.user.identifier", "P": "winlog.event_data.ImagePath"}},
   {"match": {"all": [{"path": "event.code", "values": ["7040"]}, {"path": "winlog.event_data.param3", "values": ["auto start"]}]},
    "eq": {"H": "host.name"}},
   {"match": {"all": [{"path": "event.code", "values": ["7036"]}, {"path": "winlog.event_data.param2", "values": ["running"]}]},
    "eq": {"H": "host.name"}},
   {"match": {"path": "event.code", "values": ["7045"]},
    "ne": {"H": "host.name"}, "eq": {"U": "winlog.user.identifier", "P": "winlog.event_data.ImagePath"},
    "bind": {"H2": "host.name"}},
   {"match": {"all": [{"path": "event.code", "values": ["7040"]}, {"path": "winlog.event_data.param3", "values": ["auto start"]}]},
    "eq": {"H2": "host.name"}},
   {"match": {"all": [{"path": "event.code", "values": ["7036"]}, {"path": "winlog.event_data.param2", "values": ["running"]}]},
    "eq": {"H2": "host.name"}}
  ]
 },
 "features": [
  {"name": "same_install_two_hosts",
   "key": {"path": "event.original", "regex": "<Data Name='(?:ServiceName|param1)'>([^<]+)<"},
   "within": 1800,
   "steps": [
    {"match": {"path": "event.code", "values": ["7045"]},
     "bind": {"H": "host.name", "U": "winlog.user.identifier"}},
    {"match": {"path": "event.code", "values": ["7045"]},
     "ne": {"H": "host.name"}, "eq": {"U": "winlog.user.identifier"}}
   ]}
 ],
 "notes": "Chain: one account installs the same service (same image) on two hosts within 30 min, switching it to automatic start and starting it on each. Guard in the template mirrors this matcher and drops a background final 7036 running."
}
