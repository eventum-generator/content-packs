{
 "timestamp": {"path": "event.occurred_at"},
 "actors": [
  {"name": "client", "paths": ["event.uid", "event.ip"]},
  {"name": "uid", "path": "event.uid"},
  {"name": "ip", "path": "event.ip"},
  {"name": "client_core", "paths": ["event.uid", "event.ip"],
   "when": {"path": "event.type", "values": ["id_cookie.set", "disk_fs-view", "disk_fs-set-public", "disk_fs-get-download-url"]}},
  {"name": "uid_publish", "path": "event.uid",
   "when": {"path": "event.type", "values": ["disk_fs-set-public"]}}
 ],
 "action": {"paths": ["event.type", "event.meta.public_rights.macros"]},
 "target": {"paths": ["event.meta.tgt_rawaddress", "event.meta.public_rights.macros"]},
 "pairs": [
  {"name": "public_link", "key": {"paths": ["event.uid", "event.meta.tgt_rawaddress"]},
   "open": {"path": "event.type", "values": ["disk_fs-set-public"]},
   "close": {"path": "event.type", "values": ["disk_fs-set-private"]}}
 ],
 "chain_seq": {
  "key": {"paths": ["event.uid", "event.ip"]},
  "within": 900,
  "steps": [
   {"match": {"path": "event.type", "values": ["id_cookie.set"]}},
   {"match": {"path": "event.type", "values": ["disk_fs-view"]}, "bind": {"F": "event.meta.tgt_rawaddress"}},
   {"match": {"all": [{"path": "event.type", "values": ["disk_fs-set-public"]},
                      {"path": "event.meta.public_rights.macros", "values": ["all"]}]},
    "eq": {"F": "event.meta.tgt_rawaddress"}},
   {"match": {"path": "event.type", "values": ["disk_fs-get-download-url"]}, "eq": {"F": "event.meta.tgt_rawaddress"}}
  ]
 }
}
