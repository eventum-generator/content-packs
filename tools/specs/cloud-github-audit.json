{
 "timestamp": {"path": "@timestamp"},
 "actors": [
  {"name": "user", "path": "user.name"},
  {"name": "repo", "path": "github.repo"},
  {"name": "user_repo", "paths": ["user.name", "github.repo"]},
  {"name": "owner_admin", "path": "user.name",
   "when": {"path": "event.action", "values": ["repo.add_member", "repo.update_member", "repo.remove_member", "protected_branch.destroy", "protected_branch.create", "repo.destroy", "repo.create"]},
   "target": {"path": "github.repo"}},
  {"name": "member_target", "path": "user.target.name",
   "when": {"path": "event.action", "values": ["repo.add_member", "repo.update_member", "repo.remove_member"]}}
 ],
 "action": {"paths": ["event.action"]},
 "target": {"paths": ["github.repo"]},
 "chain_seq": {
  "key": {"path": "github.repo"},
  "within": 1800,
  "steps": [
   {"match": {"all": [{"path": "event.action", "values": ["repo.add_member"]}, {"path": "github.permission", "values": ["write"]}]},
    "bind": {"O": "user.name", "X": "user.target.name"}},
   {"match": {"all": [{"path": "event.action", "values": ["repo.update_member"]}, {"path": "github.old_repo_permission", "values": ["write"]}, {"path": "github.new_repo_permission", "values": ["admin"]}]},
    "eq": {"O": "user.name", "X": "user.target.name"}},
   {"match": {"path": "event.action", "values": ["protected_branch.destroy"]}, "eq": {"O": "user.name"}},
   {"match": {"path": "event.action", "values": ["repo.download_zip"]}, "eq": {"X": "user.name"}},
   {"match": {"path": "event.action", "values": ["repo.destroy"]}, "eq": {"O": "user.name"}}
  ]
 }
}
