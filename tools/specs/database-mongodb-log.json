  "within": 1800,
  "steps": [
   {"match": {"path": "mongodb.log.id", "values": [5286307]}, "bind": {"U": "mongodb.log.attr.user"}},
   {"match": {"path": "mongodb.log.id", "values": [5286307]}, "eq": {"U": "mongodb.log.attr.user"}},
   {"match": {"path": "mongodb.log.id", "values": [5286307]}, "eq": {"U": "mongodb.log.attr.user"}},
   {"match": {"path": "mongodb.log.id", "values": [5286306]}, "eq": {"U": "mongodb.log.attr.user"}},
