{
 "timestamp": {"path": "@timestamp"},
 "actors": [
  {"name": "source", "path": "source.ip", "target": {"paths": ["host.name"]}},
  {"name": "pair", "paths": ["source.ip", "host.name"], "target": {"paths": ["destination.port"]}},
  {"name": "denied", "path": "source.ip",
   "when": {"path": "event.action", "values": ["deny"]},
   "target": {"paths": ["host.name"]}},
  {"name": "pair_denied", "paths": ["source.ip", "host.name"],
   "when": {"path": "event.action", "values": ["deny"]},
   "target": {"paths": ["destination.port"]}},
  {"name": "ips_source", "path": "source.ip",
   "when": {"path": "event.action", "values": ["ids:reset"]},
   "target": {"paths": ["host.name"]}},
  {"name": "pair_ips", "paths": ["source.ip", "host.name"],
   "when": {"path": "event.action", "values": ["ids:reset"]},
   "target": {"paths": ["rule.id"]}},
  {"name": "host", "path": "host.name", "target": {"paths": ["source.ip"]}}
 ],
 "action": {"paths": ["event.action", "destination.port"]},
 "target": {"paths": ["host.name"]},
 "failure": {"path": "event.action", "values": ["deny"]},
 "success": {"path": "event.action", "values": ["log"]},
 "chain_seq": {
  "key": {"path": "source.ip"},
  "within": 3600,
  "steps": [
   {"match": {"path": "event.action", "values": ["deny"]},
    "bind": {"H": "host.name", "P1": "destination.port"}},
   {"match": {"path": "event.action", "values": ["deny"]},
    "eq": {"H": "host.name"}, "ne": {"P1": "destination.port"},
    "bind": {"P2": "destination.port"}},
   {"match": {"path": "event.action", "values": ["deny"]},
    "eq": {"H": "host.name"}, "ne": {"P1,P2": "destination.port"}},
   {"match": {"path": "event.action", "values": ["ids:reset"]},
    "eq": {"H": "host.name"}}
  ]
 }
}
