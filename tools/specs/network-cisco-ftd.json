{
 "timestamp": {"path": "@timestamp"},
 "actors": [
  {"name": "client", "path": "source.ip", "target": {"paths": ["destination.ip"]}},
  {"name": "pair", "paths": ["source.ip", "destination.ip"], "target": {"paths": ["destination.port"]}},
  {"name": "drop_client", "path": "source.ip",
   "when": {"all": [
    {"path": "event.code", "values": ["430001"]},
    {"path": "cisco.ftd.security_event.inline_result", "values": ["Dropped"]}]},
   "target": {"paths": ["cisco.ftd.security.sid"]}},
  {"name": "drop_pair", "paths": ["source.ip", "destination.ip"],
   "when": {"all": [
    {"path": "event.code", "values": ["430001"]},
    {"path": "cisco.ftd.security_event.inline_result", "values": ["Dropped"]}]},
   "target": {"paths": ["cisco.ftd.security.sid"]}},
  {"name": "https_pair", "paths": ["source.ip", "destination.ip"],
   "when": {"all": [
    {"path": "event.code", "values": ["430002"]},
    {"path": "destination.port", "values": [443]}]}}
 ],
 "action": {"paths": ["event.code", "cisco.ftd.security_event.access_control_rule_action", "destination.port", "cisco.ftd.security.sid"]},
 "target": {"paths": ["destination.ip"]},
 "failure": {"all": [
  {"path": "event.code", "values": ["430001"]},
  {"path": "cisco.ftd.security_event.inline_result", "values": ["Dropped"]}]},
 "success": {"all": [
  {"path": "event.code", "values": ["430002"]},
  {"path": "cisco.ftd.security_event.access_control_rule_action", "values": ["Allow"]}]},
 "pairs": [
  {"name": "connection",
   "key": {"paths": ["cisco.ftd.security_event.instance_id", "cisco.ftd.security_event.connection_id", "cisco.ftd.security_event.first_packet_second"]},
   "open": {"path": "event.code", "values": ["430002"]},
   "close": {"path": "event.code", "values": ["430003"]}}
 ],
 "chain_seq": {
  "key": {"path": "source.ip"},
  "within": 3600,
  "steps": [
   {"match": {"all": [
     {"path": "event.code", "values": ["430001"]},
     {"path": "cisco.ftd.security_event.inline_result", "values": ["Dropped"]}]},
    "bind": {"W": "destination.ip", "S1": "cisco.ftd.security.sid"}},
   {"match": {"all": [
     {"path": "event.code", "values": ["430001"]},
     {"path": "cisco.ftd.security_event.inline_result", "values": ["Dropped"]}]},
    "eq": {"W": "destination.ip"}, "ne": {"S1": "cisco.ftd.security.sid"},
    "bind": {"S2": "cisco.ftd.security.sid"}},
   {"match": {"all": [
     {"path": "event.code", "values": ["430001"]},
     {"path": "cisco.ftd.security_event.inline_result", "values": ["Dropped"]}]},
    "eq": {"W": "destination.ip"}, "ne": {"S1,S2": "cisco.ftd.security.sid"}},
   {"match": {"all": [
     {"path": "event.code", "values": ["430002"]},
     {"path": "cisco.ftd.security_event.access_control_rule_action", "values": ["Allow"]},
     {"path": "destination.port", "values": [443]}]},
    "eq": {"W": "destination.ip"}}
  ]
 }
}
