{
 "timestamp": {"path": "@timestamp"},
 "actors": [
  {"name": "user", "path": "user.name"},
  {"name": "ip", "path": "source.ip"},
  {"name": "user_ip", "paths": ["user.name", "source.ip"]},
  {"name": "record", "path": "cucm.audit.record.key_value"},
  {"name": "user_cfg", "path": "user.name",
   "when": {"path": "cucm.audit.event_type", "values": ["GeneralConfigurationUpdate"]}},
  {"name": "user_add", "path": "user.name",
   "when": {"path": "event.action", "values": ["processnode_added"]}},
  {"name": "user_del", "path": "user.name",
   "when": {"path": "event.action", "values": ["processnode_deleted"]}},
  {"name": "user_record", "paths": ["user.name", "cucm.audit.record.key_value"],
   "when": {"path": "cucm.audit.event_type", "values": ["GeneralConfigurationUpdate"]}}
 ],
 "action": {"paths": ["event.action"]},
 "target": {"paths": ["cucm.audit.record.key_value"]},
 "pairs": [
  {"name": "session", "key": {"path": "user.name"},
   "open": {"path": "event.action", "values": ["user_login"]},
   "close": {"path": "event.action", "values": ["user_logout"]}},
  {"name": "record_life", "key": {"path": "cucm.audit.record.key_value"},
   "open": {"path": "event.action", "values": ["processnode_added"]},
   "close": {"path": "event.action", "values": ["processnode_deleted"]}}
 ],
 "chain_seq": {
  "key": {"path": "user.name"},
  "within": 7200,
  "steps": [
   {"match": {"path": "event.action", "values": ["processnode_added"]}, "bind": {"K": "cucm.audit.record.key_value"}},
   {"match": {"path": "event.action", "values": ["processnode_updated"]}, "eq": {"K": "cucm.audit.record.key_value"}},
   {"match": {"path": "event.action", "values": ["processnode_deleted"]}, "eq": {"K": "cucm.audit.record.key_value"}}
  ]
 },
 "features": [
  {"name": "add_then_delete", "key": {"path": "user.name"}, "within": 7200,
   "steps": [
    {"match": {"path": "event.action", "values": ["processnode_added"]}, "bind": {"K": "cucm.audit.record.key_value"}},
    {"match": {"path": "event.action", "values": ["processnode_deleted"]}, "eq": {"K": "cucm.audit.record.key_value"}}
   ]},
  {"name": "login_then_add", "key": {"path": "user.name"}, "within": 900,
   "steps": [
    {"match": {"path": "event.action", "values": ["user_login"]}},
    {"match": {"path": "event.action", "values": ["processnode_added"]}}
   ]}
 ],
 "text_time_paths": ["cucm.audit.timestamp_local"]
}
