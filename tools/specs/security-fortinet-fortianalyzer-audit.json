{
 "timestamp": {"path": "@timestamp"},
 "actors": [
  {"name": "user", "path": "user.name"},
  {"name": "user_ip", "paths": ["user.name", "source.ip"]},
  {"name": "incident", "path": "fortinet.fortianalyzer.incident_id"},
  {"name": "user_attach_delete", "path": "user.name",
   "when": {"path": "event.action", "values": ["Incident_Attachment_Delete"]}},
  {"name": "user_delete", "path": "user.name",
   "when": {"path": "event.action", "values": ["Incident_Delete"]}},
  {"name": "user_ip_removal", "paths": ["user.name", "source.ip"],
   "when": {"path": "event.action", "values": ["Incident_Attachment_Delete", "Incident_Delete"]}},
  {"name": "user_incident", "paths": ["user.name", "fortinet.fortianalyzer.incident_id"]}
 ],
 "action": {"paths": ["event.action"]},
 "target": {"paths": ["fortinet.fortianalyzer.incident_id"]},
 "chain_seq": {
  "key": {"path": "fortinet.fortianalyzer.incident_id"},
  "within": 7200,
  "steps": [
   {"match": {"all": [{"path": "event.action", "values": ["New_Incident_Create"]}, {"not": {"path": "user.name", "values": ["system"]}}]}, "bind": {"C": "user.name"}},
   {"match": {"path": "event.action", "values": ["Incident_Attachment_Add"]}},
   {"match": {"path": "event.action", "values": ["Incident_Attachment_Delete"]}, "ne": {"C": "user.name"}, "bind": {"D": "user.name"}},
   {"match": {"path": "event.action", "values": ["Incident_Delete"]}, "eq": {"D": "user.name"}}
  ]
 },
 "pairs": [
  {"name": "incident_life", "key": {"path": "fortinet.fortianalyzer.incident_id"},
   "open": {"path": "event.action", "values": ["New_Incident_Create"]},
   "close": {"path": "event.action", "values": ["Incident_Delete"]}},
  {"name": "attachment_life", "key": {"path": "fortinet.fortianalyzer.attachment"},
   "open": {"path": "event.action", "values": ["Incident_Attachment_Add"]},
   "close": {"path": "event.action", "values": ["Incident_Attachment_Delete"]}}
 ],
 "features": [
  {"name": "create_then_delete", "key": {"path": "fortinet.fortianalyzer.incident_id"}, "within": 7200,
   "steps": [
    {"match": {"path": "event.action", "values": ["New_Incident_Create"]}},
    {"match": {"path": "event.action", "values": ["Incident_Delete"]}}
   ]},
  {"name": "remove_then_delete_same_user", "key": {"path": "fortinet.fortianalyzer.incident_id"}, "within": 7200,
   "steps": [
    {"match": {"path": "event.action", "values": ["Incident_Attachment_Delete"]}, "bind": {"D": "user.name"}},
    {"match": {"path": "event.action", "values": ["Incident_Delete"]}, "eq": {"D": "user.name"}}
   ]},
  {"name": "create_attach_remove_by_other", "key": {"path": "fortinet.fortianalyzer.incident_id"}, "within": 7200,
   "steps": [
    {"match": {"path": "event.action", "values": ["New_Incident_Create"]}, "bind": {"C": "user.name"}},
    {"match": {"path": "event.action", "values": ["Incident_Attachment_Add"]}},
    {"match": {"path": "event.action", "values": ["Incident_Attachment_Delete"]}, "ne": {"C": "user.name"}}
   ]}
 ],
 "text_time_paths": ["event.original"]
}
