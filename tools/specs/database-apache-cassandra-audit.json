{
 "timestamp": {"path": "@timestamp"},
 "actors": [
  {"name": "user", "path": "user.name"},
  {"name": "source", "path": "source.ip"},
  {"name": "user_fail", "path": "user.name",
   "when": {"path": "cassandra.audit.type", "values": ["LOGIN_ERROR"]}},
  {"name": "admin_dcl", "path": "user.name",
   "when": {"path": "cassandra.audit.category", "values": ["DCL"]},
   "target": {"paths": ["user.target.name"]}},
  {"name": "role_target", "path": "user.target.name",
   "when": {"path": "cassandra.audit.type", "values": ["CREATE_ROLE", "GRANT", "REVOKE", "DROP_ROLE"]}},
  {"name": "payroll_reader", "path": "user.name",
   "when": {"path": "cassandra.audit.scope", "values": ["payroll"]}},
  {"name": "login_user", "path": "user.name",
   "when": {"path": "cassandra.audit.type", "values": ["LOGIN_SUCCESS"]}}
 ],
 "action": {"paths": ["cassandra.audit.type"]},
 "target": {"paths": ["cassandra.audit.scope"]},
 "failure": {"path": "cassandra.audit.type", "values": ["LOGIN_ERROR"]},
 "success": {"path": "cassandra.audit.type", "values": ["LOGIN_SUCCESS"]},
 "pairs": [
  {"name": "role_life", "key": {"path": "user.target.name"},
   "open": {"path": "cassandra.audit.type", "values": ["CREATE_ROLE"]},
   "close": {"path": "cassandra.audit.type", "values": ["DROP_ROLE"]}}
 ],
 "chain_seq": {
  "key": {"path": "source.ip"},
  "within": 7200,
  "steps": [
   {"match": {"path": "cassandra.audit.type", "values": ["CREATE_ROLE"]}, "bind": {"R": "user.target.name"}},
   {"match": {"all": [{"path": "cassandra.audit.type", "values": ["GRANT"]},
                      {"path": "cassandra.audit.operation", "regex": "ON TABLE finance\\.payroll TO "}]},
    "eq": {"R": "user.target.name"}},
   {"match": {"path": "cassandra.audit.type", "values": ["LOGIN_SUCCESS"]}, "eq": {"R": "user.name"}},
   {"match": {"all": [{"path": "cassandra.audit.type", "values": ["SELECT"]},
                      {"path": "cassandra.audit.scope", "values": ["payroll"]}]},
    "eq": {"R": "user.name"}},
   {"match": {"path": "cassandra.audit.type", "values": ["DROP_ROLE"]}, "eq": {"R": "user.target.name"}}
  ]
 },
 "text_time_paths": ["event.original"]
}
