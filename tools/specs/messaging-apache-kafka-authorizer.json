{
 "timestamp": {"path": "@timestamp"},
 "actors": [
  {"name": "principal", "path": "kafka.principal"},
  {"name": "ip", "path": "source.ip"},
  {"name": "principal_topic", "paths": ["kafka.principal", "kafka.resource.name"]}
 ],
 "action": {"paths": ["kafka.operation"]},
 "target": {"paths": ["kafka.resource.name"]},
 "text_time_paths": ["event.original"],
 "chain_seq": {
  "key": {"path": "kafka.principal"},
  "same": ["kafka.resource.name"],
  "within": 300,
  "steps": [
   {"match": {"path": "kafka.operation", "values": ["READ"]}},
   {"match": {"path": "kafka.operation", "values": ["WRITE"]}},
   {"match": {"path": "kafka.operation", "values": ["ALTER_CONFIGS"]}},
   {"match": {"path": "kafka.operation", "values": ["DELETE"]}}
  ]
 }
}
