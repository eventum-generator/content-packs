{
 "timestamp": {
  "path": "@timestamp"
 },
 "actors": [
  {
   "name": "host",
   "path": "host.name"
  },
  {
   "name": "host_sec_error",
   "path": "host.name",
   "when": {
    "all": [
     {
      "path": "event.code",
      "values": [
       "7016"
      ]
     },
     {
      "path": "winlog.event_data.CSEExtensionName",
      "values": [
       "Security"
      ]
     }
    ]
   }
  },
  {
   "name": "host_manual",
   "path": "host.name",
   "when": {
    "path": "event.code",
    "values": [
     "4004"
    ]
   }
  },
  {
   "name": "thread",
   "paths": [
    "host.name",
    "winlog.process.thread.id"
   ]
  }
 ],
 "action": {
  "paths": [
   "event.code",
   "winlog.event_data.CSEExtensionName"
  ]
 },
 "failure": {
  "path": "event.code",
  "values": [
   "7016",
   "7006",
   "7004"
  ]
 },
 "success": {
  "path": "event.code",
  "values": [
   "5016",
   "8006",
   "8004"
  ]
 },
 "chain_seq": {
  "key": {
   "path": "winlog.channel"
  },
  "within": 21600,
  "steps": [
   {
    "match": {
     "all": [
      {
       "path": "event.code",
       "values": [
        "7016"
       ]
      },
      {
       "path": "winlog.event_data.CSEExtensionName",
       "values": [
        "Security"
       ]
      }
     ]
    },
    "bind": {
     "A": "host.name"
    }
   },
   {
    "match": {
     "all": [
      {
       "path": "event.code",
       "values": [
        "7016"
       ]
      },
      {
       "path": "winlog.event_data.CSEExtensionName",
       "values": [
        "Security"
       ]
      }
     ]
    },
    "ne": {
     "A": "host.name"
    },
    "bind": {
     "B": "host.name"
    }
   },
   {
    "match": {
     "all": [
      {
       "path": "event.code",
       "values": [
        "7016"
       ]
      },
      {
       "path": "winlog.event_data.CSEExtensionName",
       "values": [
        "Security"
       ]
      }
     ]
    },
    "ne": {
     "A,B": "host.name"
    }
   }
  ]
 },
 "features": [
  {
   "name": "sec_error_then_restore",
   "key": {
    "path": "host.name"
   },
   "within": 21600,
   "steps": [
    {
     "match": {
      "all": [
       {
        "path": "event.code",
        "values": [
         "7016"
        ]
       },
       {
        "path": "winlog.event_data.CSEExtensionName",
        "values": [
         "Security"
        ]
       }
      ]
     }
    },
    {
     "match": {
      "all": [
       {
        "path": "event.code",
        "values": [
         "5016"
        ]
       },
       {
        "path": "winlog.event_data.CSEExtensionName",
        "values": [
         "Security"
        ]
       }
      ]
     }
    }
   ]
  },
  {
   "name": "failed_refresh_then_manual",
   "key": {
    "path": "host.name"
   },
   "within": 1800,
   "steps": [
    {
     "match": {
      "path": "event.code",
      "values": [
       "7006",
       "7004"
      ]
     }
    },
    {
     "match": {
      "path": "event.code",
      "values": [
       "4004"
      ]
     }
    }
   ]
  },
  {
   "name": "sec_error_x2_same_host",
   "key": {
    "path": "host.name"
   },
   "within": 21600,
   "steps": [
    {
     "match": {
      "all": [
       {
        "path": "event.code",
        "values": [
         "7016"
        ]
       },
       {
        "path": "winlog.event_data.CSEExtensionName",
        "values": [
         "Security"
        ]
       }
      ]
     }
    },
    {
     "match": {
      "all": [
       {
        "path": "event.code",
        "values": [
         "7016"
        ]
       },
       {
        "path": "winlog.event_data.CSEExtensionName",
        "values": [
         "Security"
        ]
       }
      ]
     }
    }
   ]
  }
 ],
 "pairs": [
  {
   "name": "refresh",
   "key": {
    "path": "winlog.activity_id"
   },
   "open": {
    "path": "event.code",
    "values": [
     "4006",
     "4004"
    ]
   },
   "close": {
    "path": "event.code",
    "values": [
     "8006",
     "8004",
     "7006",
     "7004"
    ]
   }
  }
 ]
}