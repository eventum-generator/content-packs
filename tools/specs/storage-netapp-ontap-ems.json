{
 "timestamp": {"path": "@timestamp"},
 "actors": [
  {"name": "user", "path": "user.name"},
  {"name": "user_fail", "path": "user.name",
   "when": {"path": "event.action", "values": ["security.invalid.login"]}},
  {"name": "user_locked", "path": "user.name",
   "when": {"path": "event.action", "values": ["useradmin.lockedout.user"]}},
  {"name": "arw_volume", "path": "netapp.ems.parameters.volumeName",
   "when": {"path": "event.action", "values": ["arw.volume.state"]}},
  {"name": "snap_volume", "path": "netapp.ems.parameters.volume",
   "when": {"path": "event.action", "values": ["zapi.snapshot.success"]}},
  {"name": "node", "path": "host.name"}
 ],
 "action": {"paths": ["event.action", "netapp.ems.parameters.op"]},
 "failure": {"path": "event.action", "values": ["security.invalid.login"]},
 "success": {"path": "event.action", "values": ["__never__"]},
 "pairs": [
  {"name": "arw_off", "key": {"path": "netapp.ems.parameters.volumeName"},
   "open": {"all": [{"path": "event.action", "values": ["arw.volume.state"]},
                    {"path": "netapp.ems.parameters.op", "values": ["disabled"]}]},
   "close": {"all": [{"path": "event.action", "values": ["arw.volume.state"]},
                     {"path": "netapp.ems.parameters.op", "values": ["enabled"]}]}}
 ],
 "chain_seq": {
  "key": null,
  "within": 3600,
  "steps": [
   {"match": {"path": "event.action", "values": ["security.invalid.login"]},
    "bind": {"A": "user.name"}},
   {"match": {"path": "event.action", "values": ["security.invalid.login"]},
    "eq": {"A": "user.name"}},
   {"match": {"path": "event.action", "values": ["useradmin.lockedout.user"]},
    "eq": {"A": "user.name"}},
   {"match": {"path": "event.action", "values": ["security.invalid.login"]},
    "ne": {"A": "user.name"}},
   {"match": {"all": [{"path": "event.action", "values": ["arw.volume.state"]},
                      {"path": "netapp.ems.parameters.op", "values": ["disabled"]}]}}
  ]
 }
}
