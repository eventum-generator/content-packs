{
 "timestamp": {"path": "@timestamp"},
 "actors": [
  {"name": "user", "path": "user.name"},
  {"name": "user_ip", "paths": ["user.name", "source.ip"],
   "when": {"path": "event.action", "values": ["login", "logout"]}},
  {"name": "editor", "path": "user.name",
   "when": {"path": "event.category", "values": ["configuration"]}},
  {"name": "ext_login", "path": "user.name",
   "when": {"all": [{"path": "event.action", "values": ["login"]}, {"path": "source.ip", "regex": "^203\\.0\\.113\\."}]}},
  {"name": "client", "path": "client.mac"},
  {"name": "fw_src", "path": "source.ip",
   "when": {"path": "event.action", "values": ["firewall_log"]}}
 ],
 "action": {"paths": ["event.action"]},
 "chain_seq": {
  "key": {"path": "user.name"},
  "within": 1800,
  "steps": [
   {"match": {"all": [{"path": "event.action", "values": ["login"]}, {"path": "source.ip", "regex": "^203\\.0\\.113\\."}]},
    "bind": {"I": "source.ip"}},
   {"match": {"path": "event.action", "values": ["mangle_rule_added"]}},
   {"match": {"path": "event.action", "values": ["mangle_rule_moved"]}},
   {"match": {"path": "event.action", "values": ["mangle_rule_changed"]}},
   {"match": {"path": "event.action", "values": ["mangle_rule_removed"]}}
  ]
 },
 "features": [
  {"name": "ext_add_remove", "key": {"path": "user.name"}, "within": 1800,
   "steps": [
    {"match": {"all": [{"path": "event.action", "values": ["login"]}, {"path": "source.ip", "regex": "^203\\.0\\.113\\."}]}},
    {"match": {"path": "event.action", "values": ["mangle_rule_added"]}},
    {"match": {"path": "event.action", "values": ["mangle_rule_removed"]}}
   ]},
  {"name": "add_move_change_remove", "key": {"path": "user.name"}, "within": 1800,
   "steps": [
    {"match": {"path": "event.action", "values": ["mangle_rule_added"]}},
    {"match": {"path": "event.action", "values": ["mangle_rule_moved"]}},
    {"match": {"path": "event.action", "values": ["mangle_rule_changed"]}},
    {"match": {"path": "event.action", "values": ["mangle_rule_removed"]}}
   ]}
 ],
 "pairs": [
  {"name": "session", "key": {"paths": ["user.name", "source.ip"]},
   "open": {"path": "event.action", "values": ["login"]},
   "close": {"path": "event.action", "values": ["logout"]}},
  {"name": "lease", "key": {"path": "client.mac"},
   "open": {"path": "event.action", "values": ["dhcp_assigned"]},
   "close": {"path": "event.action", "values": ["dhcp_deassigned"]}}
 ],
 "text_time_paths": []
}
