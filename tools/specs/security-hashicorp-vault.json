{
 "timestamp": {"path": "@timestamp"},
 "include": {"path": "hashicorp_vault.audit.type", "values": ["request"]},
 "actors": [
  {"name": "user", "path": "user.name"},
  {"name": "path", "path": "hashicorp_vault.audit.request.path"},
  {"name": "user_port", "paths": ["user.name", "source.port"]},
  {"name": "user_payroll_read", "path": "user.name",
   "when": {"all": [{"path": "hashicorp_vault.audit.request.path", "regex": "/data/payroll/"},
                    {"path": "event.action", "values": ["read"]}]}},
  {"name": "user_audit_delete", "path": "user.name",
   "when": {"path": "hashicorp_vault.audit.request.path", "regex": "^sys/audit"}},
  {"name": "user_renew", "path": "user.name",
   "when": {"path": "hashicorp_vault.audit.request.path", "values": ["auth/token/renew-self"]}}
 ],
 "action": {"paths": ["event.action"]},
 "target": {"paths": ["hashicorp_vault.audit.request.path"]},
 "failure": {"path": "event.outcome", "values": ["failure"]},
 "chain_seq": {
  "key": {"path": "user.name"},
  "within": 400,
  "steps": [
   {"match": {"all": [{"path": "hashicorp_vault.audit.request.path", "regex": "/data/payroll/"}, {"path": "event.action", "values": ["read"]}]},
    "bind": {"A": "hashicorp_vault.audit.request.path"}},
   {"match": {"all": [{"path": "hashicorp_vault.audit.request.path", "regex": "/data/payroll/"}, {"path": "event.action", "values": ["read"]}]},
    "ne": {"A": "hashicorp_vault.audit.request.path"},
    "bind": {"B": "hashicorp_vault.audit.request.path"}},
   {"match": {"all": [{"path": "hashicorp_vault.audit.request.path", "regex": "/data/payroll/"}, {"path": "event.action", "values": ["read"]}]},
    "ne": {"A,B": "hashicorp_vault.audit.request.path"}},
   {"match": {"all": [{"path": "hashicorp_vault.audit.request.path", "regex": "^sys/audit"}, {"path": "event.action", "values": ["delete"]}]}}
  ]
 },
 "features": [
  {"name": "payroll_burst10", "key": {"path": "user.name"}, "within": 600,
   "steps": [
    {"match": {"path": "hashicorp_vault.audit.request.path", "regex": "/data/payroll/"}},
    {"match": {"path": "hashicorp_vault.audit.request.path", "regex": "/data/payroll/"}},
    {"match": {"path": "hashicorp_vault.audit.request.path", "regex": "/data/payroll/"}},
    {"match": {"path": "hashicorp_vault.audit.request.path", "regex": "/data/payroll/"}},
    {"match": {"path": "hashicorp_vault.audit.request.path", "regex": "/data/payroll/"}},
    {"match": {"path": "hashicorp_vault.audit.request.path", "regex": "/data/payroll/"}},
    {"match": {"path": "hashicorp_vault.audit.request.path", "regex": "/data/payroll/"}},
    {"match": {"path": "hashicorp_vault.audit.request.path", "regex": "/data/payroll/"}},
    {"match": {"path": "hashicorp_vault.audit.request.path", "regex": "/data/payroll/"}},
    {"match": {"path": "hashicorp_vault.audit.request.path", "regex": "/data/payroll/"}}
   ]},
  {"name": "delete_retry", "key": {"path": "user.name"}, "within": 300,
   "steps": [
    {"match": {"path": "hashicorp_vault.audit.request.path", "regex": "^sys/audit"}},
    {"match": {"path": "hashicorp_vault.audit.request.path", "regex": "^sys/audit"}}
   ]}
 ]
}
