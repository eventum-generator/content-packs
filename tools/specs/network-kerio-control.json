{
 "timestamp": {"path": "@timestamp"},
 "actors": [
  {"name": "user", "path": "user.name", "target": {"paths": ["url.domain"]}},
  {"name": "client", "path": "source.ip", "target": {"paths": ["rule.name"]}},
  {"name": "anon_denied", "path": "user.name",
   "when": {"path": "rule.name", "values": ["Deny anonymizers"]},
   "target": {"paths": ["url.domain"]}},
  {"name": "denied", "path": "user.name",
   "when": {"path": "event.action", "values": ["DENY"]},
   "target": {"paths": ["rule.name"]}},
  {"name": "tunnel_downloader", "path": "user.name",
   "when": {"path": "url.domain", "values": ["dl.remotedesk.example", "get.tunnelvpn.example", "download.socksclient.example"]},
   "target": {"paths": ["url.domain"]}}
 ],
 "action": {"paths": ["event.action", "rule.name"]},
 "target": {"paths": ["url.domain"]},
 "failure": {"path": "event.action", "values": ["DENY"]},
 "chain_seq": {
  "key": {"path": "user.name"},
  "within": 3600,
  "steps": [
   {"match": {"path": "rule.name", "values": ["Deny anonymizers"]},
    "bind": {"H": "url.domain"}},
   {"match": {"path": "rule.name", "values": ["Deny anonymizers"]},
    "ne": {"H": "url.domain"}},
   {"match": {"all": [
     {"path": "rule.name", "values": ["Log executable downloads"]},
     {"path": "url.domain", "values": ["dl.remotedesk.example", "get.tunnelvpn.example", "download.socksclient.example"]}]}}
  ]
 },
 "text_time_paths": ["event.original"]
}
