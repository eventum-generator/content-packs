{
 "timestamp": {"path": "@timestamp"},
 "actors": [
  {"name": "client", "path": "source.ip", "target": {"paths": ["url.path"]}},
  {"name": "client_denied", "path": "source.ip",
   "when": {"path": "cisco.swa.result_code", "values": ["TCP_DENIED"]},
   "target": {"paths": ["url.path"]}},
  {"name": "client_file", "path": "source.ip",
   "when": {"path": "url.path", "regex": "^/pub/"},
   "target": {"paths": ["url.path"]}},
  {"name": "client_path", "paths": ["source.ip", "url.path"],
   "when": {"path": "url.path", "regex": "^/pub/"}}
 ],
 "action": {"paths": ["cisco.swa.result_code"]},
 "target": {"paths": ["url.domain"]},
 "failure": {"path": "cisco.swa.result_code", "values": ["TCP_DENIED"]},
 "success": {"all": [
  {"path": "http.response.status_code", "values": [200]},
  {"path": "url.path", "regex": "^/pub/"}]},
 "chain_seq": {
  "key": {"path": "source.ip"},
  "within": 1800,
  "steps": [
   {"match": {"all": [
     {"path": "cisco.swa.result_code", "values": ["TCP_DENIED"]},
     {"path": "url.path", "regex": "^/pub/"}]},
    "bind": {"P": "url.path", "D": "url.domain"}},
   {"match": {"path": "cisco.swa.result_code", "values": ["TCP_DENIED"]},
    "eq": {"P": "url.path"}},
   {"match": {"path": "http.response.status_code", "values": [200]},
    "eq": {"P": "url.path"}, "ne": {"D": "url.domain"}}
  ]
 },
 "features": [
  {"name": "denied_then_download", "key": {"path": "source.ip"}, "within": 1800,
   "steps": [
    {"match": {"all": [
      {"path": "cisco.swa.result_code", "values": ["TCP_DENIED"]},
      {"path": "url.path", "regex": "^/pub/"}]},
     "bind": {"P": "url.path"}},
    {"match": {"path": "http.response.status_code", "values": [200]},
     "eq": {"P": "url.path"}}
   ]}
 ],
 "text_time_paths": ["event.original"]
}
