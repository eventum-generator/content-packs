{
  "timestamp": {
    "path": "@timestamp"
  },
  "actors": [
    {
      "name": "ip",
      "path": "source.ip"
    },
    {
      "name": "target",
      "path": "jira.security.target_user"
    },
    {
      "name": "session",
      "path": "jira.security.session_id"
    },
    {
      "name": "user_ip",
      "paths": [
        "jira.security.target_user",
        "source.ip"
      ]
    },
    {
      "name": "ip_fail",
      "path": "source.ip",
      "when": {
        "path": "event.action",
        "values": [
          "authentication-failed"
        ]
      }
    },
    {
      "name": "target_fail",
      "path": "jira.security.target_user",
      "when": {
        "path": "event.action",
        "values": [
          "authentication-failed"
        ]
      }
    }
  ],
  "action": {
    "paths": [
      "event.action"
    ]
  },
  "target": {
    "paths": [
      "jira.security.target_user"
    ]
  },
  "include": {
    "path": "event.action",
    "values": [
      "session-created",
      "session-destroyed",
      "authentication-failed",
      "captcha-required",
      "authentication-passed",
      "logout"
    ]
  },
  "failure": {
    "path": "event.action",
    "values": [
      "authentication-failed"
    ]
  },
  "success": {
    "path": "event.action",
    "values": [
      "authentication-passed"
    ]
  },
  "pairs": [
    {
      "name": "session",
      "key": {
        "path": "jira.security.target_user"
      },
      "open": {
        "path": "event.action",
        "values": [
          "authentication-passed"
        ]
      },
      "close": {
        "path": "event.action",
        "values": [
          "logout"
        ]
      }
    }
  ],
  "chain_seq": {
    "key": {
      "paths": [
        "jira.security.target_user",
        "source.ip"
      ]
    },
    "within": 3600,
    "steps": [
      {
        "match": {
          "path": "event.action",
          "values": [
            "authentication-failed"
          ]
        },
        "bind": {
          "sess": "jira.security.session_id"
        }
      },
      {
        "match": {
          "path": "event.action",
          "values": [
            "authentication-failed"
          ]
        },
        "eq": {
          "sess": "jira.security.session_id"
        }
      },
      {
        "match": {
          "path": "event.action",
          "values": [
            "authentication-failed"
          ]
        },
        "eq": {
          "sess": "jira.security.session_id"
        }
      },
      {
        "match": {
          "path": "event.action",
          "values": [
            "captcha-required"
          ]
        },
        "eq": {
          "sess": "jira.security.session_id"
        }
      },
      {
        "match": {
          "path": "event.action",
          "values": [
            "captcha-required"
          ]
        },
        "eq": {
          "sess": "jira.security.session_id"
        }
      },
      {
        "match": {
          "path": "event.action",
          "values": [
            "captcha-required"
          ]
        },
        "eq": {
          "sess": "jira.security.session_id"
        }
      },
      {
        "match": {
          "path": "event.action",
          "values": [
            "authentication-passed"
          ]
        },
        "eq": {
          "sess": "jira.security.session_id"
        }
      }
    ]
  },
  "features": [
    {
      "name": "fail_then_pass",
      "key": {
        "path": "jira.security.session_id"
      },
      "within": 3600,
      "steps": [
        {
          "match": {
            "path": "event.action",
            "values": [
              "authentication-failed"
            ]
          }
        },
        {
          "match": {
            "path": "event.action",
            "values": [
              "authentication-passed"
            ]
          }
        }
      ]
    },
    {
      "name": "captcha_then_pass",
      "key": {
        "path": "source.ip"
      },
      "within": 3600,
      "steps": [
        {
          "match": {
            "path": "event.action",
            "values": [
              "captcha-required"
            ]
          }
        },
        {
          "match": {
            "path": "event.action",
            "values": [
              "authentication-passed"
            ]
          }
        }
      ]
    }
  ]
}
