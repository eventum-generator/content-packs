{
 "timestamp": {"path": "@timestamp"},
 "actors": [
  {"name": "container", "path": "container.id", "target": {"paths": ["process.command_line"]}},
  {"name": "node_container", "paths": ["host.name", "container.id"]},
  {"name": "container_shell", "path": "container.id",
   "when": {"path": "rule.name", "values": ["Terminal shell in container"]}},
  {"name": "container_read", "path": "container.id",
   "when": {"path": "rule.name", "values": ["Read sensitive file untrusted"]}},
  {"name": "container_api", "path": "container.id",
   "when": {"path": "rule.name", "values": ["Contact K8S API Server From Container"]}},
  {"name": "session", "paths": ["container.id", "process.parent.pid"],
   "when": {"path": "process.parent.name", "values": ["bash"]}},
  {"name": "container_parent", "paths": ["container.id", "process.parent.name"],
   "when": {"path": "rule.name", "values": ["Contact K8S API Server From Container"]}},
  {"name": "container_tty", "paths": ["container.id", "falco.output_fields.proc.tty"]}
 ],
 "action": {"paths": ["rule.name", "process.parent.name"]},
 "target": {"paths": ["process.command_line"]},
 "chain_seq": {
  "key": {"path": "container.id"},
  "within": 300,
  "steps": [
   {"match": {"path": "rule.name", "values": ["Terminal shell in container"]}, "bind": {"P": "process.pid"}},
   {"match": {"path": "rule.name", "values": ["Read sensitive file untrusted"]}, "eq": {"P": "process.parent.pid"}},
   {"match": {"all": [{"path": "rule.name", "values": ["Contact K8S API Server From Container"]}, {"path": "process.command_line", "regex": "/api$"}]}, "eq": {"P": "process.parent.pid"}}
  ]
 },
 "features": [
  {"name": "shell_then_api_child", "key": {"path": "container.id"}, "within": 300,
   "steps": [
    {"match": {"path": "rule.name", "values": ["Terminal shell in container"]}, "bind": {"P": "process.pid"}},
    {"match": {"path": "rule.name", "values": ["Contact K8S API Server From Container"]}, "eq": {"P": "process.parent.pid"}}
   ]},
  {"name": "read_then_api_same_parent", "key": {"path": "container.id"}, "within": 300,
   "steps": [
    {"match": {"path": "rule.name", "values": ["Read sensitive file untrusted"]}, "bind": {"P": "process.parent.pid"}},
    {"match": {"path": "rule.name", "values": ["Contact K8S API Server From Container"]}, "eq": {"P": "process.parent.pid"}}
   ]},
  {"name": "shell_read_version_lineage", "key": {"path": "container.id"}, "within": 300,
   "steps": [
    {"match": {"path": "rule.name", "values": ["Terminal shell in container"]}, "bind": {"P": "process.pid"}},
    {"match": {"path": "rule.name", "values": ["Read sensitive file untrusted"]}, "eq": {"P": "process.parent.pid"}},
    {"match": {"all": [{"path": "rule.name", "values": ["Contact K8S API Server From Container"]}, {"path": "process.command_line", "regex": "/version$"}]}, "eq": {"P": "process.parent.pid"}}
   ]},
  {"name": "shell_read_api_any_lineage", "key": {"path": "container.id"}, "within": 300,
   "steps": [
    {"match": {"path": "rule.name", "values": ["Terminal shell in container"]}},
    {"match": {"path": "rule.name", "values": ["Read sensitive file untrusted"]}},
    {"match": {"path": "rule.name", "values": ["Contact K8S API Server From Container"]}}
   ]}
 ],
 "day_s": 86400,
 "near_s": 1800,
 "text_time_paths": ["falco.output"],
 "skip_const_paths_regex": "^(ecs\\.version|agent\\.(type|version)|elastic_agent\\.(snapshot|version)|data_stream\\..*|input\\.type|observer\\..*|event\\.(agent_id_status|dataset|kind|provider|severity|timezone)|falco\\.source|host\\.(architecture|containerized|os\\..*)|log\\.file\\.path|tags|user\\..*|falco\\.output_fields\\.user\\..*)$"
}
