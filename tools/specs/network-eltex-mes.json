{
 "timestamp": {"path": "@timestamp"},
 "actors": [
  {"name": "user", "path": "user.name"},
  {"name": "src", "path": "source.ip"},
  {"name": "port", "path": "interface.name"},
  {"name": "mac", "path": "source.mac"},
  {"name": "user_fail", "path": "user.name",
   "when": {"path": "event.action", "values": ["login_rejected"]}},
  {"name": "port_cfg", "path": "interface.name",
   "when": {"path": "event.action", "values": ["interface_speed_changed", "interface_down"]}},
  {"name": "switch_cfg", "path": "observer.name",
   "when": {"path": "event.action", "values": ["logging_file_cleared", "syslog_server_deleted", "syslog_server_added"]}}
 ],
 "action": {"paths": ["event.action"]},
 "failure": {"path": "event.action", "values": ["login_rejected"]},
 "success": {"path": "event.action", "values": ["login_accepted"]},
 "pairs": [
  {"name": "session", "key": {"path": "user.name"},
   "open": {"path": "event.action", "values": ["login_accepted"]},
   "close": {"path": "event.action", "values": ["session_terminated"]}},
  {"name": "link", "key": {"path": "interface.name"},
   "open": {"path": "event.action", "values": ["interface_down"]},
   "close": {"path": "event.action", "values": ["interface_up"]}},
  {"name": "fdb", "key": {"path": "source.mac"},
   "open": {"path": "event.action", "values": ["mac_removed"]},
   "close": {"path": "event.action", "values": ["mac_learned"]}},
  {"name": "receiver", "key": {"path": "observer.name"},
   "open": {"path": "event.action", "values": ["syslog_server_deleted"]},
   "close": {"path": "event.action", "values": ["syslog_server_added"]}},
  {"name": "speed", "key": {"path": "interface.name"},
   "open": {"path": "eltex.mes.details.interface.speed", "values": ["1G"]},
   "close": {"path": "eltex.mes.details.interface.speed", "values": ["10G"]}}
 ],
 "chain_seq": {
  "key": {"path": "observer.name"},
  "within": 3600,
  "steps": [
   {"match": {"path": "event.action", "values": ["login_rejected"]}, "bind": {"U": "user.name"}},
   {"match": {"path": "event.action", "values": ["login_rejected"]}, "eq": {"U": "user.name"}},
   {"match": {"path": "event.action", "values": ["login_rejected"]}, "eq": {"U": "user.name"}},
   {"match": {"path": "event.action", "values": ["login_accepted"]}, "eq": {"U": "user.name"}},
   {"match": {"path": "event.action", "values": ["interface_speed_changed"]}, "bind": {"P": "interface.name"}},
   {"match": {"path": "event.action", "values": ["interface_down"]}, "eq": {"P": "interface.name"}},
   {"match": {"path": "event.action", "values": ["mac_removed"]}, "eq": {"P": "interface.name"}},
   {"match": {"path": "event.action", "values": ["logging_file_cleared"]}},
   {"match": {"path": "event.action", "values": ["syslog_server_deleted"]}}
  ]
 }
}
