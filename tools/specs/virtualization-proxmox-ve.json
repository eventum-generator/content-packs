{
 "timestamp": {"path": "@timestamp"},
 "include": {"path": "log.file.path", "values": ["/var/log/pveproxy/access.log"]},
 "actors": [
  {"name": "src", "path": "source.ip"},
  {"name": "user", "path": "user.name"},
  {"name": "src_fail", "path": "source.ip",
   "when": {"path": "event.action", "values": ["ticket-denied"]}},
  {"name": "src_ticket", "path": "source.ip",
   "when": {"path": "event.action", "values": ["ticket-denied", "ticket-issued"]}},
  {"name": "power_user", "path": "user.name",
   "when": {"path": "event.action", "values": ["vm-start-request", "vm-stop-request", "vm-shutdown-request", "vm-reboot-request"]}},
  {"name": "vm", "path": "url.path", "regex": "/qemu/(\\d+)/status/(?:start|stop|shutdown|reboot)$",
   "when": {"path": "event.action", "values": ["vm-start-request", "vm-stop-request", "vm-shutdown-request", "vm-reboot-request"]}}
 ],
 "action": {"paths": ["event.action"]},
 "target": {"paths": ["url.path"]},
 "failure": {"path": "event.action", "values": ["ticket-denied"]},
 "success": {"path": "event.action", "values": ["ticket-issued"]},
 "pairs": [
  {"name": "vm_down", "key": {"path": "url.path", "regex": "/qemu/(\\d+)/status/"},
   "open": {"path": "event.action", "values": ["vm-stop-request", "vm-shutdown-request"]},
   "close": {"path": "event.action", "values": ["vm-start-request"]}}
 ],
 "chain_seq": {
  "key": {"path": "source.ip"},
  "within": 1800,
  "steps": [
   {"match": {"path": "event.action", "values": ["ticket-denied"]}},
   {"match": {"path": "event.action", "values": ["ticket-denied"]}},
   {"match": {"path": "event.action", "values": ["ticket-denied"]}},
   {"match": {"path": "event.action", "values": ["ticket-issued"]}},
   {"match": {"path": "event.action", "values": ["vm-stop-request"]}}
  ]
 },
 "features": [
  {"name": "denied_issued_power", "key": {"path": "source.ip"}, "within": 1800,
   "steps": [
    {"match": {"path": "event.action", "values": ["ticket-denied"]}},
    {"match": {"path": "event.action", "values": ["ticket-issued"]}},
    {"match": {"path": "event.action", "values": ["vm-stop-request", "vm-shutdown-request"]}}
   ]}
 ]
}
