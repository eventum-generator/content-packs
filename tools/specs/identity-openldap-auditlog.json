{
  "timestamp": {
    "path": "@timestamp"
  },
  "actors": [
    {
      "name": "actor_ip",
      "paths": [
        "user.name",
        "source.ip"
      ]
    }
  ],
  "action": {
    "paths": [
      "event.action",
      "ldap.auditlog.attribute"
    ]
  },
  "chain_seq": {
    "key": {
      "paths": [
        "user.name",
        "source.ip"
      ]
    },
    "within": 900,
    "steps": [
      {
        "match": {
          "path": "ldap.auditlog.change_type",
          "values": [
            "add"
          ]
        },
        "bind": {
          "target": "ldap.auditlog.target_dn"
        }
      },
      {
        "match": {
          "all": [
            {
              "path": "ldap.auditlog.attribute",
              "values": [
                "member"
              ]
            },
            {
              "path": "ldap.auditlog.operation",
              "values": [
                "add"
              ]
            },
            {
              "path": "ldap.auditlog.target_dn",
              "regex": "^cn=directory-admins,"
            }
          ]
        },
        "eq": {
          "target": "ldap.auditlog.value"
        }
      },
      {
        "match": {
          "path": "ldap.auditlog.attribute",
          "values": [
            "userPassword"
          ]
        },
        "eq": {
          "target": "ldap.auditlog.target_dn"
        }
      }
    ]
  }
}
