{
 "timestamp": {"path": "@timestamp"},
 "actors": [
  {"name": "ip", "path": "message", "regex": "(?:tcp |Source: |vty\\d+ \\()(\\d+\\.\\d+\\.\\d+\\.\\d+)"},
  {"name": "user", "path": "message", "regex": "(?:\\[user: |User:|console by )([A-Za-z0-9._-]+)"},
  {"name": "user_ip", "path": "message", "regex": "\\[user: ([^\\]]+\\] \\[Source: [\\d.]+)",
   "when": {"path": "event.code", "values": ["LOGIN_FAILED", "LOGIN_SUCCESS"]}},
  {"name": "fail_ip", "path": "message", "regex": "Source: ([\\d.]+)",
   "when": {"path": "event.code", "values": ["LOGIN_FAILED"]}},
  {"name": "fail_user", "path": "message", "regex": "\\[user: ([^\\]]+)",
   "when": {"path": "event.code", "values": ["LOGIN_FAILED"]}},
  {"name": "editor", "path": "message", "regex": "User:(\\S+)",
   "when": {"path": "event.code", "values": ["CFGLOG_LOGGEDCMD"]}},
  {"name": "changer_ip", "path": "message", "regex": "vty\\d+ \\(([\\d.]+)\\)",
   "when": {"path": "event.code", "values": ["CONFIG_I"]}},
  {"name": "pair443", "paths": ["source.ip", "destination.ip"],
   "when": {"all": [{"path": "cisco.ios.access_list", "values": ["OUTSIDE_IN"]}, {"path": "destination.port", "values": [443]}]}},
  {"name": "deny_src", "path": "source.ip", "target": {"paths": ["destination.ip"]},
   "when": {"path": "event.action", "values": ["deny"]}}
 ],
 "action": {"paths": ["event.code", "event.action"]},
 "target": {"paths": ["destination.ip"]},
 "failure": {"path": "event.code", "values": ["LOGIN_FAILED"]},
 "success": {"path": "event.code", "values": ["LOGIN_SUCCESS"]},
 "chain_seq": {
  "key": {"path": "message", "regex": "(?:tcp |Source: |vty\\d+ \\()(\\d+\\.\\d+\\.\\d+\\.\\d+)"},
  "within": 1800,
  "steps": [
   {"match": {"all": [{"path": "event.code", "values": ["IPACCESSLOGP"]}, {"path": "event.action", "values": ["deny"]}, {"path": "cisco.ios.access_list", "values": ["OUTSIDE_IN"]}, {"path": "destination.port", "values": [443]}]},
    "bind": {"T": "destination.ip"}},
   {"match": {"path": "event.code", "values": ["LOGIN_FAILED"]}},
   {"match": {"path": "event.code", "values": ["LOGIN_FAILED"]}},
   {"match": {"path": "event.code", "values": ["LOGIN_FAILED"]}},
   {"match": {"path": "event.code", "values": ["LOGIN_SUCCESS"]}},
   {"match": {"path": "event.code", "values": ["CONFIG_I"]}},
   {"match": {"all": [{"path": "event.code", "values": ["IPACCESSLOGP"]}, {"path": "event.action", "values": ["allow"]}, {"path": "cisco.ios.access_list", "values": ["OUTSIDE_IN"]}, {"path": "destination.port", "values": [443]}]},
    "eq": {"T": "destination.ip"}}
  ]
 },
 "features": [
  {"name": "self_permit", "key": {"path": "message", "regex": "(?:tcp |Source: |vty\\d+ \\()(\\d+\\.\\d+\\.\\d+\\.\\d+)"}, "within": 1800,
   "steps": [
    {"match": {"all": [{"path": "event.code", "values": ["IPACCESSLOGP"]}, {"path": "event.action", "values": ["deny"]}, {"path": "destination.port", "values": [443]}]}, "bind": {"T": "destination.ip"}},
    {"match": {"path": "event.code", "values": ["LOGIN_SUCCESS"]}},
    {"match": {"path": "event.code", "values": ["CONFIG_I"]}},
    {"match": {"all": [{"path": "event.code", "values": ["IPACCESSLOGP"]}, {"path": "event.action", "values": ["allow"]}, {"path": "destination.port", "values": [443]}]}, "eq": {"T": "destination.ip"}}
   ]},
  {"name": "fail3_success", "key": {"path": "message", "regex": "Source: ([\\d.]+)"}, "within": 1800,
   "steps": [
    {"match": {"path": "event.code", "values": ["LOGIN_FAILED"]}},
    {"match": {"path": "event.code", "values": ["LOGIN_FAILED"]}},
    {"match": {"path": "event.code", "values": ["LOGIN_FAILED"]}},
    {"match": {"path": "event.code", "values": ["LOGIN_SUCCESS"]}}
   ]}
 ],
 "pairs": [
  {"name": "temp_ace", "key": {"path": "message", "regex": "logged command:(?:no )?(\\d+)"},
   "open": {"all": [{"path": "event.code", "values": ["CFGLOG_LOGGEDCMD"]}, {"path": "message", "regex": "logged command:\\d+ permit "}]},
   "close": {"all": [{"path": "event.code", "values": ["CFGLOG_LOGGEDCMD"]}, {"path": "message", "regex": "logged command:no \\d+$"}]}},
  {"name": "link", "key": {"path": "message", "regex": "Interface (\\S+),"},
   "open": {"all": [{"path": "event.code", "values": ["UPDOWN"]}, {"path": "message", "regex": "to down$"}]},
   "close": {"all": [{"path": "event.code", "values": ["UPDOWN"]}, {"path": "message", "regex": "to up$"}]}}
 ],
 "text_time_paths": ["event.original"]
}
