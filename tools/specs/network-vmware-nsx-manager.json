{
 "timestamp": {"path": "@timestamp"},
 "actors": [
  {"name": "user", "path": "user.name"},
  {"name": "src", "path": "source.ip"},
  {"name": "user_fail", "path": "user.name",
   "when": {"path": "event.action", "values": ["login-failure"]}},
  {"name": "src_login", "path": "source.ip",
   "when": {"path": "event.action", "values": ["login-failure", "login-success"]}},
  {"name": "exporter_admin", "path": "user.name",
   "when": {"path": "event.action", "values": ["syslog-exporter-delete", "syslog-exporter-create"]}},
  {"name": "exporter", "path": "url.path", "regex": "/syslog/exporters/([^/]+)$",
   "when": {"path": "event.action", "values": ["syslog-exporter-delete"]}}
 ],
 "action": {"paths": ["event.action"]},
 "target": {"paths": ["url.path"]},
 "failure": {"path": "event.action", "values": ["login-failure"]},
 "success": {"path": "event.action", "values": ["login-success"]},
 "pairs": [
  {"name": "session", "key": {"path": "user.name"},
   "open": {"path": "event.action", "values": ["login-success"]},
   "close": {"path": "event.action", "values": ["logout"]}},
  {"name": "exporter_down", "key": {"path": "host.name"},
   "open": {"path": "event.action", "values": ["syslog-exporter-delete"]},
   "close": {"path": "event.action", "values": ["syslog-exporter-create"]}}
 ],
 "chain_seq": {
  "key": {"path": "user.name"},
  "within": 1800,
  "steps": [
   {"match": {"path": "event.action", "values": ["login-failure"]}, "bind": {"I": "source.ip"}},
   {"match": {"path": "event.action", "values": ["login-failure"]}, "eq": {"I": "source.ip"}},
   {"match": {"path": "event.action", "values": ["login-failure"]}, "eq": {"I": "source.ip"}},
   {"match": {"path": "event.action", "values": ["login-success"]}, "eq": {"I": "source.ip"}},
   {"match": {"path": "event.action", "values": ["syslog-exporter-delete"]}}
  ]
 },
 "features": [
  {"name": "login_then_delete", "key": {"path": "user.name"}, "within": 1800,
   "steps": [
    {"match": {"path": "event.action", "values": ["login-success"]}},
    {"match": {"path": "event.action", "values": ["syslog-exporter-delete"]}}
   ]}
 ]
}
