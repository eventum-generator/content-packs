{
 "notes": [
  "chain: one relay + sender + recipient flow, two all-fail messages scanned clean and then an all-fail message scanned Infected, all within 180 s of the first; each message is an MA row followed by the AV row of the same cs1 (email.local_id) at the same second."
 ],
 "timestamp": {"path": "@timestamp"},
 "actors": [
  {"name": "flow", "paths": ["source.ip", "email.from.address", "email.to.address"]},
  {"name": "sender", "path": "email.from.address"},
  {"name": "recipient", "path": "email.to.address"}
 ],
 "action": {"paths": ["event.code", "event.action"]},
 "chain_seq": {
  "key": {"paths": ["source.ip", "email.from.address", "email.to.address"]},
  "within": 180,
  "steps": [
   {"match": {"all": [{"path": "event.code", "values": ["LMS_EV_SCAN_LOGIC_MA_STATUS"]}, {"path": "kaspersky.klms.spf", "values": ["Fail"]}, {"path": "kaspersky.klms.dkim", "values": ["Fail"]}, {"path": "kaspersky.klms.dmarc", "values": ["Fail"]}]},
    "bind": {"A": "email.local_id"}},
   {"match": {"all": [{"path": "event.code", "values": ["LMS_EV_SCAN_LOGIC_AV_STATUS"]}, {"path": "event.original", "regex": "outcome=Clean$"}]},
    "eq": {"A": "email.local_id"}},
   {"match": {"all": [{"path": "event.code", "values": ["LMS_EV_SCAN_LOGIC_MA_STATUS"]}, {"path": "kaspersky.klms.spf", "values": ["Fail"]}, {"path": "kaspersky.klms.dkim", "values": ["Fail"]}, {"path": "kaspersky.klms.dmarc", "values": ["Fail"]}]},
    "ne": {"A": "email.local_id"}, "bind": {"B": "email.local_id"}},
   {"match": {"all": [{"path": "event.code", "values": ["LMS_EV_SCAN_LOGIC_AV_STATUS"]}, {"path": "event.original", "regex": "outcome=Clean$"}]},
    "eq": {"B": "email.local_id"}},
   {"match": {"all": [{"path": "event.code", "values": ["LMS_EV_SCAN_LOGIC_MA_STATUS"]}, {"path": "kaspersky.klms.spf", "values": ["Fail"]}, {"path": "kaspersky.klms.dkim", "values": ["Fail"]}, {"path": "kaspersky.klms.dmarc", "values": ["Fail"]}]},
    "ne": {"A,B": "email.local_id"}, "bind": {"C": "email.local_id"}},
   {"match": {"all": [{"path": "event.code", "values": ["LMS_EV_SCAN_LOGIC_AV_STATUS"]}, {"path": "event.original", "regex": "outcome=Infected$"}]},
    "eq": {"C": "email.local_id"}}
  ]
 }
}
