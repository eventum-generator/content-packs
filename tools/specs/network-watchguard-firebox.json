{
 "timestamp": {"path": "@timestamp"},
 "actors": [
  {"name": "src", "path": "source.ip", "target": {"paths": ["destination.port"]}},
  {"name": "ext_denied", "path": "source.ip",
   "when": {"all": [
    {"path": "event.action", "values": ["traffic_deny"]},
    {"path": "rule.name", "values": ["Unhandled External Packet-00"]}]},
   "target": {"paths": ["destination.port"]}},
  {"name": "vpn", "path": "source.ip",
   "when": {"path": "rule.name", "values": ["WatchGuard SSLVPN-00"]},
   "target": {"paths": ["destination.ip"]}},
  {"name": "pair", "paths": ["source.ip", "destination.ip"],
   "target": {"paths": ["destination.port"]}}
 ],
 "action": {"paths": ["event.action", "rule.name", "destination.port"]},
 "target": {"paths": ["destination.ip"]},
 "failure": {"path": "event.action", "values": ["traffic_deny"]},
 "success": {"path": "event.action", "values": ["traffic_allow"]},
 "chain_seq": {
  "key": {"path": "source.ip"},
  "within": 3600,
  "steps": [
   {"match": {"all": [
     {"path": "event.action", "values": ["traffic_deny"]},
     {"path": "network.transport", "values": ["tcp"]},
     {"path": "watchguard.firebox.dst_interface", "values": ["Firebox"]}]},
    "bind": {"S": "destination.ip", "P1": "destination.port"}},
   {"match": {"all": [
     {"path": "event.action", "values": ["traffic_deny"]},
     {"path": "network.transport", "values": ["tcp"]}]},
    "eq": {"S": "destination.ip"}, "ne": {"P1": "destination.port"},
    "bind": {"P2": "destination.port"}},
   {"match": {"all": [
     {"path": "event.action", "values": ["traffic_deny"]},
     {"path": "network.transport", "values": ["tcp"]}]},
    "eq": {"S": "destination.ip"}, "ne": {"P1,P2": "destination.port"}},
   {"match": {"all": [
     {"path": "event.action", "values": ["traffic_allow"]},
     {"path": "rule.name", "values": ["WatchGuard SSLVPN-00"]}]},
    "eq": {"S": "destination.ip"}}
  ]
 }
}
