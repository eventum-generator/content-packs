{
 "timestamp": {"path": "@timestamp"},
 "actors": [
  {"name": "client", "path": "source.ip", "target": {"paths": ["destination.ip"]}},
  {"name": "ssh_src", "path": "source.ip",
   "when": {"path": "network.protocol", "values": ["ssh"]},
   "target": {"paths": ["destination.ip"]}},
  {"name": "alarm_src", "path": "source.ip",
   "when": {"path": "stormshield.sns.logtype", "values": ["alarm"]},
   "target": {"paths": ["destination.ip"]}},
  {"name": "ssh_pair", "paths": ["source.ip", "destination.ip"],
   "when": {"path": "network.protocol", "values": ["ssh"]},
   "target": {"paths": ["stormshield.sns.logtype"]}},
  {"name": "bulk_src", "path": "source.ip",
   "when": {"all": [
    {"path": "network.protocol", "values": ["ssh"]},
    {"path": "stormshield.sns.logtype", "values": ["connection"]},
    {"path": "destination.bytes", "regex": "^([2-9]\\d{8}|1[1-9]\\d{7}|10[5-9]\\d{6}|1049\\d{5}|1048[6-9]\\d{4}|104857[6-9]\\d{2}|10485[89]\\d{3}|\\d{10,})$"}]},
   "target": {"paths": ["destination.ip"]}}
 ],
 "action": {"paths": ["stormshield.sns.logtype", "network.protocol"]},
 "target": {"paths": ["destination.ip"]},
 "pairs": [
  {"name": "ssh_session", "key": {"paths": ["source.ip", "source.port", "destination.ip"]},
   "open": {"path": "stormshield.sns.logtype", "values": ["alarm"]},
   "close": {"all": [
    {"path": "stormshield.sns.logtype", "values": ["connection"]},
    {"path": "network.protocol", "values": ["ssh"]}]}}
 ],
 "chain_seq": {
  "key": {"path": "source.ip"},
  "within": 3600,
  "steps": [
   {"match": {"path": "stormshield.sns.logtype", "values": ["alarm"]},
    "bind": {"A": "destination.ip"}},
   {"match": {"path": "stormshield.sns.logtype", "values": ["alarm"]},
    "ne": {"A": "destination.ip"}, "bind": {"B": "destination.ip"}},
   {"match": {"path": "stormshield.sns.logtype", "values": ["alarm"]},
    "ne": {"A,B": "destination.ip"}},
   {"match": {"all": [
     {"path": "network.protocol", "values": ["ssh"]},
     {"path": "stormshield.sns.logtype", "values": ["connection"]},
     {"path": "destination.bytes", "regex": "^([2-9]\\d{8}|1[1-9]\\d{7}|10[5-9]\\d{6}|1049\\d{5}|1048[6-9]\\d{4}|104857[6-9]\\d{2}|10485[89]\\d{3}|\\d{10,})$"}]}}
  ]
 },
 "text_time_paths": ["event.original"]
}
