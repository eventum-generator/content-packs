{
 "timestamp": {"path": "@timestamp"},
 "actors": [
  {"name": "user_ip", "paths": ["user.id", "source.ip"]},
  {"name": "user", "path": "user.id", "target": {"paths": ["source.ip"]}},
  {"name": "ip", "path": "source.ip"},
  {"name": "failed_user_ip", "paths": ["user.id", "source.ip"], "when": {"path": "event.action", "values": ["LOGIN_ERROR"]}},
  {"name": "admin_failed_user_ip", "paths": ["user.id", "source.ip"], "when": {"all": [{"path": "event.action", "values": ["LOGIN_ERROR"]}, {"path": "user.name", "regex": "^adm\\."}]}},
  {"name": "login_user_ip", "paths": ["user.id", "source.ip"], "when": {"path": "event.action", "values": ["LOGIN"]}},
  {"name": "admin", "path": "user.id", "when": {"path": "keycloak.event_type", "values": ["admin"]}, "target": {"paths": ["user.target.id"]}},
  {"name": "admin_ip", "paths": ["user.id", "source.ip"], "when": {"path": "keycloak.event_type", "values": ["admin"]}},
  {"name": "priv_grantor_ip", "paths": ["user.id", "source.ip"], "when": {"all": [{"path": "event.action", "values": ["CREATE-REALM_ROLE_MAPPING"]}, {"path": "event.original", "regex": "secops-admin"}]}},
  {"name": "grant_target", "path": "user.target.id", "when": {"path": "keycloak.event_type", "values": ["admin"]}}
 ],
 "action": {"paths": ["event.action"]},
 "target": {"paths": ["keycloak.client.id"]},
 "failure": {"path": "event.action", "values": ["LOGIN_ERROR"]},
 "success": {"path": "event.action", "values": ["LOGIN"]},
 "chain_seq": {
  "key": {"paths": ["user.id", "source.ip"]},
  "within": 900,
  "steps": [
   {"match": {"path": "event.action", "values": ["LOGIN_ERROR"]}},
   {"match": {"path": "event.action", "values": ["LOGIN_ERROR"]}},
   {"match": {"path": "event.action", "values": ["LOGIN_ERROR"]}},
   {"match": {"path": "event.action", "values": ["LOGIN_ERROR"]}},
   {"match": {"path": "event.action", "values": ["LOGIN_ERROR"]}},
   {"match": {"path": "event.action", "values": ["LOGIN"]}},
   {"match": {"path": "event.action", "values": ["CODE_TO_TOKEN"]}},
   {"match": {"all": [{"path": "event.action", "values": ["CREATE-REALM_ROLE_MAPPING"]}, {"path": "event.original", "regex": "secops-admin"}]}}
  ]
 },
 "pairs": [
  {"name": "session", "key": {"path": "keycloak.session.id"}, "open": {"path": "event.action", "values": ["LOGIN"]}, "close": {"path": "event.action", "values": ["LOGOUT"]}},
  {"name": "priv_grant", "key": {"path": "user.target.id"}, "open": {"all": [{"path": "event.action", "values": ["CREATE-REALM_ROLE_MAPPING"]}, {"path": "event.original", "regex": "secops-admin"}]}, "close": {"all": [{"path": "event.action", "values": ["DELETE-REALM_ROLE_MAPPING"]}, {"path": "event.original", "regex": "secops-admin"}]}}
 ],
 "day_s": 86400,
 "near_s": 1800,
 "text_time_paths": ["event.original"]
}
