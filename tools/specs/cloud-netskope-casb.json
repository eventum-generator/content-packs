{
 "timestamp": {"path": "@timestamp"},
 "actors": [
  {"name": "suser", "path": "user.email", "target": {"path": "netskope.app"}},
  {"name": "user_src", "paths": ["user.email", "source.ip"]},
  {"name": "user_app", "paths": ["user.email", "netskope.app"]},
