  {"name": "storage_downloader", "path": "user.email", "when": {"all": [{"path": "netskope.activity", "values": ["Download"]}, {"path": "netskope.appcategory", "values": ["Cloud Storage"]}]}, "target": {"path": "netskope.app"}},
  {"name": "storage_dl_src", "paths": ["user.email", "source.ip"], "when": {"all": [{"path": "netskope.activity", "values": ["Download"]}, {"path": "netskope.appcategory", "values": ["Cloud Storage"]}]}}
 ],
 "action": {"paths": ["netskope.type", "event.action"]},
 "target": {"paths": ["netskope.app"]},
 "chain_seq": {
  "key": {"path": "user.email"},
  "within": 1800,
  "steps": [
   {"match": {"path": "netskope.audit_log_event", "values": ["Deleted Inline Policy"]}},
   {"match": {"all": [{"path": "netskope.activity", "values": ["Download"]}, {"path": "netskope.appcategory", "values": ["Cloud Storage"]}]}},
   {"match": {"all": [{"path": "netskope.activity", "values": ["Download"]}, {"path": "netskope.appcategory", "values": ["Cloud Storage"]}]}},
   {"match": {"all": [{"path": "netskope.activity", "values": ["Download"]}, {"path": "netskope.appcategory", "values": ["Cloud Storage"]}]}}
  ]
 },
 "features": [
  {"name": "login_delete_download", "key": {"path": "user.email"}, "within": 1800,
   "steps": [
    {"match": {"all": [{"path": "netskope.type", "values": ["admin_audit_logs"]}, {"path": "event.action", "values": ["Login Successful"]}]}},
    {"match": {"path": "netskope.audit_log_event", "values": ["Deleted Inline Policy"]}},
    {"match": {"path": "netskope.activity", "values": ["Download"]}}
   ]}
 ],
