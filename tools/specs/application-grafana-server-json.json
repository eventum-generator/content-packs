{
 "timestamp": {"path": "@timestamp"},
 "actors": [
  {"name": "ip", "path": "grafana.log.remote_addr"},
  {"name": "user", "path": "grafana.log.uname"},
  {"name": "ip_fail", "path": "grafana.log.remote_addr",
   "when": {"all": [{"path": "grafana.log.path", "values": ["/login"]}, {"path": "grafana.log.method", "values": ["POST"]}, {"path": "grafana.log.status", "values": [401]}]}},
  {"name": "ip_login", "path": "grafana.log.remote_addr",
   "when": {"all": [{"path": "grafana.log.path", "values": ["/login"]}, {"path": "grafana.log.method", "values": ["POST"]}]}},
  {"name": "token_admin", "path": "grafana.log.uname",
   "when": {"path": "grafana.log.handler", "regex": "/tokens"}},
  {"name": "token_sa", "path": "grafana.log.path", "regex": "^/api/serviceaccounts/(\\d+)/tokens",
   "when": {"path": "grafana.log.method", "values": ["POST", "DELETE"]}}
 ],
 "action": {"paths": ["event.action", "grafana.log.method", "grafana.log.handler", "grafana.log.status"]},
 "target": {"paths": ["grafana.log.path"]},
 "failure": {"all": [{"path": "grafana.log.path", "values": ["/login"]}, {"path": "grafana.log.method", "values": ["POST"]}, {"path": "grafana.log.status", "values": [401]}]},
 "success": {"all": [{"path": "grafana.log.path", "values": ["/login"]}, {"path": "grafana.log.method", "values": ["POST"]}, {"path": "grafana.log.status", "values": [200]}]},
 "pairs": [
  {"name": "session", "key": {"path": "grafana.log.remote_addr"},
   "open": {"all": [{"path": "grafana.log.path", "values": ["/login"]}, {"path": "grafana.log.method", "values": ["POST"]}, {"path": "grafana.log.status", "values": [200]}]},
   "close": {"all": [{"path": "grafana.log.path", "values": ["/logout"]}, {"path": "grafana.log.status", "values": [302]}]}},
  {"name": "sa_token", "key": {"path": "grafana.log.path", "regex": "^/api/serviceaccounts/(\\d+)/tokens"},
   "open": {"all": [{"path": "grafana.log.method", "values": ["POST"]}, {"path": "grafana.log.handler", "values": ["/api/serviceaccounts/:serviceAccountId/tokens"]}]},
   "close": {"path": "grafana.log.method", "values": ["DELETE"]}}
 ],
 "chain_seq": {
  "key": {"path": "grafana.log.remote_addr"},
  "within": 3600,
  "steps": [
   {"match": {"all": [{"path": "grafana.log.path", "values": ["/login"]}, {"path": "grafana.log.method", "values": ["POST"]}, {"path": "grafana.log.status", "values": [401]}]}},
   {"match": {"all": [{"path": "grafana.log.path", "values": ["/login"]}, {"path": "grafana.log.method", "values": ["POST"]}, {"path": "grafana.log.status", "values": [401]}]}},
   {"match": {"all": [{"path": "grafana.log.path", "values": ["/login"]}, {"path": "grafana.log.method", "values": ["POST"]}, {"path": "grafana.log.status", "values": [401]}]}},
   {"match": {"all": [{"path": "grafana.log.path", "values": ["/login"]}, {"path": "grafana.log.method", "values": ["POST"]}, {"path": "grafana.log.status", "values": [200]}]}},
   {"match": {"all": [{"path": "grafana.log.method", "values": ["POST"]}, {"path": "grafana.log.handler", "values": ["/api/serviceaccounts/:serviceAccountId/tokens"]}]}}
  ]
 },
 "features": [
  {"name": "login_then_token", "key": {"path": "grafana.log.remote_addr"}, "within": 600,
   "steps": [
    {"match": {"all": [{"path": "grafana.log.path", "values": ["/login"]}, {"path": "grafana.log.method", "values": ["POST"]}, {"path": "grafana.log.status", "values": [200]}]}},
    {"match": {"all": [{"path": "grafana.log.method", "values": ["POST"]}, {"path": "grafana.log.handler", "values": ["/api/serviceaccounts/:serviceAccountId/tokens"]}]}}
   ]},
  {"name": "fail_fail_success", "key": {"path": "grafana.log.remote_addr"}, "within": 900,
   "steps": [
    {"match": {"all": [{"path": "grafana.log.path", "values": ["/login"]}, {"path": "grafana.log.method", "values": ["POST"]}, {"path": "grafana.log.status", "values": [401]}]}},
    {"match": {"all": [{"path": "grafana.log.path", "values": ["/login"]}, {"path": "grafana.log.method", "values": ["POST"]}, {"path": "grafana.log.status", "values": [401]}]}},
    {"match": {"all": [{"path": "grafana.log.path", "values": ["/login"]}, {"path": "grafana.log.method", "values": ["POST"]}, {"path": "grafana.log.status", "values": [200]}]}}
   ]}
 ],
 "text_time_paths": ["grafana.log.t"]
}
