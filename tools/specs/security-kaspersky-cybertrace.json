{
 "timestamp": {"path": "@timestamp"},
 "actors": [
  {"name": "endpoint_user", "paths": ["source.ip", "user.name"], "target": {"paths": ["kaspersky.cybertrace.matched_indicator"]}},
  {"name": "endpoint", "path": "source.ip"},
  {"name": "user", "path": "user.name"},
  {"name": "url_actor", "paths": ["source.ip", "user.name"], "target": {"paths": ["url.original"]},
   "when": {"path": "event.code", "values": ["KL_Malicious_URL", "KL_Phishing_URL"]}},
  {"name": "hash_actor", "paths": ["source.ip", "user.name"], "target": {"paths": ["file.hash.md5"]},
   "when": {"path": "event.code", "values": ["KL_Malicious_Hash_MD5"]}},
  {"name": "indicator", "path": "kaspersky.cybertrace.matched_indicator"}
 ],
 "action": {"paths": ["event.code"]},
 "target": {"paths": ["kaspersky.cybertrace.matched_indicator"]},
 "chain_seq": {
  "key": {"paths": ["source.ip", "user.name"]},
  "within": 3600,
  "steps": [
   {"match": {"path": "event.code", "values": ["KL_Malicious_URL", "KL_Phishing_URL"]}, "bind": {"U": "url.original"}},
   {"match": {"path": "event.code", "values": ["KL_Malicious_Hash_MD5"]}},
   {"match": {"path": "event.code", "values": ["KL_Malicious_URL", "KL_Phishing_URL"]}, "eq": {"U": "url.original"}}
  ]
 },
 "features": [
  {"name": "url_then_hash", "key": {"paths": ["source.ip", "user.name"]}, "within": 3600,
   "steps": [
    {"match": {"path": "event.code", "values": ["KL_Malicious_URL", "KL_Phishing_URL"]}},
    {"match": {"path": "event.code", "values": ["KL_Malicious_Hash_MD5"]}}
   ]},
  {"name": "hash_then_url", "key": {"paths": ["source.ip", "user.name"]}, "within": 3600,
   "steps": [
    {"match": {"path": "event.code", "values": ["KL_Malicious_Hash_MD5"]}},
    {"match": {"path": "event.code", "values": ["KL_Malicious_URL", "KL_Phishing_URL"]}}
   ]},
  {"name": "same_url_twice", "key": {"paths": ["source.ip", "user.name"]}, "within": 3600,
   "steps": [
    {"match": {"path": "event.code", "values": ["KL_Malicious_URL"]}, "bind": {"U": "url.original"}},
    {"match": {"path": "event.code", "values": ["KL_Malicious_URL"]}, "eq": {"U": "url.original"}}
   ]}
 ],
 "day_s": 86400,
 "near_s": 3600,
 "text_time_paths": ["event.original"],
 "skip_const_paths_regex": "^(ecs\\.version|event\\.severity|kaspersky\\.cybertrace\\.confidence)$"
}
