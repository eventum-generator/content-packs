{
 "timestamp": {"path": "@timestamp"},
 "actors": [
  {"name": "user", "path": "user.name", "target": {"paths": ["url.domain"]}},
  {"name": "user_denied", "path": "user.name",
   "when": {"path": "http.response.status_code", "values": [403]},
   "target": {"paths": ["url.domain"]}},
  {"name": "user_post", "path": "user.name",
   "when": {"path": "http.request.method", "values": ["POST"]},
   "target": {"paths": ["url.domain"]}},
  {"name": "user_upload", "path": "user.name",
   "when": {"all": [
     {"path": "http.request.method", "values": ["POST"]},
     {"path": "http.response.status_code", "values": [200]},
     {"path": "url.path", "regex": "upload"}]},
   "target": {"paths": ["url.domain"]}},
  {"name": "client_ip", "path": "source.ip"}
 ],
 "action": {"paths": ["event.action", "http.request.method"]},
 "target": {"paths": ["url.domain"]},
 "failure": {"path": "http.response.status_code", "values": [403]},
 "success": {"all": [
  {"path": "http.request.method", "values": ["POST"]},
  {"path": "http.response.status_code", "values": [200]},
  {"path": "url.path", "regex": "upload"}]},
 "chain_seq": {
  "key": {"path": "user.name"},
  "within": 1800,
  "steps": [
   {"match": {"all": [
     {"path": "http.response.status_code", "values": [403]},
     {"path": "http.request.method", "values": ["POST"]}]},
    "bind": {"D": "url.domain"}},
   {"match": {"all": [
     {"path": "http.response.status_code", "values": [403]},
     {"path": "http.request.method", "values": ["POST"]}]},
    "eq": {"D": "url.domain"}},
   {"match": {"all": [
     {"path": "http.request.method", "values": ["POST"]},
     {"path": "http.response.status_code", "values": [200]},
     {"path": "url.path", "regex": "upload"}]},
    "ne": {"D": "url.domain"}}
  ]
 },
 "features": [
  {"name": "denied_post_then_upload", "key": {"path": "user.name"}, "within": 1800,
   "steps": [
    {"match": {"all": [
      {"path": "http.response.status_code", "values": [403]},
      {"path": "http.request.method", "values": ["POST"]}]},
     "bind": {"D": "url.domain"}},
    {"match": {"all": [
      {"path": "http.request.method", "values": ["POST"]},
      {"path": "http.response.status_code", "values": [200]},
      {"path": "url.path", "regex": "upload"}]},
     "ne": {"D": "url.domain"}}
   ]}
 ],
 "text_time_paths": ["event.original"]
}
