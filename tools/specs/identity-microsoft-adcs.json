{
  "timestamp": {
    "path": "@timestamp"
  },
  "actors": [
    {
      "name": "user",
      "path": "user.name"
    },
    {
      "name": "logon",
      "path": "winlog.event_data.SubjectLogonId"
    },
    {
      "name": "user_san",
      "path": "user.name",
      "when": {
        "path": "winlog.event_data.Attributes",
        "regex": "SAN:upn="
      }
    },
    {
      "name": "user_audit",
      "path": "user.name",
      "when": {
        "path": "event.code",
        "values": [
          "4885"
        ]
      }
    }
  ],
  "action": {
    "paths": [
      "event.code",
      "winlog.event_data.AuditFilter"
    ]
  },
  "target": {
    "paths": [
      "winlog.event_data.Attributes"
    ]
  },
  "failure": {
    "path": "event.code",
    "values": [
      "4888"
    ]
  },
  "chain_seq": {
    "key": {
      "paths": [
        "user.name",
        "host.name"
      ]
    },
    "within": 180,
    "steps": [
      {
        "match": {
          "all": [
            {
              "path": "event.code",
              "values": [
                "4885"
              ]
            },
            {
              "path": "winlog.event_data.AuditFilter",
              "values": [
                "119"
              ]
            }
          ]
        }
      },
      {
        "match": {
          "all": [
            {
              "path": "event.code",
              "values": [
                "4886"
              ]
            },
            {
              "path": "winlog.event_data.Attributes",
              "regex": "SAN:upn="
            }
          ]
        },
        "bind": {
          "R": "winlog.event_data.RequestId"
        }
      },
      {
        "match": {
          "path": "event.code",
          "values": [
            "4887"
          ]
        },
        "eq": {
          "R": "winlog.event_data.RequestId"
        }
      }
    ]
  },
  "pairs": [
    {
      "name": "audit_reduction",
      "key": {
        "path": "host.name"
      },
      "open": {
        "path": "winlog.event_data.AuditFilter",
        "values": [
          "119"
        ]
      },
      "close": {
        "path": "winlog.event_data.AuditFilter",
        "values": [
          "127"
        ]
      }
    }
  ]
}
