{
 "timestamp": {"path": "event.created"},
 "actors": [
  {"name": "client", "path": "source.ip", "target": {"paths": ["destination.ip"]}},
  {"name": "client_dst", "paths": ["source.ip", "destination.ip"]},
  {"name": "dns_client", "path": "source.ip",
   "when": {"path": "event.dataset", "values": ["zeek.dns"]},
   "target": {"paths": ["dns.question.name"]}},
  {"name": "tls_client", "path": "source.ip",
   "when": {"path": "event.dataset", "values": ["zeek.ssl"]},
   "target": {"paths": ["tls.client.server_name"]}},
  {"name": "tls_pair", "paths": ["source.ip", "tls.client.server_name"],
   "when": {"path": "event.dataset", "values": ["zeek.ssl"]}},
  {"name": "post_client", "path": "source.ip",
   "when": {"path": "http.request.method", "values": ["POST"]},
   "target": {"paths": ["url.domain"]}},
  {"name": "watched_client", "path": "source.ip",
   "when": {"any": [
    {"path": "dns.question.name", "regex": "^node-[0-9a-f]{8}\\.sync-gw\\.example\\.net$"},
    {"path": "tls.client.server_name", "regex": "^node-[0-9a-f]{8}\\.sync-gw\\.example\\.net$"},
    {"path": "url.domain", "regex": "^node-[0-9a-f]{8}\\.sync-gw\\.example\\.net$"}]},
   "target": {"paths": ["destination.ip"]}}
 ],
 "action": {"paths": ["event.dataset", "http.request.method"]},
 "target": {"paths": ["destination.ip"]},
 "failure": {"path": "event.outcome", "values": ["failure"]},
 "success": {"path": "event.outcome", "values": ["success"]},
 "pairs": [
  {"name": "summary_delay", "key": {"path": "event.id"},
   "open": {"path": "event.dataset", "values": ["zeek.dns", "zeek.ssl", "zeek.http"]},
   "close": {"path": "event.dataset", "values": ["zeek.connection"]}}
 ],
 "chain_seq": {
  "key": {"path": "source.ip"},
  "within": 1800,
  "steps": [
   {"match": {"all": [
     {"path": "event.dataset", "values": ["zeek.dns"]},
     {"path": "dns.response_code", "values": ["NOERROR"]},
     {"path": "dns.question.name", "regex": "^node-[0-9a-f]{8}\\.sync-gw\\.example\\.net$"}]},
    "bind": {"N": "dns.question.name"}},
   {"match": {"path": "event.dataset", "values": ["zeek.ssl"]}, "eq": {"N": "tls.client.server_name"}},
   {"match": {"path": "event.dataset", "values": ["zeek.ssl"]}, "eq": {"N": "tls.client.server_name"}},
   {"match": {"path": "event.dataset", "values": ["zeek.ssl"]}, "eq": {"N": "tls.client.server_name"}},
   {"match": {"path": "event.dataset", "values": ["zeek.ssl"]}, "eq": {"N": "tls.client.server_name"}},
   {"match": {"path": "event.dataset", "values": ["zeek.ssl"]}, "eq": {"N": "tls.client.server_name"}},
   {"match": {"path": "event.dataset", "values": ["zeek.dns"]}, "eq": {"N": "dns.question.name"}},
   {"match": {"all": [
     {"path": "event.dataset", "values": ["zeek.http"]},
     {"path": "http.request.method", "values": ["POST"]},
     {"path": "http.response.status_code", "values": ["200"]}]},
    "eq": {"N": "url.domain"}}
  ]
 }
}
