{
  "timestamp": {
    "path": "@timestamp"
  },
  "actors": [
    {
      "name": "host",
      "path": "carbonblack.edr.computer_name"
    }
  ],
  "chain_seq": {
    "key": {
      "path": "carbonblack.edr.computer_name"
    },
    "within": 600,
    "steps": [
      {
        "match": {
          "path": "event.action",
          "values": [
            "ingress.event.procstart"
          ]
        },
        "bind": {
          "p": "carbonblack.edr.process_guid"
        }
      },
      {
        "match": {
          "all": [
            {
              "path": "event.action",
              "values": [
                "ingress.event.regmod"
              ]
            },
            {
              "path": "carbonblack.edr.action",
              "values": [
                "writeval"
              ]
            }
          ]
        },
        "eq": {
          "p": "carbonblack.edr.process_guid"
        }
      },
      {
        "match": {
          "all": [
            {
              "path": "event.action",
              "values": [
                "ingress.event.filemod"
              ]
            },
            {
              "path": "carbonblack.edr.action",
              "values": [
                "lastwrite"
              ]
            }
          ]
        },
        "eq": {
          "p": "carbonblack.edr.process_guid"
        }
      },
      {
        "match": {
          "all": [
            {
              "path": "event.action",
              "values": [
                "ingress.event.netconn"
              ]
            },
            {
              "path": "carbonblack.edr.remote_ip",
              "values": [
                "198.51.100.10",
                "198.51.100.11",
                "198.51.100.12",
                "198.51.100.13"
              ]
            }
          ]
        },
        "eq": {
          "p": "carbonblack.edr.process_guid"
        }
      }
    ]
  }
}
