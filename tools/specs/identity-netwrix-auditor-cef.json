{
 "timestamp": {"path": "@timestamp"},
 "actors": [
  {"name": "suser", "path": "source.user.name", "target": {"path": "file.path"}},
  {"name": "account", "path": "event.original", "regex": "(?:cat=user suser=\\S+ filePath=\\S*\\\\\\\\|cat=Logon suser=[A-Z0-9-]+\\\\\\\\)([^\\s\\\\]+)"},
  {"name": "suser_shost", "paths": ["source.user.name", "source.domain"]},
  {"name": "suser_what", "paths": ["source.user.name", "file.path"]},
  {"name": "failed_logon", "path": "source.user.name", "when": {"path": "cef.device.event_class_id", "values": ["Failed Logon"]}},
  {"name": "failed_user_host", "paths": ["source.user.name", "file.path"], "when": {"path": "cef.device.event_class_id", "values": ["Failed Logon"]}},
  {"name": "creator", "path": "source.user.name", "when": {"all": [{"path": "cef.device.event_class_id", "values": ["Added"]}, {"path": "cef.extensions.deviceEventCategory", "values": ["user"]}]}},
  {"name": "remover", "path": "source.user.name", "when": {"all": [{"path": "cef.device.event_class_id", "values": ["Removed"]}, {"path": "cef.extensions.deviceEventCategory", "values": ["user"]}]}},
  {"name": "ad_operator_dc", "paths": ["source.user.name", "source.domain"], "when": {"path": "cef.device.product", "values": ["Active Directory"]}}
 ],
 "action": {"paths": ["cef.name"]},
 "target": {"paths": ["file.path"]},
 "failure": {"path": "cef.device.event_class_id", "values": ["Failed Logon"]},
 "success": {"path": "cef.device.event_class_id", "values": ["Successful Logon"]},
 "chain_seq": {
  "key": {"path": "event.original", "regex": "(?:cat=user suser=\\S+ filePath=\\S*\\\\\\\\|cat=Logon suser=[A-Z0-9-]+\\\\\\\\)([^\\s\\\\]+)"},
  "within": 14400,
  "steps": [
   {"match": {"all": [{"path": "cef.device.event_class_id", "values": ["Added"]}, {"path": "cef.extensions.deviceEventCategory", "values": ["user"]}]}, "bind": {"OP": "source.user.name"}},
   {"match": {"path": "cef.device.event_class_id", "values": ["Successful Logon"]}},
   {"match": {"all": [{"path": "cef.device.event_class_id", "values": ["Removed"]}, {"path": "cef.extensions.deviceEventCategory", "values": ["user"]}]}, "eq": {"OP": "source.user.name"}}
  ]
 },
 "features": [
  {"name": "added_then_removed", "key": {"path": "event.original", "regex": "(?:cat=user suser=\\S+ filePath=\\S*\\\\\\\\|cat=Logon suser=[A-Z0-9-]+\\\\\\\\)([^\\s\\\\]+)"}, "within": 14400,
   "steps": [
    {"match": {"all": [{"path": "cef.device.event_class_id", "values": ["Added"]}, {"path": "cef.extensions.deviceEventCategory", "values": ["user"]}]}},
    {"match": {"all": [{"path": "cef.device.event_class_id", "values": ["Removed"]}, {"path": "cef.extensions.deviceEventCategory", "values": ["user"]}]}}
   ]},
  {"name": "modified_logon_removed", "key": {"path": "event.original", "regex": "(?:cat=user suser=\\S+ filePath=\\S*\\\\\\\\|cat=Logon suser=[A-Z0-9-]+\\\\\\\\)([^\\s\\\\]+)"}, "within": 14400,
   "steps": [
    {"match": {"all": [{"path": "cef.device.event_class_id", "values": ["Modified"]}, {"path": "cef.extensions.deviceEventCategory", "values": ["user"]}]}},
    {"match": {"path": "cef.device.event_class_id", "values": ["Successful Logon"]}},
    {"match": {"all": [{"path": "cef.device.event_class_id", "values": ["Removed"]}, {"path": "cef.extensions.deviceEventCategory", "values": ["user"]}]}}
   ]}
 ],
