{
 "timestamp": {"path": "@timestamp"},
 "actors": [
  {"name": "client", "path": "source.ip", "target": {"paths": ["destination.ip"]}},
  {"name": "pair", "paths": ["source.ip", "destination.ip"], "target": {"paths": ["destination.port"]}},
  {"name": "dmz_denied", "path": "source.ip",
   "when": {"all": [
    {"path": "event.action", "values": ["denied"]},
    {"path": "destination.ip", "regex": "^10\\.20\\.10\\."}]},
   "target": {"paths": ["destination.ip"]}},
  {"name": "dmz_pair_denied", "paths": ["source.ip", "destination.ip"],
   "when": {"path": "event.action", "values": ["denied"]},
   "target": {"paths": ["destination.port"]}},
  {"name": "dmz_allowed", "path": "source.ip",
   "when": {"all": [
    {"path": "event.action", "values": ["allowed"]},
    {"path": "sophos.xg.con_event", "values": ["Start"]},
    {"path": "destination.ip", "regex": "^10\\.20\\.10\\."}]},
   "target": {"paths": ["destination.ip"]}}
 ],
 "action": {"paths": ["event.action", "sophos.xg.con_event", "destination.port"]},
 "target": {"paths": ["destination.ip"]},
 "failure": {"path": "event.action", "values": ["denied"]},
 "success": {"all": [
  {"path": "event.action", "values": ["allowed"]},
  {"path": "sophos.xg.con_event", "values": ["Start"]}]},
 "pairs": [
  {"name": "connection", "key": {"path": "sophos.xg.con_id"},
   "open": {"path": "sophos.xg.con_event", "values": ["Start"]},
   "close": {"path": "sophos.xg.con_event", "values": ["Stop"]}}
 ],
 "chain_seq": {
  "key": {"path": "source.ip"},
  "within": 3600,
  "steps": [
   {"match": {"all": [
     {"path": "event.action", "values": ["denied"]},
     {"path": "network.transport", "values": ["tcp"]},
     {"path": "destination.ip", "regex": "^10\\.20\\.10\\."}]},
    "bind": {"S": "destination.ip", "P1": "destination.port"}},
   {"match": {"all": [
     {"path": "event.action", "values": ["denied"]},
     {"path": "network.transport", "values": ["tcp"]}]},
    "eq": {"S": "destination.ip"}, "ne": {"P1": "destination.port"},
    "bind": {"P2": "destination.port"}},
   {"match": {"all": [
     {"path": "event.action", "values": ["denied"]},
     {"path": "network.transport", "values": ["tcp"]}]},
    "eq": {"S": "destination.ip"}, "ne": {"P1,P2": "destination.port"}},
   {"match": {"all": [
     {"path": "event.action", "values": ["allowed"]},
     {"path": "sophos.xg.con_event", "values": ["Start"]}]},
    "eq": {"S": "destination.ip"}}
  ]
 }
}
