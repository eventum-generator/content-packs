{
 "timestamp": {"path": "@timestamp"},
 "actors": [
  {"name": "site", "path": "message", "regex": "(?:<con|\\.\\.\\.198\\.51\\.100\\.|,10\\.200\\.)(\\d+)",
   "target": {"paths": ["destination.ip", "destination.port"]}},
  {"name": "wrong_peer", "path": "source.ip",
   "when": {"all": [{"path": "event.action", "values": ["ipsec-peer-lookup"]},
                    {"path": "message", "regex": "\\[(?!198\\.51\\.100\\.)[^\\]]+\\]$"}]},
   "target": {"paths": ["message"], "regex": "\\[([^\\]]+)\\]$"}},
  {"name": "peer_id", "paths": ["source.ip", "message"], "regex": "^(?:.*\\[)?([^\\[\\]]+)\\]?$",
   "when": {"path": "event.action", "values": ["ipsec-peer-lookup"]}},
  {"name": "enc_host", "path": "source.ip",
   "when": {"path": "pfsense.interface", "values": ["enc0"]},
   "target": {"paths": ["destination.ip", "destination.port"]}},
  {"name": "enc_pair", "paths": ["source.ip", "destination.ip"],
   "when": {"path": "pfsense.interface", "values": ["enc0"]},
   "target": {"paths": ["destination.port"]}},
  {"name": "admin_pair", "paths": ["source.ip", "destination.ip"],
   "when": {"all": [{"path": "pfsense.interface", "values": ["enc0"]},
                    {"path": "destination.port", "values": ["445", "3389", "5985"]}]}}
 ],
 "action": {"paths": ["event.action", "pfsense.interface"]},
 "target": {"paths": ["destination.port"]},
 "failure": {"all": [{"path": "event.action", "values": ["ipsec-peer-lookup"]},
                     {"path": "message", "regex": "\\[(?!198\\.51\\.100\\.)[^\\]]+\\]$"}]},
 "success": {"path": "event.action", "values": ["ipsec-ike-established"]},
 "chain_seq": {
  "key": {"path": "message", "regex": "(?:<con|\\.\\.\\.198\\.51\\.100\\.|,10\\.200\\.)(\\d+)"},
  "within": 900,
  "steps": [
   {"match": {"all": [{"path": "event.action", "values": ["ipsec-peer-lookup"]},
                      {"path": "message", "regex": "\\[(?!198\\.51\\.100\\.)[^\\]]+\\]$"}]}},
   {"match": {"all": [{"path": "event.action", "values": ["ipsec-peer-lookup"]},
                      {"path": "message", "regex": "\\[(?!198\\.51\\.100\\.)[^\\]]+\\]$"}]}},
   {"match": {"all": [{"path": "event.action", "values": ["ipsec-peer-lookup"]},
                      {"path": "message", "regex": "\\[(?!198\\.51\\.100\\.)[^\\]]+\\]$"}]}},
   {"match": {"path": "event.action", "values": ["ipsec-ike-established"]}},
   {"match": {"all": [{"path": "pfsense.interface", "values": ["enc0"]},
                      {"path": "destination.port", "values": ["445", "3389", "5985"]}]}}
  ]
 },
 "features": [
  {"name": "wrong_then_ike", "key": {"path": "message", "regex": "(?:<con|\\.\\.\\.198\\.51\\.100\\.|,10\\.200\\.)(\\d+)"}, "within": 900,
   "steps": [
    {"match": {"all": [{"path": "event.action", "values": ["ipsec-peer-lookup"]},
                       {"path": "message", "regex": "\\[(?!198\\.51\\.100\\.)[^\\]]+\\]$"}]}},
    {"match": {"path": "event.action", "values": ["ipsec-ike-established"]}}]},
  {"name": "ike_then_admin", "key": {"path": "message", "regex": "(?:<con|\\.\\.\\.198\\.51\\.100\\.|,10\\.200\\.)(\\d+)"}, "within": 900,
   "steps": [
    {"match": {"path": "event.action", "values": ["ipsec-ike-established"]}},
    {"match": {"all": [{"path": "pfsense.interface", "values": ["enc0"]},
                       {"path": "destination.port", "values": ["445", "3389", "5985"]}]}}]}
 ],
 "pairs": [
  {"name": "child_sa", "key": {"path": "message", "regex": "<con(\\d+)\\|"},
   "open": {"path": "event.action", "values": ["ipsec-child-established"]},
   "close": {"path": "event.action", "values": ["ipsec-child-closed"]}},
  {"name": "ike_sa", "key": {"path": "message", "regex": "<con(\\d+)\\|"},
   "open": {"path": "event.action", "values": ["ipsec-ike-established"]},
   "close": {"path": "event.action", "values": ["ipsec-ike-deleting"]}}
 ],
 "text_time_paths": ["event.original"]
}
