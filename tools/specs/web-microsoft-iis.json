{
 "timestamp": {"path": "@timestamp"},
 "actors": [
  {"name": "ip", "path": "source.ip"},
  {"name": "ip_sensitive", "path": "source.ip",
   "when": {"path": "url.path", "regex": "^/(backup|admin|exports)/"}},
  {"name": "ip_probe", "path": "source.ip",
   "when": {"path": "url.path", "values": ["/backup/", "/admin/", "/exports/"]}},
  {"name": "ip_4xx", "path": "source.ip",
   "when": {"path": "http.response.status_code", "regex": "^4"}},
  {"name": "ip_download", "path": "source.ip",
   "when": {"all": [{"path": "url.path", "regex": "^/exports/.+"},
                    {"path": "http.response.status_code", "values": [200]}]}},
  {"name": "user", "path": "user.name"},
  {"name": "ip_path", "paths": ["source.ip", "url.path"]}
 ],
 "action": {"paths": ["url.path", "http.response.status_code"]},
 "target": {"paths": ["url.path"]},
 "failure": {"path": "http.response.status_code", "regex": "^4"},
 "text_time_paths": ["event.original"],
 "chain_seq": {
  "key": {"path": "source.ip"},
  "within": 900,
  "steps": [
   {"match": {"all": [{"path": "url.path", "values": ["/backup/"]},
                      {"path": "http.response.status_code", "values": [404]}]}},
   {"match": {"all": [{"path": "url.path", "values": ["/admin/"]},
                      {"path": "http.response.status_code", "values": [403]}]}},
   {"match": {"all": [{"path": "url.path", "values": ["/exports/"]},
                      {"path": "http.response.status_code", "values": [403]}]}},
   {"match": {"all": [{"path": "url.path", "regex": "^/exports/.+"},
                      {"path": "http.response.status_code", "values": [200]}]}}
  ]
 },
 "features": [
  {"name": "probe_then_download", "key": {"path": "source.ip"}, "within": 900,
   "steps": [
    {"match": {"path": "url.path", "values": ["/backup/", "/admin/"]}},
    {"match": {"all": [{"path": "url.path", "regex": "^/exports/.+"},
                       {"path": "http.response.status_code", "values": [200]}]}}
   ]},
  {"name": "three_probes", "key": {"path": "source.ip"}, "within": 900,
   "steps": [
    {"match": {"path": "http.response.status_code", "regex": "^4"}},
    {"match": {"path": "http.response.status_code", "regex": "^4"}},
    {"match": {"path": "http.response.status_code", "regex": "^4"}},
    {"match": {"path": "http.response.status_code", "values": [200]}}
   ]}
 ]
}
