{
 "timestamp": {"path": "@timestamp"},
 "actors": [
  {"name": "src", "path": "source.ip"},
  {"name": "src_rs", "paths": ["source.ip", "fortinet.fortiadc.real_server"]},
  {"name": "src_url", "paths": ["source.ip", "url.path"]},
  {"name": "src_admin", "path": "source.ip",
   "when": {"path": "url.path", "values": ["/admin"]}},
  {"name": "src_admin_rs", "paths": ["source.ip", "fortinet.fortiadc.real_server"],
   "when": {"path": "url.path", "values": ["/admin"]}},
  {"name": "src_fail", "path": "source.ip",
   "when": {"path": "http.response.status_code", "regex": "^[45]"}}
 ],
 "action": {"paths": ["url.path", "http.response.status_code"]},
 "target": {"paths": ["fortinet.fortiadc.real_server"]},
 "include": {"path": "event.dataset", "values": ["fortinet_fortiadc.log"]},
 "failure": {"path": "http.response.status_code", "regex": "^[45]"},
 "text_time_paths": ["event.original"],
 "chain_seq": {
  "key": {"path": "source.ip"},
  "within": 900,
  "steps": [
   {"match": {"all": [{"path": "url.path", "values": ["/admin"]}, {"path": "http.response.status_code", "values": [404]}]},
    "bind": {"A": "fortinet.fortiadc.real_server"}},
   {"match": {"all": [{"path": "url.path", "values": ["/admin"]}, {"path": "http.response.status_code", "values": [403]}]},
    "ne": {"A": "fortinet.fortiadc.real_server"}, "bind": {"B": "fortinet.fortiadc.real_server"}},
   {"match": {"all": [{"path": "url.path", "values": ["/admin"]}, {"path": "http.response.status_code", "values": [200]}]},
    "ne": {"A,B": "fortinet.fortiadc.real_server"}}
  ]
 }
}
