{
 "timestamp": {"path": "@timestamp"},
 "actors": [
  {"name": "user", "path": "user.name"},
  {"name": "client", "path": "source.ip"},
  {"name": "user_client", "paths": ["user.name", "source.ip"]},
  {"name": "user_fail", "path": "user.name", "when": {"path": "event.action", "values": ["login-failure"]}},
  {"name": "user_client_fail", "paths": ["user.name", "source.ip"], "when": {"path": "event.action", "values": ["login-failure"]}},
  {"name": "user_change", "path": "user.name", "when": {"path": "event.category", "values": ["configuration"]}}
 ],
 "action": {"paths": ["event.action"]},
 "failure": {"path": "event.action", "values": ["login-failure"]},
 "success": {"path": "event.action", "values": ["login-success"]},
 "chain_seq": {
  "key": {"path": "user.name"},
  "within": 1800,
  "steps": [
   {"match": {"path": "event.action", "values": ["login-failure"]}, "bind": {"IP": "source.ip"}},
   {"match": {"path": "event.action", "values": ["login-failure"]}, "eq": {"IP": "source.ip"}},
   {"match": {"path": "event.action", "values": ["login-failure"]}, "eq": {"IP": "source.ip"}},
   {"match": {"path": "event.action", "values": ["login-failure"]}, "eq": {"IP": "source.ip"}},
   {"match": {"path": "event.action", "values": ["login-success"]}, "eq": {"IP": "source.ip"}},
   {"match": {"path": "event.action", "values": ["log-change"]}},
   {"match": {"path": "event.action", "values": ["key-add"]}}
  ]
 },
 "day_s": 86400,
 "near_s": 1800,
 "skip_const_paths_regex": "clearpass\\.(process_id|syslog_priority|software_version|event_id)"
}
