{
 "timestamp": {"path": "@timestamp"},
 "actors": [
  {"name": "endpoint", "path": "host.id"},
  {"name": "endpoint_file", "paths": ["host.id", "file.path"],
   "when": {"path": "event.code", "values": ["303", "183"]}},
  {"name": "hips_endpoint", "path": "host.id",
   "when": {"path": "event.code", "values": ["303"]}},
  {"name": "threat_endpoint", "path": "host.id",
   "when": {"path": "event.code", "values": ["183"]}},
  {"name": "hips_app", "paths": ["host.id", "process.executable"],
   "when": {"path": "event.code", "values": ["303"]}},
  {"name": "file_name", "path": "file.name"},
  {"name": "scanner_src", "path": "source.ip"}
 ],
 "action": {"paths": ["event.code"]},
 "target": {"paths": ["file.path"]},
 "failure": {"path": "event.code", "values": ["303"]},
 "success": {"path": "event.code", "values": ["183"]},
 "chain_seq": {
  "key": {"path": "host.id"},
  "within": 7200,
  "steps": [
   {"match": {"path": "event.code", "values": ["303"]}, "bind": {"F": "file.path"}},
   {"match": {"path": "event.code", "values": ["303"]}, "eq": {"F": "file.path"}},
   {"match": {"path": "event.code", "values": ["303"]}, "eq": {"F": "file.path"}},
   {"match": {"path": "event.code", "values": ["183"]}, "eq": {"F": "file.path"}}
  ]
 },
 "pairs": [
  {"name": "hips_to_clean", "key": {"paths": ["host.id", "file.path"]},
   "open": {"path": "event.code", "values": ["303"]},
   "close": {"path": "event.code", "values": ["183"]}}
 ],
 "features": [
  {"name": "hips_twice", "key": {"paths": ["host.id", "file.path"]}, "within": 3600,
   "steps": [
    {"match": {"path": "event.code", "values": ["303"]}},
    {"match": {"path": "event.code", "values": ["303"]}}
   ]},
  {"name": "hips_then_clean", "key": {"paths": ["host.id", "file.path"]}, "within": 7200,
   "steps": [
    {"match": {"path": "event.code", "values": ["303"]}},
    {"match": {"path": "event.code", "values": ["183"]}}
   ]}
 ],
 "day_s": 86400,
 "near_s": 3600,
 "text_time_paths": ["event.original"],
 "skip_const_paths_regex": "^(ecs\\.version|event\\.severity|event\\.kind|event\\.module|event\\.dataset|observer\\..*)$"
}
