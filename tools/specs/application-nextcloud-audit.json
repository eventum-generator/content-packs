{
 "timestamp": {"path": "@timestamp"},
 "actors": [
  {"name": "user", "path": "related.user", "target": {"paths": ["file.path"]}},
  {"name": "address", "path": "source.ip"},
  {"name": "user_address", "paths": ["related.user", "source.ip"]},
  {"name": "user_fail", "path": "related.user", "when": {"path": "event.action", "values": ["user-login-failed"]}},
  {"name": "user_address_fail", "paths": ["related.user", "source.ip"], "when": {"path": "event.action", "values": ["user-login-failed"]}},
  {"name": "user_share", "path": "related.user", "when": {"path": "event.action", "values": ["share-create", "share-expiration-remove", "share-permissions-change"]}}
 ],
 "action": {"paths": ["event.action"]},
 "target": {"paths": ["file.path"]},
 "failure": {"path": "event.action", "values": ["user-login-failed"]},
 "success": {"path": "event.action", "values": ["user-login"]},
 "chain_seq": {
  "key": {"paths": ["related.user", "source.ip"]},
  "within": 3600,
  "steps": [
   {"match": {"path": "event.action", "values": ["user-login-failed"]}},
   {"match": {"path": "event.action", "values": ["user-login-failed"]}},
   {"match": {"path": "event.action", "values": ["user-login-failed"]}},
   {"match": {"path": "event.action", "values": ["user-login"]}},
   {"match": {"path": "event.action", "values": ["file-access"]}, "bind": {"FILE": "file.path"}},
   {"match": {"path": "event.action", "values": ["share-create"]}, "eq": {"FILE": "file.path"}},
   {"match": {"path": "event.action", "values": ["share-expiration-remove"]}, "eq": {"FILE": "file.path"}},
   {"match": {"path": "event.action", "values": ["share-permissions-change"]}, "eq": {"FILE": "file.path"}}
  ]
 },
 "day_s": 86400,
 "near_s": 1800,
 "skip_const_paths_regex": "(nextcloud\\.audit\\.(version|level|app|data)|ecs|log|host|agent|tags)"
}
