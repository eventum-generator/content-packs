{
 "timestamp": {"path": "@timestamp"},
 "actors": [
  {"name": "client", "path": "source.ip", "target": {"paths": ["destination.ip"]}},
  {"name": "pair", "paths": ["source.ip", "destination.ip"], "target": {"paths": ["destination.port"]}},
  {"name": "dropped", "path": "source.ip",
   "when": {"path": "event.action", "values": ["drop"]},
   "target": {"paths": ["destination.ip"]}},
  {"name": "pair_dropped", "paths": ["source.ip", "destination.ip"],
   "when": {"path": "event.action", "values": ["drop"]},
   "target": {"paths": ["destination.port"]}},
  {"name": "allowed", "path": "source.ip",
   "when": {"path": "event.action", "values": ["accept", "open"]},
   "target": {"paths": ["destination.ip"]}},
  {"name": "dos_source", "path": "source.ip",
   "when": {"path": "event.code", "values": ["23003138"]},
   "target": {"paths": ["destination.ip"]}}
 ],
 "action": {"paths": ["event.action", "destination.port"]},
 "target": {"paths": ["destination.ip"]},
 "failure": {"path": "event.action", "values": ["drop"]},
 "success": {"path": "event.action", "values": ["accept", "open"]},
 "pairs": [
  {"name": "flow", "key": {"paths": ["source.ip", "source.port", "destination.ip", "destination.port"]},
   "open": {"path": "event.action", "values": ["open"]},
   "close": {"path": "event.action", "values": ["closed"]}},
  {"name": "dos_attack", "key": {"path": "f5.afm.attack_id"},
   "open": {"path": "event.action", "values": ["attack_started"]},
   "close": {"path": "event.action", "values": ["attack_stopped"]}}
 ],
 "chain_seq": {
  "key": {"path": "source.ip"},
  "within": 3600,
  "steps": [
   {"match": {"path": "event.action", "values": ["drop"]},
    "bind": {"S": "destination.ip", "P1": "destination.port"}},
   {"match": {"path": "event.action", "values": ["drop"]},
    "eq": {"S": "destination.ip"}, "ne": {"P1": "destination.port"},
    "bind": {"P2": "destination.port"}},
   {"match": {"path": "event.action", "values": ["drop"]},
    "eq": {"S": "destination.ip"}, "ne": {"P1,P2": "destination.port"}},
   {"match": {"path": "event.action", "values": ["accept", "open"]},
    "eq": {"S": "destination.ip"}}
  ]
 }
}
