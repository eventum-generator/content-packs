{
 "timestamp": {"path": "@timestamp"},
 "include": {"not": {"path": "source.ip", "missing": true}},
 "actors": [
  {"name": "user", "path": "user.name"},
  {"name": "ip", "path": "source.ip"},
  {"name": "user_ip", "paths": ["user.name", "source.ip"]},
  {"name": "user_create", "path": "user.name",
   "when": {"path": "event.action", "values": ["network-object-create"]}},
  {"name": "user_save", "path": "user.name",
   "when": {"path": "event.action", "values": ["nat-policy-save"]}},
  {"name": "user_change", "paths": ["user.name", "source.ip"],
   "when": {"path": "event.action", "values": ["network-object-create", "nat-policy-save"]}},
  {"name": "user_policy", "paths": ["user.name", "cisco.fmc.audit.policy"],
   "when": {"path": "event.action", "values": ["nat-policy-save"]}},
  {"name": "policy", "path": "cisco.fmc.audit.policy",
   "when": {"path": "event.action", "values": ["nat-policy-save"]}}
 ],
 "action": {"paths": ["event.action", "cisco.fmc.audit.subsystem"]},
 "target": {"paths": ["cisco.fmc.audit.policy"]},
 "chain_seq": {
  "key": {"paths": ["user.name", "source.ip"]},
  "within": 3600,
  "steps": [
   {"match": {"path": "event.action", "values": ["network-object-create"]}},
   {"match": {"path": "event.action", "values": ["nat-policy-save"]}, "bind": {"P": "cisco.fmc.audit.policy"}},
   {"match": {"path": "event.action", "values": ["nat-policy-save"]}, "eq": {"P": "cisco.fmc.audit.policy"}}
  ]
 },
 "features": [
  {"name": "create_then_save", "key": {"paths": ["user.name", "source.ip"]}, "within": 3600,
   "steps": [
    {"match": {"path": "event.action", "values": ["network-object-create"]}},
    {"match": {"path": "event.action", "values": ["nat-policy-save"]}}
   ]},
  {"name": "resave_same_policy", "key": {"paths": ["user.name", "source.ip"]}, "within": 3600,
   "steps": [
    {"match": {"path": "event.action", "values": ["nat-policy-save"]}, "bind": {"P": "cisco.fmc.audit.policy"}},
    {"match": {"path": "event.action", "values": ["nat-policy-save"]}, "eq": {"P": "cisco.fmc.audit.policy"}}
   ]},
  {"name": "create_save_other_policy", "key": {"paths": ["user.name", "source.ip"]}, "within": 3600,
   "steps": [
    {"match": {"path": "event.action", "values": ["network-object-create"]}},
    {"match": {"path": "event.action", "values": ["nat-policy-save"]}, "bind": {"P": "cisco.fmc.audit.policy"}},
    {"match": {"path": "event.action", "values": ["nat-policy-save"]}, "ne": {"P": "cisco.fmc.audit.policy"}}
   ]}
 ]
}
