{
 "timestamp": {"path": "EVENT_TIMESTAMP_UTC", "format": "%Y-%m-%d %H:%M:%S.%f"},
 "actors": [
  {"name": "user_host", "paths": ["DBUSERNAME", "USERHOST"]},
  {"name": "user", "path": "DBUSERNAME"},
  {"name": "host", "path": "USERHOST"},
  {"name": "user_fail", "paths": ["DBUSERNAME", "USERHOST"],
   "when": {"path": "RETURN_CODE", "values": [1017]}},
  {"name": "grantor", "paths": ["DBUSERNAME", "USERHOST"],
   "when": {"path": "ACTION_NAME", "values": ["GRANT", "REVOKE"]},
   "target": {"paths": ["ROLE", "TARGET_USER"]}},
  {"name": "grantee", "path": "TARGET_USER",
   "when": {"path": "ACTION_NAME", "values": ["GRANT", "REVOKE"]},
   "target": {"paths": ["ROLE"]}},
  {"name": "payroll_reader", "paths": ["DBUSERNAME", "USERHOST"],
   "when": {"path": "OBJECT_NAME", "values": ["PAYROLL"]}}
 ],
 "action": {"paths": ["ACTION_NAME", "RETURN_CODE"]},
 "target": {"paths": ["OBJECT_NAME"]},
 "failure": {"path": "RETURN_CODE", "values": [1017]},
 "success": {"all": [{"path": "ACTION_NAME", "values": ["LOGON"]}, {"path": "RETURN_CODE", "values": [0]}]},
 "pairs": [
  {"name": "session", "key": {"path": "SESSIONID"},
   "open": {"all": [{"path": "ACTION_NAME", "values": ["LOGON"]}, {"path": "RETURN_CODE", "values": [0]}]},
   "close": {"path": "ACTION_NAME", "values": ["LOGOFF"]}},
  {"name": "role_grant", "key": {"paths": ["ROLE", "TARGET_USER"]},
   "open": {"path": "ACTION_NAME", "values": ["GRANT"]},
   "close": {"path": "ACTION_NAME", "values": ["REVOKE"]}}
 ],
 "chain_seq": {
  "key": {"paths": ["DBUSERNAME", "USERHOST"]},
  "within": 1800,
  "steps": [
   {"match": {"path": "RETURN_CODE", "values": [1017]}},
   {"match": {"path": "RETURN_CODE", "values": [1017]}},
   {"match": {"path": "RETURN_CODE", "values": [1017]}},
   {"match": {"all": [{"path": "ACTION_NAME", "values": ["LOGON"]}, {"path": "RETURN_CODE", "values": [0]}]}, "bind": {"S": "SESSIONID"}},
   {"match": {"path": "OBJECT_NAME", "values": ["PAYROLL"]}, "eq": {"S": "SESSIONID"}},
   {"match": {"all": [{"path": "ACTION_NAME", "values": ["GRANT"]}, {"path": "ROLE", "values": ["PAYROLL_READ"]}]}, "eq": {"S": "SESSIONID"}}
  ]
 },
 "features": [
  {"name": "payroll_grant_revoke", "key": {"paths": ["DBUSERNAME", "USERHOST"]}, "within": 7200,
   "steps": [
    {"match": {"all": [{"path": "ACTION_NAME", "values": ["GRANT"]}, {"path": "ROLE", "values": ["PAYROLL_READ"]}]}, "bind": {"G": "TARGET_USER"}},
    {"match": {"all": [{"path": "ACTION_NAME", "values": ["REVOKE"]}, {"path": "ROLE", "values": ["PAYROLL_READ"]}]}, "eq": {"G": "TARGET_USER"}}
   ]}
 ],
 "skip_const_paths_regex": "^EVENT_TIMESTAMP$"
}
