    ]
   }
  },
  {
   "name": "client_server",
   "paths": [
    "source.ip",
    "destination.ip"
   ],
   "target": {
    "paths": [
     "url.path"
    ]
   }
  },
  {
   "name": "client_uri",
   "paths": [
    "source.ip",
    "destination.ip",
    "url.path"
   ],
   "target": {
    "paths": [
     "event.code"
    ]
   }
  },
  {
   "name": "blocked_client",
   "path": "source.ip",
   "when": {
    "path": "event.action",
    "values": [
     "blocked"
    ]
   },
   "target": {
    "paths": [
     "url.path"
    ]
   }
  },
  {
   "name": "blocked_uri",
   "paths": [
    "source.ip",
    "destination.ip",
    "url.path"
   ],
   "when": {
    "path": "event.action",
    "values": [
     "blocked"
    ]
   },
   "target": {
    "paths": [
     "event.code"
    ]
   }
  },
  {
   "name": "passed_client",
   "path": "source.ip",
   "when": {
    "path": "event.action",
    "values": [
     "passed"
    ]
   },
   "target": {
    "paths": [
     "url.path"
    ]
   }
  },
  {
   "name": "session",
   "path": "f5.asm.session_id",
   "target": {
    "paths": [
     "url.path"
    ]
   }
  }
 ],
 "action": {
  "paths": [
   "event.action",
   "event.code"
  ]
 },
 "target": {
  "paths": [
   "url.path"
  ]
 },
 "failure": {
  "path": "event.action",
  "values": [
   "blocked"
  ]
 },
 "success": {
  "path": "event.action",
  "values": [
   "passed"
  ]
 },
 "chain_seq": {
  "key": {
   "path": "source.ip"
  },
  "same": [
   "destination.ip",
   "url.path"
  ],
  "within": 1800,
  "steps": [
   {
    "match": {
     "path": "event.action",
     "values": [
      "blocked"
     ]
    },
    "bind": {
     "C1": "event.code"
    }
   },
   {
    "match": {
     "path": "event.action",
     "values": [
      "blocked"
     ]
    },
    "ne": {
     "C1": "event.code"
    },
    "bind": {
     "C2": "event.code"
    }
   },
   {
    "match": {
     "path": "event.action",
     "values": [
      "blocked"
     ]
    },
    "ne": {
     "C1,C2": "event.code"
    }
   },
   {
    "match": {
     "path": "event.action",
     "values": [
      "passed"
     ]
    }
   }
  ]
 },
 "skip_const_paths_regex": "^(f5\\.asm\\.policy_apply_date)$"
}