{
 "timestamp": {"path": "@timestamp"},
 "actors": [
  {"name": "user", "path": "user.name"},
  {"name": "ip", "path": "source.ip"},
  {"name": "user_ip", "paths": ["user.name", "source.ip"]},
  {"name": "denied_user", "path": "user.name", "when": {"path": "event.code", "values": ["44002"]}},
  {"name": "denied_user_ip", "paths": ["user.name", "source.ip"], "when": {"path": "event.code", "values": ["44002"]}},
  {"name": "granted_user_ip", "paths": ["user.name", "source.ip"], "when": {"path": "event.code", "values": ["44003"]}},
  {"name": "deleter", "path": "user.name", "when": {"path": "event.code", "values": ["10050"]}},
  {"name": "deleter_vm", "paths": ["user.name", "veeam.parameters.VmRef"], "when": {"path": "event.code", "values": ["10050"]}},
  {"name": "starter", "path": "user.name", "when": {"path": "event.code", "values": ["110"]}},
  {"name": "job", "path": "veeam.parameters.JobID", "when": {"path": "event.code", "values": ["110", "190"]}},
  {"name": "vm", "path": "veeam.parameters.VmRef", "when": {"path": "event.code", "values": ["10010", "10050"]}}
 ],
 "action": {"paths": ["event.code"]},
 "target": {"paths": ["veeam.parameters.VmRef", "veeam.parameters.JobID"]},
 "failure": {"path": "event.code", "values": ["44002"]},
 "success": {"path": "event.code", "values": ["44003"]},
 "chain_seq": {
  "key": {"path": "user.name"},
  "within": 1800,
  "steps": [
   {"match": {"path": "event.code", "values": ["44002"]}, "bind": {"IP": "source.ip"}},
   {"match": {"path": "event.code", "values": ["44002"]}, "eq": {"IP": "source.ip"}},
   {"match": {"path": "event.code", "values": ["44003"]}, "eq": {"IP": "source.ip"}},
   {"match": {"path": "event.code", "values": ["10050"]}}
  ]
 },
 "features": [
  {"name": "grant_delete_same_user", "key": {"path": "user.name"}, "within": 1800,
   "steps": [
    {"match": {"path": "event.code", "values": ["44003"]}},
    {"match": {"path": "event.code", "values": ["10050"]}}
   ]},
  {"name": "deny_grant_delete_same_user", "key": {"path": "user.name"}, "within": 1800,
   "steps": [
    {"match": {"path": "event.code", "values": ["44002"]}, "bind": {"IP": "source.ip"}},
    {"match": {"path": "event.code", "values": ["44003"]}, "eq": {"IP": "source.ip"}},
    {"match": {"path": "event.code", "values": ["10050"]}}
   ]},
  {"name": "deny_deny_grant_delete_any_user", "key": {"path": "host.name"}, "within": 1800,
   "steps": [
    {"match": {"path": "event.code", "values": ["44002"]}, "bind": {"U": "user.name"}},
    {"match": {"path": "event.code", "values": ["44002"]}, "eq": {"U": "user.name"}},
    {"match": {"path": "event.code", "values": ["44003"]}, "eq": {"U": "user.name"}},
    {"match": {"all": [{"path": "event.code", "values": ["10050"]}, {"path": "user.name", "regex": "."}]}}
   ]}
 ],
 "pairs": [
  {"name": "job_session", "key": {"path": "veeam.parameters.JobSessionID"},
   "open": {"path": "event.code", "values": ["110"]}, "close": {"path": "event.code", "values": ["190"]}}
 ],
 "text_time_paths": []
}
