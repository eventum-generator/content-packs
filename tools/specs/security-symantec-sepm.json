{
 "timestamp": {"path": "@timestamp"},
 "actors": [
  {"name": "admin", "path": "symantec_endpoint.log.admin",
   "when": {"path": "event.provider", "values": ["Administrative Log", "Policy Log"]}},
  {"name": "admin_logon", "path": "symantec_endpoint.log.admin",
   "when": {"path": "event.action", "values": ["admin-logon"]}},
  {"name": "admin_edit", "path": "symantec_endpoint.log.admin",
   "when": {"path": "event.action", "values": ["policy-edited"]}},
  {"name": "admin_policy", "paths": ["symantec_endpoint.log.admin", "symantec_endpoint.log.policy_name"],
   "when": {"path": "event.action", "values": ["policy-edited"]}},
  {"name": "policy", "path": "symantec_endpoint.log.policy_name",
   "when": {"path": "event.action", "values": ["policy-edited"]}},
  {"name": "host", "path": "symantec_endpoint.log.local_host_name",
   "when": {"path": "event.provider", "values": ["Agent Activity Log"]}},
  {"name": "host_download", "path": "symantec_endpoint.log.local_host_name",
   "when": {"path": "event.action", "values": ["policy-downloaded"]}}
 ],
 "action": {"paths": ["event.action", "event.outcome"]},
 "target": {"paths": ["symantec_endpoint.log.policy_name"]},
 "failure": {"path": "event.outcome", "values": ["failure"]},
 "success": {"path": "event.outcome", "values": ["success"]},
 "chain_seq": {
  "key": {"path": "symantec_endpoint.log.admin"},
  "within": 7200,
  "steps": [
   {"match": {"path": "event.outcome", "values": ["failure"]}},
   {"match": {"path": "event.outcome", "values": ["failure"]}},
   {"match": {"path": "event.outcome", "values": ["success"]}},
   {"match": {"path": "event.action", "values": ["policy-edited"]}, "bind": {"P": "symantec_endpoint.log.policy_name"}},
   {"match": {"path": "event.action", "values": ["policy-edited"]}, "eq": {"P": "symantec_endpoint.log.policy_name"}}
  ]
 },
 "features": [
  {"name": "one_fail_then_reedit", "key": {"path": "symantec_endpoint.log.admin"}, "within": 7200,
   "steps": [
    {"match": {"path": "event.outcome", "values": ["failure"]}},
    {"match": {"path": "event.outcome", "values": ["success"]}},
    {"match": {"path": "event.action", "values": ["policy-edited"]}, "bind": {"P": "symantec_endpoint.log.policy_name"}},
    {"match": {"path": "event.action", "values": ["policy-edited"]}, "eq": {"P": "symantec_endpoint.log.policy_name"}}
   ]},
  {"name": "logon_then_reedit", "key": {"path": "symantec_endpoint.log.admin"}, "within": 7200,
   "steps": [
    {"match": {"path": "event.outcome", "values": ["success"]}},
    {"match": {"path": "event.action", "values": ["policy-edited"]}, "bind": {"P": "symantec_endpoint.log.policy_name"}},
    {"match": {"path": "event.action", "values": ["policy-edited"]}, "eq": {"P": "symantec_endpoint.log.policy_name"}}
   ]},
  {"name": "fails_then_other_edits", "key": {"path": "symantec_endpoint.log.admin"}, "within": 7200,
   "steps": [
    {"match": {"path": "event.outcome", "values": ["failure"]}},
    {"match": {"path": "event.outcome", "values": ["failure"]}},
    {"match": {"path": "event.outcome", "values": ["success"]}},
    {"match": {"path": "event.action", "values": ["policy-edited"]}, "bind": {"P": "symantec_endpoint.log.policy_name"}},
    {"match": {"path": "event.action", "values": ["policy-edited"]}, "ne": {"P": "symantec_endpoint.log.policy_name"}}
   ]}
 ]
}
