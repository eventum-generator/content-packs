{
 "timestamp": {"path": "@timestamp"},
 "actors": [
  {"name": "user", "path": "user.name"},
  {"name": "src", "path": "source.ip"},
  {"name": "user_src", "paths": ["user.name", "source.ip"]},
  {"name": "user_fail", "path": "user.name",
   "when": {"path": "event.action", "values": ["access-denied"]}},
  {"name": "user_ecp", "path": "user.name",
   "when": {"path": "url.path", "regex": "^/ecp/"}}
 ],
 "action": {"paths": ["event.action"]},
 "target": {"paths": ["url.path"]},
 "include": {"path": "event.dataset", "values": ["kemp_loadmaster.esp"]},
 "failure": {"path": "event.action", "values": ["access-denied"]},
 "success": {"path": "event.action", "values": ["logged-on"]},
 "pairs": [
  {"name": "esp_session", "key": {"path": "user.name"},
   "open": {"path": "event.action", "values": ["logged-on"]},
   "close": {"path": "event.action", "values": ["logged-off", "user-session-timeout"]}}
 ],
 "chain_seq": {
  "key": {"path": "user.name"},
  "within": 1800,
  "steps": [
   {"match": {"path": "event.action", "values": ["access-denied"]}, "bind": {"I": "source.ip"}},
   {"match": {"path": "event.action", "values": ["access-denied"]}, "eq": {"I": "source.ip"}},
   {"match": {"path": "event.action", "values": ["access-denied"]}, "eq": {"I": "source.ip"}},
   {"match": {"path": "event.action", "values": ["logged-on"]}, "eq": {"I": "source.ip"}},
   {"match": {"all": [{"path": "event.action", "values": ["request"]}, {"path": "url.path", "regex": "^/ecp/"}]}, "eq": {"I": "source.ip"}}
  ]
 }
}
