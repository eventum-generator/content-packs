{
 "timestamp": {"path": "@timestamp"},
 "actors": [
  {"name": "user", "path": "message", "regex": "^\\[(?:[^\\]\\\\]*\\\\)?([^\\]]+)\\]"},
  {"name": "user_ip", "paths": ["user.name", "source.ip"]},
  {"name": "failed_user_ip", "paths": ["user.name", "source.ip"], "when": {"path": "event.outcome", "values": ["failure"]}},
  {"name": "login_user_ip", "paths": ["user.name", "source.ip"], "when": {"path": "event.action", "values": ["login"]}},
  {"name": "grantor", "path": "message", "regex": "^\\[(?:[^\\]\\\\]*\\\\)?([^\\]]+)\\]", "when": {"path": "log.logger", "values": ["vim.event.PermissionAddedEvent", "vim.event.PermissionRemovedEvent"]}}
 ],
 "action": {"paths": ["log.logger"]},
 "target": {"path": "message", "regex": "(?:Permission created for|Permission rule removed for) (\\S+) on"},
 "failure": {"path": "event.outcome", "values": ["failure"]},
 "success": {"path": "event.action", "values": ["login"]},
 "chain_seq": {
  "key": {"path": "message", "regex": "^\\[(?:[^\\]\\\\]*\\\\)?([^\\]]+)\\]"},
  "within": 1800,
  "steps": [
   {"match": {"all": [{"path": "log.logger", "values": ["vim.event.EventEx"]}, {"path": "event.outcome", "values": ["failure"]}]}},
   {"match": {"all": [{"path": "log.logger", "values": ["vim.event.EventEx"]}, {"path": "event.outcome", "values": ["failure"]}]}},
   {"match": {"all": [{"path": "log.logger", "values": ["vim.event.EventEx"]}, {"path": "event.outcome", "values": ["failure"]}]}},
   {"match": {"path": "log.logger", "values": ["vim.event.UserLoginSessionEvent"]}},
   {"match": {"all": [{"path": "log.logger", "values": ["vim.event.PermissionAddedEvent"]}, {"path": "message", "regex": ", role is Admin, "}]}}
  ]
 },
 "pairs": [
  {"name": "session", "key": {"paths": ["user.name", "source.ip"]}, "open": {"path": "event.action", "values": ["login"]}, "close": {"path": "event.action", "values": ["logout"]}},
  {"name": "grant", "key": {"path": "message", "regex": "for (\\S+ on [^,\\]]+)"}, "open": {"path": "log.logger", "values": ["vim.event.PermissionAddedEvent"]}, "close": {"path": "log.logger", "values": ["vim.event.PermissionRemovedEvent"]}}
 ],
 "day_s": 86400,
 "near_s": 1800,
 "text_time_paths": ["event.original"]
}
