{
  "timestamp": {
    "path": "@timestamp"
  },
  "actors": [
    {
      "name": "host",
      "path": "host.name"
    },
    {
      "name": "task",
      "paths": [
        "host.name",
        "winlog.event_data.TaskName"
      ]
    },
    {
      "name": "config_user",
      "path": "user.name"
    },
    {
      "name": "registrant",
      "path": "winlog.event_data.UserContext",
      "when": {
        "path": "event.code",
        "values": [
          "106"
        ]
      }
    },
    {
      "name": "deleter",
      "path": "winlog.event_data.UserName",
      "when": {
        "path": "event.code",
        "values": [
          "141"
        ]
      }
    },
    {
      "name": "run_as",
      "path": "winlog.event_data.UserContext",
      "when": {
        "path": "event.code",
        "values": [
          "100"
        ]
      }
    },
    {
      "name": "user_host",
      "paths": [
        "user.name",
        "host.name"
      ]
    }
  ],
  "action": {
    "paths": [
      "event.code"
    ]
  },
  "target": {
    "paths": [
      "winlog.event_data.TaskName"
    ]
  },
  "failure": {
    "path": "event.outcome",
    "values": [
      "failure"
    ]
  },
  "success": {
    "path": "event.outcome",
    "values": [
      "success"
    ]
  },
  "chain_seq": {
    "key": {
      "path": "host.name"
    },
    "within": 3600,
    "steps": [
      {
        "match": {
          "path": "event.code",
          "values": [
            "106"
          ]
        },
        "bind": {
          "U": "winlog.event_data.UserContext",
          "T": "winlog.event_data.TaskName"
        }
      },
      {
        "match": {
          "path": "event.code",
          "values": [
            "100"
          ]
        },
        "eq": {
          "T": "winlog.event_data.TaskName"
        }
      },
      {
        "match": {
          "path": "event.code",
          "values": [
            "141"
          ]
        },
        "eq": {
          "U": "winlog.event_data.UserName",
          "T": "winlog.event_data.TaskName"
        }
      }
    ]
  },
  "features": [
    {
      "name": "reg_del_same_user",
      "key": {
        "paths": [
          "host.name",
          "winlog.event_data.TaskName"
        ]
      },
      "within": 3600,
      "steps": [
        {
          "match": {
            "path": "event.code",
            "values": [
              "106"
            ]
          },
          "bind": {
            "U": "winlog.event_data.UserContext"
          }
        },
        {
          "match": {
            "path": "event.code",
            "values": [
              "141"
            ]
          },
          "eq": {
            "U": "winlog.event_data.UserName"
          }
        }
      ]
    },
    {
      "name": "reg_run_del",
      "key": {
        "paths": [
          "host.name",
          "winlog.event_data.TaskName"
        ]
      },
      "within": 3600,
      "steps": [
        {
          "match": {
            "path": "event.code",
            "values": [
              "106"
            ]
          }
        },
        {
          "match": {
            "path": "event.code",
            "values": [
              "100"
            ]
          }
        },
        {
          "match": {
            "path": "event.code",
            "values": [
              "141"
            ]
          }
        }
      ]
    }
  ],
  "pairs": [
    {
      "name": "task_lifetime",
      "key": {
        "paths": [
          "host.name",
          "winlog.event_data.TaskName"
        ]
      },
      "open": {
        "path": "event.code",
        "values": [
          "106"
        ]
      },
      "close": {
        "path": "event.code",
        "values": [
          "141"
        ]
      }
    },
    {
      "name": "run",
      "key": {
        "path": "winlog.activity_id"
      },
      "open": {
        "path": "event.code",
        "values": [
          "100"
        ]
      },
      "close": {
        "path": "event.code",
        "values": [
          "102"
        ]
      }
    }
  ],
  "text_time_paths": []
}
