{
 "timestamp": {"path": "@timestamp"},
 "actors": [
  {"name": "user", "path": "mariadb.audit.username"},
  {"name": "host", "path": "mariadb.audit.host"},
  {"name": "user_fail", "path": "mariadb.audit.username",
   "when": {"path": "mariadb.audit.operation", "values": ["FAILED_CONNECT"]}},
  {"name": "grant_any", "path": "mariadb.audit.serverhost",
   "when": {"path": "mariadb.audit.object", "regex": "^GRANT "},
   "target": {"path": "mariadb.audit.object", "regex": "^GRANT \\S+ ON (\\S+ TO \\S+?)@"}}
 ],
 "action": {"paths": ["mariadb.audit.operation"]},
 "failure": {"path": "mariadb.audit.operation", "values": ["FAILED_CONNECT"]},
 "success": {"path": "mariadb.audit.operation", "values": ["CONNECT"]},
 "pairs": [
  {"name": "session", "key": {"path": "mariadb.audit.connectionid"},
   "open": {"path": "mariadb.audit.operation", "values": ["CONNECT", "FAILED_CONNECT"]},
   "close": {"path": "mariadb.audit.operation", "values": ["DISCONNECT"]}}
 ],
 "chain_seq": {
  "key": {"path": "mariadb.audit.username"},
  "within": 1800,
  "steps": [
   {"match": {"path": "mariadb.audit.operation", "values": ["FAILED_CONNECT"]}},
   {"match": {"path": "mariadb.audit.operation", "values": ["FAILED_CONNECT"]}},
   {"match": {"path": "mariadb.audit.operation", "values": ["FAILED_CONNECT"]}},
   {"match": {"path": "mariadb.audit.operation", "values": ["CONNECT"]}},
   {"match": {"path": "mariadb.audit.object", "regex": "^GRANT "}}
  ]
 }
}
