{
 "timestamp": {"path": "@timestamp"},
 "actors": [
  {"name": "client", "path": "source.domain"},
  {"name": "mac", "path": "source.mac"},
  {"name": "client_ip", "paths": ["source.domain", "source.ip"]},
  {"name": "releaser", "path": "source.domain", "when": {"path": "event.code", "values": ["12"]}},
  {"name": "assignee", "path": "source.domain", "when": {"path": "event.code", "values": ["10"]}},
  {"name": "dns_host", "path": "source.domain", "when": {"path": "event.code", "values": ["30", "31", "32"]}}
 ],
 "action": {"paths": ["event.code"]},
 "target": {"paths": ["source.ip"]},
 "failure": {"path": "event.code", "values": ["31"]},
 "success": {"path": "event.code", "values": ["32"]},
 "chain_seq": {
  "key": {"path": "source.domain"},
  "within": 3600,
  "steps": [
   {"match": {"path": "event.code", "values": ["12"]}, "bind": {"R": "source.ip"}},
   {"match": {"path": "event.code", "values": ["10"]}, "ne": {"R": "source.ip"}, "bind": {"A": "source.ip"}},
   {"match": {"path": "event.code", "values": ["12"]}, "eq": {"A": "source.ip"}},
   {"match": {"path": "event.code", "values": ["10"]}, "ne": {"R,A": "source.ip"}, "bind": {"B": "source.ip"}},
   {"match": {"path": "event.code", "values": ["12"]}, "eq": {"B": "source.ip"}},
   {"match": {"path": "event.code", "values": ["10"]}, "ne": {"R,A,B": "source.ip"}, "bind": {"C": "source.ip"}},
   {"match": {"path": "event.code", "values": ["30"]}, "eq": {"C": "source.ip"}},
   {"match": {"path": "event.code", "values": ["31"]}, "eq": {"C": "source.ip"}}
  ]
 },
 "features": [
  {"name": "flap3_any_address", "key": {"path": "source.domain"}, "within": 3600,
   "steps": [
    {"match": {"path": "event.code", "values": ["12"]}},
    {"match": {"path": "event.code", "values": ["10"]}},
    {"match": {"path": "event.code", "values": ["12"]}},
    {"match": {"path": "event.code", "values": ["10"]}},
    {"match": {"path": "event.code", "values": ["12"]}},
    {"match": {"path": "event.code", "values": ["10"]}}
   ]},
  {"name": "assign_dns_fail", "key": {"path": "source.domain"}, "within": 600,
   "steps": [
    {"match": {"path": "event.code", "values": ["10"]}, "bind": {"C": "source.ip"}},
    {"match": {"path": "event.code", "values": ["30"]}, "eq": {"C": "source.ip"}},
    {"match": {"path": "event.code", "values": ["31"]}, "eq": {"C": "source.ip"}}
   ]},
  {"name": "flap_dns_fail", "key": {"path": "source.domain"}, "within": 1800,
   "steps": [
    {"match": {"path": "event.code", "values": ["12"]}, "bind": {"R": "source.ip"}},
    {"match": {"path": "event.code", "values": ["10"]}, "ne": {"R": "source.ip"}, "bind": {"C": "source.ip"}},
    {"match": {"path": "event.code", "values": ["30"]}, "eq": {"C": "source.ip"}},
    {"match": {"path": "event.code", "values": ["31"]}, "eq": {"C": "source.ip"}}
   ]}
 ],
 "pairs": [
  {"name": "lease_hold", "key": {"path": "source.domain"},
   "open": {"path": "event.code", "values": ["10"]}, "close": {"path": "event.code", "values": ["12"]}},
  {"name": "dns_update", "key": {"paths": ["source.domain", "source.ip"]},
   "open": {"path": "event.code", "values": ["30"]}, "close": {"path": "event.code", "values": ["31", "32"]}}
 ],
 "text_time_paths": ["event.original"]
}
