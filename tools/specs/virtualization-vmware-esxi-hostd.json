{
 "timestamp": {"path": "@timestamp"},
 "actors": [
  {"name": "src", "path": "source.ip"},
  {"name": "user", "path": "user.name"},
  {"name": "actor", "paths": ["user.name", "source.ip"]},
  {"name": "actor_fail", "paths": ["user.name", "source.ip"],
   "when": {"path": "event.action", "values": ["auth-failed"]}},
  {"name": "actor_auth", "paths": ["user.name", "source.ip"],
   "when": {"path": "event.action", "values": ["auth-failed", "login"]}},
  {"name": "power_actor", "paths": ["user.name", "source.ip"],
   "when": {"path": "event.action",
    "values": ["vm-poweroff-request", "vm-poweron-request",
     "vm-reboot-request", "vm-snapshot-request", "vm-reconfig-request"]}},
  {"name": "vm", "path": "vmware.esxi.task_id",
   "regex": "haTask-(\\d+)-",
   "when": {"path": "event.action",
    "values": ["vm-poweroff-request", "vm-poweron-request",
     "vm-reboot-request", "vm-snapshot-request", "vm-reconfig-request"]}}
 ],
 "action": {"paths": ["event.action"]},
 "target": {"paths": ["vmware.esxi.task_id"]},
 "failure": {"path": "event.action", "values": ["auth-failed"]},
 "success": {"path": "event.action", "values": ["login"]},
 "pairs": [
  {"name": "vm_down", "key": {"path": "vmware.esxi.task_id", "regex": "haTask-(\\d+)-"},
   "open": {"path": "event.action", "values": ["vm-poweroff-request"]},
   "close": {"path": "event.action", "values": ["vm-poweron-request"]}}
 ],
 "chain_seq": {
  "key": {"paths": ["user.name", "source.ip"]},
  "within": 1800,
  "steps": [
   {"match": {"path": "event.action", "values": ["auth-failed"]}},
   {"match": {"path": "event.action", "values": ["auth-failed"]}},
   {"match": {"path": "event.action", "values": ["auth-failed"]}},
   {"match": {"path": "event.action", "values": ["login"]}},
   {"match": {"path": "event.action", "values": ["vm-poweroff-request"]}}
  ]
 },
 "features": [
  {"name": "fail_login_power", "key": {"paths": ["user.name", "source.ip"]}, "within": 1800,
   "steps": [
    {"match": {"path": "event.action", "values": ["auth-failed"]}},
    {"match": {"path": "event.action", "values": ["login"]}},
    {"match": {"path": "event.action", "values": ["vm-poweroff-request"]}}
   ]}
 ]
}
