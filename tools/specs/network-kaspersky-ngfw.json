{
 "timestamp": {"path": "@timestamp"},
 "actors": [
  {"name": "client", "path": "source.ip", "target": {"paths": ["destination.ip"]}},
  {"name": "big_reader", "path": "source.ip",
   "when": {"all": [
    {"path": "destination.port", "values": [445]},
    {"path": "event.action", "values": ["Firewall"]},
    {"path": "destination.bytes", "regex": "^([5-9][0-9]{7}|[1-9][0-9]{8,})$"}]},
   "target": {"paths": ["destination.ip"]}},
  {"name": "big_uploader", "path": "source.ip",
   "when": {"all": [
    {"path": "destination.port", "values": [443]},
    {"path": "event.action", "values": ["Firewall"]},
    {"path": "source.bytes", "regex": "^([5-9][0-9]{7}|[1-9][0-9]{8,})$"}]},
   "target": {"paths": ["destination.ip"]}},
  {"name": "smb_client", "path": "source.ip",
   "when": {"path": "destination.port", "values": [445]},
   "target": {"paths": ["destination.ip"]}},
  {"name": "cloud_client", "path": "source.ip",
   "when": {"path": "destination.ip", "values": ["203.0.113.10", "203.0.113.11", "203.0.113.12", "203.0.113.13"]},
   "target": {"paths": ["destination.ip"]}}
 ],
 "action": {"paths": ["event.action", "network.protocol"]},
 "target": {"paths": ["destination.ip"]},
 "pairs": [
  {"name": "session", "key": {"path": "kaspersky.ngfw.session_id"},
   "open": {"path": "event.action", "values": ["Session start"]},
   "close": {"path": "event.action", "values": ["Firewall"]}}
 ],
 "chain_seq": {
  "key": {"path": "source.ip"},
  "within": 3600,
  "steps": [
   {"match": {"all": [
     {"path": "destination.port", "values": [445]},
     {"path": "event.action", "values": ["Firewall"]},
     {"path": "destination.bytes", "regex": "^([5-9][0-9]{7}|[1-9][0-9]{8,})$"}]},
    "bind": {"S": "destination.ip"}},
   {"match": {"all": [
     {"path": "destination.port", "values": [445]},
     {"path": "event.action", "values": ["Firewall"]},
     {"path": "destination.bytes", "regex": "^([5-9][0-9]{7}|[1-9][0-9]{8,})$"}]},
    "eq": {"S": "destination.ip"}},
   {"match": {"all": [
     {"path": "destination.port", "values": [443]},
     {"path": "event.action", "values": ["Firewall"]},
     {"path": "source.bytes", "regex": "^([5-9][0-9]{7}|[1-9][0-9]{8,})$"}]}}
  ]
 },
 "skip_const_paths_regex": "^(event\\.start|event\\.end)$"
}
