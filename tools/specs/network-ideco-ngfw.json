{
 "note": "2026-09-29 rework: VPN users connect from 198.18.0.0/15 home addresses (vpn_ctl regex extended). Fixed fail2ban ban time (2700 s plus a few seconds, v21 guide 45 min) is native and identical in both modes; at 60 h the absolute holds check reported it as SUSPECT (about 24% one duration), which the coordinator accepted on 2026-09-27. At 240 h the check passes.",
 "timestamp": {"path": "@timestamp"},
 "actors": [
  {"name": "src", "path": "source.ip", "target": {"paths": ["destination.port"]}},
  {"name": "vpn_ip", "path": "source.ip",
   "when": {"any": [
    {"path": "event.action", "values": ["vpn_authorized"]},
    {"all": [{"path": "event.action", "values": ["fail2ban_found", "fail2ban_ban", "fail2ban_unban"]},
             {"path": "rule.name", "values": ["utm-vpn-authd"]}]}]}},
  {"name": "jail_ip", "paths": ["source.ip", "rule.name"],
   "when": {"path": "event.action", "values": ["fail2ban_found", "fail2ban_ban", "fail2ban_unban"]}},
  {"name": "user", "path": "user.name",
   "when": {"path": "event.action", "values": ["vpn_authorized"]}},
  {"name": "user_ip", "paths": ["user.name", "source.ip"],
   "when": {"path": "event.action", "values": ["vpn_authorized"]}},
  {"name": "vpn_ctl", "path": "source.ip",
   "when": {"all": [{"path": "destination.port", "values": [1723]},
                    {"path": "source.ip", "regex": "^(198\\.1[89]|198\\.51\\.100|203\\.0\\.113|192\\.0\\.2)\\."}]}}
 ],
 "action": {"paths": ["event.action", "rule.name"]},
 "target": {"paths": ["destination.ip"]},
 "failure": {"all": [{"path": "event.action", "values": ["fail2ban_found"]},
                     {"path": "rule.name", "values": ["utm-vpn-authd"]}]},
 "success": {"path": "event.action", "values": ["vpn_authorized"]},
 "pairs": [
  {"name": "ban", "key": {"paths": ["source.ip", "rule.name"]},
   "open": {"path": "event.action", "values": ["fail2ban_ban"]},
   "close": {"path": "event.action", "values": ["fail2ban_unban"]}}
 ],
 "chain_seq": {
  "key": {"path": "source.ip"},
  "within": 900,
  "steps": [
   {"match": {"all": [{"path": "event.action", "values": ["fail2ban_found"]}, {"path": "rule.name", "values": ["utm-vpn-authd"]}]}},
   {"match": {"all": [{"path": "event.action", "values": ["fail2ban_found"]}, {"path": "rule.name", "values": ["utm-vpn-authd"]}]}},
   {"match": {"all": [{"path": "event.action", "values": ["fail2ban_found"]}, {"path": "rule.name", "values": ["utm-vpn-authd"]}]}},
   {"match": {"all": [{"path": "event.action", "values": ["fail2ban_found"]}, {"path": "rule.name", "values": ["utm-vpn-authd"]}]}},
   {"match": {"path": "event.action", "values": ["vpn_authorized"]}}
  ]
 },
 "text_time_paths": ["event.original"],
 "skip_const_paths_regex": "^(observer\\.|ecs\\.|event\\.dataset|event\\.kind)"
}
