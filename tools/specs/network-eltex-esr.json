{
 "timestamp": {"path": "@timestamp"},
 "actors": [
  {"name": "user", "path": "user.name"},
  {"name": "target", "path": "user.target.name"},
  {"name": "ssh_src", "path": "source.ip",
   "when": {"path": "event.action", "values": ["ssh_password_failed", "ssh_password_accepted"]}},
  {"name": "user_fail", "path": "user.name",
   "when": {"path": "event.action", "values": ["ssh_password_failed"]}},
  {"name": "admin_change", "path": "user.name",
   "when": {"path": "event.action", "values": ["enable_password_changed", "system_time_changed"]}},
  {"name": "account_change", "path": "user.target.name",
   "when": {"path": "event.action", "values": ["user_created", "user_privilege_changed", "user_removed"]}}
 ],
 "action": {"paths": ["event.action"]},
 "failure": {"path": "event.action", "values": ["ssh_password_failed"]},
 "success": {"path": "event.action", "values": ["ssh_password_accepted"]},
 "pairs": [
  {"name": "ssh_session", "key": {"path": "user.name"},
   "open": {"path": "event.action", "values": ["session_opened"]},
   "close": {"path": "event.action", "values": ["session_closed"]}},
  {"name": "account_life", "key": {"path": "user.target.name"},
   "open": {"path": "event.action", "values": ["user_created"]},
   "close": {"path": "event.action", "values": ["user_removed"]}}
 ],
 "chain_seq": {
  "key": {"path": "observer.hostname"},
  "within": 1800,
  "steps": [
   {"match": {"path": "event.action", "values": ["ssh_password_failed"]},
    "bind": {"A": "user.name", "I": "source.ip", "P": "source.port"}},
   {"match": {"path": "event.action", "values": ["ssh_password_failed"]},
    "eq": {"A": "user.name", "P": "source.port"}},
   {"match": {"path": "event.action", "values": ["ssh_password_failed"]},
    "eq": {"A": "user.name", "P": "source.port"}},
   {"match": {"path": "event.action", "values": ["ssh_password_accepted"]},
    "eq": {"A": "user.name", "P": "source.port"}},
   {"match": {"path": "event.action", "values": ["enable_password_changed"]},
    "eq": {"A": "user.name"}},
   {"match": {"path": "event.action", "values": ["user_created"]},
    "bind": {"T": "user.target.name"}},
   {"match": {"path": "event.action", "values": ["user_privilege_changed"]},
    "eq": {"T": "user.target.name"}},
   {"match": {"path": "event.action", "values": ["configuration_applied"]}},
   {"match": {"path": "event.action", "values": ["system_time_changed"]},
    "eq": {"A": "user.name"}},
   {"match": {"path": "event.action", "values": ["ssh_password_accepted"]},
    "eq": {"T": "user.name", "I": "source.ip"}, "ne": {"A": "user.name"}}
  ]
 }
}
