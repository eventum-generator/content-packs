{
 "timestamp": {"path": "@timestamp"},
 "actors": [
  {"name": "user", "path": "user.name"},
  {"name": "computer", "path": "client.address"},
  {"name": "user_fail", "path": "user.name",
   "when": {"path": "event.action", "values": ["_$Session$_.AuthenticationError"]}},
  {"name": "admin_mgmt", "path": "user.name",
   "when": {"path": "event.action", "regex": "User|EventLogReduce"},
   "target": {"path": "user.target.name"}}
 ],
 "action": {"paths": ["event.action"]},
 "target": {"paths": ["one_c.event_log.metadata_name"]},
 "failure": {"path": "event.action", "values": ["_$Session$_.AuthenticationError"]},
 "success": {"path": "event.action", "values": ["_$Session$_.Authentication"]},
 "chain_seq": {
  "key": {"path": "user.name"},
  "within": 1800,
  "steps": [
   {"match": {"path": "event.action", "values": ["_$Session$_.AuthenticationError"]}},
   {"match": {"path": "event.action", "values": ["_$Session$_.AuthenticationError"]}},
   {"match": {"path": "event.action", "values": ["_$Session$_.AuthenticationError"]}},
   {"match": {"path": "event.action", "values": ["_$Session$_.AuthenticationError"]}},
   {"match": {"path": "event.action", "values": ["_$Session$_.Authentication"]}},
   {"match": {"path": "event.action", "values": ["_$User$_.New"]}, "bind": {"T": "user.target.id"}},
   {"match": {"path": "event.action", "values": ["_$User$_.Delete"]}, "eq": {"T": "user.target.id"}},
   {"match": {"path": "event.action", "values": ["_$InfoBase$_.EventLogReduce"]}}
  ]
 }
}
