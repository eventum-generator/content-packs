   "target": {
    "paths": [
     "imperva.securesphere.device.custom_string4.value"
    ]
   }
  },
  {
   "name": "admin",
   "path": "source.user.name"
  },
  {
   "name": "sig_client_server",
   "paths": [
    "source.ip",
    "destination.ip"
   ],
   "when": {
    "path": "imperva.securesphere.device.event.class_id",
    "values": [
     "Signature"
    ]
   },
   "target": {
    "paths": [
     "imperva.securesphere.device.custom_string4.value"
    ]
   }
  }
 ],
 "action": {
