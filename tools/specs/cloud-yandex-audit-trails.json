{
 "timestamp": {
  "path": "@timestamp"
 },
 "actors": [
  {
   "name": "user",
   "path": "user.name"
  },
  {
   "name": "user_ip",
   "paths": [
    "user.name",
    "source.ip"
   ]
  },
  {
   "name": "account",
   "path": "user.target.id"
  },
  {
   "name": "user_account",
   "paths": [
    "user.name",
    "user.target.id"
   ]
  },
  {
   "name": "iam_user",
   "path": "user.name",
   "when": {
    "path": "event.action",
    "values": [
     "CreateServiceAccount",
     "UpdateFolderAccessBindings",
     "CreateAccessKey",
     "DeleteAccessKey",
     "DeleteServiceAccount"
    ]
   },
   "target": {
    "path": "user.target.id"
   }
  },
  {
   "name": "granter",
   "path": "user.name",
   "when": {
    "all": [
     {
      "path": "event.action",
      "values": [
       "UpdateFolderAccessBindings"
      ]
     },
     {
      "path": "yandex_cloud.audit.details.access_binding_deltas.0.action",
      "values": [
       "ADD"
      ]
     }
    ]
   },
   "target": {
    "path": "user.target.id"
   }
  },
  {
   "name": "key_issuer",
   "path": "user.name",
   "when": {
    "path": "event.action",
    "values": [
     "CreateAccessKey"
    ]
   },
   "target": {
    "path": "user.target.id"
   }
  }
 ],
 "action": {
  "paths": [
   "event.action",
   "yandex_cloud.audit.details.access_binding_deltas.0.action",
   "yandex_cloud.audit.details.access_binding_deltas.0.access_binding.role_id"
  ]
 },
 "target": {
  "paths": [
   "user.target.id"
  ]
 },
 "chain_seq": {
  "key": {
   "path": "user.id"
  },
  "same": [
   "user.target.id"
  ],
  "within": 1800,
  "steps": [
   {
    "match": {
     "path": "event.action",
     "values": [
      "CreateServiceAccount"
     ]
    }
   },
   {
    "match": {
     "all": [
      {
       "path": "event.action",
       "values": [
        "UpdateFolderAccessBindings"
       ]
      },
      {
       "path": "yandex_cloud.audit.details.access_binding_deltas.0.action",
       "values": [
        "ADD"
       ]
      },
      {
       "path": "yandex_cloud.audit.details.access_binding_deltas.0.access_binding.role_id",
       "values": [
        "editor"
       ]
      }
     ]
    }
   },
   {
    "match": {
     "path": "event.action",
     "values": [
      "CreateAccessKey"
     ]
    }
   }
  ]
 },
 "features": [
  {
   "name": "create_anyrole_key",
   "key": {
    "path": "user.id"
   },
   "same": [
    "user.target.id"
   ],
   "within": 1800,
   "steps": [
    {
     "match": {
      "path": "event.action",
      "values": [
       "CreateServiceAccount"
      ]
     }
    },
    {
     "match": {
      "path": "event.action",
      "values": [
       "UpdateFolderAccessBindings"
      ]
     }
    },
    {
     "match": {
      "path": "event.action",
      "values": [
       "CreateAccessKey"
      ]
     }
    }
   ]
  },
  {
   "name": "create_key",
   "key": {
    "path": "user.id"
   },
   "same": [
    "user.target.id"
   ],
   "within": 1800,
   "steps": [
    {
     "match": {
      "path": "event.action",
      "values": [
       "CreateServiceAccount"
      ]
     }
    },
    {
     "match": {
      "path": "event.action",
      "values": [
       "CreateAccessKey"
      ]
     }
    }
   ]
  }
 ],
 "pairs": [
  {
   "name": "access_key",
   "key": {
    "path": "yandex_cloud.audit.details.access_key_id"
   },
   "open": {
    "path": "event.action",
    "values": [
     "CreateAccessKey"
    ]
   },
   "close": {
    "path": "event.action",
    "values": [
     "DeleteAccessKey"
    ]
   }
  },
  {
   "name": "service_account",
   "key": {
    "path": "user.target.id"
   },
   "open": {
    "path": "event.action",
    "values": [
     "CreateServiceAccount"
    ]
   },
   "close": {
    "path": "event.action",
    "values": [
     "DeleteServiceAccount"
    ]
   }
  },
  {
   "name": "ci_vm",
   "key": {
    "path": "yandex_cloud.audit.details.instance_id"
   },
   "open": {
    "path": "event.action",
    "values": [
     "CreateInstance"
    ]
   },
   "close": {
    "path": "event.action",
    "values": [
     "DeleteInstance"
    ]
   }
  }
 ]
}